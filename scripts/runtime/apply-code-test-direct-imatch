#!/usr/bin/env python3
"""Remove the last code.test matcher facade and bind directly to platform IMatch."""

from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def read(path: str) -> str:
    return (ROOT / path).read_text(encoding="utf-8")


def write(path: str, content: str) -> None:
    (ROOT / path).write_text(content, encoding="utf-8")


def replace_once(path: str, old: str, new: str) -> None:
    source = read(path)
    count = source.count(old)
    if count != 1:
        raise SystemExit(f"{path}: expected one occurrence of {old!r}, found {count}")
    write(path, source.replace(old, new, 1))


for path in [
    "core/lib/src/code/test.hal",
    "core/rust/hal-src/code/test.hal",
]:
    replace_once(path, "            [code.test.protocol :as protocol]\n", "")
    replace_once(path, "(extend-type Matcher protocol/IMatcher", "(extend-type Matcher std.protocol.imatch/IMatch")
    source = read(path)
    count = source.count("protocol/match-value")
    if count == 0:
        raise SystemExit(f"{path}: no matcher dispatch calls found")
    source = source.replace("protocol/match-value", "std.protocol.imatch/match-value")
    if "code.test.protocol" in source or "protocol/IMatcher" in source or "protocol/match-value" in source:
        raise SystemExit(f"{path}: matcher facade reference survived")
    write(path, source)

for path in [
    "core/lib/src/code/test/protocol.hal",
    "core/rust/hal-src/code/test/protocol.hal",
]:
    target = ROOT / path
    if not target.is_file():
        raise SystemExit(f"{path}: expected matcher facade source")
    target.unlink()

inventory_path = "core/rust/standard-library.namespaces"
inventory = read(inventory_path)
entry = "code.test.protocol\n"
if inventory.count(entry) != 1:
    raise SystemExit("standard-library inventory must contain code.test.protocol exactly once")
write(inventory_path, inventory.replace(entry, "", 1))

for root in [ROOT / "core/lib/src", ROOT / "core/rust/hal-src"]:
    for candidate in root.rglob("*.hal"):
        source = candidate.read_text(encoding="utf-8")
        if "code.test.protocol" in source or "protocol/IMatcher" in source:
            raise SystemExit(f"matcher facade survived in {candidate.relative_to(ROOT)}")

Path(__file__).unlink()
