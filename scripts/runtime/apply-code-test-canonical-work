write("core/lib/src/code/test/work.hal", facade)
mirror("code/test/work.hal")


# ---------------------------------------------------------------------------
# Focused conformance for generic stop policy and the canonical test graph.
# ---------------------------------------------------------------------------

work_test_path = "core/lib/test/std/work_test.hal"
work_test = read(work_test_path)
stop_defs = r'''(def batch-stop-count (atom 0))
(def stopped-batch-work
  (work/batch
   {:id :stopped-batch}
   {:list
    (work/pure :stopped-list
      (fn [input context]
        [{:item/id 1 :item/value 1}
         {:item/id 2 :item/value 2}
         {:item/id 3 :item/value 3}]))
    :process
    (work/step :stopped-process
      (fn [value context]
        (swap! batch-stop-count inc)
        value))
    :stop
    (work/pure :stopped-policy
      (fn [state context]
        (= 2 (:result state))))
    :summarise
    (work/pure :stopped-summary
      (fn [batch context]
        {:processed
         (vec (map (fn [record] (:item/value record))
                   (:results batch)))}))}))
(def stopped-batch-result
  (work/run (work/local-runtime) stopped-batch-work nil))

'''
if "(def results\n  [" not in work_test:
    raise SystemExit("std.work test result anchor missing")
work_test = work_test.replace("(def results\n  [", stop_defs + "(def results\n  [", 1)
stop_check = r'''   (test/check
    "batch stop policy prevents later items from starting"
    [(:summary stopped-batch-result)
     (count (:items stopped-batch-result))
     (count (:results stopped-batch-result))
     (deref batch-stop-count)]
    [{:processed [1 2]} 3 2 2])

'''
anchor = '''   (test/check
    "only three public extension protocols are required"'''
if anchor not in work_test:
    raise SystemExit("std.work protocol check anchor missing")
work_test = work_test.replace(anchor, stop_check + anchor, 1)
write(work_test_path, work_test)

work_api_test = "core/lib/test/code/test_work_test.hal"
replace_once(
    work_api_test,
    """     (count (work/checkpoints suite-runtime suite-reference))]
    [:completed true 1 1])""",
    """     (count (work/checkpoints suite-runtime suite-reference))]
    [:completed true 1 12])""",
)
replace_once(
    work_api_test,
    """    [:step :failed true 1 :completed])""",
    """    [:chain :failed true 1 :completed])""",
)
replace_once(
    work_api_test,
    '"public code.test/run uses a native work value and explicit runtime"',
    '"public code.test/run uses the canonical fact-batch work graph"',
)

batch_test_path = "core/lib/test/code/test_work_batch_test.hal"
batch_test = read(batch_test_path)
batch_test = batch_test.replace(
    "(def durable-result (work/result runtime reference))\n",
    "(def durable-result (work/result runtime reference))\n"
    "(def durable-manifest (test-work/fact-manifest options {} 11))\n",
