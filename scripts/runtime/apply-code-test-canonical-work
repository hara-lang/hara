#!/usr/bin/env python3
"""Make the fact-batch graph the sole code.test execution path."""

from __future__ import annotations

import re
import shutil
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def read(path: str) -> str:
    return (ROOT / path).read_text(encoding="utf-8")


def write(path: str, content: str) -> None:
    target = ROOT / path
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content, encoding="utf-8")


def replace_once(path: str, old: str, new: str) -> None:
    source = read(path)
    count = source.count(old)
    if count != 1:
        raise SystemExit(f"{path}: expected one occurrence of {old[:100]!r}, found {count}")
    write(path, source.replace(old, new, 1))


def regex_once(path: str, pattern: str, replacement: str) -> None:
    source = read(path)
    updated, count = re.subn(pattern, replacement, source, count=1, flags=re.DOTALL)
    if count != 1:
        raise SystemExit(f"{path}: migration pattern did not match exactly once")
    write(path, updated)


def mirror(relative: str) -> None:
    source = ROOT / "core/lib/src" / relative
    target = ROOT / "core/rust/hal-src" / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)


# ---------------------------------------------------------------------------
# Generic sequential batch stopping. This is runtime policy, not test control.
# ---------------------------------------------------------------------------

batch_path = "core/lib/src/std/work/runtime/execution/batch.hal"
batch_source = read(batch_path)
batch_pattern = r"\(defn run-batch-process-loop.*?\n\(defn required-stage"
batch_replacement = r'''(defn processed-record
  [item value]
  {:item/id (:item/id item)
   :item/value value})

(defn stop-input
  [item value output index manifest]
  {:item item
   :result value
   :results output
   :index index
   :remaining (- (count manifest) (inc index))})

(declare run-batch-process-loop)

(defn continue-batch-process
  [execute runtime process-frame stop-frame process-work stop-work manifest index output item value]
  (let [output (conj output (processed-record item value))
        stopped
        (if stop-work
          (execute runtime
                   (frame/item-frame stop-frame (:item/id item))
                   stop-work
                   (stop-input item value output index manifest))
          false)]
    (result/then
     stopped
     (fn [stop]
       (if stop
         output
         (run-batch-process-loop execute
                                 runtime
                                 process-frame
                                 stop-frame
                                 process-work
                                 stop-work
                                 manifest
                                 (inc index)
                                 output))))))

(defn run-batch-process-loop
  [execute runtime process-frame stop-frame process-work stop-work manifest index output]
  (if (= index (count manifest))
    output
    (let [item (nth manifest index)
          value
          (execute runtime
                   (frame/item-frame process-frame (:item/id item))
                   process-work
                   (:item/value item))]
      (result/then
       value
       (fn [resolved]
         (continue-batch-process execute
                                 runtime
                                 process-frame
                                 stop-frame
                                 process-work
                                 stop-work
                                 manifest
                                 index
                                 output
                                 item
                                 resolved))))))

(defn run-batch-process
  [execute runtime frame process-work stop-work manifest]
  (let [process-spec (base/work-spec-map process-work)
        process-frame (frame/child-frame frame :batch :process process-spec)
        stop-frame
        (if stop-work
          (frame/child-frame frame
                             :batch
                             :stop
                             (base/work-spec-map stop-work))
          nil)]
    (run-batch-process-loop execute
                            runtime
                            process-frame
                            stop-frame
                            process-work
                            stop-work
                            manifest
                            0
                            [])))

(defn required-stage'''
batch_updated, count = re.subn(
    batch_pattern, batch_replacement, batch_source, count=1, flags=re.DOTALL
)
if count != 1:
    raise SystemExit("std.work batch process block did not match")
batch_updated = batch_updated.replace(
    "(run-batch-process execute runtime frame process-work selected)",
    "(run-batch-process execute runtime frame process-work (:stop spec) selected)",
    1,
)
write(batch_path, batch_updated)
mirror("std/work/runtime/execution/batch.hal")


# ---------------------------------------------------------------------------
# Move the canonical fact graph into code.test and delete the monolithic path.
# ---------------------------------------------------------------------------

work_source = read("core/lib/src/code/test/work.hal")
graph_match = re.search(
    r"\(def \+unsupported-batch-options\+.*?(?=\n\(defn run-batch)",
    work_source,
    flags=re.DOTALL,
)
if graph_match is None:
    raise SystemExit("code.test.work fact graph was not found")
graph = graph_match.group(0)
graph = re.sub(r"(?<![A-Za-z0-9_.:-])test/", "", graph)
graph = re.sub(r"\bexecution-options\b", "work-execution-options", graph)
graph = graph.replace("+default-revision+", "+default-work-revision+")

graph = re.sub(
    r"\(def \+unsupported-batch-options\+ \[:fail-fast\]\).*?\n\(defn selected-facts",
    """(def +unsupported-batch-options+ [])

(defn unsupported-batch-options
  [options]
  [])

(defn assert-batch-options!
  [options]
  options)

(defn selected-facts""",
    graph,
    count=1,
    flags=re.DOTALL,
)

graph = graph.replace(
    """(defn resolve-fact
  [namespace name]
  (let [namespace (fact-identity namespace)
        name (fact-identity name)
        fact (get-fact namespace name)]
    (if fact
      fact
      (throw
       (ex-info \"Registered test fact does not exist\"
                {:namespace namespace
                 :name name})))))""",
    """(defn resolve-fact
  [namespace name]
  (let [namespace (fact-identity namespace)
        name (fact-identity name)
        fact (get-fact namespace name)]
    (if fact
      fact
      (throw
       (ex-info \"Registered test fact does not exist\"
                {:namespace namespace
                 :name name})))))

(defn resolve-subject-fact
  \"Resolves a prepared fact and rejects definition drift before execution.\"
  [subject]
  (let [fact (resolve-fact (:namespace subject) (:name subject))
        expected (:test/definition subject)
        actual (fact-definition-token fact (:test/revision subject))]
    (if (and expected (not= expected actual))
      (throw
       (ex-info \"Registered test fact definition changed after preparation\"
                {:namespace (:namespace subject)
                 :name (:name subject)
                 :expected expected
                 :actual actual})))
    fact))""",
    1,
)

for old in [
    "(resolve-fact (:namespace subject)\n                           (:name subject))",
    "(resolve-fact (:namespace subject)\n                           (:name subject))",
]:
    graph = graph.replace(old, "(resolve-subject-fact subject)")

old_summary = r'''(defn summarise-fact-batch
  [batch context]
  (summary-from-results
   (work/manifest-values (:results batch))))'''
new_summary = r'''(defn stop-after-fact?
  [state context]
  (let [subject (:item/value (:item state))
        options (:test/options subject)
        result (:result state)]
    (and (:fail-fast options)
         (failing-status? (:status result)))))

(defn remaining-items
  [batch]
  (let [items (vec (:items batch))
        processed (count (:results batch))]
    (loop [index processed
           output []]
      (if (= index (count items))
        output
        (recur (inc index) (conj output (nth items index)))))))

(defn cancelled-fact-result
  [item]
  (let [subject (:item/value item)
        fact (resolve-subject-fact subject)]
    (merge (fact-result-identity fact)
           {:status :cancelled
            :checks []
            :reason :fail-fast})))

(defn cancelled-fact-results
  [items context]
  (reduce
   (fn [output item]
     (let [result (cancelled-fact-result item)]
       (work/emit! context :test/fact-completed result)
       (conj output result)))
   []
   items))

(defn summarise-fact-batch
  [batch context]
  (let [completed (work/manifest-values (:results batch))
        cancelled (cancelled-fact-results (remaining-items batch) context)]
    (summary-from-results (vec (concat completed cancelled)))))'''
if old_summary not in graph:
    raise SystemExit("code.test fact summary block was not found")
graph = graph.replace(old_summary, new_summary, 1)

graph = graph.replace(
    """      :process
      (fact-process-work batch-revision)

      :summarise""",
    """      :process
      (fact-process-work batch-revision)

      :stop
      (work/pure
       {:id 'code.test/fact-stop
        :version batch-revision}
       stop-after-fact?)

      :summarise""",
    1,
)

graph = re.sub(
    r"\(defn fact-batch-work.*$",
    r'''(defn fact-batch-work
  "Returns the canonical suite graph with independently checkpointed facts.

   Suite and fact cleanup use work/ensure. Test lifecycle events commit directly
   through std.work. Fail-fast is a generic batch stop policy; unstarted facts
   are projected as cancelled test-domain results."
  ([]
   (fact-batch-work +default-work-revision+))
  ([batch-revision]
   (work/chain
    {:id 'code.test/fact-batch
     :version batch-revision
     :test/revision batch-revision}
    [(work/pure
      {:id 'code.test/fact-batch-prepare
       :version batch-revision}
      (fn [input context]
        (prepare-fact-batch input context batch-revision)))
     (work/ensure
      {:id 'code.test/suite-scope
       :version batch-revision}
      (fact-batch-body batch-revision)
      (work/step
       {:id 'code.test/suite-after
        :version batch-revision}
       suite-after))
     (work/pure
      {:id 'code.test/suite-result
       :version batch-revision}
      (fn [batch context]
        (:summary batch)))])))

(defn batch-summary
  [result]
  (if (and (map? result) (has? result :summary))
    (:summary result)
    result))''',
    graph,
    count=1,
    flags=re.DOTALL,
)

code_test_path = "core/lib/src/code/test.hal"
code_test = read(code_test_path)
replacement = r'''
(def +default-work-revision+ 1)

(defn work-revision
  [options]
  (or (:test/revision options)
      +default-work-revision+))

(defn work-context-options
  [context]
  (let [base (or (:test/options context) {})
        now (:work/now context)
        timeout-promise (:work/timeout-promise context)
        cancel-timeout (:work/cancel-timeout context)]
    (merge base
           (if now {:work/now now} {})
           (if timeout-promise
             {:work/timeout-promise timeout-promise}
             {})
           (if cancel-timeout
             {:work/cancel-timeout cancel-timeout}
