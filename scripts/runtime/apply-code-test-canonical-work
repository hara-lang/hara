write(batch_test_path, batch_test)


# ---------------------------------------------------------------------------
# Strengthen the permanent gate around one graph and one event vocabulary.
# ---------------------------------------------------------------------------

audit = r'''#!/usr/bin/env python3
"""Require one canonical code.test work graph and direct committed events."""

from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
EVENT_OWNER = ROOT / "core/lib/src/code/test.hal"
FACADE = ROOT / "core/lib/src/code/test/work.hal"
CANONICAL = [EVENT_OWNER, FACADE]
MIRRORS = [
    ROOT / "core/rust/hal-src/code/test.hal",
    ROOT / "core/rust/hal-src/code/test/work.hal",
]
AUDIT_ROOTS = [ROOT / "core/lib/src/code", ROOT / "core/lib/test/code"]
AUDIT_FILES = [ROOT / "core/lib/test/std/platform_imatch_test.hal"]
RETIRED_PATHS = [
    ROOT / "core/lib/src/code/test/protocol.hal",
    ROOT / "core/rust/hal-src/code/test/protocol.hal",
]
FORBIDDEN = [
    "code.test.protocol",
    "(defn report-event",
    "(defn report!",
    "(defn work-event-kind",
    "(defn work-reporter",
    "(defn reporter-for",
    "(defn event-reporter",
    "(defn reporter-events",
    "(defn function-clock",
    "(defn function-timer",
    "(defn function-control",
    "(defn run-selected",
    "(defn run-facts",
    "(defn run-fact-with-events",
    "(defn suite-work",
    "WorkReporter",
    "ITestReporter",
    ":test/reporter",
    ":test/clock",
    ":test/timer",
    ":test/control",
    ":run/start",
    ":run/end",
    ":fact/start",
    ":fact/end",
]
REQUIRED_EVENTS = [
    ":test/run-started",
    ":test/fact-started",
    ":test/fact-completed",
    ":test/run-completed",
]
REQUIRED_GRAPH = [
    "(def +runner-work+ (fact-batch-work))",
    "code.test/fact-batch-items",
    "code.test/suite-scope",
    "code.test/fact-stop",
    "(defn resolve-subject-fact",
]
REQUIRED_FACADE = [
    "(def fact-batch-work test/fact-batch-work)",
    "(def run test/run)",
    "(def start test/start)",
]

errors = []
for path in RETIRED_PATHS:
    if path.exists():
        errors.append(f"retired code.test protocol facade exists: {path.relative_to(ROOT)}")

paths = []
for root in AUDIT_ROOTS:
    if root.exists():
        paths.extend(path for path in root.rglob("*.hal") if path.is_file())
paths.extend(path for path in AUDIT_FILES if path.exists())
for path in paths:
    source = path.read_text(encoding="utf-8")
    for token in FORBIDDEN:
        if token in source:
            errors.append(
                f"{path.relative_to(ROOT)} retains private test-runtime token {token!r}"
            )

owner_source = EVENT_OWNER.read_text(encoding="utf-8")
for token in REQUIRED_EVENTS + REQUIRED_GRAPH:
    if token not in owner_source:
        errors.append(f"{EVENT_OWNER.relative_to(ROOT)} is missing {token!r}")

facade_source = FACADE.read_text(encoding="utf-8")
for token in REQUIRED_FACADE:
    if token not in facade_source:
        errors.append(f"{FACADE.relative_to(ROOT)} is missing alias {token!r}")
for token in REQUIRED_EVENTS + ["work/emit!", "work/step", "work/batch"]:
    if token in facade_source:
        errors.append(f"{FACADE.relative_to(ROOT)} duplicates canonical graph token {token!r}")

for canonical, mirror in zip(CANONICAL, MIRRORS):
    if canonical.read_bytes() != mirror.read_bytes():
        errors.append(
            f"HAL mirror differs: {canonical.relative_to(ROOT)} != {mirror.relative_to(ROOT)}"
        )

inventory = ROOT / "core/rust/standard-library.namespaces"
if inventory.exists() and "code.test.protocol" in inventory.read_text(encoding="utf-8").splitlines():
    errors.append("retired code.test.protocol remains in the Rust namespace inventory")

if errors:
    print("\n".join(errors), file=sys.stderr)
    raise SystemExit(1)

print("code.test has one fact-batch graph, direct std.work events, and no ITest adapter surface")
'''
write("scripts/runtime/check-code-test-work-events", audit)
(ROOT / "scripts/runtime/check-code-test-work-events").chmod(0o755)

# Final shape checks before deleting this one-shot helper.
for relative in ["code/test.hal", "code/test/work.hal", "std/work/runtime/execution/batch.hal"]:
    canonical = read(f"core/lib/src/{relative}")
    mirrored = read(f"core/rust/hal-src/{relative}")
    if canonical != mirrored:
        raise SystemExit(f"HAL mirror mismatch after migration: {relative}")

source = read("core/lib/src/code/test.hal")
for retired in ["run-selected", "run-facts", "run-fact-with-events", "(defn suite-work"]:
    if retired in source:
        raise SystemExit(f"monolithic test execution survived: {retired}")

Path(__file__).unlink()
