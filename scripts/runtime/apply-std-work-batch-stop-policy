(def stop-cancel-count (atom 0))
(def stop-runtime (work/durable-runtime))
(def stop-work
  (work/batch
   {:id :stop-aware-batch
    :version 1}
   {:list
    (work/step :stop-list
      (fn [input context]
        [{:item/id :a :item/value :a}
         {:item/id :b :item/value :b}
         {:item/id :c :item/value :c}]))

    :process
    (work/step :stop-process
      (fn [value context]
        (swap! stop-process-count inc)
        {:value value
