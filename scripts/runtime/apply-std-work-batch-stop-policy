    :stop
    (work/pure :stop-after-failure
      (fn [batch context]
        (= :failed
           (get-in batch [:result :item/value :status]))))

    :cancel
    (work/step :cancel-unclaimed
      (fn [batch context]
        (swap! stop-cancel-count inc)
        {:value (get-in batch [:item :item/value])
         :status :cancelled}))

    :summarise
    (work/pure :stop-summary
      (fn [batch context]
        (work/manifest-values (:results batch))))}))
