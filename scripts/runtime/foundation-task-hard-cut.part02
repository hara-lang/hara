diff --git a/core/rust/hal-src/code/test/task.hal b/core/rust/hal-src/code/test/task.hal
deleted file mode 100644
index e0cb0bb..0000000
--- a/core/rust/hal-src/code/test/task.hal
+++ /dev/null
@@ -1,59 +0,0 @@
-;; Deprecated task-shaped entry names retained for callers while code.test
-;; execution is owned by code.test.work.
-(ns code.test.task
-  (:require [code.test.cli :as cli]
-            [code.test.work :as test-work]))
-
-(def run test-work/run)
-(def run:current test-work/run)
-(def run:test test-work/run)
-(def run:load test-work/run)
-(def run:unload test-work/run)
-(def run-errored test-work/run)
-
-(defn resolve-files
-  ([files] (resolve-files files nil))
-  ([files project]
-   (if (or (vector? files) (list? files) (set? files))
-     (vec files)
-     [files])))
-
-(defn run:interrupt [] true)
-(defn run:report
-  ([path] (test-work/run {:report path}))
-  ([path options] (test-work/run (assoc options :report path)))
-  ([path options project] (test-work/run (assoc options :report path))))
-
-(defn print-options
-  ([] (print-options :help))
-  ([options]
-   (if (= options :help)
-     #{:help :current :default :disable :all}
-     options)))
-
-(defn legacy-test-options
-  "Preserves the archived task CLI result shape while code.test.cli owns the
-   canonical :namespace execution option."
-  [options]
-  (if (has? options :namespace)
-    (assoc (dissoc options :namespace)
-           :ns
-           (:namespace options))
-    options))
-
-(defn process-run-args
-  "Returns the canonical options used by the public code.test facade."
-  [arguments]
-  (cli/process-args (cli/collapse-only arguments)))
-
-(defn process-test-args
-  [arguments]
-  (legacy-test-options (process-run-args arguments)))
-
-(defn main
-  [& arguments]
-  (test-work/run (process-run-args arguments)))
-
-(defn -main
-  [& arguments]
-  (test-work/run (process-test-args arguments)))
