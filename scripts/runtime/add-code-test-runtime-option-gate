#!/usr/bin/env python3
"""Reject retired test-runtime option objects at the code.test boundary."""

from pathlib import Path
import shutil

ROOT = Path(__file__).resolve().parents[2]


def read(relative: str) -> str:
    return (ROOT / relative).read_text(encoding="utf-8")


def write(relative: str, content: str) -> None:
    (ROOT / relative).write_text(content, encoding="utf-8")


def replace_once(relative: str, old: str, new: str) -> None:
    source = read(relative)
    count = source.count(old)
    if count != 1:
        raise SystemExit(f"{relative}: expected one option-gate anchor, found {count}")
    write(relative, source.replace(old, new, 1))


code_path = "core/lib/src/code/test.hal"
run_hooks = '''(defn run-hooks
  [hooks options]
  (reduce (fn [output hook]
            (do (run-hook hook options) output))
          nil
          hooks))'''
option_gate = run_hooks + '''

(def +retired-runtime-option-keys+
  [:reporter :clock :timer :control :session :cancelled])

(defn retired-runtime-options
  [options]
  (reduce
   (fn [output key]
     (if (has? options key)
       (conj output key)
       output))
   []
   +retired-runtime-option-keys+))

(defn assert-work-runtime-options!
  "Rejects the removed parallel test-runtime option family.

   Observation, time, deadlines and cancellation are supplied by std.work
   runtime construction, work context capabilities and runtime commands."
  [options]
  (let [options (or options {})
        retired (retired-runtime-options options)]
    (if (seq retired)
      (throw
       (ex-info "Test runtime options were removed; use std.work runtime facilities"
                {:retired retired
                 :work/options
                 [:observer
                  :context
                  :work/now
                  :work/timeout-promise
                  :work/cancel-timeout]})))
    options))'''
replace_once(code_path, run_hooks, option_gate)

replace_once(
    code_path,
    '''  ([fact options]
   (let [identity''',
    '''  ([fact options]
   (let [options (assert-work-runtime-options! options)
         identity''',
)

replace_once(
    code_path,
    '''  (let [input-options (data-options input context)
        facts''',
    '''  (let [input-options
        (assert-work-runtime-options!
         (data-options input context))
        facts''',
)

# Keep the Rust-packaged HAL source exact.
shutil.copyfile(
    ROOT / code_path,
    ROOT / "core/rust/hal-src/code/test.hal",
)

facade_path = "core/lib/src/code/test/work.hal"
replace_once(
    facade_path,
    '''(def execution-options test/work-execution-options)
(def suite-work''',
    '''(def execution-options test/work-execution-options)
(def retired-runtime-options test/retired-runtime-options)
(def assert-work-runtime-options! test/assert-work-runtime-options!)
(def suite-work''',
)
shutil.copyfile(
    ROOT / facade_path,
    ROOT / "core/rust/hal-src/code/test/work.hal",
)

# Add one focused hard-cut assertion to the canonical test namespace.
test_path = "core/lib/test/code/test_test.hal"
test_source = read(test_path)
anchor = '''])])

(legacy/print-results results)'''
check = '''
   (legacy/check-error
    "retired test runtime option objects are rejected"
    (assert-work-runtime-options!
     {:reporter nil
      :clock nil
      :timer nil
      :control nil
      :session nil
      :cancelled false}))'''
if test_source.count(anchor) != 1:
    raise SystemExit("code.test result-vector tail was not found")
write(test_path, test_source.replace(anchor, "])" + check + "] )\n\n(legacy/print-results results)", 1))

# Normalise the exact result-vector close after the insertion.
source = read(test_path).replace("])\n   (legacy/check-error", ")\n\n   (legacy/check-error", 1)
source = source.replace(")}))] )", ")}))])", 1)
write(test_path, source)

# Strengthen the permanent source law.
audit_path = "scripts/runtime/check-code-test-work-events"
audit = read(audit_path)
audit = audit.replace(
    '''    "(defn resolve-subject-fact",
]''',
    '''    "(defn resolve-subject-fact",
    "(defn assert-work-runtime-options!",
    "+retired-runtime-option-keys+",
]''',
    1,
)
if "(defn assert-work-runtime-options!" not in audit:
    raise SystemExit("code.test audit runtime-option gate was not installed")
write(audit_path, audit)

# Exact mirror and gate assertions.
if read(code_path) != read("core/rust/hal-src/code/test.hal"):
    raise SystemExit("code.test HAL mirror diverged")
if read(facade_path) != read("core/rust/hal-src/code/test/work.hal"):
    raise SystemExit("code.test.work HAL mirror diverged")

Path(__file__).unlink()
