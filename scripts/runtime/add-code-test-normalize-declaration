#!/usr/bin/env python3
"""Add the explicit normalize-run-options forward declaration, then self-delete."""

from pathlib import Path
import shutil

ROOT = Path(__file__).resolve().parents[2]
TARGET = ROOT / "core/lib/src/code/test.hal"
source = TARGET.read_text(encoding="utf-8")
anchor = "(defn data-options\n  [input context]"
declaration = "(declare normalize-run-options)\n\n"
if declaration not in source:
    if source.count(anchor) != 1:
        raise SystemExit("code.test data-options anchor was not found exactly once")
    source = source.replace(anchor, declaration + anchor, 1)
    TARGET.write_text(source, encoding="utf-8")
shutil.copyfile(TARGET, ROOT / "core/rust/hal-src/code/test.hal")
Path(__file__).unlink()
