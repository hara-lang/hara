#!/usr/bin/env python3
"""Keep workflow-file mutations out of the Actions-generated source commit."""

from __future__ import annotations

import re
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
TARGET = ROOT / "scripts/runtime/apply-code-test-direct-work-events"
source = TARGET.read_text(encoding="utf-8")

# The permanent workflow is installed later through the GitHub connector,
# because the Actions installation token cannot create or delete workflows.
pattern = re.compile(
    r'''\nwrite\(\n    "\.github/workflows/code-test-work-events\.yml",\n    '''.*?'''\n\)\n''',
    re.DOTALL,
)
source, count = pattern.subn("\n", source, count=1)
if count != 1:
    raise SystemExit("permanent workflow generation block was not found exactly once")

source = source.replace("delete(TEMP_WORKFLOW)\n", "")
TARGET.write_text(source, encoding="utf-8")
Path(__file__).unlink()
