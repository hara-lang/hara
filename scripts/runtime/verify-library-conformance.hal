(ns verify-library-conformance
  (:require [work.base :as work]
            [work.flow.task :as task]
            [work.flow.task.report :as task-report]
            [work.verify.conformance :as verify]))

(let [observer (work/recording-observer)
      runtime (work/local-runtime {:observer observer})
      output (work/run runtime
                       verify/library-conformance
                       (task/invocation {}))]
  (task-report/replay
   (vec
    (filter
     (fn [event] (= :task/run-completed (:event event)))
     (work/observer-events observer))))
  (println (pr-str (:summary output)))
  nil)
