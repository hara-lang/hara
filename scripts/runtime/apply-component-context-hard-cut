#!/usr/bin/env python3
# Apply the std.lib component/context hard cut on the dedicated branch.

from __future__ import annotations

import textwrap
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
SELF = Path(__file__).resolve()
WORKFLOW = ROOT / ".github/workflows/_apply-component-context-hard-cut.yml"


def read(relative: str) -> str:
    return (ROOT / relative).read_text(encoding="utf-8")


def write(relative: str, content: str) -> None:
    path = ROOT / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def replace_once(relative: str, old: str, new: str) -> None:
    source = read(relative)
    count = source.count(old)
    if count != 1:
        raise RuntimeError(
            f"{relative}: expected one replacement for {old!r}, found {count}"
        )
    write(relative, source.replace(old, new, 1))


def remove(relative: str) -> None:
    path = ROOT / relative
    if not path.is_file():
        raise RuntimeError(f"{relative}: expected file to remove")
    path.unlink()


def mirror(source: str, target: str) -> None:
    write(target, read(source))


def main() -> int:
    replace_once(
        "core/lib/src/lib/postgres.hal",
        "[std.lib.component :as component]",
        "[std.foundation.component :as component]",
    )
    mirror(
        "core/lib/src/lib/postgres.hal",
        "core/rust/hal-src/lib/postgres.hal",
    )

    replace_once(
        "core/lib/src/lang/core/runtime.hal",
        "[std.lib.component :as component]",
        "[std.foundation.component :as component]",
    )
    mirror(
        "core/lib/src/lang/core/runtime.hal",
        "core/rust/hal-src/lang/core/runtime.hal",
    )

    replace_once(
        "core/lib/test/std/foundation/component_test.hal",
        "            [std.foundation.component :as component]\n"
        "            [std.lib.component :as legacy]))",
        "            [std.foundation.component :as component]))",
    )
    replace_once(
        "core/lib/test/std/foundation/component_test.hal",
        '''               [:start :stop])
   (test/check "legacy facade delegates to the canonical implementation"
               (let [value (fixture)]
                 (legacy/start value)
                 (legacy/kill value)
                 (deref (:events value)))
               [:start :kill])])''',
        '''               [:start :stop])])''',
    )

    replace_once(
        "core/lib/test/std/context_test.hal",
        "            [std.context :as context]\n"
        "            [std.lib.context :as legacy]))",
        "            [std.context :as context]))",
    )
    replace_once(
        "core/lib/test/std/context_test.hal",
        '''      [:stop {:base 1 :local 2}]]])

   (test/check
    "legacy context facade returns canonical value identities"
    (with-test-context
     (fn []
       (let [runtime (legacy/runtime-null)
             space (legacy/space)
             pointer (legacy/pointer :legacy {:value 1})]
         [(instance? context/runtime-null-type runtime)
          (instance? context/space-type space)
          (instance? context/pointer-type pointer)
          (legacy/space? space)
          (legacy/pointer? pointer)
          (legacy/ptr-context pointer)])))
    [true true true true true :legacy])])''',
        '''      [:stop {:base 1 :local 2}]]])])''',
    )

    replace_once(
        "core/rust/standard-library.namespaces",
        "std.lib.component\n",
        "",
    )
    replace_once(
        "core/rust/standard-library.namespaces",
        "std.lib.context\n",
        "",
    )

    old_rust_probe = r'''    #[test]
    fn canonical_component_and_context_libraries_load_without_old_aliases() {
        let mut runtime = Runtime::new();
        assert_eq!(
            runtime
                .eval_text(
                    "(ns std-lib-context-rust-probe \
                       (:require [std.lib.component :as component] \
                                 [std.lib.context :as context])) \
                     (let [runtime (context/runtime-null)] \
                       [(component/started? runtime) \
                        (context/call runtime :a :b)])"
                )
                .unwrap(),
            "[true [:a :b]]"
        );
        assert!(runtime
            .eval_text("(require [std.foundation.component :as old])")
            .unwrap_err()
            .contains("missing"));
    }
'''
    new_rust_probe = r'''    #[test]
    fn canonical_component_and_context_libraries_load_without_legacy_facades() {
        let mut runtime = Runtime::new();
        assert_eq!(
            runtime
                .eval_text(
                    "(ns std-context-rust-probe \
                       (:require [std.foundation.component :as component] \
                                 [std.context :as context])) \
                     (let [runtime (context/runtime-null)] \
                       [(component/started? runtime) \
                        (context/call runtime :a :b)])"
                )
                .unwrap(),
            "[true [:a :b]]"
        );

        for legacy in [
            ["std", "lib", "component"].join("."),
            ["std", "lib", "context"].join("."),
        ] {
            let mut legacy_runtime = Runtime::new();
            let error = legacy_runtime
                .eval_text(&format!("(require [{legacy} :as legacy])"))
                .unwrap_err();
            assert!(error.contains("missing"), "{legacy}: {error}");
        }
    }
'''
    replace_once("core/rust/src/lib.rs", old_rust_probe, new_rust_probe)

    old_browser_probe = '''test("canonical component and context libraries run through browser wasm", () => {
  const runtime = new Runtime();
  const result = runtime.eval(
    "(ns std-context-browser-probe" +
      " (:require [std.foundation.component :as component]" +
      "           [std.context :as context]" +
      "           [std.lib.context :as legacy]))" +
      " (let [runtime (context/runtime-null)" +
      "       legacy-runtime (legacy/runtime-null)]" +
      " [(component/started? runtime)" +
      "  (context/call runtime :a :b)" +
      "  (instance? context/runtime-null-type legacy-runtime)" +
      "  (legacy/call legacy-runtime :c)])",
  );

  assert.equal(result, "[true [:a :b] true [:c]]");
});
'''
    new_browser_probe = '''test("canonical component and context libraries run through browser wasm", () => {
  const runtime = new Runtime();
  const result = runtime.eval(
    "(ns std-context-browser-probe" +
      " (:require [std.foundation.component :as component]" +
      "           [std.context :as context]))" +
      " (let [runtime (context/runtime-null)]" +
      " [(component/started? runtime)" +
      "  (context/call runtime :a :b)])",
  );

  assert.equal(result, "[true [:a :b]]");
});
'''
    replace_once(
        "core/rust/web/portable-code-test.test.mjs",
        old_browser_probe,
        new_browser_probe,
    )

    remove("core/lib/src/std/lib/component.hal")
    remove("core/rust/hal-src/std/lib/component.hal")
    remove("core/lib/test/std/lib/component_test.hal")
    remove("core/lib/src/std/lib/context.hal")
    remove("core/rust/hal-src/std/lib/context.hal")
    remove("core/lib/test/std/lib/context_test.hal")

    audit = textwrap.dedent(
        '''\
        #!/usr/bin/env python3
        # Reject retired component/context facades and namespace references.

        from __future__ import annotations

        import sys
        from pathlib import Path

        ROOT = Path(__file__).resolve().parents[2]
        MAX_TEXT_BYTES = 2 * 1024 * 1024
        SKIP_PARTS = {
            ".git",
            ".next",
            "build",
            "dist",
            "node_modules",
            "target",
        }
        SKIP_ROOTS = {
            "hara-benchmarks",
            "hara-specs-registry",
        }
        FORBIDDEN_NAMES = (
            "std.lib." + "component",
            "std.lib." + "context",
            "std.foundation." + "context",
        )
        FORBIDDEN_PATHS = (
            Path("core/lib/src/std/lib") / "component.hal",
            Path("core/rust/hal-src/std/lib") / "component.hal",
            Path("core/lib/src/std/lib") / "context.hal",
            Path("core/rust/hal-src/std/lib") / "context.hal",
        )


        def skipped(relative: Path) -> bool:
            if relative.parts and relative.parts[0] in SKIP_ROOTS:
                return True
            return any(part in SKIP_PARTS for part in relative.parts)


        def main() -> int:
            errors: list[str] = []

            for relative in FORBIDDEN_PATHS:
                if (ROOT / relative).exists():
                    errors.append(f"retired compatibility source remains: {relative}")

            for path in ROOT.rglob("*"):
                if not path.is_file():
                    continue
                relative = path.relative_to(ROOT)
                if skipped(relative):
                    continue
                try:
                    if path.stat().st_size > MAX_TEXT_BYTES:
                        continue
                    source = path.read_text(encoding="utf-8")
                except (OSError, UnicodeDecodeError):
                    continue

                for line_number, line in enumerate(source.splitlines(), 1):
                    for token in FORBIDDEN_NAMES:
                        if token in line:
                            errors.append(
                                f"{relative}:{line_number}: retired namespace "
                                f"reference {token!r}"
                            )

            if errors:
                for error in errors:
                    print(error, file=sys.stderr)
                return 1

            print(
                "component/context hard-cut audit passed: "
                "only std.foundation.component and std.context remain"
            )
            return 0


        if __name__ == "__main__":
            raise SystemExit(main())
        '''
    )
    write("scripts/runtime/check-component-context-hard-cut", audit)

    workflow_anchor = '''      - name: Enforce gw.* HAL namespaces
        if: steps.scope.outputs.run_core == 'true'
'''
    workflow_replacement = '''      - name: Enforce component/context namespace hard cut
        run: python3 scripts/runtime/check-component-context-hard-cut

      - name: Enforce gw.* HAL namespaces
        if: steps.scope.outputs.run_core == 'true'
'''
    replace_once(
        ".github/workflows/core-ci.yml",
        workflow_anchor,
        workflow_replacement,
    )

    if SELF.exists():
        SELF.unlink()
    if WORKFLOW.exists():
        WORKFLOW.unlink()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
