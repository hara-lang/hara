def top_level_forms(text: str) -> list[str]:
    forms: list[str] = []
    start: int | None = None
    depth = 0
    in_string = False
    escaped = False
    in_comment = False
    for index, char in enumerate(text):
        if in_comment:
            if char == "\n":
                in_comment = False
            continue
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            continue
        if char == ";":
            in_comment = True
            continue
        if char == '"':
            in_string = True
            continue
        if char == "(":
            if depth == 0:
                start = index
            depth += 1
        elif char == ")" and depth:
            depth -= 1
            if depth == 0 and start is not None:
                forms.append(text[start : index + 1])
                start = None
    if depth != 0:
        raise RuntimeError("unbalanced top-level form")
    return forms


def form_head(form: str) -> str | None:
    match = re.match(r"\(\s*([^\s\[\](){}]+)", form)
    return match.group(1) if match else None


def skip_metadata(source: str, offset: int) -> int:
    length = len(source)
    while True:
        while offset < length and source[offset].isspace():
            offset += 1
        if offset >= length or source[offset] != "^":
            return offset
        offset += 1
        while offset < length and source[offset].isspace():
            offset += 1
        if offset < length and source[offset] in "{[":
            opener = source[offset]
            closer = "}" if opener == "{" else "]"
            depth = 0
            in_string = False
            escaped = False
            while offset < length:
                char = source[offset]
                if in_string:
                    if escaped:
                        escaped = False
                    elif char == "\\":
                        escaped = True
                    elif char == '"':
                        in_string = False
                elif char == '"':
                    in_string = True
                elif char == opener:
                    depth += 1
                elif char == closer:
                    depth -= 1
                    if depth == 0:
                        offset += 1
                        break
                offset += 1
        else:
            while offset < length and not source[offset].isspace():
                offset += 1


def definition(form: str) -> dict[str, str] | None:
    head = form_head(form)
    if head not in DEFINE_HEADS:
        return None
    cursor = form.find(head) + len(head)
    cursor = skip_metadata(form, cursor)
    match = re.match(r"([^\s\[\](){}]+)", form[cursor:])
    if not match:
        raise RuntimeError(f"cannot read definition name from {form[:100]!r}")
    name = match.group(1)
    prefix = form[:cursor]
    if "^:private" in prefix or ":private true" in prefix:
        return None
    return {"head": head, "name": name}


def namespace_name(forms: list[str]) -> str:
    for form in forms:
        if form_head(form) == "ns":
            match = re.match(r"\(\s*ns\s+([^\s\[\](){}]+)", form)
            if match:
                return match.group(1)
    raise RuntimeError("namespace form not found")


def inventory(path: Path, display_path: str) -> dict[str, Any]:
    forms = top_level_forms(path.read_text(encoding="utf-8"))
    namespace = namespace_name(forms)
    definitions = [item for form in forms if (item := definition(form))]
    references = [f"{namespace}/{item['name']}" for item in definitions]
    if len(references) != len(set(references)):
        raise RuntimeError(f"duplicate definitions in {display_path}")
    return {
        "namespace": namespace,
        "path": display_path,
        "definitions": definitions,
        "references": references,
    }


def put(
    records: dict[str, dict[str, str | None]],
    source: str,
    *,
    target: str | None,
    disposition: str,
    stage_from: str,
    stage_to: str,
    reason: str,
    validation: str | None,
) -> None:
    if source in records:
        raise RuntimeError(f"duplicate disposition for {source}")
    records[source] = {
        "target": target,
        "disposition": disposition,
        "stage_from": stage_from,
        "stage_to": stage_to,
        "reason": reason,
        "validation": validation,
    }


def adapted(
    records: dict[str, dict[str, str | None]],
    source: str,
    target: str,
    stage_from: str,
    stage_to: str,
    reason: str,
    validation: str = SCRIPT_VALIDATION,
    disposition: str = "adapted",
) -> None:
    put(
        records,
        source,
        target=target,
        disposition=disposition,
        stage_from=stage_from,
        stage_to=stage_to,
        reason=reason,
        validation=validation,
    )


def obsolete(
    records: dict[str, dict[str, str | None]],
    source: str,
    stage_from: str,
    stage_to: str,
    reason: str,
) -> None:
    put(
