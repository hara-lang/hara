def quote_symbol(value: str) -> str:
    return "'" + value


def render_child(
    units: list[dict[str, Any]],
    source_references: list[str],
    records: dict[str, dict[str, str | None]],
) -> str:
    paths = {
        reference: unit["path"]
        for unit in units
        for reference in unit["references"]
    }
    targets: list[str] = []
    validations: list[str] = []
    for reference in source_references:
        record = records[reference]
        target = record["target"]
        validation = record["validation"]
        if target and target not in targets:
            targets.append(target)
        if validation and validation not in validations:
            validations.append(validation)

    unit_forms: list[str] = []
    for unit in units:
        references = "\n".join(
            "     " + quote_symbol(reference) for reference in unit["references"]
        )
        unit_forms.append(
            "  {:namespace "
            + quote_symbol(unit["namespace"])
            + "\n   :path "
            + json.dumps(unit["path"])
            + "\n   :references\n   [\n"
            + references
            + "\n   ]}"
        )

    ledger_forms: list[str] = []
    for reference in source_references:
        record = records[reference]
        lines = ["  {:source/refer " + quote_symbol(reference)]
        if record["target"]:
            lines.append("   :target/refer " + quote_symbol(str(record["target"])))
        lines.extend(
            [
                "   :disposition :" + str(record["disposition"]),
                "   :stage/from :" + str(record["stage_from"]),
                "   :stage/to :" + str(record["stage_to"]),
                "   :reason :" + str(record["reason"]),
                "   :provenance",
                f'   {{:repository "{SOURCE_REPOSITORY}"',
                f'    :revision "{SOURCE_REVISION}"',
                "    :path " + json.dumps(paths[reference]) + "}",
            ]
        )
        if record["validation"]:
            lines.append("   :validation " + quote_symbol(str(record["validation"])))
        lines[-1] += "}"
        ledger_forms.append("\n".join(lines))

    compatibility_forms = [
        "  {:surface "
        + quote_symbol(surface)
        + "\n   :authority "
        + quote_symbol(authority)
        + "\n   :compatibility "
        + quote_symbol(copy)
        + "\n   :disposition :"
        + disposition
        + "\n   :reason :grammar-derived-lang-core-publication-is-authoritative}"
        for surface, authority, copy, disposition in COMPATIBILITY
    ]

    return f'''(ns tool.migrate.script)

(def +foundation-script-source+
  {{:repository "{SOURCE_REPOSITORY}"
   :revision "{SOURCE_REVISION}"}})

(def +foundation-script-source-units+
 [
{chr(10).join(unit_forms)}
 ])

(def +foundation-script-source-references+
  (vec
   (mapcat (fn [unit]
             (get unit :references))
           +foundation-script-source-units+)))

(def +foundation-script-target-references+
 [
{chr(10).join('  ' + quote_symbol(target) for target in targets)}
 ])

(def +foundation-script-validation-references+
 [
{chr(10).join('  ' + quote_symbol(validation) for validation in validations)}
 ])

(def +foundation-script-ledger+
 [
{chr(10).join(ledger_forms)}
 ])

(def +foundation-script-compatibility-ledger+
 [
{chr(10).join(compatibility_forms)}
 ])

(defn foundation-script-inventory
  []
  {{:source/references +foundation-script-source-references+
   :target/references +foundation-script-target-references+
   :validation/references +foundation-script-validation-references+}})
'''


def render_test(
    units: list[dict[str, Any]],
    source_references: list[str],
    records: dict[str, dict[str, str | None]],
) -> str:
    counts = Counter(str(records[reference]["disposition"]) for reference in source_references)
    expected_counts = "{" + " ".join(
        f":{name} {counts[name]}" for name in sorted(counts)
    ) + "}"
    surfaces = "[" + " ".join(quote_symbol(item[0]) for item in COMPATIBILITY) + "]"
    paths = "[" + " ".join(json.dumps(unit["path"]) for unit in units) + "]"
    return f'''(ns tool.migrate-script-test
  (:use code.test)
  (:require [tool.migrate :as migrate]
            [tool.migrate.script :as script]))

(defn disposition-counts
  [records]
  (reduce (fn [counts record]
            (update counts
                    (get record :disposition)
                    (fn [current]
                      (inc (or current 0)))))
          {{}}
          records))

(def results
