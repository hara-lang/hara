def patch_migrate(source: str) -> str:
    if "[tool.migrate.script]" not in source:
        anchor = (
            "  (:require [code.framework :as framework]\n"
            "            [code.manage.unit.structure :as structure]"
        )
        replacement = (
            "  (:require [code.framework :as framework]\n"
            "            [code.manage.unit.structure :as structure]\n"
            "            [tool.migrate.script]\n"
            "            [std.foundation :as f]"
        )
        if source.count(anchor) != 1:
            raise RuntimeError("tool.migrate require anchor changed")
        source = source.replace(anchor, replacement)
    if "(f/intern-all tool.migrate.script)" not in source:
        anchor = "))\n\n(def rule-id :std.task/def-work)"
        replacement = "))\n\n(f/intern-all tool.migrate.script)\n\n(def rule-id :std.task/def-work)"
        if source.count(anchor) != 1:
            raise RuntimeError("tool.migrate publication anchor changed")
        source = source.replace(anchor, replacement)
    return source


def target_references(
    repo_root: Path,
    records: dict[str, dict[str, str | None]],
) -> list[str]:
    available: set[str] = set()
    for relative in TARGET_FILES:
        unit = inventory(repo_root / relative, relative)
        available.update(unit["references"])
    active = [
        str(record["target"])
        for record in records.values()
        if record["target"] is not None
    ]
    missing = sorted(set(active) - available)
    if missing:
        raise RuntimeError(f"active targets are absent from product source: {missing}")
    return active


def output_files(
    repo_root: Path,
    foundation_root: Path,
) -> tuple[dict[Path, str], dict[str, Any]]:
    units = [
        inventory(foundation_root / relative, relative)
        for relative in SOURCE_FILES
    ]
    source_references = [
        reference
        for unit in units
        for reference in unit["references"]
    ]
    if len(source_references) != 86:
        raise RuntimeError(
            f"expected 86 pinned script references, found {len(source_references)}"
        )
    if len(source_references) != len(set(source_references)):
        raise RuntimeError("pinned script inventory contains duplicate references")
    records = build_records(source_references)
    target_references(repo_root, records)

    migrate_path = repo_root / "core/lib/src/code/migrate.hal"
    outputs = {
        repo_root / "core/lib/src/code/migrate/script.hal": render_child(
            units, source_references, records
        ),
        repo_root / "core/lib/test/code/migrate_script_test.hal": render_test(
            units, source_references, records
        ),
        migrate_path: patch_migrate(migrate_path.read_text(encoding="utf-8")),
    }
    report = {
        "source_repository": SOURCE_REPOSITORY,
        "source_revision": SOURCE_REVISION,
        "source_references": len(source_references),
        "source_units": len(units),
        "target_references": len(
            {
                record["target"]
                for record in records.values()
                if record["target"] is not None
            }
        ),
        "compatibility_surfaces": len(COMPATIBILITY),
        "dispositions": dict(sorted(Counter(
            str(record["disposition"]) for record in records.values()
        ).items())),
    }
    return outputs, report


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo-root", default=".")
    parser.add_argument("--foundation-root", required=True)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--write", action="store_true")
    mode.add_argument("--check", action="store_true")
    args = parser.parse_args()

    repo_root = Path(args.repo_root).resolve()
    foundation_root = Path(args.foundation_root).resolve()
    outputs, report = output_files(repo_root, foundation_root)

    stale: list[str] = []
    for path, expected in outputs.items():
        if args.write:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(expected, encoding="utf-8")
        else:
            actual = path.read_text(encoding="utf-8") if path.exists() else None
            if actual != expected:
                stale.append(str(path.relative_to(repo_root)))

    if stale:
        raise SystemExit("stale script migration materialization: " + ", ".join(stale))
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
