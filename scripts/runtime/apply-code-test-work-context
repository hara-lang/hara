#!/usr/bin/env python3
"""Remove the protocol-shaped code.test replacement objects.

This is intentionally a hard cut: the deleted ITest* protocols must not be
recreated as code.test-specific structs. Runtime lifecycle and observation are
owned by std.work; the fact catalog remains ordinary domain state.
"""

from __future__ import annotations

import re
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def read(path: str) -> str:
    return (ROOT / path).read_text(encoding="utf-8")


def write(path: str, content: str) -> None:
    (ROOT / path).write_text(content, encoding="utf-8")


def replace_once(path: str, old: str, new: str) -> None:
    source = read(path)
    count = source.count(old)
    if count != 1:
        raise SystemExit(f"{path}: expected one occurrence of {old!r}, found {count}")
    write(path, source.replace(old, new, 1))


def regex_once(path: str, pattern: str, replacement: str) -> None:
    source = read(path)
    updated, count = re.subn(pattern, replacement, source, count=1, flags=re.DOTALL)
    if count != 1:
        raise SystemExit(f"{path}: migration pattern did not match exactly once")
    write(path, updated)


CODE_TEST_FILES = [
    "core/lib/src/code/test.hal",
    "core/rust/hal-src/code/test.hal",
]

replacement_head = r'''(defstruct Matcher [predicate expected])
(defstruct ThrownValue [error])
(defstruct TimeoutValue [milliseconds])

;; Fact registration is evaluator-local domain state, not a provider protocol.
(def +registry+ (atom {}))

(defn clear-namespace-state
  [state namespace]
  (loop [output state
         remaining (keys state)]
    (if (seq remaining)
      (let [key (first remaining)]
        (recur (if (= namespace (first key))
                 (dissoc output key)
                 output)
               (rest remaining)))
      output)))

(defn registry-register
  [registry fact]
  (do
    (swap! registry
           (fn [state]
             (assoc state [(:namespace fact) (:name fact)] fact)))
    fact))

(defn registry-remove
  [registry namespace name]
  (let [key [namespace name]
        found (get (deref registry) key)]
    (swap! registry (fn [state] (dissoc state key)))
    found))

(defn registry-clear
  [registry namespace]
  (if namespace
    (swap! registry clear-namespace-state namespace)
    (reset! registry {})))

(defn registry-facts
  [registry]
  (vec (vals (deref registry))))

(defn registry-find
  [registry namespace name]
  (get (deref registry) [namespace name]))

(defn report-event
  "Compatibility delivery for direct run-fact callers.

   Canonical suite execution emits durable :test/* events through std.work and
   uses IWorkObserver. This local adapter accepts only an ordinary function."
  [reporter event]
  (if reporter
    (let [result (reporter event)]
      (if (nil? result) event result))
    event))

(extend-type Matcher std.protocol.imatch/IMatch'''

for path in CODE_TEST_FILES:
    regex_once(
        path,
        r"\(defstruct TestRegistry \[state\]\).*?\(extend-type Matcher std\.protocol\.imatch/IMatch",
        replacement_head,
    )
    replace_once(
        path,
        "(def +registry+ (code.test/TestRegistry (atom {})))\n(def +null-reporter+ (code.test/NullReporter nil))\n",
        "",
    )
    regex_once(
        path,
        r"\(defn event-reporter.*?\n\(defn exactly",
        "(defn exactly",
    )
    replace_once(
        path,
        "(deref (field +registry+ :state))",
        "(deref +registry+)",
    )
    replace_once(
        path,
        "reporter (or (:reporter options) +null-reporter+)",
        "reporter (:reporter options)",
    )

    regex_once(
        path,
        r"\(defn timed-settle.*?\n\(defn check",
        r'''(defn timed-settle
  [options promise milliseconds]
  (let [timeout-function (:work/timeout-promise options)
        cancel-function (:work/cancel-timeout options)
        binding (timeout-function promise milliseconds)
        wrapped (if (map? binding) (:promise binding) binding)
        timeout (if (map? binding) (:timeout binding) nil)
        outcome (try
                  (deref wrapped)
                  (finally
                    (if (and timeout cancel-function)
                      (cancel-function timeout)
                      nil)))]
    (if (and (map? outcome) (= :timeout (:test/status outcome)))
      (code.test/TimeoutValue milliseconds)
      (if (and (map? outcome) (= :value (:test/status outcome)))
        (:value outcome)
        outcome))))

(defn settle
  "Returns an ordinary value, awaiting a Promise through generic std.work
   context capabilities when a timeout is requested."
  ([value]
   (settle value {}))
  ([value options]
   (if (promise? value)
     (if (and (:work/timeout-promise options) (:timeout options))
       (timed-settle options value (:timeout options))
       (deref value))
     value)))

(defn check''',
    )

    regex_once(
        path,
        r"\(defn clock-now.*?\n\(defn run-hook",
        r'''(defn clock-now
  [options]
  (let [now (:work/now options)]
    (if now (now) nil)))

(defn run-hook''',
    )

    regex_once(
        path,
        r"\(defn fact-cancelled\?.*?\n\(defn run-fact",
        r'''(defn fact-cancelled?
  [fact options]
  (if (:cancelled options) true false))

(defn run-fact''',
    )

    regex_once(
        path,
        r"\(defn work-context-options.*?\n\(defn suite-work",
        r'''(defn work-context-options
  [context]
  (let [base (or (:test/options context) {})
        now (:work/now context)
        timeout-promise (:work/timeout-promise context)
        cancel-timeout (:work/cancel-timeout context)]
    (merge base
           (if now {:work/now now} {})
           (if timeout-promise
             {:work/timeout-promise timeout-promise}
             {})
           (if cancel-timeout
             {:work/cancel-timeout cancel-timeout}
             {}))))

(defn work-execution-options
  [input context]
  (merge (or input {})
         (work-context-options context)))

(defn work-event-kind
  [event]
  (cond
    (= event :run/start) :test/run-started
    (= event :run/end) :test/run-completed
    (= event :fact/start) :test/fact-started
    (= event :fact/end) :test/fact-completed
    :else :test/event))

(defn work-reporter
  "Returns a local event function that commits through the active work frame."
  [context]
  (fn [event]
    (let [event-kind (work-event-kind (:event event))
          data (assoc (dissoc event :event)
                      :test/event (:event event))]
      (work/emit! context event-kind data)
      event)))

(defn suite-work''',
    )

    replace_once(
        path,
        "(run-selected nil\n                    (work-execution-options input context))",
        "(run-selected nil\n                    (assoc (work-execution-options input context)\n                           :reporter\n                           (work-reporter context)))",
    )

# code.test.work now reuses the canonical work-event adapter and never carries
# a private reporter object or delegate.
for path in [
    "core/lib/src/code/test/work.hal",
    "core/rust/hal-src/code/test/work.hal",
]:
    regex_once(
        path,
        r"\(defn work-event-kind.*?\n\(def \+default-revision\+",
        r'''(def work-event-kind test/work-event-kind)
(def work-reporter test/work-reporter)

(defn reporter-for
  [options context]
  (test/work-reporter context))

(def +default-revision+''',
    )

# Canonical HAL tests use IWorkObserver and generic work context capabilities.
write(
    "core/lib/test/code/test_test.hal",
    r'''(ns code.test-test
  (:use code.test)
  (:require [std.lib.test :as legacy]
            [std.work :as work]))

(fact "evaluates ordinary equality"
  (+ 20 22) => 42
  (+ 1 2 3) => 6)

(fact "awaits promise-returning assertions"
  (promise/from 42) => 42)

(fact "matches thrown values"
  (throw "expected") => (throws))

(fact "supports predicate matchers"
  {:tags [:unit :matcher]}
  42 => (satisfies (fn [value] (= 42 value)))

  [2 1] => (just [1 2] :in-any-order)
  [3 1 2] => (contains [1 2] :in-any-order)
  [["b" 2] ["a" 1]] => (just [["a" 1] ["b" 2]] :in-any-order))

(fact "records skipped facts"
  {:skip true :tags [:slow]}
  (throw "must not run") => :never)

(def lifecycle (atom []))

(fact "runs promise-aware fixtures"
  {:before (fn []
             (swap! lifecycle (fn [events] (conj events :before))))
   :after (fn []
            (swap! lifecycle (fn [events] (conj events :after))))}
  (promise/from :ready) => :ready)

(def observer (work/recording-observer))
(def summary
  (run (work/local-runtime {:observer observer})
       {:namespace "code.test-test"}))
(def positional-summary (run '[missing]))

(def timeout-result
  (check
   (fn [] (promise/from 42))
   42
   {:work/timeout-promise
    (fn [promise milliseconds]
      {:promise (promise/from {:test/status :timeout})
       :timeout milliseconds})
    :work/cancel-timeout (fn [timeout] timeout)
    :timeout 25}))

(def fixture-events (atom []))
(def fixture-summary
  (run {:namespace "code.test-test"
        :name "evaluates ordinary equality"
        :before-all (fn []
                      (swap! fixture-events
                             (fn [events] (conj events :before-all))))
        :before-each (fn []
                       (swap! fixture-events
                              (fn [events] (conj events :before-each))))
        :after-each (fn []
                      (swap! fixture-events
                             (fn [events] (conj events :after-each))))
        :after-all (fn []
                     (swap! fixture-events
                            (fn [events] (conj events :after-all))))}))

(def tagged-summary
  (run {:namespace "code.test-test"
        :include-tags :matcher}))

(def fail-fast-runs (atom 0))
(register! "fail-fast/1"
           (fn [options]
             [{:pass false :actual :no :expected :yes}]))
(register! "fail-fast/2"
           (fn [options]
             (do
               (swap! fail-fast-runs inc)
               [{:pass true :actual :yes :expected :yes}])))
(def fail-fast-summary
  (run {:namespace "code.test-test"
        :name "fail-fast/"
        :fail-fast true}))
(remove-fact "fail-fast/1")
(remove-fact "fail-fast/2")

(def clock-values (atom [10 18]))
(def timed-result
  (run-fact
   (get-fact "code.test-test" "evaluates ordinary equality")
   nil
   {:work/now
    (fn []
      (let [value (first (deref clock-values))]
        (swap! clock-values rest)
        value))}))

(defn test-event?
  [event]
  (let [kind (:event event)]
    (or (= kind :test/run-started)
        (= kind :test/fact-started)
        (= kind :test/fact-completed)
        (= kind :test/run-completed))))

(def test-events
  (vec
   (map (fn [event] (:event event))
        (filter test-event?
                (work/observer-events observer)))))

(def results
  [(legacy/check "archived positional namespace selectors are supported"
                 [(get positional-summary :status)
                  (get positional-summary :facts)
                  (get positional-summary :checks)]
                 [:passed 0 0])
   (legacy/check "portable facts pass"
                 [(get summary :status)
                  (get (get summary :counts) :passed)
                  (count (get summary :results))
                  (count (get (first (get summary :results)) :checks))
                  (deref lifecycle)]
