#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
MANIFEST="$ROOT/core/rust/interpreter-observation-raw/Cargo.toml"
PROFILE=${HARA_INTERPRETER_OBSERVATION_PROFILE:-browser-release}
TARGET=${HARA_INTERPRETER_OBSERVATION_TARGET:-wasm32-unknown-unknown}
TARGET_DIR="$ROOT/core/rust/interpreter-observation-raw/target"
WASM="$TARGET_DIR/$TARGET/$PROFILE/hara_interpreter_observation_raw.wasm"

cargo build \
  --manifest-path "$MANIFEST" \
  --target "$TARGET" \
  --profile "$PROFILE"

test -s "$WASM"
echo "$WASM"
