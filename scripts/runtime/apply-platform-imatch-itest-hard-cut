#!/usr/bin/env python3
"""Apply the platform-owned IMatch and std.work-owned test-runtime hard cut.

This is a one-shot branch migration helper. It removes itself and its temporary
workflow after producing the reviewable source delta.
"""

from __future__ import annotations

import re
import shutil
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def read(relative: str) -> str:
    return (ROOT / relative).read_text(encoding="utf-8")


def write(relative: str, content: str) -> None:
    path = ROOT / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def replace_once(relative: str, old: str, new: str) -> None:
    source = read(relative)
    if new in source:
        return
    if source.count(old) != 1:
        raise SystemExit(
            f"expected exactly one migration anchor in {relative}: {old[:100]!r}; "
            f"found {source.count(old)}"
        )
    write(relative, source.replace(old, new, 1))


def replace_regex(relative: str, pattern: str, replacement: str) -> None:
    source = read(relative)
    updated, count = re.subn(pattern, replacement, source, count=1, flags=re.DOTALL)
    if count != 1:
        raise SystemExit(f"regex migration anchor not found in {relative}: {pattern!r}")
    write(relative, updated)


def delete(relative: str) -> None:
    path = ROOT / relative
    if path.exists():
        path.unlink()


def mirror(relative: str) -> None:
    source = ROOT / "core/lib/src" / relative
    target = ROOT / "core/rust/hal-src" / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)


# ---------------------------------------------------------------------------
# #497: platform-owned IMatch on Java and Rust/browser-Wasm.
# ---------------------------------------------------------------------------
replace_once(
    "core/java/src/main/java/hara/truffle/HaraJavaAdapters.java",
    '    installLookup(context.defineProtocol("ILookup", Map.of("lookup", -1)));\n'
    '    context.defineProtocol("IMutable", Map.of());',
    '    installLookup(context.defineProtocol("ILookup", Map.of("lookup", -1)));\n'
    '    context.defineProtocol("IMatch", Map.of("match-value", 2));\n'
    '    context.defineProtocol("IMutable", Map.of());',
)

replace_once(
    "core/rust/src/core.rs",
    '    ("ILookup", &[("lookup", usize::MAX)]),\n'
    '    ("IMutable", &[]),',
    '    ("ILookup", &[("lookup", usize::MAX)]),\n'
    '    ("IMatch", &[("match-value", 2)]),\n'
    '    ("IMutable", &[]),',
)

# IContextEval is language-runtime-owned, not a platform protocol.
write(
    "core/lib/src/lang/protocol/runtime.hal",
    """(ns lang.protocol.runtime)

(defprotocol IEvalTransport
  (exchange [transport request options]))

;; Promise-first evaluation boundary owned by the language runtime. Runtime
;; implementations own their profiles; callers supply portable requests and
;; options without depending on a platform-wide std.protocol identity.
(defprotocol IContextEval
  (evaluate [context request options])
  (evaluate-raw [context request options]))
""",
)

context_eval_consumers = [
    "core/lib/src/lang/core/eval.hal",
    "core/lib/src/lang/core/runtime.hal",
    "core/lib/src/lang/runtime/basic/type_basic.hal",
    "core/lib/src/lang/runtime/basic/type_hara.hal",
    "core/lib/src/lang/runtime/postgres/db_client.hal",
    "scripts/runtime/migrate-tahto-metadata-to-lang",
]
for relative in context_eval_consumers:
    source = read(relative)
    if "std.protocol.icontexteval" not in source:
        raise SystemExit(f"IContextEval migration anchor missing in {relative}")
    write(relative, source.replace("std.protocol.icontexteval", "lang.protocol.runtime"))

# ---------------------------------------------------------------------------
# #498: ordinary test-domain data/functions over std.work, no ITest runtime.
# ---------------------------------------------------------------------------
write(
    "core/lib/src/code/test/protocol.hal",
    """;; Compatibility facade for the one retained test-domain protocol.
;; Test lifecycle, reporting, clocks, deadlines, cancellation and registries
;; are ordinary code.test/std.work functions and data.
(ns code.test.protocol
  (:require [std.protocol.imatch :as match]))

(def IMatcher match/IMatch)
(def IMatch match/IMatch)
(def -match-value match/match-value)
(def match-value match/match-value)
""",
)

ordinary_test_adapters = r'''(defn registry-register
  [registry fact]
  (do
    (swap! (field registry :state)
           (fn [state]
             (assoc state [(:namespace fact) (:name fact)] fact)))
    fact))

(defn registry-remove
  [registry namespace name]
  (let [key [namespace name]
        found (get (deref (field registry :state)) key)]
    (swap! (field registry :state)
           (fn [state] (dissoc state key)))
    found))

(defn registry-clear
  [registry namespace]
  (if namespace
    (swap! (field registry :state) clear-namespace-state namespace)
    (reset! (field registry :state) {})))

(defn registry-facts
  [registry]
  (vec (vals (deref (field registry :state)))))

(defn registry-find
  [registry namespace name]
  (get (deref (field registry :state)) [namespace name]))

(defn report-event
  "Delivers one test-domain event through ordinary data/function adapters."
  [reporter event]
  (cond
    (or (nil? reporter)
        (instance? code.test/NullReporter reporter))
    event

    (instance? code.test/EventReporter reporter)
    (do
      (swap! (field reporter :events)
             (fn [events] (conj events event)))
      event)

    (fn? reporter)
    (let [result (reporter event)]
      (if (nil? result) event result))

    (and (map? reporter) (fn? (:report-event reporter)))
    (let [result ((:report-event reporter) event)]
      (if (nil? result) event result))

    :else
    (throw
     (ex-info "Unsupported test reporter"
              {:reporter reporter}))))

(defn now-ms
  "Reads an ordinary host clock function or compatibility clock value."
  [clock]
  (cond
    (nil? clock)
    nil

    (instance? code.test/FunctionClock clock)
    ((field clock :function))

    (fn? clock)
    (clock)

    (and (map? clock) (fn? (:now-ms clock)))
    ((:now-ms clock))

    :else
    (throw
     (ex-info "Unsupported test clock"
              {:clock clock}))))

(defn timeout-promise
  "Applies an ordinary timeout function to a promise."
  [timer promise milliseconds]
  (cond
    (instance? code.test/FunctionTimer timer)
    ((field timer :timeout-function) promise milliseconds)

    (fn? timer)
    (timer promise milliseconds)

    (and (map? timer) (fn? (:timeout-promise timer)))
    ((:timeout-promise timer) promise milliseconds)

    :else
    (throw
     (ex-info "Unsupported test timer"
              {:timer timer}))))

(defn cancel-timeout
  "Cancels an ordinary timeout handle when one exists."
  [timer timeout]
  (cond
    (or (nil? timer) (nil? timeout))
    nil

    (instance? code.test/FunctionTimer timer)
    ((field timer :cancel-function) timeout)

    (and (map? timer) (fn? (:cancel-timeout timer)))
    ((:cancel-timeout timer) timeout)

    :else
    nil))

(defn cancelled?
  "Evaluates an ordinary cancellation predicate for a fact."
  [control fact]
  (cond
    (nil? control)
    false

    (instance? code.test/FunctionControl control)
    ((field control :function) fact)

    (fn? control)
    (control fact)

    (and (map? control) (fn? (:cancelled? control)))
    ((:cancelled? control) fact)

    :else
    (throw
     (ex-info "Unsupported test cancellation control"
              {:control control}))))
'''

replace_regex(
    "core/lib/src/code/test.hal",
    r"\(extend-type TestRegistry protocol/ITestRegistry.*?\n\n\(extend-type Matcher protocol/IMatcher",
    ordinary_test_adapters + "\n(extend-type Matcher protocol/IMatcher",
)

code_test_replacements = {
    "protocol/timeout-promise": "timeout-promise",
    "protocol/cancel-timeout": "cancel-timeout",
    "protocol/registry-register": "registry-register",
    "protocol/registry-remove": "registry-remove",
    "protocol/registry-clear": "registry-clear",
    "protocol/registry-facts": "registry-facts",
    "protocol/registry-find": "registry-find",
    "protocol/report-event": "report-event",
    "protocol/now-ms": "now-ms",
    "protocol/cancelled?": "cancelled?",
}
source = read("core/lib/src/code/test.hal")
for old, new in code_test_replacements.items():
    source = source.replace(old, new)
write("core/lib/src/code/test.hal", source)

work_source = read("core/lib/src/code/test/work.hal")
work_source = work_source.replace(
    "            [code.test.protocol :as protocol]\n", ""
)
work_source = work_source.replace("(defstruct WorkReporter [context reporter])\n\n", "")
work_source, count = re.subn(
    r"\(extend-type WorkReporter protocol/ITestReporter.*?\n\n",
    "",
    work_source,
    count=1,
    flags=re.DOTALL,
)
if count != 1:
    raise SystemExit("WorkReporter protocol implementation anchor was not found")
work_source = work_source.replace(
    """(defn work-reporter
  [context reporter]
  (code.test.work/WorkReporter context reporter))""",
    """(defn work-reporter
  "Creates an ordinary event function that commits test events to std.work."
  [context reporter]
  (fn [event]
    (let [event-kind (work-event-kind (:event event))
          data (assoc (dissoc event :event)
                      :test/event (:event event))]
      (work/emit! context event-kind data)
      (if reporter
        (try
          (test/report! reporter event)
          (catch Throwable error event))
        event))))""",
)
write("core/lib/src/code/test/work.hal", work_source)

# ---------------------------------------------------------------------------
# Remove the file-backed platform/test runtime namespaces and their fixture.
# ---------------------------------------------------------------------------
removed_hal = [
    "std/protocol/icontexteval.hal",
    "std/protocol/imatch.hal",
    "std/protocol/itestclock.hal",
    "std/protocol/itestcontrol.hal",
    "std/protocol/itestregistry.hal",
    "std/protocol/itestreporter.hal",
    "std/protocol/itestsession.hal",
    "std/protocol/itesttimer.hal",
    "std/native/Test.hal",
]
for relative in removed_hal:
    delete(f"core/lib/src/{relative}")
    delete(f"core/rust/hal-src/{relative}")
delete("core/lib/test/std/native/Test_test.hal")

# Exact canonical/Rust mirrors for every changed portable source.
mirrored = [
    "code/test.hal",
    "code/test/protocol.hal",
    "code/test/work.hal",
    "lang/protocol/runtime.hal",
    "lang/core/eval.hal",
    "lang/core/runtime.hal",
    "lang/runtime/basic/type_basic.hal",
    "lang/runtime/basic/type_hara.hal",
    "lang/runtime/postgres/db_client.hal",
]
for relative in mirrored:
    mirror(relative)

inventory_path = "core/rust/standard-library.namespaces"
removed_namespaces = {
    "std.native.Test",
    "std.protocol.icontexteval",
    "std.protocol.imatch",
    "std.protocol.itestclock",
    "std.protocol.itestcontrol",
    "std.protocol.itestregistry",
    "std.protocol.itestreporter",
    "std.protocol.itestsession",
    "std.protocol.itesttimer",
}
lines = [
    line
    for line in read(inventory_path).splitlines()
    if line.strip() not in removed_namespaces
]
write(inventory_path, "\n".join(lines) + "\n")

# ---------------------------------------------------------------------------
# Cross-runtime and portable conformance coverage.
# ---------------------------------------------------------------------------
write(
    "core/lib/test/std/platform_imatch_test.hal",
    r'''(ns std.platform-imatch-test
  (:require [code.test :as code-test]
            [code.test.protocol :as protocol]
            [std.foundation.promise :as promise]
            [std.lib.test :as test]
            [std.protocol.imatch :as match]))

(defstruct EqualMatcher [expected])

(extend-type EqualMatcher match/IMatch
  (match-value [matcher actual]
    {:pass (= (field matcher :expected) actual)
     :actual actual
     :expected (field matcher :expected)}))

(def reporter (code-test/event-reporter))
(def reported (code-test/report! reporter {:event :probe :value 42}))
(def clock (code-test/function-clock (fn [] 17)))
(def control (code-test/function-control (fn [fact] (= :cancel (:name fact)))))
(def timer
  (code-test/function-timer
   (fn [value milliseconds] value)
   (fn [handle] nil)))

(def results
  [(test/check
    "IMatch resolves from the platform namespace and retains compatibility identity"
    [(= match/IMatch protocol/IMatch)
     (match/match-value (std.platform-imatch-test/EqualMatcher 42) 42)]
    [true {:pass true :actual 42 :expected 42}])

   (test/check
    "test reporting is ordinary data/function dispatch"
    [(code-test/reporter-events reporter) reported]
    [[{:event :probe :value 42}] {:event :probe :value 42}])

   (test/check
    "clock and cancellation adapters no longer require lifecycle protocols"
    [(code-test/clock-now {:clock clock})
     (code-test/fact-cancelled? {:name :cancel} {:control control})
     (code-test/fact-cancelled? {:name :run} {:control (fn [fact] false)})]
    [17 true false])

   (test/check
    "timer adapters remain ordinary host capabilities"
    (code-test/settle
     (promise/from 42)
     {:timer timer :timeout 10})
    42)])

(test/print-results results)
''',
)

write(
