# ---------------------------------------------------------------------------
# Permanent absolute namespace/test-runtime audits, with no allowlist.
# ---------------------------------------------------------------------------
write(
    "scripts/runtime/check-reserved-platform-namespaces",
    r'''#!/usr/bin/env python3
"""Reject file-backed std.native.* and std.protocol.* HAL namespaces."""

from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
NS_PATTERN = re.compile(r"(?m)^\s*\(ns\+?\s+([^\s\)]+)")
SKIP_PARTS = {".git", "node_modules", "target", ".next", "dist", "build"}
FORBIDDEN_PREFIXES = ("std.native.", "std.protocol.")
FORBIDDEN_TEST_RUNTIME = (
    "std.native.Test",
    "std.protocol.itest",
    "ITestClock",
    "ITestControl",
    "ITestRegistry",
    "ITestReporter",
    "ITestSession",
    "ITestTimer",
)


def skipped(path: Path) -> bool:
    return any(part in SKIP_PARTS for part in path.parts)


def main() -> int:
    errors: list[str] = []
    for path in ROOT.rglob("*.hal"):
        if not path.is_file() or skipped(path.relative_to(ROOT)):
            continue
        source = path.read_text(encoding="utf-8")
        match = NS_PATTERN.search(source)
        if match and match.group(1).startswith(FORBIDDEN_PREFIXES):
            errors.append(
                f"reserved platform namespace is file-backed: "
                f"{path.relative_to(ROOT)} declares {match.group(1)}"
            )

    audit_roots = [
        ROOT / "core/lib/src",
        ROOT / "core/lib/test",
        ROOT / "core/rust/hal-src",
    ]
    for root in audit_roots:
        if not root.exists():
            continue
        for path in root.rglob("*.hal"):
            if not path.is_file():
                continue
            source = path.read_text(encoding="utf-8")
            for token in FORBIDDEN_TEST_RUNTIME:
                if token in source:
                    errors.append(
                        f"retired test-runtime token {token!r} remains in "
                        f"{path.relative_to(ROOT)}"
                    )

    inventory = ROOT / "core/rust/standard-library.namespaces"
    if inventory.exists():
        for line in inventory.read_text(encoding="utf-8").splitlines():
            if line.startswith(FORBIDDEN_PREFIXES):
                errors.append(f"reserved namespace remains in inventory: {line}")

    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1

    print(
        "reserved platform namespace audit passed: no file-backed "
        "std.native.*, std.protocol.*, std.native.Test, or ITest* surface"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
''',
)
(ROOT / "scripts/runtime/check-reserved-platform-namespaces").chmod(0o755)

write(
    ".github/workflows/reserved-platform-namespaces.yml",
    r'''name: Reserved platform namespaces

on:
  push:
    paths:
      - '**/*.hal'
      - 'core/rust/standard-library.namespaces'
      - 'scripts/runtime/check-reserved-platform-namespaces'
      - '.github/workflows/reserved-platform-namespaces.yml'
  pull_request:
    branches: [main]
    paths:
      - '**/*.hal'
      - 'core/rust/standard-library.namespaces'
      - 'scripts/runtime/check-reserved-platform-namespaces'
      - '.github/workflows/reserved-platform-namespaces.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: reserved-platform-namespaces-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Reject file-backed native and protocol namespaces
        run: python3 scripts/runtime/check-reserved-platform-namespaces
''',
)

# Final migration assertions before removing this one-shot helper.
for relative in [
    "core/lib/src/code/test.hal",
    "core/lib/src/code/test/work.hal",
    "core/lib/src/code/test/protocol.hal",
]:
    source = read(relative)
    for token in (
        "ITestClock",
        "ITestControl",
        "ITestRegistry",
        "ITestReporter",
        "ITestSession",
        "ITestTimer",
    ):
        if token in source:
            raise SystemExit(f"retired protocol {token} remains in {relative}")

if "std.protocol.icontexteval" in read("scripts/runtime/migrate-tahto-metadata-to-lang"):
    raise SystemExit("migration script still references std.protocol.icontexteval")

# The final PR delta must not contain branch-mutation machinery.
delete(".github/workflows/_apply-platform-imatch-itest.yml")
delete("scripts/runtime/apply-platform-imatch-itest-hard-cut")
