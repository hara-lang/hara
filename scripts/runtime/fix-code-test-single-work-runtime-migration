#!/usr/bin/env python3
"""Restrict definition-token rewriting to prepared graph stages."""

from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
TARGET = ROOT / "scripts/runtime/apply-code-test-single-work-runtime"
source = TARGET.read_text(encoding="utf-8")

old = '''subject_pattern = re.compile(
    r"\\(resolve-fact \\(:namespace subject\\)\\s+\\(:name subject\\)\\)"
)
graph, prepared_resolution_count = subject_pattern.subn(
    "(resolve-subject-fact subject)", graph
)
if prepared_resolution_count != 7:
    raise SystemExit(
        "expected seven prepared fact resolution sites, "
        f"found {prepared_resolution_count}"
    )'''

new = '''subject_pattern = re.compile(
    r"\\(resolve-fact \\(:namespace subject\\)\\s+\\(:name subject\\)\\)"
)
graph_prefix, graph_marker, graph_stages = graph.partition("(defn fact-mode")
if not graph_marker:
    raise SystemExit("prepared fact stage boundary was not found")
graph_stages, prepared_resolution_count = subject_pattern.subn(
    "(resolve-subject-fact subject)", graph_stages
)
graph = graph_prefix + graph_marker + graph_stages
if prepared_resolution_count != 7:
    raise SystemExit(
        "expected seven prepared fact resolution sites, "
        f"found {prepared_resolution_count}"
    )'''

if source.count(old) != 1:
    raise SystemExit("prepared fact rewrite block was not found exactly once")

TARGET.write_text(source.replace(old, new, 1), encoding="utf-8")
Path(__file__).unlink()
