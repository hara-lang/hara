#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

log_dir="${RUNNER_TEMP:-${TMPDIR:-/tmp}}"
log="$log_dir/hara-connector-java-maven.log"

set +e
mvn -B -Ptruffle package --file core/java/pom.xml >"$log" 2>&1
status=$?
set -e

if [[ "$status" -ne 0 ]]; then
  printf '%s\n' '::group::Java Maven failure summary'
  grep -E '^\[(ERROR|WARNING)\]|Tests run:|Failures:|Errors:|Skipped:|<<< FAILURE!|There are test failures|BUILD FAILURE|Caused by:' "$log" \
    | tail -n 240 || true
  printf '%s\n' '::endgroup::'
  printf '%s\n' '::group::Java Maven failure tail'
  tail -n 320 "$log"
  printf '%s\n' '::endgroup::'
  exit "$status"
fi

tail -n 80 "$log"
./core/hara eval '(+ 19 23)'
