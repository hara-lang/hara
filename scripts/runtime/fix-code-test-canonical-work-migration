#!/usr/bin/env python3
"""Repair the canonical code.test migration boundary, then self-delete."""

from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
TARGET = ROOT / "scripts/runtime/apply-code-test-canonical-work"
source = TARGET.read_text(encoding="utf-8")

old = '''graph_match = re.search(
    r"\\(def \\+unsupported-batch-options\\+.*?(?=\\n\\(defn run-batch)",
    work_source,
    flags=re.DOTALL,
)'''
new = '''graph_match = re.search(
    r"\\(defn fact-identity.*?(?=\\n\\(defn run-batch)",
    work_source,
    flags=re.DOTALL,
)'''

if source.count(old) != 1:
    raise SystemExit("canonical graph extraction boundary was not found exactly once")

TARGET.write_text(source.replace(old, new, 1), encoding="utf-8")
Path(__file__).unlink()
