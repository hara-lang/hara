#!/usr/bin/env python3
"""Validate the split language-oriented source and test roots."""

from __future__ import annotations

import re
import sys
from collections import defaultdict
from pathlib import Path


REPOSITORY = Path(__file__).resolve().parents[2]

LANGUAGE_ROOTS = {
    Path("core/lib/src/lang"): "lang",
    Path("core/lib/test-lang/lang"): "lang",
    Path("core/lib/src-lang/xt"): "xt",
    Path("core/lib/src-lang/postgres"): "postgres",
    Path("core/lib/test-lang/xt"): "xt",
    Path("core/lib/test-lang/postgres"): "postgres",
}

PRODUCTION_ROOTS = (
    Path("core/lib/src"),
    Path("core/lib/src-lang"),
)
TEST_ROOTS = (
    Path("core/lib/test"),
    Path("core/lib/test-lang"),
)

LEGACY_ROOTS = (
    Path("core/lib/src-lang/lang"),
    Path("core/lib/test/lang"),
    Path("core/lib/src/tahto"),
    Path("core/lib/test/tahto"),
    Path("core/lib/src/xt"),
    Path("core/lib/src/postgres"),
    Path("core/lib/test/xt"),
    Path("core/lib/test/postgres"),
)

PUBLIC_MODEL_NAMESPACES = (
    "lang.model.v1.spec-xtalk",
    "lang.model.v1.spec-hara",
    "lang.model.v1.spec-js",
    "lang.model.v1.spec-python",
    "lang.model.v1.spec-lua",
    "lang.model.v1.spec-postgres",
)

LANG_PORT = Path("core/lib/lang-port.edn")
LANG_REGISTRY = Path("core/lib/src/lang/core/registry.hal")
NAMESPACE_PATTERN = re.compile(r"^\s*\(ns\+?\s+([^\s\)]+)", re.MULTILINE)
UNVERSIONED_BOOK_PATTERN = re.compile(r":ns\s+'lang\.model\.spec-")


def editor_artifact(path: Path) -> bool:
    name = path.name
    return name.startswith(".#") or (name.startswith("#") and name.endswith("#"))


def namespace_of(path: Path) -> str | None:
    source = path.read_text(encoding="utf-8")
    match = NAMESPACE_PATTERN.search(source)
    return match.group(1) if match else None


def namespace_path(namespace: str, family: str) -> Path:
    prefix = f"{family}."
    if not namespace.startswith(prefix):
        raise ValueError(f"{namespace} does not begin with {prefix}")
    relative = namespace[len(prefix) :]
    return Path(*relative.replace("-", "_").split(".")).with_suffix(".hal")


def collect_namespaces(roots: tuple[Path, ...]) -> dict[str, list[Path]]:
    namespaces: dict[str, list[Path]] = defaultdict(list)
    for relative_root in roots:
        root = REPOSITORY / relative_root
        if not root.is_dir():
            continue
        for path in sorted(root.rglob("*.hal")):
            if not path.is_file() or editor_artifact(path):
                continue
            namespace = namespace_of(path)
            if namespace:
                namespaces[namespace].append(path.relative_to(REPOSITORY))
    return namespaces


def check_v1_model_contract(errors: list[str]) -> None:
    manifest_path = REPOSITORY / LANG_PORT
    registry_path = REPOSITORY / LANG_REGISTRY

    if not manifest_path.is_file():
        errors.append(f"language migration manifest is missing: {LANG_PORT}")
        return
    if not registry_path.is_file():
        errors.append(f"language registry is missing: {LANG_REGISTRY}")
        return

    manifest = manifest_path.read_text(encoding="utf-8")
    registry = registry_path.read_text(encoding="utf-8")

    if ":version-model-namespaces true" not in manifest:
        errors.append(
            "language migration manifest must preserve versioned model namespaces"
        )
    if ":public-model-version 1" not in manifest:
        errors.append("language migration manifest must declare public model version 1")

    for namespace in PUBLIC_MODEL_NAMESPACES:
        if f'"{namespace}"' not in manifest:
            errors.append(f"language migration manifest omits public model {namespace}")
        if f":ns '{namespace}" not in registry:
            errors.append(f"language registry does not own V1 book coordinate {namespace}")

    if UNVERSIONED_BOOK_PATTERN.search(registry):
        errors.append(
            "language registry exposes an unversioned lang.model.spec-* book coordinate"
        )
    if ':default-version "alpha"' in registry:
        errors.append(
            "language registry uses alpha as a public book version; expected numeric V1"
        )


def main() -> int:
    errors: list[str] = []

    for relative in LEGACY_ROOTS:
        if (REPOSITORY / relative).exists():
            errors.append(f"legacy language root still exists: {relative}")

    for relative_root, family in LANGUAGE_ROOTS.items():
        root = REPOSITORY / relative_root
        if not root.is_dir():
            errors.append(f"required language root is missing: {relative_root}")
            continue

        for path in sorted(root.rglob("*.hal")):
            if not path.is_file() or editor_artifact(path):
                continue
            namespace = namespace_of(path)
            display = path.relative_to(REPOSITORY)
            if namespace is None:
                errors.append(f"missing namespace declaration: {display}")
                continue
            try:
                expected = namespace_path(namespace, family)
            except ValueError as error:
                errors.append(f"{display}: {error}")
                continue
            actual = path.relative_to(root)
            if actual != expected:
                errors.append(
                    f"namespace/path mismatch: {namespace} is {actual}; "
                    f"expected {expected} under {relative_root}"
                )

    for label, roots in (("production", PRODUCTION_ROOTS), ("test", TEST_ROOTS)):
        namespaces = collect_namespaces(roots)
        for namespace, paths in sorted(namespaces.items()):
            if len(paths) > 1:
                errors.append(
                    f"duplicate {label} namespace {namespace}: "
                    + ", ".join(str(path) for path in paths)
                )

    check_v1_model_contract(errors)

    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1

    production_count = len(collect_namespaces(PRODUCTION_ROOTS))
    test_count = len(collect_namespaces(TEST_ROOTS))
    print(
        "language source layout is consistent: "
        f"{production_count} production namespaces and {test_count} test namespaces; "
        "lang.model.v1 is the public model epoch"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
