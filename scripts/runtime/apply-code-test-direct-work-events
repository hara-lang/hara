#!/usr/bin/env python3
"""Remove the private code.test event bus and commit test events directly to std.work.

This is a one-shot branch migration helper. It deletes itself and its temporary
workflow after producing the reviewable source delta.
"""

from __future__ import annotations

import re
import shutil
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
CODE_TEST = "core/lib/src/code/test.hal"
CODE_TEST_WORK = "core/lib/src/code/test/work.hal"
CODE_TEST_TEST = "core/lib/test/code/test_test.hal"
TEMP_WORKFLOW = ".github/workflows/_apply-code-test-direct-work-events.yml"
SELF = "scripts/runtime/apply-code-test-direct-work-events"


def read(relative: str) -> str:
    return (ROOT / relative).read_text(encoding="utf-8")


def write(relative: str, content: str) -> None:
    path = ROOT / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def replace_once(relative: str, old: str, new: str) -> None:
    source = read(relative)
    if new in source:
        return
    count = source.count(old)
    if count != 1:
        raise SystemExit(
            f"expected exactly one migration anchor in {relative}: {old[:100]!r}; found {count}"
        )
    write(relative, source.replace(old, new, 1))


def replace_regex(relative: str, pattern: str, replacement: str) -> None:
    source = read(relative)
    updated, count = re.subn(pattern, replacement, source, count=1, flags=re.DOTALL)
    if count != 1:
        raise SystemExit(f"regex migration anchor not found in {relative}: {pattern!r}")
    write(relative, updated)


def delete(relative: str) -> None:
    path = ROOT / relative
    if path.exists():
        path.unlink()


def mirror(relative: str) -> None:
    source = ROOT / "core/lib/src" / relative
    target = ROOT / "core/rust/hal-src" / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)


# ---------------------------------------------------------------------------
# code.test: ordinary domain execution plus direct committed work events.
# ---------------------------------------------------------------------------
replace_regex(
    CODE_TEST,
    r"\n\(defn report-event\n.*?\n\n(?=\(extend-type Matcher)",
    "\n",
)

replace_regex(
    CODE_TEST,
    r"\n\(defn report!\n.*?\n\n(?=\(defn checks-pass\?)",
    "\n",
)

replace_regex(
    CODE_TEST,
    r"\(defn run-fact\n.*?\n\n(?=\(defn result-counts)",
    '''(defn run-fact
  "Runs one fact and returns a structured test-domain result.

   Work graph stages own lifecycle event emission. This function owns only fact
   semantics, hooks, assertion classification and optional elapsed projection."
  ([fact]
   (run-fact fact {}))
  ([fact options]
   (let [identity {:namespace (:namespace fact)
                   :name (:name fact)
                   :meta (:meta fact)}
         start (clock-now options)
         result
         (if (:skip (:meta fact))
           (merge identity {:status :skipped :checks []})
           (if (fact-cancelled? fact options)
             (merge identity {:status :cancelled :checks []})
             (try
               (let [checks
                     (try
                       (do
                         (run-hooks [(:before-each options)
                                     (:before (:meta fact))]
                                    options)
                         (normalize-checks
                          (settle ((:function fact) options) options)))
                       (finally
                         (run-hooks [(:after (:meta fact))
                                     (:after-each options)]
                                    options)))
                     status (if (checks-timeout? checks)
                              :timeout
                              (if (checks-error? checks)
                                :error
                                (if (checks-pass? checks)
                                  :passed
                                  :failed)))]
                 (merge identity {:status status :checks checks}))
               (catch Throwable error
                 (merge identity
                        {:status :error
                         :checks []
                         :error (str error)})))))
         end (clock-now options)
         timed-result (if (and start end)
                        (assoc result :elapsed (- end start))
                        result)]
     timed-result)))

''',
)

replace_regex(
    CODE_TEST,
    r"\(defn run-facts\n.*?\n\n(?=\(def \+default-work-revision\+)",
    '''(defn fact-event-identity
  [fact]
  {:namespace (:namespace fact)
   :name (:name fact)
   :meta (:meta fact)})

(defn run-fact-with-events
  [fact options context]
  (work/emit! context :test/fact-started (fact-event-identity fact))
  (let [result (run-fact fact options)]
    (work/emit! context :test/fact-completed result)
    result))

(defn run-facts
  [facts options context]
  (loop [index 0
         results []
         cancelled false]
    (if (= index (count facts))
      results
      (let [result (run-fact-with-events
                    (nth facts index)
                    (assoc options :cancelled cancelled)
                    context)
            stop (or cancelled
                     (and (:fail-fast options)
                          (failing-status? (:status result))))]
        (recur (inc index) (conj results result) stop)))))

(defn run-selected
  [options context]
  (let [selected (vec
                  (filter (fn [fact] (matches-selection? fact options))
                          (tests)))
        namespace (if (seq selected) (:namespace (first selected)) nil)
        suite-options (or (get (deref +global-settings+) namespace) {})
        options (merge suite-options options)]
    (work/emit! context :test/run-started {:count (count selected)})
    (let [results (try
                    (do
                      (run-hook (:before-all options) options)
                      (run-facts selected options context))
                    (finally
                      (run-hook (:after-all options) options)))
          counts (result-counts results)
          checks (attach-check-total (check-counts results))
          status (if (and (= 0 (:failed counts))
                          (= 0 (:error counts))
                          (= 0 (:timeout counts)))
                   :passed
                   :failed)
          namespaces
          (reduce (fn [output result]
                    (conj output (:namespace result)))
                  #{}
                  results)
          summary {:status status
                   :counts counts
                   :check-counts checks
                   :files (count namespaces)
                   :facts (count results)
                   :checks (:total checks)
                   :passed (:passed checks)
                   :failed (:failed checks)
                   :throw (:error counts)
                   :timeout (:timeout counts)
                   :results results}]
      (work/emit! context :test/run-completed summary)
      summary)))

''',
)

replace_regex(
    CODE_TEST,
    r"\n\(defn work-event-kind\n.*?\n\n(?=\(defn suite-work)",
    "\n",
)

replace_once(
    CODE_TEST,
    '''    (fn [input context]
      (run-selected nil
                    (assoc (work-execution-options input context)
                           :reporter
                           (work-reporter context)))))))''',
    '''    (fn [input context]
      (run-selected (work-execution-options input context)
                    context)))))''',
)

# ---------------------------------------------------------------------------
# code.test.work: graph stages emit the canonical :test/* vocabulary directly.
# ---------------------------------------------------------------------------
replace_regex(
    CODE_TEST_WORK,
    r"\n\(def work-event-kind test/work-event-kind\).*?\n\n(?=\(def \+default-revision\+)",
    "\n",
)

replace_regex(
    CODE_TEST_WORK,
    r"\(defn fact-work\n.*?\n\n(?=\(defn unsupported-batch-options)",
    '''(defn fact-work
  "Returns one checkpointed fact boundary. Assertion failures, skips, timeouts,
   and test errors are completed domain results returned by code.test/run-fact."
  ([namespace name]
   (fact-work namespace name +default-revision+))
  ([namespace name fact-revision]
   (work/step
    {:id (fact-coordinate namespace name fact-revision)
     :version fact-revision
     :test/revision fact-revision}
    (fn [input context]
      (let [options (execution-options input context)
            fact (resolve-fact namespace name)]
        (work/emit! context
                    :test/fact-started
                    (fact-result-identity fact))
        (let [result (test/run-fact fact options)]
          (work/emit! context :test/fact-completed result)
          result))))))

''',
)

replace_regex(
    CODE_TEST_WORK,
    r"\(defn terminal-fact-result\n.*?\n\n(?=\(defn before-fact)",
    '''(defn terminal-fact-result
  [subject context]
  (let [fact (resolve-fact (:namespace subject)
                           (:name subject))
        options (fact-options subject context)]
    (work/emit! context
                :test/fact-started
                (fact-result-identity fact))
    (let [result (test/run-fact fact options)]
      (work/emit! context :test/fact-completed result)
      result)))

''',
)

replace_regex(
    CODE_TEST_WORK,
    r"\(defn before-fact\n.*?\n\n(?=\(defn execute-fact-body)",
    '''(defn before-fact
  [subject context]
  (let [fact (resolve-fact (:namespace subject)
                           (:name subject))
        options (fact-options subject context)
        identity (fact-result-identity fact)
        start (test/clock-now options)]
    (work/emit! context :test/fact-started identity)
    (try
      (do
        (test/run-hooks [(:before-each options)
                         (:before (:meta fact))]
                        options)
        {:subject subject
         :test/start start
         :test/before-error nil})
      (catch Throwable error
        {:subject subject
         :test/start start
         :test/before-error (str error)}))))

''',
)

replace_regex(
    CODE_TEST_WORK,
    r"\(defn finalize-fact\n.*?\n\n(?=\(defn running-fact-work)",
    '''(defn finalize-fact
  [outcome context]
  (let [state (get-in outcome [:work/body :result])
        subject (:subject state)
        fact (resolve-fact (:namespace subject)
                           (:name subject))
        options (fact-options subject context)
        cleanup (get-in outcome [:work/cleanup :result])
        result (if (= :error (:status cleanup))
                 (error-result fact (:error cleanup))
                 (:test/result state))
        result (timed-result result (:test/start state) options)]
    (work/emit! context :test/fact-completed result)
    result))

''',
)

replace_regex(
    CODE_TEST_WORK,
    r"\(defn suite-before\n.*?\n\n(?=\(defn suite-after)",
    '''(defn suite-before
  [prepared context]
  (let [options (execution-options (:test/options prepared) context)]
    (work/emit! context
                :test/run-started
                {:count (count (:test/items prepared))})
    (test/run-hook (:before-all options) options)
    nil))

''',
)

replace_regex(
    CODE_TEST_WORK,
    r"\(defn suite-after\n.*?\n\n(?=\(defn fact-batch-body)",
    '''(defn suite-after
  [outcome context]
  (let [prepared (:work/input outcome)
        options (execution-options (:test/options prepared) context)
        body-result (:work/body-result outcome)]
    (test/run-hook (:after-all options) options)
    (if (= :completed (:work/body-status outcome))
      (work/emit! context
                  :test/run-completed
                  (:summary body-result))
      nil)
    {:status :completed}))

''',
)

replace_once(
    CODE_TEST_WORK,
    '''   Reporters are bridged into durable work history. Fail-fast scheduling remains
   on the cleanup-safe suite runner until the runtime owns queued item claims.''',
    '''   Test events are committed directly into durable work history. Fail-fast
   scheduling remains on the cleanup-safe suite runner until runtime item claims
   own the stop policy.''',
)

replace_once(
    CODE_TEST_TEST,
    '''  (run-fact
   (get-fact "code.test-test" "evaluates ordinary equality")
   nil
   {:work/now''',
    '''  (run-fact
   (get-fact "code.test-test" "evaluates ordinary equality")
   {:work/now''',
)

# Permanent guard: do not rebuild a private code.test lifecycle bus.
write(
    "scripts/runtime/check-code-test-work-events",
    '''#!/usr/bin/env python3
"""Reject private code.test reporter buses; require direct std.work events."""

from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
CANONICAL = [
    ROOT / "core/lib/src/code/test.hal",
    ROOT / "core/lib/src/code/test/work.hal",
]
MIRRORS = [
    ROOT / "core/rust/hal-src/code/test.hal",
    ROOT / "core/rust/hal-src/code/test/work.hal",
]
FORBIDDEN = [
    "(defn report-event",
    "(defn report!",
    "(defn work-reporter",
    "(defn reporter-for",
    "WorkReporter",
    "ITestReporter",
    ":run/start",
    ":run/end",
    ":fact/start",
    ":fact/end",
]
REQUIRED = [
    ":test/run-started",
    ":test/fact-started",
    ":test/fact-completed",
    ":test/run-completed",
]

errors = []
for path in CANONICAL:
    source = path.read_text(encoding="utf-8")
    for token in FORBIDDEN:
        if token in source:
            errors.append(f"{path.relative_to(ROOT)} retains private event token {token!r}")
    for token in REQUIRED:
        if token not in source:
            errors.append(f"{path.relative_to(ROOT)} does not emit required event {token}")

for canonical, mirror in zip(CANONICAL, MIRRORS):
    if canonical.read_bytes() != mirror.read_bytes():
        errors.append(
            f"HAL mirror differs: {canonical.relative_to(ROOT)} != {mirror.relative_to(ROOT)}"
        )

if errors:
    print("\\n".join(errors), file=sys.stderr)
    raise SystemExit(1)

print("code.test commits lifecycle events directly through std.work")
''',
)
(ROOT / "scripts/runtime/check-code-test-work-events").chmod(0o755)

write(
    ".github/workflows/code-test-work-events.yml",
    '''name: code.test work events

on:
  push:
    paths:
      - 'core/lib/src/code/test.hal'
      - 'core/lib/src/code/test/work.hal'
      - 'core/rust/hal-src/code/test.hal'
      - 'core/rust/hal-src/code/test/work.hal'
      - 'scripts/runtime/check-code-test-work-events'
      - '.github/workflows/code-test-work-events.yml'
  pull_request:
    branches: [main]
    paths:
      - 'core/lib/src/code/test.hal'
      - 'core/lib/src/code/test/work.hal'
      - 'core/rust/hal-src/code/test.hal'
      - 'core/rust/hal-src/code/test/work.hal'
      - 'scripts/runtime/check-code-test-work-events'
      - '.github/workflows/code-test-work-events.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: code-test-work-events-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Enforce direct committed test events
        run: python3 scripts/runtime/check-code-test-work-events
''',
)

mirror("code/test.hal")
mirror("code/test/work.hal")

delete(SELF)
delete(TEMP_WORKFLOW)
