#!/usr/bin/env bash
set -euo pipefail

# Homebrew may put a non-rustup rustc ahead of the rustup toolchain even when
# rustup owns the installed Wasm standard library. Keep every Hara Wasm build
# on one explicitly selected toolchain so local and CI artifacts agree.
if command -v rustup >/dev/null 2>&1; then
  HARA_WASM_RUSTC="$(rustup which rustc)"
  exec rustup run stable cargo \
    --config "build.rustc=\"$HARA_WASM_RUSTC\"" \
    build "$@"
fi

exec cargo build "$@"
