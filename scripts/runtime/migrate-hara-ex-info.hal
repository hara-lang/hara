(ns code.migrate.hara-catalog-script
  (:require [code.migrate.transform.lib-core :as transform]
            [std.foundation :refer :all]
            [std.lib.fs.path :as path]
            [tool.sh :as sh]))

(def +repository+ "hara-lang/hara")
(def +candidate-path+ "/private/tmp/hara-ex-info-migration-candidate.hal")

(defn host-read [file]
  (let [result (sh/run ["/bin/cat" file] {:trim false})]
    (if (= 0 (:exit result))
      (:stdout result)
      (throw (ex :code.migrate/read-failed
                 {:ex/message "Cannot read migration source" :path file})))))

(defn host-write [file content]
  (let [process (Process/spawn ["/usr/bin/tee" file])]
    (Process/write process (str/encode-utf8 content))
    (Process/close-input process)
    (let [values (deref (promise/all [(Process/stdout process)
                                      (Process/stderr process)
                                      (Process/wait process)]))]
      (if (= 0 (nth values 2))
        file
        (throw (ex :code.migrate/write-failed
                   {:ex/message "Cannot write migration source" :path file}))))))

(defn selected-site? [site]
  (and (= +repository+ (:source/repository site))
       (= :production (:source/role site))
       (empty? (:source/modifiers site))))

(defn sites-by-path [catalog]
  (reduce
   (fn [output site]
     (if (selected-site? site)
       (let [source-path (:source/path site)]
         (assoc output source-path (conj (or (get output source-path) []) site)))
       output))
   {}
   (:catalog/sites catalog)))

(defn record-definition [record]
  (let [definition (get-in record [:context/definition :name])]
    (if definition (name definition) nil)))

(defn record-matches-context? [record context]
  (and (= (:legacy/message record) (:message context))
       (= (:legacy/data record) (:data context))
       (= (:legacy/cause record) (:cause context))))

(defn contract-resolver [records]
  (let [used (atom #{})]
    (fn [context]
      (let [index
            (loop [position 0]
              (if (< position (count records))
                (if (and (nil? (get @used position))
                         (record-matches-context? (nth records position) context))
                  position
                  (recur (inc position)))
                nil))]
        (if (nil? index)
          (throw (ex :code.migrate/unreviewed-site
                     {:ex/message "Current ex-info site has no classified record"
                      :context context}))
          (do
            (swap! used conj index)
            (select-keys (nth records index) [:ex/code :ex/class])))))))

(defn validate-candidate [source path]
  (let [remaining (transform/catalog-ex-info-source
                   source path {:repository +repository+})]
    {:valid (empty? remaining)
     :remaining (count remaining)}))

(defn migrate-file [root hara mode path records]
  (let [file (path/join root path)
        before (host-read file)
        current (transform/catalog-ex-info-source
                 before path {:repository +repository+})
        current (vec (filter (fn [site] (empty? (:source/modifiers site))) current))]
    (if (= 0 (count current))
      {:path path :status :already-migrated
       :matches (count records) :changes 0}
      (if (not= (count records) (count current))
        {:path path :status :mismatch
         :expected (count records) :current (count current)}
      (let [after (transform/migrate-ex-info before (contract-resolver records))
            changes (if (= before after) 0 (count records))]
        (if (= 0 changes)
          {:path path :status :unchanged :matches (count records) :changes 0}
          (do
            (host-write +candidate-path+ after)
            (let [validation (validate-candidate after path)]
              (if (not (:valid validation))
                {:path path :status :validation-failed
                 :matches (count records) :changes 0
                 :validation validation}
                (do
                  (if (= mode "write") (host-write file after) nil)
                  {:path path
                   :status (if (= mode "write") :written :ready)
                   :matches (count records)
                   :changes changes}))))))))))

(defn run []
  (let [root (OS/cwd)
        workspace (path/parent (path/parent root))
        catalog (Edn/read (host-read
                           (path/join workspace "ex-info-catalog-classified.edn")))
        grouped (sites-by-path catalog)
        mode (or (OS/getenv "HARA_MIGRATION_MODE") "dry-run")
        hara (path/join root "core/hara")
        results (vec
                 (map (fn [source-path]
                        (migrate-file root hara mode source-path
                                      (get grouped source-path)))
                      (keys grouped)))
        summary {:mode (keyword mode)
                 :files (count results)
                 :matches (reduce + 0 (map (fn [entry] (or (:matches entry) 0)) results))
                 :changes (reduce + 0 (map (fn [entry] (or (:changes entry) 0)) results))
                 :statuses (frequencies (map :status results))
                 :results results}]
    (host-write (path/join workspace "hara-ex-info-migration-report.edn")
                (str (pr-str summary) "\n"))
    (dissoc summary :results)))

(run)
