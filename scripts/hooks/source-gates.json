{
  "document_id": "hara/source-gates",
  "extensions": [".hal"],
  "evaluation": {
    "runtime": "hara",
    "pre_write": true,
    "post_write": true,
    "registry_only_loading": true
  },
  "rules": [
    {
      "id": "hara.source/no-requiring-resolve",
      "severity": "error",
      "pattern": "requiring-resolve",
      "message": "Dynamic loading must use an explicit namespace alias or a registered loader."
    },
    {
      "id": "hara.source/no-clojure-namespace",
      "severity": "error",
      "pattern": "clojure\\.",
      "message": "Hara source must use Foundation APIs rather than Clojure namespaces."
    },
    {
      "id": "hara.source/foundation-builtin-alias",
      "severity": "error",
      "pattern": "\\[std\\.foundation\\.(string|promise|bytes|socket|file|coroutine|edn|json|set|pretty|host|kernel|os|crypto)\\s",
      "message": "Use builtin aliases such as str/*, co/*, json/*, bytes/*, and host/*; do not require Foundation builtin libraries."
    },
    {
      "id": "hara.source/lang-canonical-root",
      "severity": "error",
      "path_pattern": "/core/lib/src-lang/lang/",
      "message": "lang.* libraries belong under core/lib/src/lang/."
    }
  ]
}
