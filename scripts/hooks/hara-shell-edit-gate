#!/usr/bin/env python3
"""Reject shell-based writes to Hara source; use evaluated patch edits."""

import json
import re
import sys


payload = json.load(sys.stdin)
command = (payload.get("tool_input") or {}).get("command", "")
patterns = (
    r"(?:>|>>)\s*[^\s;'\"]+\.hal(?:$|[\s;&|<>])",
    r"\btee\s+[^\n]*\.hal(?:$|[\s;&|<>])",
    r"\bsed\s+[^\n]*-i[^\n]*\.hal(?:$|[\s;&|<>])",
    r"\b(?:cp|mv|install)\s+[^\n]*\s[^\s;'\"]+\.hal(?:$|[\s;&|<>])",
)
if any(re.search(pattern, command) for pattern in patterns):
    message = ("Hara source files must be evaluated first and changed with the native patch "
               "tool; shell writes to .hal files are blocked.")
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": message}}))
