 nonempty archive provenance frames in order\"\n   :test (fn [] (provenance/provenance {:lang/module :module}\n                                        nil\n                                        {}\n                                        {:lang/line 8}))\n   :expected {:lang/module :module :lang/line 8}}])\n\n^{:refer lang.base.provenance/provenance-stack}\n(Test/check\n [{:name \"uses a supplied stack or creates one frame from plain provenance\"\n   :test (fn []\n           [(provenance/provenance-stack {:lang/provenance-stack [{:lang/module :outer}\n                                                                    {:lang/line 9}]})\n            (provenance/provenance-stack {:lang/module :single})\n            (provenance/provenance-stack nil)])\n   :expected [[{:lang/module :outer} {:lang/line 9}]\n              [{:lang/module :single}]\n              []]}])\n\n^{:refer lang.base.provenance/same-site?}\n(Test/check\n [{:name \"compares only stable source-site identity fields\"\n   :test (fn []\n           [(provenance/same-site? {:lang/module :m :lang/line 1 :lang/source :a}\n                                   {:lang/module :m :lang/line 1 :lang/source :b})\n            (provenance/same-site? {:lang/module :m :lang/line 1}\n                                   {:lang/module :m :lang/line 2})])\n   :expected [true false]}])\n\n^{:refer lang.base.provenance/append-frame}\n(Test/check\n [{:name \"adds new provenance frames and eliminates adjacent duplicate sites\"\n   :test (fn []\n           [(provenance/append-frame [] {:lang/module :m :lang/line 1})\n            (provenance/append-frame [{:lang/module :m :lang/line 1}]\n                                     {:lang/module :m :lang/line 1})\n            (provenance/append-frame [{:lang/module :m :lang/line 1}]\n                                     {:lang/module :m :lang/line 2})])\n   :expected [[{:lang/module :m :lang/line 1}]\n              [{:lang/module :m :lang/line 1}]\n              [{:lang/module :m :lang/line 1}\n               {:lang/module :m :lang/line 2}]]}])\n\n^{:refer lang.base.provenance/with-provenance}\n(Test/check\n [{:name \"attaches merged canonical provenance without changing empty input\"\n   :test (fn []\n           [(provenance/with-provenance {:lang/provenance {:lang/module :outer}}\n                                        {:lang/line 4})\n            (provenance/with-provenance {:value :unchanged} nil)])\n   :expected [{:lang/provenance {:lang/module :outer :lang/line 4}}\n              {:value :unchanged}]}])\n\n^{:refer lang.base.provenance/error-with-provenance}\n(Test/check\n [{:name \"wraps errors once with a canonical provenance stack\"\n   :test (fn []\n           (let [error (provenance/error-with-provenance\n                        \"compile\"\n                        {:lang/module :fixture :lang/line 12}\n                        (ex :generic {:reason :inner} :ex/message \"inner\"))]\n             [(ex-message error)\n              (select-keys (ex-data error)\n                           [:reason :lang/module :lang/line :lang/wrapped :lang/cause-message])]))\n   :expected [\"compile: inner\"\n              {:reason :inner\n               :lang/module :fixture\n               :lang/line 12\n               :lang/wrapped true\n               :lang/cause-message \"inner\"}]}])\n\n^{:refer lang.base.provenance/throw-with-provenance}\n(Test/check\n [{:name \"throws the same canonical provenance wrapper\"\n   :test (fn []\n           (try\n             (provenance/throw-with-provenance \"compile\" {:lang/module :fixture}\n                                               (ex :generic {} :ex/message \"inner\"))\n             :missing\n             (catch error\n               [(ex-message error) (:lang/module (ex-data error))])))\n   :expected [\"compile: inner\" :fixture]}])\n",
