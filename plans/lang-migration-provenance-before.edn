nance-stack data)]\n    (cond (seq stack)\n          (vec (filter (fn [value] (not (empty? value)))\n                       (map frame stack)))\n\n          (map? data)\n          (let [single (frame data)]\n            (if (empty? single)\n              []\n              [single]))\n\n          :else\n          [])))\n\n(defn same-site?\n  [left right]\n  (= (select-keys left [:lang/phase\n                        :lang/subsystem\n                        :lang/module\n                        :lang/namespace\n                        :lang/line])\n     (select-keys right [:lang/phase\n                         :lang/subsystem\n                         :lang/module\n                         :lang/namespace\n                         :lang/line])))\n\n(defn append-frame\n  [stack current]\n  (cond (empty? current)\n        stack\n\n        (and (seq stack)\n             (same-site? (IPeekLast/peek-last stack) current))\n        stack\n\n        :else\n        (conj stack current)))\n\n(defn with-provenance\n  [mopts & inputs]\n  (let [merged (apply provenance\n                      (concat [(:lang/provenance mopts)] inputs))]\n    (if (empty? merged)\n      mopts\n      (assoc mopts :lang/provenance merged))))\n\n(defn error-with-provenance\n  [message data t]\n  (let [cause-data (ex-data t)\n        cause-payload (dissoc cause-data\n                              :ex/code\n                              :ex/class\n                              :ex/message\n                              :ex/cause)\n        cause (if (map? (ex-data t)) t nil)\n        current (frame data)\n        inner-stack (provenance-stack cause-data)\n        stack (append-frame (vec inner-stack) current)\n        merged (if (seq stack)\n                 (reduce merge {} (reverse stack))\n                 {})\n        wrapped? (:lang/wrapped cause-data)\n        plain-data (dissoc data\n                           :lang/provenance\n                           :lang/provenance-stack\n                           :book\n                           :modules\n                           :module\n                           :entry\n                           :grammar)\n        payload-0 (merge cause-payload plain-data merged)\n        payload-1 (if (seq merged)\n                    (assoc payload-0 :lang/provenance merged)\n                    payload-0)\n        payload-2 (if (seq stack)\n                    (assoc payload-1 :lang/provenance-stack stack)\n                    payload-1)\n        payload-3 (assoc payload-2\n                         :lang/wrapped true\n                         :lang/cause-class (try\n                                             (ex-class t)\n                                             (catch error nil))\n                         :lang/cause-message (ex-message t))\n        payload (if (and cause-data (not wrapped?))\n                    (assoc payload-3 :lang/cause-data cause-data)\n                    payload-3)\n        output-message (if (ex-message t)\n                         (str message \": \" (ex-message t))\n                         message)]\n    (if cause\n      (ex :generic payload :ex/message output-message :ex/cause cause)\n      (ex :generic payload :ex/message output-message))))\n\n(defn throw-with-provenance\n  [message data t]\n  (throw (error-with-provenance message data t)))\n",
