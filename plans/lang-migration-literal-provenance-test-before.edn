{:source/revision "fe54cc866473a888bfbd4ce2d3de6d8011f09f72",
 :target/id :migration/lang-base-provenance,
 :target/path "test/lang/base/provenance_test.hal",
 :unit/kind :test,
 :reason
 "Semantic block reading preserves literal escapes; regenerate map and metadata ordering.",
 :before/checksum
 "de72a537f460e0e769d4701c5515fd74822fd7984416db4abf26ddad211ef3b1",
 :after/checksum
 "d8bb216073fd04ee4de2d3a107a9602cca641575eae608caf27dda2d7553fbef",
 :before
 "(ns lang.base.provenance-test\n  (:use code.test)\n  (:require [lang.base.provenance :refer :all]))\n\n^{:refer lang.base.provenance/module-id :added \"4.1\"}\n(fact \"extracts module ids from maps and symbols\"\n  [(module-id {:id 'demo.core})\n   (module-id 'demo.core)]\n  => '[demo.core demo.core])\n\n^{:added \"4.1\", :refer lang.base.provenance/namespace-id}\n(fact\n  \"normalizes namespace references\"\n  [(namespace-id (ns-current)) (namespace-id 'demo.core)]\n  =>\n  '[lang.base.provenance-test demo.core])\n\n^{:refer lang.base.provenance/line-of :added \"4.1\"}\n(fact \"finds line metadata across nested values\"\n  (let [form (with-meta '(+ 1 2) {:line 12})]\n    [(line-of nil)\n     (line-of form)\n     (line-of {:form form})])\n  => [nil 12 12])\n\n^{:refer lang.base.provenance/compact :added \"4.1\"}\n(fact \"drops nil values from maps\"\n  (compact {:a 1 :b nil :c 3})\n  => '{:a 1 :c 3})\n\n^{:added \"4.1\", :refer lang.base.provenance/frame}\n(fact\n  \"builds a compact provenance frame\"\n  (let [form (with-meta '(boom 1) {:line 33})]\n    (frame\n      {:lang/provenance {:lang/phase :emit/form},\n       :lang/subsystem :probe/op,\n       :lang/namespace (ns-current),\n       :lang/form form,\n       :lang/module {:id 'demo.core}}))\n  =>\n  '{:lang/line 33,\n    :lang/subsystem :probe/op,\n    :lang/namespace lang.base.provenance-test,\n    :lang/form (boom 1),\n    :lang/phase :emit/form,\n    :lang/module demo.core})\n\n^{:added \"4.1\", :refer lang.base.provenance/provenance}\n(fact\n  \"merges provenance inputs into a single frame\"\n  (provenance\n    {:lang/module 'demo.core}\n    {:lang/line 10}\n    {:lang/subsystem :emit/direct})\n  =>\n  '{:lang/line 10,\n    :lang/subsystem :emit/direct,\n    :lang/module demo.core})\n\n^{:added \"4.1\", :refer lang.base.provenance/provenance-stack}\n(fact\n  \"returns stack frames from explicit stacks or a single frame\"\n  [(provenance-stack\n     {:lang/provenance-stack\n      [{:lang/module 'demo.core} {:lang/module 'demo.next}]})\n   (provenance-stack {:lang/module 'demo.core})]\n  =>\n  '[[{:lang/module demo.core} {:lang/module demo.next}]\n    [{:lang/module demo.core}]])\n\n^{:added \"4.1\", :refer lang.base.provenance/same-site?}\n(fact\n  \"compares provenance frames by site fields\"\n  [(same-site?\n     {:lang/line 10,\n      :lang/subsystem :probe,\n      :lang/phase :emit/form,\n      :lang/module 'demo.core}\n     {:lang/line 10,\n      :lang/subsystem :probe,\n      :lang/form '(ignored),\n      :lang/phase :emit/form,\n      :lang/module 'demo.core})\n   (same-site? {:lang/phase :emit/form} {:lang/phase :emit/direct})]\n  =>\n  [true false])\n\n^{:added \"4.1\", :refer lang.base.provenance/append-frame}\n(fact\n  \"appends only distinct provenance sites\"\n  [(append-frame [{:lang/phase :emit/form}] {:lang/phase :emit/form})\n   (append-frame\n     [{:lang/phase :emit/form}]\n     {:lang/phase :emit/direct})]\n  =>\n  '[[{:lang/phase :emit/form}]\n    [{:lang/phase :emit/form} {:lang/phase :emit/direct}]])\n\n^{:added \"4.1\", :refer lang.base.provenance/with-provenance}\n(fact\n  \"threads merged provenance into mopts\"\n  (with-provenance\n    {:lang :lua}\n    {:lang/module 'demo.core}\n    {:lang/line 10})\n  =>\n  '{:lang/provenance {:lang/line 10, :lang/module demo.core},\n    :lang :lua})\n\n^{:added \"4.1\", :refer lang.base.provenance/error-with-provenance}\n(fact\n  \"wraps throwables with merged provenance data\"\n  (try\n    (throw\n      ((fn [migration-message migration-data] (ex :generic migration-data :ex/message migration-message)) \"inner\" {:inner true :lang/provenance {:lang/module (quote demo.inner) :lang/phase :emit/form}}))\n    (catch\n      t\n      (let [wrapped (error-with-provenance\n                      \"wrap\"\n                      {:lang/phase :emit/direct,\n                       :outer true,\n                       :lang/module 'demo.outer}\n                      t)]\n        [(ex-message wrapped)\n         (select-keys\n           (ex-data wrapped)\n           [:inner\n            :outer\n            :lang/phase\n            :lang/module\n            :lang/wrapped\n            :lang/cause-message])])))\n  =>\n  '[\"wrap: inner\"\n    {:lang/cause-message \"inner\",\n     :lang/wrapped true,\n     :inner true,\n     :lang/phase :emit/form,\n     :outer true,\n     :lang/module demo.inner}])\n\n^{:added \"4.1\", :refer lang.base.provenance/throw-with-provenance}\n(fact\n  \"throws wrapped provenance exceptions\"\n  (try\n    (throw ((fn [migration-message migration-data] (ex :generic migration-data :ex/message migration-message)) \"inner\" {:inner true}))\n    (catch\n      t\n      (try\n        (throw-with-provenance \"wrap\" {:outer true} t)\n        (catch\n          wrapped\n          [(ex-message wrapped) (:outer (ex-data wrapped))]))))\n  =>\n  [\"wrap: inner\" true])\n\n\n\n^{:refer lang.base.provenance/module-id}\n(Test/check\n [{:name \"reduces archived module maps to their stable identifier\"\n   :test (fn [] [(lang.base.provenance/module-id {:id :fixture})\n                 (lang.base.provenance/module-id :fixture)])\n   :expected [:fixture :fixture]}])\n\n^{:refer lang.base.provenance/namespace-id}\n(Test/check\n [{:name \"normalizes loaded namespace handles while retaining unresolved values\"\n   :test (fn [] [(lang.base.provenance/namespace-id 'std.foundation)\n                 (lang.base.provenance/namespace-id 'missing.namespace)\n                 (lang.base.provenance/namespace-id :fixture)])\n   :expected ['std.foundation 'missing.namespace :fixture]}])\n\n^{:refer lang.base.provenance/line-of}\n(Test/check\n [{:name \"finds explicit and nested archive source-line metadata\"\n   :test (fn [] [(lang.base.provenance/line-of nil)\n                 (lang.base.provenance/line-of {:line 1})\n                 (lang.base.provenance/line-of {:entry {:line 2}})\n                 (lang.base.provenance/line-of {:form {:line 3}})])\n   :expected [nil 1 2 3]}])\n\n^{:refer lang.base.provenance/compact}\n(Test/check\n [{:name \"drops only nil provenance fields\"\n   :test (fn [] (lang.base.provenance/compact {:lang/module :fixture\n                                     :lang/line nil\n                                     :lang/source false}))\n   :expected {:lang/module :fixture :lang/source false}}])\n\n^{:refer lang.base.provenance/frame}\n(Test/check\n [{:name \"retains canonical provenance and ignores unrecognized historical keys\"\n   :test (fn []\n           [(lang.base.provenance/frame {:lang/provenance {:lang/module {:id :inner}}\n                               :lang/line 7\n                               :lang/source :fixture})\n            (lang.base.provenance/frame {:tahto/module :legacy})])\n   :expected [{:lang/module :inner :lang/line 7 :lang/source :fixture}\n              {}]}])\n\n^{:refer lang.base.provenance/provenance}\n(Test/check\n [{:name \"merges nonempty archive provenance frames in order\"\n   :test (fn [] (lang.base.provenance/provenance {:lang/module :module}\n                                        nil\n                                        {}\n                                        {:lang/line 8}))\n   :expected {:lang/module :module :lang/line 8}}])\n\n^{:refer lang.base.provenance/provenance-stack}\n(Test/check\n [{:name \"uses a supplied stack or creates one frame from plain provenance\"\n   :test (fn []\n           [(lang.base.provenance/provenance-stack {:lang/provenance-stack [{:lang/module :outer}\n                                                                    {:lang/line 9}]})\n            (lang.base.provenance/provenance-stack {:lang/module :single})\n            (lang.base.provenance/provenance-stack nil)])\n   :expected [[{:lang/module :outer} {:lang/line 9}]\n              [{:lang/module :single}]\n              []]}])\n\n^{:refer lang.base.provenance/same-site?}\n(Test/check\n [{:name \"compares only stable source-site identity fields\"\n   :test (fn []\n           [(lang.base.provenance/same-site? {:lang/module :m :lang/line 1 :lang/source :a}\n                                   {:lang/module :m :lang/line 1 :lang/source :b})\n            (lang.base.provenance/same-site? {:lang/module :m :lang/line 1}\n                                   {:lang/module :m :lang/line 2})])\n   :expected [true false]}])\n\n^{:refer lang.base.provenance/append-frame}\n(Test/check\n [{:name \"adds new provenance frames and eliminates adjacent duplicate sites\"\n   :test (fn []\n           [(lang.base.provenance/append-frame [] {:lang/module :m :lang/line 1})\n            (lang.base.provenance/append-frame [{:lang/module :m :lang/line 1}]\n                                     {:lang/module :m :lang/line 1})\n            (lang.base.provenance/append-frame [{:lang/module :m :lang/line 1}]\n                                     {:lang/module :m :lang/line 2})])\n   :expected [[{:lang/module :m :lang/line 1}]\n              [{:lang/module :m :lang/line 1}]\n              [{:lang/module :m :lang/line 1}\n               {:lang/module :m :lang/line 2}]]}])\n\n^{:refer lang.base.provenance/with-provenance}\n(Test/check\n [{:name \"attaches merged canonical provenance without changing empty input\"\n   :test (fn []\n           [(lang.base.provenance/with-provenance {:lang/provenance {:lang/module :outer}}\n                                        {:lang/line 4})\n            (lang.base.provenance/with-provenance {:value :unchanged} nil)])\n   :expected [{:lang/provenance {:lang/module :outer :lang/line 4}}\n              {:value :unchanged}]}])\n\n^{:refer lang.base.provenance/error-with-provenance}\n(Test/check\n [{:name \"wraps errors once with a canonical provenance stack\"\n   :test (fn []\n           (let [error (lang.base.provenance/error-with-provenance\n                        \"compile\"\n                        {:lang/module :fixture :lang/line 12}\n                        (ex :generic {:reason :inner} :ex/message \"inner\"))]\n             [(ex-message error)\n              (select-keys (ex-data error)\n                           [:reason :lang/module :lang/line :lang/wrapped :lang/cause-message])]))\n   :expected [\"compile: inner\"\n              {:reason :inner\n               :lang/module :fixture\n               :lang/line 12\n               :lang/wrapped true\n               :lang/cause-message \"inner\"}]}])\n\n^{:refer lang.base.provenance/throw-with-provenance}\n(Test/check\n [{:name \"throws the same canonical provenance wrapper\"\n   :test (fn []\n           (try\n             (lang.base.provenance/throw-with-provenance \"compile\" {:lang/module :fixture}\n                                               (ex :generic {} :ex/message \"inner\"))\n             :missing\n             (catch error\n               [(ex-message error) (:lang/module (ex-data error))])))\n   :expected [\"compile: inner\" :fixture]}])\n\n^{:refer lang.base.provenance/+field-keys+}\n(fact \"preserves ordered authority fields and native provenance extensions\"\n  +field-keys+\n  => [:lang/phase :lang/subsystem :lang/lang :lang/module :lang/namespace\n      :lang/entry :lang/symbol :lang/line :lang/form :lang/hook\n      :lang/grammar-coordinate :lang/grammar-fingerprint :lang/actor :lang/source :lang/work]\n\n  (frame {:lang/hook :before :lang/grammar-coordinate 'lang/js\n          :lang/grammar-fingerprint \"abc\" :lang/actor :compiler\n          :lang/source false :lang/work 0 :ignored true})\n  => {:lang/hook :before :lang/grammar-coordinate 'lang/js\n      :lang/grammar-fingerprint \"abc\" :lang/actor :compiler\n      :lang/source false :lang/work 0})\n"}

