{:artifact/version 1 :scope :reviewed-native-intermediate :artifact/type :foundation/lang-native-adaptations :steps [{:recipe {:lang/namespace "lang.base.preprocess-resolve" :lang/definitions [{:name "fragment-template-args" :before "(defn fragment-template-args [form template]\n  (let [template-arglists (:arglists (meta template))\n        body (vec (drop 2 form))\n        body (if (string? (first body)) (vec (rest body)) body)\n        body (if (map? (first body)) (vec (rest body)) body)\n        args (first body)\n        arglist (or (first template-arglists)\n                    (if (vector? args) args\n                        (if (and (list? args) (vector? (first args)))\n                          (first args))))]\n    (if arglist\n      (vec arglist)\n      (fail \"Unable to derive standalone fragment args\" {:form form}))))" :reason "Preserve Foundation anonymous and multi-arity fn argument vectors while retaining native named declarations." :after "(defn fragment-template-args [form template]\n  (let [template-arglists (:arglists (meta template))\n        first-args (second form)\n        anonymous? (or (vector? first-args)\n                       (and (list? first-args) (vector? (first first-args))))\n        body (vec (if anonymous? (rest form) (drop 2 form)))\n        body (if (string? (first body)) (vec (rest body)) body)\n        body (if (map? (first body)) (vec (rest body)) body)\n        args (first body)\n        arglist (or (first template-arglists)\n                    (if (vector? args) args\n                        (if (and (list? args) (vector? (first args)))\n                          (first args))))]\n    (if arglist\n      (vec arglist)\n      (fail \"Unable to derive standalone fragment args\" {:form form}))))"}]} :source/definition tahto.base.preprocess-resolve/fragment-template-args :test/path "test/lang/base/preprocess_resolve_test.hal" :test/append "\n^{:refer lang.base.preprocess-resolve/fragment-template-args}\n(Test/check\n [{:name \"preserves Foundation anonymous and multi-arity fn argument shapes\"\n   :test (fn []\n           [(resolve/fragment-template-args\n             '(fn [x y] (list '+ x y)) (fn [x y] (list '+ x y)))\n            (resolve/fragment-template-args\n             '(fn ([x] x) ([x y] (+ x y))) nil)\n            (resolve/fragment-template-args '(fn [] :empty) nil)\n            (resolve/fragment-template-args '(fn [x & more] more) nil)\n            (resolve/fragment-template-args '(fn named [x y] (+ x y)) nil)\n            (resolve/fragment-template-args\n             '(fn [ignored] ignored)\n             (with-meta (fn [] nil) {:arglists '([preferred])}))\n            (try (resolve/fragment-template-args '(fn :invalid) nil)\n                 :unexpected\n                 (catch error [(ex-message error) (:form (ex-data error))]))])\n   :expected [['x 'y] ['x] [] ['x '& 'more] ['x 'y] ['preferred]\n              [\"Unable to derive standalone fragment args\" '(fn :invalid)]]}])\n\n^{:refer lang.base.preprocess-resolve/process-fragment-entry}\n(Test/check\n [{:name \"recreates the original standalone add fragment and records its dependency\"\n   :test (fn []\n           (let [baseline #{'existing/value}\n                 dependencies (atom baseline)\n                 output\n                 (try\n                   [(resolve/process-fragment-entry\n                     {:id 'add :form '(fn [x y] (list '+ x y))\n                      :template (fn [x y] (list '+ x y)) :standalone true}\n                     'L.core/add 'L.core 'L.core/add dependencies\n                     (fn [form] [:walk form]))\n                    (deref dependencies)]\n                   (finally (reset! dependencies baseline)))]\n             [output (= baseline (deref dependencies))]))\n   :expected [[[:walk '(fn [x y] (return (+ x y)))]\n               #{'existing/value 'L.core/add}] true]}])\n" :source/path "src/tahto/base/preprocess_resolve.clj" :target/after-sha256 "03267386239f12cc10620aa4e3f7356193ecaf061f299715f1bcdcc4d80f0338" :target/path "src/lang/base/preprocess_resolve.hal" :target/before-sha256 "90d5d2396b36755c6bcd5083e22b133c68073497b4bac52b820410e47bacf719"} {:recipe {:lang/namespace "lang.base.emit-common" :lang/definitions [{:name "emit-invoke" :before "(defn emit-invoke\n  \"emits a general invocation\"\n  {:added \"3.0\"}\n  [_ form grammar mopts]\n  (let [sym (first form)\n        custom (get-in grammar [:default :invoke :custom])\n        keyword-fn (get-in grammar [:default :invoke :keyword-fn])]\n    (cond custom (custom form grammar mopts)\n          (and (keyword? sym) keyword-fn) (keyword-fn form grammar mopts)\n          (and (keyword? sym) (namespace sym))\n          (emit-invoke-static form grammar mopts)\n          (keyword? sym) (emit-invoke-typecast form grammar mopts)\n          :else\n          (let [target (*emit-fn* sym grammar mopts)\n                options (get-in grammar [:default :common])\n                target (if (symbol? sym)\n                         target\n                         (str (:start options) target (:end options)))]\n            (emit-invoke-raw target (rest form) grammar mopts)))))" :reason "Use Foundation emit-wrapping for the callee; do not wrap every nonsymbol invocation." :after "(defn emit-invoke\n  \"emits a general invocation\"\n  {:added \"3.0\"}\n  [_ form grammar mopts]\n  (let [sym (first form)\n        custom (get-in grammar [:default :invoke :custom])\n        keyword-fn (get-in grammar [:default :invoke :keyword-fn])]\n    (cond custom (custom form grammar mopts)\n          (and (keyword? sym) keyword-fn) (keyword-fn form grammar mopts)\n          (and (keyword? sym) (namespace sym))\n          (emit-invoke-static form grammar mopts)\n          (keyword? sym) (emit-invoke-typecast form grammar mopts)\n          :else\n          (emit-invoke-raw (emit-wrapping sym grammar mopts)\n                           (rest form) grammar mopts))))"}]} :source/definition tahto.base.emit-common/emit-invoke :test/path "test/lang/base/emit_common_test.hal" :test/append "\n^{:refer lang.base.emit-common/emit-invoke :added \"4.0\"}\n(fact \"uses Foundation callee wrapping without adding parentheses to chained invocations\"\n  (emit-invoke :invoke '((make-fn 1) 2) helper/+default+ {})\n  => \"(make-fn 1)(2)\"\n  (emit-invoke :invoke '((fn [x] x) 2) helper/+default+ {})\n  => \"((fn [x] x))(2)\"\n  (emit-invoke :invoke '((+ 1 2) 3)\n               (assoc-in helper/+default+ [:reserved '+] {:emit :infix}) {})\n  => \"((+ 1 2))(3)\")\n\n^{:refer lang.base.emit-common/*explode*}\n(fact \"explode is opt-in and its binding restores the baseline\"\n  [common/*explode* (with:explode common/*explode*) common/*explode*]\n  => [nil true nil])\n\n^{:refer lang.base.emit-common/*trace*}\n(fact \"trace is opt-in and its binding restores the baseline\"\n  [common/*trace* (with-trace common/*trace*) common/*trace*]\n  => [nil true nil])\n\n^{:refer lang.base.emit-common/*indent*}\n(fact \"indent is zero by default and nested indentation is scoped\"\n  [common/*indent*\n   (binding [common/*indent* 3]\n     [(newline-indent) (with-indent [2] (newline-indent)) (newline-indent)])\n   common/*indent*]\n  => [0 [\"\\n   \" \"\\n     \" \"\\n   \"] 0])\n\n^{:refer lang.base.emit-common/*compressed*}\n(fact \"compressed whitespace is scoped and restores even after an exception\"\n  [common/*compressed*\n   (with-compressed (newline-indent))\n   (try (binding [common/*compressed* true] (throw (ex :test/compressed {})))\n        (catch error common/*compressed*))\n   common/*compressed*]\n  => [false \" \" false false])\n\n^{:refer lang.base.emit-common/*multiline*}\n(fact \"multiline output is disabled by default and locally selectable\"\n  [common/*multiline* (binding [common/*multiline* true] common/*multiline*) common/*multiline*]\n  => [false true false])\n\n^{:refer lang.base.emit-common/*max-len*}\n(fact \"the default maximum line length is sixty and scoped overrides restore it\"\n  [common/*max-len* (binding [common/*max-len* 12] common/*max-len*) common/*max-len*]\n  => [60 12 60])\n\n^{:refer lang.base.emit-common/*emit-internal*}\n(fact \"internal emission is disabled by default and scoped overrides restore it\"\n  [common/*emit-internal*\n   (binding [common/*emit-internal* true] common/*emit-internal*)\n   common/*emit-internal*]\n  => [false true false])\n\n^{:refer lang.base.emit-common/*emit-fn*}\n(fact \"the default recursive emitter prints forms and a scoped replacement restores it\"\n  [(common/*emit-fn* '(call 1) {} {})\n   (binding [common/*emit-fn* (fn [form grammar options] \"replacement\")]\n     (common/*emit-fn* '(call 1) {} {}))\n   (common/*emit-fn* '(call 1) {} {})]\n  => [\"(call 1)\" \"replacement\" \"(call 1)\"])\n\n^{:refer lang.base.emit-common/+emit-lookup+}\n(fact \"the common dispatch table owns exactly token invocation and macro emission\"\n  [(set (keys common/+emit-lookup+))\n   ((get common/+emit-lookup+ :token) :number 1 helper/+default+ {})\n   ((get common/+emit-lookup+ :invoke) :invoke '(call 2) helper/+default+ {})\n   ((get common/+emit-lookup+ :macro) :macro '(expand 2)\n    (assoc-in helper/+default+ [:reserved 'expand]\n              {:macro (fn [form] '(expanded 2))}) {})]\n  => [#{:token :invoke :macro} \"1\" \"call(2)\" \"(expanded 2)\"])\n" :source/path "src/tahto/base/emit_common.clj" :target/after-sha256 "ec96639dd8569d8f304f3418b2cfe04c6677ac691cd4c0924767503a576937eb" :target/path "src/lang/base/emit_common.hal" :target/before-sha256 "24f3fe2c3e895d6315c303657021f811168e2b6f10cfb7a49f0b23434b6d2e1d"}] :authority {:revision "fe54cc866473a888bfbd4ce2d3de6d8011f09f72" :path "reference/foundation-base"}}
