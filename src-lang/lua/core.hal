(ns lua.core
  (:config {:role :internal})
  (:require [lang.core :as l]))

(l/script :lua lua.core)

;; Lua standard-library bindings that are available in the basic target runtime.
(def$.lua ^{:public true} lua-type type)
(def$.lua ^{:public true} tonumber tonumber)
(def$.lua ^{:public true} tostring tostring)
(def$.lua ^{:public true} table-insert table.insert)
(def$.lua ^{:public true} table-remove table.remove)
(def$.lua ^{:public true} table-sort table.sort)
(def$.lua ^{:public true} string-sub string.sub)
(def$.lua ^{:public true} string-lower string.lower)
(def$.lua ^{:public true} string-upper string.upper)
(def$.lua ^{:public true} string-format string.format)
(def$.lua ^{:public true} math-abs math.abs)
(def$.lua ^{:public true} math-floor math.floor)
(def$.lua ^{:public true} math-max math.max)
(def$.lua ^{:public true} math-min math.min)
(def$.lua ^{:public true} math-pi math.pi)
