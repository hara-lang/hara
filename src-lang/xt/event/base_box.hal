(ns xt.event.base-box
  (:require [lang.core :as l]))

(l/script :xtalk
  {:require [[xt.lang.spec-base :as xt]
             [xt.lang.common-data :as xtd]
             [xt.event.base-listener :as event-common]]})

(def ^{:schema [:xt/array :xt/any]} BoxPath nil)

(def ^{:schema :xt/any} BoxData nil)

(def ^{:schema [:fn [] BoxData]} BoxInitializer nil)

(def ^{:schema [:xt/record
                ["path" BoxPath]
                ["value" [:xt/maybe :xt/any]]
                ["data" BoxData]
                ["meta" [:xt/maybe xt.event.base-listener/EventListenerMeta]]]} 
  BoxEvent
  nil)

(def ^{:schema [:xt/record
                ["::" :xt/str]
                ["listeners" xt.event.base-listener/EventListenerMap]
                ["data" BoxData]
                ["initial" BoxInitializer]]}
  EventBox
  nil)

(defn.xt ^{:public true :schema [:fn [[:or BoxData BoxInitializer]] EventBox]}
  make-box
  "Creates a mutable box from a value or repeatable initialiser."
  {:added "4.1"}
  [initial]
  (var initial-fn initial)
  (when (not (xt/x:is-function? initial-fn))
    (var initial-data initial-fn)
    (:= initial-fn
        (fn []
          (return initial-data))))
  (var data (initial-fn))
  (return {"::" "event.box"
           :listeners {}
           :data data
           :initial initial-fn}))

(defn.xt ^{:public true :schema [:fn [BoxEvent BoxPath] :xt/bool]}
  check-event
  "Returns true when the listener path is a prefix of the event path."
  {:added "4.1"}
  [event path]
  (var event-path (. event ["path"]))
  (when (> (xt/x:len path) (xt/x:len event-path))
    (return false))
  (xt/for:array [[i value] path]
    (when (not= value (. event-path [i]))
      (return false)))
  (return true))

(defn.xt ^{:public true
            :schema [:fn [EventBox :xt/str BoxPath
                          xt.event.base-listener/EventListenerCallback
                          [:xt/maybe xt.event.base-listener/EventListenerMeta]]
                         xt.event.base-listener/EventListenerEntry]}
  add-listener
  "Adds a listener that receives updates below its registered box path."
  {:added "4.1"}
  [box listener-id path callback meta]
  (:= path (event-common/arrayify-path path))
  (return
   (event-common/add-listener
    box listener-id "box" callback
    (xt/x:obj-assign {:box/path path} meta)
    (fn [event]
      (return (-/check-event event path))))))

(def.xt ^{:public true :arglists '([box listener-id])}
  remove-listener
  event-common/remove-listener)

(def.xt ^{:public true :arglists '([box])}
  list-listeners
  event-common/list-listeners)

(defn.xt ^{:public true :schema [:fn [EventBox [:xt/maybe BoxPath]] BoxData]}
  get-data
  "Reads root or nested data from a box."
  {:added "4.1"}
  [box path]
  (var #{data} box)
  (:= path (event-common/arrayify-path path))
  (return (xtd/get-in data path)))

(defn.xt ^{:public true :schema [:fn [EventBox BoxPath :xt/any] :xt/any]}
  set-data-raw
  "Updates root or nested data without notifying listeners."
  {:added "4.1"}
  [box path value]
  (var #{data} box)
  (cond (xtd/arr-empty? path)
        (xt/x:set-key box "data" value)

        :else
        (return (xtd/set-in data path value))))

(defn.xt ^{:public true :schema [:fn [EventBox BoxPath :xt/any] [:xt/array :xt/str]]}
  set-data
  "Updates data and notifies matching listeners."
  {:added "4.1"}
  [box path value]
  (var #{data} box)
  (:= path (event-common/arrayify-path path))
  (-/set-data-raw box path value)
  (return
   (event-common/trigger-listeners
    box
    {:path path
     :value value
     :data data})))

(defn.xt ^{:public true :schema [:fn [EventBox BoxPath] :xt/bool]}
  del-data-raw
  "Deletes a nested value without notifying listeners."
  {:added "4.1"}
  [box path]
  (:= path (event-common/arrayify-path path))
  (var #{data} box)
  (var parent-path (xt/x:arr-slice path 0 (- (xt/x:len path) 1)))
  (var parent (xtd/get-in data parent-path))
  (when (xt/x:not-nil? parent)
    (var value (xt/x:get-key parent (xt/x:last path)))
    (xt/x:del-key parent (xt/x:last path))
    (return (xt/x:not-nil? value)))
  (return false))

(defn.xt ^{:public true
            :schema [:fn [EventBox BoxPath] [:xt/maybe [:xt/array :xt/str]]]}
  del-data
  "Deletes a nested value and notifies matching listeners only on change."
  {:added "4.1"}
  [box path]
  (:= path (event-common/arrayify-path path))
  (var #{data} box)
  (when (-/del-data-raw box path)
    (return
     (event-common/trigger-listeners
      box
      {:path path
       :value nil
       :data data}))))

(defn.xt ^{:public true :schema [:fn [EventBox] [:xt/array :xt/str]]}
  reset-data
  "Resets a box by taking a fresh value from its initialiser."
  {:added "4.1"}
  [box]
  (var #{initial} box)
  (return (-/set-data box [] (initial))))

(defn.xt ^{:public true
            :schema [:fn [EventBox BoxPath [:xt/dict :xt/str :xt/any]] [:xt/array :xt/str]]}
  merge-data
  "Merges an object into root or nested box data and notifies listeners."
  {:added "4.1"}
  [box path value]
  (:= path (event-common/arrayify-path path))
  (var previous (-/get-data box path))
  (var merged (xtd/obj-assign (xtd/obj-clone previous) value))
  (return (-/set-data box path merged)))

(defn.xt ^{:public true :schema [:fn [EventBox BoxPath :xt/any] [:xt/array :xt/str]]}
  append-data
  "Appends a value to array data and notifies matching listeners."
  {:added "4.1"}
  [box path value]
  (:= path (event-common/arrayify-path path))
  (var arr (xt/x:arr-clone (-/get-data box path)))
  (xt/x:arr-push arr value)
  (return (-/set-data box path arr)))
