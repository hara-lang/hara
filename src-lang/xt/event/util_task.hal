(ns xt.event.util-task
  (:require [lang.core :as l]))

(l/script :xtalk
  {:require [[xt.lang.spec-base :as xt]
             [xt.lang.common-data :as xtd]
             [xt.lang.common-sort-topo :as xtst]
             [xt.lang.spec-promise :as spec-promise]]})

(defn.xt ^{:public true}
  new-task
  "Creates a task declaration with dependencies, arguments, and lifecycle options."
  {:added "4.1"}
  [id deps args opts]
  (return (xt/x:obj-assign {"::" "loader.task" :id id :deps deps :args args} opts)))

(defn.xt ^{:public true}
  task-load
  "Loads one task, reusing an already valid value unless checks are disabled."
  {:added "4.1"}
  [task]
  (var #{id assert-fn load-fn args get-fn check-fn load-no-check} task)
  (when (xt/x:is-function? assert-fn)
    (when (not (assert-fn))
      (xt/x:err (xt/x:cat "Assertion Failed - " id))))
  (when (not= true load-no-check)
    (var current (:? (xt/x:is-function? get-fn) (get-fn)))
    (var check (:? (xt/x:is-function? check-fn) (check-fn current)))
    (when (== true check)
      (return (spec-promise/x:promise-run current))))
  (when (xt/x:is-function? args)
    (:= args (args)))
  (:= args (:? (xt/x:nil? args) [] args))
  (return (spec-promise/x:promise-run (xt/x:apply load-fn args))))

(defn.xt ^{:public true}
  task-unload
  "Unloads a task only when its current value passes the unload check."
  {:added "4.1"}
  [task]
  (var #{unload-fn get-fn check-fn unload-no-check} task)
  (when (not= true unload-no-check)
    (var current (:? (xt/x:is-function? get-fn) (get-fn)))
    (var check (:? (xt/x:is-function? check-fn) (check-fn current)))
    (when (not= true check)
      (return (spec-promise/x:promise-run false))))
  (return
   (spec-promise/x:promise-then
    (spec-promise/x:promise-run (unload-fn))
    (fn [_]
      (return true)))))

(defn.xt ^{:public true}
  unload-tasks-loop
  "Recursively unloads completed tasks in a supplied reverse order."
  {:added "4.1"}
  [tasks completed ids out hook-fn]
  (when (== 0 (xt/x:len ids))
    (return (spec-promise/x:promise-run out)))
  (var id (xt/x:first ids))
  (var remaining (xt/x:arr-slice ids 1 (xt/x:len ids)))
  (when (not= true (xt/x:get-key completed id))
    (return (-/unload-tasks-loop tasks completed remaining out hook-fn)))
  (xt/x:del-key completed id)
  (var task (xt/x:get-key tasks id))
  (return
   (spec-promise/x:promise-then
    (-/task-unload task)
    (fn [unloaded]
      (when (xt/x:not-nil? hook-fn)
        (hook-fn id unloaded))
      (xt/x:arr-push out [id unloaded])
      (return (-/unload-tasks-loop tasks completed remaining out hook-fn))))))

(defn.xt ^{:public true}
  new-loader-blank
  "Creates an empty, resettable dependency loader."
  {:added "4.1"}
  []
  (return {"::" "loader" :completed {} :loading {} :errored nil :order [] :tasks {}}))

(defn.xt ^{:public true}
  add-tasks
  "Adds tasks and computes their topological dependency order."
  {:added "4.1"}
  [loader tasks]
  (var previous (. loader ["tasks"]))
  (var all (xt/x:arr-assign (xt/x:obj-vals previous) tasks))
  (var deps (xt/x:arr-map all
                           (fn [entry]
                             (return [(. entry ["id"]) (. entry ["deps"])]))))
  (return
   (xt/x:obj-assign
    loader
    {:order (xtst/sort-topo deps)
     :tasks (xtd/arr-juxt all
                          (fn [entry] (return (. entry ["id"])))
                          xtd/clone-nested)})))

(defn.xt ^{:public true}
  new-loader
  "Creates a loader with an initial task set."
  {:added "4.1"}
  [tasks]
  (return (-/add-tasks (-/new-loader-blank) tasks)))

(defn.xt ^{:public true}
  list-loading
  "Lists currently loading task ids."
  {:added "4.1"}
  [loader]
  (return (xt/x:obj-keys (. loader ["loading"]))))

(defn.xt ^{:public true}
  list-completed
  "Lists completed task ids."
  {:added "4.1"}
  [loader]
  (return (xt/x:obj-keys (. loader ["completed"]))))

(defn.xt ^{:public true}
  list-incomplete
  "Lists declared tasks that are not yet completed."
  {:added "4.1"}
  [loader]
  (var #{tasks completed order} loader)
  (var out [])
  (xt/for:array [id order]
    (when (and (xt/x:not-nil? (xt/x:get-key tasks id))
               (not= true (xt/x:get-key completed id)))
      (xt/x:arr-push out id)))
  (return out))

(defn.xt ^{:public true}
  list-waiting
  "Lists incomplete tasks whose dependencies have all completed."
  {:added "4.1"}
  [loader]
  (var #{tasks loading completed order} loader)
  (var out [])
  (xt/for:array [id order]
    (var task (xt/x:get-key tasks id))
    (when (and (xt/x:not-nil? task)
               (not= true (xt/x:get-key loading id))
               (not= true (xt/x:get-key completed id))
               (xt/x:arr-every (. task ["deps"])
                                (fn [dep-id]
                                  (return (== true (xt/x:get-key completed dep-id))))))
      (xt/x:arr-push out id)))
  (return out))

(defn.xt ^{:public true}
  load-tasks-single
  "Loads one task, updates loader state, and optionally resumes the load loop."
  {:added "4.1"}
  [loader id hook-fn complete-fn loop-fn]
  (var #{tasks loading completed} loader)
  (var task (xt/x:get-key tasks id))
  (xt/x:set-key loading id true)
  (return
   (spec-promise/x:promise-then
    (spec-promise/x:promise-catch
     (-/task-load task)
     (fn [error]
       (xt/x:del-key loading id)
       (xt/x:set-key loader "errored" id)
       (when (xt/x:not-nil? hook-fn)
         (hook-fn id false))
       (when (xt/x:not-nil? complete-fn)
         (complete-fn error))
       (xt/x:throw error)))
    (fn [result]
      (xt/x:del-key loading id)
      (xt/x:set-key completed id true)
      (when (xt/x:not-nil? hook-fn)
        (hook-fn id true))
      (return (:? (xt/x:not-nil? loop-fn)
                  (loop-fn loader hook-fn complete-fn)
                  result))))))

(defn.xt ^{:public true}
  load-tasks
  "Loads dependency-ready tasks until all complete or one errors."
  {:added "4.1"}
  [loader hook-fn complete-fn]
  (var #{errored order} loader)
  (when (xt/x:not-nil? errored)
    (var reject-fn
         (fn []
           (xt/x:throw (xt/x:cat "ERR - Task Errored - " errored))))
    (return (spec-promise/x:promise reject-fn)))
  (var waiting (-/list-waiting loader))
  (when (< 0 (xt/x:len waiting))
    (var waiting-lu (xtd/arr-juxt waiting
                                  (fn [id] (return id))
                                  (fn [id] (return true))))
    (var next-id
         (xt/x:first
          (xtd/arr-keep order
                        (fn [id]
                          (when (== true (xt/x:get-key waiting-lu id))
                            (return id))))))
    (return (-/load-tasks-single loader next-id hook-fn complete-fn -/load-tasks)))
  (var incomplete (-/list-incomplete loader))
  (when (== 0 (xt/x:len incomplete))
    (when (xt/x:not-nil? complete-fn)
      (complete-fn true))
    (return (spec-promise/x:promise-run loader)))
  (return (spec-promise/x:promise-run loader)))

(defn.xt ^{:public true}
  unload-tasks
  "Unloads completed tasks in reverse dependency order."
  {:added "4.1"}
  [loader hook-fn]
  (var #{order completed tasks} loader)
  (var reverse-order (xt/x:arr-reverse order))
  (return (-/unload-tasks-loop tasks completed reverse-order [] hook-fn)))
