  {:require [[js.react :as r]]
   :import [["blessed" :as Blessed]
            ["blessed-contrib" :as [* BlessedContrib]]
            ["react-blessed" :as ReactBlessed]
            ["react-blessed-contrib" :as [* ReactBlessedContrib]]
            ["drawille" :as Drawille]
            ["bresenham" :as Bresenham]]})

