;; drawille and bresenham

(defmacro.js canvas
  "Creates a drawille canvas."
  {:added "4.0"}
  [width height]
  (list 'new 'Drawille width height))

(def$.js line Bresenham)

(defn.js createScreen
  "Creates a terminal screen with standard keyboard teardown bindings."
  {:added "4.0"}
  [title options]
  (const screen-instance
         (-/screen
          (Object.assign
           {:autoPadding true
            :smartCSR true
            :useBCE true
            :sendFocus true
            :dockBorders true
            :grabKeys true
            :debug true
            :title title
            :cursor {:artificial true
                     :shape {:bg "yellow" :fg "white" :bold true}
                     :blink true}}
           options)))
  (screen-instance.key ["q" "C-c" "Esc"]
                       (fn []
                         (. screen-instance (destroy))))
  (return screen-instance))

(defn.js ^{:style/indent 1}
  run
  "Renders a React Blessed element into a newly created terminal screen."
  {:added "4.0"}
  [element title options]
  (-/renderBlessed element (-/createScreen title options)))
