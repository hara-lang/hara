(ns js.react
  (:config {:override [> ref derive sync get set]})
  (:require [lang.core :as l]
            [js.react.compile :as compile]))

(l/script :js
  {:import [["react" :as React]
            ["react-dom/client" :as ReactDOM]
            ["react-nil" :as ReactNIL]]
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.common-lib :as k]
             [xt.lang.common-data :as xtd]
             [xt.lang.common-tree :as xtt]
             [xt.lang.common-string :as str]
             [xt.lang.common-math :as math]
             [xt.lang.common-trace :as trace]
             [xt.lang.spec-promise :as promise]]})

;; React fragments

(def$.js Children React.Children)
(def$.js Component React.Component)
(def$.js Fragment React.Fragment)
(def$.js Profiler React.Profiler)
(def$.js PureComponent React.PureComponent)
(def$.js StrictMode React.StrictMode)
(def$.js Suspense React.Suspense)
(def$.js cloneElement React.cloneElement)
(def$.js createContext React.createContext)
(def$.js createElement React.createElement)
(def$.js createFactory React.createFactory)
(def$.js createRef React.createRef)
(def$.js forwardRef React.forwardRef)
(def$.js isValidElement React.isValidElement)
(def$.js lazy React.lazy)
(def$.js memo React.memo)
(def$.js useCallback React.useCallback)
(def$.js useContext React.useContext)
(def$.js useDebugValue React.useDebugValue)
(def$.js useEffect React.useEffect)
(def$.js useImperativeHandle React.useImperativeHandle)
(def$.js useLayoutEffect React.useLayoutEffect)
(def$.js useMemo React.useMemo)
(def$.js useReducer React.useReducer)
(def$.js useRef React.useRef)
(def$.js useState React.useState)
(def$.js useSyncExternalStore React.useSyncExternalStore)
(def$.js useTransition React.useTransition)
(def$.js version React.version)

(def$.js % React.createElement)
(def$.js createDOMRoot ReactDOM.createRoot)
(def$.js renderDom ReactDOM.render)
(def$.js hydrateDom ReactDOM.hydrate)
(def$.js flushDom ReactDOM.flushSync)
(def$.js unmountDom ReactDOM.unmountComponentAtNode)
(def$.js createPortalDom ReactDOM.createPortal)
(def$.js findDom ReactDOM.findDOMNode)
(def$.js versionDOM ReactDOM.version)
(def$.js renderNil ReactNIL.render)

;; React hook shortcuts

(defmacro.js ^{:style/indent 0}
  curr
  "Returns a ref's current value."
  {:added "4.0"}
  ([reference]
   (list '. reference 'current)))

(defmacro.js curr:set
  "Sets a ref's current value."
  {:added "4.0"}
  ([reference value]
   (list := (list '. reference 'current) value)))

(defmacro.js ref
  "Expands to React.useRef."
  {:added "4.0"}
  ([& args]
   (apply list 'React.useRef args)))

(defmacro.js ^{:style/indent 1}
  local
  "Expands to React.useState."
  {:added "4.0"}
  ([& args]
   (apply list 'React.useState args)))

(defmacro.js const
  "Retains a constant value through React.useRef."
  {:added "4.0"}
  ([value]
   (list '. (list 'React.useRef value) 'current)))

(defmacro.js ^{:style/indent 1}
  derive
  "Derives a value from a dependency vector and expression."
  {:added "4.0"}
  ([watch value]
   (list 'React.useCallback value watch)))

(defmacro.js ^{:style/indent 1}
  init
  "Expands to an effect with an empty dependency vector."
  {:added "4.0"}
  ([_ & body]
   (list 'React.useEffect (apply list 'fn [] body) [])))

(defmacro.js ^{:style/indent 1}
  run
  "Expands to an effect without an explicit dependency vector."
  {:added "4.0"}
  ([_ & body]
   (list 'React.useEffect (apply list 'fn [] body))))

(defmacro.js ^{:style/indent 1}
  watch
  "Expands to an effect watched by the supplied values."
  {:added "4.0"}
  ([watch-values & body]
   (list 'React.useEffect (apply list 'fn [] body) watch-values)))

(defmacro.js sync
  "Synchronises a local value through an effect."
  {:added "4.0"}
  ([local-value set-fn & [expr]]
   (list 'React.useEffect
         (list 'fn []
               (list 'if set-fn
                     (list set-fn (list 'or expr local-value))))
         [local-value])))

(defmacro.js get
  "Returns the generated getter symbol for a local state name."
  [state]
  (list '. (symbol (str/camel-case (name state)))))

(defmacro.js set
  "Returns the generated setter symbol for a local state name."
  [state]
  (list '. (symbol (str/camel-case (str "set-" (name state))))))

(defmacro.js ^{:style/indent 1
               :static/deps ['React]}
  ui
  "Compiles a declarative layout with an explicit component map."
  {:added "4.0"}
  [layout components]
  (compile/compile-layout layout components))

(defmacro.js ^{:static/deps ['React]}
  return-ui
  "Compiles a complete declarative React UI specification."
  {:added "4.0"}
  [input]
  (compile/compile-full input))

;; DOM helpers

(defn.js getDOMRoot
  [domNode]
  (var internalKey
       (xtd/arr-find (xtd/obj-keys domNode)
                     (fn [key]
                       (return (. key (startsWith "__reactContainer$"))))))
  (if (> internalKey 0)
    (return (. domNode [internalKey])))
  (return nil))

(defn.js renderDOMRoot
  [id Component]
  (var rootElement (document.getElementById id))
  (var root (-/getDOMRoot rootElement))
  (when (xt/x:nil? root)
    (:= root (-/createDOMRoot rootElement)))
  (. root (render [:% Component]))
  (return true))

(defn.js useStateFor
  [controls key]
  (var setterKey (+ "set" (str/capitalize key)))
  (return [(. controls [key])
           (. controls [setterKey])]))

(defclass.js Try
  [:- -/Component]

  (fn constructor [props]
    (super props)
    (:= (. this state)
        {:hasError false
         :error nil}))

  ^{:- [:static]}
  (fn getDerivedStateFromError [error]
    (return #{error {:hasError true}}))

  (fn render []
    (if (. this state hasError)
      (return (. this props fallback))
      (return (. this props children)))))

(defn.js id
  "Makes a random, hook-stable identifier."
  {:added "4.0"}
  [n]
  (:# "eslint-disable-next-line react-hooks/rules-of-hooks")
  (return (-/const (. (Math.random)
                      (toString 36)
                      (substr 2 (or n 6))))))

;; General hook helpers

(defn.js useStep
  "Returns completion state and setter for a one-step effect."
  {:added "4.0"}
  [f]
  (var [done setDone] (-/local false))
  (-/run []
    (when (not done)
      (return (f setDone))))
  (return [done setDone]))

(defn.js makeLazy
  "Makes a lazy component unless the input is already a function."
  {:added "4.0"}
  [component]
  (if (xt/x:is-function? component)
    (return component)
    (return (-/lazy (fn:> component)))))

(defn.js useLazy
  "Constructs a lazy component once per React render lifecycle."
  {:added "4.0"}
  [component]
  (if (xt/x:is-function? component)
    (return component)
    (do (:# "eslint-disable-next-line react-hooks/rules-of-hooks")
        (return (-/const (-/lazy (fn:> component)))))))

(defn.js useRefresh
  "Constructs a refresh function."
  {:added "4.0"}
  []
  (var [flag setFlag] (-/local true))
  (var refresh (fn:> (setFlag (not flag))))
  (return refresh))

(defn.js useGetCount
  "Returns a getter for a counter incremented on every render."
  {:added "4.0"}
  [n]
  (var counterRef (-/ref (or n 0)))
  (-/run []
    (-/curr:set counterRef (+ 1 (-/curr counterRef))))
  (var getCount (-/const (fn:> (-/curr counterRef))))
  (return getCount))

(defn.js useFollowRef
  "Returns a ref which follows a value after applying f."
  {:added "4.0"}
  [value f]
  (:= f (or f k/identity))
  (:# "eslint-disable-next-line react-hooks/rules-of-hooks")
  (var valueRef (-/ref (f value)))
  (:# "eslint-disable-next-line react-hooks/rules-of-hooks")
  (-/watch [value]
    (-/curr:set valueRef (f value)))
  (return valueRef))

(defn.js useIsMounted
  "Returns a function that reports whether the component remains mounted."
  {:added "4.0"}
  ([]
   (var mountedRef (-/ref true))
   (var isMounted (-/const (fn:> (return (-/curr mountedRef)))))
   (-/init []
     (return (fn []
               (-/curr:set mountedRef false))))
   (return isMounted)))

(defn.js useIsMountedWrap
  "Wraps a callback so it only runs while mounted."
  {:added "4.0"}
  ([]
   (var isMounted (-/useIsMounted))
   (return
    (fn [f]
      (return
       (fn [...args]
         (when (isMounted)
           (f ...args))))))))

(defn.js useMountedCallback
  "Calls cb with mount state changes."
  {:added "4.0"}
  [cb]
  (var cbRef (-/useFollowRef cb))
  (-/init []
    (when (-/curr cbRef)
      ((-/curr cbRef) true))
    (return
     (fn []
       (when (-/curr cbRef)
         ((-/curr cbRef) false))))))

(defn.js useFollowDelayed
  "Tracks a value after a delay while the component remains mounted."
  {:added "4.0"}
  [value delay isMounted]
  (when (== 0 delay)
    (return [value k/noop]))
  (:# "eslint-disable-next-line react-hooks/rules-of-hooks")
  (var [delayed setDelayed] (-/local value))
  (:# "eslint-disable-next-line react-hooks/rules-of-hooks")
  (-/watch [value]
    (promise/x:with-delay delay
                          (fn []
                            (when (isMounted)
                              (setDelayed value)))))
  (return [delayed setDelayed]))

(defn.js useStablized
  "Keeps a stable value while its nested representation matches."
  [input isStabilized]
  (var [output setOutput] (-/local input))
  (-/watch [input]
    (when (and isStabilized
               (xt/x:not-nil? input)
               (xtt/eq-nested input output))
      (setOutput input)))
  (return (:? isStabilized output input)))

;; Interval and timeout lifecycle helpers

(defn.js runIntervalStop
  "Stops the interval stored in intervalRef and clears the ref."
  {:added "4.0"}
  [intervalRef]
  (var interval (-/curr intervalRef))
  (when (xt/x:not-nil? interval)
    (clearInterval interval)
    (-/curr:set intervalRef nil))
  (return interval))

(defn.js runIntervalStart
  "Restarts an interval from function, delay, and interval refs."
  {:added "4.0"}
  [fRef msRef intervalRef]
  (var prev (-/runIntervalStop intervalRef))
  (when (not= nil (-/curr msRef))
    (var curr (setInterval (fn []
                             ((-/curr fRef)))
                           (-/curr msRef)))
    (-/curr:set intervalRef curr)
    (return [prev curr]))
  (return [prev]))

(defn.js useInterval
  "Returns idempotent start and stop controls for a repeating task."
  {:added "4.0"}
  ([f ms]
   (var fRef (-/useFollowRef f))
   (var msRef (-/useFollowRef ms))
   (var intervalRef (-/ref nil))
   (var stopInterval
        (-/const (fn:> (-/runIntervalStop intervalRef))))
   (var startInterval
        (-/const (fn:> (-/runIntervalStart fRef msRef intervalRef))))
   (-/watch [ms]
     (startInterval)
     (return stopInterval))
   (return #{stopInterval
             startInterval})))

(defn.js runTimeoutStop
  "Stops the timeout stored in timeoutRef and clears the ref."
  {:added "4.0"}
  [timeoutRef]
  (var timeout (-/curr timeoutRef))
  (when (xt/x:not-nil? timeout)
    (clearTimeout timeout)
    (-/curr:set timeoutRef nil))
  (return timeout))

(defn.js runTimeoutStart
  "Restarts a timeout from function, delay, and timeout refs."
  {:added "4.0"}
  [fRef msRef timeoutRef]
  (var prev (-/runTimeoutStop timeoutRef))
  (var curr (setTimeout (fn []
                          ((-/curr fRef)))
                        (or (-/curr msRef) 0)))
  (-/curr:set timeoutRef curr)
  (return [prev curr]))

(defn.js useTimeout
  "Returns idempotent start and stop controls for a delayed task."
  {:added "4.0"}
  ([f ms init]
   (var fRef (-/useFollowRef f))
   (var msRef (-/useFollowRef ms))
   (var timeoutRef (-/ref nil))
   (var stopTimeout
        (-/const (fn:> (-/runTimeoutStop timeoutRef))))
   (var startTimeout
        (-/const (fn:> (-/runTimeoutStart fRef msRef timeoutRef))))
   (-/init []
     (when (not= false init)
       (startTimeout))
     (return stopTimeout))
   (return #{stopTimeout
             startTimeout})))

(defn.js useCountdown
  "Returns a countdown value, setter, and start/stop controls."
  {:added "4.0"}
  [initial onComplete opts]
  (var #{[(:= interval 1000)
         (:= step 1)
         (:= to 0)]}
       (or opts {}))
  (var [current setCurrent] (-/local initial))
  (var #{stopInterval
         startInterval}
       (-/useInterval
        (fn []
          (cond (> current to)
                (setCurrent (- current step))

                :else
                (do (stopInterval)
                    (when onComplete
                      (onComplete current)))))
        interval))
  (return [current
           setCurrent
           {:startCountdown startInterval
            :stopCountdown stopInterval}]))

(defn.js useNow
  "Returns the current time and controls for refreshing it."
  {:added "4.0"}
  [interval]
  (var [now setNow] (-/local (xt/x:now-ms)))
  (var #{stopInterval
         startInterval}
       (-/useInterval
        (fn []
          (setNow (xt/x:now-ms)))
        (or interval 1000)))
  (return [now {:startNow startInterval
                :stopNow stopInterval}]))

(defn.js useSubmit
  "Builds waiting, action, and error state around a promise-producing submitter."
  {:added "4.0"}
  [#{[result
      (:= delay 200)
      (:= setResult (fn:>))
      (:= onSubmit (fn:>))
      (:= onError (fn [res]
                    (trace/LOG! "ERRORED" res)
                    (return (. res ["body"]))))
      (:= onSuccess k/identity)
      (:= isMounted (fn:> true))]}]
  (var [waiting setWaiting] (-/local (fn:> false)))
  (var onAction
       (fn []
         (setWaiting true)
         (. (promise/x:promise
             (fn []
               (when onSubmit
                 (return (onSubmit)))))
            (then (fn [res]
                    (when (isMounted)
                      (setResult (onSuccess res)))
                    (setTimeout
                     (fn []
                       (when (isMounted)
                         (setWaiting false)))
                     delay)))
            (catch (fn [err]
                     (setTimeout
                      (fn []
                        (when (isMounted)
                          (setWaiting false)))
                      delay)
                     (when (isMounted)
                       (setResult (onError err))))))))
  (var errored (and result (== "error" (. result ["status"]))))
  (return #{waiting setWaiting
            onAction errored}))

(defn.js useSubmitResult
  "Builds submit controls with result reset behaviour."
  {:added "4.0"}
  [#{onResult onSubmit onError onSuccess result setResult}]
  (var isMounted (-/useIsMounted))
  (:# "eslint-disable-next-line react-hooks/rules-of-hooks")
  (:= [result setResult]
      (:? (xt/x:nil? setResult)
          (-/local)
          [result setResult]))
  (-/watch [result]
    (when onResult
      (onResult result)))
  (var #{waiting setWaiting onAction errored}
       (-/useSubmit #{onSubmit onError onSuccess result setResult isMounted}))
  (return #{waiting
            setWaiting
            onAction
            errored
            isMounted
            result
            setResult
            {:onActionPress (fn:> (:? errored
                                      (setResult nil)
                                      (onAction)))
             :onActionReset (fn:> (setResult nil))}}))

;; Value conversion helpers

(defn.js convertIndex
  "Converts a list value to its selectable list index."
  {:added "4.0"}
  [#{[data
      value
      setValue
      allowNotFound
      (:= valueFn k/identity)]}]
  (var forwardFn
       (fn [idx]
         (var out (and data (. data [(or idx 0)])))
         (return (:? out (valueFn out)))))
  (var reverseFn
       (fn [label]
         (var idx (xtd/arr-find (xtd/arr-map data valueFn)
                                (fn:> [item]
                                      (== item label))))
         (return (:? allowNotFound idx (math/max 0 idx)))))
  (var setIndex (fn [idx] (setValue (forwardFn idx))))
  (var index (reverseFn value))
  (var items (xtd/arr-map data valueFn))
  (return #{setIndex items index}))

(defn.js convertModular
  "Converts a selectable value to a modular index."
  {:added "4.0"}
  [#{[data
      value
      setValue
      (:= valueFn k/identity)
      indexFn]}]
  (var forwardFn
       (fn [idx]
         (var out
              (and data
                   (. data [(math/mod-pos (or idx 0)
                                           (xt/x:len data))])))
         (return (:? out (valueFn out)))))
  (var reverseFn
       (fn [label]
         (var pval (indexFn))
         (var nval (math/max 0
                             (xtd/arr-find (xtd/arr-map data valueFn)
                                           (fn:> [item]
                                                 (== item label)))))
         (var offset (math/mod-offset pval nval (xt/x:len data)))
         (return (+ pval offset))))
  (var setIndex (fn [idx] (setValue (forwardFn idx))))
  (var index (reverseFn value))
  (var items (xtd/arr-map data valueFn))
  (return #{setIndex items index}))

(defn.js convertIndices
  "Converts a selection of values to selectable indices."
  {:added "4.0"}
  [#{[data
      values
      setValues
      (:= valueFn k/identity)]}]
  (var forwardFn
       (fn [indices]
         (var out [])
         (xt/for:array [[i entry] indices]
           (when entry
             (x:arr-push out (. data [i]))))
         (return out)))
  (var reverseFn
       (fn:> [input-values]
             (xtd/arr-map data
                          (fn:> [entry]
                                (<= 0
                                    (xtd/arr-find input-values
                                                  (fn:> [item]
                                                        (== item entry))))))))
  (var setIndices (fn [indices] (setValues (forwardFn indices))))
  (var indices (reverseFn values))
  (var items (xtd/arr-map data valueFn))
  (return #{items setIndices indices}))

(defn.js convertPosition
  "Maps between a discrete value and a linear position."
  {:added "4.0"}
  [#{length max min step}]
  (var divisions (math/floor (/ (- max min) step)))
  (var unit (/ length divisions))
  (var forwardFn
       (fn [value]
         (var n (math/floor (/ (- value min) step)))
         (return (* n unit))))
  (var reverseFn
       (fn [position]
         (var relative (math/max 0 (math/min length position)))
         (var n (math/round (/ relative unit)))
         (var out (+ min (* n step)))
         (return out)))
  (return #{forwardFn reverseFn}))

(defn.js useChanging
  "Keeps a selected value valid as its available data changes."
  {:added "4.0"}
  [data f state]
  (:= f (or f xtd/first))
  (:= data (or data []))
  (:# "eslint-disable-next-line react-hooks/rules-of-hooks")
  (var [value setValue] (or state (-/local (f data))))
  (-/watch [(xt/x:json-encode data)]
    (when (and (xtd/not-empty? data)
               (or (xt/x:nil? value)
                   (> 0 (xtd/arr-find data
                                      (fn:> [item]
                                            (== item value))))))
      (setValue (f data))))
  (return [value setValue]))

(defn.js useTree
  "Builds branch selection and rendered view state for a tree."
  {:added "4.0"}
  [#{tree root parents initial setInitial branchesFn targetFn formatFn displayFn}]
  (:= branchesFn
      (or branchesFn
          (fn [input-tree _parents _root]
            (if input-tree
              (do (var out (xtd/obj-keys input-tree))
                  (. out (sort))
                  (return out))
              (return [])))))
  (:= targetFn
      (or targetFn
          (fn [input-tree branch _parents _root]
            (if input-tree
              (return (xt/x:get-key input-tree branch))
              (return nil)))))
  (var branches (branchesFn tree parents root))
  (var [branch setBranch] (-/local (or initial (xtd/first branches))))
  (var target (:? (and tree branch)
                  (targetFn tree branch parents root)))
  (-/watch [branch initial]
    (when (and (xt/x:not-nil? branch)
               (xt/x:nil? target)
               (xtd/not-empty? branches)
               (targetFn tree (xtd/first branches) parents root))
      (setBranch (xtd/first branches)))
    (when (and (xt/x:not-nil? branch)
               setInitial
               (not= initial branch))
      (setInitial branch)))
  (var view (displayFn target branch parents root))
  (return #{branch setBranch branches view}))
