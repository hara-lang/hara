(ns js.core.style
  (:require [lang.core :as l]))

(l/script :js js.core.style
  {:require [[xt.lang.spec-base :as xt]]})

(def ^{:public true} +flex-container+
  {:writing-mode #{"horizontal-tb" "vertical-rl" "vertical-lr"
                   "sideways-rl" "sideways-lr"}
   :display #{"flex" "inline-flex"}
   :flexDirection #{"row" "row-reverse" "column" "column-reverse"}
   :flexWrap #{"nowrap" "wrap" "wrap-reverse"}
   :flexFlow [:flexDirection :flexWrap]
   :justifyContent #{"flex-start" "flex-end" "center" "space-between"
                     "space-around" "space-evenly"}
   :alignItems #{"flex-start" "flex-end" "center" "stretch" "baseline"}
   :alignContent #{"flex-start" "flex-end" "center" "stretch"
                   "space-between" "space-around" "space-evenly"}})

(def ^{:public true} +flex-item+
  {:order number?
   :flexGrow pos?
   :flexShrink pos?
   :flexBasis #{"auto" "content"}
   :flex [:flexGrow :flexShrink :flexBasis]
   :alignSelf #{"auto" "flex-start" "flex-end" "center" "stretch"
                "baseline"}})

(defmacro.js ^{:public true}
  rect
  "Creates a rect style object."
  {:added "4.0"}
  [width & [height]]
  {:width width
   :height (or height width)})

(defmacro.js ^{:public true}
  padding
  "Creates a CSS padding style object."
  {:added "4.0"}
  [top & [right bottom left]]
  {:paddingTop top
   :paddingRight (or right top)
   :paddingBottom (or bottom top)
   :paddingLeft (or left right top)})

(defmacro.js ^{:public true}
  margin
  "Creates a CSS margin style object."
  {:added "4.0"}
  [top & [right bottom left]]
  {:marginTop top
   :marginRight (or right top)
   :marginBottom (or bottom top)
   :marginLeft (or left right top)})

(defmacro.js ^{:public true}
  align
  "Creates a flex alignment style object."
  {:added "4.0"}
  [major & [minor content]]
  (cond-> {:flex 1
           :justifyContent major
           :alignItems "center"}
    minor (assoc :alignItems minor)
    content (assoc :alignContent content)))

(defmacro.js ^{:public true}
  pos
  "Creates a positioned style object."
  {:added "4.0"}
  [position & [m]]
  (cond-> {:position position}
    m (merge m)))

(defmacro.js ^{:public true}
  fillAbsolute
  "Creates a style object that fills an absolute parent."
  {:added "4.0"}
  []
  {:position "absolute"
   :top 0
   :bottom 0
   :left 0
   :right 0})

(defmacro.js ^{:public true}
  centered
  "Creates a centered flex alignment style object."
  {:added "4.0"}
  []
  {:justifyContent "center"
   :alignContent "center"
   :alignItems "center"})

(defn.js
  hue->rgb
  "Interpolates an RGB channel from hue segments."
  {:added "4.0"}
  [v1 v2 vH]
  (cond (< vH 0) (:= vH (+ vH 1))
        (> vH 1) (:= vH (- vH 1)))
  (cond (< (* 6 vH) 1)
        (return (+ v1 (* (- v2 v1) 6 vH)))
        (< (* 2 vH) 1)
        (return v2)
        (< (* 3 vH) 2)
        (return (+ v1 (* (- v2 v1) 6 (- (xt/x:div 2 3) vH))))
        :else
        (return v1)))

(defn.js
  hsl->rgb-fn
  "Converts an HSL map to an RGB vector."
  {:added "4.0"}
  [hsl]
  (var h (xt/x:div (. hsl h) 360))
  (var s (xt/x:div (. hsl s) 100))
  (var l (xt/x:div (. hsl l) 100))
  (if (== s 0)
    (return [(xt/x:m-floor (+ (* 255 l) 0.5))
             (xt/x:m-floor (+ (* 255 l) 0.5))
             (xt/x:m-floor (+ (* 255 l) 0.5))]))
  (var v2 (:? (< l 0.5)
              (* l (+ s 1))
              (- (+ l s) (* s l))))
  (var v1 (- (* 2 l) v2))
  (return [(xt/x:m-floor (+ (* 255 (hue->rgb v1 v2 (+ h (xt/x:div 1 3)))) 0.5))
           (xt/x:m-floor (+ (* 255 (hue->rgb v1 v2 h)) 0.5))
           (xt/x:m-floor (+ (* 255 (hue->rgb v1 v2 (- h (xt/x:div 1 3)))) 0.5))]))

(defn.js
  hsl->rgb-string
  "Formats an HSL map as a lowercase CSS hex colour."
  {:added "4.0"}
  [hsl]
  (var [r g b] (hsl->rgb-fn hsl))
  (return (+ "#"
             (. r (toString 16))
             (. g (toString 16))
             (. b (toString 16)))))

(defmacro.js ^{:public true}
  hsl->rgb
  "Converts an HSL map to a CSS hex colour at JavaScript runtime."
  {:added "4.0"}
  [hsl]
  (list 'hsl->rgb-string hsl))
