(ns js.core.impl
  (:config {:override [concat eval filter map reduce some]})
  (:require [lang.core :as l]))

(l/script :js js.core.impl)

;; JavaScript globals and static members used by the portable runtime surface.
(def$.js ^{:public true} JSGlobal globalThis)
(def$.js ^{:public true} JSObject globalThis.Object)
(def$.js ^{:public true} JSFunction globalThis.Function)
(def$.js ^{:public true} JSArray globalThis.Array)
(def$.js ^{:public true} JSArrayBuffer globalThis.ArrayBuffer)
(def$.js ^{:public true} JSBoolean globalThis.Boolean)
(def$.js ^{:public true} JSNumber globalThis.Number)
(def$.js ^{:public true} JSSet globalThis.Set)
(def$.js ^{:public true} JSMap globalThis.Map)
(def$.js ^{:public true} JSError globalThis.Error)
(def$.js ^{:public true} JSDate globalThis.Date)
(def$.js ^{:public true} JSString globalThis.String)
(def$.js ^{:public true} JSSymbol globalThis.Symbol)
(def$.js ^{:public true} JSMath globalThis.Math)
(def$.js ^{:public true} JSON globalThis.JSON)
(def$.js ^{:public true} Intl globalThis.Intl)
(def$.js ^{:public true} Reflect globalThis.Reflect)
(def$.js ^{:public true} Proxy globalThis.Proxy)
(def$.js ^{:public true} JSPromise globalThis.Promise)
(def$.js ^{:public true} JSBigInt globalThis.BigInt)

(def$.js ^{:public true} getOwnPropertyNames globalThis.Object.getOwnPropertyNames)
(def$.js ^{:public true} eval globalThis.eval)
(def$.js ^{:public true} E globalThis.Math.E)
(def$.js ^{:public true} LOG2E globalThis.Math.LOG2E)
(def$.js ^{:public true} PI globalThis.Math.PI)
(def$.js ^{:public true} EPSILON globalThis.Number.EPSILON)
(def$.js ^{:public true} POSITIVE-INFINITY globalThis.Number.POSITIVE_INFINITY)
(def$.js ^{:public true} NEGATIVE-INFINITY globalThis.Number.NEGATIVE_INFINITY)
(def$.js ^{:public true} now globalThis.Date.now)

(defmacro.js ^{:public true}
  toFixed
  "Formats a JavaScript number with fixed fractional precision."
  [num digits]
  (list '. num (list 'toFixed digits)))

(defmacro.js ^{:public true}
  toRadix
  "Formats a JavaScript number in the supplied radix."
  [num radix]
  (list '. (list 'js.core.impl/JSNumber num) (list 'toString radix)))

(defmacro.js ^{:public true}
  concat
  "Concatenates two JavaScript arrays."
  [arr other]
  (list '. arr (list 'concat other)))

(defmacro.js ^{:public true}
  slice
  "Returns a JavaScript array slice."
  [arr start finish]
  (list '. arr (list 'slice start finish)))

(defmacro.js ^{:public true}
  fill
  "Fills a JavaScript array over its optional bounds."
  ([arr value]
   (list '. arr (list 'fill value)))
  ([arr value start finish]
   (list '. arr (list 'fill value start finish))))

(defmacro.js ^{:public true}
  findIndex
  "Returns the first JavaScript array index matching a predicate."
  [arr pred]
  (list '. arr (list 'findIndex pred)))

(defmacro.js ^{:public true}
  flat
  "Flattens a JavaScript array to the requested depth."
  [arr depth]
  (list '. arr (list 'flat depth)))

(defmacro.js ^{:public true}
  flatMap
  "Maps and flattens a JavaScript array by one level."
  [arr f]
  (list '. arr (list 'flatMap f)))

(defmacro.js ^{:public true}
  indexOf
  "Returns the first JavaScript array index containing a value."
  [arr value]
  (list '. arr (list 'indexOf value)))

(defmacro.js ^{:public true}
  lastIndexOf
  "Returns the final JavaScript array index containing a value."
  [arr value]
  (list '. arr (list 'lastIndexOf value)))

(defmacro.js ^{:public true}
  map
  "Maps a function over a JavaScript array."
  [arr f]
  (list '. arr (list 'map f)))

(defmacro.js ^{:public true}
  reduce
  "Reduces a JavaScript array from the left."
  ([arr f]
   (list '. arr (list 'reduce f)))
  ([arr f initial]
   (list '. arr (list 'reduce f initial))))

(defmacro.js ^{:public true}
  reduceRight
  "Reduces a JavaScript array from the right."
  ([arr f]
   (list '. arr (list 'reduceRight f)))
  ([arr f initial]
   (list '. arr (list 'reduceRight f initial))))

(defmacro.js ^{:public true}
  filter
  "Filters a JavaScript array with a predicate."
  [arr pred]
  (list '. arr (list 'filter pred)))

(defmacro.js ^{:public true}
  every
  "Checks whether every JavaScript array entry satisfies a predicate."
  [arr pred]
  (list '. arr (list 'every pred)))

(defmacro.js ^{:public true}
  some
  "Checks whether a JavaScript array entry satisfies a predicate."
  [arr pred]
  (list '. arr (list 'some pred)))

(defmacro.js ^{:public true}
  delayed
  "Schedules body execution through setTimeout and returns nil."
  [[ms] & body]
  (list 'do
        (list 'setTimeout
              (list 'fn []
                    (list 'new 'js.core.impl/JSPromise
                          (list 'fn [] (apply list 'do body))))
              ms)
        nil))

(defmacro.js ^{:public true}
  repeating
  "Schedules body execution through setInterval."
  [[ms] & body]
  (list 'setInterval
        (list 'fn []
              (list 'new 'js.core.impl/JSPromise
                    (list 'fn [] (apply list 'do body))))
        ms))

(defmacro.js ^{:public true}
  postMessage
  "Posts a value to a worker-like JavaScript receiver."
  [worker value]
  (list '. worker (list 'postMessage value)))
