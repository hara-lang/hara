(ns js.core.dom
  (:config {:role :internal})
  (:require [lang.core :as l]))

(l/script :js js.core.dom)

(defmacro.js ^{:public true}
  body
  "Returns the current document body."
  {:added "4.0"}
  []
  (list '. 'document 'body))

(defmacro.js ^{:public true}
  id
  "Finds an element by identifier on a document-like root."
  {:added "4.0"}
  ([element-id]
   (list '. 'document (list 'getElementById element-id)))
  ([root element-id]
   (list '. root (list 'getElementById element-id))))

(defmacro.js ^{:public true}
  text
  "Reads an element's text content by identifier."
  {:added "4.0"}
  ([element-id]
   (list '. (list '. 'document (list 'getElementById element-id)) 'textContent))
  ([root element-id]
   (list '. (list '. root (list 'getElementById element-id)) 'textContent)))

(defmacro.js ^{:public true}
  val
  "Parses an element's text content as JSON."
  {:added "4.0"}
  ([element-id]
   (list '. 'JSON
         (list 'parse
               (list '. (list '. 'document (list 'getElementById element-id))
                     'textContent))))
  ([root element-id]
   (list '. 'JSON
         (list 'parse
               (list '. (list '. root (list 'getElementById element-id))
                     'textContent)))))

(defmacro.js ^{:public true}
  click
  "Clicks an element or resolves a string identifier first."
  {:added "4.0"}
  [element]
  (if (string? element)
    (list '. (list '. 'document (list 'getElementById element)) (list 'click))
    (list '. element (list 'click))))

(defmacro.js ^{:public true}
  sel
  "Selects one descendant using querySelector."
  {:added "4.0"}
  ([selector]
   (list '. 'document (list 'querySelector selector)))
  ([root selector]
   (list '. root (list 'querySelector selector))))

(defmacro.js ^{:public true}
  q
  "Selects all descendants using querySelectorAll."
  {:added "4.0"}
  ([selector]
   (list '. 'document (list 'querySelectorAll selector)))
  ([root selector]
   (list '. root (list 'querySelectorAll selector))))

(defmacro.js ^{:public true}
  appendChild
  "Appends a child to a root or to document."
  {:added "4.0"}
  ([child]
   (list '. 'document (list 'appendChild child)))
  ([root child]
   (list '. root (list 'appendChild child))))

(defmacro.js ^{:public true}
  removeChild
  "Removes a child from an element."
  {:added "4.0"}
  [root child]
  (list '. root (list 'removeChild child)))

(defmacro.js ^{:public true}
  remove
  "Removes an element from its parent."
  {:added "4.0"}
  [element]
  (list '. element (list 'remove)))

(defmacro.js ^{:public true}
  setAttribute
  "Sets an element attribute."
  {:added "4.0"}
  [element key value]
  (list '. element (list 'setAttribute key value)))

(defmacro.js ^{:public true}
  getAttribute
  "Gets an element attribute."
  {:added "4.0"}
  [element key]
  (list '. element (list 'getAttribute key)))
