(ns js.core.fetch
  (:config {:role :internal})
  (:require [lang.core :as l]))

(l/script :js js.core.fetch)

(defmacro.js ^{:public true}
  fetch
  "Starts a JavaScript fetch request and optionally decodes its response."
  {:added "4.0"}
  [url & [opts]]
  (let [opts (or opts {})
        decode (get opts :as)
        request-opts (dissoc opts :as)
        request (list 'fetch url request-opts)]
    (if decode
      (list '. request
            (list 'then
                  (list 'fn ['res]
                        (list 'return
                              (list '. 'res (list (symbol decode)))))))
      request)))

(defmacro.js ^{:public true}
  toText
  "Decodes a fetch response promise as text."
  {:added "4.0"}
  [promise]
  (list '. promise
        (list 'then
              (list 'fn ['res]
                    (list 'return (list '. 'res (list 'text)))))))

(defmacro.js ^{:public true}
  toJson
  "Decodes a fetch response promise as JSON."
  {:added "4.0"}
  [promise]
  (list '. promise
        (list 'then
              (list 'fn ['res]
                    (list 'return (list '. 'res (list 'json)))))))

(defmacro.js ^{:public true}
  toBlob
  "Decodes a fetch response promise as a blob."
  {:added "4.0"}
  [promise]
  (list '. promise
        (list 'then
              (list 'fn ['res]
                    (list 'return (list '. 'res (list 'blob)))))))

(defmacro.js ^{:public true}
  toPrint
  "Logs and preserves a fetch response promise value."
  {:added "4.0"}
  [promise]
  (list '. promise
        (list 'then
              (list 'fn ['res]
                    (list 'console.warn 'res)
                    (list 'return 'res)))))

(defmacro.js ^{:public true}
  toAssign
  "Assigns a response object into state and resolves to that state."
  {:added "4.0"}
  [promise state]
  (list '. promise
        (list 'then
              (list 'fn ['res]
                    (list 'return
                          (list 'Object.assign state 'res))))))

(defn.js ^{:public true}
  fetch-api
  "Fetches an API endpoint and resolves its successful data payload."
  {:added "4.0"}
  [url opts]
  (return
   (. (. (globalThis.fetch url (or opts {}))
         (then
          (fn [res]
            (if (== 200 (. res ["status"]))
              (return (. res (json)))
              (throw res)))) )
      (then
       (fn [payload]
         (if (== "ok" (. payload ["status"]))
           (return (. payload ["data"]))
           (throw (. payload ["data"]))))))))
