(ns js.core.util
  (:require [lang.core :as l]))

(l/script :js js.core.util)

(defn.js ^{:public true}
  pass-callback
  "Returns a successful Node-style callback value or rethrows its error."
  {:added "4.0"}
  [err res]
  (if err
    (throw err))
  (return res))

(defn.js ^{:public true}
  wrap-callback
  "Adapts a promise to a Node-style callback and preserves its result promise."
  {:added "4.0"}
  [promise callback]
  (return (. promise (then
                      (fn:> [res] (callback nil res))
                      (fn:> [err] (callback err nil))))))
