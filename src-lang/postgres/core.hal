;; ============================================================================
;; postgres.core — Foundation-compatible PostgreSQL composition facade.
;;
;; The implementation remains source-owned by graph, typed, and application
;; modules.  This facade restores the stable import surface without inserting a
;; second runtime or compatibility coordinate.
;; ============================================================================
(ns postgres.core
  (:config {:role :facade})
  (:require [postgres.application :as application]
            [postgres.core.builtin :as builtin]
            [postgres.core.addon :as addon]
            [postgres.core.graph :as graph-macros]
            [postgres.core.graph-base :as graph]
            [postgres.core.graph-insert :as insert]
            [postgres.core.graph-query :as query]
            [postgres.core.graph-view :as view]
            [postgres.core.system :as system]
            [postgres.core.impl :as implementation]
            [postgres.core.impl-insert :as impl-insert]
            [postgres.core.impl-main :as impl-main]
            [postgres.core.impl-update :as impl-update]
            [postgres.entity :as entity]
            [postgres.gen.bind-macro :as bind]))

(intern-all postgres.core.builtin
           postgres.core.addon
           postgres.core.impl
           postgres.core.graph
           postgres.core.system)

(intern-in
 [uuid-generate-v4 builtin/uuid-generate-v4]
 [exec addon/exec]
 [ARRAY addon/ARRAY]
 [id addon/id]
 [full addon/full]
 [coord addon/coord]
 [rand-hex addon/rand-hex]
 [sha1 addon/sha1]
 [client-list addon/client-list]
 [time-ms addon/time-ms]
 [time-us addon/time-us]
 [throw addon/throw]
 [error addon/error]
 [assert addon/assert]
 [case addon/case]
 [get-stack-diagnostics addon/get-stack-diagnostics]
 [field-id addon/field-id]
 [map:rel addon/map:rel]
 [map:js-text addon/map:js-text]
 [map:js addon/map:js]
 [do:reduce addon/do:reduce]
 [b:select addon/b:select]
 [ret addon/ret]
 [b:update addon/b:update]
 [b:insert addon/b:insert]
 [b:delete addon/b:delete]
 [perform addon/perform]
 [random-enum addon/random-enum]
 [do:plpgsql addon/do:plpgsql]
 [full-str addon/full-str]
 [t:select implementation/t:select]
 [t:get-field implementation/t:get-field]
 [t:get implementation/t:get]
 [t:id implementation/t:id]
 [t:count implementation/t:count]
 [t:exists implementation/t:exists]
 [t:delete implementation/t:delete]
 [t:insert implementation/t:insert]
 [t:insert! implementation/t:insert!]
 [t:upsert implementation/t:upsert]
 [t:update implementation/t:update]
 [t:update! implementation/t:update!]
 [t:modify implementation/t:modify]
 [t:fields implementation/t:fields]
 [defsel.pg view/defsel.pg]
 [defret.pg view/defret.pg]
 [view view/view]
 [view-descriptor view/view-descriptor]
 [registry-snapshot view/registry-snapshot]
 [restore-registry! view/restore-registry!]
 [reset-registry! view/reset-registry!]
 [register-table view/register-table]
 [register-view view/register-view]
 [t-select impl-main/t-select]
 [t-id impl-main/t-id]
 [t-count impl-main/t-count]
 [t-exists impl-main/t-exists]
 [t-delete impl-main/t-delete]
 [t-fields impl-main/t-fields]
 [t-insert impl-insert/t-insert]
 [t-upsert impl-insert/t-upsert]
 [t-update impl-update/t-update]
 [t-modify impl-update/t-modify]
 [id-fn graph/id-fn]
 [count-fn graph/count-fn]
 [exists-fn graph/exists-fn]
 [select-fn graph/select-fn]
 [delete-fn graph/delete-fn]
 [update-fn graph/update-fn]
 [modify-fn graph/modify-fn]
 [insert-fn insert/insert-fn]
 [query-fn query/query-fn]
 [g:where graph-macros/g:where]
 [g:id graph-macros/g:id]
 [g:count graph-macros/g:count]
 [g:exists graph-macros/g:exists]
 [g:select graph-macros/g:select]
 [g:get graph-macros/g:get]
 [g:update graph-macros/g:update]
 [g:modify graph-macros/g:modify]
 [g:delete graph-macros/g:delete]
 [g:insert graph-macros/g:insert]
 [q graph-macros/q]
 [q:get graph-macros/q:get]
 [system-pg-tmpl system/pg-tmpl]
 [bind-app bind/bind-app]
 [bind-schema bind/bind-schema]
 [E entity/E]
 [app-create application/app-create]
 [app-list application/app-list]
 [app application/app]
 [app-schema application/app-schema]
 [app-typed application/app-typed]
 [app-rebuild application/app-rebuild]
 [app-clear application/app-clear])
