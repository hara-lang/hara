(ns postgres.core.supabase
  (:require [lang.common.compiler :as compiler]
            [lang.core :as l]))

(l/script :postgres
  {:macro-only true})

(defmacro.pg create-role
  [role]
  [:create-role role])

(defmacro.pg alter-role-bypassrls
  [role]
  [:alter-role role :bypassrls])

(defmacro.pg grant-public
  [schema]
  [:do [:grant-usage-on-schema schema
        :to ['anon 'authenticated 'service_role]]
       [:grant-all-on-all-tables-in-schema schema
        :to ['anon 'authenticated 'service_role]]
       [:alter-default-privileges-for-role 'postgres
        :in-schema schema
        :grant-all-on-tables-to ['anon 'authenticated 'service_role]]])

(defmacro.pg revoke-execute-privileges-from-public
  [schema]
  [:alter-default-privileges-for-role 'postgres
   :in-schema schema
   :revoke-execute-on-functions-from-public])

(defmacro.pg grant-usage
  [schema & [roles]]
  [:grant-usage-on-schema schema
   :to (or roles ['anon 'authenticated 'service_role])])

(defmacro.pg grant-tables
  [schema & [roles]]
  [:grant-all-on-all-tables-in-schema schema
   :to (or roles ['anon 'authenticated 'service_role])])

(defmacro.pg grant-privileges
  [schema & [roles]]
  [:alter-default-privileges-for-role 'postgres
   :in-schema schema
   :grant-all-on-tables-to (or roles ['anon 'authenticated 'service_role])])

(defmacro.pg grant-all
  [schemas & [roles access]]
  (let [roles (or roles ['anon 'authenticated 'service_role])
        access (or access {})
        usage (if (contains? access :usage) (:usage access) true)
        tables (if (contains? access :tables) (:tables access) true)
        privileges (if (contains? access :privileges) (:privileges access) false)]
    (vec (concat [:do]
                 (mapcat (fn [schema]
                           (filter identity
                                   [(if usage [:grant-usage-on-schema schema :to roles] nil)
                                    (if tables [:grant-all-on-all-tables-in-schema schema :to roles] nil)
                                    (if privileges [:alter-default-privileges-for-role 'postgres
                                                    :in-schema schema :grant-all-on-tables-to roles] nil)]))
                         schemas)))))

(defmacro.pg auth-uid
  []
  '(auth.uid))

(defmacro.pg auth-email
  []
  '(auth.email))

(defmacro.pg auth-role
  []
  '(auth.role))

(defmacro.pg auth-jwt
  []
  '(auth.jwt))

(defmacro.pg is-supabase
  []
  [:exists [:select 1 :from 'information_schema.schemata
            :where {:schema-name "auth"}]])

(defmacro.pg raise
  [message detail & [options]]
  (let [options (or options {})
        statements (filter identity
                           [(if (:http-status options)
                              [:perform ['set-config "response.status"
                                         (str (:http-status options)) true]])
                            (if (:http-headers options)
                              [:perform ['set-config "response.headers"
                                         (:http-headers options) true]])
                            [:raise (or (:state options) :exception) :using
                             [[:detail := detail] [:message := message]]]])]
    (vec (concat [:do] statements))))

(defmacro.pg show-roles
  []
  [:select ['rolname 'rolsuper 'rolbypassrls 'rolcanlogin]
   :from 'pg_roles
   :where ['rolname :in ["authenticated" "service_role" "anon"]]])

(defn request-event
  [request]
  (cond (contains? request "db/sync") "db/sync"
        (contains? request "db/remove") "db/remove"
        :else nil))

(defn resolve-literal
  [form]
  (cond (or (map? form) (vector? form) (string? form)
            (number? form) (boolean? form) (nil? form)) form
        (symbol? form)
        (let [resolved (Base/resolve form)]
          (if (and resolved (bound? resolved)) (deref resolved) form))
        :else form))

(defn normalize-realtime-payload
  [payload]
  (let [payload (resolve-literal payload)]
    (if (map? payload)
      (with-meta payload (assoc (meta payload) :js true))
      payload)))

(defmacro.pg realtime-send
  ([topic event payload]
   (list 'realtime-send topic event payload false))
  ([topic event payload private?]
   (list 'realtime.send (normalize-realtime-payload payload)
         event topic private?)))

(defmacro.pg realtime-topic
  []
  '(realtime.topic))

(defmacro.pg realtime-send-request
  ([topic request]
   (list 'realtime-send-request topic request false))
  ([topic request private?]
   (let [request (resolve-literal request)
         event (request-event request)]
     (or event
         (throw (ex :argument {:request request}
                    :ex/message "Unsupported xt.db realtime request")))
     (list 'realtime.send (normalize-realtime-payload request)
           event topic private?))))

(defn process-return
  [ret]
  (if (= ret "") nil ret))

(defn get-form-type
  [form]
  (cond (string? form) :text
        (integer? form) :bigint
        (number? form) :numeric
        (map? form) :jsonb
        (:type (meta form)) (:type (meta form))
        (list? form) (or (if (keyword? (first form)) (first form) nil)
                         (:static/type (meta (first form)))
                         (:static/return (meta (first form)))
                         (throw (ex :argument {:form form}
                                    :ex/message "Cannot determine type")))
        :else (throw (ex :argument {:form form}
                          :ex/message "Cannot determine type"))))

(defmacro with-role-single
  [[role type] form]
  (let [role (case role :admin 'service_role :auth 'authenticated :anon 'anon role)
        type (or type (get-form-type form))]
    (list 'process-return
          (list '!.pg
                (list 'try [:set-local-role role]
                      (list 'let [(list type 'out) form] (list 'return 'out))
                      (list 'catch 'others
                            (list 'return {:code 'SQLSTATE :message 'SQLERRM})))))))

(defmacro with-role
  [[role type] & forms]
  (let [result (map (fn [form] (list 'with-role-single [role type] form)) forms)]
    (if (= 1 (count forms)) (first result) (vec result))))

(defmacro with-auth-single
  [[user-id type] form]
  (let [type (or type (get-form-type form))]
    (list 'process-return
          (list '!.pg
                (list 'try [:set-local-role 'authenticated]
                      [:perform ['set-config "request.jwt.claim.sub"
                                 (list :text user-id) true]]
                      (list 'let [(list type 'out) form] (list 'return 'out))
                      (list 'catch 'others
                            (list 'return {:code 'SQLSTATE :message 'SQLERRM})))))))

(defmacro with-auth
  [[user-id type] & forms]
  (let [result (map (fn [form] (list 'with-auth-single [user-id type] form)) forms)]
    (if (= 1 (count forms)) (first result) (vec result))))

(defmacro with-super-single
  [[user-id type] form]
  (let [type (or type (get-form-type form))]
    (list 'process-return
          (list '!.pg
                (list 'try [:set-local-role 'authenticated]
                      [:perform ['set-config "request.jwt.claim.sub" user-id true]]
                      [:perform ['set-config "request.jwt.claims"
                                 (list :text {:sub user-id :user_metadata {:super true}}) true]]
                      (list 'let [(list type 'out) form] (list 'return 'out))
                      (list 'catch 'others
                            (list 'return {:code 'SQLSTATE :message 'SQLERRM})))))))

(defmacro with-super
  [[user-id type] & forms]
  (let [result (map (fn [form] (list 'with-super-single [user-id type] form)) forms)]
    (if (= 1 (count forms)) (first result) (vec result))))

(defn grant-roles
  "Normalizes archived Supabase grant categories to PostgreSQL role symbols."
  [grant]
  (case grant
    :all ['anon 'authenticated 'service_role]
    :auth ['authenticated 'service_role]
    :admin ['service_role]
    grant))

(defn transform-entry-defn
  "Appends Supabase function privilege statements from declaration metadata."
  [body {:keys [entry mopts selection]}]
  (let [grant (get-in entry [:api/meta :sb/grant])
        function-form
        (list '.
              #{(:static/schema entry)}
              (apply list
                     (IObjType/with-meta (:id entry) {})
                     (map :modifiers (:static/input entry))))]
    (if grant
      (str body
           "\n"
           (compiler/emit-direct
            (list 'do
                  [:revoke-all-on-function function-form :from-public]
                  [:grant-execute-on-function function-form :to (grant-roles grant)])
            selection
            mopts))
      body)))

(defn transform-entry-deftype
  "Appends Supabase RLS and table-access statements from declaration metadata."
  [body {:keys [entry mopts selection]}]
  (let [metadata (:api/meta entry)
        rls (:sb/rls metadata)
        access (:sb/access metadata)
        table-form (list '. #{(:static/schema entry)} #{(str (:id entry))})
        rls-output (if rls
                     (compiler/emit-direct
                      [:alter-table table-form :enable-row-level-security]
                      selection mopts)
                     nil)
        access-forms
        (vec
         (filter identity
                 (map (fn [[role operations]]
                        (let [operations
                              (cond (vector? operations)
                                    (vec (map (fn [operation] (symbol (name operation))) operations))

                                    (= :all operations)
                                    ['select 'update 'delete 'insert]

                                    (= :none operations)
                                    nil

                                    :else operations)
                              role (case role
                                     :admin 'service_role
                                     :auth 'authenticated
                                     :anon 'anon
                                     role)]
                          (if operations
                            [:grant operations :on-table table-form :to role]
                            nil)))
                      (vec (seq access)))))
        access-output (if (empty? access-forms)
                        nil
                        (compiler/emit-direct
                         (apply list 'do access-forms)
                         selection mopts))]
    (str/join "\n" (filter identity [body rls-output access-output]))))

(defn transform-entry
  "Transforms one emitted PostgreSQL entry according to its Supabase metadata."
  [body environment]
  (let [entry (:entry environment)]
    (case (:op-key entry)
      :defn (transform-entry-defn body environment)
      :deftype (transform-entry-deftype body environment)
      body)))
