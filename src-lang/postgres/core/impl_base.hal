(ns postgres.core.impl-base
  (:require [lang.base.emit-common :as emit-common]
            [lang.base.preprocess-base :as preprocess]
            [lang.base.util :as util]
            [lang.core.impl :as impl]
            [lang.core.library :as library]
            [lang.core.library-snapshot :as snapshot]
            [lang.model.v1.spec-postgres.postgres-common :as common]
            [lang.model.v1.spec-postgres.deftype.common :as table]
            [postgres.application :as app]
            [lang.model.v1.spec-postgres.deftype.hydrate :as hydrate]))

(def ^:dynamic *skip-checks* false)

(defn table-symbol
  [entry]
  (let [schema (:static/schema entry)]
    (if schema
      (list 'pg:raw (table/qualified-token schema (:id entry)))
      (or (util/sym-full entry) (:id entry)))))

(defn schema-attrs [table-schema key]
  (let [entry (get table-schema key)]
    (if (vector? entry) (first entry) entry)))

(defn schema-key? [table-schema key]
  (not (nil? (get table-schema key))))

(defn module-table-entries
  [module]
  (->> (:code module)
       vals
       (map (fn [entry]
              (or (and (:static/schema-seed entry)
                       entry)
                  (some-> entry
                          (select-keys [:module :id])
                          common/pg-link-symbol
                          resolve
                          deref))))
       (filter :static/schema-seed)))

(defn module-application-view
  [module app-name]
  (let [entries (module-table-entries module)
        current (when app-name (app/app app-name))
        tables (merge (:tables current)
                      (->> entries
                           (mapcat (comp :vec :static/schema-seed))
                           (partition 2)
                           (map (fn [pair]
                                  [(symbol (str (first pair))) (second pair)]))
                           (into {})))
        pointers (merge (:pointers current)
                        (into {}
                              (map (fn [entry]
                                     [(:id entry)
                                      (select-keys entry [:id :module :lang :section])])
                                   entries)))]
    (if (or current (seq entries))
      (app/app-create-raw tables pointers (:typed current))
      nil)))

(defn ensure-table-entry-static
  [book entry mopts]
  (let [module (get mopts :module)
        snapshot (get mopts :snapshot)]
    (cond (nil? entry) nil
          (not= :table (:static/dbtype entry)) entry
          (or (:static/schema-seed entry)
              (:static/schema-primary entry)
              (:static/application entry)) entry
          (nil? book) entry
          :else
          (let [entry-module (or (and module
                                      (= (:id module) (:module entry))
                                      module)
                                  (get-in book [:modules (:module entry)]))
                hydrated (hydrate/pg-deftype-hydrate
                           (:form-input entry)
                           (:grammar book)
                           {:module entry-module
                            :book book
                            :snapshot snapshot})
                hmeta (first hydrated)
                entry' (merge entry hmeta)]
            (if (or (:static/schema-seed entry')
                    (:static/application entry'))
              entry'
              (throw (ex :database
                         {:entry (:id entry)
                          :module (:module entry)
                          :entry-module (:id entry-module)
                          :hmeta hmeta}
                         :ex/message "Table hydrate did not produce schema metadata.")))))))

(defn prep-entry
  "Prepares a PostgreSQL entry through the active Library and Book." 
  [sym mopts]
  (if (map? sym)
    [(get mopts :book) sym]
    (let [lang (get mopts :lang)
          module (get mopts :module)
          snapshot (get mopts :snapshot)
          classified (emit-common/emit-symbol-classify sym mopts)
          type (first classified)
          initial-sym-module (second classified)
          sym-id (symbol (name sym))
          local-entry (and (= '- initial-sym-module)
                           (some-> sym-id resolve deref))
          sym-module (cond local-entry (:module local-entry)
                           (nil? initial-sym-module)
                           (throw (ex :database {:input sym}
                                      :ex/message "No module entry for sym"))
                           (= '- initial-sym-module) (:id module)
                           :else initial-sym-module)
          lang (or lang :postgres)
          base-book (or (:book mopts)
                        (and snapshot (snapshot/get-book snapshot lang))
                        (library/get-book (impl/runtime-library) lang))
          resolved (if local-entry
                     [base-book local-entry]
                     (common/pg-resolve-entry
                      {:lang lang
                       :module sym-module
                       :id sym-id
                       :section :code}
                      (assoc mopts :book base-book)))
          book (first resolved)
          raw-entry (second resolved)
          entry (ensure-table-entry-static book raw-entry mopts)]
      (if entry
        [book entry]
        (throw (ex :database
                   {:input sym-id :type type :module sym-module}
                   :ex/message "No entry found"))))))

(defn prep-table
  "Prepares a table entry and schema through the original application path."
  [sym full mopts]
  (let [module (get mopts :module)]
    (if *skip-checks*
      [{:id sym} {} (snapshot/get-book (:snapshot mopts) (:lang mopts))]
      (let [prepared (prep-entry sym mopts)
            book (first prepared)
            entry (second prepared)
            application (get entry :static/application)
            schema-seed (get entry :static/schema-seed)
            app-view (module-application-view module (first application))
            schema (if (not full)
                     (or schema-seed (:schema app-view))
                     (or (:schema app-view) schema-seed))
            table-schema (or (:table-schema entry)
                             (get-in schema [:tree (keyword (name sym))]))]
        (if table-schema
          [entry table-schema (cond-> (or mopts {})
                               schema (assoc :schema schema)
                               book (assoc :book book)
                               app-view (assoc :application app-view))]
          (throw (ex :not-found
                     {:sym sym
                      :entry (:id entry)
                      :module (:module entry)
                      :current-module (:id module)
                      :application application
                      :schema-keys (keys (:tree schema))}
                     :ex/message "Table not found in schema")))))))

(defn t-input-check
  ([table-schema input] (t-input-check table-schema input {}))
  ([table-schema input params]
   (let [valid? (get params :valid true)
         missing? (get params :missing true)
         invalid (filter (fn [key] (not (schema-key? table-schema key))) (keys input))
         required (filter (fn [key]
                            (let [attrs (schema-attrs table-schema key)]
                              (and (not (:ignore attrs))
                                   (or (:required attrs) (:primary attrs))
                                   (nil? (get-in attrs [:sql :default])))))
                          (keys table-schema))
         absent (filter (fn [key] (nil? (get input key))) required)]
     (cond (and valid? (seq invalid))
           (throw (ex :database {:keys (vec invalid) :data input} :ex/message "Invalid keys"))
           (and missing? (seq absent))
           (throw (ex :not-found {:keys (vec absent) :data input} :ex/message "Missing keys"))
           :else input))))

(defn t-input-collect
  [table-schema input]
  (reduce-kv (fn [out key value]
               (assoc out key [value (schema-attrs table-schema key)]))
             {}
             input))

(defn t-val-process
  [process output]
  (if (vector? process)
    (reduce (fn [out step]
              (cond (symbol? step) (list step out)
                    (vector? step) (apply list (first step) out (rest step))
                    :else out))
            output
            process)
    (list process output)))

(defn already-cast? [value type]
  (and (list? value) (= type (first value))))

(defn ref-primary-attrs
  "Resolves the primary type of a referenced table when available."
  [attrs options]
  (let [link (get-in attrs [:ref :link])
        resolved (when link
                   (common/pg-resolve-entry link (or options {})))
        book (first resolved)
        entry (second resolved)
        entry (when entry
                (ensure-table-entry-static book entry (or options {})))
        primary (:static/schema-primary entry)
        primary (if (vector? primary)
                  (or (first (filter (fn [value] (= (:id value) :id)) primary))
                      (first primary))
                  primary)]
    (or primary
        (get-in attrs [:ref :type])
        {:type :uuid})))

(defn t-val-fn
  [table-schema key value params options]
  (let [attrs (schema-attrs table-schema key)
        type (:type attrs)
        sql (:sql attrs)
        cast (cond (= :enum type)
                   (if (and (list? value) (= '++ (first value)))
                     value
                     (list '++ value (get-in attrs [:enum :ns])))
                   (= :ref type)
                   (let [target-attrs (if (:schema options)
                                         (ref-primary-attrs attrs options)
                                         {:type (or (get-in attrs [:ref :type]) :uuid)})
                         target-type (or (:type target-attrs) :uuid)]
                     (if (and (= :enum (:type target-attrs))
                              (not (and (list? value) (= '++ (first value)))))
                       (list '++ value (:ns (:enum target-attrs)))
                       (if (already-cast? value target-type)
                       value
                       (list target-type value))))
                   :else
                   (let [target-type (or (get {:long :bigint :int :integer
                                               :bool :boolean :string :text}
                                              type)
                                         type)]
                     (if (already-cast? value target-type)
                       value
                       (list target-type value))))
        with-default (if (and (not (nil? (:default sql))) (:coalesce params))
                       (list 'coalesce cast (:default sql))
                       cast)]
    (if (:process sql)
      (t-val-process (:process sql) with-default)
      with-default)))

(defn t-key-attrs-fn
  [entry]
  (let [key (first entry)
        attrs-entry (second entry)
        attrs (if (vector? attrs-entry) (first attrs-entry) attrs-entry)
        base (cond (string? key) key
                   (or (keyword? key) (symbol? key)) (util/sym-default-str key)
                   :else (str key))]
    (if (= :ref (:type attrs)) (str base "_id") base)))

(defn t-key-fn [table-schema key]
  (t-key-attrs-fn [key [(schema-attrs table-schema key)]]))

(defn t-sym-fn
  [table-schema key sym]
  (let [attrs (schema-attrs table-schema key)
        type (:type attrs)
        column (t-key-fn table-schema key)]
    (cond (= :ref type)
          (list (or (get-in attrs [:ref :type]) :uuid)
                (list 'coalesce
                      (list :->> sym column)
                      (list :->> (list :-> sym (util/sym-default-str key)) "id")))
          (= :enum type)
          (list '++ (list :->> sym column) (get-in attrs [:enum :ns]))
          :else (list (or (get {:long :bigint :int :integer :bool :boolean
                                :string :text} type) type)
                      (list :->> sym column)))))

(defn t-build-js-map
  [table-schema input params options]
  (let [values (reduce-kv (fn [out key pair]
                            (assoc out key
                                   (t-val-fn table-schema key (first pair) params options)))
                          {}
                          input)
        ordered (filter (fn [key] (not (nil? (get values key))))
                        (keys table-schema))]
    (apply list 'jsonb-build-object
           (reduce (fn [out key]
                     (conj (conj out (t-key-fn table-schema key)) (get values key)))
                   []
                   ordered))))

(defn t-create-fn [spec input params]
  (let [prepared (prep-table spec false {})
        table-schema (second prepared)
        options (nth prepared 2)]
    (t-input-check table-schema input params)
    (t-build-js-map table-schema (t-input-collect table-schema input) params options)))

(defn t-returning-cols-default [returning key-fn]
  (vec (map (fn [key] #{(util/sym-default-str key)}) returning)))

(defn t-join-target-sym [link]
  (let [module (or (:module link) (:ns link))
        id (:id link)]
    (if (and module id)
      (symbol (name module) (name id))
      nil)))

(defn t-returning-cols
  [table-schema returning key-fn]
  (let [key-fn (or key-fn t-key-attrs-fn)]
    (vec
     (reduce (fn [out value]
             (cond (map? value)
                   (conj out (if (:as value)
                               [(:expr value) :as (:as value)]
                               (:expr value)))
                   (keyword? value)
                   (if (schema-key? table-schema value)
                     (conj out #{(key-fn [value [(schema-attrs table-schema value)]])})
                     (if *skip-checks*
                       out
                       (throw (ex :database {:key value :data returning}
                                  :ex/message "Invalid returning column"))))
                   (symbol? value) (conj out #{(util/sym-default-str value)})
                   :else out))
             []
             returning))))

(defn t-returning
  ([table-schema returning] (t-returning table-schema returning nil))
  ([table-schema returning key-fn]
   (let [key-fn (or key-fn t-key-attrs-fn)]
     (cond (or (= '* returning) (list? returning) (number? returning) (nil? returning)) returning
           (set? returning) (list '--- (t-returning-cols table-schema returning key-fn))
           (or (map? returning) (keyword? returning) (symbol? returning))
           (list '--- (t-returning-cols table-schema #{returning} key-fn))
           :else (throw (ex :database {:value returning} :ex/message "Not valid"))))))

(defn t-where-hashvec-transform
  [clauses transform]
  #{(vec
     (reduce (fn [out clause]
               (let [mapped (transform
                             (reduce (fn [entry pair]
                                       (assoc entry (first pair) (second pair)))
                                     {}
                                     (partition 2 clause)))
                     flat (reduce (fn [values entry]
                                    (conj (conj values (first entry)) (second entry)))
                                  []
                                  mapped)]
                 (if (seq out)
                   (into (into out [:or]) flat)
                   flat)))
             []
             clauses))})

(defn t-where-hashvec
  [where transform]
  (let [clauses (reduce (fn [state value]
                          (cond (or (= value [:or]) (= value :or))
                                {:done (conj (:done state) (:current state)) :current []}
                                (or (= value [:and]) (= value :and)) state
                                :else (assoc state :current (conj (:current state) value))))
                        {:done [] :current []}
                        (first where))]
    (t-where-hashvec-transform
     (conj (:done clauses) (:current clauses))
     transform)))

(defn t-where-transform
  [table-schema where options]
  (let [transform
        (fn [input]
          (reduce-kv
           (fn [out key value]
             (if (not (schema-key? table-schema key))
               (if *skip-checks* out
                   (throw (ex :database {:key key :data input} :ex/message "Invalid columns")))
               (let [attrs (schema-attrs table-schema key)
                     type (:type attrs)
                     link (get-in attrs [:ref :link])
                     pair (cond (nil? value) [:is-null]
                                (and (= :enum type)
                                     (not (and (list? value) (= '++ (first value)))))
                                [:eq (list '++ value (get-in attrs [:enum :ns]))]
                                (and (= :ref type) (or (map? value) (util/hashvec? value)))
                                [:in [:select #{"id"}
                                      :from (table-symbol (or link attrs))
                                      \\
                                      :where (t-where-transform
                                              (or (get-in options [:schema :tree (keyword (name (:id link)))]) {})
                                              value options)]]
                                (vector? value) value
                                :else [:eq value])]
                 (assoc out (t-key-fn table-schema key) pair))))
           {}
           input))]
    (cond (util/hashvec? where) (t-where-hashvec where transform)
          (map? where) (transform where)
          :else (throw (ex :database {:value where} :ex/message "Not Allowed")))))

(defn t-wrap-json [form as json-output into field]
  (if (or (= :json as) (= :jsonb as) (and (= :record as) into))
    [:with 'j-ret :as form \\ :select
     (list json-output (if field (list '. 'j-ret #{field}) 'j-ret))
     :from 'j-ret]
    form))

(defn t-join-transform [table-schema join source-sym options]
  (vec (reduce (fn [out value]
                 (cond (keyword? value)
                       (let [attrs (schema-attrs table-schema value)]
                         (if (= :ref (:type attrs))
                           (let [target (t-join-target-sym (get-in attrs [:ref :link]))]
                             (conj out [:left-join target :on
                                        [:= (list '. #{source-sym} #{(t-key-fn table-schema value)})
                                         (list '. target #{"id"})]]))
                           (throw (ex :database {:key value} :ex/message "Key is not a ref"))))
                       :else (conj out value)))
               [] join)))

(defn newline [form enabled] (if enabled (conj form \\) form))
(defn t-wrap-join [form join params]
  (if join (into (newline form (and (seq join) (:newline params))) join) form))
(defn t-wrap-where [form where table-schema params options]
  (let [out (newline form (and where (:newline params)))
        out (if where (conj (conj out :where) (t-where-transform table-schema where options)) out)]
    (vec (if (:where-args params) (concat out (:where-args params)) out))))
(defn t-wrap-order-by [form columns table-schema params]
  (let [out (newline form (and columns (:newline params)))]
    (if columns
      (conj (conj out :order-by)
            (if (vector? columns)
              (list 'quote (vec (map (fn [key] #{(t-key-fn table-schema key)}) columns)))
              columns))
      out)))
(defn t-wrap-order-sort [form sort table-schema params]
  (if sort (conj form sort) form))
(defn t-wrap-limit [form limit params]
  (if limit (conj (conj (newline form (:newline params)) :limit) limit) form))
(defn t-wrap-offset [form offset params]
  (if offset (conj (conj (newline form (:newline params)) :offset) offset) form))
(defn t-wrap-into [form target params]
  (if target (conj (conj (newline form (:newline params)) :into) target) form))
(defn t-wrap-returning [form returning params]
  (if returning (conj (conj (newline form (:newline params)) :returning) returning) form))
(defn t-wrap-group-by [form group-by params]
  (if group-by (conj (conj (newline form (:newline params)) :group-by) group-by) form))
(defn t-wrap-having [form having table-schema params options]
  (if having
    (conj (conj (newline form (:newline params)) :having)
          (t-where-transform table-schema having options))
    form))
(defn t-wrap-args [form args params]
  (vec (if args (concat (newline form (:newline params)) args) form)))
(defn t-wrap-lock [form lock params]
  (if (nil? lock)
    form
    (let [mode (first lock)
          option (second lock)
          clause (get {:update [:for :update]
                       :share [:for :share]
                       :key-share [:for :key :share]
                       :no-key-update [:for :no :key :update]} mode)
          suffix (get {:skip-locked [:skip :locked] :nowait [:nowait]} option)]
      (if (nil? clause)
        (throw (ex :database {:input mode} :ex/message "Invalid lock mode"))
        (into (newline form (:newline params))
              (if suffix (into clause suffix) clause))))))
