(ns postgres.core.impl
  (:require [lang.core :as l]
            [postgres.core.impl-base :as base]
            [postgres.core.impl-insert :as insert]
            [postgres.core.impl-main :as main]
            [postgres.core.impl-update :as update]))

(l/script :postgres postgres.core
  {:macro-only true})

(defmacro.pg t:select
  [spec-sym & [params]]
  (main/t-select spec-sym (or params {})))

(defmacro.pg t:get-field
  [spec-sym & [params]]
  (let [params (or params {})]
    (or (:where params)
        (throw (ex :argument {:params params} :ex/message "No WHERE clause")))
    (with-meta
      (main/t-select spec-sym (merge {:single true :as :raw} params))
      {:op/type :get})))

(defmacro.pg t:get
  [spec-sym & [params]]
  (let [params (or params {})]
    (or (:where params)
        (throw (ex :argument {:params params} :ex/message "No WHERE clause")))
    (with-meta
      (main/t-select spec-sym (merge {:single true} params))
      {:op/type :get})))

(defmacro.pg t:id
  [spec-sym & [params]]
  (let [params (or params {})]
    (or (:where params)
        (throw (ex :argument {:params params} :ex/message "No WHERE clause")))
    (main/t-id spec-sym params)))

(defmacro.pg t:count
  [spec-sym & [params]]
  (main/t-count spec-sym (or params {})))

(defmacro.pg t:exists
  [spec-sym & [params]]
  (main/t-exists spec-sym (or params {})))

(defmacro.pg t:delete
  [spec-sym & [params]]
  (main/t-delete spec-sym (or params {})))

(defmacro.pg t:insert
  [spec-sym data & [params]]
  (insert/t-insert spec-sym data (or params {})))

(defmacro.pg t:insert!
  [spec-sym data & [params]]
  (insert/t-insert spec-sym data (merge {:track :ignore} (or params {}))))

(defmacro.pg t:upsert
  [spec-sym data & [params]]
  (insert/t-upsert spec-sym data (or params {})))

(defmacro.pg t:update
  [spec-sym & [params]]
  (update/t-update spec-sym (or params {})))

(defmacro.pg t:update!
  [spec-sym & [params]]
  (update/t-update spec-sym (merge {:track :ignore :as :raw} (or params {}))))

(defmacro.pg t:modify
  [spec-sym & [params]]
  (update/t-modify spec-sym (or params {})))

(defmacro.pg t:fields
  [spec-sym & [params]]
  (main/t-fields spec-sym (or params {})))
