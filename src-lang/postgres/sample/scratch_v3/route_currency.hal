(ns postgres.sample.scratch-v3.route-currency
  (:require [lang.core :as l]
            [postgres.gen.bind-macro :as bind-pg]
            [postgres.gen.gen-bind :as bind]
            [postgres.sample.scratch-v3]))

(l/script :xtalk
  {:require [[xt.lang.spec-base :as xt]]
   :export [MODULE]})

(defn route-list
  "Collects the generated Currency mutation routes."
  []
  (vec (map (fn [pair]
              (assoc (bind-pg/bind-function (second pair))
                     :url (str "api/currency/" (name (first pair)))
                     :type "route"))
            (bind-pg/list-api 'postgres.sample.scratch-v3))))

(def.xt ROUTES
  (@! (-/route-list)))

(defn.xt make-routes
  "Collects the generated Currency mutation routes indexed by URL."
  []
  (var out {})
  (xt/for:array [entry -/ROUTES]
    (xt/x:set-key out (. entry ["url"]) entry))
  (return out))

(def.xt MODULE (!:module))
