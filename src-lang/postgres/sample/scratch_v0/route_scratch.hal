(ns postgres.sample.scratch-v0.route-scratch
  (:require [lang.core :as l]
            [postgres.gen.gen-bind :as bind]))

(l/script :xtalk
  {:require [[xt.lang.spec-base :as xt]]})

(defn route-list
  "Collects the generated scratch-v0 route entries."
  []
  (bind/route-list 'postgres.sample.scratch-v0.route-entries))

(def.xt ROUTES
  (@! (-/route-list)))

(defn.xt make-routes
  "Collects the generated scratch-v0 routes indexed by URL."
  []
  (var out {})
  (xt/for:array [entry -/ROUTES]
    (xt/x:set-key out (. entry ["url"])
                  (xt/x:obj-assign {"type" "route"} entry)))
  (return out))
