(ns postgres.entity
  (:require [lang.common.grammar-spec :as grammar-spec]
            [lang.core.script :as script]
            [lang.model.v1.spec-postgres.postgres-entity-util :as ut]))

(intern-in
 [init-addons ut/init-addons]
 [init-default-ns-str ut/init-default-ns-str]
 [get-addon ut/get-addon]
 [add-addon ut/add-addon])

(def ESpec
  {:id #{:id/none :id/v4 :id/v1 :id/text map?}
   :class #{:none :0d/base :0d/entry :0d/log
            :1d/base :1d/entry :1d/log
            :2d/base :2d/entry :2d/log}
   :addons #{keyword? vector? map?}
   :owner #{symbol? vector?}
   :provides #{map?}
   :track #{:track/none :track/data :track/log :track/record :track/time}
   :access #{:access/public :access/auth :access/system :access/hidden :none}
   :class-types #{nil? false? string? symbol? keyword? coll?}})

(def +structural-columns+
  #{:class-table :class-link :class-context :class-ref})

(def +coord->column+
  {:table :class-table :context :class-context :id :class-ref :link :class-link})

(def +compatibility+
  {:entity {[2 :log] #{[2 :base]}
            [1 :log] #{[1 :entry] [1 :base]}
            [2 :entry] #{[2 :base]}
            [1 :entry] #{[1 :base]}}
   :addons {[1 :entry] #{[2 :base] [1 :base]}
            [0 :entry] #{[0 :base] [0 :entry] [1 :base] [2 :base]}
            [0 :base] #{[0 :base] [0 :entry]}}})

(defn parse-class
  [class]
  (if (= :none class)
    [nil :none]
    (let [depth (namespace class)
          role (name class)]
      [(parse-long (str/slice depth 0 1)) (keyword role)])))

(defn basis-for
  [[depth role] basis-kind]
  (case [depth role basis-kind]
    [0 :base :minimal] #{}
    [0 :base :expanded] #{}
    [0 :entry :minimal] #{}
    [0 :entry :expanded] #{:table :context}
    [0 :log :minimal] #{}
    [0 :log :expanded] #{}
    [1 :base :minimal] #{:table :id}
    [1 :base :expanded] #{:table :context :id}
    [1 :entry :minimal] #{:table}
    [1 :entry :expanded] #{:table :context :link}
    [1 :log :minimal] #{:table}
    [1 :log :expanded] #{:table}
    [2 :base :minimal] #{:table :context :id}
    [2 :base :expanded] #{:table :context :id}
    [2 :entry :minimal] #{:table :context}
    [2 :entry :expanded] #{:table :context}
    [2 :log :minimal] #{:table :context}
    [2 :log :expanded] #{:table :context}
    #{}))

(defn local-support-columns
  [[depth role] basis-kind relation]
  (case [relation depth role basis-kind]
    [:addon 0 :base :minimal] []
    [:addon 0 :entry :minimal] []
    [:addon 0 :entry :expanded] [:class-table :class-context]
    [:addon 1 :base :minimal] [:class-table]
    [:addon 1 :base :expanded] [:class-table :class-context]
    [:addon 1 :entry :minimal] [:class-table]
    [:addon 1 :entry :expanded] [:class-table :class-link]
    [:addon 1 :log :minimal] [:class-table]
    [:addon 2 :base :minimal] [:class-table :class-context]
    [:addon 2 :entry :minimal] [:class-table :class-context]
    [:addon 2 :log :minimal] [:class-table :class-context]
    [:entity 0 :base :minimal] []
    [:entity 0 :entry :minimal] []
    [:entity 0 :entry :expanded] [:class-table :class-context]
    [:entity 1 :base :minimal] [:class-table]
    [:entity 1 :base :expanded] [:class-table :class-context]
    [:entity 1 :entry :minimal] [:class-table]
    [:entity 1 :entry :expanded] [:class-table]
    [:entity 1 :log :minimal] [:class-table]
    [:entity 2 :base :minimal] [:class-table :class-context]
    [:entity 2 :entry :minimal] [:class-table :class-context]
    [:entity 2 :log :minimal] [:class-table :class-context]
    [:owner 1 :entry :minimal] [:class-table]
    [:owner 1 :entry :expanded] [:class-table]
    [:owner 1 :log :minimal] [:class-table]
    [:owner 2 :entry :minimal] [:class-table :class-context]
    [:owner 2 :log :minimal] [:class-table :class-context]
    []))

(defn target-support-columns
  [[depth _]]
  (case (long depth)
    0 []
    1 [:class-table]
    2 [:class-table :class-context]
    []))

(defn project-support-columns
  [relation source-tuple basis-kind target-tuple]
  (let [local-cols (local-support-columns source-tuple basis-kind relation)
        remote-cols (target-support-columns target-tuple)
        remote-cols (if (and (= relation :addon)
                             (= source-tuple [1 :entry])
                             (= target-tuple [2 :base]))
                      [:class-context :class-table]
                      remote-cols)]
    (if (> (count remote-cols) (count local-cols))
      (throw (ex :argument {:relation relation :source source-tuple
                            :basis basis-kind :target target-tuple}
                 :ex/message "Not enough local support columns"))
      (zipmap local-cols remote-cols))))

(defn column->coord
  [column]
  (reduce-kv (fn [out coord generated]
               (if (= column generated) coord out))
             nil
             +coord->column+))

(defn required-basis-for-plan
  [projection]
  (set (keep column->coord (keys projection))))

(defn allowed-target?
  [relation source-tuple target-tuple]
  (has? (or (get-in +compatibility+ [relation source-tuple]) #{}) target-tuple))

(defn public-input->basis
  [input]
  (or (:basis input)
      (basis-for (parse-class (:class input)) :expanded)))

(defn target-info
  [ref]
  (let [resolved (Base/resolve ref)]
    (if resolved
      (let [entry (deref resolved)
            input (:api/input entry)
            symname (or (:symname input) (if (:id entry) (name (:id entry)) nil))]
        (assoc (cond-> {:class (:class input)
                        :tuple (parse-class (:class input))
                        :basis (public-input->basis input)}
                 symname (assoc :symname symname))
               :ref ref))
      nil)))

(defn E-owner-pair
  [owner]
  (let [[ref key] (if (vector? owner) owner [owner nil])
        ref (ut/normalise-ref ref)]
    (if (and ref (or (nil? key) (keyword? key)))
      [(or key (keyword (str/spear-case (name ref)))) ref]
      (throw (ex :argument {:owner owner}
                 :ex/message "Invalid :owner")))))

(defn E-check-input
  [m]
  (let [retired (select-keys m [:link :spec/addon])
        _ (when (seq retired)
            (throw (ex :argument {:retired (keys retired) :input m}
                       :ex/message "Retired inputs for E")))
        valid? (fn [allowed value]
                 (or (has? (set (remove function? allowed)) value)
                     (some (fn [pred] (pred value)) (filter function? allowed))))
        errors (reduce-kv
                (fn [out key allowed]
                  (if (not (has? m key))
                    out
                    (let [value (get m key)]
                      (cond
                        (= key :addons)
                        (let [values (cond (nil? value) []
                                           (coll? value) value
                                           :else [value])
                              bad (filter (fn [v] (not (valid? allowed v))) values)]
                          (if (seq bad) (assoc out key {:invalid bad :allowed allowed}) out))
                        (= key :owner)
                        (try (when (not (nil? value)) (E-owner-pair value)) out
                             (catch error (assoc out key {:value value})))
                        (= key :provides)
                        (if (and (map? value) (keyword? (:key value))
                                 (or (not (has? value :priority))
                                     (number? (:priority value))))
                          out (assoc out key {:value value}))
                        (valid? allowed value) out
                        :else (assoc out key {:value value :allowed allowed})))))
                {} ESpec)]
    (if (seq errors)
      (throw (ex :argument {:errors errors :input m}
                 :ex/message "Invalid inputs for E"))
      m)))

(defn E-known-addon-keys
  [application]
  (set (keys (get (deref ut/+addons+) (or application (ut/default-application))))))

(defn E-addon-bool-shorthand
  [m]
  (let [addon-keys (E-known-addon-keys (:application m))
        result (reduce-kv
                (fn [state key value]
                  (if (and (has? addon-keys key)
                           (or (true? value) (false? value) (nil? value)))
                    (if (true? value)
                      [(conj (first state) key) (dissoc (second state) key)]
                      [(first state) (dissoc (second state) key)])
                    state))
                [[] m] m)
        addons (vec (distinct (concat (or (:addons (second result)) [])
                                     (sort-by name (first result)))))]
    (assoc (second result) :addons addons)))

(defn E-addon-columns-single
  [value]
  (let [ref-fn (fn [key ref]
                 {:key key :field {:type :ref :required true :ref {:ns ref}}})]
    (cond
      (vector? value)
      (let [[key ref priority custom] value]
        (merge-nested (ref-fn key ref) {:priority priority} custom))
      (keyword? value) (ut/get-addon value)
      (map? value)
      (let [addon (ut/get-addon (or (:type value) (:key value)))]
        (merge addon (dissoc value :ref)
               (if (:ref value) (ref-fn (:key value) (:ref value)) {})))
      :else (throw (ex :argument {:input value} :ex/message "Addon Not Valid")))))

(defn basis-kind-for
  [m]
  (if (= (:basis m) (basis-for (parse-class (:class m)) :minimal)) :minimal :expanded))

(defn plan-addon-relation
  [m addon]
  (let [source-tuple (parse-class (:class m))
        target (target-info (get-in addon [:field :ref :ns]))
        target-tuple (:tuple target)]
    (if (not (allowed-target? :addons source-tuple target-tuple))
      (throw (ex :argument {:class (:class m) :target (:class target) :addon addon}
                 :ex/message "Not a valid addon"))
      (let [projection (project-support-columns :addon source-tuple
                                                (basis-kind-for m) target-tuple)]
        (reduce-kv
         (fn [out local remote]
           (assoc out local {:foreign {(:key addon) {:ns (get-in addon [:field :ref :ns])
                                                     :column remote}}}))
         {} projection)))))

(defn plan-entity-relation
  [m]
  (let [source-tuple (parse-class (:class m))
        basis-kind (basis-kind-for m)
        entity (:entity m)
        for-value (:for entity)]
    (if (not for-value)
      (throw (ex :argument {:input m} :ex/message "Need a :for keyword"))
      (let [[key ref] (if (vector? for-value)
                        for-value
                        [(keyword (str/spear-case (name (ut/normalise-ref for-value)))) for-value])
            ref (ut/normalise-ref ref)
            remote-cols (if (has? #{[1 :entry] [1 :log]} source-tuple)
                          [:class-table]
                          [:class-table :class-context])
            local-cols (local-support-columns source-tuple basis-kind :entity)
            _ (when (> (count remote-cols) (count local-cols))
                (throw (ex :argument {:class (:class m)}
                           :ex/message "Not enough local support columns for entity relation")))
            projection (zipmap local-cols remote-cols)
            unique (or (:unique entity)
                       (if (not= :log (second source-tuple))
                         [(str/snake-case (name key))]))
            field {:type :ref :required true :ref {:ns ref}
                   :sql {:cascade true :unique unique}}]
        (merge
         (reduce-kv (fn [out local remote]
                      (assoc out local {:foreign {key {:ns ref :column remote}}}))
                    {} projection)
         {key (if (= (:class m) :2d/log) (assoc field :primary "default") field)})))))

(defn plan-owner-relation
  [m]
  (if (not (:owner m))
    {}
    (let [source-tuple (parse-class (:class m))
          projection (project-support-columns :owner source-tuple
                                              (basis-kind-for m)
                                              (:tuple (target-info (second (E-owner-pair (:owner m))))))
          [key ref] (E-owner-pair (:owner m))
          unique (if (= (:class m) :1d/entry) [(str/snake-case (name key))])
          fields (reduce-kv (fn [out local remote]
                              (assoc out local {:foreign {key {:ns ref :column remote}}}))
                            {} projection)
          fields (assoc fields key {:type :ref :required true :ref {:ns ref}
                                    :sql (if unique {:cascade true :unique unique}
                                             {:cascade true})})]
      (if (has? #{:2d/log :2d/entry} (:class m))
        (merge-nested fields {key {:primary "default"}})
        fields))))

(defn coordinate-column
  [ns-str coord]
  (case coord
    :table (ut/type-class ns-str 1)
    :link (ut/type-class ns-str 2)
    :context (ut/type-class ns-str 3)
    :id (ut/type-class-ref {:sql {:unique ["class"]}} 4)))

(defn E-class-columns
  [{:keys [symname entity ns-str basis class]
    :or {ns-str ut/*ns-str* symname "Global"}}]
  (let [[depth role] (parse-class class)
        context (or (:context entity) "Global")
        basis-map (reduce (fn [out coord]
                            (assoc out (get +coord->column+ coord)
                                   (coordinate-column ns-str coord)))
                          {} basis)
        generated-map (case [depth role]
                        [0 :entry] (merge {}
                                         (if (has? basis :table) {:class-table {:generated symname}} {})
                                         (if (has? basis :context) {:class-context {:generated context}} {}))
                        [1 :base] (merge {}
                                        (if (has? basis :table) {:class-table {:primary "default"}} {})
                                        (if (has? basis :context) {:class-context {:generated context}} {}))
                        [1 :entry] (merge {}
                                         (if (has? basis :table) {:class-table {:primary "default"}} {})
                                         (if (has? basis :link) {:class-link {:generated symname}} {})
                                         (if (has? basis :context) {:class-context {:generated context}} {}))
                        [1 :log] {:class-table {:primary "default"}}
                        [2 :base] {:class-table {:primary "default" :sql {:unique ["class"]}}
                                    :class-context {:primary "default" :sql {:unique ["class"]}}}
                        [2 :entry] {:class-table {:primary "default"} :class-context {:primary "default"}}
                        [2 :log] {:class-table {:primary "default"} :class-context {:primary "default"}}
                        {})]
    (merge-nested basis-map generated-map)))

(defn E-basis-compatible?
  [m basis]
  (let [m (assoc m :basis basis)]
    (and (or (not (:entity m)) (do (plan-entity-relation m) true))
         (or (not (:owner m)) (do (plan-owner-relation m) true))
         (every? (fn [addon]
                   (if (= :ref (get-in addon [:field :type]))
                     (do (plan-addon-relation m addon) true)
                     true))
                 (map E-addon-columns-single (:addons m))))))

(defn E-resolve-basis
  [{:keys [class] :as m}]
  (let [parsed (parse-class class)
        minimal (basis-for parsed :minimal)
        expanded (basis-for parsed :expanded)]
    (if (= minimal expanded)
      minimal
      (if (try (E-basis-compatible? m minimal)
               (catch error false)) minimal expanded))))

(defn E-addon-columns
  [{:keys [addons] :as m}]
  (let [addons (map E-addon-columns-single addons)
        addon-cols (reduce (fn [out addon]
                             (let [key (:key addon)
                                   field (:field addon)
                                   is-ref (= :ref (:type field))
                                   unique (or (:unique addon)
                                              (if is-ref [(str/snake-case (name key))]))]
                               (assoc out key
                                      (cond-> field
                                        (:priority addon) (assoc :priority (:priority addon))
                                        unique (assoc-in [:sql :unique] unique)))))
                           {} addons)
        addon-class-cols (reduce (fn [out addon]
                                   (if (= :ref (get-in addon [:field :type]))
                                     (merge-nested out (plan-addon-relation m addon))
                                     out))
                                 {} addons)]
    [addon-cols addon-class-cols]))

(defn E-class-merge
  [m id-cols track-cols class-cols addon-cols]
  (let [[depth _] (parse-class (:class m))
        basis (:basis m)
        final-cols (merge-nested (merge id-cols track-cols class-cols addon-cols) (:columns m))
        class-uniques (vec (set (mapcat (fn [attrs] (or (get-in attrs [:sql :unique]) []))
                                      (vals final-cols))))
        col-uniques (cond (or (= 0 (or depth 0)) (empty? class-uniques)) {}
                          (has? basis :context)
                          {:class-table {:sql {:unique class-uniques}}
                           :class-context {:sql {:unique class-uniques}}}
                          :else {:class-table {:sql {:unique class-uniques}}})]
    (merge-nested final-cols col-uniques)))

(defn E-main-track
  [{:keys [id class track ns-str] :as m}]
  (let [[_ role] (parse-class class)
        defaults (case role
                   :log [:id/v1 :track/log]
                   :base [:id/v4 :track/log]
                   :entry [:id/v4 :track/data]
                   [:id/none :track/none])
        id (or id (first defaults))
        track (or track (second defaults))
        id (case id
             :id/v1 (ut/type-id-v1)
             :id/v4 (ut/type-id-v4)
             :id/text (ut/type-id-text ns-str)
             :id/none nil
             id)
        track-val (ut/get-tracking track)
        track-cols (apply hash-map (ut/fill-priority (ut/get-tracking-columns track) 200))]
    [(if id {:id (assoc id :priority 0)} {}) track-cols track-val]))

(defn E-main
  [{:keys [entity access] :as m}]
  (let [[id-cols track-cols track-val] (E-main-track m)
        access-val (ut/get-access access)
        class-cols (if entity (merge-nested (E-class-columns m) (plan-entity-relation m))
                       (E-class-columns m))
        [addon-cols addon-class-cols] (E-addon-columns m)
        final-cols (E-class-merge m id-cols track-cols
                                  (merge-nested class-cols addon-class-cols
                                                (plan-owner-relation m)) addon-cols)]
    {:api/meta access-val
     :api/input (dissoc m :ns-str :application)
     :public (if (has? #{:none :access/hidden} access) false true)
     :track track-val
     :raw (vec (sort-by (fn [pair] [(or (:priority (second pair)) 50)
                                    (or (:priority-index (second pair)) 0)])
                        final-cols))}))

(defn E-main-spec
  [{:keys [provides]}]
  (if (and provides grammar-spec/*symbol*)
    (let [{:keys [key priority]} provides]
      (ut/add-addon key
                    (ut/type-ref (or (namespace grammar-spec/*symbol*)
                                     (name (ns-current)))
                                 (name grammar-spec/*symbol*))
                    priority))))

(defn normalise-class-types
  [class-types]
  (let [strn (fn [value] (if (keyword? value) (name value) (str value)))]
   (cond (or (nil? class-types) (false? class-types)) #{}
        (or (string? class-types) (symbol? class-types) (keyword? class-types))
        #{(strn class-types)}
        (coll? class-types)
        (if (every? (fn [v] (or (string? v) (symbol? v) (keyword? v))) class-types)
          (set (map strn class-types))
          (throw (ex :argument {:class-types class-types} :ex/message "Invalid class types")))
        :else (throw (ex :argument {:class-types class-types} :ex/message "Invalid class types")))))

(defn E-relation-ref [relation]
  (let [for-value (:for relation)]
    (if (vector? for-value) (second for-value) for-value)))

(defn E-reference-addons
  [addons]
  (filter (fn [addon] (= :ref (get-in addon [:field :type])))
          (map E-addon-columns-single addons)))

(defn E-auto-class-types
  [{:keys [class symname basis entity owner addons] :as m}]
  (let [[depth] (parse-class class)
        refs (E-reference-addons addons)
        relations (concat (keep identity [(E-relation-ref entity)
                                          (if owner (second (E-owner-pair owner)) nil)])
                          (keep (fn [addon] (get-in addon [:field :ref :ns])) refs))
        linkage? (or entity owner (seq refs))
        own-type (if (and linkage? (has? #{0 1} depth)) symname nil)
        context-type (if (and linkage? (has? basis :context)
                              (has? #{[0 :entry] [1 :entry]} (parse-class class)))
                       (or (get-in m [:entity :context]) "Global") nil)
        target-types (keep (fn [ref]
                             (let [info (target-info ref)]
                               (if (and info (has? #{0 1} (first (:tuple info))))
                                 (:symname info) nil))) relations)]
    (normalise-class-types (concat (keep identity [own-type context-type]) target-types))))

(defn E-class-types
  [m]
  (if (has? m :class-types)
    (normalise-class-types (:class-types m))
    (E-auto-class-types m)))

(defn normalise-reference
  "Normalizes pointer-shaped references without discarding owner tuples."
  [value]
  (cond (vector? value) (vec (map (fn [entry]
                                   (if (keyword? entry) entry (normalise-reference entry)))
                                 value))
        (map? value) (or (ut/normalise-ref value) value)
        :else (ut/normalise-ref value)))

(defn class-types
  ([] (class-types (ut/default-application (ns-current)) []))
  ([application] (class-types application []))
  ([application defaults]
   (let [modules (deref script/+modules+)]
     (vec
      (sort
       (vec
        (normalise-class-types
         (vec
          (concat defaults
                  (mapcat (fn [module]
                            (mapcat (fn [entry] (:api/class-types entry))
                                    (vals (:code module))))
                          (filter (fn [module]
                                    (some (fn [candidate]
                                            (= candidate application))
                                          (or (:application module)
                                              (get-in module [:static :application])
                                              [])))
                                  (vals modules))))))))))))

(defn E
  [{:keys [application] :as m}]
   (let [m (merge {:symname (if grammar-spec/*symbol*
                             (name grammar-spec/*symbol*))
                  :class :none :access :access/auth :columns []
                  :ns-str (or (ut/default-ns-str application) ut/*ns-str*)}
                 m)
        m (E-addon-bool-shorthand m)
        m (assoc m :addons (map E-addon-columns-single (:addons m)))
        m (assoc m :owner (if (:owner m) (normalise-reference (:owner m)) nil))
        m (assoc m :entity (if (:entity m) (normalise-reference (:entity m)) nil))
        _ (E-check-input m)
        m (assoc m :basis (E-resolve-basis m))
        out (assoc (E-main m) :api/class-types (E-class-types m))]
    (E-main-spec m)
    out))
