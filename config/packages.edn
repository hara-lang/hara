{hara/std.foundation
 {:description "Intrinsic Foundation language and runtime support"
  :include [[std.foundation :complete]]}

 hara/std.lib
 {:description "Portable Foundation library utilities"
  :include [[std.lib :complete] [std.fs :complete]]
  :dependencies [hara/std.foundation]}

 hara/std.config
 {:description "Portable configuration decoding and resolution"
  :include [[std.config :complete]]
  :dependencies [hara/std.foundation hara/std.lib]}

 hara/std.block
 {:description "Source-preserving block parsing and transformation"
  :include [[std.block :complete]]
  :dependencies [hara/std.foundation hara/std.lib]}

 hara/std.typed
 {:description "Typed schema and registry support"
  :include [[std.typed :complete]]
  :dependencies [hara/std.foundation hara/std.lib]}

 hara/lang.common
 {:description "Shared compiler, grammar, and language protocol support"
  :include [[lang.common :complete]
            [lang.protocol :complete]]
  :dependencies [hara/std.foundation hara/std.lib hara/std.typed]}

 hara/tool.sh
 {:description "Portable process and shell boundary helpers"
  :include [[tool.sh :complete]]
  :dependencies [hara/std.foundation]}

 hara/tool.cli
 {:description "Reusable command-line model and test-runner helpers"
  :include [[tool.cli :complete]]
  :dependencies [hara/code.manage]}

 hara/lang.core
  {:description "Language compilation, evaluation, rewriting, and seed tooling"
   :include [[lang.core :complete]
             [lang.seedgen :complete]]
   :dependencies [hara/code.framework
                hara/code.manage
                hara/lang.common
                hara/std.block
                hara/std.config
                hara/std.lib
                hara/tool.cli
                hara/work]}

 hara/lang.typed
 {:description "Typed XTalk form and type analysis helpers"
  :include [[lang.typed :complete]]
  :dependencies [hara/lang.core]}

 hara/lang.model.base
 {:description "Shared language model grammar foundation"
  :include [[lang.base.v1 :complete]]
  :dependencies [hara/lang.common hara/lang.core hara/lang.typed]}

 hara/lang.model.xtalk
 {:description "Target-neutral XTalk language model"
  :include [[lang.model.v1.spec-xtalk
             :exclude [lang.model.v1.spec-xtalk.fn-go
                       lang.model.v1.spec-xtalk.fn-js
                       lang.model.v1.spec-xtalk.fn-lua
                       lang.model.v1.spec-xtalk.fn-python]]]
  :dependencies [hara/lang.common hara/lang.core hara/lang.model.base hara/lang.typed]}

 hara/lang.model.hara
 {:description "Native Hara language model"
  :include [[lang.model.v1.spec-hara :complete]]
  :dependencies [hara/lang.common hara/lang.core hara/lang.model.base hara/lang.model.xtalk hara/lang.typed]}

 hara/lang.model.js
 {:description "JavaScript language model"
  :include [[lang.model.v1.spec-js :complete]
            [lang.model.v1.spec-xtalk.fn-js :complete]]
  :dependencies [hara/lang.common hara/lang.core hara/lang.model.base hara/lang.model.xtalk hara/lang.typed]}

 hara/lang.model.python
 {:description "Python language model"
  :include [[lang.model.v1.spec-python :complete]
            [lang.model.v1.spec-xtalk.fn-python :complete]]
  :dependencies [hara/lang.common hara/lang.core hara/lang.model.base hara/lang.model.xtalk hara/lang.typed]}

 hara/lang.model.lua
 {:description "Lua language model"
  :include [[lang.model.v1.spec-lua :complete]
            [lang.model.v1.spec-xtalk.fn-lua :complete]]
  :dependencies [hara/lang.common hara/lang.core hara/lang.model.base hara/lang.model.xtalk hara/lang.typed]}

 hara/lang.model.go
 {:description "Go language model"
  :include [[lang.model.v1.spec-go :complete]
            [lang.model.v1.spec-xtalk.fn-go :complete]]
  :dependencies [hara/lang.common hara/lang.core hara/lang.model.base hara/lang.model.xtalk hara/lang.typed]}

 hara/lang.model.c
 {:description "C language model"
  :include [[lang.model.v1.spec-c :complete]]
  :dependencies [hara/lang.common hara/lang.core hara/lang.model.base hara/lang.model.xtalk hara/lang.typed]}

 hara/lang.runtime
  {:description "Portable language runtime implementations"
   :include [[lang.runtime :complete]]
  :dependencies [hara/db.postgres
                 hara/lang.core
                 hara/lang.model.hara
                 hara/std.lib
                 hara/std.stream
                 hara/tool.sh]}

 hara/lang.model.postgres
  {:description "PostgreSQL language model and query implementation internals"
   :include [[lang.model.v1.spec-postgres :complete]
             [postgres.core.impl :complete]
             [postgres.core.impl-base :complete]
             [postgres.core.impl-insert :complete]
             [postgres.core.impl-main :complete]
             [postgres.core.impl-update :complete]
             [postgres.core.addon :complete]]
   :dependencies [hara/lang.common hara/lang.core hara/lang.model.base]}

 hara/postgres.typed
 {:description "Typed PostgreSQL application and generation helpers"
  :include [[postgres.application :complete]
            [postgres.gen :complete]
            [postgres.typed :complete]]
  :dependencies [hara/lang.core]}

 hara/postgres.entity
  {:description "PostgreSQL entity and code-generation support"
   :include [[postgres.entity :complete]]
  :dependencies [hara/lang.core hara/lang.model.postgres]
  :context-dependencies [hara/lang.model.postgres]}

 hara/postgres.core
  {:description "PostgreSQL query, graph, and Supabase core DSL"
   :include [[postgres.core :exclude [postgres.core.impl
                                      postgres.core.impl-base
                                      postgres.core.impl-insert
                                      postgres.core.impl-main
                                      postgres.core.impl-update
                                      postgres.core.addon]]]
  :dependencies [hara/lang.core
                 hara/postgres.entity
                 hara/lang.model.postgres
                 hara/postgres.typed]
  :context-dependencies [hara/lang.model.postgres]}

 hara/db.postgres
 {:description "Database protocol and PostgreSQL connection boundaries"
  :include [[db.protocol :complete]
            [db.postgres :complete]]
  :dependencies [hara/std.foundation]}

 hara/code.framework
 {:description "Reader-first source analysis, linkage, and durable cache"
  :include [[code.framework :complete]]
  :dependencies [hara/std.lib]}

 hara/work
  {:description "Portable work-flow task execution"
   :include [[work :complete]]
  :dependencies [hara/std.lib hara/tool.sh]}

 hara/code.test
  {:description "Native Test/check command, registry, and reports"
   :include [[code.test :complete]]
  :dependencies [hara/std.typed hara/work]}

 hara/code.manage
  {:description "Project analysis, test correspondence, and source management"
   :include [[code.manage :complete]
             [code.project :complete]]
  :dependencies [hara/code.framework hara/std.block hara/std.lib hara/work]}

 hara/std.package
 {:description "HARP package construction and runtime lifecycle"
  :include [[std.package :exclude [std.package.project]]]
  :dependencies [hara/std.foundation hara/std.lib]}

hara/code.deploy
  {:description "Foundation-compatible package catalogue planning and staging"
   :include [[code.deploy :complete]
             [std.package.project :complete]]
   :dependencies [hara/code.framework hara/std.package hara/tool.sh hara/work]}

 hara/std.stream
 {:description "Portable stream duplex primitives"
  :include [[std.stream :complete]]
  :dependencies [hara/std.foundation]}

 hara/xt.lang
 {:description "Portable Foundation XTalk language libraries"
  :include [[xt.lang :complete]]
  :dependencies [hara/lang.core]}

 hara/tool.metaspec
 {:description "Hara metaspec authoring and verification"
  :include [[tool.metaspec :complete]]
  :dependencies [hara/std.typed]}

 hara/command
 {:description "Hara command-line entry points and CLI tooling"
  :include [[hara.command :complete]]
  :dependencies [hara/code.deploy
                 hara/code.manage
                 hara/code.test
                 hara/lang.core
                 hara/tool.metaspec
                 hara/work]}}
