(ns std.typed.registry-candidate
  (:require [std.typed.registry :as registry]
            [std.typed.schema :as schema]))

(def nodes
  (registry/local
   'demo
   {'Node '[:map
             [:value :int]
             [:next [:maybe Node]]]}))

(def cycle
  (registry/local 'cycle {'A 'B 'B 'A}))

[(registry/qualify nodes 'Node)
 (schema/valid? 'Node
                {:value 1
                 :next {:value 2 :next nil}}
                nodes)
 (schema/valid? 'Node
                {:value 1
                 :next {:value "two" :next nil}}
                nodes)
 (schema/unresolved-references 'Node nodes)
 (:finding/type (first (schema/validate 'A 1 cycle)))]
