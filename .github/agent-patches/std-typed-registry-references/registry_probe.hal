(ns std.typed.registry-probe
  (:require [std.typed.registry :as registry]
            [std.typed.schema :as schema]))

(def +base+
  (registry/local
   'model
   {'Id :int
    'Status '[:enum :active :disabled]}))

(def +application+
  (registry/registry
   {'User '[:map
             [:id (var Id)]
             [:status (var m/Status)]]}
   {:namespace 'app
    :aliases {'m 'model}
    :refers {'Id 'model/Id}
    :parents [+base+]}))

(def +nodes+
  (registry/local
   'demo
   {'Node '[:map
             [:value :int]
             [:next [:maybe Node]]]}))

(def +cycle+
  (registry/local
   'cycle
   {'A 'B
    'B 'A}))

(let [override (registry/local 'model {'Id :str})
      composite (registry/composite [override +base+])
      extended (registry/assoc-schema +application+ 'Token :str)
      resolved (schema/resolve-recursive 'Node +nodes+)
      names (registry/names +application+)
      references (schema/reference-names resolved)
      missing (schema/unresolved-references 'Node +nodes+)
      unresolved (first (schema/validate 'Missing 1 +nodes+))
      cyclic (first (schema/validate 'A 1 +cycle+))
      checks
      [[:qualify-local
        (= 'app/User
           (registry/qualify +application+ 'User))]
       [:qualify-refer
        (= 'model/Id
           (registry/qualify +application+ 'Id))]
       [:qualify-alias
        (= 'model/Status
           (registry/qualify +application+ 'm/Status))]
       [:lookup-parent
        (= :int (registry/lookup +application+ 'Id))]
       [:parent-precedence
        (= :str (registry/lookup composite 'Id))]
       [:has-local
        (registry/has-schema? +application+ 'User)]
       [:missing-local
        (not (registry/has-schema? +application+ 'Missing))]
       [:names-family
        (vector? names)]
       [:names-order
        (= names (vec '[app/User model/Id model/Status]))]
       [:definition-count
        (= 3 (count (registry/definitions +application+)))]
       [:immutable-assoc
        (= :str (registry/lookup extended 'Token))]
       [:original-unchanged
        (nil? (registry/lookup +application+ 'Token))]
       [:immutable-dissoc
        (not
         (registry/has-schema?
          (registry/dissoc-schema extended 'Token)
          'Token))]
       [:normalized-reference
        (= {:kind :reference :name 'demo/Node}
           (schema/normalize-with 'Node +nodes+))]
       [:one-step-resolution
        (= :map (:kind (schema/resolve-reference 'Node +nodes+)))]
       [:recursive-resolution
        (= :map (:kind resolved))]
       [:reference-family
        (vector? references)]
       [:reference-values
        (= references (vec '[demo/Node]))]
       [:unresolved-family
        (vector? missing)]
       [:unresolved-empty
        (empty? missing)]
       [:valid-recursive-value
        (schema/valid? 'Node
                       {:value 1
                        :next {:value 2
                               :next nil}}
                       +nodes+)]
       [:invalid-recursive-value
        (not
         (schema/valid? 'Node
                        {:value 1
                         :next {:value "two"
                                :next nil}}
                        +nodes+))]
       [:unresolved-finding
        (= :std.typed.schema/unresolved-reference
           (:finding/type unresolved))]
       [:unresolved-name
        (= 'demo/Missing (:finding/reference unresolved))]
       [:cyclic-finding
        (= :std.typed.schema/cyclic-reference
           (:finding/type cyclic))]]
      failures
      (vec
       (keep (fn [check]
               (if (second check)
                 nil
                 (first check)))
             checks))]
  (if (empty? failures)
    :ok
    (throw
     (ex-info "std.typed registry probe failed"
              {:failures failures
               :names names
               :references references
               :unresolved missing
               :unresolved-finding unresolved
               :cyclic-finding cyclic}))))
