(ns play.tui-002-game-of-life.build
  (:require [work.flow :as work]
            [work.flow.make :as make]))

(def +makefile+
  [[:.PHONY {:- ["build" "start" "dev"]}]
   [:build ["@echo 'Artifacts are generated by work/def.work into .build/'"]]
   [:start ["node dist/main.js"]]
   [:dev ["npx webpack --watch"]]])
(def +expected-files+ [".gitignore" "Makefile" "package.json" "webpack.config.js" "src/main.js"])

(work/def.work PROJECT
  [:make]
  {:tag "play-tui-002-game-of-life"
   :orgfile "Main.org"
   :sections {:setup [{:type :gitignore :main ["dist" "node_modules" "out"]}
                      {:type :makefile :main +makefile+}
                      {:type :package.json :main {"name" "tui-002-game-of-life"
                                                  "main" "dist/main.js"}}]}
   :default [{:type :module.single :lang :js
              :main 'play.tui-002-game-of-life.main
              :file "main.js" :target "src"}]})
(defn -main [] (make/build-all PROJECT))
