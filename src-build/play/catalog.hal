(ns play.catalog
  (:config {:role :internal}))

(def +samples+
  [{:id "c_000_pthreads_hello"
    :namespace 'play.c-000-pthreads-hello
    :targets [:c]
    :validation :deterministic}
   {:id "go_000_user_directory"
    :namespace 'play.go-000-user-directory
    :targets [:go]
    :validation :deterministic}
   {:id "go_001_xtalk_user_directory"
    :namespace 'play.go-001-xtalk-user-directory
    :targets [:xtalk :go]
    :validation :deterministic}
   {:id "js_002_substrate_scratch_v3"
    :namespace 'play.js-002-substrate-scratch-v3
    :targets [:js]
    :validation :deterministic}
   {:id "ngx_000_hello"
    :namespace 'play.ngx-000-hello
    :targets [:lua :openresty]
    :validation :deterministic
    :external :openresty}
   {:id "ngx_001_eval"
    :namespace 'play.ngx-001-eval
    :targets [:lua :openresty]
    :validation :deterministic
    :external :openresty}
   {:id "ts_000_user_directory"
    :namespace 'play.ts-000-user-directory
    :targets [:js :typescript]
    :validation :deterministic}
   {:id "ts_001_single_source_user_directory"
    :namespace 'play.ts-001-single-source-user-directory
    :targets [:xtalk :js :typescript]
    :validation :deterministic}
   {:id "tui_000_counter"
    :namespace 'play.tui-000-counter
    :targets [:js :blessed]
    :validation :deterministic
    :external :node}
   {:id "tui_001_fetch"
    :namespace 'play.tui-001-fetch
    :targets [:js :blessed]
    :validation :deterministic
    :external :node}
   {:id "tui_002_game_of_life"
    :namespace 'play.tui-002-game-of-life
    :targets [:js :blessed]
    :validation :deterministic
    :external :node}
   {:id "view_001_kitchen_sink"
    :namespace 'play.view-001-kitchen-sink
    :targets [:js]
    :validation :deterministic
    :deferred #{:dart :flutter}}])

(defn sample-ids
  "Returns sample ids in catalog order."
  []
  (vec (map :id +samples+)))

(defn sample
  "Returns a catalog entry by stable id."
  [id]
  (first (filter (fn [entry] (= id (:id entry))) +samples+)))

(defn complete?
  "Returns true when a sample has deterministic validation metadata."
  [entry]
  (and (map? entry)
       (string? (:id entry))
       (symbol? (:namespace entry))
       (vector? (:targets entry))
       (= :deterministic (:validation entry))))

(defn deferred-targets
  "Returns the explicitly deferred targets for a sample."
  [entry]
  (set (or (:deferred entry) #{})))

(defn all-complete?
  "Returns true when every original sample has a deterministic catalog entry."
  []
  (every? complete? +samples+))
