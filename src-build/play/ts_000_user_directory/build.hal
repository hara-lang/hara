(ns play.ts-000-user-directory.build
  (:require [work.flow :as work]
            [work.flow.make :as make]
            [lang.model.v1.spec-js.ts :as ts]))

(def +gitignore+ ["node_modules"])
(def +makefile+
  [[:.PHONY {:- ["build" "show-types" "show-js"]}]
   [:build ["@echo 'Artifacts are generated by work/def.work into .build/'"]]
   [:show-types ["@sed -n '1,160p' src/index.d.ts"]]
   [:show-js ["@sed -n '1,160p' src/index.js"]]])
(def +package+ {"name" "ts-000-user-directory" "private" true "type" "module"
                "main" "src/index.js" "types" "src/index.d.ts"
                "exports" {"." "./src/index.js"}})
(def +expected-files+ [".gitignore" "Makefile" "package.json" "src/index.js" "src/index.d.ts"])
(defn typescript-artifact [options] (ts/module-dts-artifact options))

(work/def.work PROJECT
  [:make]
  {:tag "play-ts-000-user-directory"
   :orgfile "Main.org"
   :sections {:setup [{:type :gitignore :main +gitignore+}
                      {:type :makefile :main +makefile+}
                      {:type :package.json :main +package+}]}
   :default [{:type :module.single :lang :js
              :main 'play.ts-000-user-directory.main
              :file "index.js" :target "src"
              :emit {:artifacts [typescript-artifact]}}]})
(defn -main [] (make/build-all PROJECT))
