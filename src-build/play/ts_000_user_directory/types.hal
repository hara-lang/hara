(ns play.ts-000-user-directory.types
  (:require [lang.core :as l]
            [lang.model.v1.spec-xtalk]))

(l/script :xtalk
  {:require [[xt.lang.common-data :as xtd]]})

(def.xt ^{:schema :xt/str}
  UserId
  :xt/str)

(def.xt ^{:schema [:xt/record
                   ["id" UserId]
                   ["displayName" [:xt/maybe :xt/str]]
                   ["roles" [:xt/array :xt/str]]] }
  User
  [:xt/record
   ["id" UserId]
   ["displayName" [:xt/maybe :xt/str]]
   ["roles" [:xt/array :xt/str]]])

(def.xt ^{:schema [:xt/dict UserId User]}
  UserMap
  [:xt/dict UserId User])

(defn.xt ^{:schema [:fn [UserMap UserId] [:xt/maybe User]]}
  lookupUser
  [users id]
  (return (xt/x:get-key users id)))

(defn.xt ^{:schema [:fn [UserMap] [:xt/array UserId]]}
  userIds
  [users]
  (return (xt/x:arr-map (xt/x:obj-keys users)
                        (fn [id]
                          (return id)))))

(def.xt ^{:schema :xt/int}
  DEFAULT_PAGE_SIZE
  20)
