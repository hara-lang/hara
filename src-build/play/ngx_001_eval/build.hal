(ns play.ngx-001-eval.build
  (:require [work.flow :as work]
            [work.flow.make :as make]))

(def +makefile+
  [[:.PHONY {:- ["build" "start"]}]
   [:build ["@echo 'Generated OpenResty eval source is under lua/'"]]
   [:start ["resty -p 18091 -c nginx.conf"]]])
(def +expected-files+ ["Makefile" "lua/eval.lua" "nginx.conf"])

(work/def.work PROJECT
  [:make]
  {:tag "play-ngx-001-eval"
   :sections {:setup [{:type :gitignore :main ["bin" "out"]}
                      {:type :makefile :main +makefile+}
                      {:type :raw :file "nginx.conf"
                       :main ["worker_processes 1" "events {}" "http { include mime.types; }"]}]}
   :default [{:type :module.single :lang :lua
              :main 'play.ngx-001-eval.main
              :file "eval.lua" :target "lua"}]})
(defn -main [] (make/build-all PROJECT))
