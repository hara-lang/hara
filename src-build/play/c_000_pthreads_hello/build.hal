(ns play.c-000-pthreads-hello.build
  (:require [work.flow :as work]
            [work.flow.make :as make]))

(def +makefile+
  [{:CC :gcc :CFLAGS ["-I."]}
   ["out/%.o" {:- ["src/%.c"]}
    ["@mkdir -p out"]
    ["$(CC) -c -o $@ $< $(CFLAGS)"]]
   [:package {:- ["out/pthreads_hello.o"]}
    ["@mkdir -p bin"]
    ["$(CC) -o bin/pthreads_hello out/pthreads_hello.o" "-lpthread"]]
   [:run {:- [:package]} ["./bin/pthreads_hello"]]])

(def +expected-files+ ["Makefile" "src/pthreads_hello.c"])
(def +c-header+
  "#include <stdio.h>\n#include <stdlib.h>\n#include <pthread.h>\n\nvoid * print_message_function(void * ptr);\n")

(work/def.work PROJECT
  [:make]
  {:tag "play-c-000-pthreads-hello"
   :orgfile "Main.org"
   :sections {:setup [{:type :makefile :main +makefile+}
                      {:type :gitignore :main ["bin" "out"]}]}
   :default [{:type :module.single
              :lang :c
              :main 'play.c-000-pthreads-hello.main
              :file "pthreads_hello.c"
              :target "src"
              :layout :flat
              :header +c-header+}]})

(defn -main [] (make/build-all PROJECT))
