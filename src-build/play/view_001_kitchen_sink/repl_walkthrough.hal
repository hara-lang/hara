;; Native Hara walkthrough for play.view-001-kitchen-sink.build.
;;
;; Load the build namespace, inspect VIEW-KITCHEN-SINK-JS, and evaluate
;; (work.flow.make/build-all VIEW-KITCHEN-SINK-JS).  The JS target writes the
;; deterministic static project under .build/view-kitchen-sink-js.
;;
;; Dart and Flutter remain documented deferred targets until native books for
;; those targets are available.  Their source metadata is retained in the
;; build namespace so the migration is explicit and reversible.
(ns play.view-001-kitchen-sink.repl-walkthrough
  (:config {:role :internal}))
