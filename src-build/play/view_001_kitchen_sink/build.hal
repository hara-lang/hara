(ns play.view-001-kitchen-sink.build
  (:require [work.flow :as work]
            [work.flow.make :as make]))

;; The JS view demo is ported; Dart and Flutter remain explicit deferred
;; targets until the corresponding native target books are available.

(def +js-index+ ["<!doctype html>" "<html lang=\"en\">" "<head>"
                 "  <meta charset=\"utf-8\" />"
                 "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />"
                 "  <title>xt.substrate.view kitchen sink</title>"
                 "  <script src=\"https://cdn.tailwindcss.com\"></script>"
                 "</head>" "<body>" "  <main id=\"app\"></main>"
                 "  <script type=\"module\" src=\"./app.js\"></script>"
                 "</body>" "</html>"])
(def +js-package+ {"name" "view-kitchen-sink" "version" "0.1.0" "private" true
                   "type" "module"
                   "scripts" {"bundle" "esbuild src/app.js --bundle --outfile=public/app.js"
                              "start" "python3 -m http.server 8080 --directory public"}})
(def +js-makefile+
  [[:.PHONY {:- ["install" "bundle" "start"]}]
   [:install ["npm install"]]
   [:bundle ["npm run bundle"]]
   [:start ["npm run start"]]])
(def +expected-js-files+ ["Makefile" "package.json" "public/index.html" "src/app.js"])
(def +deferred-targets+
  {:dart {:status :deferred :reason :target-book-not-ported}
   :flutter {:status :deferred :reason :target-book-not-ported}})

(work/def.work VIEW-KITCHEN-SINK-JS
  [:make]
  {:tag "view-kitchen-sink-js"
   :build ".build/view-kitchen-sink-js"
   :sections {:setup [{:type :gitignore :main ["node_modules/" "public/app.js" ".DS_Store"]}
                      {:type :package.json :main +js-package+}
                      {:type :makefile :main +js-makefile+}
                      {:type :raw :target "public" :file "index.html" :main +js-index+}]}
   :default [{:type :module.directory :lang :js
              :main 'play.view-001-kitchen-sink.app
              :target "src" :file "app.js"}]})
(def VIEW-KITCHEN-SINK-DART +deferred-targets+)
(def VIEW-KITCHEN-SINK-FLUTTER +deferred-targets+)
(defn -main [] (make/build-all VIEW-KITCHEN-SINK-JS))
