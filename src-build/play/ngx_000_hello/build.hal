(ns play.ngx-000-hello.build
  (:require [work.flow :as work]
            [work.flow.make :as make]))

(def +makefile+
  [[:.PHONY {:- ["build" "run"]}]
   [:build ["@echo 'Generated OpenResty source is under lua/'"]]
   [:run ["resty lua/hello.lua"]]])
(def +expected-files+ ["Makefile" "lua/hello.lua"])

(work/def.work PROJECT
  [:make]
  {:tag "play-ngx-000-hello"
   :orgfile "Main.org"
   :sections {:setup [{:type :gitignore :main ["bin" "out"]}
                      {:type :makefile :main +makefile+}]}
   :default [{:type :module.single :lang :lua
              :main 'play.ngx-000-hello.main
              :file "hello.lua" :target "lua"}]})
(defn -main [] (make/build-all PROJECT))
