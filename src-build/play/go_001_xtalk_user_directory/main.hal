(ns play.go-001-xtalk-user-directory.main
  (:require [lang.core :as l]
            [lang.model.v1.spec-xtalk]))

(l/script :xtalk
  {:require [[xt.lang.common-data :as common-data]]
   :schema {UserId :xt/str
            User [:xt/record
                  ["id" UserId]
                  ["displayName" [:xt/maybe :xt/str]]
                  ["roles" [:xt/array :xt/str]]]
            UserMap [:xt/dict UserId User]}})

(defn.xt ^{:schema [:fn [UserMap UserId] [:xt/maybe User]]}
  lookupUser
  [users id]
  (return (x:get-key users id)))

(defn.xt ^{:schema [:fn [UserMap] [:xt/array UserId]]}
  userIds
  [users]
  (return (x:arr-map (x:obj-keys users)
                     (fn [id]
                       (return id)))))

(def.xt ^{:schema :xt/int}
  DEFAULT_PAGE_SIZE
  20)
