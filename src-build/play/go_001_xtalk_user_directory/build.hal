(ns play.go-001-xtalk-user-directory.build
  (:require [work.flow :as work]
            [work.flow.make :as make]
            [lang.core.script :as script]
            [lang.model.v1.spec-go.typed :as go-typed]))

(def +gitignore+ ["bin"])
(def +makefile+
  [[:.PHONY {:- ["build" "test" "show-source"]}]
   [:build ["go build ./..."]]
   [:test ["go test ./..."]]
   [:show-source ["@sed -n '1,160p' user_directory.go"]]])
(def +go-mod+ ["module example.com/go-001-xtalk-user-directory" "" "go 1.22"])
(def +expected-files+ [".gitignore" "Makefile" "go.mod" "user_directory.go"])

(defn go-source
  [options]
  (script/load-module (:main options))
  (go-typed/emit-namespace-declarations (:main options)))

(work/def.work PROJECT
  [:make]
  {:tag "play-go-001-xtalk-user-directory"
   :orgfile "Main.org"
   :sections {:setup [{:type :gitignore :main +gitignore+}
                      {:type :makefile :main +makefile+}
                      {:type :raw :file "go.mod" :main +go-mod+}]}
   :default [{:type :custom :file "user_directory.go"
              :header "package userdirectory"
              :main 'play.go-001-xtalk-user-directory.main
              :fn go-source}]})
(defn -main [] (make/build-all PROJECT))
