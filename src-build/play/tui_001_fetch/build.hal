(ns play.tui-001-fetch.build
  (:require [work.flow :as work]
            [work.flow.make :as make]))

(def +makefile+
  [[:.PHONY {:- ["build" "init" "dev"]}]
   [:build ["@echo 'Artifacts are generated by work/def.work into .build/'"]]
   [:init ["npm install"]]
   [:dev ["node src/index.js"]]])
(def +expected-files+ ["Makefile" "src/index.js"])

(work/def.work PROJECT
  [:make]
  {:tag "play-tui-001-fetch"
   :orgfile "Main.org"
   :sections {:setup [{:type :gitignore :main ["bin" "out"]}
                      {:type :makefile :main +makefile+}]}
   :default [{:type :module.single :lang :js
              :main 'play.tui-001-fetch.main
              :file "index.js" :target "src"}]})
(defn -main [] (make/build-all PROJECT))
