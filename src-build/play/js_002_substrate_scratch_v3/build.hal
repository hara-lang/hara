(ns play.js-002-substrate-scratch-v3.build
  (:require [work.flow :as work]
            [work.flow.make :as make]))

(def +index+ ["<!doctype html>" "<html lang=\"en\">"
              "<head>" "  <meta charset=\"utf-8\" />"
              "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />"
              "  <title>xt.substrate scratch-v3 playground</title>"
              "  <link rel=\"stylesheet\" href=\"./styles.css\" />" "</head>"
              "<body>" "  <main id=\"app\"></main>"
              "  <script type=\"module\" src=\"./app.js\"></script>"
              "</body>" "</html>"])
(def +styles+ [":root { color-scheme: dark; font-family: ui-sans-serif, system-ui, sans-serif; background: #07110f; color: #eefaf5; }"
               "body { margin: 0; min-height: 100vh; }"
               ".shell { width: min(1180px, 100%); margin: 0 auto; padding: 4rem 2rem 6rem; display: grid; gap: 1.2rem; }"])
(def +makefile+
  [[:.PHONY {:- ["build" "start"]}]
   [:build ["@echo 'Artifacts are generated by work/def.work into .build/'"]]
   [:start ["python3 -m http.server 8080 --directory public"]]])
(def +expected-files+ ["Makefile" "public/index.html" "public/styles.css" "public/app.js"])

(work/def.work PROJECT
  [:make]
  {:tag "play-js-002-substrate-scratch-v3"
   :build ".build/play-js-002-substrate-scratch-v3"
   :sections {:setup [{:type :makefile :main +makefile+}
                      {:type :raw :target "public" :file "index.html" :main +index+}
                      {:type :raw :target "public" :file "styles.css" :main +styles+}]}
   :default [{:type :module.directory :lang :js
              :main 'play.js-002-substrate-scratch-v3.app
              :target "public"
              :file "app.js"}]})
(defn -main [] (make/build-all PROJECT))
