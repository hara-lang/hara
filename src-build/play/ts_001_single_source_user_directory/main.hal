(ns play.ts-001-single-source-user-directory.main
  (:require [lang.core :as l]
            [lang.model.v1.spec-xtalk]
            [xt.lang.common-lib]
            [xt.lang.common-data]))

(l/script :xtalk
  {:require [[xt.lang.spec-base :as xt]
             [xt.lang.common-data :as common-data]]})

(def.xt ^{:schema :xt/str}
  UserId
  :xt/str)

(def.xt ^{:schema [:xt/record
                   ["id" UserId]
                   ["displayName" [:xt/maybe :xt/str]]
                   ["roles" [:xt/array :xt/str]]] }
  User
  [:xt/record
   ["id" UserId]
   ["displayName" [:xt/maybe :xt/str]]
   ["roles" [:xt/array :xt/str]]])

(def.xt ^{:schema [:xt/dict UserId User]}
  UserMap
  [:xt/dict UserId User])

(defn.xt ^{:schema [:fn [UserMap UserId] [:xt/maybe User]]}
  lookupUser
  [users id]
  (return (x:get-key users id)))

(defn.xt ^{:schema [:fn [UserMap] [:xt/array UserId]]}
  userIds
  [users]
  (return (x:arr-map (x:obj-keys users)
                     (fn [id]
                       (return id)))))

(def.xt ^{:schema :xt/int}
  DEFAULT_PAGE_SIZE
  20)
