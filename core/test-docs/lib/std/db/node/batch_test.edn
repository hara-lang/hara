ving\"\n     (do\n       (reset! EVENTS [])\n       (let [connected (connected-runtime \"commit\")\n             client-node (get connected :client)\n             output (deref\n                     (client/transaction\n                      client-node\n                      \"db/primary\"\n                      [{:sql \"insert\" :parameters [1]}\n                       {:sql \"select\" :parameters [7] :mode \"query\"}]\n                      {}))]\n         [(get output :status)\n          (get-in output [:results 1 :rows])\n          (map (fn [event] (get event :sql)) @EVENTS)]))\n     => [:committed\n         [[7]]\n         [\"begin\" \"insert\" \"select\" \"commit\"]])" :meta {} :refer-source :qualified-call :nested true :original-refer false :refer db.node.client-base/transaction :refer-candidates [db.node.client-base/transaction] :order 3157 :results true} {:checked true :title "failed transaction batches roll back and propagate the error" :source "(fact \"failed transaction batches roll back and propagate the error\"\n     (do\n       (reset! EVENTS [])\n       (let [connected (connected-runtime \"rollback\")\n             client-node (get connected :client)\n             status (deref\n                     (promise/catch\n                      (client/transaction\n                       client-node\n                       \"db/primary\"\n                       [{:sql \"before-failure\"}\n                        {:sql \"fail\"}\n                        {:sql \"after-failure\"}]\n                       {})\n                      (fn [error] :failed)))]\n         [status\n          (map (fn [event] (get event :sql)) @EVENTS)]))\n     => [:failed\n         [\"begin\" \"before-failure\" \"fail\" \"rollback\"]])" :meta {} :refer-source :qualified-call :nested true :original-refer false :refer db.node.client-base/transaction :refer-candidates [db.node.client-base/transaction] :order 3873 :results true}] :noncanonical 3 :unresolved 0}
