{:format "code.manage.test-doc/2" :test-path "std/db/node/batch_test.hal" :namespace std.db.node.batch-test :namespace-form "(ns std.db.node.batch-test\n  (:use code.test)\n  (:require [db.node.client-base :as client]\n            [db.node.runtime :as runtime]\n            [db.protocol :as protocol]\n            [std.substrate :as substrate]))" :support-forms [{:source "(def EVENTS (atom []))" :order 217} {:source "(defstruct BatchConnection\n  [id])" :order 241} {:source "(defn- record-event\n  [connection mode sql parameters]\n  (swap! EVENTS conj {:connection (:id connection)\n                      :mode mode\n                      :sql sql\n                      :parameters parameters}))" :order 277} {:source "(extend-type BatchConnection protocol/IDatabase\n  (db-engine [connection]\n    :batch-sql)\n  (db-provider [connection]\n    :batch)\n  (db-info [connection]\n    {:id (:id connection)\n     :engine :batch-sql\n     :provider :batch})\n  (db-exec [connection sql parameters]\n    (record-event connection :exec sql parameters)\n    (if (= sql \"fail\")\n      (promise/new\n       (fn [resolve reject]\n         (reject (ex-info \"statement failed\" {:sql sql}))))\n      (promise/from {:affected 1\n                     :sql sql\n                     :parameters parameters})))\n  (db-query [connection sql parameters]\n    (record-event connection :query sql parameters)\n    (promise/from {:columns [\"value\"]\n                   :rows [[(first parameters)]]\n                   :affected 0}))\n  (db-close [connection]\n    (promise/from true)))" :order 496} {:source "(defn batch-driver\n  []\n  {:id :batch\n   :engine :batch-sql\n   :open (fn [options]\n           (promise/from\n            (std.db.node.batch-test/BatchConnection\n             (get options :id \"batch-1\"))))})" :order 1319} {:source "(def config\n  {:primary {:type :batch\n             :options {:id \"primary-batch\"}}})" :order 1526} {:source "(defn connected-runtime\n  [suffix]\n  (let [serv