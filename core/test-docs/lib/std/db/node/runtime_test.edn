{:format "code.manage.test-doc/2" :test-path "std/db/node/runtime_test.hal" :namespace std.db.node.runtime-test :namespace-form "(ns std.db.node.runtime-test\n  (:use code.test)\n  (:require [std.db.node.client-base :as client]\n            [std.db.node.connection :as remote]\n            [std.db.node.kernel-base :as kernel]\n            [std.db.node.runtime :as runtime]\n            [db.protocol :as db-protocol]\n            [std.foundation.promise :as promise]\n            [std.substrate :as substrate]))" :support-forms [{:source "(defstruct MockConnection\n  [id state])" :order 376} {:source "(extend-type MockConnection db-protocol/IDatabase\n  (db-engine [connection]\n    :mock-sql)\n  (db-provider [connection]\n    :mock)\n  (db-info [connection]\n    {:id (:id connection)\n     :engine :mock-sql\n     :provider :mock})\n  (db-exec [connection sql parameters]\n    (swap! (:state connection)\n           (fn [state]\n             (assoc state :last-exec {:sql sql :parameters parameters})))\n    (promise/from {:affected 1 :sql sql :parameters parameters}))\n  (db-query [connection sql parameters]\n    (swap! (:state connection)\n           (fn [state]\n             (assoc state :last-query {:sql sql :parameters parameters})))\n    (promise/from {:columns [\"id\" \"name\"]\n                   :rows [[1 \"wombat\"]]\n                   :affected 0}))\n  (db-close [connection]\n    (reset! (:state connection) {:closed true})\n    (promise/from true)))" :order 417} {:source "(defn mock-driver\n  []\n  {:id :mock\n   :engine :mock-sql\n   :open (fn [options]\n           (promise/from\n            (std.db.node.runtime-test/MockConnection\n             (get options :id \"mock-1\")\n             (atom {:opened true :options options}))))})" :order 1261} {:source "(defn failing-open\n  [options]\n  (promise/new\n   (fn [resolve reject]\n     (reject (ex-info \"driver failed\" {:options options})))))" :order 1517} {:source "(defn failing-driver\n  []\n  {:id :failing\n   :engine :failing-sql\n   :open failing-open})" :order 1650} {:source "(def config\n  {:primary {:type :mock\n             :options {:id \"primary-1\"}}\n   :caching {:type :mock\n             :options {:id \"cache-1\"}}})" :order 1741}] :facts [{:checked true :title "database runtimes use canonical substrate nodes and map frames" :source "(fact \"database runtimes use canonical substrate nodes and map frames\"\n     (let [node (substrate/node-create \"canonical\")\n           frame (substrate/request-frame nil \"@probe\" [1] {})]\n       [(instance? substrate/SubstrateNode node)\n        (substrate/node? node)\n        (map? frame)\n        (substrate/frame-kind frame)\n        (get frame \"action\")])\n     => [true true true \"request\" \"@probe\"])" :meta {} :refer-source :unresolved :nested true :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate/request-frame std.substrate/SubstrateNode std.substrate/node? std.substrate/frame-kind] :order 1902 :results true} {:checked true :title "kernel config assigns stable service IDs" :source "(fact \"kernel config assigns stable service IDs\"\n     (kernel/kernel-create-config\n      {\"primary\" {\"type\" \"mock\"}\n       \"caching\" {\"type\" \"mock\"}})\n     => {:common {:id \"db/common\"}\n         :primary {:type \"mock\" :id \"db/primary\"}\n         :caching {:type \"mock\" :id \"db/caching\"}})" :meta {} :refer-source :qualified-call :nested true :original-refer false :refer std.db.node.kernel-base/kernel-create-config :refer-candidates [std.db.node.kernel-base/kernel-create-config] :order 2307 :results true} {:checked true :title "server initialization installs database handlers" :source "(fact \"server initialization installs database handlers\"\n     (let [node (substrate/node-create \"server\")]\n       (runtime/init-server node)\n       (substrate/list-handlers node))\n     => (contains [\"@xt.db/kernel-init\"\n                   \"@xt.db/kernel-setup\"\n                 