"))\n             output (deref (db-protocol/db-query\n                            connection\n                            \"select id, name from items\"\n                            []))]\n         [(db-protocol/db-engine connection)\n          (db-protocol/db-provider connection)\n          (get (db-protocol/db-info connection) :remote)\n          (get output :rows)\n          (deref (db-protocol/db-close connection))\n          (remote/closed? connection)]))\n     => [:mock-sql :mock true [[1 \"wombat\"]] true true])" :meta {} :refer-source :unresolved :nested true :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.db.node.kernel-base/register-driver std.db.node.runtime/local-connect std.db.node.runtime/open-service db.protocol/db-query db.protocol/db-engine db.protocol/db-provider db.protocol/db-info db.protocol/db-close std.db.node.connection/closed?] :order 4884 :results true} {:checked true :title "closed runtime connection handles reject further operations" :source "(fact \"closed runtime connection handles reject further operations\"\n     (let [server (substrate/node-create \"server-closed-handle\")\n           client-node (substrate/node-create \"client-closed-handle\")]\n       (kernel/register-driver server :mock (mock-driver))\n       (deref (runtime/local-connect client-node server config {} {}))\n       (let [connection (deref (remote/open client-node \"db/primary\"))]\n         (deref (db-protocol/db-close connection))\n         (db-protocol/db-query connection \"select 1\" [])))\n     => (throws))" :meta {} :refer-source :unresolved :nested true :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.db.node.kernel-base/register-driver std.db.node.runtime/local-connect std.db.node.connection/open db.protocol/db-close db.protocol/db-query] :order 5888 :results true} {:checked true :title "reinitialization reports no change and preserves services" :source "(fact \"reinitialization reports no change and preserves services\"\n     (let [server (substrate/node-create \"server-repeat\")\n           client-node (substrate/node-create \"client-repeat\")]\n       (kernel/register-driver server :mock (mock-driver))\n       (deref (runtime/local-connect client-node server config {} {}))\n       (get (deref (client/kernel-init client-node config {} {} {})) :status))\n     => :no-change)" :meta {} :refer-source :unresolved :nested true :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.db.node.kernel-base/register-driver std.db.node.runtime/local-connect std.db.node.client-base/kernel-init] :order 6426 :results true} {:checked true :title "failed multi-service setup rolls back opened services" :source "(fact \"failed multi-service setup rolls back opened services\"\n     (let [server (substrate/node-create \"server-failed\")\n           failed-config {:primary {:type :mock}\n                          :caching {:type :failing}}]\n       (kernel/register-driver server :mock (mock-driver))\n       (kernel/register-driver server :failing (failing-driver))\n       (let [status (deref\n                     (promise/catch\n                      (kernel/kernel-setup-main server failed-config {} {})\n                      (fn [error] :failed)))]\n         [status\n          (substrate/get-service server \"db/common\")\n          (substrate/get-service server \"db/primary\")\n          (substrate/get-service server \"db/caching\")]))\n     => [:failed nil nil nil])" :meta {} :refer-source :unresolved :nested true :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.db.node.kernel-base/register-driver std.foundation.promise/catch std.db.node.kernel-base/kernel-setup-main std.substrate/get-service] :order 6847 :results true} {:checked true :title "failed local initialization detaches the linked transport" :source "(fact \"failed local initialization detaches the linked transport\"\n     (let [server (substrate/node-cre