                                    {}))\n          (deref (client/health client-node \"auth/supabase\" {}))]))\n     => [{:rpc \"ping\"}\n         [{:id 1 :table \"items\"}]\n         {:name \"GoTrue\"}])" :meta {} :refer-source :unresolved :nested true :original-refer false :refer nil :refer-candidates [std.db.node.client-supabase/rpc-call std.db.node.client-supabase/query-table std.db.node.client-supabase/health] :order 5056 :results true} {:checked true :title "sign-out stops refresh and clears the stored session" :source "(fact \"sign-out stops refresh and clears the stored session\"\n     (do\n       (reset! REFRESH-STOPS 0)\n       (let [nodes (connected-nodes \"signout\")\n             client-node (get nodes :client)]\n         (deref\n          (client/sign-in client-node\n                          \"auth/supabase\"\n                          {:email \"wombat@example.com\" :password \"secret\"}\n                          {}))\n         [(deref (client/sign-out client-node \"auth/supabase\" {}))\n          (deref (client/current-session client-node \"auth/supabase\" {}))\n          (deref (client/signed-in? client-node \"auth/supabase\" {}))\n          @REFRESH-STOPS]))\n     => [{\"status\" \"ok\"} nil false 1])" :meta {} :refer-source :unresolved :nested true :original-refer false :refer nil :refer-candidates [std.db.node.client-supabase/sign-in std.db.node.client-supabase/sign-out std.db.node.client-supabase/current-session std.db.node.client-supabase/signed-in?] :order 5898 :results true} {:checked true :title "runtime finalization stops refresh and removes Supabase services" :source "(fact \"runtime finalization stops refresh and removes Supabase services\"\n     (do\n       (reset! REFRESH-STOPS 0)\n       (let [nodes (connected-nodes \"finalize\")\n             server (get nodes :server)\n             client-node (get nodes :client)]\n         (deref\n          (client/sign-in client-node\n                          \"auth/supabase\"\n                 