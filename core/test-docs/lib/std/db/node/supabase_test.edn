{:format "code.manage.test-doc/2" :test-path "std/db/node/supabase_test.hal" :namespace std.db.node.supabase-test :namespace-form "(ns std.db.node.supabase-test\n  (:use code.test)\n  (:require [std.db.node.client-base :as runtime-client]\n            [std.db.node.client-supabase :as client]\n            [std.db.node.kernel-supabase :as kernel]\n            [std.db.node.runtime :as runtime]\n            [std.db.node.supabase :as supabase]\n            [std.foundation.promise :as promise]\n            [std.substrate :as substrate]))" :support-forms [{:source "(def CALLS (atom []))" :order 400} {:source "(def REFRESH-STARTS (atom 0))" :order 422} {:source "(def REFRESH-STOPS (atom 0))" :order 452} {:source "(defn request-adapter\n  [operation arguments options service]\n  (swap! CALLS conj {:operation operation\n                     :arguments arguments\n                     :options options})\n  (cond\n    (= operation :sign-up)\n    (promise/from {:status 200\n                   :body {:data {:access-token \"signup-token\"\n                                 :refresh-token \"signup-refresh\"}}})\n\n    (= operation :sign-in)\n    (promise/from {:status 200\n                   :body {:data {:access-token \"signin-token\"\n                                 :refresh-token \"signin-refresh\"}}})\n\n    (= operation :sign-out)\n    (promise/from {:status 204 :body nil})\n\n    (= operation :rpc-call)\n    (promise/from {:status 200\n                   :body {:data {:rpc (first arguments)}}})\n\n    (= operation :query-table)\n    (promise/from {:status 200\n                   :body {:data [{:id 1 :table (first arguments)}]}})\n\n    (= operation :health)\n    (promise/from {:status 200\n                   :body {:name \"GoTrue\"}})\n\n    :else\n    (promise/from {:status 200\n                   :body {:operation operation\n                          :arguments arguments}})))" :order 482} {:source "(defn supabase-service\n  []\n  (supabase/create-service\n   request-adapter\n   {:refresh (fn [service]\n               (promise/from {:access-token \"refreshed-token\"}))\n    :auto-refresh-start (fn [service]\n                          (swap! REFRESH-STARTS + 1))\n    :auto-refresh-stop (fn [service]\n                         (swap! REFRESH-STOPS + 1))}))" :order 1624} {:source "(defn connected-nodes\n  [suffix]\n  (let [server (substrate/node-create (str \"supabase-server-\" suffix))\n        client-node (substrate/node-create (str \"supabase-client-\" suffix))]\n    (runtime/init-server server)\n    (runtime/init-server-proxy client-node)\n    (supabase/init-server server)\n    (supabase/init-client client-node)\n    (runtime/connect-nodes client-node server)\n    (supabase/install-service server \"auth/supabase\" (supabase-service))\n    {:server server :client client-node}))" :order 1975}] :facts [{:checked true :title "Supabase gateway RPC details are decoded and normalized" :source "(fact \"Supabase gateway RPC details are decoded and normalized\"\n     (let [data (kernel/supabase-error-data\n                 {:status 400\n                  :body {:message \"RPC failed\"\n                         :details \"{\\\"type\\\":\\\"gw.rpc.error\\\",\\\"tag\\\":\\\"bad-input\\\"}\"}})]\n       [(get data \"type\")\n        (get data \"tag\")\n        (get data :status)\n        (get data :http-status)])\n     => [\"gw.rpc.error\" \"bad-input\" 400 400])" :meta {} :refer-source :qualified-call :nested true :original-refer false :refer std.db.node.kernel-supabase/supabase-error-data :refer-candidates [std.db.node.kernel-supabase/supabase-error-data] :order 2486 :results true} {:checked true :title "failed HTTP-style responses throw normalized exception data" :source "(fact \"failed HTTP-style responses throw normalized exception data\"\n     (kernel/supabase-response-data\n      {:status 401\n       :body {:message \"Unauthorized\"}})\n     => (throws))" :meta {} :refer-source :qualified-call :nested true :original-refer false :refer std.db.node.kernel-supabase/supabase-response-data :refer-candidates [std.db.node.kernel-supabase/supabase-response-data] :order 2923 :results true} {:checked true :title "Supabase proxy installs every legacy action on a canonical node" :source "(fact \"Supabase proxy installs every legacy action on a canonical node\"\n     (let [node (substrate/node-create \"supabase-proxy\")]\n       (supabase/init-client node)\n       [(instance? substrate/SubstrateNode node)\n        (count kernel/ACTIONS)\n        (count (substrate/list-handlers node))])\n     => [true 28 28])" :meta {} :refer-source :unresolved :nested true :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.db.node.supabase/init-client std.substrate/SubstrateNode std.db.node.kernel-supabase/ACTIONS std.substrate/list-handlers] :order 3109 :results true} {:checked true :title "sign-in stores session and starts refresh through the remote kernel" :source "(fact \"sign-in stores session and starts refresh through the remote kernel\"\n     (do\n       (reset! CALLS [])\n       (reset! REFRESH-STARTS 0)\n       (let [nodes (connected-nodes \"signin\")\n             client-node (get nodes :client)\n             session (deref\n                      (client/sign-in client-node\n                                      \"auth/supabase\"\n                                      {:email \"wombat@example.com\"\n                                       :password \"secret\"}\n                                      {:timeout-ms 1000}))\n             current (deref (client/current-session client-node \"auth/supabase\" {}))\n             signed-in (deref (client/signed-in? client-node \"auth/supabase\" {}))]\n         [session\n          current\n          signed-in\n          @REFRESH-STARTS\n          (get (first @CALLS) :operation)]))\n     => [{:access-token \"signin-token\" :refresh-token \"signin-refresh\"}\n         {:access-token \"signin-token\" :refresh-token \"signin-refresh\"}\n         true\n       