{:format "code.manage.test-doc/2" :test-path "std/db/node/service_test.hal" :namespace std.db.node.service-test :namespace-form "(ns std.db.node.service-test\n  (:use code.test)\n  (:require [std.db.node.client-base :as client]\n            [std.db.node.runtime :as runtime]\n            [db.protocol :as protocol]\n            [std.foundation.promise :as promise]\n            [std.substrate :as substrate]))" :support-forms [{:source "(defstruct ServiceConnection\n  [id])" :order 276} {:source "(extend-type ServiceConnection protocol/IDatabase\n  (db-engine [connection]\n    :service-sql)\n  (db-provider [connection]\n    :service-mock)\n  (db-info [connection]\n    {:id (:id connection)\n     :engine :service-sql\n     :provider :service-mock})\n  (db-exec [connection sql parameters]\n    (promise/from {:affected 1\n                   :connection (:id connection)\n                   :sql sql\n                   :parameters parameters}))\n  (db-query [connection sql parameters]\n    (promise/from {:columns [\"connection\" \"value\"]\n                   :rows [[(:id connection) (first parameters)]]\n                   :affected 0}))\n  (db-close [connection]\n    (promise/from true)))" :order 314} {:source "(defn service-driver\n  []\n  {:id :service-mock\n   :engine :service-sql\n   :open (fn [options]\n           (promise/from\n            (std.db.node.service-test/ServiceConnection\n             (get options :id \"service-default\"))))})" :order 995} {:source "(def base-config\n  {:primary {:type :service-mock\n             :options {:id \"primary\"}}})" :order 1225}] :facts [{:checked true :title "drivers are discoverable through the client runtime API" :source "(fact \"drivers are discoverable through the client runtime API\"\n     (let [server (substrate/node-create \"service-driver-server\")\n           client-node (substrate/node-create \"service-driver-client\")]\n       (let [connected (deref\n                        (runtime/local-connect\n                  