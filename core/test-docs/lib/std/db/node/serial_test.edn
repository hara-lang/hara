{:format "code.manage.test-doc/2" :test-path "std/db/node/serial_test.hal" :namespace std.db.node.serial-test :namespace-form "(ns std.db.node.serial-test\n  (:use code.test)\n  (:require [db.node.client-base :as client]\n            [db.node.runtime :as runtime]\n            [db.protocol :as protocol]\n            [std.substrate :as substrate]))" :support-forms [{:source "(def EVENTS (atom []))" :order 218} {:source "(defstruct SerialConnection\n  [id])" :order 242} {:source "(defn- finish\n  [sql result]\n  (swap! EVENTS conj [:end sql])\n  result)" :order 279} {:source "(extend-type SerialConnection protocol/IDatabase\n  (db-engine [connection] :serial-sql)\n  (db-provider [connection] :serial)\n  (db-info [connection]\n    {:id (:id connection)\n     :engine :serial-sql\n     :provider :serial})\n  (db-exec [connection sql parameters]\n    (swap! EVENTS conj [:start sql])\n    (cond\n      (= sql \"slow\")\n      (promise/delay 20\n                     (fn []\n                       (finish sql {:affected 1})))\n\n      (= sql \"fail\")\n      (do\n        (swap! EVENTS conj [:end sql])\n        (promise/new\n         (fn [resolve reject]\n           (reject (ex-info \"serial failure\" {:sql sql})))))\n\n      :else\n      (promise/from (finish sql {:affected 1}))))\n  (db-query [connection sql parameters]\n    (swap! EVENTS conj [:start sql])\n    (promise/from\n     (finish sql {:columns [] :rows [] :affected 0})))\n  (db-close [connection]\n    (promise/from true)))" :order 352} {:source "(defn serial-driver\n  []\n  {:id :serial\n   :engine :serial-sql\n   :open (fn [options]\n           (promise/from\n            (std.db.node.serial-test/SerialConnection \"serial-1\")))})" :order 1236} {:source "(def config {:primary {:type :serial}})" :order 1418} {:source "(defn client-node\n  [suffix]\n  (let [server (substrate/node-create (str \"serial-server-\" suffix))\n        client-node (substrate/node-create (str \"serial-client-\" suffix))]\n    (deref\n     (run