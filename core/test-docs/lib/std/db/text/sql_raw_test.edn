.text.sql-raw/raw-insert] :order 751 :results true} {:checked true :title "raw-upsert preserves source conflict semantics" :source "(fact \"raw-upsert preserves source conflict semantics\"\n     (raw/raw-upsert\n      \"Currency\"\n      \"id\"\n      [\"id\" \"name\" \"type\"]\n      [{:id \"XLM\" :name \"XLM\" :type \"crypto\"}]\n      {:upsert-clause \"\\\"excluded\\\".time_updated < time_updated\"})\n     => (str \"INSERT INTO Currency\\n\"\n             \" (id, name, type)\\n\"\n             \" VALUES\\n\"\n             \" ('XLM','XLM','crypto')\\n\"\n             \"ON CONFLICT (id) DO UPDATE SET\\n\"\n             \"name=coalesce(\\\"excluded\\\".name,name),\\n\"\n             \"type=coalesce(\\\"excluded\\\".type,type)\\n\"\n             \"WHERE \\\"excluded\\\".time_updated < time_updated;\"))" :meta {} :refer-source :qualified-call :nested true :original-refer false :refer std.db.text.sql-raw/raw-upsert :refer-candidates [std.db.text.sql-raw/raw-upsert] :order 1009 :results true} {:checked true :title "raw-update and raw-select retain source whitespace" :source "(fact \"raw-update and raw-select retain source whitespace\"\n     [(raw/raw-update \"Currency\"\n                      {\"id\" \"XLM\"}\n                      {\"name\" \"Stellar\"}\n                      {})\n      (raw/raw-select \"Currency\"\n                      {\"id\" \"XLM\"}\n                      [\"id\" \"name\" \"type\"]\n                      {})]\n     => [\"UPDATE Currency\\n SET name = 'Stellar'\\n WHERE id = 'XLM';\"\n         \"SELECT id, name, type\\n  FROM Currency\\n WHERE id = 'XLM';\"])" :meta {} :refer-source :unresolved :nested true :original-refer false :refer nil :refer-candidates [std.db.text.sql-raw/raw-update std.db.text.sql-raw/raw-select] :order 1621 :results true} {:checked true :title "raw statements accept SQLite quoting options" :source "(fact \"raw statements accept SQLite quoting options\"\n     (raw/raw-select\n      \"Currency\"\n      {\"id\" \"XLM\"}\n     