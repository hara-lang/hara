ource "(fact \"removes pending request entries by id\"\n  (let [node (substrate/node-create \"node/remove-pending\")\n        outgoing (frame/request-frame \"room/a\" \"echo\" [] nil)]\n    (request/add-pending node outgoing identity identity nil)\n    (let [removed (request/remove-pending node (get outgoing \"id\"))]\n      [(string? (get-in removed [\"request\" \"id\"]))\n       (substrate/node-section node :pending)]))\n  => [true {}])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate.frame/request-frame std.substrate.request/add-pending std.substrate.request/remove-pending std.substrate/node-section] :order 1059 :results nil} {:checked true :title "settles rejected pending requests with the response frame" :source "(fact \"settles rejected pending requests with the response frame\"\n  (let [node (substrate/node-create \"node/reject\")\n        rejected (atom nil)\n        outgoing (frame/request-frame \"room/a\" \"echo\" [] nil)\n        response (frame/response-error-frame\n                  (get outgoing \"id\") \"room/a\"\n                  {\"message\" \"boom\"} nil)]\n    (request/add-pending\n     node outgoing identity (fn [value] (reset! rejected value)) nil)\n    (request/settle-pending node response)\n    [(get-in @rejected [\"error\" \"message\"])\n     (substrate/node-section node :pending)])\n  => [\"boom\" {}])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate.frame/request-frame std.substrate.frame/response-error-frame std.substrate.request/add-pending std.substrate.request/settle-pending std.substrate/node-section] :order 1475 :results nil} {:checked true :title "invokes handlers against the selected space" :source "(fact \"invokes handlers against the selected space\"\n  (let [node (substrate/node-create \"node/handler\")\n        calls (atom [])]\n    (substrate/secti