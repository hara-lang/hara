[network\n        (memory/memory-network\n         {\"hub\" [\"peer-a\" \"peer-b\"]\n          \"peer-a\" [\"hub\"]\n          \"peer-b\" [\"hub\"]})\n        seen (atom [])]\n    ((get-in network [\"peer-a\" \"start_fn\"])\n     (fn [event context]\n       (reset! seen\n               (conj @seen\n                     [\"peer-a\"\n                      (memory/event-text event)\n                      (get context \"wire\")\n                      (get context \"peer\")]))\n       true))\n    ((get-in network [\"peer-b\" \"start_fn\"])\n     (fn [event context]\n       (reset! seen\n               (conj @seen\n                     [\"peer-b\"\n                      (memory/event-text event)\n                      (get context \"wire\")\n                      (get context \"peer\")]))\n       true))\n    (promise/value ((get-in network [\"hub\" \"write_fn\"]) \"ping\"))\n    @seen)\n  => [[\"peer-a\" \"ping\" \"hub\" \"peer-a\"]\n      [\"peer-b\" \"ping\" \"hub\" \"peer-b\"]])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate.transport-memory/memory-network std.substrate.transport-memory/event-text std.foundation.promise/value] :order 2342 :results nil} {:checked true :title "link-pair supports end-to-end substrate requests" :source "(fact \"link-pair supports end-to-end substrate requests\"\n  (let [client (substrate/node-create {\"id\" \"client\"})\n        server\n        (substrate/node-create\n         {\"id\" \"server\"\n          \"handlers\"\n          {\"sum\"\n           (fn [space args incoming node]\n             (+ (nth args 0) (nth args 1)))}})]\n    (promise/value (memory/link-pair server client))\n    (promise/value\n     (substrate/request client \"room/a\" \"sum\" [19 23] {})))\n  => 42)" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.foundation.promise/value std.substrate.transport-memory/link-pair std.su