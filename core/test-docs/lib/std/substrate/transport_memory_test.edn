{:format "code.manage.test-doc/2" :test-path "std/substrate/transport_memory_test.hal" :namespace std.substrate.transport-memory-test :namespace-form "(ns std.substrate.transport-memory-test\n  (:use code.test)\n  (:require [std.foundation.promise :as promise]\n            [std.substrate :as substrate]\n            [std.substrate.frame :as frame]\n            [std.substrate.json :as substrate-json]\n            [std.substrate.transport-memory :as memory]))" :support-forms [] :facts [{:checked true :title "unwraps endpoint event text and normalises targets" :source "(fact \"unwraps endpoint event text and normalises targets\"\n  [(memory/event-text {\"data\" \"ping\"})\n   (memory/event-text {\"text\" \"pong\"})\n   (memory/event-text \"echo\")\n   (memory/network-targets nil)\n   (memory/network-targets [\"a\" \"b\"])\n   (memory/network-targets \"hub\")]\n  => [\"ping\" \"pong\" \"echo\" [] [\"a\" \"b\"] [\"hub\"]])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate.transport-memory/event-text std.substrate.transport-memory/network-targets] :order 305 :results nil} {:checked true :title "memory pair endpoints deliver text with wire context" :source "(fact \"memory pair endpoints deliver text with wire context\"\n  (let [wire (memory/memory-pair\n              {\"left_id\" \"host\" \"right_id\" \"peer\"})\n        left (get wire \"left\")\n        right (get wire \"right\")\n        seen (atom nil)]\n    ((get right \"start_fn\")\n     (fn [event context]\n       (reset! seen\n               [(memory/event-text event)\n                (get context \"wire\")\n                (get context \"peer\")])\n       true))\n    (promise/value ((get left \"write_fn\") \"ping\"))\n    @seen)\n  => [\"ping\" \"host\" \"peer\"])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate.transport-memory/memory-pair std.substrate.transport-memory/event-text std.fou