{:format "code.manage.test-doc/2" :test-path "std/substrate/pubsub_test.hal" :namespace std.substrate.pubsub-test :namespace-form "(ns std.substrate.pubsub-test\n  (:use code.test)\n  (:require [std.substrate :as substrate]\n            [std.substrate.frame :as frame]\n            [std.substrate.pubsub :as pubsub]\n            [std.substrate.space :as space]))" :support-forms [] :facts [{:checked true :title "constructs subscription control frames" :source "(fact \"constructs subscription control frames\"\n  (let [node (substrate/node-create \"node/control\")\n        subscribe (pubsub/subscribe\n                   node \"room/a\" \"event/updated\" \"sub-1\" nil)\n        unsubscribe (pubsub/unsubscribe\n                     node \"room/a\" \"event/updated\" \"sub-1\" nil)]\n    [(get subscribe \"kind\")\n     (get subscribe \"space\")\n     (get subscribe \"signal\")\n     (get subscribe \"id\")\n     (get unsubscribe \"kind\")\n     (get unsubscribe \"id\")])\n  => [\"subscribe\" \"room/a\" \"event/updated\" \"sub-1\"\n      \"unsubscribe\" \"sub-1\"])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate.pubsub/subscribe std.substrate.pubsub/unsubscribe] :order 228 :results nil} {:checked true :title "invokes a shared trigger against the selected space" :source "(fact \"invokes a shared trigger against the selected space\"\n  (let [node (substrate/node-create \"node/trigger\")\n        calls (atom [])]\n    (substrate/section-put\n     node :triggers \"event/updated\"\n     {\"id\" \"event/updated\"\n      \"fn\" (fn [current-space stream current-node]\n             (reset! calls\n                     (conj @calls\n                           [(get current-space \"id\")\n                            (get-in stream [\"data\" \"value\"])\n                            (:id current-node)]))\n             {\"ok\" true})\n      \"meta\" {}})\n    (promise/value\n     (pubsub/invoke-trigg