{:format "code.manage.test-doc/2" :test-path "std/substrate/router_test.hal" :namespace std.substrate.router-test :namespace-form "(ns std.substrate.router-test\n  (:use code.test)\n  (:require [std.substrate :as substrate]\n            [std.substrate.router :as router]))" :support-forms [] :facts [{:checked true :title "constructs router control frames" :source "(fact \"constructs router control frames\"\n  (let [subscribe (router/subscribe-frame\n                   \"room/a\" \"event/ping\" \"sub-a\" {\"via\" \"tab\"})\n        unsubscribe (router/unsubscribe-frame\n                     nil \"event/ping\" nil {\"via\" \"tab\"})]\n    [(get subscribe \"kind\")\n     (get subscribe \"space\")\n     (get subscribe \"signal\")\n     (get-in subscribe [\"meta\" \"via\"])\n     (get unsubscribe \"kind\")\n     (get unsubscribe \"space\")\n     (string? (get unsubscribe \"id\"))])\n  => [\"subscribe\" \"room/a\" \"event/ping\" \"tab\"\n      \"unsubscribe\" \"__NODE__\" true])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate.router/subscribe-frame std.substrate.router/unsubscribe-frame] :order 140 :results nil} {:checked true :title "creates router and nested subscription tables on demand" :source "(fact \"creates router and nested subscription tables on demand\"\n  (let [node (substrate/node-create \"node/router\")]\n    (router/ensure-signal-subscriptions node \"room/a\" \"event/ping\")\n    [(vec (sort (keys (router/ensure-router node))))\n     (vec (keys (router/ensure-space-subscriptions node \"room/a\")))\n     (router/ensure-signal-subscriptions node \"room/a\" \"event/ping\")])\n  => [[\"connections\" \"subscriptions\"] [\"event/ping\"] {}])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate.router/ensure-signal-subscriptions std.substrate.router/ensure-router std.substrate.router/ensure-space-subscriptions] :order 703 :results nil} {:checked true :title "registers connections and subscriptions" :source "(fact \"registers connections and subscriptions\"\n  (let [node (substrate/node-create \"node/register\")\n        connection (router/register-connection\n                    node \"peer-a\" {\"role\" \"edge\"})\n        subscription (router/add-subscription\n                      node \"peer-a\" \"room/a\" \"event/ping\"\n                      \"sub-a\" {\"scope\" \"tab\"})]\n    [(get connection \"id\")\n     (get-in (router/get-connections node)\n             [\"peer-a\" \"meta\" \"role\"])\n     (get subscription \"id\")\n     (get-in (router/get-subscriptions node)\n             [\"room/a\" \"event/ping\" \"peer-a\" \"meta\" \"scope\"])\n     (router/list-subscriptions node \"room/a\" \"event/ping\")])\n  => [\"peer-a\" \"edge\" \"sub-a\" \"tab\" [\"peer-a\"]])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate.router/register-connection std.substrate.router/add-subscription std.substrate.router/get-connections std.substrate.router/get-subscriptions std.substrate.router/list-subscriptions] :order 1138 :results nil} {:checked true :title "pure prune helpers remove empty signal and space branches" :source "(fact \"pure prune helpers remove empty signal and space branches\"\n  (let [space-subscriptions\n        {\"event/a\" {\"peer-a\" {\"id\" \"sub-a\"}\n                     \"peer-b\" {\"id\" \"sub-b\"}}\n         \"event/b\" {\"peer-a\" {\"id\" \"sub-c\"}}}\n        pruned-space\n        (router/prune-subscription-signal-loop\n         space-subscriptions [\"event/a\" \"event/b\"] \"peer-a\" 0)\n        subscriptions\n        {\"room/a\" space-subscriptions\n         \"room/b\" {\"event/c\" {\"peer-a\" {\"id\" \"sub-d\"}}}}\n        pruned-all\n        (router/prune-subscription-space-loop\n         subscriptions [\"room/a\" \"room/b\"] \"peer-a\" 0)]\n    [(get-in pruned-space [\"event/a\" \"peer-b\" \"id\"])\n     (nil? (get-in pruned-space [\"event/a\" \"peer-a\"]))\n     (nil? (get pruned-space \"event/b\"))\n     (vec (keys pruned-all))])\n  => [\"sub-b\" true true [\"room/a\"]])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate.router/prune-subscription-signal-loop std.substrate.router/prune-subscription-space-loop] :order 1846 :results nil} {:checked true :title "removes subscriptions and prunes connection state" :source "(fact \"removes subscriptions and prunes connection state\"\n  (let [node (substrate/node-create \"node/remove\")]\n    (router/register-connection node \"peer-a\" nil)\n    (router/register-connection node \"peer-b\" nil)\n    (router/add-subscription node \"peer-a\" \"room/a\" \"event/ping\" \"sub-a\" nil)\n    (router/add-subscription node \"peer-b\" \"room/a\" \"event/ping\" \"sub-b\" nil)\n    (let [removed (router/remove-subscription\n                   node \"peer-a\" \"room/a\" \"event/ping\")\n          previous (router/unregister-connection node \"peer-b\")]\n      [(get removed \"id\")\n       (get previous \"id\")\n       (router/list-subscriptions node \"room/a\" \"event/ping\")\n       (vec (keys (router/get-connections node)))]))\n  => [\"sub-a\" \"peer-b\" [] [\"peer-a\"]])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate.router/register-connection std.substrate.router/add-subscription std.substrate.router/remove-subscription std.substrate.router/unregister-connection std.substrate.router/list-subscriptions std.substrate.router/get-connections] :order 2663 :results nil} {:checked true :title "receives subscribe and unsubscribe controls from transport context" :source "(fact \"receives subscribe and unsubscribe controls from transport context\"\n  (let [node (substrate/node-create \"node/receive\")\n        subscribe (router/subscribe-frame\n                   \"room/a\" \"event/ping\" \"sub-a\" nil)\n        unsubscribe (router/unsubscribe-frame\n                     \"room/a\" \"event/ping\" \"sub-a\" nil)]\n    (promise/value\n     (router/receive-subscribe node subscribe {\"transport_id\" \"peer-a\"}))\n    (let [before (router/list-subscriptions node \"room/a\" \"event/ping\")]\n      (promise/value\n       (router/receive-unsubscribe node unsubscribe\n                                   {\"transport_id\" \"peer-a\"}))\n      [before\n       (router/list-subscriptions node \"room/a\" \"event/ping\")]))\n  => [[\"peer-a\"] []])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate.router/subscribe-frame std.substrate.router/unsubscribe-frame std.substrate.router/receive-subscribe std.substrate.router/list-subscriptions std.substrate.router/receive-unsubscribe] :order 3406 :results nil}] :noncanonical 6 :unresolved 6}
