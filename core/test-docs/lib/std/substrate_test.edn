{:format "code.manage.test-doc/2" :test-path "std/substrate_test.hal" :namespace std.substrate-test :namespace-form "(ns std.substrate-test\n  (:use code.test)\n  (:require [std.foundation.promise :as promise]\n            [std.substrate :as substrate]))" :support-forms [] :facts [{:checked true :title "node-create applies declarative spaces services and handlers" :source "(fact \"node-create applies declarative spaces services and handlers\"\n  (let [node (substrate/node-create\n              {:id \"node/config\"\n               :spaces {\"main\" {:state {:count 1}\n                                  :meta {:owner \"test\"}}}\n               :services {\"cache\" 41}\n               :handlers\n               {\"sum\" (fn [space args request current-node]\n                        (+ (nth args 0) (nth args 1)))}})]\n    (substrate/update-space-state\n     node \"main\"\n     (fn [state space current-node]\n       (assoc state :count\n              (+ (get state :count)\n                 (substrate/get-service current-node \"cache\")))))\n    [(substrate/node-id node)\n     (substrate/get-space-state node \"main\")\n     (promise/value\n      (substrate/request node \"main\" \"sum\" [19 23] {:local true}))])\n  => [\"node/config\" {:count 42} 42])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate/update-space-state std.substrate/get-service std.substrate/node-id std.substrate/get-space-state std.foundation.promise/value std.substrate/request] :order 136 :results nil} {:checked true :title "transport lifecycle stores listener and invokes send and stop" :source "(fact \"transport lifecycle stores listener and invokes send and stop\"\n  (let [node (substrate/node-create {:id \"node/transport\"})\n        started (atom false)\n        stopped (atom false)\n        sent (atom nil)\n        transport\n        (substrate/transport-create\n         \"peer\"\n         {:send-fn (fn [frame]\n                     (reset! sent (substrate/frame-id frame))\n                     frame)\n          :start-fn (fn [listener]\n                      (reset! started true)\n                      listener)\n          :stop-fn (fn [listener]\n                     (reset! stopped (fn? listener))\n                     true)})]\n    (promise/value (substrate/attach-transport node \"peer\" transport))\n    (promise/value\n     (substrate/transport-send\n      node \"peer\"\n      (substrate/stream-frame \"main\" \"changed\" 1 {:id \"evt-1\"} nil)))\n    (promise/value (substrate/detach-transport node \"peer\"))\n    [@started @sent @stopped (substrate/transport-list node)])\n  => [true \"evt-1\" true []])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.substrate/transport-create std.substrate/frame-id std.foundation.promise/value std.substrate/attach-transport std.substrate/transport-send std.substrate/stream-frame std.substrate/detach-transport std.substrate/transport-list] :order 982 :results nil} {:checked true :title "remote requests settle through symmetric substrate transports" :source "(fact \"remote requests settle through symmetric substrate transports\"\n  (let [client (substrate/node-create {:id \"node/client\"})\n        server (substrate/node-create\n                {:id \"node/server\"\n                 :handlers\n                 {\"sum\" (fn [space args request current-node]\n                          (+ (nth args 0) (nth args 1)))}})]\n    (promise/value\n     (substrate/attach-transport\n      client \"server\"\n      {:send-fn\n       (fn [frame]\n         (substrate/receive-frame server frame {:transport-id \"client\"}))}))\n    (promise/value\n     (substrate/attach-transport\n      server \"client\"\n      {:send-fn\n       (fn [frame]\n         (substrate/receive-frame client frame {:transport-id \"server\"}))}))\n    (promise/value\n     (substrate/request client \"main\" \"sum\" [19 23] {})))\n  => 42)" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.foundation.promise/value std.substrate/attach-transport std.substrate/receive-frame std.substrate/request] :order 1976 :results nil} {:checked true :title "subscriptions route streams without echoing to inbound transport" :source "(fact \"subscriptions route streams without echoing to inbound transport\"\n  (let [node (substrate/node-create {:id \"node/router\"})\n        peer-a (atom [])\n        peer-b (atom [])]\n    (promise/value\n     (substrate/attach-transport\n      node \"peer-a\"\n      {:send-fn (fn [frame]\n                  (reset! peer-a (conj @peer-a (substrate/frame-id frame)))\n                  frame)}))\n    (promise/value\n     (substrate/attach-transport\n      node \"peer-b\"\n      {:send-fn (fn [frame]\n                  (reset! peer-b (conj @peer-b (substrate/frame-id frame)))\n                  frame)}))\n    (promise/value\n     (substrate/receive-frame\n      node\n      (promise/value (substrate/subscribe node \"main\" \"changed\" \"sub-a\"\n                                          {:transport-id \"peer-a\"}))\n      {:transport-id \"peer-a\"}))\n    (promise/value\n     (substrate/receive-frame\n      node\n      (promise/value (substrate/subscribe node \"main\" \"changed\" \"sub-b\"\n                                          {:transport-id \"peer-b\"}))\n      {:transport-id \"peer-b\"}))\n    (promise/value\n     (substrate/receive-frame\n      node\n      (substrate/stream-frame \"main\" \"changed\" 42 {:id \"evt-in\"} nil)\n      {:transport-id \"peer-a\"}))\n    [@peer-a @peer-b\n     (substrate/list-subscriptions node \"main\" \"changed\")])\n  => [[\"sub-a\"] [\"sub-b\" \"evt-in\"] [\"peer-a\" \"peer-b\"]])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [std.substrate/node-create std.foundation.promise/value std.substrate/attach-transport std.substrate/frame-id std.substrate/receive-frame std.substrate/subscribe std.substrate/stream-frame std.substrate/list-subscriptions] :order 2787 :results nil}] :noncanonical 4 :unresolved 4}
