ge.unit.template/tasklet-reference] :order 779 :results nil} {:checked true :title "the public task and its atomic tasklet produce the same item value" :source "(fact \"the public task and its atomic tasklet produce the same item value\"\n  (let [atomic (unit/analyse sample-unit)\n        batch\n        (work/run\n         (work/local-runtime)\n         manage/analyse\n         sample-unit)\n        record\n        (get-in batch\n                [:results 0 :item/value])]\n    [(:item/id record)\n     (= atomic (:data record))\n     (:count (:summary batch))\n     (:results (:summary batch))])\n  => [\"sample.hal\" true 1 1])" :meta {} :refer-source :unresolved :nested nil :original-refer false :refer nil :refer-candidates [code.manage.unit/analyse std.work/run std.work/local-runtime code.manage/analyse] :order 1362 :results nil} {:checked true :title "composed tasks preserve the tasklet result boundary" :source "(fact \"composed tasks preserve the tasklet result boundary\"\n  (let [heal-then-analyse\n        (work/chain\n         {:id :code.manage/heal-then-analyse}\n         [manage/heal-code\n          (work/pure\n           :code.manage/use-healed-source\n           (fn [batch context]\n             (let [edit\n                   (get-in\n                    batch\n                    [:results 0\n                     :item/value\n                     :data])]\n               {:path (:path edit)\n                :source (:after edit)})))\n          manage/analyse])\n        result\n        (work/run\n         (work/local-runtime)\n         heal-then-analyse\n         {:path \"composed.hal\"\n          :source \"(ns composed.core)  \"})]\n    [(get-in result\n             [:results 0\n              :item/value\n              :item/id])\n     (get-in result\n             [:results 0\n              :item/value\n              :data\n              :namespace])\n     (str/ends-with?\n      (get-in result\n              [:results 0\n               :item/value\n        