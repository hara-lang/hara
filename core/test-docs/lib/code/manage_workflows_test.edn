fact \"scaffold appends only missing facts before the runner and preserves legacy refs\"\n  (let [edit (unit/scaffold scaffold-unit {})\n        after (:after edit)\n        existing \"^{:ref demo.core/first-value :added \\\"1.0\\\"}\\n(fact \\\"Keep me byte-for-byte\\\")\"\n        generated \"^{:refer demo.core/second-value :added \\\"5.8\\\"}\\n(fact \\\"Second title.\\\")\"]\n    [(:new edit)\n     (:create edit)\n     (= (str/index-of after generated)\n        (str/last-index-of after generated))\n     (str/includes? after existing)\n     (< (str/index-of after generated)\n        (str/index-of after \"(pr-str (run\"))])\n  => [[\"second-value\"] false true true true])" :meta {} :refer-source :qualified-call :nested nil :original-refer false :refer code.manage.unit/scaffold :refer-candidates [code.manage.unit/scaffold] :order 1837 :results nil} {:checked true :title "scaffold creates a complete test and honours --added major/minor override" :source "(fact \"scaffold creates a complete test and honours --added major/minor override\"\n  (let [edit (unit/scaffold (assoc scaffold-unit :test-source \"\")\n                            {:added \"9.4.7\"})]\n    [(:create edit)\n     (:added edit)\n     (str/includes? (:after edit)\n                    \"^{:refer demo.core/first-value :added \\\"9.4\\\"}\")\n     (str/includes? (:after edit) \"(fact \\\"Existing title.\\\")\")])\n  => [true \"9.4\" true true])" :meta {} :refer-source :qualified-call :nested nil :original-refer false :refer code.manage.unit/scaffold :refer-candidates [code.manage.unit/scaffold] :order 2482 :results nil} {:checked true :title "import uses the last duplicate fact, replaces docs, and merges :added metadata" :source "(fact \"import uses the last duplicate fact, replaces docs, and merges :added metadata\"\n  (let [edit (unit-import/import import-unit {})\n        after (:after edit)]\n    [(:imported edit)\n     (str/includes? after \"\\\"Canonical title\\\"\")\n     (str/includes? after \":s