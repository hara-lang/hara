{:format "code.manage.test-doc/2" :test-path "code/manage_workflows_test.hal" :namespace code.manage-workflows-test :namespace-form "(ns code.manage-workflows-test\n  (:use code.test)\n  (:require [code.framework :as framework]\n            [code.manage.editor :as editor]\n            [code.manage.unit :as unit]\n            [code.manage.unit.import :as unit-import]))" :support-forms [{:source "(def structural-source\n  \"(ns demo.structural)\\n\\n(defn ^{:schema [:fn [:str] :str] :owner :runtime}\\n  render\\n  \\\"A multiline\\\\ndocstring with \\\\\\\"quotes\\\\\\\".\\\"\\n  [value]\\n  value)\\n\\n(defmacro\\n  expose\\n  \\\"Expose a form.\\\"\\n  [form]\\n  form)\\n\\n(defonce ^:private hidden 1)\\n\\n(defonce cache 7)\\n\\n(def undocumented 42)\\n\")" :order 234} {:source "(def scaffold-unit\n  {:path \"src/demo/core.hal\"\n   :test-path \"test/demo/core_test.hal\"\n   :version \"5.8.3\"\n   :source\n   \"(ns demo.core)\\n\\n(defn first-value\\n  \\\"Existing title.\\\"\\n  []\\n  1)\\n\\n(defn second-value\\n  \\\"Second title.\\\"\\n  []\\n  2)\\n\"\n   :test-source\n   \"(ns demo.core-test\\n  (:use code.test))\\n\\n^{:ref demo.core/first-value :added \\\"1.0\\\"}\\n(fact \\\"Keep me byte-for-byte\\\")\\n\\n(pr-str (run {:namespace \\\"demo.core-test\\\"}))\\n\"})" :order 1387} {:source "(def import-unit\n  {:path \"src/demo/imports.hal\"\n   :test-path \"test/demo/imports_test.hal\"\n   :source\n   \"(ns demo.imports)\\n\\n(defn ^{:schema [:fn [] :int] :owner :api}\\n  answer\\n  \\\"Old title.\\\"\\n  []\\n  42)\\n\\n(defmacro expose\\n  [form]\\n  form)\\n\"\n   :test-source\n   \"(ns demo.imports-test (:use code.test))\\n\\n^{:refer demo.imports/answer :added \\\"2.1\\\"}\\n(fact \\\"Earlier title\\\")\\n\\n^{:refer demo.imports/answer :added \\\"3.7\\\"}\\n(fact \\\"Canonical title\\\")\\n\\n^{:refer demo.imports/expose :added \\\"3.7\\\"}\\n(fact \\\"Expose a form\\\")\\n\"})" :order 2916} {:source "(def report-unit\n  {:path \"src/demo/report.hal\"\