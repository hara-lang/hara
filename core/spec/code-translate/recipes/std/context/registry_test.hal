(ns std.context.registry-test
  (:use code.test)
  (:require [std.context.registry :as registry]))

(fact "null runtime and initial registry are installed"
  [(registry/rt-null? registry/+rt-null+)
   (registry/registry-list)
   (registry/registry-rt-list :null)]
  => [true [:null] [:default]])

(fact "registry operations preserve Foundation names and nested configuration"
  (binding [registry/*registry* (atom {})]
    (registry/registry-install
     :demo
     {:rt {:default {:key :default
                     :create (fn [config] config)
                     :config {:outer {:left 1}}}}})
    (registry/registry-rt-add :demo {:key :other :config {:value 2}})
    (let [runtime (registry/registry-rt :demo :default)]
      (registry/registry-scratch-set! :demo {:scratch true})
      [(:config runtime)
       (registry/registry-rt-list :demo)
       (registry/registry-scratch :demo)
       (let [removed (registry/registry-uninstall :demo)]
         [(get-in removed [:rt :default :key])
          (fn? (get-in removed [:rt :default :create]))
          (get-in removed [:rt :other :config])])]))
  => [{:outer {:left 1}}
      [:default :other]
      {:scratch true}
      [:default true {:value 2}]])

(pr-str (run {:namespace "std.context.registry-test"}))
