(ns std.context.pointer-test
  (:use code.test)
  (:require [std.context.pointer :as pointer]
            [std.context.registry :as registry]))

(fact "pointers retain fields and resolve explicit runtimes first"
  (let [value (pointer/pointer {:context :demo
                                :answer 42
                                :context/rt registry/+rt-null+})]
    [(pointer/pointer? value)
     (IPointer/ptr-context value)
     (IPointer/ptr-val value :answer)
     (set (IPointer/ptr-keys value))
     (= registry/+rt-null+ (pointer/pointer-default value))])
  => [true :demo 42 #{:answer} true])

(fact "pointer invocation uses the native context protocol"
  (let [value (pointer/pointer {:context :demo
                                :context/rt registry/+rt-null+})]
    [(vector? (pointer/pointer-deref value))
     (invoke-as value :a :b)
     (pointer/rt-call registry/+rt-null+ :c)])
  => [true [:a :b] [:c]])

(pr-str (run {:namespace "std.context.pointer-test"}))
