(ns std.foundation.native-method-conformance)

(def native-method-fixtures
  {'RegExp/instance?
   [true (fn [] (RegExp/instance? (RegExp/compile "a+")))]

   'RegExp/compile
   [true (fn [] (RegExp/instance? (RegExp/compile "a+")))]

   'RegExp/pattern
   ["a+" (fn [] (RegExp/pattern (RegExp/compile "a+")))]

   'RegExp/find?
   [true (fn [] (RegExp/find? (RegExp/compile "a+") "caa"))]

   'RegExp/find
   ["aa" (fn [] (RegExp/find (RegExp/compile "a+") "caa"))]

   'RegExp/matches
   [[true false true]
    (fn []
      [(RegExp/matches (RegExp/compile "a+") "aa")
       (RegExp/matches (RegExp/compile "a+") "caa")
       (RegExp/matches (RegExp/compile "a|abc") "abc")])]

   'RegExp/replace
   ["12:x" (fn []
              (RegExp/replace
                (RegExp/compile "([a-z]+)-([0-9]+)")
                "x-12"
                "$2:$1"))]

   'RegExp/split
   [["a" "b" "c"]
    (fn [] (RegExp/split (RegExp/compile ",+") "a,,b,c"))]})

(defn native-method-result
  "Runs direct canonical native calls, with concrete RegExp cases and missing-dispatch classification."
  [method thunk]
  (let [fixture (get native-method-fixtures method)]
    (try
      (if fixture
        (let [expected (first fixture)
              actual ((second fixture))]
          {:method method
           :pass (= expected actual)
           :expected expected
           :actual actual})
        (do
          (thunk)
          {:method method :pass true}))
      (catch Throwable error
        (let [message (ex-message error)]
          {:method method
           :pass
           (if fixture
             false
             (if (std.foundation.string/includes? message "nbound symbol")
               false
               (if (std.foundation.string/includes? message "unavailable/")
                 false
                 true)))
           :error message})))))
