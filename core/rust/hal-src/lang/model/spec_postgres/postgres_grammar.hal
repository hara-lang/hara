(ns lang.model.spec-postgres.postgres-grammar
  (:require [lang.base.v1.grammar-spec :as spec]
            [lang.common.grammar-api :as grammar]
            [lang.model.spec-xtalk :as xtalk]
            [lang.model.spec-postgres.postgres-native :as native]
))

(def +language+ :postgres)
(def +tag+ :postgres)
(def +grammar-version+ spec/+version+)

(def +grammar+
  (grammar/definition
   {:grammar/id +tag+
    :grammar/version +grammar-version+
    :grammar/release "alpha"
    :grammar/language +language+
    :grammar/tag +tag+
    :grammar/engine {:minimum 1 :maximum 1}
    :grammar/parent {:grammar/id xtalk/+tag+
                     :grammar/version xtalk/+grammar-version+}
    :operators {:override (get native/+operators+ :override)
                :define (get native/+operators+ :define)}
    :emit native/+emit+}))

