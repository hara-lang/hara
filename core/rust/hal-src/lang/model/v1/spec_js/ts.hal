(ns lang.model.v1.spec-js.ts
  (:require [lang.model.spec-js.js-ts :as impl]))

;; Preserve the historical public TypeScript facet namespace while the split
;; alpha implementation remains under lang.model.spec-js.js-ts.
(def +facet+ impl/+facet+)
(def +ts-ident-start-chars+ impl/+ts-ident-start-chars+)
(def +ts-ident-rest-chars+ impl/+ts-ident-rest-chars+)
(def +digits+ impl/+digits+)
(def valid-ts-ident? impl/valid-ts-ident?)
(def sanitize-ts-ident impl/sanitize-ts-ident)
(def named-ts-ident impl/named-ts-ident)
(def export-ts-ident impl/export-ts-ident)
(def ns->module-path impl/ns->module-path)
(def quoted-prop impl/quoted-prop)
(def prop-ident impl/prop-ident)
(def unwrap-maybe impl/unwrap-maybe)
(def emit-record-fields impl/emit-record-fields)
(def emit-open-record impl/emit-open-record)
(def emit-ts-type impl/emit-ts-type)
(def collect-type-refs impl/collect-type-refs)
(def emit-imports impl/emit-imports)
(def emitted-specs impl/emitted-specs)
(def emit-analysis-declarations impl/emit-analysis-declarations)
(def emit-module-declarations impl/emit-module-declarations)
(def module-dts-artifact impl/module-dts-artifact)
