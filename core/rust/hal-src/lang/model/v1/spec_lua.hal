(ns lang.model.v1.spec-lua
  (:require [lang.model.spec-lua :as impl]))

;; Stable public V1 coordinate over the alpha Lua grammar implementation.
(def +language+ impl/+language+)
(def +tag+ impl/+tag+)
(def +version+ 1)
(def +grammar-version+ impl/+grammar-version+)
(def +grammar+ impl/+grammar+)
(def install impl/install)
(def catalog impl/catalog)
(def select impl/select)
(def +selection+ impl/+selection+)
(def +book+ (assoc impl/+book+ :version +version+))
(def +init+ +book+)
