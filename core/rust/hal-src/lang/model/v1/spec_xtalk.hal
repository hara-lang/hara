(ns lang.model.v1.spec-xtalk
  (:require [lang.model.spec-xtalk :as impl]))

;; Stable public model namespace. The alpha implementation remains internal;
;; callers and registry coordinates keep the Foundation V1 contract.
(def +language+ impl/+language+)
(def +tag+ impl/+tag+)
(def +version+ 1)
(def +grammar-version+ impl/+grammar-version+)
(def +template+ impl/+template+)
(def +profile+ impl/+profile+)
(def +grammar+ impl/+grammar+)
(def install impl/install)
(def catalog impl/catalog)
(def select impl/select)
(def +selection+ impl/+selection+)
(def +book+ (assoc impl/+book+ :version +version+))
(def +init+ +book+)
