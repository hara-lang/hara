(ns lang.runtime.postgres.db-client
  (:require [lib.postgres :as base]
            [lang.core.compile :as compile :lazy true]
            [std.db.postgres :as postgres]
            [std.protocol.icontexteval :as context-eval]))

(defstruct RuntimePostgresDbClient
  [id lang runtime options connection host port container startup shutdown state modules pointers profile timeout])

(defn rt-create
  [options]
  (lang.runtime.postgres.db-client/RuntimePostgresDbClient
   (or (:id options) :postgres.db-client)
   :postgres
   :db.client
   options
   (atom nil)
   nil
   nil
   (get-in options [:config :container])
   (get-in options [:config :startup])
   (get-in options [:config :shutdown])
   (atom {:status :created})
   (atom #{})
   (atom #{})
   {:input [] :source [] :response []}
   (or (get-in options [:config :timeout]) 30000)))

(defn start-runtime
  [runtime]
  (let [started (base/start-pg runtime)]
    (reset! (:state started) {:status :started})
    started))

(defn stop-runtime
  [runtime]
  (let [stopped (base/stop-pg runtime)]
    (reset! (:state stopped) {:status :stopped})
    stopped))

(defn execute-only?
  [source]
  (let [statement (str/upper (str/trim source))]
    (boolean
     (first
      (filter (fn [prefix] (str/starts-with? statement prefix))
              ["DO " "BEGIN " "DECLARE " "INSERT " "UPDATE " "DELETE "
               "CREATE " "DROP " "ALTER " "GRANT " "REVOKE " "TRUNCATE "
               "COMMENT " "VACUUM "])))))

(defn normalize-query
  [response]
  (let [columns (get response "columns")
        rows (get response "rows")
        values (if (= 1 (count columns))
                 (map first rows)
                 rows)]
    (if (= 1 (count values)) (first values) values)))

(defn raw-eval
  [runtime source]
  (let [connection (deref (:connection runtime))]
    (if (nil? connection)
      (throw (ex-info "PostgreSQL runtime is not started" {:id (:id runtime)}))
      (if (execute-only? source)
        (deref (postgres/exec connection source))
        (normalize-query
         (deref (postgres/query connection source)))))))

(defn evaluate-async
  [runtime source options]
  (promise/run (fn [] (raw-eval runtime source))))

(defn module-compile
  [module]
  (let [compile-form (list 'resolve (list 'quote 'compile/compile-module))
        compile-var (eval-in-ns 'lang.runtime.postgres.db-client [compile-form])]
    (if compile-var
      ((deref compile-var) {:lang :postgres
                            :main module
                            :layout :module
                            :emit {:code {:label true}}})
      (throw (ex-info "Declared compiler dependency did not load"
                      {:symbol 'compile/compile-module})))))

(defn setup-module!
  [runtime module]
  (if (get (deref (:modules runtime)) module)
    runtime
    (let [compiled (module-compile module)
          diagnostics (:diagnostics compiled)]
      (if (not (empty? diagnostics))
        (throw (ex-info "PostgreSQL module compilation failed"
                        {:module module :diagnostics diagnostics})))
      (deref (postgres/batch-exec (deref (:connection runtime)) (:output compiled)))
      (swap! (:modules runtime) conj module)
      runtime)))

(defn teardown-module!
  [runtime module]
  (swap! (:modules runtime) disj module)
  runtime)

(defn setup-pointer!
  [runtime pointer]
  (swap! (:pointers runtime) conj pointer)
  runtime)

(defn teardown-pointer!
  [runtime pointer]
  (swap! (:pointers runtime) disj pointer)
  runtime)

(extend-type RuntimePostgresDbClient context-eval/IContextEval
  (evaluate [runtime request options]
    (evaluate-async runtime request options))
  (evaluate-raw [runtime request options]
    (evaluate-async runtime request options)))

(extend-type RuntimePostgresDbClient IContext
  (call [runtime source]
    (raw-eval runtime source)))

(extend-type RuntimePostgresDbClient IComponent
  (props [runtime]
    {:state {:get (fn [] (deref (:state runtime)))}
     :connection {:get (fn [] (deref (:connection runtime)))}
     :container {:get (fn [] (:container runtime))}})
  (status [runtime]
    (:status (deref (:state runtime))))
  (started? [runtime]
    (= :started (:status (deref (:state runtime)))))
  (stopped? [runtime]
    (= :stopped (:status (deref (:state runtime)))))
  (start [runtime]
    (start-runtime runtime))
  (stop [runtime]
    (stop-runtime runtime))
  (kill [runtime]
    (stop-runtime runtime))
  (remote? [runtime]
    (nil? (:container runtime))))

(extend-type RuntimePostgresDbClient IContextLifeCycle
  (has-module? [runtime module]
    (boolean (get (deref (:modules runtime)) module)))
  (setup-module [runtime module]
    (setup-module! runtime module))
  (teardown-module [runtime module]
    (teardown-module! runtime module))
  (has-pointer? [runtime pointer]
    (boolean (get (deref (:pointers runtime)) pointer)))
  (setup-pointer [runtime pointer]
    (setup-pointer! runtime pointer))
  (teardown-pointer [runtime pointer]
    (teardown-pointer! runtime pointer)))

(def +init+
  (if-let [install-var (resolve 'lang.core.runtime/install-type!)]
    ((deref install-var)
     :postgres :db.client
     {:type :lang/rt.postgres.db-client
      :component true
      :config {:layout :module}
      :instance {:create rt-create}})
    {:runtime :db.client :installation :deferred}))
