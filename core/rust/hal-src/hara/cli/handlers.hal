(ns hara.cli.handlers
  (:require [code.manage.cli :as manage]
            [code.test.cli :as code-test]
            [hara.cli.asset :as asset]
            [hara.cli.extension :as extension]
            [hara.cli.identity :as identity]
            [hara.cli.language :as language]
            [hara.cli.package :as package]
            [hara.cli.project-command :as project-command]
            [hara.cli.snapshot :as snapshot]
            [hara.cli.spec :as spec]
            [hara.cli.tap :as tap]
            [lang.seedgen.cli :as seedgen]))

(def +registry+
  {:hara.cli.handler/eval language/eval-handler
   :hara.cli.handler/run-file language/run-file-handler
   :hara.cli.handler/project-run language/project-run-handler
   :hara.cli.handler/manage manage/handler
   :hara.cli.handler/project-test code-test/handler
   :hara.cli.handler/project-new project-command/handler
   :hara.cli.handler/project-check project-command/handler
   :hara.cli.handler/project-add project-command/handler
   :hara.cli.handler/project-remove project-command/handler
   :hara.cli.handler/project-sync project-command/handler
   :hara.cli.handler/project-update project-command/handler
   :hara.cli.handler/asset asset/handler
   :hara.cli.handler/extension extension/handler
   :hara.cli.handler/identity identity/handler
   :hara.cli.handler/package package/handler
   :hara.cli.handler/tap tap/handler
   :hara.cli.handler/snapshot snapshot/handler
   :hara.cli.handler/spec spec/handler
   :hara.cli.handler/seedgen seedgen/handler})

(defn registry
  ([] +registry+)
  ([overrides] (merge +registry+ overrides)))
