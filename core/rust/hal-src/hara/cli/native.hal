(ns hara.cli.native
  (:config {:blank true}))

(defn package-check [path]
  (std.native.Kernel/package-check path))

(defn package-build [path output]
  (std.native.Kernel/package-build path output))

(defn package-inspect [path]
  (std.native.Kernel/package-inspect path))

(defn package-install [path]
  (std.native.Kernel/package-install path))
