(ns hara.cli.native
  (:config {:blank true}))

(defn package-check [path]
  (std.native.Kernel/package-check path))

(defn package-build [path output]
  (std.native.Kernel/package-build path output))

(defn package-inspect [path]
  (std.native.Kernel/package-inspect path))

(defn package-install [path]
  (std.native.Kernel/package-install path))

(defn package-publish [path tap dry-run]
  (std.native.Kernel/package-publish path tap dry-run))

(defn package-registry-verify [request identity]
  (std.native.Kernel/package-registry-verify request identity))

(defn tap-config-root []
  (std.native.Kernel/tap-config-root))

(defn tap-add [root name registry identity identity-key]
  (std.native.Kernel/tap-add root name registry identity identity-key))

(defn tap-bootstrap [root profile]
  (std.native.Kernel/tap-bootstrap root profile))

(defn tap-remove [root name]
  (std.native.Kernel/tap-remove root name))

(defn tap-list [root]
  (std.native.Kernel/tap-list root))

(defn tap-mirror-add [root name registry identity]
  (std.native.Kernel/tap-mirror-add root name registry identity))

(defn tap-initialize [root name registry identity identity-root-key]
  (std.native.Kernel/tap-initialize
   root name registry identity identity-root-key))

(defn tap-verify [root name]
  (std.native.Kernel/tap-verify root name))

(defn snapshot-build [source output]
  (std.native.Kernel/snapshot-build source output))

(defn snapshot-verify [path base]
  (std.native.Kernel/snapshot-verify path base))

(defn snapshot-inspect [path]
  (std.native.Kernel/snapshot-inspect path))

(defn snapshot-diff [left right]
  (std.native.Kernel/snapshot-diff left right))
