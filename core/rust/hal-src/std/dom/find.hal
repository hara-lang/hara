(ns std.dom.find
  (:require [std.dom.common :as dom]))

(declare dom-find dom-find-all)

(defn dom-match? [node key match]
  (let [value (get (:props node) key)]
    (if (fn? match)
      (try (match value) (catch Throwable error false))
      (= match value))))

(defn dom-find-props [props key match]
  (letfn [(find-children [children]
            (loop [children children]
              (if (empty? children)
                nil
                (or (dom-find (first children) key match)
                    (recur (rest children))))))]
    (loop [entries (seq props)]
      (if (empty? entries)
        nil
        (let [value (second (first entries))
              result (cond (dom/dom? value) (dom-find value key match)
                           (and (vector? value) (dom/dom? (first value)))
                           (find-children value))]
          (or result (recur (rest entries))))))))

(defn dom-find [node key match]
  (cond (dom-match? node key match) node
        (:shadow node) (dom-find (:shadow node) key match)
        :else (dom-find-props (:props node) key match)))

(defn dom-find-all-props [props key match state]
  (reduce
   (fn [_ [prop-key value]]
     (cond (dom/dom? value) (dom-find-all value key match state)
           (and (vector? value) (dom/dom? (first value)))
           (reduce (fn [_ child] (dom-find-all child key match state)) nil value)))
   nil
   props))

(defn dom-find-all
  ([node key match] (dom-find-all node key match (atom [])))
  ([node key match state]
   (if (dom-match? node key match)
     (swap! state conj node))
   (if (:shadow node)
     (dom-find-all (:shadow node) key match state)
     (dom-find-all-props (:props node) key match state))
   @state))
