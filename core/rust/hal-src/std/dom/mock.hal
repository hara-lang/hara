(ns std.dom.mock
  (:require [std.dom.common :as dom]
            [std.dom.item :as item]
            [std.dom.type :as type]))

(defmutable MockElement [tag props])
(defstruct MockValue [tag props])

(defn mock? [value]
  (or (instance? MockElement value)
      (instance? MockValue value)))

(defn mock-format [mock]
  (letfn [(format-value [value]
            (if (mock? value) (mock-format value) value))]
    (let [tag (:tag mock)
          props (:props mock)
          {:keys [key children]} (dom/dom-children mock)
          children (map format-value children)
          props (map-vals (fn [value]
                            (if (sequential? value)
                              (mapv format-value value)
                              (format-value value)))
                          (dissoc props key))]
      (if (empty? props)
        (apply vector tag children)
        (apply vector tag props children)))))

(defn- mock-props-set! [mock props]
  (set! (field mock :props) props)
  mock)

(defn item-props-delete-mock [tag mock props]
  (if (empty? props)
    mock
    (mock-props-set! mock (apply dissoc (:props mock) (keys props)))))

(defmethod std.dom.item/item-props-delete :mock/element [tag mock props]
  (item-props-delete-mock tag mock props))

(defn item-props-set-mock [tag mock props]
  (mock-props-set! mock (merge (:props mock) props)))

(defmethod std.dom.item/item-props-set :mock/element [tag mock props]
  (item-props-set-mock tag mock props))

(defn item-set-list-mock [tag mock key values]
  (mock-props-set! mock (assoc (:props mock) key values)))

(defmethod std.dom.item/item-set-list :mock/element [tag mock key values]
  (item-set-list-mock tag mock key values))

(def +init+
  (do (type/metaclass-add :mock/element {:metatype :dom/element})
      (type/metaclass-add :mock/value {:metatype :dom/value})
      (type/metaprops-add :mock/element
                          {:tag :mock/label
                           :construct (fn [props] (MockElement :mock/label props))
                           :children {:key :text :single true}
                           :no-check true})
      (type/metaprops-add :mock/element
                          {:tag :mock/pane
                           :construct (fn [props] (MockElement :mock/pane props))
                           :no-check true})
      (type/metaprops-add :mock/value
                          {:tag :mock/insets
                           :construct (fn [props] (MockValue :mock/insets props))})))
