(ns std.block.parse
  (:require [std.block.construct :as construct]))

(defn source-char
  [source index]
  (if (or (< index 0) (>= index (str/length source)))
    nil
    (str/char-at source index)))

(defn source-position
  [source offset]
  (let [prefix (str/slice source 0 offset)
        normalized (str/replace (str/replace prefix "\r\n" "\n")
                                   "\r" "\n")
        lines (str/split normalized "\n")]
    {:offset offset
     :row (count lines)
     :col (inc (str/length (last lines)))}))

(defn with-range
  [block source start end]
  (let [start-position (source-position source start)
        end-position (source-position source end)]
    (assoc block :props
           (merge (:props block)
                  {:start-offset start
                   :end-offset end
                   :row (:row start-position)
                   :col (:col start-position)
                   :end-row (:row end-position)
                   :end-col (:col end-position)}))))

(defn whitespace?
  [character]
  (or (= character " ")
      (= character "\t")
      (= character "\n")
      (= character "\r")
      (= character "\f")
      (= character ",")))

(defn dispatch-character?
  [character]
  (or (= character "^")
      (= character "#")
      (= character "\\")
      (= character "(")
      (= character "[")
      (= character "{")
      (= character "}")
      (= character "]")
      (= character ")")
      (= character "~")
      (= character "'")
      (= character "`")
      (= character ";")
      (= character "@")
      (= character "\"")
      (= character ":")))

(defn boundary?
  [character]
  (or (nil? character)
      (whitespace? character)
      (dispatch-character? character)))

(defn closing-delimiter?
  [character]
  (or (= character ")")
      (= character "]")
      (= character "}")))

(defn scan-token-end
  [source index]
  (loop [current index]
    (if (boundary? (source-char source current))
      current
      (recur (inc current)))))

(defn scan-comment-end
  [source index]
  (loop [current index]
    (let [character (source-char source current)]
      (if (or (nil? character)
              (= character "\n")
              (= character "\r"))
        current
        (recur (inc current))))))

(defn scan-string-end
  [source index escaped]
  (loop [current index escaping escaped]
    (let [character (source-char source current)]
      (if (nil? character)
        (throw "EOF while reading string")
        (if escaping
          (recur (inc current) false)
          (if (= character "\\")
            (recur (inc current) true)
            (if (= character "\"")
              (inc current)
              (recur (inc current) false))))))))

(defn token-block
  [text]
  (construct/token-from-string
   text
   (try
     (edn/read text)
     (catch Throwable error text))))

(defn parse-children
  [source index expected children parser]
  (loop [current index output children]
    (let [character (source-char source current)]
      (if (nil? character)
        (throw (str "EOF while reading collection, expected " expected))
        (if (= character expected)
          [output current]
          (if (closing-delimiter? character)
            (throw (str "Mismatched delimiter: expected "
                        expected " but found " character))
            (let [[child next-index] (parser source current)]
              (recur next-index (conj output child)))))))))

(defn parse-container
  [source index tag expected parser]
  (let [[children end-index] (parse-children source index expected [] parser)]
    [(construct/container tag children) (inc end-index)]))

(defn parse-prefix
  [source index tag prefix-length parser]
  (let [child-index (+ index prefix-length)]
    (if (nil? (source-char source child-index))
      (throw (str "EOF while reading " tag))
      (let [[child next-index] (parser source child-index)]
        [(construct/container tag [child]) next-index]))))

(defn parse-hash
  [source index parser]
  (let [next (source-char source (inc index))]
    (if (= next "{")
      (parse-container source (+ index 2) :set "}" parser)
      (if (= next "(")
        (parse-container source (+ index 2) :fn ")" parser)
        (if (= next "'")
          (parse-prefix source index :var 2 parser)
          (if (= next "_")
            [(construct/uneval) (+ index 2)]
            (if (= next "|")
              [(construct/cursor) (+ index 2)]
              (if (= next "?")
                (if (= "@" (source-char source (+ index 2)))
                  (if (= "(" (source-char source (+ index 3)))
                    (parse-container source (+ index 4)
                                     :select-splice ")" parser)
                    (throw "Reader conditional splice requires a list"))
                  (if (= "(" (source-char source (+ index 2)))
                    (parse-container source (+ index 3)
                                     :select ")" parser)
                    (throw "Reader conditional requires a list")))
                (throw (str "Unsupported hash dispatch: " next))))))))))

(declare parse-at)

(defn parse-at-raw
  [source index]
  (let [character (source-char source index)]
    (if (nil? character)
      (throw "Cannot parse past end of source")
      (if (= character " ")
        [(construct/space) (inc index)]
        (if (= character "\t")
          [(construct/tab) (inc index)]
          (if (or (= character "\n") (= character "\r") (= character "\f"))
            [(construct/void :linebreak character) (inc index)]
            (if (= character ",")
              [(construct/void :space character) (inc index)]
              (if (= character ";")
                (let [end (scan-comment-end source index)]
                  [(construct/comment (str/slice source index end)) end])
                (if (= character "\"")
                  (let [end (scan-string-end source (inc index) false)
                        text (str/slice source index end)]
                    [(token-block text) end])
                  (if (= character ":")
                    (let [end (scan-token-end source (inc index))
                          text (str/slice source index end)]
                      [(token-block text) end])
                    (if (= character "\\")
                      (let [end (scan-token-end source (inc index))
                            text (str/slice source index end)]
                        [(token-block text) end])
                      (if (= character "(")
                        (parse-container source (inc index) :list ")" parse-at)
                        (if (= character "[")
                          (parse-container source (inc index) :vector "]" parse-at)
                          (if (= character "{")
                            (parse-container source (inc index) :map "}" parse-at)
                            (if (= character "^")
                              (parse-prefix source index :meta 1 parse-at)
                              (if (= character "'")
                                (parse-prefix source index :quote 1 parse-at)
                                (if (= character "`")
                                  (parse-prefix source index :syntax 1 parse-at)
                                  (if (= character "@")
                                    (parse-prefix source index :deref 1 parse-at)
                                    (if (= character "~")
                                      (if (= "@" (source-char source (inc index)))
                                        (parse-prefix source index :unquote-splice 2 parse-at)
                                        (parse-prefix source index :unquote 1 parse-at))
                                      (if (= character "#")
                                        (parse-hash source index parse-at)
                                        (if (closing-delimiter? character)
                                          (throw (str "Unmatched delimiter: " character))
                                          (let [end (scan-token-end source index)
                                                text (str/slice source index end)]
                                            [(token-block text) end]))))))))))))))))))))))

(defn parse-at
  [source index]
  (let [[block end] (parse-at-raw source index)]
    [(with-range block source index end) end]))

(defn parse-root-children
  [source index children]
  (loop [current index output children]
    (if (= current (str/length source))
      output
      (let [[child next-index] (parse-at source current)]
        (recur next-index (conj output child))))))

(defn parse-root
  [source]
  (with-range
   (construct/root (parse-root-children source 0 []) source)
   source 0 (str/length source)))

(defn recovery-end
  [source start]
  (let [first-character (source-char source start)]
    (if (closing-delimiter? first-character)
      (inc start)
      (loop [index (inc start)]
        (let [character (source-char source index)]
          (if (or (nil? character) (= character "\n") (= character "\r"))
            index
            (recur (inc index))))))))

(defn parse-root-recovering
  [source]
  (loop [index 0 children [] diagnostics []]
    (if (= index (str/length source))
      {:block (with-range (construct/root children source)
                          source 0 (str/length source))
       :diagnostics diagnostics}
      (try
        (let [[child next-index] (parse-at source index)]
          (recur next-index (conj children child) diagnostics))
        (catch Throwable error
          (let [end (recovery-end source index)
                message (or (ex-message error) (str error))
                block (with-range
                       (construct/error (str/slice source index end) message)
                       source index end)
                finding {:type :tool.lint/reader-error
                         :level :error
                         :message message
                         :row (:row (:props block))
                         :col (:col (:props block))
                         :end-row (:end-row (:props block))
                         :end-col (:end-col (:props block))
                         :start-offset index
                         :end-offset end}]
            (recur end
                   (conj children block)
                   (conj diagnostics finding))))))))

(defn attach-file
  [block file]
  (let [children (:children block)]
    (assoc (assoc block :children
                  (vec (map (fn [child] (attach-file child file)) children)))
           :props
           (assoc (:props block) :file file))))

(defn parse-source
  ([source] (parse-source source {}))
  ([source options]
   (let [result (parse-root-recovering source)
         file (or (:file options) "<memory>")]
     {:block (attach-file (:block result) file)
      :diagnostics
      (vec (map (fn [finding] (assoc finding :file file))
                (:diagnostics result)))})))

(defn parse-string
  [source]
  (parse-root source))

(defn parse-first
  [source]
  (let [[block next-index] (parse-at source 0)]
    block))
