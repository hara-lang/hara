;; ============================================================================
;; std.lib.component — compatibility facade for std.foundation.component.
;;
;; Canonical component lifecycle behavior now lives in
;; std.foundation.component. This namespace is retained only while callers move
;; to the canonical Foundation-owned surface tracked by issue #501.
;; ============================================================================
(ns std.lib.component
  (:require [std.foundation.component :as component]))

(def props component/props)
(def status component/status)
(def started? component/started?)
(def stopped? component/stopped?)
(def remote? component/remote?)
(def wrap-start component/wrap-start)
(def wrap-stop component/wrap-stop)
(def start component/start)
(def stop component/stop)
(def kill component/kill)
(def all-props component/all-props)
(def get-prop component/get-prop)
(def set-prop component/set-prop)

(defmacro with-component
  "Compatibility wrapper for std.foundation.component/with-component."
  [binding & body]
  `(let [component# (std.foundation.component/start ~(second binding))]
     (try
       (let [~(first binding) component#] ~@body)
       (finally (std.foundation.component/stop component#)))))
