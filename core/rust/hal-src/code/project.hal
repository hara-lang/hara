;; Project coordinates shared by host-side code tooling. This namespace is
;; intentionally data-only: native hosts discover files and pass a descriptor
;; and index here, keeping source navigation portable across HAL targets.
(ns code.project
  (:require [std.foundation.string :as string]))

(def default-project
  {:root "."
   :source-paths ["src"]
   :test-paths ["test"]
   :extension ".hal"
   :test-suffix "-test"})

(defn project-options
  "Applies portable project defaults without discarding host-specific keys."
  [project]
  (merge default-project project))

(defn join-path
  [parts]
  (string/join "/" (filter (fn [part] (not (string/blank? (str part)))) parts)))

(defn namespace-path
  [namespace]
  (string/replace (string/replace (str namespace) "." "/") "-" "_"))

(defn path-namespace
  "Converts a source-relative HAL path into its namespace convention."
  [path]
  (let [without-extension (if (string/ends-with? path ".hal")
                            (string/slice path 0 (- (string/length path) 4))
                            path)]
    (symbol (string/replace (string/replace without-extension "/" ".") "_" "-"))))

(defn sym-name
  [namespace]
  (str namespace))

(defn test-suffix
  [project]
  (:test-suffix (project-options project)))

(defn source-namespace
  [project namespace]
  (let [value (sym-name namespace)
        suffix (test-suffix project)]
    (if (string/ends-with? value suffix)
      (symbol (string/slice value 0 (- (string/length value) (string/length suffix))))
      (symbol value))))

(defn test-namespace
  [project namespace]
  (let [value (sym-name namespace)
        suffix (test-suffix project)]
    (if (string/ends-with? value suffix)
      (symbol value)
      (symbol (str value suffix)))))

(defn file-suffix
  [project namespace]
  (str (namespace-path (source-namespace project namespace))
       (:extension (project-options project))))

(defn test-file-suffix
  [project namespace]
  (str (namespace-path (source-namespace project namespace))
       "_test"
       (:extension (project-options project))))

(defn source-candidates
  [project namespace]
  (let [options (project-options project)]
    (vec (map (fn [root]
                (join-path [(:root options) root (file-suffix options namespace)]))
              (:source-paths options)))))

(defn test-candidates
  [project namespace]
  (let [options (project-options project)]
    (vec (map (fn [root]
                (join-path [(:root options) root (test-file-suffix options namespace)]))
              (:test-paths options)))))

(defn source-path
  [project namespace]
  (first (source-candidates project namespace)))

(defn test-path
  [project namespace]
  (first (test-candidates project namespace)))

(defn file-type
  [project path]
  (let [options (project-options project)
        source-root (first (:source-paths options))
        test-root (first (:test-paths options))]
    (cond (string/includes? path (str "/" test-root "/")) :test
          (string/includes? path (str "/" source-root "/")) :source
          (string/ends-with? path "_test.hal") :test
          :else :source)))

(defn index-entry
  "Normalises either a path string or a host-supplied source record."
  [path entry]
  (merge {:path path
          :namespace (path-namespace path)}
         (if (map? entry) entry {:source entry})))

(defn project-index
  "Builds an index keyed by path and namespace from host-discovered sources.
   Input entries may be strings or maps containing at least :path."
  [project entries]
  (let [options (project-options project)
        files (vec (map (fn [entry]
                          (if (string? entry)
                            (index-entry entry nil)
                            (index-entry (:path entry) entry)))
                        entries))]
    {:project options
     :paths (reduce (fn [out entry] (assoc out (:path entry) entry)) {} files)
     :namespaces (reduce (fn [out entry]
                           (assoc out (:namespace entry) entry))
                         {}
                         files)}))

(defn lookup-path
  [index path]
  (get (:paths index) path))

(defn lookup-namespace
  [index namespace]
  (get (:namespaces index) (symbol (str namespace))))

(defn file-lookup
  "Returns the indexed source/test entry for namespace and type."
  [index namespace type]
  (let [project (:project index)
        candidates (if (= type :test)
                     (test-candidates project namespace)
                     (source-candidates project namespace))]
    (first (filter identity (map (fn [path] (lookup-path index path)) candidates)))))

(defn code-path
  "Returns the discovered path, falling back to the canonical project path."
  [index namespace type]
  (let [entry (file-lookup index namespace type)
        project (:project index)]
    (if entry
      (:path entry)
      (if (= type :test)
        (test-path project namespace)
        (source-path project namespace)))))

(defn test-root
  [project]
  (let [options (project-options project)]
    (join-path [(:root options) (first (:test-paths options))])))
