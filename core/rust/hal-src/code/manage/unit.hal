(ns code.manage.unit
  (:require [code.framework :as framework]
            [code.manage.unit.scaffold :as scaffold]))

(defn analyse
  [unit]
  (merge {:path (:path unit)}
         (framework/analyse-source (:source unit))))

(defn extract
  [unit]
  (:definitions (analyse unit)))

(defn vars
  [unit]
  (vec
   (map
    (fn [entry]
      (:source entry))
    (extract unit))))

(defn docstrings
  [unit]
  (:docstrings (analyse unit)))

(defn transform-function
  [transform-or-options]
  (cond
    (fn? transform-or-options)
    transform-or-options

    (map? transform-or-options)
    (or (:transform transform-or-options) identity)

    (nil? transform-or-options)
    identity

    :else
    (throw
     (ex-info "code.manage transform must be a function or options map"
              {:transform transform-or-options}))))

(defn transform-code
  [unit transform-or-options]
  (let [before (:source unit)
        transform (transform-function transform-or-options)
        after (transform before)]
    {:path (:path unit)
     :changed (not= before after)
     :before before
     :after after
     :write false}))

(defn grep
  [unit needle-or-options]
  (let [needle
        (if (map? needle-or-options)
          (:needle needle-or-options)
          needle-or-options)]
    (if needle
      (framework/grep-source (:source unit) needle)
      [])))

(defn grep-replace
  ([unit options]
   (if (:match options)
     (grep-replace unit
                   (:match options)
                   (or (:replacement options) ""))
     (transform-code unit identity)))
  ([unit match replacement]
   (transform-code
    unit
    (fn [source]
      (str/replace source match replacement)))))

(defn heal-code
  [unit]
  (transform-code
   unit
   (fn [source]
     (str (str/trim-right source) "\n"))))

(defn unclean
  [unit]
  (if (= (:source unit) (:after (heal-code unit)))
    []
    [(:path unit)]))

(defn incomplete
  [unit]
  (grep unit "TODO"))

(defn commented
  "Returns comment-only lines so callers can decide whether to remove them."
  [unit]
  (vec
   (filter
    (fn [entry]
      (str/starts-with? (str/trim (:text entry)) ";"))
    (framework/grep-source (:source unit) ";"))))

(defn unclean-findings
  "Reports normalisation issues without modifying the source."
  [unit]
  (let [lines (str/split-lines (:source unit))
        trailing
        (loop [index 0 output []]
          (if (= index (count lines))
            output
            (let [line (nth lines index)]
              (recur
               (inc index)
               (if (not= line (str/trim-right line))
                 (conj output
                       {:path (:path unit)
                        :line (inc index)
                        :kind :trailing-whitespace})
                 output)))))]
    (if (str/ends-with? (:source unit) "\n")
      trailing
      (conj trailing
            {:path (:path unit)
             :kind :missing-final-newline}))))

(defn definition-names
  [unit]
  (vec
   (map
    (fn [entry]
      (:name entry))
    (extract unit))))

(defn public-definition-names
  [unit]
  (vec
   (map
    (fn [entry]
      (:name entry))
    (filter
     (fn [entry]
       (not= :private-function (:kind entry)))
     (extract unit)))))

(defn in-order?
  [unit]
  (let [names (definition-names unit)]
    (= names (vec (sort names)))))

(defn orphaned-meta
  [unit]
  (let [lines (str/split-lines (:source unit))]
    (loop [index 0 output []]
      (if (= index (count lines))
        output
        (let [line (str/trim (nth lines index))
              next-line
              (if (< (inc index) (count lines))
                (str/trim (nth lines (inc index)))
                "")]
          (recur
           (inc index)
           (if (and (str/starts-with? line "^")
                    (not (str/starts-with? next-line "(def")))
             (conj output
                   {:path (:path unit)
                    :line (inc index)
                    :kind :orphaned-metadata})
             output)))))))

(defn orphaned
  [unit]
  (orphaned-meta unit))

(defn todos
  [unit]
  (incomplete unit))

(defn unchecked
  [unit]
  (let [facts (grep unit "(fact")
        checks (grep unit "=>")]
    (if (and (not (empty? facts))
             (empty? checks))
      (vec
       (map
        (fn [entry]
          (assoc entry :kind :unchecked-fact))
        facts))
      [])))

(defn pedantic
  [unit]
  (vec
   (concat
    (unclean-findings unit)
    (map
     (fn [entry]
       (assoc entry :kind :todo))
     (incomplete unit))
    (orphaned-meta unit)
    (unchecked unit))))

(defn missing
  [unit options]
  (let [available (or (:available-namespaces options) #{})]
    (vec
     (filter
      (fn [namespace]
        (nil? (get available namespace)))
      (or (:requires unit) [])))))

(defn includes-any?
  [line patterns]
  (loop [remaining patterns]
    (if (empty? remaining)
      false
      (if (str/includes? line (first remaining))
        true
        (recur (rest remaining))))))

(defn remove-matching-lines
  [source patterns]
  (str
   (str/join
    "\n"
    (filter
     (fn [line]
       (not (includes-any? line patterns)))
     (str/split-lines source)))
   "\n"))

(defn purge
  [unit options]
  (transform-code
   unit
   (fn [source]
     (remove-matching-lines
      source
      (or (:patterns options) [])))))

(defn replacements
  [options]
  (or (:replacements options)
      (if (and (:match options)
               (:replacement options))
        [[(:match options)
          (:replacement options)]]
        [])))

(defn replace-all
  [source pairs]
  (reduce
   (fn [output pair]
     (str/replace output
                  (str (first pair))
                  (str (second pair))))
   source
   pairs))

(defn refactor-code
  [unit options]
  (transform-code
   unit
   (fn [source]
     (replace-all source
                  (replacements options)))))

(defn refactor-test
  [unit options]
  (refactor-code unit options))

(defn refactor-swap
  [unit pairs]
  (refactor-code unit
                 {:replacements pairs}))

(defn arrange
  [unit]
  (if (in-order? unit)
    (transform-code unit identity)
    (assoc
     (transform-code unit identity)
     :finding
     {:path (:path unit)
      :kind :definitions-out-of-order
      :definitions (definition-names unit)})))

(defn scaffold
  [unit options]
  (let [source-namespace (:namespace (analyse unit))
        test-namespace
        (scaffold/test-namespace-for
         unit
         options
         source-namespace)
        alias (or (:alias options) "subject")
        definitions (public-definition-names unit)
        before (or (:test-source unit) "")
        scaffold-options
        (merge
         {:version (:version unit)}
         (or options {}))
        after
        (scaffold/scaffold-source
         source-namespace
         test-namespace
         alias
         definitions
         scaffold-options)]
    {:path (scaffold/test-path-for unit options)
     :changed (not= before after)
     :before before
     :after after
     :functions definitions
     :new definitions
     :write false
     :create (empty? before)}))

(defn create-tests
  [unit options]
  (scaffold unit options))

(defn locate-code
  [unit]
  (if (= (:type unit) :test)
    nil
    (:path unit)))

(defn locate-test
  [unit]
  (if (= (:type unit) :test)
    (:path unit)
    (:test-path unit)))
