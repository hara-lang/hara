(ns code.manage.unit.factcheck
  (:require [code.manage.unit :as unit]
            [code.manage.unit.import :as unit-import]
            [code.manage.unit.template :as template]))

(defn factcheck-remove
  [code-unit options]
  (unit/purge
   code-unit
   {:patterns [(or (:marker options) "#fact")]}))

(defn factcheck-generate
  [code-unit options]
  (unit-import/import-unit
   code-unit
   {:form (or (:form options)
              "#fact {:type :core}")}))

(def factcheck-remove-unit
  (template/code-tasklet
   :factcheck-remove
   (fn [code-unit options]
     (factcheck-remove code-unit options))))

(def factcheck-generate-unit
  (template/code-tasklet
   :factcheck-generate
   (fn [code-unit options]
     (factcheck-generate code-unit options))))
