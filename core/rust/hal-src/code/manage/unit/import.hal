(ns code.manage.unit.import
  (:config {:blank true})
  (:require [std.foundation :refer :all :exclude [import]]
            [code.manage.unit :as unit]))

(defn import
  [code-unit options]
  (let [form (:form options)]
    (if (or (nil? form)
            (str/blank? (str form)))
      (unit/transform-code code-unit identity)
      (unit/transform-code
       code-unit
       (fn [source]
         (str
          (str/trim-right source)
          "\n"
          form
          "\n"))))))
