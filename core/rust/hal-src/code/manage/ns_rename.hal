(ns code.manage.ns-rename
  (:require [code.manage.unit :as unit]
            [code.manage.unit.template :as template]))

(defn ns-rename
  [code-unit options]
  (let [old (:from options)
        new (:to options)]
    (if (or (nil? old)
            (nil? new))
      (unit/transform-code code-unit identity)
      (unit/grep-replace code-unit
                         (str old)
                         (str new)))))

(def ns-rename-unit
  (template/code-tasklet
   :ns-rename
   (fn [code-unit options]
     (ns-rename code-unit options))))
