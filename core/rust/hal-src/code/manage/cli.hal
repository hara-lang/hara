(ns code.manage.cli
  (:require [code.manage :as manage]
            [tool.cli.model :as model]
            [tool.project :as project]
            [std.work :as work]))

(def +value-options+
  {"--match" :match "--replacement" :replacement
   "--from" :from "--to" :to "--needle" :needle
   "--form" :form "--var" :var "--corpus" :corpus})

(def +test-only+
  #{:refactor-test :isolate :factcheck-remove :factcheck-generate :unchecked})

(def +source-and-test+
  #{:ns-rename :find-usages :grep :grep-replace})

(defn tail [values] (vec (rest values)))

(defn required [remaining option]
  (if (empty? remaining)
    (throw (ex-info (str option " requires a value") {:option option}))
    (first remaining)))

(defn parse-arguments [arguments]
  (let [operation (keyword (or (first arguments) "analyse"))]
    (if (nil? (get manage/parity-inventory operation))
      (throw (ex-info (str "unsupported manage operation " operation)
                      {:operation operation}))
      (loop [remaining (tail arguments)
             write false
             namespaces []
             patterns []
             options {}]
        (if (empty? remaining)
          {:operation operation
           :write write
           :namespaces namespaces
           :options (if (empty? patterns)
                      options
                      (assoc options :patterns patterns))}
          (let [argument (first remaining)
                more (tail remaining)
                option-key (get +value-options+ argument)]
            (cond
              (= argument "--write")
              (recur more true namespaces patterns options)
              (= argument "--pattern")
              (recur (tail more) write namespaces
                     (conj patterns (required more argument)) options)
              option-key
              (recur (tail more) write namespaces patterns
                     (assoc options option-key (required more argument)))
              (str/starts-with? argument "-")
              (throw (ex-info (str "unknown manage option " argument)
                              {:option argument}))
              :else
              (recur more write (conj namespaces argument) patterns options))))))))

(defn selected? [path namespaces]
  (or (empty? namespaces)
      (not
       (empty?
        (filter
         (fn [namespace]
           (str/includes?
            path
            (str/replace
             (str/replace namespace "." "/") "-" "_")))
         namespaces)))))

(defn roots-for [project operation]
  (cond
    (has? +test-only+ operation) (:project/test-paths project)
    (has? +source-and-test+ operation)
    (vec (concat (:project/source-paths project) (:project/test-paths project)))
    :else (:project/source-paths project)))

(defn unit [path type]
  {:path path
   :type type
   :source (project/read-text path)})

(defn translation-field [value keyword-key string-key]
  (if (map? value)
    (if (has? value keyword-key)
      (get value keyword-key)
      (get value string-key))
    nil))

(defn translation-entry [entries path]
  (first
   (filter
    (fn [entry]
      (str/ends-with?
       path
       (translation-field entry :source_path "source_path")))
    entries)))

(defn translation-selected? [entry namespaces]
  (if entry
    (let [entry-namespace (translation-field entry :namespace "namespace")
          recipe (translation-field entry :recipe "recipe")
          aggregate (= "aggregate"
                       (translation-field recipe :mode "mode"))]
      (if (or (empty? namespaces)
              (not
               (empty?
                (filter
                 (fn [namespace]
                   (or (= namespace entry-namespace)
                       (and aggregate
                            (str/starts-with?
                             entry-namespace
                             (str namespace ".")))))
                 namespaces))))
      true
      false))
    false))

(defn translation-project-path [project-root path]
  (let [direct (file/join project-root path)]
    (if (deref (file/exists? direct))
      direct
      (if (str/starts-with? path "core/")
        (file/join project-root (str/slice path 5 (count path)))
        direct))))

(defn translation-project [target-root]
  (let [direct (file/join target-root "project.edn")
        nested-root (file/join target-root "core")
        nested (file/join nested-root "project.edn")]
    (cond
      (deref (file/exists? direct)) {:project/root target-root}
      (deref (file/exists? nested)) {:project/root nested-root}
      :else (throw (ex-info "clojure-to-hal --to must name a Hara repository or project"
                            {:target/root target-root})))))

(defn translation-read-text [path]
  (try
    (project/read-text path)
    (catch Throwable error
      (throw (ex-info (str "Cannot read translation input " path)
                      {:path path :cause (ex-message error)})))))

(defn translation-target-path [target-root entry source-root source-path]
  (let [targets (translation-field entry :targets "targets")
        target (first targets)
        routed (if target (translation-field target :path "path") nil)
        routed (if (and routed
                        (str/ends-with? target-root "/core")
                        (str/starts-with? routed "core/"))
                 (str/slice routed 5 (count routed))
                 routed)
        relative (str/slice source-path (count source-root) (count source-path))
        test-source (str/starts-with? relative "/test/")
        target-prefix (if test-source "core/lib/test" "core/lib/src")
        source-offset (if test-source 5 4)
        fallback (str target-prefix
                      (str/slice relative source-offset (- (count relative) 4))
                      ".hal")]
    (file/join target-root (or routed fallback))))

(defn dedupe-translation-units [units]
  (:units
   (reduce
    (fn [output unit]
      (let [path (:target/path unit)]
        (if (has? (:seen output) path)
          {:seen (:seen output)
           :units
           (vec
            (map
             (fn [existing]
               (if (= path (:target/path existing))
                 (assoc existing
                        :recipe/sources
                        (conj (:recipe/sources existing) (:source/path unit)))
                 existing))
             (:units output)))}
          {:seen (assoc (:seen output) path true)
           :units (conj (:units output)
                        (assoc unit :recipe/sources [(:source/path unit)]))})))
    {:seen {} :units []}
    units)))

(defn translation-routed-path [target-root path]
  (let [routed (if (and path
                         (str/ends-with? target-root "/core")
                         (str/starts-with? path "core/"))
                 (str/slice path 5 (count path))
                 path)]
    (file/join target-root routed)))

(defn translation-recipe-output [current-project recipe-path]
  (translation-read-text
   (translation-project-path (:project/root current-project) recipe-path)))

(defn translation-managed-units [current-project source-root target-root unit]
  (let [entry (:corpus/entry unit)
        recipe (:translation/recipe unit)
        mirrors (or (translation-field entry :mirrors "mirrors") [])
        mirror-units
        (vec
         (map
          (fn [path]
            (let [target-path (translation-routed-path target-root path)]
              (assoc unit
                     :target/path target-path
                     :target/text
                     (if (deref (file/exists? target-path))
                       (translation-read-text target-path)
                       nil)
                     :translation/role :mirror)))
          mirrors))
        test-route (translation-field entry :test_route "test_route")
        test-unit
        (if test-route
          (let [source-path
                (file/join source-root
                           (translation-field test-route :source_path "source_path"))
                target-path
                (translation-routed-path
                 target-root
                 (translation-field test-route :target_path "target_path"))
                recipe-path
                (translation-field test-route :recipe_path "recipe_path")
                source (translation-read-text source-path)]
            {:source/path source-path
             :source/root source-root
             :source/text source
             :source/sha256 (str "sha256:" (std.native.Crypto/sha256
                                              (str/encode-utf8 source)))
             :target/root target-root
             :target/path target-path
             :target/text (if (deref (file/exists? target-path))
                            (translation-read-text target-path)
                            nil)
             :corpus/entry entry
             :translation/role :test
             :translation/recipe
             {:id (str (translation-field recipe :id "id") "/test")
              :output (translation-recipe-output current-project recipe-path)}
             :translation/options {:mode :review}})
          nil)]
    (vec (concat [unit] mirror-units (if test-unit [test-unit] [])))))

(defn translation-units-for [current-project parsed]
  (let [options (:options parsed)
        source-root (or (:from options)
                        (throw (ex-info "clojure-to-hal requires --from" {})))
        target-root (or (:to options)
                        (throw (ex-info "clojure-to-hal requires --to" {})))
        corpus-path (or (:corpus options)
                        (translation-project-path
                         (:project/root current-project)
                         "core/spec/clj-hal-corpus.json"))
        corpus (std.native.Json/read (translation-read-text corpus-path))
        entries (translation-field corpus :namespaces "namespaces")
        selected-entries
        (filter (fn [entry]
                  (translation-selected? entry (:namespaces parsed)))
                entries)
        paths (vec
               (map
                (fn [entry]
                  (file/join
                   source-root
                   (translation-field entry :source_path "source_path")))
                selected-entries))]
    (let [canonical
          (vec
           (keep
      (fn [path]
        (let [entry (translation-entry entries path)]
          (if (and (str/ends-with? path ".clj")
                   (translation-selected? entry (:namespaces parsed)))
          (let [source (translation-read-text path)
                target-path (translation-target-path target-root entry source-root path)
                recipe (translation-field entry :recipe "recipe")
                template-path (if recipe
                                (translation-field recipe :template_path "template_path")
                                nil)
                template-source (if template-path
                                  (translation-read-text
                                   (translation-project-path
                                    (:project/root current-project)
                                    template-path))
                                  nil)
                template-namespace (if recipe
                                     (translation-field recipe :template_namespace "template_namespace")
                                     nil)
                target-namespace (if recipe
                                   (translation-field recipe :target_namespace "target_namespace")
                                   nil)
                template (if (and template-source template-namespace target-namespace)
                           (str/replace-first template-source template-namespace target-namespace)
                           template-source)]
            {:source/path path
             :source/root source-root
             :source/text source
             :source/sha256 (str "sha256:" (std.native.Crypto/sha256
                                              (str/encode-utf8 source)))
             :target/root target-root
             :target/path target-path
             :target/text (if (deref (file/exists? target-path))
                            (translation-read-text target-path)
                            nil)
             :corpus/entry entry
             :translation/recipe
             (if recipe
               {:id (translation-field recipe :id "id")
                :output template}
               nil)
             :translation/options {:mode :review}})
          nil)))
            paths))]
      (dedupe-translation-units
       (vec
        (mapcat
         (fn [unit]
           (translation-managed-units
            current-project source-root target-root unit))
         canonical))))))

(defn units-for [project parsed]
  (if (= :clojure-to-hal (:operation parsed))
    (translation-units-for project parsed)
    (let [test-roots (:project/test-paths project)
        paths (project/files-in project
                                (roots-for project (:operation parsed))
                                ".hal")]
    (reduce
     (fn [output path]
       (if (selected? path (:namespaces parsed))
         (conj output
               (unit path
                     (if (not
                          (empty?
                           (filter (fn [root]
                                     (str/includes?
                                      path
                                      (file/join (:project/root project) root)))
                                   test-roots)))
                       :test
                       :source)))
         output))
     []
     paths))))

(defn current-source [path]
  (if (deref (file/exists? path)) (project/read-text path) ""))

(defn preflight! [edits]
  (loop [remaining edits]
    (if (empty? remaining)
      edits
      (let [edit (first remaining)]
        (if (= (:before edit) (current-source (:path edit)))
          (recur (tail remaining))
          (throw (ex-info (str "code.manage stale edit: " (:path edit))
                          {:path (:path edit)})))))))

(defn apply-edits! [edits]
  (preflight! edits)
  (loop [remaining edits]
    (if (empty? remaining)
      edits
      (let [edit (first remaining)
            path (:path edit)
            parent (file/parent path)]
        (if parent (deref (file/mkdir parent)) nil)
        (deref (file/write path (str/encode-utf8 (:after edit))))
        (recur (tail remaining))))))

(defn execute [request]
  (let [parsed (parse-arguments (:request/arguments request))
        start (or (:project (:request/options request))
                  (:root (:request/options request))
                  (:request/cwd request)
                  (os/cwd))
        current-project (if (= :clojure-to-hal (:operation parsed))
                          (translation-project (get-in parsed [:options :to]))
                          (project/discover start))
        plan (manage/plan (:operation parsed)
                          {:units (units-for current-project parsed)
                           :options (:options parsed)})]
    (if (:write parsed) (apply-edits! (:edits plan)) nil)
    (model/success plan [(model/message (str (pr-str plan) "\n"))])))

(def +command-work+
  (work/step
   {:id 'code.manage/cli :version 1}
   (fn [request context] (execute request))))

(defn handler [request]
  (work/run (work/local-runtime) +command-work+ request))
