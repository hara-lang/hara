(ns code.manage.var
  (:require [code.manage.unit :as unit]
            [code.manage.unit.template :as template]))

(defn find-usages
  [code-unit options]
  (if (:var options)
    (unit/grep code-unit (str (:var options)))
    []))

(def find-usages-unit
  (template/code-tasklet
   :find-usages
   (fn [code-unit options]
     (find-usages code-unit options))))
