(ns code.test.base.print
  (:require [std.foundation.string :as string]))

(defn format-diff-map [value]
  (string/join "\n"
               [(str "  missing: " (pr-str (:left-only value)))
                (str "  unexpected: " (pr-str (:right-only value)))]))

(defn format-diff-seq [value]
  (str "  expected: " (pr-str (:left value))
       "\n  actual: " (pr-str (:right value))))

(defn format-diff [value]
  (if (and (map? value)
           (or (:left-only value) (:right-only value)))
    (format-diff-map value)
    (if (and (map? value) (has? value :left) (has? value :right))
      (format-diff-seq value)
      (str value))))

(defn format-result
  [title value]
  (string/join "\n"
               [(str title (if (:name value) (str " " (:name value)) ""))
                (if (:path value) (str "  path: " (:path value)) "")
                (if (:line value) (str "  line: " (:line value)) "")
                (if (:error value) (str "  error: " (:error value)) "")
                (if (has? value :expected) (str "  expected: " (pr-str (:expected value))) "")
                (if (has? value :actual) (str "  actual: " (pr-str (:actual value))) "")]))

(defn format-summary
  "Renders the stable cross-host summary shape without terminal colour."
  [summary]
  (string/join "\n"
               [(str "Summary (" (:files summary) " files)")
                (str "  facts: " (:facts summary))
                (str "  checks: " (:checks summary))
                (str "  passed: " (:passed summary))
                (str "  failed: " (:failed summary))
                (str "  thrown: " (:throw summary))
                (str "  timeout: " (:timeout summary))]))

(defn print-preliminary [value] (let [output (format-result "TEST" value)] (println output) output))
(defn print-success [value] (let [output (format-result "SUCCESS" value)] (println output) output))
(defn print-on-error [value] (let [output (format-result "ON ERROR" value)] (println output) output))
(defn print-throw [value] (let [output (format-result "THROW" value)] (println output) output))
(defn print-timeout [value] (let [output (format-result "TIMEOUT" value)] (println output) output))
(defn print-failed [value] (let [output (format-result "FAILED" value)] (println output) output))
(defn print-fact [value] (let [output (format-result "FACT" value)] (println output) output))
(defn print-summary [value]
  (let [output (format-summary value)]
    (println output)
    output))
