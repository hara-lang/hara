;; ============================================================================
;; code.test.protocol — compatibility aliases for the platform matcher.
;;
;; `std.protocol.imatch` is a reserved evaluator-owned namespace. Its protocol
;; identity is installed by the runtime, so this compatibility namespace must
;; not require a file-backed platform source.
;; ============================================================================
(ns code.test.protocol)

(def IMatch std.protocol.imatch/IMatch)
(def match-value std.protocol.imatch/match-value)
