(ns code.deploy.runtime)

(defn- start-process
  [argv options]
  (if (empty? options)
    (Process/spawn argv)
    (Process/spawn argv options)))

(defn run
  "Runs one argv vector through the capability-gated process boundary.

   The command is never interpreted by a shell. The returned map is ordinary
   HAL data so code.deploy tasks can report, aggregate, and test it."
  ([argv]
   (run argv {}))
  ([argv options]
   (let [process (start-process argv options)
         values (deref
                 (promise/all
                  [(Process/stdout process)
                   (Process/stderr process)
                   (Process/wait process)]))
         result {:command argv
                 :exit (nth values 2)
                 :stdout (str/decode-utf8 (nth values 0))
                 :stderr (str/decode-utf8 (nth values 1))}]
     (if (= 0 (:exit result))
       result
       (throw
        (ex-info "Hara package command failed" result))))))
