;; Foundation-compatible, pure source analysis primitives. Host adapters
;; supply file text; this namespace never grants filesystem authority.
(ns code.framework
  (:require [std.block.base :as block]
            [std.block.parse :as parse]))

(defn source-position
  "Returns a one-based line/column position for a byte-compatible HAL offset."
  [source offset]
  (loop [index 0
         line 1
         column 1]
    (if (or (= index offset)
            (= index (str/length source)))
      {:line line :column column}
      (if (= "\n" (str/char-at source index))
        (recur (inc index) (inc line) 1)
        (recur (inc index) line (inc column))))))

(defn line-number
  [source offset]
  (:line (source-position source offset)))

(defn parsed-block-value
  "Decodes one structural block independently of the parser's host value model."
  [value]
  (let [text (block/block-string value)]
    (if (block/expression? value)
      (try
        (Edn/read text)
        (catch Throwable error
          (block/block-value value)))
      (block/block-value value))))

(defn block-record
  [source value fallback-start]
  (let [text (block/block-string value)
        props (block/block-info value)
        start (or (:start-offset props) fallback-start)
        end (or (:end-offset props)
                (+ start (str/length text)))
        position (source-position source start)]
    {:block value
     :tag (block/block-tag value)
     :text text
     :value (parsed-block-value value)
     :start start
     :end end
     :line (or (:row props) (:line position))
     :column (or (:col props) (:column position))}))

(defn child-records
  "Returns exact source ranges for a parsed container's direct children."
  [source container start]
  (let [children (block/block-children container)
        child-start (+ start (block/block-prefixed container))]
    (loop [index 0
           offset child-start
           output []]
      (if (= index (count children))
        output
        (let [child (nth children index)
              record (block-record source child offset)]
          (recur (inc index)
                 (:end record)
                 (conj output record)))))))

(defn code-record?
  [record]
  (block/expression? (:block record)))

(defn metadata-record?
  [record]
  (= :meta (:tag record)))

(defn list-record?
  [record]
  (= :list (:tag record)))

(defn map-record?
  [record]
  (= :map (:tag record)))

(defn significant-records
  [records]
  (vec (filter code-record? records)))

(defn form-records-in
  "Groups prefix metadata with each direct list form in a parsed container."
  [source container start]
  (:output
   (reduce
    (fn [state record]
      (let [pending (:pending state)
            output (:output state)]
        (cond
          (metadata-record? record)
          {:pending (conj pending record)
           :output output}

          (list-record? record)
          (let [full-start (if (empty? pending)
                             (:start record)
                             (:start (first pending)))]
            {:pending []
             :output
             (conj output
                   (assoc record
                          :prefix-metadata pending
                          :full-start full-start
                          :full-text (str/slice source full-start (:end record))))})

          (code-record? record)
          {:pending [] :output output}

          :else
          state)))
    {:pending [] :output []}
    (child-records source container start))))

(defn semantic-children
  "Returns direct code children excluding metadata containers."
  [source form]
  (vec
   (filter
    (fn [record]
      (and (code-record? record)
           (not (metadata-record? record))))
    (child-records source (:block form) (:start form)))))

(defn inline-metadata-records
  [source form]
  (vec
   (filter metadata-record?
           (child-records source (:block form) (:start form)))))

(defn metadata-map-record
  [source metadata-record]
  (first
   (filter
    map-record?
    (significant-records
     (child-records source
                    (:block metadata-record)
                    (:start metadata-record))))))

(defn map-pairs
  [source map-record]
  (if (nil? map-record)
    []
    (let [records
          (significant-records
           (child-records source (:block map-record) (:start map-record)))]
      (loop [index 0
             output []]
        (if (>= index (count records))
          output
          (let [key-record (nth records index)
                value-record (if (< (inc index) (count records))
                               (nth records (inc index))
                               nil)]
            (recur
             (+ index 2)
             (conj output
                   {:key (:value key-record)
                    :value (if value-record (:value value-record) nil)
                    :key-record key-record
                    :value-record value-record}))))))))

(defn metadata-info
  [source metadata-record]
  (let [records
        (significant-records
         (child-records source
                        (:block metadata-record)
                        (:start metadata-record)))
        map-record (first (filter map-record? records))
        shorthand (first records)
        shorthand-value (if shorthand (:value shorthand) nil)
        value
        (cond
          map-record (:value map-record)
          (keyword? shorthand-value) {shorthand-value true}
          (or (symbol? shorthand-value)
              (string? shorthand-value)) {:tag shorthand-value}
          :else {})]
    {:record metadata-record
     :map-record map-record
     :pairs (map-pairs source map-record)
     :value (if (map? value) value {})}))

(defn form-metadata
  [source form]
  (vec
   (map
    (fn [record]
      (metadata-info source record))
    (concat (:prefix-metadata form)
            (inline-metadata-records source form)))))

(defn merged-metadata
  [metadata]
  (reduce
   (fn [output entry]
     (merge output (:value entry)))
   {}
   metadata))

(def +definition-heads+
  #{"def" "defonce" "defmacro" "defn" "defn-"})

(defn form-head
  [source form]
  (let [children (semantic-children source form)]
    (if (empty? children)
      nil
      (str (:value (first children))))))

(defn definition-kind
  [head]
  (cond
    (= head "defn-") :private-function
    (= head "defn") :function
    (= head "defmacro") :macro
    (= head "defonce") :once
    (= head "def") :value
    :else nil))

(defn definition-info
  [source form]
  (let [children (semantic-children source form)
        head (if (empty? children) nil (str (:value (first children))))]
    (if (not (has? +definition-heads+ head))
      nil
      (let [name-record (if (< 1 (count children)) (nth children 1) nil)
            doc-record (if (< 2 (count children)) (nth children 2) nil)
            name (if name-record (str (:value name-record)) nil)
            metadata (form-metadata source form)
            metadata-value (merged-metadata metadata)
            docstring (if (and doc-record (string? (:value doc-record)))
                        (:value doc-record)
                        nil)
            private (or (= head "defn-")
                        (= true (:private metadata-value))
                        (and name (str/starts-with? name "-")))]
        {:head head
         :name name
         :kind (definition-kind head)
         :public (not private)
         :private private
         :line (if name-record (:line name-record) (:line form))
         :column (if name-record (:column name-record) (:column form))
         :form-line (:line form)
         :form-column (:column form)
         :start (:start form)
         :end (:end form)
         :full-start (:full-start form)
         :source (:text form)
         :form form
         :name-record name-record
         :name-start (if name-record (:start name-record) nil)
         :name-end (if name-record (:end name-record) nil)
         :doc-record (if docstring doc-record nil)
         :doc-start (if docstring (:start doc-record) nil)
         :doc-end (if docstring (:end doc-record) nil)
         :docstring docstring
         :metadata metadata
         :meta metadata-value}))))

(defn namespace-name-from-forms
  [source forms]
  (loop [remaining forms]
    (if (empty? remaining)
      nil
      (let [form (first remaining)
            children (semantic-children source form)
            head (if (empty? children) nil (str (:value (first children))))]
        (if (and (or (= head "ns") (= head "ns+"))
                 (< 1 (count children)))
          (str (:value (nth children 1)))
          (recur (rest remaining)))))))

(defn namespace-name
  [source]
  (let [root (parse/parse-string source)
        forms (form-records-in source root 0)]
    (namespace-name-from-forms source forms)))

(defn definitions-from-forms
  [source forms]
  (vec
   (keep
    (fn [form]
      (definition-info source form))
    forms)))

(defn docstrings
  [definitions]
  (vec (filter (fn [entry] (:docstring entry)) definitions)))

(defn analyse-structure
  "Returns the internal structural model used by precise source editors."
  [source]
  (let [root (parse/parse-string source)
        forms (form-records-in source root 0)
        definitions (definitions-from-forms source forms)]
    {:namespace (namespace-name-from-forms source forms)
     :forms (count forms)
     :form-records forms
     :definitions definitions
     :docstrings (docstrings definitions)
     :source source}))

(defn public-definition
  "Removes parser blocks and edit-only records from one analysis entry."
  [definition]
  {:head (:head definition)
   :name (:name definition)
   :kind (:kind definition)
   :public (:public definition)
   :private (:private definition)
   :line (:line definition)
   :column (:column definition)
   :form-line (:form-line definition)
   :form-column (:form-column definition)
   :start (:start definition)
   :end (:end definition)
   :full-start (:full-start definition)
   :source (:source definition)
   :name-start (:name-start definition)
   :name-end (:name-end definition)
   :doc-start (:doc-start definition)
   :doc-end (:doc-end definition)
   :docstring (:docstring definition)
   :metadata (vec (map :value (:metadata definition)))
   :meta (:meta definition)})

(defn analyse-source
  "Structurally analyses top-level HAL forms and returns portable EDN data."
  [source]
  (let [analysis (analyse-structure source)
        definitions (vec (map public-definition (:definitions analysis)))]
    {:namespace (:namespace analysis)
     :forms (:forms analysis)
     :definitions definitions
     :docstrings (docstrings definitions)
     :source source}))

(defn grep-source
  [source needle]
  (loop [index 0
         lines (str/split-lines source)
         output []]
    (if (= index (count lines))
      output
      (let [line (nth lines index)]
        (recur (inc index) lines
               (if (str/includes? line needle)
                 (conj output {:line (inc index) :column 1 :text line})
                 output))))))

(defn value-contains?
  "Recursively searches parsed data for a value such as the `=>` symbol."
  [value target]
  (cond
    (= value target)
    true

    (map? value)
    (reduce
     (fn [found entry]
       (or found
           (value-contains? (first entry) target)
           (value-contains? (second entry) target)))
     false
     value)

    (or (vector? value) (list? value) (set? value))
    (reduce
     (fn [found child]
       (or found (value-contains? child target)))
     false
     value)

    :else
    false))
