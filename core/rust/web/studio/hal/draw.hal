(ns studio.draw
  (:require [studio.node :as node]))

(defn next-frame [canvas]
  (std.native.Host/call "studio.canvas" "next-frame" [(node/current-id) canvas]))

(defn render [canvas frame]
  (std.native.Host/call "studio.canvas" "render" [(node/current-id) canvas frame]))

(defn publish [canvas frame]
  (std.native.Host/call "studio.canvas" "publish" [(node/current-id) canvas frame]))
