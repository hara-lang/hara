(ns example.code-test.tasks
  (:require [std.work :as work]
            [std.work.command :as command]))

(def double-command
  (command/inspect
   {:id :example/double :version 1}
   {:list
    (work/pure
     :double/list
     (fn [input context]
       (vec (map (fn [value] {:item/id value :item/value value})
                 (:values input)))))
    :process
    (command/action :double/process
                    (fn [value context] (* 2 value)))}))

(work/run (work/local-runtime) double-command {:values [1 2 3]})
