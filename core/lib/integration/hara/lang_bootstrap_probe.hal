(ns integration.hara.lang-bootstrap-probe)

(defn probe [label namespace]
  (println (str "lang bootstrap probe: " label))
  (require namespace)
  (println (str "lang bootstrap probe passed: " label)))

(probe "postgres alpha" 'lang.model.spec-postgres)
(probe "runtime basic" 'lang.runtime.basic)

(println "lang bootstrap probe complete")
