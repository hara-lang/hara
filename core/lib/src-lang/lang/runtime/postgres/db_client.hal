(ns lang.runtime.postgres.db-client
  (:require [std.db.postgres :as postgres]
            [std.foundation.os :as os]
            [std.foundation.promise :as promise]
            [std.foundation.string :as string]
            [std.protocol.icontexteval :as context-eval]
            [lang.core.compile :as compile]
            [lang.core.eval :as evaluation]
            [lang.core.runtime :as runtime]))

(defstruct RuntimePostgresDbClient
  [id lang runtime options connection container state profile timeout])

(defn command!
  [argv]
  (let [process (os/spawn argv)
        values (deref (promise/all [(os/process-stdout process)
                                    (os/process-stderr process)
                                    (os/process-wait process)]))
        result {:command argv
                :stdout (string/trim (string/decode-utf8 (nth values 0)))
                :stderr (string/trim (string/decode-utf8 (nth values 1)))
                :exit (nth values 2)}]
    (if (= 0 (:exit result))
      result
      (throw (ex-info "Docker command failed" result)))))

(defn container-name
  [runtime container]
  (str (or (:group container) "testing") "_"
       (or (:id container) (name (:id runtime)))))

(defn append-pairs
  [arguments flag values]
  (reduce (fn [out key]
            (conj (conj out flag) (str (name key) "=" (get values key))))
          arguments
          (keys (or values {}))))

(defn start-container!
  [runtime container]
  (let [name (container-name runtime container)
        arguments (append-pairs ["docker" "run" "-d" "--rm" "--name" name]
                                "-e" (:environment container))
        arguments (into arguments (or (:flags container) []))
        arguments (conj arguments (:image container))
        arguments (into arguments (or (:cmd container) []))
        started (command! arguments)
        inspected (command! ["docker" "inspect" "-f"
                             "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}"
                             name])]
    {:name name
     :id (:stdout started)
     :host (:stdout inspected)
     :port (or (first (:ports container)) 5432)
     :permanent (:permanent container)}))

(defn stop-container!
  [container]
  (if (and container (not (:permanent container)))
    (command! ["docker" "kill" (:name container)]))
  nil)

(defn connection-options
  [runtime started]
  (let [options (:config (:options runtime))
        environment (get-in options [:container :environment])]
    (merge
     (dissoc options :container :temp :vendor)
     (if started {:host (:host started) :port (:port started)} {})
     (if (or (:user options) (nil? environment))
       {}
       {:user (get environment "POSTGRES_USER")})
     (if (or (:password options) (nil? environment))
       {}
       {:password (get environment "POSTGRES_PASSWORD")}))))

(defn primary-module
  [runtime]
  (first
   (keep (fn [spec]
           (if (and (vector? spec)
                    (some (fn [value] (= value :primary)) spec)
                    (some (fn [value] (= value true)) spec))
             (first spec)
             nil))
         (:require (:options runtime)))))

(defn bootstrap!
  [runtime]
  (if-let [main (primary-module runtime)]
    (let [compiled (compile/compile-module
                    {:lang :postgres
                     :main main
                     :layout :module
                     :emit (or (get-in runtime [:options :emit]) {})})
          diagnostics (:diagnostics compiled)]
      (if (not (empty? diagnostics))
        (throw (ex-info "PostgreSQL module compilation failed"
                        {:main main :diagnostics diagnostics})))
      (evaluation/await
       (postgres/batch-exec (deref (:connection runtime)) (:output compiled))
       (:timeout runtime))))
  runtime)

(defn rt-create
  [options]
  (lang.runtime.postgres.db-client/RuntimePostgresDbClient
   (or (:id options) :postgres.db-client)
   :postgres
   :db.client
   options
   (atom nil)
   (atom nil)
   (atom {:status :created})
   {:input [] :source [] :response []}
   (or (get-in options [:config :timeout]) 30000)))

(defn start
  [runtime]
  (let [container-options (get-in runtime [:options :config :container])
        started (if container-options (start-container! runtime container-options) nil)
        options (connection-options runtime started)]
    (if started (reset! (:container runtime) started))
    (evaluation/await (postgres/wait-ready options) (:timeout runtime))
    (if (get-in runtime [:options :config :temp])
      (evaluation/await
       (postgres/database-create options (get options :dbname))
       (:timeout runtime)))
    (reset! (:connection runtime)
            (evaluation/await (postgres/open options) (:timeout runtime)))
    (bootstrap! runtime)
    (reset! (:state runtime) {:status :started})
    runtime))

(defn stop
  [runtime]
  (if (deref (:connection runtime))
    (evaluation/await (postgres/close (deref (:connection runtime)))
                      (:timeout runtime)))
  (reset! (:connection runtime) nil)
  (stop-container! (deref (:container runtime)))
  (reset! (:container runtime) nil)
  (reset! (:state runtime) {:status :stopped})
  runtime)

(defn execute-only?
  [source]
  (let [statement (string/upper (string/trim source))]
    (some (fn [prefix] (string/starts-with? statement prefix))
          ["DO " "BEGIN " "DECLARE " "INSERT " "UPDATE " "DELETE "
           "CREATE " "DROP " "ALTER " "GRANT " "REVOKE " "TRUNCATE "
           "COMMENT " "VACUUM "])))

(defn normalize-query
  [response]
  (let [columns (get response "columns")
        rows (get response "rows")
        values (if (= 1 (count columns))
                 (map first rows)
                 rows)]
    (if (= 1 (count values)) (first values) values)))

(defn raw-eval
  [runtime source]
  (let [connection (deref (:connection runtime))]
    (if (nil? connection)
      (throw (ex-info "PostgreSQL runtime is not started" {:id (:id runtime)}))
      (if (execute-only? source)
        (evaluation/await (postgres/exec connection source) (:timeout runtime))
        (normalize-query
         (evaluation/await (postgres/query connection source) (:timeout runtime)))))))

(defn evaluate-async
  [runtime source options]
  (promise/run (fn [] (raw-eval runtime source))))

(extend-type RuntimePostgresDbClient context-eval/IContextEval
  (evaluate [runtime request options] (evaluate-async runtime request options))
  (evaluate-raw [runtime request options] (evaluate-async runtime request options)))

(def +init+
  (runtime/install-type!
   :postgres :db.client
   {:type :lang/rt.postgres.db-client
    :config {:layout :module}
    :instance {:create rt-create
               :start start
               :stop stop
               :raw-eval raw-eval}}))
