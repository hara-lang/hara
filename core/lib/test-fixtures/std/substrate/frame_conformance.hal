(ns std.substrate.frame-conformance
  (:require [std.substrate.json :as wire]))

(let [value
      (wire/frame-create
       :request "req-1"
       {:source "client/a"
        :target "server/b"
        :space "workspace/main"
        :meta {:trace "trace-1"}
        :action "math/add"
        :args [19 23]})]
  [(get value "version")
   (get value "kind")
   (get value "id")
   (get value "source")
   (get value "target")
   (get value "space")
   (get value "meta")
   (get value "action")
   (get value "args")
   (get value "reply_to")
   (get value "status")
   (get value "data")
   (get value "error")
   (get value "signal")
   (get value "cause")])
