(ns std.substrate.protocol-conformance
  (:require [std.substrate.protocol :as protocol]))

(defstruct Fixture [value])

(extend-type Fixture protocol/ISubstrateService
  (get-service [node service-id] (:value node))
  (set-service [node service-id service] service)
  (remove-service [node service-id] service-id))

(def fixture (Fixture 40))

[(protocol/get-service fixture "answer")
 (protocol/set-service fixture "answer" 42)]
