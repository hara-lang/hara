;; Shared native collection capability contract for Rust and Truffle.
(ns user)

(let [queue (std.native.Algo/queue 1 2)
      mutable-queue (std.protocol.itomutable/to-mutable queue)
      vector (vec [1 2])
      mutable-map (std.protocol.itomutable/to-mutable {:a 1})]
  [(satisfies? std.protocol.ipushfirst/IPushFirst queue)
   (= (std.native.Algo/queue 0 1 2)
      (std.protocol.ipushfirst/push-first queue 0))
   (satisfies? std.protocol.ipushfirst/IPushFirst mutable-queue)
   (do (std.protocol.ipushfirst/push-first mutable-queue 0)
       (= 0 (std.protocol.ipeekfirst/peek-first mutable-queue)))
   (satisfies? std.protocol.ipopfirst/IPopFirst mutable-queue)
   (do (std.protocol.ipopfirst/pop-first mutable-queue)
       (= 1 (std.protocol.ipeekfirst/peek-first mutable-queue)))
   (not (satisfies? std.protocol.ipushfirst/IPushFirst vector))
   (not (satisfies? std.protocol.ipopfirst/IPopFirst vector))
   (satisfies? std.protocol.ipushlast/IPushLast vector)
   (satisfies? std.protocol.ipoplast/IPopLast vector)
   (satisfies? std.protocol.ifind/IFind mutable-map)
   (= [:a 1] (std.protocol.ifind/find mutable-map :a))])
