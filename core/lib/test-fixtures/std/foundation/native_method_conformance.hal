(ns std.foundation.native-method-conformance)

(def native-method-fixtures
  {'Base/list
   ['(1 2) (fn [] (Base/list 1 2))]

   'Base/vector
   [[1 2] (fn [] (Base/vector 1 2))]

   'Base/pair
   [[:a 1] (fn [] (Base/pair :a 1))]

   'Base/tup
   [[1 2 3] (fn [] (Base/tup 1 2 3))]

   'Base/hash-map
   [{:a 1} (fn [] (Base/hash-map :a 1))]

   'Base/hash-set
   [#{1 2} (fn [] (Base/hash-set 1 2))]

   'Base/atom
   [1 (fn [] (deref (Base/atom 1)))]

   'Base/pointer
   [:base (fn [] (IPointer/ptr-context (Base/pointer {:context :base})))]

   'Base/symbol
   ['base/value (fn [] (Base/symbol "base" "value"))]

   'Base/keyword
   [:base/value (fn [] (Base/keyword "base" "value"))]

   'Base/reduced
   [true (fn [] (Base/reduced? (Base/reduced 1)))]

   'Base/reduced?
   [false (fn [] (Base/reduced? 1))]

   'Base/unreduced
   [1 (fn [] (Base/unreduced (Base/reduced 1)))]

   'RegExp/instance?
   [true (fn [] (RegExp/instance? (RegExp/compile "a+")))]

   'RegExp/compile
   [true (fn [] (RegExp/instance? (RegExp/compile "a+")))]

   'RegExp/pattern
   ["a+" (fn [] (RegExp/pattern (RegExp/compile "a+")))]

   'RegExp/find?
   [true (fn [] (RegExp/find? (RegExp/compile "a+") "caa"))]

   'RegExp/find
   ["aa" (fn [] (RegExp/find (RegExp/compile "a+") "caa"))]

   'RegExp/matches
   [[true false true]
    (fn []
      [(RegExp/matches (RegExp/compile "a+") "aa")
       (RegExp/matches (RegExp/compile "a+") "caa")
       (RegExp/matches (RegExp/compile "a|abc") "abc")])]

   'RegExp/replace
   ["12:x" (fn []
              (RegExp/replace
                (RegExp/compile "([a-z]+)-([0-9]+)")
                "x-12"
                "$2:$1"))]

   'RegExp/split
   [["a" "b" "c"]
    (fn [] (RegExp/split (RegExp/compile ",+") "a,,b,c"))]})

(defn native-method-result
  "Runs direct canonical native calls, with concrete RegExp cases and missing-dispatch classification."
  [method thunk]
  (let [fixture (get native-method-fixtures method)]
    (try
      (if fixture
        (let [expected (first fixture)
              actual ((second fixture))]
          {:method method
           :pass (= expected actual)
           :expected expected
           :actual actual})
        (do
          (thunk)
          {:method method :pass true}))
      (catch Throwable error
        (let [message (ex-message error)]
          {:method method
           :pass
           (if fixture
             false
             (if (std.foundation.string/includes? message "nbound symbol")
               false
               (if (std.foundation.string/includes? message "unavailable/")
                 false
                 true)))
           :error message})))))
