(ns postgres.core.impl-test
  (:require [postgres.core.impl :as impl])
  (:use code.test))

(def schema
  {:id [{:type :uuid :primary true :order 0}]
   :name [{:type :text :order 1}]})
(def entry {:id 'Entry :module 'demo :table-schema schema})

(fact "exposes select operations through the implementation facade"
  (macroexpand-1 (list 'impl/t:select entry {:as :raw})) => '[:select * :from demo/Entry]
  (macroexpand-1 (list 'impl/t:count entry {}))
  => '(pg:scalar [:select (count *) :from demo/Entry]))

(fact "guards single-record reads with WHERE"
  (macroexpand-1 (list 'impl/t:get entry {})) => (throws)
  (macroexpand-1 (list 'impl/t:id entry {})) => (throws)
  (macroexpand-1 (list 'impl/t:get entry {:where {:id "a"}}))
  => '(pg:scalar
       [:with j-ret :as
        [:select (--- [#{"id"} #{"name"}]) :from demo/Entry
         \\ :where {"id" [:eq "a"]} \\ :limit 1]
        \\ :select (to-jsonb j-ret) :from j-ret]))

(fact "exposes insert and update operations"
  (macroexpand-1 (list 'impl/t:insert entry {:id "a"} {:as :raw}))
  => '[:insert-into demo/Entry (>-< [#{"id"}]) :values (>-< [(:uuid "a")])]
  (macroexpand-1 (list 'impl/t:update! entry {:set {:name "n"}}))
  => '[:update demo/Entry :set (== (>-< [#{"name"}]) (row (:text "n")))])

(fact "exposes table fields"
  (macroexpand-1 (list 'impl/t:fields entry {})) => '[name])
