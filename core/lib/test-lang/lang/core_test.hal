(ns lang.core-test
  (:use code.test)
  (:require [std.foundation.component :as component]
            [std.lib.walk :as walk]
            [lang.core :as tahto]))

(def +xtalk-runtime+
  (tahto/script :xtalk))

(def.xt HEX
  (tab ["A" 10]
       ["B" 11]))

(fact "script returns a started runtime and installs the language tag macro"
  (component/started? +xtalk-runtime+)
  => true

  (!.xtalk (+ 19 23))
  => 42)

(fact "top-level XTalk declarations intern pointer-backed Vars"
  (tahto/script-pointer? HEX)
  => true

  (:id (deref HEX))
  => 'HEX

  (not (nil? (resolve 'HEX)))
  => true)

(fact "prewalk replaces nested values"
  (walk/prewalk-replace {'a 'x} '(a (a b)))
  => '(x (x b)))

(fact "resolves namespaced code symbols"
  (tahto/to-resolve '(u/add 1 2) nil
                    {'L.core {:code {'add {:id 'add :op 'defn}}}}
                    {:module {:id 'L.current :link '{u L.core}}})
  => '(L.core/add 1 2))

(run {:namespace "lang.core-test"})
