(ns lang.common.book-meta-test
  (:use code.test)
  (:require [lang.common.book-meta :as meta]
            [lang.common.util :as util]))

^{:refer lang.common.book-meta/book-meta? :added "4.0"}
(fact "checks if object is book metadata"
  (meta/book-meta? (meta/book-meta {})) => true)

^{:refer lang.common.book-meta/book-meta :added "4.0"}
(fact "creates provider-independent book lifecycle metadata"
  (meta/book-meta?
   (meta/book-meta
    {:module-export (fn [module options] (list 'return (:as module)))
     :module-import (fn [name module options]
                      (list 'var (:as module) := (list 'require (str name))))
     :teardows-module (fn [module options]
                        (list 'teardown (:as module)))
     :has-ptr (fn [ptr] (list 'not= (util/sym-full ptr) nil))
     :teardown-ptr (fn [ptr] (list := (util/sym-full ptr) nil))}))
  => true
  (let [value (meta/book-meta
              {:teardows-module (fn [module options]
                                  (list 'teardown (:as module)))})]
    ((:teardows-module value) {:as 'demo} {}))
  => (list 'teardown 'demo))

(pr-str (run {:namespace "lang.common.book-meta-test"}))
