(ns lang.common.emit-helper-test
  (:use code.test)
  (:require [lang.common.emit-helper :as helper]))

^{:refer lang.common.emit-helper/default-emit-fn :added "4.0"}
(fact "the default emit function"
  (helper/default-emit-fn 'abc {} {})
  => "abc")

^{:refer lang.common.emit-helper/pr-single :added "3.0"}
(fact "prints a single quoted string"
  (helper/pr-single "hello")
  => "'hello'"

  (helper/pr-single "he'\"llo")
  => "'he\\'\"llo'"

  (helper/pr-single "''")
  => "'\\'\\''")

(fact "preserves Foundation character-keyed symbol replacements"
  helper/+sym-replace+
  => {\- "_"
      \* "__"
      \? "p"
      \! "f"
      \= "_eq"
      \< "_lt"
      \> "_gt"}

  (get-in helper/+default+ [:default :symbol :full :replace])
  => {\. "_"})

^{:refer lang.common.emit-helper/get-option :added "3.0"}
(fact "gets either the path option or the default one"
  (helper/get-option helper/+default+ [:block :for] :sep)
  => ","

  (helper/get-option helper/+default+ [:data :map] :start)
  => "{")

^{:refer lang.common.emit-helper/get-options :added "3.0"}
(fact "gets the path option merged with defaults"
  (helper/get-options helper/+default+ [:data :map])
  => {:statement ";"
      :sep ","
      :space ""
      :static "."
      :start "{"
      :line-spacing 1
      :assign "="
      :namespace-full "____"
      :apply "."
      :access "."
      :end "}"
      :namespace "."
      :range ":"})

^{:refer lang.common.emit-helper/form-key-base :added "4.0"}
(fact "gets the key for a form"
  (helper/form-key-base :a)
  => [:keyword :token true]

  (helper/form-key-base ())
  => :expression)

^{:refer lang.common.emit-helper/basic-typed-args :added "4.0"}
(fact "typed args without grammar checks"
  (map (juxt meta identity)
       (helper/basic-typed-args '(:int i :const :int j)))
  => [[{:- [:int]} 'i]
      [{:- [:const :int]} 'j]])

^{:refer lang.common.emit-helper/emit-typed-allowed-args :added "4.0"}
(fact "allowed declared args other than symbols"
  (helper/emit-typed-allowed-args
   [[{:modifiers [:int]}]
    {:modifiers [:int]}]
   {:allow {:assign #{:symbol}}})
  => (throws))

^{:refer lang.common.emit-helper/emit-typed-args :added "3.0"}
(fact "creates typed args from declarations"
  (helper/emit-typed-args '(:int i := 9 :const :int j := 10)
                          helper/+default+)
  => [{:modifiers [:int]
       :symbol 'i
       :assign true
       :force true
       :value 9}
      {:modifiers [:const :int]
       :symbol 'j
       :assign true
       :force true
       :value 10}]

  (helper/emit-typed-args '((:int a) 9)
                          helper/+default+)
  => [{:modifiers [] :symbol 'a :type '(:int) :value 9}]

  (helper/emit-typed-args '(:mutable (:int a) 9)
                          helper/+default+)
  => [{:modifiers [:mutable] :symbol 'a :type '(:int) :value 9}]

  (helper/emit-typed-args '(a b)
                          helper/+default+)
  => [{:modifiers [] :symbol 'a}
      {:modifiers [] :symbol 'b}]

  (helper/emit-typed-args '(a b)
                          helper/+default+
                          {:shorthand true})
  => [{:modifiers [] :symbol 'a :value 'b}]

  (helper/emit-typed-args '(out [])
                          helper/+default+
                          {:shorthand true})
  => [{:modifiers [] :symbol 'out :value []}])

^{:refer lang.common.emit-helper/emit-symbol-full :added "4.0"}
(fact "emits a full symbol"
  (helper/emit-symbol-full 'hello 'ns helper/+default+)
  => "ns____hello")

^{:refer lang.common.emit-helper/emit-type-record :added "4.0"}
(fact "formats a typed argument to the standard record"
  (helper/emit-type-record {:modifiers [:int]
                            :symbol "a"})
  => {:symbol "a" :type "int"})

^{:refer lang.common.emit-helper/rest-arg-form? :added "4.1"}
(fact "recognizes only the canonical final rest argument shape"
  [(helper/rest-arg-form? '(:.. args))
   (helper/rest-arg-form? '(:.. "args"))
   (helper/rest-arg-form? '(:.. args extra))
   (helper/rest-arg-form? '[:.. args])]
  => [true false false false])

^{:refer lang.common.emit-helper/rest-arg-symbol :added "4.1"}
(fact "returns the symbol from a canonical rest argument"
  [(helper/rest-arg-symbol '(:.. args))
   (helper/rest-arg-symbol '(:.. "args"))]
  => ['args nil])

(pr-str (run '[lang.common.emit-helper-test]))
