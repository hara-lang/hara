(ns lang.common.grammar-spec-test
  (:use code.test)
  (:require [lang.common.emit-helper :as helper]
            [lang.common.grammar-spec :as spec]))

(defn mixin-add-symbol
  [m]
  {:symbol spec/*symbol*
   :base (:base m)})

^{:refer lang.common.grammar-spec/get-comment :added "4.0"}
(fact "gets the comment prefix for a grammar"
  (spec/get-comment helper/+default+ {}) => "//")

^{:refer lang.common.grammar-spec/format-fargs :added "3.0"}
(fact "formats function inputs"
  (spec/format-fargs '[[a b]]) => '["" {} ([a b])]
  (spec/format-fargs '["docstring" [a b]])
  => '["docstring" {} ([a b])]
  (spec/format-fargs '(([a] a) ([a b] (+ a b))))
  => '["" {} (([a] a) ([a b] (+ a b)))])

^{:refer lang.common.grammar-spec/format-defn-mixins :added "4.1"}
(fact "applies symbol, form, and map mixins in order"
  (binding [spec/*symbol* 'hello]
    [(spec/format-defn-mixins
      {:base true} ['lang.common.grammar-spec-test/mixin-add-symbol])
     (spec/format-defn-mixins
      {:base true} ['(hash-map :from-form *symbol*)])
     (spec/format-defn-mixins {:base true} ['{:from-map true}])])
  => '[{:symbol hello :base true}
       {:from-form hello}
       {:base true :from-map true}])

^{:refer lang.common.grammar-spec/format-defn :added "3.0"}
(fact "standardizes function definitions"
  (spec/format-defn '(defn hello "hello" {:list 1} []))
  => '[{:list 1 :doc "hello"} (defn hello [])])

^{:refer lang.common.grammar-spec/tf-for-index :added "4.0"}
(fact "transforms indexed loops"
  (spec/tf-for-index '(for:index [i [0 2 3]]))
  => '(for [(var i := 0) (< i 2) (:= i (+ i 3))]))

(run {:namespace "lang.common.grammar-spec-test"})
