(ns lang.common.preprocess-base-test
  (:use code.test)
  (:require [lang.common.preprocess-base :as base]))

^{:refer lang.common.preprocess-base/macro-form :added "4.1"}
(fact "returns the current macro form"
  (binding [base/*macro-form* 'hello]
    (base/macro-form))
  => 'hello)

^{:refer lang.common.preprocess-base/macro-opts :added "4.1"}
(fact "returns the current macro options"
  (binding [base/*macro-opts* {:a 1}]
    (base/macro-opts))
  => {:a 1})

^{:refer lang.common.preprocess-base/macro-grammar :added "4.1"}
(fact "returns the current macro grammar"
  (binding [base/*macro-grammar* {:a 1}]
    (base/macro-grammar))
  => {:a 1})

^{:refer lang.common.preprocess-base/with:macro-opts :added "4.1"}
(fact "binds macro options for consumer namespaces"
  (base/with:macro-opts [{:a 1}]
    (base/macro-opts))
  => {:a 1})

(run {:namespace "lang.common.preprocess-base-test"})
