(ns lang.seedgen-cli-test
  (:require [lang.seedgen.cli :as cli]))

[(test-check "seedgen owns operation and runtime language parsing"
              (cli/parse-arguments ["benchadd" "lua"])
              {:operation :benchadd :language :lua})
  (test-check "seedgen defaults to listing"
              (cli/parse-arguments [])
              {:operation :list :language nil})]
