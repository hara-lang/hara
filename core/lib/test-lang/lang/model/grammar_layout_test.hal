(ns lang.model.grammar-layout-test
  (:use code.test)
  (:require [lang.model.v1.spec-js.js-native :as js-native]
            [lang.model.v1.spec-xtalk.fn-js :as js-xtalk]
            [lang.model.v1.spec-python.python-native :as python-native]
            [lang.model.v1.spec-xtalk.fn-python :as python-xtalk]
            [lang.model.v1.spec-lua.lua-native :as lua-native]
            [lang.model.v1.spec-xtalk.fn-lua :as lua-xtalk]))

(defn xtalk-layer-valid?
  [native xtalk]
  (let [native-operators (get native :override)
        xtalk-operators (get xtalk :override)
        xtalk-keys (keys xtalk-operators)]
    (and (every? (fn [operator]
                   (str/starts-with? (name operator) "x-"))
                 xtalk-keys)
         (every? (fn [operator]
                   (nil? (get native-operators operator)))
                 xtalk-keys))))

(defn grouped-xtalk-valid?
  [source operators groups]
  (and (= (get source :override) (get operators :override))
       (= (count (get source :override))
          (reduce + (map (fn [group] (count (:entries group))) groups)))))

(defn grouped-native-valid?
  [source operators groups]
  (and (= source operators)
       (= (+ (count (get source :override)) (count (get source :define)))
          (reduce + (map (fn [group]
                           (+ (count (:override group))
                              (count (:define group))))
                         groups)))))

(fact "language XTalk layers contain only portable x-* overrides"
  [(xtalk-layer-valid? js-native/+operators+ js-xtalk/+operators+)
   (xtalk-layer-valid? python-native/+operators+ python-xtalk/+operators+)
   (xtalk-layer-valid? lua-native/+operators+ lua-xtalk/+operators+)]
  => [true true true])

(fact "native layers retain target-specific operators"
  [(boolean (get-in js-native/+operators+ [:override :eq]))
   (boolean (get-in python-native/+operators+ [:override :with-global]))
   (boolean (get-in lua-native/+operators+ [:override :with-global]))]
  => [true true true])

(fact "XTalk targets preserve the original named group vocabulary"
  [js-xtalk/+operator-group-names+
   lua-xtalk/+operator-group-names+
   python-xtalk/+operator-group-names+]
  => [[:core :global :custom :math :type :lu :obj :arr :arr-functional
       :str :bytes :js :return :iter :promise :shell :file]
      [:core :global :custom :math :type :lu :bit :obj :arr :str :bytes :js
       :return :iter :promise :file :shell]
      [:core :global :custom :math :type :lu :obj :arr :fn :str :bytes :js
       :return :iter :promise :shell :file]])

(fact "group composition is lossless for XTalk and native target specs"
  [(grouped-xtalk-valid? js-xtalk/+operator-source+ js-xtalk/+operators+
                         js-xtalk/+operator-groups+)
   (grouped-xtalk-valid? lua-xtalk/+operator-source+ lua-xtalk/+operators+
                         lua-xtalk/+operator-groups+)
   (grouped-xtalk-valid? python-xtalk/+operator-source+ python-xtalk/+operators+
                         python-xtalk/+operator-groups+)
   (grouped-native-valid? js-native/+operator-source+ js-native/+operators+
                          js-native/+operator-groups+)
   (grouped-native-valid? lua-native/+operator-source+ lua-native/+operators+
                          lua-native/+operator-groups+)
   (grouped-native-valid? python-native/+operator-source+ python-native/+operators+
                          python-native/+operator-groups+)]
  => [true true true true true true])

(fact "XTalk group vars expose the original semantic boundaries"
  [(boolean (get js-xtalk/+js-math+ :x-m-sqrt))
   (boolean (get js-xtalk/+js-arr-functional+ :x-arr-foldl))
   (boolean (get lua-xtalk/+lua-bit+ :x-bit-xor))
   (boolean (get lua-xtalk/+lua-file+ :x-file-read))
   (boolean (get python-xtalk/+python-custom+ :x-get-key))
   (boolean (get python-xtalk/+python-promise+ :x-async-run))]
  => [true true true true true true])

(fact "native group vars expose target grammar boundaries"
  [(boolean (get js-native/+js-native-for+ :for-array))
   (boolean (get js-native/+js-native-definitions+ :typeof))
   (boolean (get lua-native/+lua-native-counter+ :incby))
   (boolean (get lua-native/+lua-native-coroutine+ :yield))
   (boolean (get python-native/+python-native-fn+ :fn))
   (boolean (get python-native/+python-native-definitions+ :index-native))]
  => [true true true true true true])

(run {:namespace "lang.model.grammar-layout-test"})
