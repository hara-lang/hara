(ns lang.runtime.basic.type-oneshot-test
  (:require [lang.runtime.basic.type-oneshot :as oneshot]))

(def runtime
  {:id :shell.oneshot
   :lang :shell
   :runtime :oneshot
   :program :sh
   :exec ["sh" "-c"]
   :process {}})

(def results
  [(test-check
    "oneshot-result retains its existing vector projection"
    (oneshot/oneshot-result
     runtime
     ["sh" "-c" "printf ok"]
     [(str/encode-utf8 "ok")
      (str/encode-utf8 "")
      0])
    {:phase :eval
     :runtime/id :shell.oneshot
     :runtime/language :shell
     :lang :shell
     :runtime :oneshot
     :program :sh
     :command ["sh" "-c" "printf ok"]
     :exit 0
     :stdout "ok"
     :stderr ""})

   (test-check
    "execute-oneshot delegates one-shot execution to tool.sh"
    (oneshot/execute-oneshot runtime "printf 'value\\n'")
    {:phase :eval
     :runtime/id :shell.oneshot
     :runtime/language :shell
     :lang :shell
     :runtime :oneshot
     :program :sh
     :command ["sh" "-c" "printf 'value\\n'"]
     :exit 0
     :stdout "value\n"
     :stderr ""})

   (test-check
    "raw-eval-oneshot retains its explicit semantic trimming"
    (oneshot/raw-eval-oneshot runtime "printf 'value\\n'")
    "value")])

results
