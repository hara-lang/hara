(ns xt.db.node.proxy-util-test
  (:use code.test)
  (:require [lang.core :as l]
            [xt.db.node.proxy-util :as proxy-util]))

^{:seedgen/root {:all true, :langs [:js :lua :python]}}
(l/script- :js
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.common-data :as xtd]
             [xt.substrate :as substrate]
             [xt.db.node.proxy-util :as proxy-util]]})

(l/script- :lua
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.common-data :as xtd]
             [xt.substrate :as substrate]
             [xt.db.node.proxy-util :as proxy-util]]})

(l/script- :python
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.common-data :as xtd]
             [xt.substrate :as substrate]
             [xt.db.node.proxy-util :as proxy-util]]})

(fact:global
 {:setup [(l/rt:restart)]
  :teardown [(l/rt:stop)]})

^{:refer xt.db.node.proxy-util/get-transport-id :added "4.1"}
(fact "resolves explicit and default proxy transport metadata"

  (!.js
   (var node {"state" {"adaptor_proxy" {}}})
   (proxy-util/set-default-transport node "default-server")
   (return
    [(proxy-util/get-default-transport node)
     (proxy-util/get-transport-id node {"transport_id" "opt-server"})
     (proxy-util/get-transport-id node {})
     (proxy-util/request-meta node {"transport_id" "opt-server"})]))
  => ["default-server" "opt-server" "default-server"
      {"transport_id" "opt-server"}]

  (!.lua
   (var node {"state" {"adaptor_proxy" {}}})
   (proxy-util/set-default-transport node "default-server")
   (return
    [(proxy-util/get-default-transport node)
     (proxy-util/get-transport-id node {"transport_id" "opt-server"})
     (proxy-util/get-transport-id node {})
     (proxy-util/request-meta node {"transport_id" "opt-server"})]))
  => ["default-server" "opt-server" "default-server"
      {"transport_id" "opt-server"}]

  (!.py
   (var node {"state" {"adaptor_proxy" {}}})
   (proxy-util/set-default-transport node "default-server")
   (return
    [(proxy-util/get-default-transport node)
     (proxy-util/get-transport-id node {"transport_id" "opt-server"})
     (proxy-util/get-transport-id node {})
     (proxy-util/request-meta node {"transport_id" "opt-server"})]))
  => ["default-server" "opt-server" "default-server"
      {"transport_id" "opt-server"}])

(fact "registers exactly the Foundation proxy utility functions"

  (let [module (get (deref lang.core.script/+modules+)
                    'xt.db.node.proxy-util)]
    (set (keys (:code module))))
  => '#{set-default-transport
        get-default-transport
        get-transport-id
        request-meta
        request-proxy
        request-client})
