(ns xt.db.node.client-base-test
  (:use code.test)
  (:require [xt.db.node.client-base]))

(defn request-shape
  [sym]
  (let [module (get (deref lang.core.script/+modules+)
                    'xt.db.node.client-base)
        form (:form (get (:code module) sym))
        call (second (last form))]
    [(nth call 2) (nth call 3)]))

(fact "preserves every Foundation client action and argument vector"

  (vec
   (map request-shape
        '[kernel-init
          kernel-setup
          kernel-teardown
          subscribe-db
          unsubscribe-db
          sync-cached
          attach-model
          detach-model
          rpc-call
          rpc-attach-model
          pull-call
          pull-cached
          pull-attach-model
          dataview-call
          dataview-cached
          dataview-attach-model]))
  => [["@xt.db/kernel-init" '[config schema lookup]]
      ["@xt.db/kernel-setup" '[config schema lookup]]
      ["@xt.db/kernel-teardown" '[config]]
      ["@xt.db/subscribe-db" '[primary-id conn-id topics]]
      ["@xt.db/unsubscribe-db" '[primary-id conn-id topics]]
      ["@xt.db/sync-cached" '[primary-id payload]]
      ["@xt.db/attach-model" '[primary-id page-args model-spec]]
      ["@xt.db/detach-model" '[primary-id page-args]]
      ["@xt.db/rpc-call" '[service-id rpc-spec rpc-args]]
      ["@xt.db/rpc-attach-model" '[primary-id page-args rpc-spec model]]
      ["@xt.db/pull-call" '[primary-id tree]]
      ["@xt.db/pull-cached" '[primary-id tree]]
      ["@xt.db/pull-attach-model" '[primary-id page-args tree model]]
      ["@xt.db/dataview-call" '[primary-id dataview]]
      ["@xt.db/dataview-cached" '[primary-id dataview]]
      ["@xt.db/dataview-attach-model" '[primary-id page-args dataview model]]])
