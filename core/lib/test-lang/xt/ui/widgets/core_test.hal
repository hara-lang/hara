(ns xt.ui.widgets.core-test
  (:use code.test)
  (:require [lang.core :as l]
            [xt.ui.widgets.core :as widgets]))

^{:seedgen/root {:all true, :langs [:js]}}
(l/script- :js
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.ui.core :as ui]
             [xt.ui.widgets.core :as widgets]]})

(fact:global
 {:setup [(l/rt:restart)]
  :teardown [(l/rt:stop)]})

(fact "builds the complete semantic registry and fields"
  (!.js
   (var reg (widgets/registry))
   (var field-node (widgets/field "ui/input" "email" "Email" nil
                                  {"placeholder" "name@example.com"} "change"))
   (return [(ui/validate-node reg field-node)
            (. field-node ["children"])]))
  => [true [{"component" "ui/label"
             "props" {"value" "Email" "for" "email"}
             "children" []}
            {"component" "ui/input"
             "props" {"id" "email"
                      "value" ""
                      "on_change" "change"
                      "placeholder" "name@example.com"}
             "children" []}]])

(fact "registers exactly the Foundation widget functions"
  (let [module (get (deref lang.core.script/+modules+)
                    'xt.ui.widgets.core)]
    (set (keys (:code module))))
  => '#{register semantic-registry registry widget field})
