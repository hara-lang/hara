(ns lang.model.spec-js
  (:require [lang.common.grammar-api :as grammar]
            [lang.common.registry :as registry]
            [lang.model.spec-xtalk :as xtalk]
            [lang.model.spec-js.js-grammar :as model]))

(def +language+ :js)
(def +tag+ :js)
(def +version+ "alpha")
(def +grammar-version+ model/+grammar-version+)
(def +grammar+ model/+grammar+)

(defn- install-source
  [catalog source]
  (if (registry/find catalog (grammar/source-coordinate source))
    catalog
    (registry/install catalog source)))

(defn install
  "Installs the Foundation-named JavaScript V1 model."
  [catalog]
  (install-source (xtalk/install catalog) +grammar+))

(defn catalog
  []
  (install (registry/registry)))

(defn select
  "Resolves JavaScript language :js using grammar tag :js."
  ([]
   (select (catalog)))
  ([catalog]
   (registry/resolve catalog
                     {:grammar/id +tag+
                      :grammar/version +grammar-version+})))

(def +selection+ (select))

(def +book+
  {:lang +language+
   :parent :xtalk
   :version +version+
   :coordinate (:coordinate +selection+)
   :grammar (:grammar +selection+)
   :selection +selection+})


(def +init+ +book+)

