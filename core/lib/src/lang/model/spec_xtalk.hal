(ns lang.model.spec-xtalk
  (:require [lang.common.grammar-api :as grammar]
            [lang.common.registry :as registry]
            [lang.model.spec-xtalk.xtalk-grammar :as model]))

(def +language+ :xtalk)
(def +tag+ :xtalk)
(def +version+ "alpha")
(def +grammar-version+ model/+grammar-version+)
(def +template+ model/+template+)
(def +profile+ model/+profile+)
(def +grammar+ model/+grammar+)

(defn- install-source
  [catalog source]
  (if (registry/find catalog (grammar/source-coordinate source))
    catalog
    (registry/install catalog source)))

(defn install
  "Installs the alpha XTalk/common model sources."
  [catalog]
  (let [catalog (install-source catalog +template+)
        catalog (install-source catalog +profile+)]
    (install-source catalog +grammar+)))

(defn catalog
  []
  (install (registry/registry)))

(defn select
  ([]
   (select (catalog)))
  ([catalog]
   (registry/resolve catalog
                     {:grammar/id +tag+
                      :grammar/version +grammar-version+})))

(def +selection+ (select))

(def +book+
  {:lang +language+
   :parent nil
   :version +version+
   :coordinate (:coordinate +selection+)
   :grammar (:grammar +selection+)
   :selection +selection+})

(def +init+ +book+)


