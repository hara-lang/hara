(ns lang.model.spec-hara
  (:require [lang.common.compiler :as common-compiler]
            [lang.common.grammar-api :as grammar]
            [lang.common.registry :as registry]
            [lang.model.spec-hara.hara-emit :as hara-emit]
            [lang.model.spec-hara.hara-grammar :as model]
            [lang.model.spec-xtalk :as xtalk]
            [lang.protocol.compiler :as protocol]))

(def +language+ :hara)
(def +tag+ :hara)
(def +version+ "alpha")
(def +grammar-version+ model/+grammar-version+)
(def +grammar+ model/+grammar+)

(defn- install-source
  [catalog source]
  (if (registry/find catalog (grammar/source-coordinate source))
    catalog
    (registry/install catalog source)))

(defn install
  "Installs the XTalk parent and Hara target grammar."
  [catalog]
  (install-source (xtalk/install catalog) +grammar+))

(defn catalog
  []
  (install (registry/registry)))

(defn select
  "Resolves the Hara child grammar of XTalk."
  ([]
   (select (catalog)))
  ([catalog]
   (registry/resolve catalog
                     {:grammar/id +tag+
                      :grammar/version +grammar-version+})))

(def +selection+ (select))

(defstruct HaraEmitter [])

(extend-type HaraEmitter protocol/IEmitter
  (emit-form [emitter rewritten selected context]
    (hara-emit/emit-form
     rewritten
     (assoc context
            :lang/grammar-coordinate (:coordinate selected)
            :lang/grammar-fingerprint (:fingerprint selected)))))

(defn emitter
  []
  (lang.model.spec-hara/HaraEmitter))

(defn compiler
  "Creates a compiler whose final emission phase produces Hara source."
  []
  (common-compiler/compiler {:emitter (emitter)}))

(defn compile-result
  "Compiles one XTalk form through the Hara grammar and returns all phases."
  ([form]
   (compile-result form {}))
  ([form context]
   (common-compiler/compile
    (compiler)
    form
    +selection+
    (assoc context :lang :hara))))

(defn compile
  "Compiles one XTalk form into executable Hara source."
  ([form]
   (compile form {}))
  ([form context]
   (:output (compile-result form context))))

(defn emit
  "Directly lowers an already staged XTalk form into Hara source."
  ([form]
   (emit form {}))
  ([form context]
   (hara-emit/emit-form form context)))

(def +book+
  {:lang +language+
   :parent :xtalk
   :version +version+
   :coordinate (:coordinate +selection+)
   :grammar (:grammar +selection+)
   :selection +selection+
   :compiler compiler})

(def +init+ +book+)


