(ns lang.model.v1.spec-hara
  (:require [lang.model.spec-hara :as impl]))

;; Stable public V1 coordinate over the alpha self-hosting Hara implementation.
(def +language+ impl/+language+)
(def +tag+ impl/+tag+)
(def +version+ 1)
(def +grammar-version+ impl/+grammar-version+)
(def +grammar+ impl/+grammar+)
(def HaraEmitter impl/HaraEmitter)
(def install impl/install)
(def catalog impl/catalog)
(def select impl/select)
(def +selection+ impl/+selection+)
(def emitter impl/emitter)
(def compiler impl/compiler)
(def compile-result impl/compile-result)
(def compile impl/compile)
(def emit impl/emit)
(def +book+ (assoc impl/+book+ :version +version+))
(def +init+ +book+)
