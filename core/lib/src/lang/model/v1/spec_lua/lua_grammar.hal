(ns lang.model.v1.spec-lua.lua-grammar
  (:require [lang.base.v1.grammar-spec :as spec]
            [lang.common.grammar :as grammar]
            [lang.common.grammar-api :as grammar-api]
            [lang.model.v1.spec-xtalk :as xtalk]
            [lang.model.v1.spec-lua.lua-native :as native]
            [lang.model.v1.spec-xtalk.fn-lua :as xtalk-ops]))

(def +language+ :lua)
(def +tag+ :lua)
(def +grammar-version+ spec/+version+)

(def +features+
  (-> (grammar/build)
      (grammar/build:override
       (merge (get native/+operators+ :override)
              (get xtalk-ops/+operators+ :override)))
      (grammar/build:extend (get native/+operators+ :define))))

(def +grammar+
  (grammar-api/definition
   {:grammar/id +tag+
    :grammar/version +grammar-version+
    :grammar/release "alpha"
    :grammar/language +language+
    :grammar/tag +tag+
    :grammar/engine {:minimum 1 :maximum 1}
    :grammar/parent {:grammar/id xtalk/+tag+
                     :grammar/version xtalk/+grammar-version+}
    :operators {:override (merge (get native/+operators+ :override)
                                 (get xtalk-ops/+operators+ :override))
                :define (get native/+operators+ :define)}
    :emit native/+emit+}))
