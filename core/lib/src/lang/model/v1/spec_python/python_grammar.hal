(ns lang.model.v1.spec-python.python-grammar
  (:require [lang.base.v1.grammar-spec :as spec]
            [lang.common.grammar :as grammar]
            [lang.common.grammar-api :as grammar-api]
            [lang.model.v1.spec-xtalk :as xtalk]
            [lang.model.v1.spec-python.python-native :as native]
            [lang.model.v1.spec-xtalk.fn-python :as xtalk-ops]))

(def +language+ :python)
(def +tag+ :py)
(def +grammar-version+ spec/+version+)

(def +features+
  (-> (grammar/build)
      (grammar/build:override
       (merge native/+python-native+ xtalk-ops/+python+))
      (grammar/build:extend native/+python-native-definitions+)))

(def +grammar+
  (grammar-api/definition
   {:grammar/id +tag+
    :grammar/version +grammar-version+
    :grammar/release "alpha"
    :grammar/language +language+
    :grammar/tag +tag+
    :grammar/engine {:minimum 1 :maximum 1}
    :grammar/parent {:grammar/id xtalk/+tag+
                     :grammar/version xtalk/+grammar-version+}
    :operators {:override (merge native/+python-native+ xtalk-ops/+python+)
                :define native/+python-native-definitions+}
    :emit native/+emit+}))
