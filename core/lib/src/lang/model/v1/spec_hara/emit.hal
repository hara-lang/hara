(ns lang.model.v1.spec-hara.emit
  (:require [lang.model.spec-hara.hara-emit :as impl]))

;; Stable V1 emitter namespace over the split alpha implementation.
(def +not-handled+ impl/+not-handled+)
(def form impl/form)
(def sanitize-symbol-name impl/sanitize-symbol-name)
(def flatten-symbol impl/flatten-symbol)
(def module-symbol? impl/module-symbol?)
(def mutable-symbol? impl/mutable-symbol?)
(def lower-symbol impl/lower-symbol)
(def definition-symbol impl/definition-symbol)
(def lower-vector impl/lower-vector)
(def lower-map impl/lower-map)
(def lower-set impl/lower-set)
(def return-form? impl/return-form?)
(def var-form? impl/var-form?)
(def var-declaration impl/var-declaration)
(def add-mutable impl/add-mutable)
(def lower-body impl/lower-body)
(def lower impl/lower)
(def emit-form impl/emit-form)
