(def +string-symbols+
  {"blank?" "blank?"
   "capitalize" "capitalize"
   "ends-with?" "ends-with?"
   "escape" "escape"
   "includes?" "includes?"
   "join" "join"
   "last-index-of" "last-index-of"
   "lower-case" "lower-case"
   "replace" "replace"
   "replace-first" "replace-first"
   "split" "split"
   "split-lines" "split-lines"
   "starts-with?" "starts-with?"
   "trim" "trim"
   "trim-newline" "trim-newlines"
   "triml" "trim-left"
   "trimr" "trim-right"
   "upper-case" "upper-case"})

(def +string-evidence+
  {:foundation/repository "zcaudate-xyz/foundation-base"
   :foundation/revision "baa75aabd6a879753d7d5cb07271b1448271e7cb"
   :foundation/route "clojure.string"
   :hara/path "core/lib/src/std/foundation/string.hal"
   :hara/test-path "core/lib/test/std/foundation/string_test.hal"
   :review/status :reviewed})

(defn route-kind
  [name]
  (cond
    (has? +parser-candidates+ name) :referred-symbol
    (has? +jvm-classes+ name) :jvm-class
    :else :namespace))

(defn disposition
  [name]
  (cond
    (= name "clojure.string") :portable-substitute
    (has? +reader-boundaries+ name) :manual-boundary
    (has? +jvm-classes+ name) :host-runtime-adapter
    (has? +host-namespaces+ name) :host-runtime-adapter
    (has? +semantic-namespaces+ name) :semantic-replacement
    (has? +parser-candidates+ name) :obsolete
    (has? +missing-namespaces+ name) :missing
    (has? +reviewed-names+ name) :manual-boundary
    :else :pending))

(defn target
  [name]
  (cond
    (= name "clojure.string") "std.foundation.string"
    (has? +reader-boundaries+ name) "std.block"
    (= name "clojure.data.json") "Json"
    (= name "clojure.set") "std.foundation"
    (= name "clojure.walk") "std.lib.collection"
    :else nil))

(defn safety
  [name]
  (if (= name "clojure.string") :review :manual))

(defn rationale
  [name]
  (cond
    (= name "clojure.string")
    "Portable string surface exists; three historical symbol names require explicit mappings."

    (has? +reader-boundaries+ name)
    "Reader state, pushback, line/column tracking, and host reader objects are structural boundaries."

    (has? +jvm-classes+ name)
    "Imported JVM class or interface is host-specific and is not a portable namespace rewrite."

    (has? +host-namespaces+ name)
    "Host integration requires an explicit runtime capability or adapter."

    (has? +semantic-namespaces+ name)
    "Hara has related semantics, but public-symbol and behavior equivalence is not a namespace rename."

    (has? +parser-candidates+ name)
    "The source item is a referred or publication symbol, not an external namespace dependency."

    (has? +missing-namespaces+ name)
    "No portable Hara target with an evidence-backed public contract was found."

    :else
    "Reviewed as a project-specific boundary with no reusable automatic rewrite."))

(defn review
  [name]
  {:external/name name
   :route/kind (route-kind name)
   :review/disposition (disposition name)
   :review/terminal (not= :pending (disposition name))
   :rewrite/safety (safety name)
   :hara/candidate (target name)
   :review/rationale (rationale name)
   :profile/id (:profile/id +profile+)
   :foundation/revision (:foundation/revision +profile+)})

(defn review-route
  [route]
  (merge route (review (:external/namespace route))))

(defn reviewed?
  [record]
  (and
   (:review/terminal record)
   (not= :pending (:review/disposition record))))

(defn validate-catalog
  []
  (let [records (map review (sort +reviewed-names+))
        pending (vec (filter (fn [record]
                               (not (reviewed? record)))
                             records))]
    {:valid? (empty? pending)
     :names (count records)
     :pending pending
     :portable
     (vec
      (map :external/name
           (filter
            (fn [record]
              (= :portable-substitute
                 (:review/disposition record)))
            records)))}))

(defn string-symbol-target
  [symbol]
  (get +string-symbols+ symbol))

(defn string-symbol-reviewed?
  [symbol]
  (not (nil? (string-symbol-target symbol))))

(defn external-summary
  [routes]
  (let [reviewed (vec (map review-route routes))]
    {:routes (count reviewed)
     :names (count (set (map :external/namespace reviewed)))
     :reviewed (count (filter reviewed? reviewed))
     :pending
     (count
      (filter
       (fn [record]
         (not (reviewed? record)))
       reviewed))
     :by/disposition
     (frequencies (map :review/disposition reviewed))
     :records reviewed}))
