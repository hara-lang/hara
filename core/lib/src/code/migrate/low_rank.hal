(defn library-by-name
  [namespace]
  (first
   (filter
    (fn [library]
      (= namespace (:library/namespace library)))
    +libraries+)))

(defn pending?
  [library]
  (= :pending (:review/status library)))

(defn terminal?
  [library]
  (= :reviewed (:review/status library)))

(defn symbol-review-index
  [library]
  (reduce
   (fn [output review]
     (assoc output (:source/symbol review) review))
   {}
   (:symbol/reviews library)))

(defn unreviewed-symbols
  [library]
  (let [index (symbol-review-index library)]
    (vec
     (sort
      (filter
       (fn [symbol]
         (not (has? index symbol)))
       (:public/symbols library))))))

(defn unexpected-symbol-reviews
  [library]
  (let [public (set (:public/symbols library))]
    (vec
     (sort
      (filter
       (fn [symbol]
         (not (has? public symbol)))
       (keys (symbol-review-index library)))))))

(defn candidate-valid?
  [candidate]
  (and
   (map? candidate)
   (string? (:source/symbol candidate))
   (keyword? (:candidate/kind candidate))
   (= :unreviewed (:candidate/status candidate))
   (= +candidate-evidence-revision+
      (:candidate/evidence-revision candidate))
   (or (nil? (:target/namespace candidate))
       (string? (:target/namespace candidate)))
   (or (nil? (:target/symbol candidate))
       (string? (:target/symbol candidate)))))

(defn symbol-review-valid?
  [library review]
  (and
   (map? review)
   (= :reviewed (:review/status review))
   (string? (:source/symbol review))
   (has? (set (:public/symbols library))
         (:source/symbol review))
   (profile/allowed-disposition?
    +profile+
    (:review/disposition review))
   (not= :pending (:review/disposition review))
   (keyword? (:review/classification review))
   (string? (:review/rationale review))
   (or (nil? (:target/namespace review))
       (string? (:target/namespace review)))
   (or (nil? (:target/symbol review))
       (string? (:target/symbol review)))))

(defn evidence-valid?
  [library]
  (and
   (string? (:library/namespace library))
   (string? (:source/path library))
   (profile/sha? (:source/blob library))
   (string? (:test/path library))
   (profile/sha? (:test/blob library))))

(defn library-errors
  [library]
  (let [unreviewed (unreviewed-symbols library)
        unexpected (unexpected-symbol-reviews library)
        public (:public/symbols library)
        reviews (:symbol/reviews library)]
    (vec
     (concat
      (if (evidence-valid? library)
        []
        [{:type :code.migrate.low-rank/source-test-evidence
          :library (:library/namespace library)}])
      (if (= (count public) (count (set public)))
        []
        [{:type :code.migrate.low-rank/duplicate-public-symbol
          :library (:library/namespace library)}])
      (keep
       (fn [candidate]
         (if (candidate-valid? candidate)
           nil
           {:type :code.migrate.low-rank/invalid-candidate
            :library (:library/namespace library)
            :candidate candidate}))
       (:candidate/matches library))
      (if (profile/allowed-disposition?
           +profile+
           (:review/disposition library))
        []
        [{:type :code.migrate.low-rank/invalid-disposition
          :library (:library/namespace library)
          :disposition (:review/disposition library)}])
      (if (and (pending? library)
               (not (empty? reviews)))
        [{:type :code.migrate.low-rank/pending-has-reviews
          :library (:library/namespace library)}]
        [])
      (if (terminal? library)
        (concat
         (if (empty? unreviewed)
           []
           [{:type :code.migrate.low-rank/unreviewed-symbols
             :library (:library/namespace library)
             :symbols unreviewed}])
         (if (empty? unexpected)
           []
           [{:type :code.migrate.low-rank/unexpected-symbol-reviews
             :library (:library/namespace library)
             :symbols unexpected}])
         (keep
          (fn [review]
            (if (symbol-review-valid? library review)
              nil
              {:type :code.migrate.low-rank/invalid-symbol-review
               :library (:library/namespace library)
               :review review}))
          reviews))
        [])))))

(defn reviewed?
  [library]
  (and
   (terminal? library)
   (empty? (library-errors library))))

(defn validate-catalog
  []
  (let [library-names (map :library/namespace +libraries+)
        errors
        (vec
         (concat
          (if (= (count library-names)
                 (count (set library-names)))
            []
            [{:type :code.migrate.low-rank/duplicate-library}])
          (mapcat library-errors +libraries+)))
        reviewed (vec (filter reviewed? +libraries+))
        pending (vec (filter pending? +libraries+))]
    {:valid? (empty? errors)
     :libraries (count +libraries+)
     :reviewed (count reviewed)
     :pending (vec (map :library/namespace pending))
     :errors errors}))

(def +migration-dispositions+
  #{:portable-substitute
    :semantic-replacement
    :renamed
    :consolidated})

(defn migration-ready?
  [library]
  (and
   (reviewed? library)
   (= :ready (:dry-run/status library))
   (has? +migration-dispositions+
         (:review/disposition library))))

(defn next-review
  []
  (vec
   (map :library/namespace
        (filter pending? +libraries+))))

(defn next-unblocked-migration
  []
  (vec
   (map :library/namespace
        (filter migration-ready? +libraries+))))

(defn plan-unit
  "Produces one canonical dry-run edit for an audited Foundation library unit."
  [namespace unit transform]
  (let [library (library-by-name namespace)]
    (if (nil? library)
      (throw
       (ex :code.migrate.low-rank/unknown-library
           {:ex/message "Low-rank migration plan names an unknown library"
            :library/namespace namespace})))
    (framework/transform-code
     unit
     transform
     {:rules
      [(keyword
        (str "foundation-low-rank/" namespace))]
      :provenance
      {:profile/id (:profile/id +profile+)
       :foundation/revision (:foundation/revision +profile+)
       :library/namespace namespace
       :source/blob (:source/blob library)
       :test/blob (:test/blob library)}})))

(defn plan-pair
  "Plans paired source and historical-test transformations through code.framework."
  ([namespace source-unit test-unit transform]
   (plan-pair namespace
              source-unit transform
              test-unit transform))
  ([namespace source-unit source-transform test-unit test-transform]
   [(plan-unit namespace source-unit source-transform)
    (plan-unit namespace test-unit test-transform)]))

(defn second-pass
  [edit transform]
  (framework/transform-code
   {:path (:path edit)
    :source (:after edit)}
   transform
   {:provenance
    {:profile/id (:profile/id +profile+)
     :pass 2}}))

(defn unchanged-second-pass?
  [edit transform]
  (not (:changed (second-pass edit transform))))

(defn catalog-document
  []
  (let [validation (validate-catalog)]
    {:document/type :code-migrate-low-rank-review
     :document/version 1
     :profile/id (:profile/id +profile+)
     :foundation/repository (:foundation/repository +profile+)
     :foundation/revision (:foundation/revision +profile+)
     :foundation/tree (:foundation/tree +profile+)
     :library/count (count +libraries+)
     :reviewed/count (:reviewed validation)
     :pending/count (count (:pending validation))
     :next/review (next-review)
     :next/unblocked-migration (next-unblocked-migration)
     :libraries +libraries+}))

(defn catalog-source
  []
  (str (corpus/render-edn (catalog-document)) "\n"))

(defn report-source
  []
  (let [validation (validate-catalog)]
    (str
     "# Foundation low-rank library review: `foundation-baa75a`\n\n"
     "- Pinned revision: `" (:foundation/revision +profile+) "`\n"
     "- Libraries: " (count +libraries+) "\n"
     "- Reviewed libraries: " (:reviewed validation) "\n"
     "- Pending libraries: " (count (:pending validation)) "\n"
     "- Public symbols: "
     (reduce + 0 (map (fn [library]
                        (count (:public/symbols library)))
                      +libraries+))
     "\n\n"
     "## Next review\n\n"
     (str/join
      ""
      (map (fn [namespace]
             (str "- `" namespace "`\n"))
           (next-review)))
     "\n## Next unblocked migration\n\n"
     (str/join
      ""
      (map (fn [namespace]
             (str "- `" namespace "`\n"))
           (next-unblocked-migration)))
     "\n## Reviewed boundaries\n\n"
     "- `std.lib.function`: manual/host-only; no automatic rewrite.\n"
     "- `std.lib.walk`: consolidated across `std.foundation` and `std.lib.collection`.\n"
     "- `std.lib.zip`: adapted same-namespace result owned by #555 and consumed by #556.\n")))
