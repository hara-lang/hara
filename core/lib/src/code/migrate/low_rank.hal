(defn candidate-record
  [symbol kind target-namespace target-symbol]
  {:source/symbol symbol
   :candidate/kind kind
   :candidate/status :unreviewed
   :candidate/evidence-revision +candidate-evidence-revision+
   :target/namespace target-namespace
   :target/symbol target-symbol})

(def +foundation-candidates+
  (vec
   (map
    (fn [symbol]
      (candidate-record symbol :same-name "std.foundation" symbol))
    +foundation-candidate-symbols+)))

(def +collection-candidates+
  (vec
   (concat
    (map
     (fn [symbol]
       (candidate-record symbol :moved "std.foundation" symbol))
     +collection-moved-candidate-symbols+)
    (map
     (fn [symbol]
       (candidate-record symbol :similar nil nil))
     +collection-similar-candidate-symbols+))))

(defn function-symbol-review
  [symbol]
  (let [host-only? (has? +function-host-symbols+ symbol)]
    {:source/symbol symbol
     :review/status :reviewed
     :review/classification (if host-only? :host-only :manual)
     :review/disposition
     (if host-only? :host-runtime-adapter :manual-boundary)
     :target/namespace nil
     :target/symbol nil
     :review/rationale
     (if host-only?
       "Foundation behavior depends on JVM function classes, interfaces, arity reflection, or RestFn."
       "The helper constructs or rewrites function forms and requires a reviewed structural migration.")}))

(def +function-reviews+
  (vec (map function-symbol-review (sort +function-symbols+))))

(defn walk-symbol-review
  [symbol]
  (let [target
        (cond
          (has? +walk-foundation-symbols+ symbol) "std.foundation"
          (has? +walk-collection-symbols+ symbol) "std.lib.collection"
          :else nil)]
    {:source/symbol symbol
     :review/status :reviewed
     :review/classification :consolidated
     :review/disposition :consolidated
     :target/namespace target
     :target/symbol symbol
     :review/rationale
     "The retired walk namespace is split between portable structural walk and collection-key traversal ownership."}))

(def +walk-reviews+
  (vec (map walk-symbol-review (sort +walk-symbols+))))

(defn zip-symbol-review
  [symbol]
  {:source/symbol symbol
   :review/status :reviewed
   :review/classification :adapted
   :review/disposition :semantic-replacement
   :target/namespace "std.lib.zip"
   :target/symbol symbol
   :review/rationale
   "The public symbol is retained in the current Hara zipper, while implementation and protocol boundaries are adapted."})

(def +zip-reviews+
  (vec (map zip-symbol-review (sort +zip-symbols+))))

