    :review/shape :unreviewed
    :symbol/reviews []
    :dry-run/status :not-planned
    :target/evidence
    {:target/path "core/lib/src/std/foundation.hal"
     :target/blob "87d4b9c5bd650de2e64b40163a2434ce17c55505"
