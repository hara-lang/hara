(ns code.translate.rules)

(def +foundation-revision+
  "baa75aabd6a879753d7d5cb07271b1448271e7cb")

(defn evidence
  [foundation-path hara-path note]
  [{:foundation/repository "zcaudate-xyz/foundation-base"
    :foundation/revision +foundation-revision+
    :foundation/path foundation-path
    :hara/path hara-path
    :note note}])

(def +rules+
  [{:id :namespace/std-protocol-block
    :kind :token
    :match {:text "std.protocol.block"}
    :rewrite {:op :replace-token
              :text "std.block.protocol"}
    :safety :safe
    :priority 100
    :message "Use the portable block protocol namespace."
    :evidence
    (evidence "src/std/protocol/block.clj"
              "core/lib/src/std/block/protocol.hal"
              "Foundation's JVM interfaces are represented by std.block.protocol in Hara.")}

   {:id :namespace/std-block-navigation
    :kind :token
    :match {:text "std.block.navigate"}
    :rewrite {:op :replace-token
              :text "std.block.navigation"}
    :safety :safe
    :priority 110
    :message "Use the source-preserving std.block.navigation namespace."
    :evidence
    (evidence "src/std/block/navigate.clj"
              "core/lib/src/std/block/navigation.hal"
              "The reviewed Hara port gives the navigation boundary an explicit noun name.")}

   {:id :namespace/std-lib-foundation
    :kind :token
    :match {:text "std.lib.foundation"}
    :rewrite {:op :replace-token
              :text "std.foundation"}
    :safety :review
    :priority 120
    :message "Review the consolidated std.foundation import surface."
    :evidence
   (evidence "src/std/lib/zip.clj"
              "core/lib/src/std/lib/zip.hal"
              "Hara consolidates Foundation helper imports under std.foundation.")}

   {:id :dependency/std-foundation-refer-all
    :kind :dependency-entry
    :match {:text "std.foundation"}
    :match/when {:parent-contains ":refer :all"}
    :rewrite {:op :delete-parent}
    :safety :safe
    :priority 125
    :message "Remove the redundant std.foundation :refer :all dependency from native Hara source."
    :evidence
    (evidence "src/std/lib/foundation.clj"
              "core/lib/src/std/foundation.hal"
              "Native Hara exposes the Foundation surface without an explicit refer-all dependency.")}

   {:id :namespace/std-lib-walk
    :kind :token
    :match {:text "std.lib.walk"}
    :rewrite {:op :replace-token
              :text "std.foundation"}
    :safety :review
    :priority 130
    :message "Review whether std.lib.walk usage is covered by std.foundation."
    :evidence
   (evidence "src/std/lib/zip.clj"
              "core/lib/src/std/lib/zip.hal"
              "The portable zipper no longer depends on a separate std.lib.walk namespace.")}

   {:id :dependency/std-lib-test
    :kind :token
    :match {:text "std.lib.test"}
    :safety :manual
    :priority 190
    :message "Translate legacy test/check forms into canonical code.test facts and built-in assertions."
    :evidence
    (evidence "test/std/lib/context/registry_test.clj"
              "core/lib/src/code/test.hal"
              "Canonical Hara tests register code.test facts instead of collecting std.lib.test result vectors.")}

   {:id :host/clojure-tools-reader
    :kind :token
    :match {:text "clojure.tools.reader"}
    :safety :manual
    :priority 200
    :message "Choose the Hara parser or an explicit host reader adapter."
    :evidence
    (evidence "src/std/block/parse.clj"
              "core/lib/src/std/block/parse.hal"
              "The Hara parser is portable and does not mechanically import clojure.tools.reader.")}

   {:id :host/clojure-tools-reader-types
    :kind :token
    :match {:text "clojure.tools.reader.reader-types"}
    :safety :manual
    :priority 210
    :message "Replace JVM reader types with an explicit portable reader adapter."
    :evidence
    (evidence "src/std/block/reader.clj"
              "core/lib/src/std/block/reader.hal"
              "Reader state is implemented by the portable std.block.reader surface.")}

   {:id :form/definterface
    :kind :form-head
    :match {:text "definterface"}
    :safety :manual
    :priority 300
    :message "Translate JVM interfaces into a reviewed portable protocol contract."
    :evidence
    (evidence "src/std/protocol/block.clj"
              "core/lib/src/std/block/protocol.hal"
              "The IBlock interfaces require semantic protocol review rather than text substitution.")}

   {:id :form/defrecord
    :kind :form-head
    :match {:text "defrecord"}
    :safety :manual
    :priority 310
    :message "Translate records and host object methods into a reviewed portable struct."
    :evidence
    (evidence "src/std/lib/zip.clj"
              "core/lib/src/std/lib/zip.hal"
              "Foundation's Zipper record becomes a portable struct with explicit display behavior.")}

   {:id :form/deftype
    :kind :form-head
    :match {:text "deftype"}
    :safety :manual
    :priority 320
    :message "Translate host type implementations into reviewed structs and protocol extensions."
    :evidence
    (evidence "src/std/block/type.clj"
              "core/lib/src/std/block/type.hal"
              "JVM deftype implementations become a portable Block struct and protocol extension.")}

   {:id :form/defmulti
    :kind :form-head
    :match {:text "defmulti"}
    :safety :manual
    :priority 330
    :message "Replace multimethod dispatch with an explicit reviewed Hara dispatch boundary."
    :evidence
    (evidence "src/std/block/parse.clj"
              "core/lib/src/std/block/parse.hal"
              "Parser dispatch is expressed directly in the portable Hara parser.")}

   {:id :form/defmethod
    :kind :form-head
    :match {:text "defmethod"}
    :safety :manual
    :priority 340
    :message "Fold method cases into the reviewed Hara dispatch implementation."
    :evidence
    (evidence "src/std/block/parse.clj"
              "core/lib/src/std/block/parse.hal"
              "Foundation parser methods are represented by explicit portable parser branches.")}

   {:id :form/print-method
    :kind :form-head
    :match {:text "defmethod"}
    :match/when {:second "print-method"}
    :safety :manual
    :priority 350
    :message "Remove JVM print-method integration or replace it with explicit portable display data."
    :evidence
    (evidence "src/std/lib/zip.clj"
              "core/lib/src/std/lib/zip.hal"
              "The portable zipper exposes display data instead of java.io.Writer integration.")}])
