;; Hara host-side successor to Foundation code.manage.  Workflows are pure
;; until a host explicitly applies their returned edits with :write true.
(ns code.manage
  (:require [code.framework :as framework]
            [std.foundation.string :as string]
            [std.work :as work]
            [std.work.command :as command]))

(defn analyse [unit] (merge {:path (:path unit)} (framework/analyse-source (:source unit))))
(defn extract [unit] (:definitions (analyse unit)))
(defn vars [unit] (vec (map (fn [entry] (:source entry)) (extract unit))))
(defn docstrings [unit] (:docstrings (analyse unit)))
(defn grep [unit needle] (framework/grep-source (:source unit) needle))

(defn transform-code
  [unit transform]
  (let [before (:source unit)
        after (transform before)]
    {:path (:path unit)
     :changed (not= before after)
     :before before
     :after after
     :write false}))

(defn grep-replace
  [unit match replacement]
  (transform-code unit (fn [source] (string/replace source match replacement))))

(defn heal-code [unit]
  (transform-code unit (fn [source] (str (string/trim-right source) "\n"))))

(defn unclean [unit]
  (if (= (:source unit) (:after (heal-code unit))) [] [(:path unit)]))

(defn incomplete [unit]
  (grep unit "TODO"))

(defn commented
  "Returns comment-only lines so callers can decide whether to remove them."
  [unit]
  (vec (filter (fn [entry]
                 (string/starts-with? (string/trim (:text entry)) ";"))
               (framework/grep-source (:source unit) ";"))))

(defn unclean-findings
  "Reports normalisation issues without modifying the source."
  [unit]
  (let [lines (string/split-lines (:source unit))
        trailing (loop [index 0 output []]
                   (if (= index (count lines))
                     output
                     (let [line (nth lines index)]
                       (recur (inc index)
                              (if (not= line (string/trim-right line))
                                (conj output {:path (:path unit)
                                              :line (inc index)
                                              :kind :trailing-whitespace})
                                output)))))]
    (if (string/ends-with? (:source unit) "\n")
      trailing
      (conj trailing {:path (:path unit) :kind :missing-final-newline}))))

(defn incomplete-report [units]
  (into {}
        (map (fn [unit] [(:path unit) (incomplete unit)]) units)))

(defn maintenance-work
  [operation]
  (command/batch
   {:id (keyword (str "code.manage/" (name operation)))
    :version 1}
   {:list (work/pure :list-units (fn [input context] (:units input)))
    :process (work/pure :process-unit
                        (fn [unit context]
                          (cond (= operation :analyse) (analyse unit)
                                (= operation :extract) (extract unit)
                                (= operation :vars) (vars unit)
                                (= operation :docstrings) (docstrings unit)
                                (= operation :incomplete) (incomplete unit)
                                (= operation :todos) (incomplete unit)
                                (= operation :commented) (commented unit)
                                (= operation :unclean) (unclean unit)
                                (= operation :unclean-findings) (unclean-findings unit)
                                :else (throw (ex-info "Unsupported code.manage workflow" {:operation operation})))))
    :summarise (work/pure :summarise
                          (fn [batch context]
                            {:operation operation
                             :count (count (:results batch))}))}))

(defn run
  [operation input]
  (work/run (work/local-runtime) (maintenance-work operation) input))
