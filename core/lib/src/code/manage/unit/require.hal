(ns code.manage.unit.require
  (:require [code.manage.unit :as unit]
            [code.manage.unit.template :as template]))

(defn require-file
  [code-unit]
  (vec
   (map
    (fn [entry]
      (symbol (:name entry)))
    (filter
     (fn [entry]
       (not= (:kind entry) :private-function))
     (unit/extract code-unit)))))

(def require-file-unit
  (template/code-tasklet
   :require-file
   (fn [code-unit options]
     (require-file code-unit))))
