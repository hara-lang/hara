(ns code.manage.unit.snapto
  (:require [code.manage.unit :as unit]
            [code.manage.unit.template :as template]))

(defn snapto
  [code-unit options]
  (unit/refactor-code code-unit options))

(def snapto-unit
  (template/code-tasklet
   :snapto
   (fn [code-unit options]
     (snapto code-unit options))))
