(ns code.manage.unit.test-doc
  (:require [code.framework :as framework]
            [code.manage.unit.scaffold :as scaffold]
            [code.manage.unit.structure :as structure]
            [std.block.parse :as parse]
            [tool.lint.analyze :as lint]
            [tool.project :as project]))

(def +document-format+ "code.manage.test-doc/1")

(defn form-name
  [source form]
  (framework/form-head source form))

(defn form-definition-name
  [source form]
  (let [head (form-name source form)
        children (framework/semantic-children source form)]
    (if (or (= head "def") (= head "defonce"))
      (if (< 1 (count children))
        (str (:value (nth children 1)))
        nil)
      nil)))

(defn results-parent?
  [parent]
  (and (or (= "def" (:head parent))
           (= "defonce" (:head parent)))
       (= "results" (:name parent))))

(defn results-facts
  [source path form]
  (if (not (results-parent? {:head (form-name source form)
                             :name (form-definition-name source form)}))
    []
    (vec
     (keep
      (fn [record]
        (if (= :vector (:tag record))
          (first
           (keep
            (fn [nested]
              (let [fact (structure/fact-record source path nested false)]
                (if fact (assoc fact :nested true :results true) nil)))
            (framework/form-records-in source (:block record) (:start record))))
          nil))
      (framework/child-records source (:block form) (:start form))))))

(defn facts
  [unit]
  (let [source (:source unit)
        path (:path unit)
        forms (:form-records (framework/analyse-structure source))
        direct (structure/facts-from-source source path)
        nested (reduce (fn [output form]
                         (into output (results-facts source path form)))
                       [] forms)]
    (vec (concat direct nested))))

(defn symbols-in
  [value]
  (cond
    (symbol? value) [(str value)]
    (map? value)
    (reduce
     (fn [output entry]
       (into output (symbols-in (first entry)) (symbols-in (second entry))))
     []
     value)
    (or (vector? value) (list? value) (set? value))
    (reduce (fn [output child] (into output (symbols-in child))) [] value)
    :else []))

(defn qualified-symbol?
  [value]
  (and (str/includes? value "/")
       (not (str/starts-with? value "/"))))

(defn resolve-symbol
  [aliases value]
  (if (not (qualified-symbol? value))
    nil
    (let [parts (str/split value "/")
          qualifier (first parts)
          member (second parts)
          namespace (get aliases (symbol qualifier))]
      (if namespace
        (str namespace "/" member)
        value))))

(defn inferred-refer
  [source fact]
  (let [aliases (:aliases (lint/namespace-info (parse/parse-string source)))
        candidates
        (vec
         (distinct
          (keep
           (fn [value] (resolve-symbol aliases value))
           (symbols-in (:value (:form fact))))))]
    (if (= 1 (count candidates))
      (first candidates)
      nil)))

(defn document-fact
  [source fact]
  (let [existing (:refer fact)
        inferred (if existing nil (inferred-refer source fact))
        refer (or existing inferred)]
    {:title (:title fact)
     :refer refer
     :inference (if existing :metadata (if inferred :qualified-call :unresolved))
     :added (:added fact)
     :checked (:checked fact)
     :commented (:commented fact)
     :nested (:nested fact)
     :results (:results fact)
     :source (:text fact)}))

(defn noncanonical-fact?
  [fact]
  (or (nil? (:refer fact)) (:results fact)))

(defn ns-form
  [source]
  (first
   (filter
    (fn [form]
      (let [head (form-name source form)]
        (or (= head "ns") (= head "ns+"))))
    (:form-records (framework/analyse-structure source)))))

(defn document
  [unit]
  (let [source (:source unit)
        all-facts (facts unit)
        entries (vec (map (fn [fact] (document-fact source fact)) all-facts))
        noncanonical (vec (filter noncanonical-fact? entries))
        ns-record (ns-form source)]
    (if (empty? noncanonical)
      nil
      {:format +document-format+
       :path (:path unit)
       :namespace (framework/namespace-name source)
       :namespace-form (if ns-record (:text ns-record) nil)
       :facts entries
       :noncanonical (count noncanonical)
       :unresolved (count (filter (fn [fact] (nil? (:refer fact))) entries))})))

(defn document-source
  [unit]
  (let [value (document unit)]
    (if value (str (pr-str value) "\n") nil)))

(defn metadata-source
  [fact]
  (let [metadata (cond-> {:refer (symbol (:refer fact))}
                   (:added fact) (assoc :added (:added fact)))]
    (str "^" (pr-str metadata))))

(defn render-fact
  [fact]
  (if (nil? (:refer fact))
    (throw (ex-info "cannot render an unresolved test fact" {:fact fact}))
    (str (metadata-source fact) "\n" (:source fact))))

(defn render
  [document]
  (let [unresolved (filter (fn [fact] (nil? (:refer fact))) (:facts document))]
    (if (not (empty? unresolved))
      (throw (ex-info "cannot render a test document with unresolved facts"
                      {:path (:path document) :unresolved (count unresolved)}))
      (str (:namespace-form document)
           "\n\n"
           (str/join "\n\n" (map render-fact (:facts document)))
           "\n\n"
           (scaffold/runner-form (:namespace document))
           "\n"))))

(defn replace-suffix
  [path suffix replacement]
  (if (str/ends-with? path suffix)
    (str (str/slice path 0 (- (str/length path) (str/length suffix))) replacement)
    path))

(defn target-path
  [path test-root output-root suffix]
  (if (not (str/starts-with? path test-root))
    (throw (ex-info "test path is not under the supplied test root"
                    {:path path :test-root test-root}))
    (let [relative (str/slice path (str/length test-root) (str/length path))]
      (File/join output-root (replace-suffix relative ".hal" suffix)))))

(defn test-units
  [test-root]
  (vec
   (keep
    (fn [path]
      (if (and (not (str/includes? path "/.#"))
               (str/ends-with? path "_test.hal")
               (str/includes? (project/read-text path) "code.test"))
        {:path path :source (project/read-text path)}
        nil))
    (project/walk-files test-root))))

(defn write-text!
  [path source]
  (let [parent (File/parent path)]
    (if parent (deref (File/mkdir parent)) nil)
    (deref (File/write path (str/encode-utf8 source)))
    path))

(defn export-one!
  [unit options]
  (let [document (document unit)]
    (if (nil? document)
      {:path (:path unit) :status :canonical}
      (let [test-root (:test-root options)
            document-path (target-path (:path unit) test-root (:document-root options) ".edn")
            generated-path (target-path (:path unit) test-root (:generated-root options) ".hal")
            unresolved (:unresolved document)]
        (write-text! document-path (str (pr-str document) "\n"))
        (if (= 0 unresolved)
          (do (write-text! generated-path (render document))
              {:path (:path unit) :status :generated
               :document-path document-path :generated-path generated-path})
          {:path (:path unit) :status :unresolved
           :document-path document-path :unresolved unresolved})))))

(defn export!
  [test-root options]
  (let [required [:document-root :generated-root]
        missing (vec (filter (fn [key] (nil? (get options key))) required))]
    (if (not (empty? missing))
      (throw (ex-info "test document export requires output roots" {:missing missing}))
      (vec (map (fn [unit] (export-one! unit (assoc options :test-root test-root)))
                (test-units test-root))))))
