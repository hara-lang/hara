(ns code.manage.unit.import
  (:refer-clojure :exclude [import])
  (:require [code.manage.unit :as unit]
            [code.manage.unit.template :as template]))

(defn import-unit
  [code-unit options]
  (let [form (:form options)]
    (if (or (nil? form)
            (str/blank? (str form)))
      (unit/transform-code code-unit identity)
      (unit/transform-code
       code-unit
       (fn [source]
         (str (str/trim-right source)
              "\n"
              form
              "\n"))))))

(def import import-unit)

(def import-tasklet
  (template/code-tasklet
   :import
   (fn [code-unit options]
     (import-unit code-unit options))))
