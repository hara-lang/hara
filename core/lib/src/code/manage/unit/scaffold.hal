(ns code.manage.unit.scaffold)

(defn test-path-for
  [code-unit options]
  (or (:test-path options)
      (:test-path code-unit)
      (str/replace (:path code-unit)
                   ".hal"
                   "_test.hal")))

(defn test-namespace-for
  [code-unit options source-namespace]
  (or (:test-namespace options)
      (symbol (str source-namespace "-test"))))

(defn scaffold-source
  [source-namespace test-namespace alias]
  (str "(ns " test-namespace "\n"
       "  (:use code.test)\n"
       "  (:require [" source-namespace " :as " alias "]))\n\n"
       "(fact \"scaffolded test\" true => true)\n"))
