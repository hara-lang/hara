(ns code.manage.unit.isolate
  (:require [code.manage.unit :as unit]))

(defn isolate
  [code-unit options]
  (let [needle (or (:needle options) "(fact")
        selected
        (filter
         (fn [line]
           (or
            (str/starts-with?
             (str/trim line)
             "(ns ")
            (str/includes? line needle)))
         (str/split-lines
          (:source code-unit)))]
    (unit/transform-code
     code-unit
     (fn [source]
       (str
        (str/join "\n" selected)
        "\n")))))
