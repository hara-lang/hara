(ns code.manage.ns-rename
  (:require [code.manage.unit :as unit]))

(defn ns-rename
  [code-unit options]
  (let [old (:from options)
        new (:to options)]
    (if (or (nil? old)
            (nil? new))
      (unit/transform-code
       code-unit
       identity)
      (unit/grep-replace
       code-unit
       (str old)
       (str new)))))
