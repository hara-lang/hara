(ns code.translate
  (:require [std.foundation :refer :all]
            [std.work :as work]
            [std.work.command :as command]
            [code.translate.clojure :as clj]
            [code.translate.rule :as rule]
            [code.translate.rules :as declarations]))

(def rules rule/+ruleset+)
(def declarations declarations/+rules+)
(def compile-rules rule/compile-rules)
(def rule-by-id rule/rule-by-id)
(def rules-summary rule/rules-summary)
(def matches rule/matches)
(def analyze-source rule/analyze-source)
(def lint-source rule/lint-source)
(def translate-source rule/translate-source)

(def source-path clj/source-path)
(def target-path clj/target-path)
(def source-unit clj/source-unit)
(def source-summary clj/source-summary)
(def namespace-name
  (fn [input]
    (:namespace (clj/source-summary input))))
(def dependencies clj/dependencies)
(def public-symbols clj/public-symbols)
(def analyze-source-unit clj/analyze-source-unit)
(def lint-source-unit clj/lint-source-unit)
(def translate-source-unit clj/translate-source-unit)
(def migrate-source-unit clj/migrate-source-unit)
(def run-unit clj/run-unit)

(def task-id :code.translate/clojure-to-hal-project)
(def task-version 1)

(def +terminal-statuses+
  #{:exact :ported :obsolete})

(def +blocking-diagnostic-types+
  #{:code.translate/ambiguous
    :code.translate/conflict
    :code.translate/unsupported})

(defn field
  [value keys]
  (loop [remaining keys]
    (if (empty? remaining)
      nil
      (let [key (first remaining)]
        (if (and (map? value)
                 (has? value key))
          (get value key)
          (recur (vec (rest remaining))))))))

(defn keyword-value
  [value]
  (if (string? value)
    (keyword value)
    value))

(defn input-units
  [input]
  (cond
    (and (map? input) (has? input :units))
    (vec (or (:units input) []))

    (and (map? input) (has? input :unit))
    [(:unit input)]

    (vector? input)
    input

    (nil? input)
    []

    :else
    [input]))

(defn input-options
  [input]
  (merge
   {:mode :lint}
   (if (map? input)
     (or (:translation/options input)
         (:options input)
         {})
     {})))

(defn input-selection
  [input]
  (if (map? input)
    (or (:selection input) {})
    {}))

(defn corpus-entries
  [input]
  (if (map? input)
    (let [corpus (:corpus input)]
      (cond
        (vector? corpus) corpus
        (map? corpus) (vec (or (field corpus
                                      [:namespaces "namespaces"])
                                []))
        (has? input :corpus/namespaces)
        (vec (or (:corpus/namespaces input) []))
        :else []))
    []))

(defn entry-source-path
  [entry]
  (field entry
         [:source/path :source_path
          "source/path" "source_path"]))

(defn entry-target-path
  [entry]
  (field entry
         [:target/path :target_path
          "target/path" "target_path"]))

(defn entry-namespace
  [entry]
  (field entry
         [:source/namespace :corpus/namespace :namespace
          "source/namespace" "corpus/namespace" "namespace"]))

(defn entry-target-namespace
  [entry]
  (field entry
         [:target/namespace :target_namespace
          "target/namespace" "target_namespace"]))

(defn unit-namespace
  [unit]
  (field unit
         [:source/namespace :corpus/namespace :namespace
          "source/namespace" "corpus/namespace" "namespace"]))

(defn find-corpus-entry
  [entries unit]
  (let [path (clj/source-path unit)
        namespace (unit-namespace unit)]
    (first
     (filter
      (fn [entry]
        (or (and path
                 (= path (entry-source-path entry)))
            (and namespace
                 (= namespace (entry-namespace entry)))))
      entries))))

(defn dependency-component
  [unit entry namespace]
  (vec
   (or
    (field unit
           [:dependency/component :dependency_component
            "dependency/component" "dependency_component"])
    (field entry
           [:dependency/component :dependency_component
            "dependency/component" "dependency_component"])
    (if namespace [namespace] []))))

(defn prepare-unit
  [unit options entries]
  (let [entry (find-corpus-entry entries unit)
        source-path
        (or (clj/source-path unit)
            (entry-source-path entry))
        target-path
        (or (:target/path unit)
            (entry-target-path entry))
        namespace
        (or (unit-namespace unit)
            (entry-namespace entry))
        target-namespace
        (or (field unit
                   [:target/namespace :target_namespace
                    "target/namespace" "target_namespace"])
            (entry-target-namespace entry))
        status
        (keyword-value
         (or
          (field unit
                 [:corpus/status :status
                  "corpus/status" "status"])
          (field entry
                 [:corpus/status :status
                  "corpus/status" "status"])))
        rank
        (or
         (field unit
                [:dependency/rank :dependency_rank
                 "dependency/rank" "dependency_rank"])
         (field entry
                [:dependency/rank :dependency_rank
                 "dependency/rank" "dependency_rank"]))
        cycle
        (or
         (field unit
                [:dependency/cycle :dependency_cycle
                 "dependency/cycle" "dependency_cycle"])
         (field entry
                [:dependency/cycle :dependency_cycle
                 "dependency/cycle" "dependency_cycle"])
         false)
        component
        (dependency-component unit entry namespace)]
    (merge
     unit
     {:source/path source-path
      :target/path target-path
      :source/namespace namespace
      :target/namespace target-namespace
      :corpus/status status
      :corpus/match
      (or
       (field unit
              [:corpus/match :match
               "corpus/match" "match"])
       (field entry
              [:corpus/match :match
               "corpus/match" "match"]))
      :dependency/rank rank
      :dependency/component component
      :dependency/cycle (= true cycle)
      :translation/options
      (merge
       (or (:translation/options unit) {})
       options)})))

(defn component-key
  [unit]
  (str/join "|" (:dependency/component unit)))

(defn order-key
  [unit]
  [(or (:dependency/rank unit) 2147483647)
   (component-key unit)
   (or (:source/namespace unit) "")
   (or (clj/source-path unit) "")])

(defn order-units
  [units]
  (vec (sort-by order-key units)))

(defn criterion
  [selection keys]
  (field selection keys))

(defn criterion-match?
  [expected actual]
  (cond
    (nil? expected) true
    (coll? expected)
    (not
     (empty?
      (filter
       (fn [value] (= value actual))
       expected)))
    :else (= expected actual)))

(defn rule-identifiers
  [unit]
  (try
    (vec
     (map
      :rule/id
      (:rules/matched
       (clj/lint-source-unit unit))))
    (catch Throwable error
      [])))

(defn rule-selection-match?
  [selection unit]
  (let [required
        (criterion selection
                   [:rule-ids :rules :requires-rules
                    "rule-ids" "rules" "requires-rules"])]
    (if (nil? required)
      true
      (let [required
            (if (coll? required) (vec required) [required])
            matched (rule-identifiers unit)
            mode
            (or
             (field selection
                    [:rule-match "rule-match"])
             :any)]
        (if (= mode :all)
          (every?
           (fn [identifier]
             (not
              (empty?
               (filter
                (fn [matched-id]
                  (= identifier matched-id))
                matched))))
           required)
          (not
           (empty?
            (filter
             (fn [identifier]
               (not
                (empty?
                 (filter
                  (fn [matched-id]
                    (= identifier matched-id))
                  matched))))
             required))))))))

(defn selected-unit?
  [selection unit]
  (let [include?
        (field selection [:include? "include?"])
        exclude?
        (field selection [:exclude? "exclude?"])]
    (and
     (criterion-match?
      (criterion selection
                 [:source-paths :paths
                  "source-paths" "paths"])
      (clj/source-path unit))
     (criterion-match?
      (criterion selection
                 [:namespaces
                  "namespaces"])
      (:source/namespace unit))
     (criterion-match?
      (criterion selection
                 [:corpus-statuses :statuses
                  "corpus-statuses" "statuses"])
      (:corpus/status unit))
     (criterion-match?
      (criterion selection
                 [:dependency-ranks :ranks
                  "dependency-ranks" "ranks"])
      (:dependency/rank unit))
     (rule-selection-match? selection unit)
     (if include? (include? unit) true)
     (if exclude? (not (exclude? unit)) true))))

(defn prepare-units
  [input]
  (if (and (map? input)
           (:code.translate/prepared input))
    (vec (:units input))
    (let [options (input-options input)
          selection (input-selection input)
          entries (corpus-entries input)]
      (vec
       (filter
        (fn [unit]
          (selected-unit? selection unit))
        (order-units
         (map
          (fn [unit]
            (prepare-unit unit options entries))
          (input-units input))))))))

(defn batch-records
  [batch]
  (vec
   (map
    (fn [item]
      (:item/value item))
    (:results batch))))

(defn record-error?
  [record]
  (or
   (= :error (:status record))
   (= :critical (:status record))))

(defn task-summary
  [batch]
  (let [records (batch-records batch)]
    {:operation task-id
     :selected (count records)
     :processed (count records)
     :returned
     (count
      (filter
       (fn [record]
         (= :return (:status record)))
       records))
     :warnings
     (count
      (filter
       (fn [record]
         (= :warn (:status record)))
       records))
     :errors
     (count
      (filter record-error? records))}))

(def migration-work
  (command/batch
   {:id task-id
    :version task-version
    :task/schema "code.translate.project/0-alpha"
    :task/tasklet 'code.translate.clojure/migrate-source-unit}
   {:list
    (work/pure
     :code.translate/list-source-units
     (fn [input context]
       (prepare-units input)))
    :process clj/migrate-source-unit
    :batch-options {:item-key clj/source-path}
    :summarise
    (work/pure
     :code.translate/summarise-project
     (fn [batch context]
       (task-summary batch)))}))

(def task-work migration-work)
(def clojure-to-hal migration-work)

(defn run
  ([input]
   (run (work/local-runtime) input))
  ([runtime input]
   (work/run runtime migration-work input)))

(defn record-index
  [records]
  (reduce
   (fn [output record]
     (assoc output (:item/id record) record))
   {}
   records))

(defn plan-items
  [units records]
  (let [index (record-index records)]
    (vec
     (map
      (fn [unit]
        (let [record (get index (clj/source-path unit))
              result (:data record)]
          {:item/id (clj/source-path unit)
           :unit unit
           :record record
           :result result
           :namespace
           (or (:namespace result)
               (:source/namespace unit))
           :corpus/status (:corpus/status unit)
           :dependency/rank (:dependency/rank unit)
           :dependency/component
           (:dependency/component unit)
           :dependency/cycle
           (:dependency/cycle unit)}))
      units))))

(defn result-edit?
  [result]
  (and
   (map? result)
   (has? result :after)))

(defn item-diagnostics
  [item]
  (vec
   (or
    (:diagnostics (:result item))
    [])))

(defn item-rules
  [item key]
  (vec
   (or
    (get (:result item) key)
    [])))

(defn plan-edits
  [items]
  (vec
   (keep
    (fn [item]
      (let [result (:result item)]
        (if (result-edit? result)
          result
          nil)))
    items)))

(defn write-intent
  [item]
  (let [unit (:unit item)
        result (:result item)]
    {:path (:target/path result)
     :source/path (:source/path result)
     :source/text (:source/text result)
     :source/sha256 (:source/sha256 result)
     :target/root (:target/root result)
     :target/sha256
     (field unit
            [:target/sha256 :target_sha256
             "target/sha256" "target_sha256"])
     :before (:before result)
     :after (:after result)
     :changed (:changed result)
     :create (:create result)
     :namespace (:namespace result)
     :diagnostics (:diagnostics result)
     :provenance (:provenance result)}))

(defn write-intents
  [items]
  (vec
   (keep
    (fn [item]
      (let [result (:result item)]
        (if (result-edit? result)
          (write-intent item)
          nil)))
    items)))

(defn flatten-diagnostics
  [items]
  (reduce
   (fn [output item]
     (into output (item-diagnostics item)))
   []
   items))

(defn count-by
  [values key-function]
  (reduce
   (fn [output value]
     (let [key (key-function value)]
       (assoc output key
              (inc (or (get output key) 0)))))
   {}
   values))

(defn sorted-unique
  [values]
  (vec
   (sort
    (keys
     (reduce
      (fn [output value]
        (if (nil? value)
          output
          (assoc output value true)))
      {}
      values)))))

(defn namespaces-by
  [items key-function]
  (reduce
   (fn [output item]
     (let [key (key-function item)
           namespace (:namespace item)]
       (assoc
        output
        key
        (sorted-unique
         (conj
          (vec (or (get output key) []))
          namespace)))))
   {}
   items))

(defn rule-counts
  [items key]
  (count-by
   (reduce
    (fn [output item]
      (into output (item-rules item key)))
    []
    items)
   :rule/id))

(defn safety-counts
  [items]
  (count-by
   (reduce
    (fn [output item]
      (into output
            (item-rules item :rules/matched)))
    []
    items)
   :safety))

(defn cycle-report
  [items]
  (let [cycles
        (filter
         (fn [item]
           (:dependency/cycle item))
         items)]
    (namespaces-by cycles
                   (fn [item]
                     (str/join
                      "|"
                      (:dependency/component item))))))

(defn item-blocked?
  [item]
  (let [record (:record item)
        diagnostics (item-diagnostics item)]
    (or
     (record-error? record)
     (not
      (empty?
       (filter
        (fn [diagnostic]
          (or
           (= :manual (:safety diagnostic))
           (= :error (:level diagnostic))
           (= :critical (:level diagnostic))
           (has? +blocking-diagnostic-types+
                 (:type diagnostic))))
        diagnostics))))))

(defn next-unblocked
  [items]
  (let [candidates
        (vec
         (filter
          (fn [item]
            (and
             (not
              (has? +terminal-statuses+
                    (:corpus/status item)))
             (not (item-blocked? item))))
          items))]
    (if (empty? candidates)
      []
      (let [rank
            (first
             (sort
              (keep
               :dependency/rank
               candidates)))]
        (sorted-unique
         (map
          :namespace
          (filter
           (fn [item]
             (= rank (:dependency/rank item)))
           candidates)))))))

(defn diagnostic-errors
  [diagnostics]
  (vec
   (filter
    (fn [diagnostic]
      (or
       (= :error (:level diagnostic))
       (= :critical (:level diagnostic))
       (has? +blocking-diagnostic-types+
             (:type diagnostic))))
    diagnostics)))

(defn diagnostic-warnings
  [diagnostics]
  (vec
   (filter
    (fn [diagnostic]
      (= :warning (:level diagnostic)))
    diagnostics)))

(defn plan-summary
  [units records items edits diagnostics]
  (let [matched
        (reduce
         (fn [output item]
           (into output
                 (item-rules item :rules/matched)))
         []
         items)
        applied
        (reduce
         (fn [output item]
           (into output
                 (item-rules item :rules/applied)))
         []
         items)
        safety (count-by matched :safety)
        diagnostic-errors
        (diagnostic-errors diagnostics)]
    {:operation task-id
     :selected (count units)
     :processed (count records)
     :changed
     (count
      (filter
       (fn [edit] (:changed edit))
       edits))
     :unchanged
     (count
      (filter
       (fn [edit] (not (:changed edit)))
       edits))
     :matched (count matched)
     :matched/safe (or (get safety :safe) 0)
     :matched/review (or (get safety :review) 0)
     :matched/manual (or (get safety :manual) 0)
     :applied (count applied)
     :unsupported
     (count
      (filter
       (fn [diagnostic]
         (= :code.translate/unsupported
            (:type diagnostic)))
       diagnostics))
     :conflicts
     (count
      (filter
       (fn [diagnostic]
         (= :code.translate/conflict
            (:type diagnostic)))
       diagnostics))
     :warnings
     (+ (count (diagnostic-warnings diagnostics))
        (count
         (filter
          (fn [record]
            (= :warn (:status record)))
          records)))
     :errors
     (+ (count diagnostic-errors)
        (count (filter record-error? records)))}))

(defn report
  [items]
  {:by/namespace
   (reduce
    (fn [output item]
      (assoc
       output
       (:namespace item)
       {:source/path
        (clj/source-path (:unit item))
        :target/path
        (:target/path (:result item))
        :corpus/status (:corpus/status item)
        :dependency/rank (:dependency/rank item)
        :dependency/component
        (:dependency/component item)
        :dependency/cycle
        (:dependency/cycle item)
        :status (:status (:record item))
        :changed (:changed (:result item))
        :rules/matched
        (vec
         (map
          :rule/id
          (item-rules item :rules/matched)))
        :rules/applied
        (vec
         (map
          :rule/id
          (item-rules item :rules/applied)))}))
    {}
    items)
   :by/dependency-rank
   (namespaces-by items :dependency/rank)
   :by/migration-status
   (namespaces-by items :corpus/status)
   :rules/matched
   (rule-counts items :rules/matched)
   :rules/applied
   (rule-counts items :rules/applied)
   :rules/by-safety
   (safety-counts items)
   :cycles
   (cycle-report items)
   :next-unblocked
   (next-unblocked items)})

(defn plan
  [input]
  (let [units (prepare-units input)
        batch
        (run
         {:units units
          :code.translate/prepared true})
        records (batch-records batch)
        items (plan-items units records)
        edits (plan-edits items)
        diagnostics (flatten-diagnostics items)]
    {:operation task-id
     :write false
     :units units
     :records records
     :items items
     :edits edits
     :write-intents (write-intents items)
     :diagnostics diagnostics
     :warnings (diagnostic-warnings diagnostics)
     :errors
     (vec
      (concat
       (diagnostic-errors diagnostics)
       (filter record-error? records)))
     :summary
     (plan-summary units records items edits diagnostics)
     :report (report items)
     :task/summary (:summary batch)}))

(defn blocking-diagnostic?
  [diagnostic options]
  (or
   (and
    (not (:allow-manual? options))
    (= :manual (:safety diagnostic)))
   (and
    (not (:allow-errors? options))
    (or
     (= :error (:level diagnostic))
     (= :critical (:level diagnostic))
     (has? +blocking-diagnostic-types+
           (:type diagnostic))))))

(defn canonical-under-root?
  [path root]
  (let [root
        (if (string? root)
          (clj/strip-trailing-separator root)
          nil)]
    (and
     (string? path)
     (string? root)
     (not (empty? root))
     (or
      (= path root)
      (str/starts-with?
       path
       (str root "/"))))))

(defn required-capability
  [capabilities key]
  (or
   (get capabilities key)
   (throw
    (ex-info
     "Missing Clojure translation host capability"
     {:capability key}))))

(defn duplicate-targets
  [intents]
  (sorted-unique
   (keep
    (fn [entry]
      (let [path (first entry)
            owners (second entry)]
        (if (> (count owners) 1)
          path
          nil)))
    (seq (group-by :path intents)))))

(defn intent-errors
  [intent capabilities options]
  (let [read-text
        (required-capability capabilities :read-text)
        sha256
        (required-capability capabilities :sha256)
        canonical-path
        (required-capability capabilities :canonical-path)
        roots
        (vec
         (or
          (:authorized-roots options)
          (:authorized-roots capabilities)
          []))
        canonical-roots
        (vec (map canonical-path roots))
        canonical-target
        (canonical-path (:path intent))
        declared-root (:target/root intent)
        canonical-declared-root
        (if (string? declared-root)
          (canonical-path declared-root)
          nil)
        source-text
        (read-text (:source/path intent))
        target-text
        (read-text (:path intent))
        source-sha
        (if (nil? source-text)
          nil
          (sha256 source-text))
        target-sha
        (if (nil? target-text)
          nil
          (sha256 target-text))]
    (vec
     (concat
      (if (empty? roots)
        [{:type :code.translate/write-root-required
          :path (:path intent)}]
        [])
      (if (not (string? declared-root))
        [{:type :code.translate/target-root-required
          :path (:path intent)}]
        [])
      (if
       (and
        (not (empty? canonical-roots))
        (empty?
         (filter
          (fn [root]
            (canonical-under-root?
             canonical-declared-root root))
          canonical-roots)))
        [{:type :code.translate/unauthorized-root
          :path (:path intent)
          :target/root (:target/root intent)}]
        [])
      (if
       (not
        (canonical-under-root?
         canonical-target
         canonical-declared-root))
        [{:type :code.translate/path-escape
          :path (:path intent)
          :target/root (:target/root intent)}]
        [])
      (if (nil? (:source/sha256 intent))
        [{:type :code.translate/source-checksum-required
          :source/path (:source/path intent)}]
        [])
      (if
       (and
        (:source/sha256 intent)
        (not= (:source/sha256 intent)
              source-sha))
        [{:type :code.translate/stale-source
          :source/path (:source/path intent)
          :expected (:source/sha256 intent)
          :actual source-sha}]
        [])
      (if
       (not= (:before intent)
             target-text)
        [{:type :code.translate/stale-target
          :path (:path intent)
          :expected (:before intent)
          :actual target-text}]
        [])
      (if
       (and
        (:target/sha256 intent)
        (not= (:target/sha256 intent)
              target-sha))
        [{:type :code.translate/stale-target-checksum
          :path (:path intent)
          :expected (:target/sha256 intent)
          :actual target-sha}]
        [])
      []))))

(defn validate-write-plan
  ([plan capabilities]
   (validate-write-plan plan capabilities {}))
  ([plan capabilities options]
   (let [all-intents
         (vec (:write-intents plan))
         intents
         (vec
          (filter
           (fn [intent]
             (:changed intent))
           all-intents))
         duplicates (duplicate-targets all-intents)
         duplicate-errors
         (vec
          (map
           (fn [path]
             {:type :code.translate/duplicate-target
              :path path})
           duplicates))
         diagnostic-errors
         (vec
          (map
           (fn [diagnostic]
             {:type :code.translate/blocked-diagnostic
              :diagnostic diagnostic})
           (filter
            (fn [diagnostic]
              (blocking-diagnostic?
               diagnostic options))
            (:diagnostics plan))))
         record-errors
         (if (:allow-errors? options)
           []
           (vec
            (map
             (fn [record]
               {:type :code.translate/blocked-record
                :item/id (:item/id record)
                :status (:status record)
                :error (:error record)})
             (filter
              record-error?
              (:records plan)))))
         errors
         (reduce
          (fn [output intent]
            (into output
                  (intent-errors
                   intent capabilities options)))
          (vec
           (concat
            duplicate-errors
            diagnostic-errors
            record-errors))
          intents)]
     {:valid? (empty? errors)
      :write false
      :intents intents
      :errors (vec errors)})))

(defn apply-plan!
  ([plan capabilities]
   (apply-plan! plan capabilities {}))
  ([plan capabilities options]
   (let [validation
         (validate-write-plan
          plan capabilities options)]
     (if (not (:valid? validation))
       (throw
        (ex-info
         "Clojure translation write plan validation failed"
         validation)))
     (let [write-atomic!
           (required-capability
            capabilities :write-atomic!)
           results
           (vec
            (map
             (fn [intent]
               {:path (:path intent)
                :result
                (write-atomic!
                 (:path intent)
                 (:after intent))})
             (:intents validation)))]
       {:write true
        :count (count results)
        :results results
        :validation validation}))))