;; Foundation-compatible, pure source analysis primitives.  Host adapters
;; supply file text; this namespace never grants filesystem authority.
(ns code.framework
  (:require [std.block.base :as block]
            [std.block.parse :as parse]))

(defn line-number
  [source offset]
  (loop [index 0 line 1]
    (if (or (= index offset) (= index (str/length source)))
      line
      (recur (inc index)
             (if (= "\n" (str/char-at source index)) (inc line) line)))))

(defn namespace-name
  [source]
  (let [lines (str/split-lines source)
        match (first (filter (fn [line]
                               (or (str/includes? line "(ns ")
                                   (str/includes? line "(ns+ ")))
                             lines))]
    (if match
      (let [parts (str/split (str/trim match) " ")]
        (str/replace (nth parts 1) ")" ""))
      nil)))

(defn definition-kind
  [line]
  (let [trimmed (str/trim line)]
    (cond (str/starts-with? trimmed "(defn- ") :private-function
          (str/starts-with? trimmed "(defn ") :function
          (str/starts-with? trimmed "(defmacro ") :macro
          (str/starts-with? trimmed "(defonce ") :once
          (str/starts-with? trimmed "(def ") :value
          :else nil)))

(defn definition-name-part?
  [part]
  (and part
       (not (str/blank? part))
       (not (str/starts-with? part "^"))
       (not (str/starts-with? part ":"))
       (not (str/starts-with? part "["))
       (not (str/starts-with? part "{"))
       (not (str/starts-with? part "}"))
       (not (str/starts-with? part "\""))
       (not (str/starts-with? part "("))
       (not (= part "&"))))

(defn clean-definition-name
  [part]
  (if part
    (str/replace (str/replace part ")" "") "]" "")
    nil))

(defn definition-name
  [line]
  (let [trimmed (str/trim line)
        headless (str/replace-first trimmed "(" "")
        parts (vec
               (filter
                (fn [part] (not (str/blank? part)))
                (str/split headless " ")))]
    (clean-definition-name
     (first
      (filter definition-name-part?
              (rest parts))))))

(defn continuation-definition-name
  [line]
  (let [parts
        (filter
         (fn [part] (not (str/blank? part)))
         (str/split (str/trim line) " "))]
    (clean-definition-name
     (first
      (filter definition-name-part? parts)))))

(defn definition-name-at
  [lines index]
  (or
   (definition-name (nth lines index))
   (loop [cursor (inc index)]
     (if (= cursor (count lines))
       nil
       (let [candidate
             (continuation-definition-name
              (nth lines cursor))]
         (if candidate
           candidate
           (recur (inc cursor))))))))

(defn inline-docstring
  [line]
  (let [start (str/index-of line "\"")]
    (if (< start 0)
      nil
      (let [remainder (str/slice line (inc start))
            end (str/index-of remainder "\"")]
        (if (< end 0)
          nil
          (str/slice remainder 0 end))))))

(defn definition-lines
  [source]
  (loop [index 0
         lines (str/split-lines source)
         output []]
    (if (= index (count lines))
      output
      (let [line (nth lines index)
            trimmed (str/trim line)
            kind (definition-kind trimmed)]
        (if kind
          (recur
           (inc index)
           lines
           (conj
            output
            {:line (inc index)
             :column 1
             :kind kind
             :name (definition-name-at lines index)
             :docstring (inline-docstring trimmed)
             :source line}))
          (recur (inc index) lines output))))))

(defn docstrings
  [definitions]
  (vec (filter (fn [entry] (:docstring entry)) definitions)))

(defn analyse-source
  [source]
  ;; Parse first so callers receive a structured failure for invalid HAL.
  (let [root (parse/parse-string source)
        definitions (definition-lines source)]
    {:namespace (namespace-name source)
     :forms (count (block/block-children root))
     :definitions definitions
     :docstrings (docstrings definitions)
     :source source}))

(defn grep-source
  [source needle]
  (loop [index 0
         lines (str/split-lines source)
         output []]
    (if (= index (count lines))
      output
      (let [line (nth lines index)]
        (recur (inc index) lines
               (if (str/includes? line needle)
                 (conj output {:line (inc index) :text line})
                 output))))))