(ns code.migrate
  (:require [code.framework :as framework]
            [code.manage.unit.structure :as structure]
            [work.base :as work :refer [def.work]]
            [work.flow.task :as task]
            [work.flow.task.selector :as selector]))

(def rule-id :std.task/def-work)

(def +lang-model-v1-prefix+ "lang.model.spec-")
(def +lang-model-v1-target-prefix+ "lang.model.v1.spec-")
(def +lang-model-v1-path-prefix+ "lang/model/spec_")
(def +lang-model-v1-target-path-prefix+ "lang/model/v1/spec_")

(def +foundation-common-test-rewrites+
  [["tahto.base.emit" "lang.common.emit"]
   ["tahto.base.grammar" "lang.common.grammar"]
   ["tahto.base.preprocess-base" "lang.common.emit-preprocess"]
   ["tahto.base.util" "lang.common.util"]
   ["tahto.common.book" "lang.common.book"]
   ["tahto.model.spec-js" "lang.model.v1.spec-js"]
   ["tahto.model.spec-lua" "lang.model.v1.spec-lua"]
   ["tahto.model.annex.spec-rust" "lang.model.v1.spec-rust"]])

(def +foundation-common-blocked-prefixes+ ["tahto.core"])

(defn replace-routes
  [source routes]
  (reduce (fn [output route]
            (str/replace output (first route) (second route)))
          source
          routes))

(defn route-foundation-common-test-path
  [path]
  (-> path
      (str/replace "test/tahto/base/" "core/lib/test-lang/lang/common/")
      (str/replace "test/tahto/common/" "core/lib/test-lang/lang/common/")
      (str/replace ".clj" ".hal")))

(defn foundation-common-fact-count
  [source]
  (- (count (str/split source "(fact")) 1))

(defn foundation-common-diagnostics
  [source]
  (vec
   (keep (fn [prefix]
           (if (str/includes? source prefix)
             {:level :error
              :migration/error :foundation/unmapped-reference
              :reference prefix
              :message "Foundation test requires an explicit persistent adaptation"}
             nil))
         +foundation-common-blocked-prefixes+)))

(defn canonical-test-runner
  [namespace]
  (str "(pr-str (run {:namespace \"" namespace "\"}))"))

(defn migrate-foundation-common-test-source
  [source namespace]
  (let [rewritten (replace-routes source +foundation-common-test-rewrites+)
        runner (canonical-test-runner namespace)
        output (if (str/includes? rewritten runner)
                 rewritten
                 (str (if (str/ends-with? rewritten "\n")
                        rewritten
                        (str rewritten "\n"))
                      "\n" runner "\n"))
        fact-count (foundation-common-fact-count source)
        diagnostics (foundation-common-diagnostics output)]
    {:before source
     :after output
     :changed (not= source output)
     :rules [:foundation/lang-common-tests]
     :facts {:source fact-count
             :direct (if (empty? diagnostics) fact-count 0)
             :adapted 0
             :covered-current 0
             :unmapped (if (empty? diagnostics) 0 fact-count)}
     :diagnostics diagnostics}))

(defn migrate-foundation-common-test-unit
  [unit]
  (let [source-path (:path unit)
        target-path (or (:target/path unit)
                        (route-foundation-common-test-path source-path))
        namespace (or (:target/namespace unit) (:namespace unit))
        result (migrate-foundation-common-test-source (:source unit) namespace)]
    (merge {:path target-path
            :source/path source-path
            :target/path target-path
            :language :hara
            :copy true
            :move false
            :create true
            :write false}
           result)))

(defn route-lang-model-v1-namespace
  [namespace]
  (let [name (str namespace)]
    (if (str/starts-with? name +lang-model-v1-prefix+)
      (str +lang-model-v1-target-prefix+
           (subs name (count +lang-model-v1-prefix+)))
      name)))

(defn route-lang-model-v1-path
  [path]
  (str/replace path
               +lang-model-v1-path-prefix+
               +lang-model-v1-target-path-prefix+))

(defn rewrite-lang-model-v1-source
  [source]
  (str/replace source
               +lang-model-v1-prefix+
               +lang-model-v1-target-prefix+))

(defn migrate-lang-model-v1-source
  [source]
  (let [output (rewrite-lang-model-v1-source source)]
    {:before source
     :after output
     :changed (not= source output)
     :rules (if (= source output) [] [:lang.model/v1])
     :diagnostics []}))

(defn migrate-lang-model-v1-unit
  [unit]
  (let [source-path (:path unit)
        target-path (route-lang-model-v1-path source-path)
        result (migrate-lang-model-v1-source (:source unit))]
    (merge {:path target-path
            :source/path source-path
            :target/path target-path
            :language (or (:language unit) :hara)
            :move (not= source-path target-path)
            :create false
            :write false}
           result
           {:changed (or (:changed result)
                         (not= source-path target-path))})))

(def task-heads
  #{"deftask" "def.task" "task/deftask" "task/def.task"})

(defn task-vector?
  [value]
  (and (vector? value)
       (= :task (first value))
       (map? (second value))))

(defn child-values
  [source form]
  (vec
   (map :value
        (framework/semantic-children source form))))

(defn first-task-vector
  [values]
  (first (filter task-vector? values)))

(defn first-docstring
  [values]
  (first (filter string? values)))

(defn definition-with-doc
  [definition docstring]
  (if docstring
    (assoc definition
           :metadata
           (assoc (or (:metadata definition) {}) :doc docstring))
    definition))

(defn task-replacement
  [source form]
  (let [values (child-values source form)
        head (str (first values))
        name (second values)]
    (cond
      (or (= head "invoke/definvoke")
          (= head "definvoke"))
      (let [task-vector (first-task-vector values)]
        (if task-vector
          {:replacement
           (pr-str
            (list 'def.work
                  name
                  [:task]
                  (definition-with-doc (second task-vector)
                                       (first-docstring values))))
           :rules [rule-id]
           :diagnostics []}
          nil))

      (has? task-heads head)
      (let [definition (if (< 2 (count values)) (nth values 2) nil)
            body (vec (drop 3 values))]
        (if (and (map? definition) (empty? body))
          {:replacement
           (pr-str (list 'def.work name [:task] definition))
           :rules [rule-id]
           :diagnostics []}
          {:replacement nil
           :rules []
           :diagnostics
           [{:level :error
             :migration/error :std.task/ambiguous-deftask
             :message "deftask body requires manual conversion"
             :name name}]}))

      :else nil)))

(defn nested-map
  [value]
  (cond
    (map? value) value
    (or (sequential? value) (seq? value))
    (loop [remaining (reverse (vec value))]
      (if (empty? remaining)
        nil
        (let [found (nested-map (first remaining))]
          (if found found (recur (rest remaining))))))
    :else nil))

(defn profile-replacement
  [source form]
  (let [values (child-values source form)]
    (if (and (= "defmethod" (str (first values)))
             (= "task/task-defaults" (str (second values))))
      (let [type (if (< 2 (count values)) (nth values 2) nil)
            options (nested-map
                     (if (< 3 (count values)) (nth values 3) nil))]
        (if (and type options)
          {:replacement
           (pr-str (list 'task/register-profile! type options))
           :rules [:std.task/profile]
           :diagnostics []}
          {:replacement nil
           :rules []
           :diagnostics
           [{:level :error
             :migration/error :std.task/invalid-profile
             :message "task-defaults method could not be converted"}]}))
      nil)))

(defn form-migration
  [source form]
  (or (task-replacement source form)
      (profile-replacement source form)))

(defn source-plan
  [source]
  (let [analysis (framework/analyse-structure source)]
    (reduce
     (fn [plan form]
       (let [migration (form-migration source form)]
         (if migration
           (let [replacement (:replacement migration)]
             {:edits
              (if replacement
                (conj (:edits plan)
                      (structure/edit (:start form)
                                      (:end form)
                                      replacement))
                (:edits plan))
              :rules (into (:rules plan) (:rules migration))
              :diagnostics
              (into (:diagnostics plan) (:diagnostics migration))})
           plan)))
     {:edits [] :rules [] :diagnostics []}
     (:form-records analysis))))

(defn rewrite-requires
  [source]
  (-> source
      (str/replace "[std.task :as task]"
                   "[work.base :as work :refer [def.work]]\n            [work.flow.task :as task]")
      (str/replace "[std.work :as work]"
                   "[work.base :as work :refer [def.work]]")
      (str/replace "[std.work.template.task :as task]"
                   "[work.flow.task :as task]")))

(defn migrate-source
  [source]
  (let [plan (source-plan source)
        rewritten (structure/apply-edits source (:edits plan))
        output (rewrite-requires rewritten)]
    (assoc plan
           :before source
           :after output
           :changed (not= source output))))

(defn migrate-unit
  [unit]
  (let [result (migrate-source (:source unit))]
    (merge {:path (:path unit)
            :language (or (:language unit) :hara)
            :create false
            :write false}
           result)))

(defn migrate-selected-unit
  [unit]
  (cond (= :lang.model/v1 (:migration unit))
        (migrate-lang-model-v1-unit unit)
        (= :foundation/lang-common-tests (:migration unit))
        (migrate-foundation-common-test-unit unit)
        :else (migrate-unit unit)))

(def.work migration
  [:task]
  {:task/type :code.migrate
   :item
   {:list
    (fn [input context]
      (vec
       (map
        (fn [unit]
          {:item/id (:path unit)
           :item/value (assoc unit :migration (:migration input))})
        (sort-by :path (:units input)))))
    :run
    (fn [unit context]
      (let [result (migrate-selected-unit unit)]
        {:status
         (if (empty? (:diagnostics result)) :return :error)
         :data result}))}
   :return {:select :all :package :map}})

(defn plan
  [input]
  (work/run migration input))

(defn planned-edits
  [plan]
  (vec
   (keep
    (fn [record]
      (let [value (:data record)]
        (if (:changed value) value nil)))
    (:records plan))))

(defn target-path-of
  [unit]
  (or (:target/path unit) (:path unit)))

(defn owned-edits
  "Chooses the moved implementation when a hard-cut target is also occupied by
   a compatibility facade. Other duplicate target ownership is rejected."
  [edits]
  (vals
   (reduce
    (fn [owners unit]
      (let [target (target-path-of unit)
            current (get owners target)]
        (cond
          (nil? current) (assoc owners target unit)
          (and (:move unit) (not (:move current))) (assoc owners target unit)
          (and (:move current) (not (:move unit))) owners
          :else
          (throw (ex-info "Migration target has multiple owners"
                          {:target/path target
                           :owners [(:source/path current)
                                    (:source/path unit)]})))))
    {}
    edits)))

(defn path-under-root?
  [root path]
  (let [root (str/replace (File/resolve root "") "\\" "/")
        path (str/replace (File/resolve root path) "\\" "/")]
    (or (= root path)
        (str/starts-with? path (str root "/")))))

(defn validate-unit!
  [root unit]
  (let [source-path (or (:source/path unit) (:path unit))
        target-path (or (:target/path unit) (:path unit))]
    (if (or (not (path-under-root? root source-path))
            (not (path-under-root? root target-path)))
    (throw (ex-info "Migration path escapes project root"
                    {:root root
                     :source/path source-path
                     :target/path target-path})))
    (let [path (File/resolve root source-path)
          current (str/decode-utf8 (deref (File/read path)))]
    (if (not= current (:before unit))
      (throw (ex-info "Migration source changed after planning"
                      {:path path})))
      unit)))

(defn apply-unit!
  [root unit]
  (let [source-relative (or (:source/path unit) (:path unit))
        target-relative (or (:target/path unit) (:path unit))
        source-path (File/resolve root source-relative)
        target-path (File/resolve root target-relative)
        target-parent (File/parent target-path)]
    (if target-parent
      (deref (File/mkdir target-parent {:parents? true :exists-ok? true}))
      nil)
    (deref (File/write target-path
                       (str/encode-utf8 (:after unit))
                       {:mode :replace :parents? true}))
    (if (and (not (:copy unit))
             (not= source-path target-path))
      (deref (File/delete source-path {:missing-ok? false}))
      nil)
    (assoc unit :write true)))

(defn apply!
  [root plan]
  (let [edits (vec (owned-edits (planned-edits plan)))
        diagnostics
        (vec (mapcat (fn [unit] (:diagnostics unit)) edits))]
    (if (not (empty? diagnostics))
      (throw (ex-info "Migration contains blocking diagnostics"
                      {:diagnostics diagnostics})))
    (vec (map (fn [unit] (validate-unit! root unit)) edits))
    (vec (map (fn [unit] (apply-unit! root unit)) edits))))
