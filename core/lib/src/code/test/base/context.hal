(ns code.test.base.context)

(def ^:dynamic *eval-fact* false)
(def ^:dynamic *eval-mode* true)
(def ^:dynamic *eval-meta* nil)
(def ^:dynamic *eval-global* nil)
(def ^:dynamic *eval-check* nil)
(def ^:dynamic *eval-current-ns* nil)
(def ^:dynamic *run-id* true)
(def ^:dynamic *registry* (atom {}))
(def ^:dynamic *accumulator* (atom {}))
(def ^:dynamic *errors* nil)
(def ^:dynamic *settings* {:test-paths ["test"]})
(def ^:dynamic *root* ".")
(def ^:dynamic *results* nil)
(def ^:dynamic *timeout-global* 20000)
(def ^:dynamic *timeout-ns-global* nil)
(def ^:dynamic *timeout* nil)
(def ^:dynamic *print*
  #{:print-throw :print-failed :print-timeout :print-bulk})

(def +context+ (atom {}))

(defn new-context
  []
  {:eval-fact false
   :eval-mode true
   :eval-meta nil
   :eval-global nil
   :eval-check nil
   :eval-current-ns nil
   :run-id true
   :registry *registry*
   :accumulator *accumulator*
   :errors nil
   :settings {:test-paths ["test"]}
   :root "."
   :results nil
   :timeout-global 20000
   :timeout-ns-global nil
   :timeout nil
   :print #{:print-throw :print-failed :print-timeout :print-bulk}})

(defmacro with-new-context
  [options & body]
  `(let [previous# (deref code.test.base.context/+context+)
         context# (merge (code.test.base.context/new-context) ~options)]
     (try
       (do
         (reset! code.test.base.context/+context+ context#)
         (binding [code.test.base.context/*eval-fact* (:eval-fact context#)
                   code.test.base.context/*eval-mode* (:eval-mode context#)
                   code.test.base.context/*eval-meta* (:eval-meta context#)
                   code.test.base.context/*eval-global* (:eval-global context#)
                   code.test.base.context/*eval-check* (:eval-check context#)
                   code.test.base.context/*eval-current-ns* (:eval-current-ns context#)
                   code.test.base.context/*run-id* (:run-id context#)
                   code.test.base.context/*registry* (:registry context#)
                   code.test.base.context/*accumulator* (:accumulator context#)
                   code.test.base.context/*errors* (:errors context#)
                   code.test.base.context/*settings* (:settings context#)
                   code.test.base.context/*root* (:root context#)
                   code.test.base.context/*results* (:results context#)
                   code.test.base.context/*timeout-global* (:timeout-global context#)
                   code.test.base.context/*timeout-ns-global* (:timeout-ns-global context#)
                   code.test.base.context/*timeout* (:timeout context#)
                   code.test.base.context/*print* (:print context#)]
           ~@body))
       (finally
         (reset! code.test.base.context/+context+ previous#)))))
