(ns code.test.base.process
  (:require [code.test.checker.common :as common]))

(defstruct TimeoutValue [milliseconds])

(defn evaluate
  [input]
  (try
    {:type :code/test
     :status :success
     :data (if (map? input)
             ((or (:function input) (fn [] (:form input))))
             (input))}
    (catch Throwable error
      {:type :code/test :status :exception :data error})))

(defn timed-settle
  [options promise milliseconds]
  (let [timeout-function (:work/timeout-promise options)
        cancel-function (:work/cancel-timeout options)
        binding (timeout-function promise milliseconds)
        wrapped (if (map? binding) (:promise binding) binding)
        timeout (if (map? binding) (:timeout binding) nil)
        outcome (try
                  (deref wrapped)
                  (finally
                    (if (and timeout cancel-function)
                      (cancel-function timeout)
                      nil)))]
    (if (and (map? outcome) (= :timeout (:test/status outcome)))
      (code.test.base.process/TimeoutValue milliseconds)
      (if (and (map? outcome) (= :value (:test/status outcome)))
        (:value outcome)
        outcome))))

(defn settle
  "Returns an ordinary value, awaiting a Promise through generic std.work
   context capabilities when a timeout is requested."
  ([value]
   (settle value {}))
  ([value options]
   (if (promise? value)
     (if (and (:work/timeout-promise options) (:timeout options))
       (timed-settle options value (:timeout options))
       (deref value))
     value)))

(defn check
  "Evaluates a thunk and verifies its canonical code.test result envelope."
  ([thunk expected]
   (check thunk expected {}))
  ([thunk expected options]
   (let [checker (common/->checker expected)
         reported-expected (if (common/checker? expected)
                             (str expected)
                             expected)]
     (try
       (let [actual (settle (thunk) options)]
         (if (instance? code.test.base.process/TimeoutValue actual)
           {:pass false
            :status :timeout
            :actual nil
            :expected reported-expected
            :timeout (:milliseconds actual)}
           (let [evaluation {:type :code/test
                             :status :success
                             :data actual}
                 verification (common/verify checker evaluation)]
             {:pass (common/succeeded? verification)
              :status (:status verification)
              :actual actual
              :expected reported-expected})))
       (catch Throwable error
         (let [evaluation {:type :code/test
                           :status :exception
                           :data error}
               verification (common/verify checker evaluation)
               passing (common/succeeded? verification)]
           {:pass passing
            :status (if passing :success :error)
            :actual nil
            :expected reported-expected
            :error (if passing nil (ex-message error))
            :error-data (if passing nil (ex-data error))}))))))

(defn checks-pass?
  [checks]
  (reduce (fn [passing check-result]
            (and passing (:pass check-result)))
          true
          checks))

(defn checks-error?
  [checks]
  (reduce (fn [errored check-result]
            (or errored (= :error (:status check-result))))
          false
          checks))

(defn checks-timeout?
  [checks]
  (reduce (fn [timed-out check-result]
            (or timed-out (= :timeout (:status check-result))))
          false
          checks))

(defn normalize-checks
  [value]
  (if (vector? value)
    value
    (if (map? value)
      [value]
      [{:pass true :actual value :expected :returned}])))

(defn clock-now
  [options]
  (let [now (:work/now options)]
    (if now (now) nil)))

(defn run-hook
  [hook options]
  (if hook
    (settle (hook) options)
    nil))

(defn run-hooks
  [hooks options]
  (reduce (fn [output hook]
            (do (run-hook hook options) output))
          nil
          hooks))

(defn fact-cancelled?
  [fact options]
  (if (:cancelled options) true false))

(defn fact-result-identity
  [fact]
  {:namespace (:namespace fact)
   :name (:name fact)
   :meta (:meta fact)})

(defn error-result
  [fact error]
  (merge (fact-result-identity fact)
         {:status :error
          :checks []
          :error (str error)}))

(defn execute-fact-body
  [fact options]
  (try
    (let [checks
          (normalize-checks
           (settle ((:function fact) options) options))
          status (if (checks-timeout? checks)
                   :timeout
                   (if (checks-error? checks)
                     :error
                     (if (checks-pass? checks)
                       :passed
                       :failed)))]
      (merge (fact-result-identity fact)
             {:status status
              :checks checks}))
    (catch Throwable error
      (error-result fact error))))

(defn timed-result
  [result start options]
  (let [end (clock-now options)]
    (if (and start end)
      (assoc result :elapsed (- end start))
      result)))

(defn run-fact
  "Runs one fact and returns a structured test-domain result."
  ([fact]
   (run-fact fact {}))
  ([fact options]
   (let [identity (fact-result-identity fact)
         start (clock-now options)
         result
         (if (:skip (:meta fact))
           (merge identity {:status :skipped :checks []})
           (if (fact-cancelled? fact options)
             (merge identity {:status :cancelled :checks []})
             (try
               (let [checks
                     (try
                       (do
                         (run-hooks [(:before-each options)
                                     (:before (:meta fact))]
                                    options)
                         (normalize-checks
                          (settle ((:function fact) options) options)))
                       (finally
                         (run-hooks [(:after (:meta fact))
                                     (:after-each options)]
                                    options)))
                     status (if (checks-timeout? checks)
                              :timeout
                              (if (checks-error? checks)
                                :error
                                (if (checks-pass? checks)
                                  :passed
                                  :failed)))]
                 (merge identity {:status status :checks checks}))
               (catch Throwable error
                 (merge identity
                        {:status :error
                         :checks []
                         :error (str error)})))))
         end (clock-now options)
         timed-result (if (and start end)
                        (assoc result :elapsed (- end start))
                        result)]
     timed-result)))

(defn infer-function [form] (fn [] form))
(defn attach-meta [result metadata] (assoc result :meta metadata))
(defn evaluate-on-error [result] result)
(defn process [input] (evaluate input))
(defn collect [results] (vec results))
(defn skip-check [check] (assoc check :status :skipped))
(def run-check check)
