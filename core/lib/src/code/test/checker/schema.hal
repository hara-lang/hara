(ns code.test.checker.schema
  (:require [code.test.checker.common :as common]
            [std.typed.explain :as typed]))

(defn conforms
  "Creates an explicit std.typed schema checker with a portable descriptor."
  ([schema-value]
   (conforms schema-value nil))
  ([schema-value registry-value]
   (let [descriptor {:checker/type :typed/schema
                     :checker/form schema-value}]
     (common/checker
      {:tag :conforms
       :doc "Checks portable std.typed schema conformance."
       :expect descriptor
       :form descriptor
       :fn (fn [actual]
             (let [outcome (typed/check schema-value
                                        (common/result-data actual)
                                        registry-value)]
               (and (Result/success? outcome)
                    (Result/data outcome))))}))))
