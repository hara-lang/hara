(ns code.test.checker.util)

(defn exact-at? [values checks start index]
  (if (= index (count checks))
    true
    (and ((nth checks index) (nth values (+ start index)))
         (exact-at? values checks start (inc index)))))

(defn contains-exact-from [values checks start]
  (if (> (+ start (count checks)) (count values))
    false
    (or (exact-at? values checks start 0)
        (contains-exact-from values checks (inc start)))))

(defn contains-exact [data checkers]
  (let [values (vec data)
        checks (vec checkers)]
    (if (empty? checks)
      true
      (if (contains-exact-from values checks 0) true false))))

(defn contains-with-gaps-from [values checks value-index check-index]
  (cond
    (= check-index (count checks)) true
    (= value-index (count values)) false
    ((nth checks check-index) (nth values value-index))
    (contains-with-gaps-from values checks (inc value-index) (inc check-index))
    :else
    (contains-with-gaps-from values checks (inc value-index) check-index)))

(defn contains-with-gaps [data checkers]
  (contains-with-gaps-from (vec data) (vec checkers) 0 0))

(defn perm-search [permutation remaining used]
  (if (empty? remaining)
    true
    (let [check-index (first remaining)]
      (loop [data-index 0]
        (if (= data-index (count permutation))
          false
          (if (and (not (has? used data-index))
                   (has? (nth permutation data-index) check-index))
            (if (perm-search permutation (rest remaining) (conj used data-index))
              true
              (recur (inc data-index)))
            (recur (inc data-index))))))))

(defn perm-check [permutation all]
  (perm-search (vec permutation) (vec all) #{}))

(defn perm-build [data checkers]
  (let [checks (vec checkers)]
    (mapv (fn [value]
            (loop [index 0 matches #{}]
              (if (= index (count checks))
                matches
                (recur (inc index)
                       (if ((nth checks index) value)
                         (conj matches index)
                         matches)))))
          data)))

(defn window [values start length]
  (loop [index 0 output []]
    (if (= index length)
      output
      (recur (inc index) (conj output (nth values (+ start index)))))))

(defn contains-any-order-from [values checks all start]
  (if (> (+ start (count checks)) (count values))
    false
    (or (perm-check (perm-build (window values start (count checks)) checks) all)
        (contains-any-order-from values checks all (inc start)))))

(defn contains-any-order [data checkers]
  (let [values (vec data)
        checks (vec checkers)
        check-count (count checks)
        value-count (count values)
        all (set (range check-count))]
    (if (= check-count 0)
      true
      (if (contains-any-order-from values checks all 0) true false))))

(defn contains-all [data checkers]
  (let [checks (vec checkers)]
    (perm-check (perm-build data checks)
                (set (range (count checks))))))
