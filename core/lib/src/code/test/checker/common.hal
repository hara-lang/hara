(ns code.test.checker.common)

(defstruct Checker [fn tag doc expect form])

(defn function-string [function] (str function))

(defn checker [descriptor]
  (code.test.checker.common/Checker
   (:fn descriptor)
   (:tag descriptor)
   (:doc descriptor)
   (:expect descriptor)
   (:form descriptor)))

(defn checker? [value]
  (instance? code.test.checker.common/Checker value))

(defn result-data [result] result)

(declare verify)

(extend-type Checker IFn
  (invoke [checker & arguments]
    (apply (:fn checker) arguments)))

(extend-type Checker IDisplay
  (display [checker]
    (str "#" (name (:tag checker)) "<" (:expect checker) ">")))

(extend-type Checker std.protocol.imatch/IMatch
  (match-value [checker actual]
    (verify checker actual)))

(defn verify [checker actual]
  (try
    (Result/create
     :success
     (boolean (checker actual))
     {:test {:actual actual :expected (:expect checker)}})
    (catch Throwable error
      (Result/create
       :error error
       {:test {:actual actual :expected (:expect checker)}}))))

(defn succeeded? [result]
  (and (Result/success? result) (= true (Result/data result))))

(defn exactly
  ([expected] (exactly expected identity))
  ([expected function]
   (checker {:tag :exactly
             :doc "Checks exact equality."
             :fn (fn [result]
                   (= (function result) expected))
             :expect expected})))

(defn approx
  ([expected] (approx expected 0.001))
  ([expected threshold]
   (checker {:tag :approx
             :doc "Checks numeric proximity."
             :fn (fn [result]
                   (let [actual result]
                     (and (number? actual)
                          (< (- expected threshold) actual)
                          (< actual (+ expected threshold)))))
             :expect expected})))

(defn type-expectation? [expected]
  (and (keyword? expected) (= "hara" (namespace expected))))

(defn satisfies
  ([expected] (satisfies expected identity))
  ([expected function]
   (checker {:tag :satisfies
             :doc "Checks value, predicate, type, collection, or regexp satisfaction."
             :fn (fn [result]
                   (let [actual (function result)]
                     (cond
                       (= actual expected) true
                       (type-expectation? expected)
                       (or (= expected (type actual))
                           (str/ends-with? (str (type actual))
                                           (str "." (name expected))))
                       (set? expected) (has? expected actual)
                       (map? expected) (= expected (into {} actual))
                       (vector? expected) (= actual expected)
                       (function? expected) (boolean (expected actual))
                       (regexp? expected)
                       (if (regexp? actual)
                         (= (RegExp/pattern expected) (RegExp/pattern actual))
                         (if (string? actual)
                           (RegExp/find? expected actual)
                           false))
                       :else false)))
             :expect expected})))

(defn stores [expected]
  (checker {:tag :stores
            :doc "Checks the value stored by a dereferenceable reference."
            :fn (fn [result]
                  (let [actual result]
                    (if (derefable? actual)
                      ((satisfies expected) (deref actual))
                      false)))
            :expect expected}))

(defn anything [value] true)

(defn ->checker [value]
  (if (checker? value) value (satisfies value)))

(defn throws
  ([] (throws :hara/Error nil))
  ([error-type] (throws error-type nil))
  ([error-type message]
     (checker {:tag :throws
             :doc "Checks a thrown error type and optional message."
             :fn (fn [error]
                   (and (or (= error-type :hara/Error)
                            (= error-type (type error)))
                        (if message
                          (= message (ex-message error))
                          true)))
             :expect {:exception error-type :message message}})))

(defmacro capture
  ([] `(code.test.checker.common/capture nil $0))
  ([check] `(code.test.checker.common/capture ~check $0))
  ([check symbol]
   `(fn [value#]
      (do
        (def ~symbol value#)
        (if ~check (~check value#) true)))))
