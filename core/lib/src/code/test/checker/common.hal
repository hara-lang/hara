(ns code.test.checker.common)

(defstruct Checker [fn tag doc expect form])

(defn function-string [function] (str function))

(defn checker [descriptor]
  (code.test.checker.common/Checker
   (:fn descriptor)
   (:tag descriptor)
   (:doc descriptor)
   (:expect descriptor)
   (:form descriptor)))

(defn checker? [value]
  (instance? code.test.checker.common/Checker value))

(defn result-data [result]
  (cond
    (res-success? result) (res-data result)
    (res-error? result) (res-error-value result)
    (and (map? result)
         (= :code/test (:type result))
         (has? result :data)) (:data result)
    :else result))

(extend-type Checker std.protocol.ifn/IFn
  (invoke [checker & arguments]
    (apply (:fn checker) arguments)))

(extend-type Checker std.protocol.idisplay/IDisplay
  (display [checker]
    (str "#" (name (:tag checker)) "<" (:expect checker) ">")))

(extend-type Checker std.protocol.imatch/IMatch
  (match-value [checker actual]
    {:pass (checker actual)
     :actual actual
     :expected (:expect checker)}))

(defn verify [checker result]
  (let [out (try
              {:type :code/test :status :success :data (checker result)}
              (catch Throwable error
                {:type :code/test :status :exception :data error}))]
    (assoc out
           :pass (and (= :success (:status out)) (= true (:data out)))
           :checker checker
           :actual result
           :from :verify)))

(defn succeeded? [result]
  (if (res? result)
    (and (res-success? result) (= true (res-data result)))
    (and (= :success (:status result)) (= true (:data result)))))

(declare checker-descriptor)

(defn native-error? [value] (= :hara/Error (type value)))

(defn descriptor-value [value]
  (cond
    (checker? value) (checker-descriptor value)
    (fn? value) (str value)
    (regexp? value) {:descriptor/type :regexp :descriptor/pattern (Regex/pattern value)}
    (map? value) (reduce-kv (fn [out key nested]
                              (assoc out key (descriptor-value nested))) {} value)
    (vector? value) (mapv descriptor-value value)
    (set? value) (into #{} (map descriptor-value value))
    (list? value) (vec (map descriptor-value value))
    (native-error? value) {:descriptor/type :error
                           :descriptor/error-type (type value)
                           :descriptor/message (ex-message value)
                           :descriptor/data (or (ex-data value) {})}
    :else value))

(defn checker-descriptor [checker]
  {:checker/type (:tag checker)
   :checker/expected (descriptor-value (:expect checker))
   :checker/form (descriptor-value (:form checker))})

(defn error-checker? [checker] (has? #{:throws :raises} (:tag checker)))

(defn comparison-context [checker actual]
  {:test {:checker (checker-descriptor checker) :actual actual} :failures []})

(defn invoke-checker-result [checker actual]
  (let [context (comparison-context checker actual)]
    (try (res-success (boolean (checker actual)) context)
         (catch Throwable error (res-error error context)))))

(defn compare-result [checker evaluation]
  (if (res-error? evaluation)
    (if (error-checker? checker)
      (invoke-checker-result checker (res-error-value evaluation))
      (res-with-context evaluation
                        {:test {:checker (checker-descriptor checker)} :failures []}))
    (invoke-checker-result checker (res-data evaluation))))

(defn exactly
  ([expected] (exactly expected identity))
  ([expected function]
   (checker {:tag :exactly
             :doc "Checks exact equality."
             :fn (fn [result]
                   (= (function (result-data result)) expected))
             :expect expected})))

(defn approx
  ([expected] (approx expected 0.001))
  ([expected threshold]
   (checker {:tag :approx
             :doc "Checks numeric proximity."
             :fn (fn [result]
                   (let [actual (result-data result)]
                     (and (number? actual)
                          (< (- expected threshold) actual)
                          (< actual (+ expected threshold)))))
             :expect expected})))

(defn type-expectation? [expected]
  (and (keyword? expected) (= "hara" (namespace expected))))

(defn satisfies
  ([expected] (satisfies expected identity))
  ([expected function]
   (checker {:tag :satisfies
             :doc "Checks value, predicate, type, collection, or regexp satisfaction."
             :fn (fn [result]
                   (let [actual (function (result-data result))]
                     (cond
                       (= actual expected) true
                       (type-expectation? expected) (= expected (type actual))
                       (set? expected) (has? expected actual)
                       (map? expected) (= expected (into {} actual))
                       (vector? expected) (= actual expected)
                       (fn? expected) (boolean (expected actual))
                       (regexp? expected)
                       (if (regexp? actual)
                         (= (Regex/pattern expected) (Regex/pattern actual))
                         (if (string? actual)
                           (Regex/find? expected actual)
                           false))
                       :else false)))
             :expect expected})))

(defn stores [expected]
  (checker {:tag :stores
            :doc "Checks the value stored by a dereferenceable reference."
            :fn (fn [result]
                  (let [actual (result-data result)]
                    (if (derefable? actual)
                      ((satisfies expected) (deref actual))
                      false)))
            :expect expected}))

(defn anything [value] true)

(defn ->checker [value]
  (if (checker? value) value (satisfies value)))

(defn throws
  ([] (throws :hara/Error nil))
  ([error-type] (throws error-type nil))
  ([error-type message]
   (checker {:tag :throws
             :doc "Checks a captured native Error type and optional message."
             :fn (fn [result]
                   (let [error (cond
                                 (native-error? result) result
                                 (res-error? result) (res-error-value result)
                                 (and (map? result) (= :exception (:status result))) (:data result)
                                 :else nil)]
                     (and error
                          (or (= error-type :hara/Error) (= error-type (type error)))
                          (if message (= message (ex-message error)) true))))
             :expect {:exception error-type :message message}})))

(defmacro capture
  ([] `(code.test.checker.common/capture nil $0))
  ([check] `(code.test.checker.common/capture ~check $0))
  ([check symbol]
   `(fn [value#]
      (do
        (def ~symbol value#)
        (if ~check (~check value#) true)))))
