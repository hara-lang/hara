(ns code.test.checker.logic
  (:require [code.test.checker.common :as common]))

(defn is-not
  ([check] (is-not check identity))
  ([check function]
   (let [check (common/->checker check)]
     (common/checker
      {:tag :is-not
       :doc "Checks that a result does not match."
       :fn (fn [result] (not (check (function result))))
       :expect check}))))

(defn any [& checks]
  (let [checks (mapv common/->checker checks)]
    (common/checker
     {:tag :any
      :doc "Checks that any checker matches."
      :fn (fn [result]
            (reduce (fn [passing check]
                      (or passing (common/succeeded? (common/verify check result))))
                    false
                    checks))
      :expect checks})))

(defn all [& checks]
  (let [checks (mapv common/->checker checks)]
    (common/checker
     {:tag :all
      :doc "Checks that every checker matches."
      :fn (fn [result]
            (reduce (fn [passing check]
                      (and passing (common/succeeded? (common/verify check result))))
                    true
                    checks))
      :expect checks})))
