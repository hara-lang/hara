(ns code.test.result
  (:require [code.test.checker.common :as common]
            [std.typed.explain :as typed]))

(defn descriptor
  "Returns portable expected data without retaining checker functions."
  [expected]
  (if (common/checker? expected)
    (or (:form expected) (str expected))
    expected))

(defn compare
  "Compares actual and expected, returning one native Result<boolean>."
  [actual expected]
  (try
    (if (and (common/checker? expected)
             (= :typed/schema (get-in expected [:form :checker/type])))
      (let [outcome (typed/check (get-in expected [:form :checker/form]) actual)]
        (Result/with-context
         outcome
         {:test {:actual actual :expected (descriptor expected)}}))
      (if (common/checker? expected)
        (let [checker (common/->checker expected)
              passing (boolean (checker actual))]
          (Result/create
           :success passing
           {:test {:actual actual :expected (descriptor expected)}
            :failures []}))
        (Test/compare actual expected)))
    (catch Throwable error
      (Result/create
       :error error
       {:test {:actual actual :expected (descriptor expected)}}))))

(defn result
  "Adds test identity and display data to an existing comparison Result."
  [name actual expected comparison]
  (Test/result name actual (descriptor expected) comparison))

(defn passed? [value] (Test/passed? value))
(defn actual [value] (Test/actual value))
(defn expected [value] (Test/expected value))
(defn failures [value] (Test/failures value))
(defn failure-seq [value] (Test/failure-seq value))
(defn failure-count [value] (Test/failure-count value))
(defn failure [value index] (Test/failure value index))
(defn failure? [value] (Test/failure? value))
