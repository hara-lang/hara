(ns code.test.compile.types)

(def +type+ #{:core :template})
(defstruct Fact [type id ns path refer desc column line source global function meta])

(defn fact?
  [value]
  (instance? code.test.compile.types/Fact value))

(defn fact-display-info
  [fact]
  {:type (:type fact)
   :id (:id fact)
   :ns (:ns fact)
   :desc (:desc fact)
   :line (:line fact)})

(defn fact-display
  [fact]
  (str "{:type " (pr-str (:type fact))
       " :id " (pr-str (:id fact))
       " :ns " (pr-str (:ns fact))
       " :desc " (pr-str (:desc fact))
       " :line " (pr-str (:line fact))
       "}"))
(defn fact-invoke [fact] ((:function fact)))

(extend-type Fact IFn
  (invoke [fact & arguments]
    (apply (:function fact) arguments)))

(extend-type Fact IDisplay
  (display [fact]
    (str "#fact " (fact-display fact))))
