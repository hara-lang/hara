;; Runtime kernel facade for sandbox, sessions, resources, mounts, and VM traces.
(ns code.vm.kernel
  (:config {:role :facade})
  (:require [code.vm.instrument :as instrument]
            [code.vm.instrument.trace :as trace]))

;; Sandbox lifecycle.
(defn sandbox-open
  [spec]
  (Sandbox/open spec))

(defn sandbox-eval
  [id source]
  (Sandbox/eval id source))

(defn sandbox-call
  [id callable arguments]
  (Sandbox/call id callable arguments))

(defn sandbox-cancel
  [id]
  (Sandbox/cancel id))

(defn sandbox-status
  [id]
  (Sandbox/status id))

(defn sandbox-close
  [id]
  (Sandbox/close id))

;; Session and resource lifecycle.
(defn session-create
  [name]
  (Kernel/session-create name))

(defn session-close
  [name]
  (Kernel/session-close name))

(defn session-list
  []
  (Kernel/session-list))

(defn session-info
  [name]
  (Kernel/session-info name))

(defn session-eval
  [name source]
  (Kernel/session-eval name source))

(defn session-namespace
  [name]
  (Kernel/session-namespace name))

(defn session-complete
  [name prefix]
  (Kernel/session-complete name prefix))

(defn resource-register
  [name source]
  (Kernel/resource-register name source))

(defn resource-remove
  [name]
  (Kernel/resource-remove name))

(defn resource-list
  []
  (Kernel/resource-list))

;; Kernel-managed filesystem mounts. The native signature remains owned by the
;; runtime so this facade can carry the same boundary on JVM, Rust, and Wasm.
(defn filesystem-create
  [& arguments]
  (apply Kernel/filesystem-create arguments))

(defn filesystem-attach
  [& arguments]
  (apply Kernel/filesystem-attach arguments))

(defn filesystem-detach
  [& arguments]
  (apply Kernel/filesystem-detach arguments))

(defn filesystem-info
  [& arguments]
  (apply Kernel/filesystem-info arguments))

(defn filesystem-close
  [& arguments]
  (apply Kernel/filesystem-close arguments))

(defn capabilities
  []
  (Kernel/capabilities))

;; Instrumentation surface. Prefixes keep the event and trace models distinct
;; where both source namespaces expose a target or provenance function.
(def instrument-event-supported? instrument/event-supported?)
(def instrument-normalize-projection instrument/normalize-projection)
(def instrument-normalize-filter instrument/normalize-filter)
(def instrument-registration instrument/registration)
(def instrument-registration? instrument/registration?)
(def instrument-target instrument/target)
(def instrument-target? instrument/target?)
(def instrument-event instrument/event)
(def instrument-event? instrument/event?)
(def instrument-trace-provenance instrument/trace-provenance)

(def trace-live-machine? trace/live-machine?)
(def trace-target trace/target)
(def trace-provenance trace/provenance)
(def trace-create trace/create)
(def trace-consume trace/consume)
(def trace-consume-all trace/consume-all)
(def trace-from-events trace/from-events)
