;; ============================================================================
;; code.test — portable, data-first test registration and execution.
;;
;; The library owns test semantics but no terminal presentation. A reporter
;; receives structured events; hosts decide whether and how to print them.
;; ============================================================================
(ns code.test
  (:require [code.test.cli :as cli]
            [code.test.selector :as selector]
            [std.work :as work]))

(defstruct Matcher [predicate expected])
(defstruct ThrownValue [error])
(defstruct TimeoutValue [milliseconds])

;; Fact registration is evaluator-local domain state, not a provider protocol.
(def +registry+ (atom {}))

(defn clear-namespace-state
  [state namespace]
  (loop [output state
         remaining (keys state)]
    (if (seq remaining)
      (let [key (first remaining)]
        (recur (if (= namespace (first key))
                 (dissoc output key)
                 output)
               (rest remaining)))
      output)))

(defn registry-register
  [registry fact]
  (do
    (swap! registry
           (fn [state]
             (assoc state [(:namespace fact) (:name fact)] fact)))
    fact))

(defn registry-remove
  [registry namespace name]
  (let [key [namespace name]
        found (get (deref registry) key)]
    (swap! registry (fn [state] (dissoc state key)))
    found))

(defn registry-clear
  [registry namespace]
  (if namespace
    (swap! registry clear-namespace-state namespace)
    (reset! registry {})))

(defn registry-facts
  [registry]
  (vec (vals (deref registry))))

(defn registry-find
  [registry namespace name]
  (get (deref registry) [namespace name]))

(extend-type Matcher std.protocol.imatch/IMatch
  (match-value [matcher actual]
    {:pass ((field matcher :predicate) actual)
     :actual actual
     :expected (field matcher :expected)}))

(def => '=>)
(def +listeners+ {})
(def +global-settings+ (atom {}))

(defn anything
  [value]
  true)

(defn exactly
  "Matches a value using HAL equality."
  [expected]
  (code.test/Matcher (fn [actual] (= actual expected)) expected))

(defn satisfies
  "Matches when predicate returns truthy."
  [predicate]
  (code.test/Matcher predicate :satisfies))

(defn approx
  ([expected]
   (approx expected 0.001))
  ([expected threshold]
   (code.test/Matcher
    (fn [actual]
      (and (number? actual)
           (< (- expected threshold) actual)
           (< actual (+ expected threshold))))
    expected)))

(defn stores
  [expected]
  (code.test/Matcher
   (fn [actual]
     (try
       (= expected (deref actual))
       (catch Throwable error false)))
   expected))

(declare sequence-exact? sequence-any-order? map-contains?)

(defn matcher-for
  [expected]
  (cond (instance? code.test/Matcher expected)
        expected

        (fn? expected)
        (code.test/Matcher expected expected)

        (map? expected)
        (code.test/Matcher
         (fn [actual]
           (and (map? actual)
                (= (count expected) (count actual))
                (map-contains? expected actual)))
         expected)

        (or (vector? expected) (list? expected))
        (code.test/Matcher
         (fn [actual]
           (and (or (vector? actual) (list? actual))
                (sequence-exact? expected actual)))
         expected)

        (set? expected)
        (code.test/Matcher
         (fn [actual]
           (and (or (set? actual) (vector? actual) (list? actual))
                (= (count expected) (count actual))
                (sequence-any-order? (vec expected) (vec actual))))
         expected)

        :else
        (exactly expected)))

(defn sequence-exact?
  [expected actual]
  (and (= (count expected) (count actual))
       (reduce (fn [passing entry]
                 (and passing
                      (:pass
                       (std.protocol.imatch/match-value (matcher-for (nth expected (nth entry 0)))
                        (nth actual (nth entry 0))))))
               true
               (loop [index 0 output []]
                 (if (= index (count expected))
                   output
                   (recur (inc index) (conj output [index])))))))

(defn modifier-present?
  [modifiers target]
  (loop [remaining modifiers]
    (if (seq remaining)
      (if (= target (first remaining))
        true
        (recur (rest remaining)))
      false)))

(defn vector-without
  [values index]
  (loop [position 0 output []]
    (if (= position (count values))
      output
      (recur (inc position)
             (if (= position index)
               output
               (conj output (nth values position)))))))

(defn sequence-any-order?
  [expected actual]
  (if (empty? expected)
    true
    (let [matcher (matcher-for (first expected))]
      (loop [index 0]
        (if (= index (count actual))
          false
          (if (and (:pass (std.protocol.imatch/match-value matcher (nth actual index)))
                   (sequence-any-order? (vec (rest expected))
                                        (vector-without actual index)))
            true
            (recur (inc index))))))))

(defn sequence-prefix?
  [expected actual]
  (and (<= (count expected) (count actual))
       (sequence-exact? expected
                        (loop [index 0 output []]
                          (if (= index (count expected))
                            output
                            (recur (inc index)
                                   (conj output (nth actual index))))))))

(defn map-contains?
  [expected actual]
  (and
   (map? actual)
   (reduce
    (fn [passing entry]
      (and passing
           (:pass
            (std.protocol.imatch/match-value (matcher-for (nth entry 1))
                           (get actual (nth entry 0))))))
    true
    expected)))

(defn contains
  [expected & modifiers]
  (code.test/Matcher
   (fn [actual]
     (if (map? expected)
       (map-contains? expected actual)
       (if (or (vector? expected) (list? expected) (set? expected))
         (if (or (set? expected)
                 (modifier-present? modifiers :in-any-order))
           (and (<= (count expected) (count actual))
                (sequence-any-order? (vec expected) (vec actual)))
           (sequence-prefix? (vec expected) (vec actual)))
         (:pass
          (std.protocol.imatch/match-value (matcher-for expected) actual)))))
   expected))

(defn just
  [expected & modifiers]
  (code.test/Matcher
   (fn [actual]
     (if (map? expected)
       (and (= (count expected) (count actual))
            (map-contains? expected actual))
       (and (= (count expected) (count actual))
            (if (modifier-present? modifiers :in-any-order)
              (sequence-any-order? (vec expected) (vec actual))
              (sequence-exact? (vec expected) (vec actual))))))
   expected))

(defn contains-in-form
  [expected]
  (cond (map? expected)
        (list (quote code.test/contains)
              (reduce-kv (fn [output key value]
                           (assoc output key (contains-in-form value)))
                         {}
                         expected))

        (set? expected)
        (list (quote code.test/contains)
              (vec (map contains-in-form expected))
              :in-any-order)

        (vector? expected)
        (list (quote code.test/contains)
              (vec (map contains-in-form expected)))

        :else expected))

(defn just-in-form
  [expected]
  (cond (map? expected)
        (list (quote code.test/just)
              (reduce-kv (fn [output key value]
                           (assoc output key (just-in-form value)))
                         {}
                         expected))

        (set? expected)
        (list (quote code.test/just)
              (vec (map just-in-form expected))
              :in-any-order)

        (vector? expected)
        (list (quote code.test/just)
              (vec (map just-in-form expected)))

        :else expected))

(defmacro contains-in
  [expected]
  (contains-in-form expected))

(defmacro just-in
  [expected]
  (just-in-form expected))

(defn throws-info
  ([] (throws))
  ([expected] (throws)))

(defn is-not
  [expected]
  (let [matcher (matcher-for expected)]
    (code.test/Matcher
     (fn [actual]
       (not (:pass
             (std.protocol.imatch/match-value matcher actual))))
     expected)))

(defn any
  [& expected]
  (let [matchers
        (loop [remaining (vec expected)
               output []]
          (if (empty? remaining)
            output
            (recur (vec (rest remaining))
                   (conj output (matcher-for (first remaining))))))]
    (code.test/Matcher
     (fn [actual]
       (reduce
        (fn [passing matcher]
          (or passing
              (:pass
               (std.protocol.imatch/match-value matcher actual))))
        false matchers))
     expected)))

(defn all
  [& expected]
  (let [matchers
        (loop [remaining (vec expected)
               output []]
          (if (empty? remaining)
            output
            (recur (vec (rest remaining))
                   (conj output (matcher-for (first remaining))))))]
    (code.test/Matcher
     (fn [actual]
       (reduce
        (fn [passing matcher]
          (and passing
               (:pass
                (std.protocol.imatch/match-value matcher actual))))
        true matchers))
     expected)))

(defn throws
  "Matches any value thrown while evaluating an assertion."
  []
  (code.test/Matcher
   (fn [actual] (instance? code.test/ThrownValue actual))
   :throws))

(defn timed-settle
  [options promise milliseconds]
  (let [timeout-function (:work/timeout-promise options)
        cancel-function (:work/cancel-timeout options)
        binding (timeout-function promise milliseconds)
        wrapped (if (map? binding) (:promise binding) binding)
        timeout (if (map? binding) (:timeout binding) nil)
        outcome (try
                  (deref wrapped)
                  (finally
                    (if (and timeout cancel-function)
                      (cancel-function timeout)
                      nil)))]
    (if (and (map? outcome) (= :timeout (:test/status outcome)))
      (code.test/TimeoutValue milliseconds)
      (if (and (map? outcome) (= :value (:test/status outcome)))
        (:value outcome)
        outcome))))

(defn settle
  "Returns an ordinary value, awaiting a Promise through generic std.work
   context capabilities when a timeout is requested."
  ([value]
   (settle value {}))
  ([value options]
   (if (promise? value)
     (if (and (:work/timeout-promise options) (:timeout options))
       (timed-settle options value (:timeout options))
       (deref value))
     value)))

(defn check
  "Evaluates thunk and returns a structured check result."
  ([thunk expected]
   (check thunk expected {}))
  ([thunk expected options]
   (try
     (let [actual (settle (thunk) options)]
       (if (instance? code.test/TimeoutValue actual)
         {:pass false
          :status :timeout
          :actual nil
          :expected expected
          :timeout (field actual :milliseconds)}
         (if (instance? code.test/Matcher expected)
           (std.protocol.imatch/match-value expected actual)
           (if (fn? expected)
             {:pass (if (expected actual) true false)
              :actual actual
              :expected expected}
             {:pass (= actual expected)
              :actual actual
              :expected expected}))))
     (catch Throwable error
       (let [actual (code.test/ThrownValue error)]
         (if (instance? code.test/Matcher expected)
           (std.protocol.imatch/match-value expected actual)
           {:pass false
            :status :error
            :actual nil
            :expected expected
            :error (str error)}))))))

(defn register!
  "Registers a fact in the current namespace."
  ([name function]
   (register! name function {}))
  ([name function metadata]
   (registry-register +registry+
    {:namespace (current-namespace)
     :name name
     :function function
     :meta metadata})))

(defn remove-fact
  "Removes a fact from namespace, defaulting to the current namespace."
  ([name]
   (remove-fact (current-namespace) name))
  ([namespace name]
   (registry-remove +registry+
    namespace
    name)))

(defn purge-facts
  "Clears facts from namespace, defaulting to the current namespace."
  ([] (purge-facts (current-namespace)))
  ([namespace]
   (registry-clear +registry+
    namespace)))

(defn purge-all
  "Clears the complete test registry."
  []
  (registry-clear +registry+ nil))

(defn tests
  "Returns all registered fact records."
  []
  (registry-facts +registry+))

(defn registry
  "Returns the registry snapshot keyed by [namespace fact-name]."
  []
  (deref +registry+))

(defn get-fact
  "Returns a fact by namespace and name."
  ([name] (get-fact (current-namespace) name))
  ([namespace name]
   (registry-find +registry+
    namespace
    name)))

(defn assertion-forms-strict
  [forms form-meta options]
  (loop [remaining forms
         output []]
    (if (= 0 (count remaining))
      output
      (if (< (count remaining) 3)
        (throw (ex-info "fact assertions must be actual => expected triples"
                        {:remaining remaining :form-meta form-meta}))
        (let [actual (nth remaining 0)
              arrow (nth remaining 1)
              expected (nth remaining 2)
              check-options (list 'merge
                                  (list 'quote form-meta)
                                  options
                                  'run-options)]
          (if (not (= arrow '=>))
            (throw "fact expects => between actual and expected")
            (recur
             (vec (rest (rest (rest remaining))))
             (conj output
                   `(code.test/check
                     (fn [] ~actual)
                     ~expected
                     ~check-options)))))))))

(defn assertion-forms
  [forms form-meta options]
  (loop [remaining forms
         setup []]
    (if (= 0 (count remaining))
      (if (= 0 (count setup))
        []
        (apply list (quote do) (concat setup [[]])))
      (if (and (>= (count remaining) 3)
               (= (nth remaining 1) (quote =>)))
        (let [checks (assertion-forms-strict remaining form-meta options)]
          (if (= 0 (count setup))
            checks
            (apply list (quote do) (concat setup [checks]))))
        (recur (vec (rest remaining))
               (conj setup (first remaining)))))))

(defn fact-form
  "Builds the registration form for one or more fact assertions."
  [description body form-meta]
  (let [forms (vec body)
        options (if (map? (first forms)) (first forms) {})
        assertions (if (map? (first forms)) (vec (rest forms)) forms)
        checks (assertion-forms assertions form-meta options)
        setup (:setup form-meta)
        teardown (:teardown form-meta)
        hooks (merge
               (if setup
                 {:before (apply list (quote fn) [] setup)}
                 {})
               (if teardown
                 {:after (apply list (quote fn) [] teardown)}
                 {}))
        registration-options (list (quote merge)
                                   (list (quote quote) form-meta)
                                   options
                                   hooks
                                   (if (= 0 (count checks))
                                     {:skip true}
                                     {}))]
    `(code.test/register!
      ~description
      (fn [run-options] ~checks)
      ~registration-options)))

(defmacro fact
  "Registers one or more actual => expected assertions."
  [description & body]
  (fact-form description body (meta &form)))

(defn selector-match?
  [selection value]
  (selector/matches? selection value))

(defn tag-selected?
  [fact options]
  (let [tags (or (:tags (:meta fact)) #{})
        include (:include-tags options)
        exclude (:exclude-tags options)
        included (if include
                   (reduce (fn [found tag]
                             (or found (selector/matches? include tag)))
                           false
                           tags)
                   true)
        excluded (if exclude
                   (reduce (fn [found tag]
                             (or found (selector/matches? exclude tag)))
                           false
                           tags)
                   false)]
    (and included (not excluded))))

(defn matches-selection?
  "Returns true when a fact matches namespace, name, and tag selectors."
  [fact options]
  (let [metadata (assoc (:meta fact) :namespace (:namespace fact))]
    (and
     (selector-match? (:namespace options) (:namespace fact))
     (selector-match? (:name options) (:name fact))
     (tag-selected? fact options)
     (selector/matches-options? metadata options))))

(defn selected?
  "Compatibility predicate: matching facts explicitly marked :skip are not
   executable, though the runner retains them as structured skipped results."
  [fact options]
  (and (matches-selection? fact options)
       (not (:skip (:meta fact)))))

(defn checks-pass?
  [checks]
  (reduce (fn [passing check-result]
            (and passing (:pass check-result)))
          true
          checks))

(defn checks-error?
  [checks]
  (reduce (fn [errored check-result]
            (or errored (= :error (:status check-result))))
          false
          checks))

(defn checks-timeout?
  [checks]
  (reduce (fn [timed-out check-result]
            (or timed-out (= :timeout (:status check-result))))
          false
          checks))

(defn normalize-checks
  [value]
  (if (vector? value)
    value
    (if (map? value)
      [value]
      [{:pass true :actual value :expected :returned}])))

(defn clock-now
  [options]
  (let [now (:work/now options)]
    (if now (now) nil)))

(defn run-hook
  [hook options]
  (if hook
    (settle (hook) options)
    nil))

(defn run-hooks
  [hooks options]
  (reduce (fn [output hook]
            (do (run-hook hook options) output))
          nil
          hooks))

(defn fact-cancelled?
  [fact options]
  (if (:cancelled options) true false))

(defn run-fact
  "Runs one fact and returns a structured test-domain result.

   Work graph stages own lifecycle event emission. This function owns only fact
   semantics, hooks, assertion classification and optional elapsed projection."
  ([fact]
   (run-fact fact {}))
  ([fact options]
   (let [identity {:namespace (:namespace fact)
                   :name (:name fact)
                   :meta (:meta fact)}
         start (clock-now options)
         result
         (if (:skip (:meta fact))
           (merge identity {:status :skipped :checks []})
           (if (fact-cancelled? fact options)
             (merge identity {:status :cancelled :checks []})
             (try
               (let [checks
                     (try
                       (do
                         (run-hooks [(:before-each options)
                                     (:before (:meta fact))]
                                    options)
                         (normalize-checks
                          (settle ((:function fact) options) options)))
                       (finally
                         (run-hooks [(:after (:meta fact))
                                     (:after-each options)]
                                    options)))
                     status (if (checks-timeout? checks)
                              :timeout
                              (if (checks-error? checks)
                                :error
                                (if (checks-pass? checks)
                                  :passed
                                  :failed)))]
                 (merge identity {:status status :checks checks}))
               (catch Throwable error
                 (merge identity
                        {:status :error
                         :checks []
                         :error (str error)})))))
         end (clock-now options)
         timed-result (if (and start end)
                        (assoc result :elapsed (- end start))
                        result)]
     timed-result)))

(defn result-counts
  [results]
  (reduce (fn [counts result]
            (update counts (:status result) (fn [count] (inc (or count 0)))))
          {:passed 0
           :failed 0
           :error 0
           :timeout 0
           :skipped 0
           :cancelled 0}
          results))

(defn check-counts
  [results]
  (reduce
   (fn [counts result]
     (reduce (fn [current check-result]
               (update current
                       (if (:pass check-result) :passed :failed)
                       (fn [count] (inc (or count 0)))))
             counts
             (:checks result)))
   {:total 0 :passed 0 :failed 0}
   results))

(defn attach-check-total
  [counts]
  (assoc counts :total (+ (:passed counts) (:failed counts))))

(defn failing-status?
  [status]
  (or (= status :failed)
      (= status :error)
      (= status :timeout)))

(defn fact-order-key
  [fact]
  (str (:namespace fact) "/" (:name fact)))

(defn insert-fact
  [facts fact]
  (loop [index 0
         output []]
    (if (= index (count facts))
      (conj output fact)
      (if (< (compare (fact-order-key fact)
                      (fact-order-key (nth facts index)))
             0)
        (loop [remaining index
               inserted (conj output fact)]
          (if (= remaining (count facts))
            inserted
            (recur (inc remaining)
                   (conj inserted (nth facts remaining)))))
        (recur (inc index) (conj output (nth facts index)))))))

(defn order-facts
  [facts]
  (reduce insert-fact [] facts))

(def +default-work-revision+ 1)

(defn work-revision
  [options]
  (or (:test/revision options)
      +default-work-revision+))

(defn work-context-options
  [context]
  (let [base (or (:test/options context) {})
        now (:work/now context)
        timeout-promise (:work/timeout-promise context)
        cancel-timeout (:work/cancel-timeout context)]
    (merge base
           (if now {:work/now now} {})
           (if timeout-promise
             {:work/timeout-promise timeout-promise}
             {})
           (if cancel-timeout
             {:work/cancel-timeout cancel-timeout}
             {}))))

(defn work-execution-options
  [input context]
  (merge (or input {})
         (work-context-options context)))

(defn fact-identity
  [value]
  (str value))

(defn fact-coordinate
  [namespace name fact-revision]
  [:test/fact
   (fact-identity namespace)
   (fact-identity name)
   fact-revision])

(defn fact-revision
  [fact default-revision]
  (or (:test/revision (:meta fact))
      default-revision))

(defn fact-definition-token
  "Returns the stable definition token used to invalidate a fact checkpoint.

   A producer may supply a canonical source digest as `:test/digest`, or another
   stable definition identity as `:test/definition`. The explicit fact/suite
   revision remains the compatibility fallback until portable source hashing is
   available in every runtime."
  [fact default-revision]
  (let [metadata (:meta fact)]
    (or (:test/digest metadata)
        (:test/definition metadata)
        (fact-revision fact default-revision))))

(defn fact-item-coordinate
  [fact default-revision]
  (let [fact-revision (fact-revision fact default-revision)]
    (conj
     (fact-coordinate (:namespace fact)
                      (:name fact)
                      fact-revision)
     (fact-definition-token fact default-revision))))

(defn resolve-fact
  [namespace name]
  (let [namespace (fact-identity namespace)
        name (fact-identity name)
        fact (get-fact namespace name)]
    (if fact
      fact
      (throw
       (ex-info "Registered test fact does not exist"
                {:namespace namespace
                 :name name})))))

(defn resolve-subject-fact
  "Resolves a prepared fact and rejects definition drift before execution."
  [subject]
  (let [fact (resolve-fact (:namespace subject) (:name subject))
        expected (:test/definition subject)
        actual (fact-definition-token fact (:test/revision subject))]
    (if (and expected (not= expected actual))
      (throw
       (ex-info "Registered test fact definition changed after preparation"
                {:namespace (:namespace subject)
                 :name (:name subject)
                 :expected expected
                 :actual actual})))
    fact))

(defn fact-work
  "Returns one checkpointed fact boundary. Assertion failures, skips, timeouts,
   and test errors are completed domain results returned by code.test/run-fact."
  ([namespace name]
   (fact-work namespace name +default-work-revision+))
  ([namespace name fact-revision]
   (work/step
    {:id (fact-coordinate namespace name fact-revision)
     :version fact-revision
     :test/revision fact-revision}
    (fn [input context]
      (let [options (work-execution-options input context)
            fact (resolve-fact namespace name)]
        (work/emit! context
                    :test/fact-started
                    (fact-result-identity fact))
        (let [result (run-fact fact options)]
          (work/emit! context :test/fact-completed result)
          result))))))

(defn unsupported-batch-options
  [options]
  (reduce
   (fn [output key]
     (if (and (has? options key)
              (not (nil? (get options key)))
              (not (= false (get options key))))
       (conj output key)
       output))
   []
   +unsupported-batch-options+))

(defn assert-batch-options!
  [options]
  (let [unsupported (unsupported-batch-options options)]
    (if (seq unsupported)
      (throw
       (ex-info
        "Fact batch execution does not support fail-fast scheduling"
        {:unsupported unsupported
         :options options})))
    options))

(defn selected-facts
  [options]
  (order-facts
   (vec
    (filter
     (fn [fact]
       (matches-selection? fact options))
     (tests)))))

(defn data-options
  [input context]
  (merge (normalize-run-options input)
         (or (:test/options context) {})))

(defn effective-suite-options
  [facts options]
  (let [namespace (if (seq facts)
                    (:namespace (first facts))
                    nil)
        suite-options
        (or (get (deref +global-settings+) namespace)
            {})]
    (merge suite-options options)))

(defn fact-item
  [fact options default-revision]
  (let [fact-revision (fact-revision fact default-revision)
        definition-token (fact-definition-token fact default-revision)]
    {:item/id (fact-item-coordinate fact default-revision)
     :item/value
     {:namespace (fact-identity (:namespace fact))
      :name (fact-identity (:name fact))
      :test/revision fact-revision
      :test/definition definition-token
      :test/options options}}))

(defn prepare-fact-batch
  [input context default-revision]
  (let [input-options (data-options input context)
        facts (selected-facts input-options)
        options (assert-batch-options!
                 (effective-suite-options facts input-options))
        items
        (vec
         (map
          (fn [fact]
            (fact-item fact options default-revision))
          facts))]
    {:test/options options
     :test/items items}))

(defn fact-manifest
  [input context default-revision]
  (:test/items
   (prepare-fact-batch input context default-revision)))

(defn summary-from-results
  [results]
  (let [counts (result-counts results)
        checks (attach-check-total
                (check-counts results))
        status (if (and (= 0 (:failed counts))
                        (= 0 (:error counts))
                        (= 0 (:timeout counts)))
                 :passed
                 :failed)
        namespaces
        (reduce
         (fn [output result]
           (conj output (:namespace result)))
         #{}
         results)]
    {:status status
     :counts counts
     :check-counts checks
     :files (count namespaces)
     :facts (count results)
     :checks (:total checks)
     :passed (:passed checks)
     :failed (:failed checks)
     :throw (:error counts)
     :timeout (:timeout counts)
     :results results}))

(defn fact-options
  [subject context]
  (work-execution-options (:test/options subject) context))

(defn fact-result-identity
  [fact]
  {:namespace (:namespace fact)
   :name (:name fact)
   :meta (:meta fact)})

(defn error-result
  [fact error]
  (merge (fact-result-identity fact)
         {:status :error
          :checks []
          :error (str error)}))

(defn fact-mode
  [subject context]
  (let [fact (resolve-subject-fact subject)
        options (fact-options subject context)]
    (if (:skip (:meta fact))
      :terminal
      (if (fact-cancelled? fact options)
        :terminal
        :run))))

(defn terminal-fact-result
  [subject context]
  (let [fact (resolve-subject-fact subject)
        options (fact-options subject context)]
    (work/emit! context
                :test/fact-started
                (fact-result-identity fact))
    (let [result (run-fact fact options)]
      (work/emit! context :test/fact-completed result)
      result)))

(defn before-fact
  [subject context]
  (let [fact (resolve-subject-fact subject)
        options (fact-options subject context)
        identity (fact-result-identity fact)
        start (clock-now options)]
    (work/emit! context :test/fact-started identity)
    (try
      (do
        (run-hooks [(:before-each options)
                         (:before (:meta fact))]
                        options)
        {:subject subject
         :test/start start
         :test/before-error nil})
      (catch Throwable error
        {:subject subject
         :test/start start
         :test/before-error (str error)}))))

(defn execute-fact-body
  [fact options]
  (try
    (let [checks
          (normalize-checks
           (settle ((:function fact) options) options))
          status (if (checks-timeout? checks)
                   :timeout
                   (if (checks-error? checks)
                     :error
                     (if (checks-pass? checks)
                       :passed
                       :failed)))]
      (merge (fact-result-identity fact)
             {:status status
              :checks checks}))
    (catch Throwable error
      (error-result fact error))))

(defn run-fact-body
  [state context]
  (let [subject (:subject state)
        fact (resolve-subject-fact subject)
        options (fact-options subject context)
        result
        (if (:test/before-error state)
          (error-result fact (:test/before-error state))
          (execute-fact-body fact options))]
    (assoc state :test/result result)))

(defn after-fact
  [outcome context]
  (let [state (:work/body-result outcome)
        subject (or (:subject state)
                    (:work/input outcome))
        fact (resolve-subject-fact subject)
        options (fact-options subject context)]
    (try
      (do
        (run-hooks [(:after (:meta fact))
                         (:after-each options)]
                        options)
        {:status :completed})
      (catch Throwable error
        {:status :error
         :error (str error)}))))

(defn timed-result
  [result start options]
  (let [end (clock-now options)]
    (if (and start end)
      (assoc result :elapsed (- end start))
      result)))

(defn finalize-fact
  [outcome context]
  (let [state (get-in outcome [:work/body :result])
        subject (:subject state)
        fact (resolve-subject-fact subject)
        options (fact-options subject context)
        cleanup (get-in outcome [:work/cleanup :result])
        result (if (= :error (:status cleanup))
                 (error-result fact (:error cleanup))
                 (:test/result state))
        result (timed-result result (:test/start state) options)]
    (work/emit! context :test/fact-completed result)
    result))

(defn running-fact-work
  [batch-revision]
  (work/chain
   {:id 'code.test/fact-scope-chain
    :version batch-revision}
   [(work/ensure
     {:id 'code.test/fact-scope
      :version batch-revision
      :return :outcome}
     (work/chain
      {:id 'code.test/fact-body-chain
       :version batch-revision}
      [(work/step
        {:id 'code.test/fact-before
         :version batch-revision}
        before-fact)
       (work/step
        {:id 'code.test/fact-body
         :version batch-revision}
        run-fact-body)])
     (work/step
      {:id 'code.test/fact-after
       :version batch-revision}
      after-fact))
    (work/step
     {:id 'code.test/fact-finalize
      :version batch-revision}
     finalize-fact)]))

(defn fact-process-work
  [batch-revision]
  (work/choose
   {:id 'code.test/fact-dispatch
    :version batch-revision}
   (work/step
    {:id 'code.test/fact-mode
     :version batch-revision}
    fact-mode)
   {:terminal
    (work/step
     {:id 'code.test/fact-terminal
      :version batch-revision}
     terminal-fact-result)
    :run
    (running-fact-work batch-revision)}))

(defn stop-after-fact?
  [state context]
  (let [subject (:item/value (:item state))
        options (:test/options subject)
        result (:result state)]
    (and (:fail-fast options)
         (failing-status? (:status result)))))

(defn remaining-items
  [batch]
  (let [items (vec (:items batch))
        processed (count (:results batch))]
    (loop [index processed
           output []]
      (if (= index (count items))
        output
        (recur (inc index) (conj output (nth items index)))))))

(defn cancelled-fact-result
  [item]
  (let [subject (:item/value item)
        fact (resolve-subject-fact subject)]
    (merge (fact-result-identity fact)
           {:status :cancelled
            :checks []
            :reason :fail-fast})))

(defn cancelled-fact-results
  [items context]
  (reduce
   (fn [output item]
     (let [result (cancelled-fact-result item)]
       (work/emit! context :test/fact-completed result)
       (conj output result)))
   []
   items))

(defn summarise-fact-batch
  [batch context]
  (let [completed (work/manifest-values (:results batch))
        cancelled (cancelled-fact-results (remaining-items batch) context)]
    (summary-from-results (vec (concat completed cancelled)))))

(defn suite-before
  [prepared context]
  (let [options (work-execution-options (:test/options prepared) context)]
    (work/emit! context
                :test/run-started
                {:count (count (:test/items prepared))})
    (run-hook (:before-all options) options)
    nil))

(defn suite-after
  [outcome context]
  (let [prepared (:work/input outcome)
        options (work-execution-options (:test/options prepared) context)
        body-result (:work/body-result outcome)]
    (run-hook (:after-all options) options)
    (if (= :completed (:work/body-status outcome))
      (work/emit! context
                  :test/run-completed
                  (:summary body-result))
      nil)
    {:status :completed}))

(defn fact-batch-body
  [batch-revision]
  (work/chain
   {:id 'code.test/fact-batch-body
    :version batch-revision}
   [(work/all
     {:id 'code.test/suite-start
      :version batch-revision}
     [(work/pure
       {:id 'code.test/suite-state
        :version batch-revision}
       (fn [prepared context] prepared))
      (work/step
       {:id 'code.test/suite-before
        :version batch-revision}
       suite-before)])
    (work/pure
     {:id 'code.test/suite-state-after-start
      :version batch-revision}
     (fn [outputs context]
       (nth outputs 0)))
    (work/batch
     {:id 'code.test/fact-batch-items
      :version batch-revision}
     {:list
      (work/pure
       {:id 'code.test/fact-list
        :version batch-revision}
       (fn [prepared context]
         (:test/items prepared)))

      :process
      (fact-process-work batch-revision)

      :stop
      (work/pure
       {:id 'code.test/fact-stop
        :version batch-revision}
       stop-after-fact?)

      :summarise
      (work/pure
       {:id 'code.test/fact-summary
        :version batch-revision}
       summarise-fact-batch)})]))

(defn fact-batch-work
  "Returns the canonical suite graph with independently checkpointed facts.

   Suite and fact cleanup use work/ensure. Test lifecycle events commit directly
   through std.work. Fail-fast is a generic batch stop policy; unstarted facts
   are projected as cancelled test-domain results."
  ([]
   (fact-batch-work +default-work-revision+))
  ([batch-revision]
   (work/chain
    {:id 'code.test/fact-batch
     :version batch-revision
     :test/revision batch-revision}
    [(work/pure
      {:id 'code.test/fact-batch-prepare
       :version batch-revision}
      (fn [input context]
        (prepare-fact-batch input context batch-revision)))
     (work/ensure
      {:id 'code.test/suite-scope
       :version batch-revision}
      (fact-batch-body batch-revision)
      (work/step
       {:id 'code.test/suite-after
        :version batch-revision}
       suite-after))
     (work/pure
      {:id 'code.test/suite-result
       :version batch-revision}
      (fn [batch context]
        (:summary batch)))])))

(defn batch-summary
  [result]
  (if (and (map? result) (has? result :summary))
    (:summary result)
    result))

(def suite-work fact-batch-work)
(def +runner-work+ (fact-batch-work))

(defn normalize-run-options
  [selector-or-options]
  (if (map? selector-or-options)
    selector-or-options
    {:namespace selector-or-options}))

(defn run
  "Runs selected facts through the canonical IWork fact-batch graph."
  ([] (code.test/run {}))
  ([selector-or-options]
   (code.test/run (work/local-runtime) selector-or-options {}))
  ([runtime selector-or-options]
   (code.test/run runtime selector-or-options {}))
  ([runtime selector-or-options work-options]
   (let [options (normalize-run-options selector-or-options)]
     (work/run runtime
               (fact-batch-work (work-revision options))
               options
               work-options))))

(defn start
  "Starts the canonical fact-batch graph and returns a work reference."
  ([runtime selector-or-options]
   (start runtime selector-or-options {}))
  ([runtime selector-or-options work-options]
   (let [options (normalize-run-options selector-or-options)]
     (work/start runtime
                 (fact-batch-work (work-revision options))
                 options
                 work-options))))

(defn batch-result
  [runtime reference]
  (batch-summary (work/result runtime reference)))

(def run-batch run)
(def start-batch start)
(defn run-tests
  "Compatibility name for run."
  ([] (run {}))
  ([options] (run options)))

(defn fact:purge [] (purge-facts))
(defn fact:list [] (map :name (tests)))
(defn fact:missing [] [])
(defmacro fact:all [& body] `(do ~@body))
(defmacro fact:get [name] `(code.test/get-fact ~name))
(defmacro fact:exec [name]
  `((:function (code.test/get-fact ~name)) {}))
(defmacro fact:setup [& body] `(do ~@body))
(defmacro fact:setup? [& body] `(do ~@body))
(defmacro fact:teardown [& body] `(do ~@body))
(defmacro fact:remove [name] `(code.test/remove-fact ~name))
(defmacro fact:symbol [name] name)
(defmacro fact:template [description & body]
  `(code.test/fact ~description ~@body))
(defmacro fact:global [settings]
  (let [setup (or (:setup settings) [])
        teardown (or (:teardown settings) [])]
    `(swap! +global-settings+
            assoc
            (current-namespace)
            {:before-all (fn [] ~@setup)
             :after-all (fn [] ~@teardown)})))
(defmacro fact:ns [& body] `(do ~@body))
(defn fact:ns-load [namespace] namespace)

(def run:current run)
(def run:test run)
(def run:load run)
(def run:unload run)
(def run-errored run)

(defn run:interrupt [] true)
(defn run:report
  ([path] (run {:report path}))
  ([path options] (run (assoc options :report path)))
  ([path options project] (run (assoc options :report path))))

(defn print-options
  ([] (print-options :help))
  ([options]
   (if (= options :help)
     #{:help :current :default :disable :all}
     options)))

(defn process-test-args
  [arguments]
  (cli/process-args (cli/collapse-only arguments)))

(defn -main
  [& arguments]
  (run (process-test-args arguments)))
