;; ============================================================================
;; db.node.proxy-base — client-side forwarding handlers.
;; ============================================================================
(ns db.node.proxy-base
  (:require [db.node.kernel-base :as db-kernel]
            [db.node.kernel-batch :as batch]
            [db.node.kernel-service :as service]
            [db.node.lifecycle :as lifecycle]
            [db.node.proxy-util :as proxy]
            [std.substrate :as substrate]))

(def CALL-ACTIONS
  [db-kernel/ACTION-KERNEL-INIT
   db-kernel/ACTION-KERNEL-SETUP
   db-kernel/ACTION-KERNEL-TEARDOWN
   db-kernel/ACTION-SERVICE-INFO
   db-kernel/ACTION-EXEC
   db-kernel/ACTION-QUERY
   batch/ACTION-BATCH
   lifecycle/ACTION-FINALIZE
   service/ACTION-RUNTIME-STATUS
   service/ACTION-DRIVER-LIST
   service/ACTION-SERVICE-LIST
   service/ACTION-SERVICE-OPEN
   service/ACTION-SERVICE-CLOSE
   service/ACTION-SERVICE-CLOSE-ALL
   service/ACTION-SERVICE-EXISTS])

(defn request-proxy
  [space args request node]
  (proxy/request-proxy space args request node))

(defn init-proxy-handlers
  "Installs forwarding handlers for all database runtime actions."
  [node]
  (reduce (fn [current action]
            (substrate/register-handler current action request-proxy {})
            current)
          node
          CALL-ACTIONS)
  node)
