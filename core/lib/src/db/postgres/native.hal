(ns db.postgres.native
  (:require [db.postgres.connection :as connection]))

(def provider :postgres)
(defn provider-options [options] (assoc (or options {}) :provider provider))
(defn open ([] (open {})) ([options] (connection/open (provider-options options))))
(def close connection/close)
(def exec connection/exec)
(def execute connection/execute)
(def query connection/query)
(def batch-exec connection/batch-exec)
(def describe connection/describe)
(def capabilities connection/capabilities)
(def version connection/version)
(def begin connection/begin)
(def commit connection/commit)
(def rollback connection/rollback)
(def listen connection/listen)
(def next-notification connection/next-notification)
(def unlisten connection/unlisten)
(def notify connection/notify)
(def wait-ready connection/wait-ready)
(def database-create connection/database-create)
(def database-drop connection/database-drop)
(def server-start connection/server-start)
(def server-stop connection/server-stop)
(def numeric connection/numeric)
(def sql-array connection/sql-array)
