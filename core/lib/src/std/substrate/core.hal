;; ============================================================================
;; std.substrate.core — canonical substrate node-state primitives.
;;
;; This internal namespace owns only the portable atom-backed state operations
;; shared by the std.substrate package. The public SubstrateNode identity lives
;; in std.substrate; no parallel legacy node or frame model is created here.
;; ============================================================================
(ns std.substrate.core)

(defn empty-state
  "Returns the initial state map for a canonical substrate node."
  []
  {:spaces {}
   :services {}
   :handlers {}
   :triggers {}
   :pending {}
   :router {}
   :transports {}
   :meta {}})

(defn node-state
  "Returns the complete immutable state snapshot for node."
  [node]
  (deref (:state node)))

(defn node-section
  "Returns one state section, or an empty map when it is absent."
  [node section]
  (get (node-state node) section {}))

(defn section-put
  "Associates value under id in section and returns value."
  [node section id value]
  (swap! (:state node)
         (fn [state]
           (assoc state
                  section
                  (assoc (get state section {}) id value))))
  value)

(defn section-remove
  "Removes id from section and returns its previous value."
  [node section id]
  (let [previous (get (node-section node section) id)]
    (swap! (:state node)
           (fn [state]
             (assoc state
                    section
                    (dissoc (get state section {}) id))))
    previous))
