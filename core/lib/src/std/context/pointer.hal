(ns std.context.pointer
  (:require [std.foundation :refer :all :exclude [pointer]]
            [std.context.registry :as registry]
            [std.context.space :as space]))

(def ^{:dynamic true} *runtime* nil)

(defstruct pointer-type [context fields runtime resolver])

(defn pointer-default [pointer]
  (or *runtime*
      (:runtime pointer)
      (if (:resolver pointer) ((:resolver pointer) pointer))
      (space/space:rt-current (:context pointer))))

(defn pointer-deref [pointer]
  (let [runtime (pointer-default pointer)]
    (IContext/call runtime pointer)))

(extend-type pointer-type IPointer
  (ptr-context [pointer] (:context pointer))
  (ptr-keys [pointer] (keys (:fields pointer)))
  (ptr-val [pointer key] (get (:fields pointer) key)))

(extend-type pointer-type IApplicable
  (apply-default [pointer] (pointer-default pointer))
  (apply-in [pointer runtime args]
    (apply IContext/call runtime args))
  (transform-in [pointer runtime args] args)
  (transform-out [pointer runtime args value] value))

(extend-type pointer-type IInvokeIn
  (invoke-in [pointer runtime & args]
    (IApplicable/apply-in pointer runtime args)))

(defn pointer? [value]
  (instance? pointer-type value))

(defn pointer [options]
  (let [context (:context options)]
    (if (nil? context)
      (throw (ex-info "Context required" {:options options})))
    (std.context.pointer/pointer-type
     context
     (dissoc options :context :context/rt :context/fn)
     (:context/rt options)
     (:context/fn options))))

(defn rt-call [runtime-or-context & args]
  (apply IContext/call
         (if (keyword? runtime-or-context)
           (space/space:rt-current runtime-or-context)
           runtime-or-context)
         args))

(defn rt-has-module? [runtime-or-context module]
  (IContextLifeCycle/has-module?
   (if (keyword? runtime-or-context)
     (space/space:rt-current runtime-or-context)
     runtime-or-context)
   module))

(defn rt-setup-module [runtime-or-context module]
  (IContextLifeCycle/setup-module
   (if (keyword? runtime-or-context)
     (space/space:rt-current runtime-or-context)
     runtime-or-context)
   module))

(defn rt-teardown-module [runtime-or-context module]
  (IContextLifeCycle/teardown-module
   (if (keyword? runtime-or-context)
     (space/space:rt-current runtime-or-context)
     runtime-or-context)
   module))

(defn rt-has-pointer? [runtime-or-context pointer]
  (IContextLifeCycle/has-pointer?
   (if (keyword? runtime-or-context)
     (space/space:rt-current runtime-or-context)
     runtime-or-context)
   pointer))

(defn rt-setup-pointer [runtime-or-context pointer]
  (IContextLifeCycle/setup-pointer
   (if (keyword? runtime-or-context)
     (space/space:rt-current runtime-or-context)
     runtime-or-context)
   pointer))

(defn rt-teardown-pointer [runtime-or-context pointer]
  (IContextLifeCycle/teardown-pointer
   (if (keyword? runtime-or-context)
     (space/space:rt-current runtime-or-context)
     runtime-or-context)
   pointer))

(def +init+
  ['rt-call 'rt-has-module? 'rt-setup-module 'rt-teardown-module
   'rt-has-pointer? 'rt-setup-pointer 'rt-teardown-pointer])
