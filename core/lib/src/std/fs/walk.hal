;; Promise-based deterministic traversal over std.native.File/entries.
(ns std.fs.walk
  (:config {:override [walk]})
  (:require [std.foundation.promise :as promise]
            [std.fs.path :as path]))

(def default-options
  {:include-root? false
   :max-depth nil
   :include nil
   :exclude nil})

(defn- append-values
  [left right]
  (reduce conj left right))

(defn- accepted?
  [entry options]
  (let [include (:include options)
        exclude (:exclude options)]
    (and (or (nil? include) (include entry))
         (or (nil? exclude) (not (exclude entry))))))

(defn- excluded?
  [entry options]
  (let [exclude (:exclude options)]
    (and (not (nil? exclude)) (exclude entry))))

(defn walk
  "Returns a promise of entry maps in canonical lexical path order.

   Options are :include-root?, :max-depth, :include, and :exclude. Excluded
   directories are pruned and symbolic links are never followed."
  ([root]
   (walk root {}))
  ([root options]
   (let [root (path/normalise root)
         options (merge default-options options)]
     (letfn [(visit-many [entries depth]
               (loop [index 0
                      result (promise/from [])]
                 (if (= index (count entries))
                   result
                   (let [entry (nth entries index)]
                     (recur
                      (inc index)
                      (promise/then
                       result
                       (fn [output]
                         (promise/then
                          (visit-entry entry depth)
                          (fn [values]
                            (append-values output values))))))))))
             (visit-entry [entry depth]
               (let [include-entry (accepted? entry options)
                     max-depth (:max-depth options)
                     descend (and (= (:type entry) :directory)
                                  (not (excluded? entry options))
                                  (or (nil? max-depth) (< depth max-depth)))]
                 (if descend
                   (promise/then
                    (File/entries (:path entry))
                    (fn [children]
                      (promise/then
                       (visit-many children (inc depth))
                       (fn [descendants]
                         (if include-entry
                           (conj descendants entry)
                           descendants)))))
                   (promise/from (if include-entry [entry] [])))))]
       (promise/then
        (File/stat root)
        (fn [entry]
          (promise/then
           (visit-entry entry 0)
           (fn [values]
             (let [ordered (vec (sort-by :path values))]
               (if (:include-root? options)
                 ordered
                 (vec (filter (fn [value]
                                (not (= (:path value) root)))
                              ordered))))))))))))