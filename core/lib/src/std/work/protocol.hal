(ns std.work.protocol)

;; Compatibility method Vars for the native work protocols. The protocol Vars
;; themselves are runtime-owned Foundation referrals, so `std.work.protocol/IWork`
;; and the other qualified names resolve to the same native identities without
;; redeclaring or shadowing them.
(def work-spec std.protocol.iwork/work-spec)
(def work-id std.protocol.iworkref/work-id)
(def work-submit std.protocol.iworkhost/work-submit)
(def work-resolve std.protocol.iworkhost/work-resolve)
(def work-status std.protocol.iworkrun/work-status)
(def work-result std.protocol.iworkrun/work-result)
(def work-events std.protocol.iworkrun/work-events)
(def work-cancel std.protocol.iworkrun/work-cancel)

;; Temporary compatibility contracts for the current managed runtime. The live
;; host and event-stream migrations replace these without changing IWork.
(defprotocol IWorkRuntime
  (-start [runtime work input options])
  (-query [runtime reference options])
  (-command [runtime reference command options]))

(defprotocol IWorkObserver
  (work-event [observer event]))
