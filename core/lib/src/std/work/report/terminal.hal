(ns std.work.report.terminal
  (:require [std.work :as work]
            [std.work.report.plain :as plain]))

(def ansi-reset "\u001b[0m")

(def ansi-codes
  {:default nil
   :muted "\u001b[2m"
   :index "\u001b[2m"
   :success "\u001b[32m"
   :warning "\u001b[33m"
   :error "\u001b[31m"
   :critical "\u001b[1;31m"
   :highlight "\u001b[1;36m"})

(def default-options
  {:ansi true
   :emit println})

(defn style-line
  ([entry]
   (style-line entry {}))
  ([entry options]
   (let [options (merge default-options options)
         text (:line/text entry)
         role (or (:line/role entry) :default)
         code (get ansi-codes role)]
     (if (and (:ansi options)
              code
              (not (empty? text)))
       (str code text ansi-reset)
       text))))

(defn style-lines
  ([entries]
   (style-lines entries {}))
  ([entries options]
   (vec
    (map
     (fn [entry] (style-line entry options))
     entries))))

(defn render-lines
  ([document]
   (render-lines document {}))
  ([document options]
   (style-lines (plain/render-lines document options) options)))

(defn render
  ([document]
   (render document {}))
  ([document options]
   (str/join "\n" (render-lines document options))))

(defn event-lines
  ([event]
   (event-lines event {}))
  ([event options]
   (style-lines (plain/event-lines event options) options)))

(defn event-texts
  ([event]
   (event-texts event {}))
  ([event options]
   (event-lines event options)))

(defn render-events
  ([events]
   (render-events events {}))
  ([events options]
   (str/join
    "\n"
    (style-lines (plain/render-event-lines events options) options))))

(defn emit-texts!
  [texts options]
  (let [emit (:emit (merge default-options options))]
    (reduce
     (fn [count text]
       (emit text)
       (inc count))
     0
     texts)))

(defn emit-event!
  ([event]
   (emit-event! event {}))
  ([event options]
   (emit-texts! (event-texts event options) options)))

(defn observer
  "Creates a baseline terminal reporter over committed std.work events.

   The output sink is injected through :emit. ANSI styling may be disabled
   without changing the underlying report document or line projection."
  ([]
   (observer {}))
  ([options]
   (let [options (merge default-options options)]
     (work/observer
      (fn [event]
        (emit-event! event options))))))

(def terminal-observer observer)

(defn replay!
  "Renders a stored event history through the same event projection as a live
   observer. Returns the number of emitted lines."
  ([events]
   (replay! events {}))
  ([events options]
   (emit-texts!
    (style-lines (plain/render-event-lines events options) options)
    options)))
