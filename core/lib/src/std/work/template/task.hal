(ns std.work.template.task
  (:refer-clojure :exclude [compile])
  (:require [std.work :as work]
            [std.work.command :as command]
            [std.work.command.result :as result]
            [std.work.command.task :as task-command]
            [std.work.command.selector :as selector]
            [std.work.report :as report]))

(def schema-id "std.work.template.task/0-alpha")
(def request-id "std.work.template.task.request/0-alpha")

(def parity-statuses
  #{:implemented :partial :host-adapted :intentional-change :obsolete :missing})

(def event-types
  [:task/run-started
   :task/input-prepared
   :task/items-listed
   :task/items-selected
   :task/item-started
   :task/item-completed
   :task/item-warning
   :task/item-error
   :task/results-ready
   :task/warnings-ready
   :task/errors-ready
   :task/summary-ready
   :task/run-completed])

(def feature-contract
  [{:feature :definition/id-version :status :implemented}
   {:feature :definition/defaults-by-type :status :implemented}
   {:feature :main/arity-adapter-1-4 :status :implemented}
   {:feature :main/additional-arguments :status :implemented}
   {:feature :construct/input :status :implemented}
   {:feature :construct/environment :status :implemented}
   {:feature :construct/lookup :status :implemented}
   {:feature :item/list :status :implemented}
   {:feature :item/select :status :implemented}
   {:feature :item/pre-run-post :status :implemented}
   {:feature :item/output :status :partial}
   {:feature :item/display :status :implemented}
   {:feature :execution/random :status :missing}
   {:feature :execution/parallel :status :host-adapted}
   {:feature :execution/deterministic-report-order :status :partial}
   {:feature :execution/cancellation :status :host-adapted}
   {:feature :execution/timeout :status :host-adapted}
   {:feature :result/warnings-errors-results :status :implemented}
   {:feature :result/ignore-derived-format-order :status :partial}
   {:feature :result/columns :status :partial}
   {:feature :summary/aggregate :status :implemented}
   {:feature :summary/finalise :status :partial}
   {:feature :summary/elapsed-cumulative :status :partial}
   {:feature :summary/annotations :status :missing}
   {:feature :report/title-sections-labels :status :implemented}
   {:feature :report/live-stage-events :status :partial}
   {:feature :report/plain-terminal-renderers :status :missing}
   {:feature :return/selection :status :implemented}
   {:feature :return/map-vector-packaging :status :partial}])

(def default-execution
  {:order :input
   :parallel false
   :random false
   :fail-fast false})

(def default-return
  {:select :results
   :package :map})

(def default-task-options
  {:main {:argcount 4
          :args-required? false}
   :params {}
   :execution default-execution
   :return default-return})

(def ^:dynamic *task-defaults*
  (atom {:default default-task-options}))

(defn merge-nested
  "Recursively merges task option maps. Non-map values replace earlier values."
  [left right]
  (reduce
   (fn [output entry]
     (let [key (nth entry 0)
           value (nth entry 1)
           current (get output key)]
       (assoc output
              key
              (if (and (map? current) (map? value))
                (merge-nested current value)
                value))))
   (or left {})
   (or right {})))

(defn task-defaults
  "Returns the default task options for type, including :default options."
  [type]
  (let [registry (deref *task-defaults*)
        base (or (get registry :default) {})
        selected (if (= :default type)
                   {}
                   (or (get registry type) {}))]
    (merge-nested base selected)))

(defn install-defaults!
  "Installs or extends defaults for one local task type."
  [type options]
  (swap! *task-defaults*
         (fn [registry]
           (assoc registry
                  type
                  (merge-nested (or (get registry type) {}) options))))
  (task-defaults type))

(defn uninstall-defaults!
  "Removes local defaults for type. The :default profile cannot be removed."
  [type]
  (if (= :default type)
    (throw
     (ex-info "The default task profile cannot be removed"
              {:task/type type}))
    (swap! *task-defaults* dissoc type)))

(defn feature-status
  [feature]
  (:status
   (first
    (filter
     (fn [entry] (= feature (:feature entry)))
     feature-contract))))

(defn incomplete-features
  []
  (vec
   (filter
    (fn [entry]
      (or (= :partial (:status entry))
          (= :missing (:status entry))))
    feature-contract)))

(defn request
  "Creates an explicit task invocation request.

   Recognised keys are :input, :params, :environment (or :env), :lookup,
   :args, :selector, and :mode. A request without :input asks the template to
   call :construct/input. Raw values passed to work/run remain ordinary input."
  ([]
   {:task/request request-id})
  ([options]
   (if (not (map? options))
     (throw
      (ex-info "Task request options must be a map"
               {:options options}))
     (assoc options :task/request request-id))))

(defn invocation
  "Convenience constructor for explicit task input, parameters, and arguments."
  ([input]
   (request {:input input}))
  ([input params]
   (request {:input input :params params}))
  ([input params arguments]
   (request {:input input :params params :args arguments})))

(defn request?
  [value]
  (and (map? value)
       (= request-id (:task/request value))))

(defn normalise-request
  [input]
  (if (request? input)
    {:task/input (:input input)
     :task/input? (has? input :input)
     :task/params (or (:params input) {})
     :task/environment
     (if (has? input :environment)
       (:environment input)
       (:env input))
     :task/environment?
     (or (has? input :environment)
         (has? input :env))
     :task/lookup (:lookup input)
     :task/lookup? (has? input :lookup)
     :task/args (vec (or (:args input) []))
     :task/selector (:selector input)
     :task/mode (or (:mode input) :run)}
    {:task/input input
     :task/input? true
     :task/params {}
     :task/environment nil
     :task/environment? false
     :task/lookup nil
     :task/lookup? false
     :task/args []
     :task/selector (if (map? input) (:selector input) nil)
     :task/mode :run}))

(defn main-function
  "Adapts a Foundation-style main function with an explicit argument count.

   The returned function always accepts input, params, lookup, environment,
   and a vector of additional arguments."
  [function count]
  (case count
    4 (fn [input params lookup environment arguments]
        (apply function input params lookup environment arguments))
    3 (fn [input params lookup environment arguments]
        (apply function input params environment arguments))
    2 (fn [input params lookup environment arguments]
        (apply function input params arguments))
    1 (fn [input params lookup environment arguments]
        (apply function input arguments))
    (throw
     (ex-info "Task main argcount must be between 1 and 4"
              {:argcount count}))))

(defn assert-definition!
  [definition]
  (if (not (map? definition))
    (throw
     (ex-info "Task template definition must be a map"
              {:definition definition})))
  (if (nil? (or (:task/id definition) (:id definition)))
    (throw (ex-info "Task template requires an id" {})))
  (if (nil? (or (get-in definition [:item :run])
                (get-in definition [:main :fn])
                (:run definition)))
    (throw (ex-info "Task template requires an item run function" {})))
  definition)

(defn normalise-definition
  [raw-definition]
  (let [type (or (:task/type raw-definition)
                 (:type raw-definition)
                 :default)
        defaults (merge-nested
                  (task-defaults type)
                  (or (:defaults raw-definition) {}))
        definition (assert-definition!
                    (merge-nested defaults raw-definition))
        schema (or (:schema definition) schema-id)
        id (or (:task/id definition) (:id definition))
        version (or (:task/version definition) (:version definition) 1)
        item (or (:item definition) {})
        main (or (:main definition) {})
        item-run (or (:run item) (:run definition))
        main-run (:fn main)
        run-mode (if item-run :work :task)
        run (or item-run main-run)
        argcount (or (:argcount main) 4)
        list-mode
        (or (:list-mode item)
            (if (= :task run-mode)
              :lookup-environment
              :input-context))]
    (if (not= schema schema-id)
      (throw
       (ex-info "Task template schema is not supported"
                {:schema schema})))
    (if (or (< argcount 1) (> argcount 4))
      (throw
       (ex-info "Task main argcount must be between 1 and 4"
                {:argcount argcount})))
    {:schema schema-id
     :task/id id
     :task/type type
     :task/version version
     :construct (or (:construct definition) {})
     :params (or (:params definition) {})
     :main (assoc main
                  :fn run
                  :argcount argcount
                  :invoke (if (= :task run-mode)
                            (main-function run argcount)
                            nil))
     :item (assoc item
                  :run run
                  :run-mode run-mode
                  :list-mode list-mode)
     :execution (merge-nested default-execution
                              (or (:execution definition) {}))
     :result (or (:result definition) {})
     :summary (or (:summary definition) {})
     :report (report/normalise-profile (:report definition))
     :return (merge-nested default-return
                           (or (:return definition) {}))
     :metadata (or (:metadata definition) {})}))

(defn task-item-id
  [value index]
  (if (and (map? value) (has? value :item/id))
    (:item/id value)
    (if (or (string? value) (number? value) (keyword? value) (symbol? value))
      value
      index)))

(defn task-item-value
  [value]
  (if (and (map? value) (has? value :item/value))
    (:item/value value)
    value))

(defn selected-values
  [values selector-value]
  (loop [source-index 0
         output []]
    (if (= source-index (count values))
      output
      (let [value (nth values source-index)
            id (task-item-id value source-index)]
        (recur
         (inc source-index)
         (if (selector/matches? selector-value id)
           (conj output
                 {:task/source-index source-index
                  :task/item-id id
                  :task/value (task-item-value value)})
           output))))))

(defn manifest
  [values selector-value prepared]
  (let [values (vec (or values []))
        selected (selected-values values selector-value)
        total (count selected)]
    (loop [index 0
           output []]
      (if (= index total)
        output
        (let [selected-value (nth selected index)
              id (:task/item-id selected-value)]
          (recur
           (inc index)
           (conj output
                 {:item/id id
                  :item/value
                  (merge prepared
                         selected-value
                         {:task/index index
                          :task/total total})})))))))

(defn construct-input
  [definition invocation]
  (if (:task/input? invocation)
    (:task/input invocation)
    (let [construct (get-in definition [:construct :input])]
      (if construct
        (construct definition)
        nil))))

(defn construct-environment
  [definition invocation params]
  (if (:task/environment? invocation)
    (:task/environment invocation)
    (let [construct
          (or (get-in definition [:construct :environment])
              (get-in definition [:construct :env]))]
      (if construct
        (construct (merge-nested definition params))
        {}))))

(defn construct-lookup
  [definition invocation params environment]
  (if (:task/lookup? invocation)
    (:task/lookup invocation)
    (let [construct (get-in definition [:construct :lookup])]
      (if construct
        (construct definition (merge-nested environment params))
        {}))))

(defn prepare-input
  [definition input context]
  (let [invocation (normalise-request input)
        params (merge-nested (:params definition)
                             (:task/params invocation))
        prepared-input (construct-input definition invocation)
        environment (construct-environment definition invocation params)
        lookup (construct-lookup definition invocation params environment)
        arguments (:task/args invocation)
        required?
        (or (get-in definition [:main :args-required?])
            (get-in definition [:main :args?]))
        selector-value
        (or (:task/selector invocation)
            (get-in definition [:item :selector])
            :all)]
    (if (and required? (empty? arguments))
      (throw
       (ex-info "Task invocation requires additional arguments"
                {:task/id (:task/id definition)
                 :task/type (:task/type definition)})))
    (work/emit! context :task/run-started
                {:task/id (:task/id definition)
                 :task/type (:task/type definition)
                 :task/version (:task/version definition)})
    (work/emit! context :task/input-prepared
                {:task/id (:task/id definition)
                 :selector selector-value
                 :argument-count (count arguments)})
    {:task/input prepared-input
     :task/params params
     :task/environment environment
     :task/lookup lookup
     :task/args arguments
     :task/selector selector-value
     :task/mode (:task/mode invocation)}))

(defn list-values
  [definition prepared context]
  (let [item (:item definition)
        list-function (:list item)
        list-mode (:list-mode item)]
    (if list-function
      (case list-mode
        :lookup-environment
        (list-function
         (:task/lookup prepared)
         (:task/environment prepared))

        :input-context
        (list-function (:task/input prepared) context)

        (throw
         (ex-info "Task item list mode is not supported"
                  {:task/id (:task/id definition)
                   :list-mode list-mode})))
      [(:task/input prepared)])))

(defn list-items
  [definition prepared context]
  (let [listed (vec (or (list-values definition prepared context) []))
        items (manifest listed (:task/selector prepared) prepared)]
    (work/emit! context :task/items-listed
                {:task/id (:task/id definition)
                 :count (count listed)})
    (work/emit! context :task/items-selected
                {:task/id (:task/id definition)
                 :count (count items)})
    items))

(def status-event task-command/status-event)

(defn invoke-item
  [definition subject prepared context]
  (let [item (:item definition)]
    (if (= :task (:run-mode item))
      ((get-in definition [:main :invoke])
       prepared
       (:task/params subject)
       (:task/lookup subject)
       (:task/environment subject)
       (:task/args subject))
      ((:run item) prepared context))))

(defn display-value
  [definition record]
  (task-command/display-value
   {:display (get-in definition [:item :display])}
   record))

(defn unit-options
  [definition]
  (let [item (:item definition)]
    {:id :task/process
     :version (:task/version definition)
     :input
     (fn [subject context]
       (:task/value subject))
     :item/meta
     (fn [subject context]
       {:item/id (:task/item-id subject)
        :item/index (:task/index subject)
        :item/source-index (:task/source-index subject)
        :item/total (:task/total subject)})
     :pre (:pre item)
     :run
     (fn [prepared context]
       (invoke-item definition
                    (:command/subject context)
                    prepared
                    context))
     :post (:post item)
     :display (:display item)
     :on-error :record}))

(defn unit-work
  "Compiles the reusable one-item command for a normalised task definition."
  [definition]
  (task-command/unit (unit-options definition)))

(defn run-item
  "Compatibility entry point for the atomic task lifecycle.

   New composition should use unit-work so direct and bulk execution share the
   exact same ordinary IWork value."
  [definition subject context]
  (task-command/run-item
   (task-command/normalise-options (unit-options definition))
   subject
   context))

(defn result-options
  [definition]
  {:ignore (get-in definition [:result :ignore])
   :output (or (get-in definition [:result :output])
               (get-in definition [:item :output]))
   :aggregate (get-in definition [:summary :aggregate])
   :finalise (get-in definition [:summary :finalise])})

(defn report-status
  [bundle]
  (cond
    (< 0 (count (:errors bundle))) :failed
    (< 0 (count (:warnings bundle))) :warning
    :else :completed))

(defn report-section
  [definition bundle id]
  (let [labels (get-in definition [:report :labels])
        title (get labels id)]
    (case id
      :items
      (report/section id :progress (:records bundle) {:section/title title})
      :warnings
      (report/section id :diagnostics (:warnings bundle) {:section/title title})
      :errors
      (report/section id :diagnostics (:errors bundle) {:section/title title})
      :results
      (report/section id :table (:results bundle)
                      {:section/title title
                       :section/columns (get-in definition [:result :columns])})
      :summary
      (report/section id :summary [(:summary bundle)] {:section/title title})
      (report/section id :text [] {:section/title title}))))

(defn task-report
  [definition bundle]
  (let [profile (:report definition)
        initial
        (report/document
         (:task/id definition)
         {:profile profile
          :title (:title profile)
          :status (report-status bundle)})]
    (loop [sections (:sections profile)
           document initial]
      (if (empty? sections)
        (report/complete document (report-status bundle))
        (recur (vec (rest sections))
               (report/add-section
                document
                (report-section definition bundle (first sections))))))))

(defn summarise
  [definition batch context]
  (let [bundle (result/summarise batch (result-options definition))
        bundle (assoc bundle :report (task-report definition bundle))]
    (work/emit! context :task/warnings-ready
                {:count (count (:warnings bundle))})
    (work/emit! context :task/errors-ready
                {:count (count (:errors bundle))})
    (work/emit! context :task/results-ready
                {:count (count (:results bundle))})
    (work/emit! context :task/summary-ready
                {:summary (:summary bundle)})
    bundle))

(defn package-value
  [value package]
  (if (= :vector package)
    (cond
      (vector? value) value
      (map? value) (vec (vals value))
      :else [value])
    value))

(defn finish
  [definition batch context]
  (let [bundle (or (:summary batch) batch)
        selection (get-in definition [:return :select])
        package (get-in definition [:return :package])
        output (result/package bundle selection)]
    (work/emit! context :task/run-completed
                {:task/id (:task/id definition)
                 :status (report-status bundle)
                 :summary (:summary bundle)})
    (package-value output package)))

(defn compile
  "Compiles a local task definition into an ordinary std.work graph.

   The template owns task construction and presentation data; scheduling,
   cancellation, timeout, durability, and parallelism remain runtime policies."
  [definition]
  (let [definition (normalise-definition definition)
        id (:task/id definition)
        version (:task/version definition)]
    (command/batch
     {:id id
      :version version
      :template/schema schema-id
      :template/definition definition}
     {:prepare
      (work/pure
       {:id :task/prepare :version version}
       (fn [input context]
         (prepare-input definition input context)))
      :list
      (work/pure
       {:id :task/list :version version}
       (fn [prepared context]
         (list-items definition prepared context)))
      :process
      (unit-work definition)
      :summarise
      (work/pure
       {:id :task/summarise :version version}
       (fn [batch context]
         (summarise definition batch context)))
      :finish
      (work/pure
       {:id :task/finish :version version}
       (fn [batch context]
         (finish definition batch context)))})))

(def template compile)

(defn task-work?
  [work-value]
  (= schema-id (:template/schema (work/work-spec work-value))))
