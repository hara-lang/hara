(ns std.work.command.report
  (:require [std.foundation.string :as string]
            [std.work :as work]))

(defn format-item
  [record]
  (str (:item/id record) "  " (name (or (:status record) :return))
       (if (has? record :data) (str "  " (pr-str (:data record))) "")
       (if (:error record) (str "  " (:error record)) "")))

(defn format-summary
  [summary]
  (string/join
   "\n"
   [(str "Items: " (:items summary))
    (str "Results: " (:results summary))
    (str "Warnings: " (:warnings summary))
    (str "Errors: " (:errors summary))]))

(defn event-text
  [event]
  (cond (= :command/item-completed (:event event))
        (format-item (:record event))
        (= :command/completed (:event event))
        (format-summary (get-in event [:result :summary]))
        :else nil))

(defn terminal-observer
  "Creates an explicit work observer that renders command domain events."
  ([] (terminal-observer {}))
  ([options]
   (work/observer
    (fn [event]
      (let [text (event-text event)]
        (if text (println text) nil))))))
