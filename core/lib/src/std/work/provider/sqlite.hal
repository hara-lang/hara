(ns std.work.provider.sqlite
  (:require [std.db.sqlite :as sqlite]
            [std.work.runtime.store :as store]))

;; SQLite operational store provider.
;;
;; SQLite is the reference durable implementation for local, browser/WASM and
;; edge execution. It shares the operational-store contract with memory and
;; future PostgreSQL providers. Receipt publication remains separate.

(def provider-id :sqlite)

(def schema-version 1)

(defn connection
  [value]
  value)

(defn capabilities
  []
  #{:runs
    :transactions
    :events
    :checkpoints
    :outbox})

(defn describe
  []
  {:provider/role :work/store
   :provider/id provider-id
   :provider/schema-version schema-version
   :provider/capabilities (capabilities)})

(defn open
  ([]
   (open {}))
  ([options]
   (sqlite/open options)))

(defn normalise-provider
  [operations]
  (store/normalise-provider
   {:provider/role :work/store
    :provider/id provider-id
    :provider/schema-version schema-version
    :provider/capabilities (capabilities)
    :provider/operations operations}))

;; SQL transition, checkpoint, event and outbox operations are implemented in
;; the next slice. This boundary deliberately matches the memory provider
;; conformance contract before adding storage-specific behaviour.
