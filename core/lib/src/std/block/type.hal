(ns std.block.type
  (:require [std.block.protocol :as protocol]))

(defstruct Block [type tag string value children props])

(extend-type Block protocol/IBlock
  (block-type [block] (:type block))
  (block-tag [block] (:tag block))
  (block-string [block] (:string block))
  (block-value [block] (:value block))
  (block-children [block] (:children block))
  (block-verify [block] true)
  (block-info [block] (:props block)))

(defn block?
  [value]
  (instance? std.block.type/Block value))

(defn void-block?
  [block]
  (= :void (protocol/block-type block)))

(defn token-block?
  [block]
  (= :token (protocol/block-type block)))

(defn container-block?
  [block]
  (= :container (protocol/block-type block)))

(defn modifier-block?
  [block]
  (= :modifier (protocol/block-type block)))

(defn error-block?
  [block]
  (= :error (protocol/block-type block)))

(defn code-block?
  [block]
  (or (token-block? block)
      (container-block? block)))

(defn space-block?
  [block]
  (= :space (protocol/block-tag block)))

(defn linebreak-block?
  [block]
  (= :linebreak (protocol/block-tag block)))

(defn linespace-block?
  [block]
  (= :linespace (protocol/block-tag block)))

(defn eof-block?
  [block]
  (= :eof (protocol/block-tag block)))

(defn comment-block?
  [block]
  (= :comment (protocol/block-tag block)))
