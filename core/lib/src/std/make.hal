;; ============================================================================
;; std.make — temporary compatibility facade over work.flow.make.
;; ============================================================================
(ns std.make
  (:require [work.flow.make :as make]))

(def run make/run)
(def build make/build)
(def clean make/clean)
(def start! make/start!)
(def stop! make/stop!)
(def plan make/plan)
(def targets make/targets)
(def target-work make/target-work)
(def revision make/revision)
(def status make/status)
(def host? make/host?)

(defmacro def.make
  [definition-name definition & declaration-body]
  `(work.flow.make/def.make
    ~definition-name
    ~definition
    ~@declaration-body))
