;; ============================================================================
;; std.codec.base64 — canonical padded RFC 4648 Base64.
;; ============================================================================
(ns std.codec.base64)

(def +alphabet+ "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

(defn- input-bytes
  [value]
  (cond (string? value) (str/encode-utf8 value)
        (Bytes/instance? value) value
        :else (throw (ex-info "Base64 encode expects a string or bytes" {:value value}))))

(defn encode
  [value]
  (let [value (input-bytes value)
        length (bytes/count value)]
    (loop [index 0 output ""]
      (if (>= index length)
        output
        (let [remaining (- length index)
              a (bytes/get value index)
              b (if (> remaining 1) (bytes/get value (inc index)) 0)
              c (if (> remaining 2) (bytes/get value (+ index 2)) 0)
              packed (+ (Bits/shift-left a 16)
                        (Bits/shift-left b 8)
                        c)
              first (Bits/and (Bits/shift-right packed 18) 63)
              second (Bits/and (Bits/shift-right packed 12) 63)
              third (Bits/and (Bits/shift-right packed 6) 63)
              fourth (Bits/and packed 63)]
          (recur (+ index 3)
                 (str output
                      (str/char-at +alphabet+ first)
                      (str/char-at +alphabet+ second)
                      (if (> remaining 1) (str/char-at +alphabet+ third) "=")
                      (if (> remaining 2) (str/char-at +alphabet+ fourth) "="))))))))

(defn- value-of
  [character index]
  (let [value (str/index-of +alphabet+ character)]
    (if (neg? value)
      (throw (ex-info "Invalid Base64 character"
                      {:character character :index index}))
      value)))

(defn decode
  [source]
  (if (not (string? source))
    (throw (ex-info "Base64 decode expects a string" {:value source})))
  (let [length (str/length source)]
    (if (not= 0 (mod length 4))
      (throw (ex-info "Base64 length must be a multiple of four"
                      {:value source :length length})))
    (loop [index 0 output []]
      (if (= index length)
        (apply bytes output)
        (let [last? (= (+ index 4) length)
              ca (str/char-at source index)
              cb (str/char-at source (inc index))
              cc (str/char-at source (+ index 2))
              cd (str/char-at source (+ index 3))]
          (if (or (= ca "=") (= cb "=")
                  (and (not last?) (or (= cc "=") (= cd "="))))
            (throw (ex-info "Base64 padding is only valid in the final quartet"
                            {:value source :index index})))
          (let [a (value-of ca index)
                b (value-of cb (inc index))
                c-padding (= cc "=")
                d-padding (= cd "=")]
            (if (and c-padding (not d-padding))
              (throw (ex-info "Invalid Base64 padding" {:value source :index index})))
            (let [c (if c-padding 0 (value-of cc (+ index 2)))
                  d (if d-padding 0 (value-of cd (+ index 3)))]
              (if (and c-padding (not= 0 (Bits/and b 15)))
                (throw (ex-info "Non-canonical Base64 trailing bits" {:value source})))
              (if (and d-padding (not c-padding) (not= 0 (Bits/and c 3)))
                (throw (ex-info "Non-canonical Base64 trailing bits" {:value source})))
              (let [packed (+ (Bits/shift-left a 18)
                              (Bits/shift-left b 12)
                              (Bits/shift-left c 6)
                              d)
                    output (conj output (Bits/and (Bits/shift-right packed 16) 255))
                    output (if c-padding
                             output
                             (conj output (Bits/and (Bits/shift-right packed 8) 255)))
                    output (if d-padding
                             output
                             (conj output (Bits/and packed 255)))]
                (recur (+ index 4) output)))))))))
