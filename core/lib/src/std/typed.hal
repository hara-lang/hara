;; Curated public facade for portable schema construction and checking.
(ns std.typed
  (:require [std.typed.catalog :as catalog]
            [std.typed.catalog.document :as document]
            [std.typed.explain :as explain]
            [std.typed.infer :as inference]
            [std.typed.registry :as reg]
            [std.typed.schema :as schema]))

(def schema schema/normalize)
(def normalize schema/normalize)
(def normalize-with schema/normalize-with)
(def reference-names schema/reference-names)
(def resolve-reference schema/resolve-reference)
(def resolve-recursive schema/resolve-recursive)
(def unresolved-references schema/unresolved-references)
(def validate schema/validate)
(def valid? schema/valid?)
(def compatible? schema/compatible?)
(def project-arities schema/project-arities)

(def registry reg/registry)
(def local-registry reg/local)
(def composite-registry reg/composite)
(def registry? reg/registry?)
(def registry-lookup reg/lookup)
(def registry-names reg/names)

(def catalog catalog/catalog)
(def catalog? catalog/catalog?)
(def catalog-lookup catalog/lookup)
(def catalog-coordinate catalog/coordinate)
(def catalog-resolve catalog/resolve)
(def catalog-dependencies catalog/dependencies)
(def catalog-dependency-closure catalog/dependency-closure)
(def catalog-dependency-components catalog/dependency-components)
(def catalog-dependency-order catalog/dependency-order)
(def catalog-registry catalog/schema-registry)
(def catalog-document-verify document/verify)
(def catalog-document-verify-json document/verify-json)

(def explain explain/explain)
(def validator explain/validator)
(def explainer explain/explainer)
(def check explain/check)
(def failure? explain/failure?)
(def failure-seq explain/failure-seq)
(def failure-count explain/failure-count)

(def infer inference/infer)
(def infer-result inference/infer-result)
