(ns std.stream.duplex
  (:config {:override [instance? send receive]}))

(defn create
  ([receive send] (Duplex/create receive send))
  ([receive send close] (Duplex/create receive send close)))

(defn instance? [value]
  (Duplex/instance? value))

(defn receive [duplex]
  (Duplex/receive duplex))

(defn send [duplex value]
  (Duplex/send duplex value))

(defn close [duplex]
  (Duplex/close duplex))

