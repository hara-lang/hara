(ns std.lib.collection
  (:config {:builtins [deque ordered-map ordered-set priority-map queue
                       sorted-map sorted-set trie]}))

(defn deque [& values] (apply Algo/deque values))
(defn ordered-map [& entries] (apply Algo/ordered-map entries))
(defn ordered-set [& values] (apply Algo/ordered-set values))
(defn priority-map [& entries] (apply Algo/priority-map entries))
(defn queue [& values] (apply Algo/queue values))
(defn sorted-map [& entries] (apply Algo/sorted-map entries))
(defn sorted-set [& values] (apply Algo/sorted-set values))
(defn trie [& entries] (apply Algo/trie entries))

(defn peek-first
  "Returns the first value through IPeekFirst."
  [collection]
  (IPeekFirst/peek-first collection))

(defn peek-last
  "Returns the last value through IPeekLast."
  [collection]
  (IPeekLast/peek-last collection))

(defn pop-first
  "Returns collection without its first value through IPopFirst."
  [collection]
  (IPopFirst/pop-first collection))

(defn pop-last
  "Returns collection without its last value through IPopLast."
  [collection]
  (IPopLast/pop-last collection))

(defn push-first
  "Returns collection with value added at the front through IPushFirst."
  [collection value]
  (IPushFirst/push-first collection value))

(defn push-last
  "Returns collection with value added at the back through IPushLast."
  [collection value]
  (IPushLast/push-last collection value))

(defn deque?
  "Returns true when value is a persistent deque."
  [value]
  (Algo/deque? value))

(defn priority-map?
  "Returns true when value is a stable persistent priority map."
  [value]
  (Algo/priority-map? value))

(defn ordered-map?
  "Returns true when value is an insertion-ordered persistent map."
  [value]
  (Algo/ordered-map? value))

(defn ordered-set?
  "Returns true when value is an insertion-ordered persistent set."
  [value]
  (Algo/ordered-set? value))

(defn queue?
  "Returns true when value is a persistent queue."
  [value]
  (Algo/queue? value))

(defn sorted-map?
  "Returns true when value is a key-sorted persistent map."
  [value]
  (Algo/sorted-map? value))

(defn sorted-set?
  "Returns true when value is a value-sorted persistent set."
  [value]
  (Algo/sorted-set? value))

(defn trie?
  "Returns true when value is a persistent string-keyed trie."
  [value]
  (Algo/trie? value))

(defn- transform-map-keys
  [function value]
  (if (map? value)
    (reduce (fn [output entry]
              (assoc output (function (key entry)) (val entry)))
            (empty value)
            value)
    value))

(defn keywordize-keys
  "Recursively transforms string and symbol map keys into keywords."
  [value]
  (postwalk (fn [current]
              (transform-map-keys
                (fn [key]
                  (if (or (string? key) (symbol? key)) (keyword key) key))
                current))
            value))

(defn keyword-spearify-keys
  "Recursively transforms string map keys into spear-case keywords."
  [value]
  (postwalk (fn [current]
              (transform-map-keys
                (fn [key]
                  (if (string? key)
                    (keyword (str/replace key "_" "-"))
                    key))
                current))
            value))

(defn stringify-keys
  "Recursively transforms keyword map keys into strings."
  [value]
  (postwalk (fn [current]
              (transform-map-keys
                (fn [key] (if (keyword? key) (name key) key))
                current))
            value))

(defn string-snakify-keys
  "Recursively transforms keyword map keys into snake-case strings."
  [value]
  (postwalk (fn [current]
              (transform-map-keys
                (fn [key]
                  (if (keyword? key)
                    (str/replace (name key) "-" "_")
                    key))
                current))
            value))

(defn walk:contains
  "Returns true when predicate matches any value in a nested form."
  [predicate form]
  (let [found (atom false)]
    (prewalk (fn [value]
               (try
                 (if (predicate value) (reset! found true))
                 (catch Throwable error nil))
               value)
             form)
    (deref found)))

(defn walk:find
  "Returns the set of nested values matched by predicate."
  [predicate form]
  (let [found (atom #{})]
    (postwalk (fn [value]
                (try
                  (if (predicate value) (swap! found conj value))
                  (catch Throwable error nil))
                value)
              form)
    (deref found)))

(defn walk:keep
  "Returns the set of truthy values produced while walking form."
  [function form]
  (let [found (atom #{})]
    (postwalk (fn [value]
                (try
                  (let [result (function value)]
                    (if result (swap! found conj result)))
                  (catch Throwable error nil))
                value)
              form)
    (deref found)))
