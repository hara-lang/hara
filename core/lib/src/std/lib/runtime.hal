(ns std.lib.runtime
  (:config {:override [load-string macroexpand-1 gensym var-sym
                       resolve intern-var eval]}))

;; Portable access to the active evaluator Runtime. Host implementations keep
;; their namespace registry and evaluation primitives behind this facade.

(defn ^{:inline true :schema [:fn [:str] :any]}
  load-string
  "Reads and evaluates every form in source."
  [source]
  (std.native.Runtime/load-string source))

(defn ^{:inline true :schema [:fn [:any] :any]}
  macroexpand-1
  "Expands the outermost macro invocation once."
  [form]
  (std.native.Runtime/macroexpand-1 form))

(defn ^{:inline true
        :schema [:function [:fn [] :symbol]
                           [:fn [:any] :symbol]]}
  gensym
  "Returns a fresh symbol with an optional prefix."
  ([] (std.native.Runtime/gensym))
  ([prefix] (std.native.Runtime/gensym prefix)))

(defn ^{:inline true :schema [:fn [:any] :symbol]}
  var-sym
  "Returns the qualified symbol owned by variable."
  [variable]
  (std.native.Runtime/var-sym variable))

(defn ^{:inline true :schema [:fn [] :symbol]}
  current
  "Returns the active namespace symbol."
  []
  (std.native.Env/current))

(defn ^{:inline true :schema [:fn [] :map]}
  snapshot
  "Returns a stable descriptor of the active Runtime."
  []
  (std.native.Env/snapshot))

(defn ^{:inline true
        :schema [:function [:fn [] :map]
                           [:fn [:any] :map]]}
  vars
  "Returns Vars owned by the active or supplied namespace."
  ([] (std.native.Env/vars))
  ([namespace] (std.native.Env/vars namespace)))

(defn ^{:inline true :schema [:fn [] :vector]}
  namespaces
  "Returns descriptors for every namespace known to the Runtime."
  []
  (std.native.Env/namespaces))

(defn ^{:inline true :schema [:fn [:any] :any]}
  namespace
  "Returns a namespace descriptor, or nil when it is unknown."
  [name]
  (std.native.Env/namespace name))

(defn ^{:inline true :schema [:fn [:str] :any]}
  module
  "Returns the loaded module descriptor for path, or nil."
  [path]
  (std.native.Env/module path))

(defn ^{:inline true :schema [:fn [:symbol] :any]}
  resolve
  "Resolves symbol without loading a namespace or package."
  [symbol]
  (std.native.Env/resolve symbol))

(defn ^{:inline true
        :schema [:function [:fn [:symbol] :any]
                           [:fn [:any :symbol] :any]]}
  alias-state
  "Returns load state for an alias in the active or supplied namespace."
  ([alias] (std.native.Env/alias-state alias))
  ([namespace alias] (std.native.Env/alias-state namespace alias)))

(defn ^{:inline true
        :schema [:function [:fn [:any :symbol :any] :any]
                           [:fn [:any :symbol :any :map] :any]]}
  intern-var
  "Interns a Var root and optional metadata into namespace."
  ([namespace symbol variable]
   (std.native.Env/intern-var namespace symbol variable))
  ([namespace symbol variable metadata]
   (std.native.Env/intern-var namespace symbol variable metadata)))

(defn ^{:inline true :schema [:fn [:any :any] :any]}
  eval-in
  "Evaluates form values in an existing namespace."
  [namespace forms]
  (std.native.Env/eval-in namespace forms))

(defn ^{:inline true :schema [:fn [:any] :any]}
  eval
  "Evaluates one form value in the active namespace."
  [form]
  (std.native.Env/eval form))
