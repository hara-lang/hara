(ns std.lib.relay
  (:config {:override [send receive]})
  (:require [std.codec.frame :as frame]
            [std.lib.stream :as stream]))

(defstruct Mailbox [state limit])
(defstruct Relay [duplex codec options state jobs events reader writer])

(defn- mailbox [limit]
  (Mailbox (atom {:items [] :waiters [] :closed false :error nil}) limit))

(defn- mailbox-offer [mailbox value]
  (loop []
    (let [current (deref (:state mailbox))]
      (if (:closed current)
        (throw (ex-info "Mailbox is closed" {:error/type :relay/closed})))
      (let [waiters (:waiters current)]
        (if (> (count waiters) 0)
          (let [waiter (first waiters)
                next-state (assoc current :waiters (vec (rest waiters)))]
            (if (cas! (:state mailbox) current next-state)
              (do ((:resolve waiter) {:value value}) true)
              (recur)))
          (let [items (:items current)]
            (if (>= (count items) (:limit mailbox))
              (throw (ex-info "Mailbox exceeded its bounded capacity"
                              {:error/type :relay/overflow
                               :limit (:limit mailbox)})))
            (if (cas! (:state mailbox)
                      current
                      (assoc current :items (conj items {:value value})))
              true
              (recur))))))))

(defn- mailbox-take-register [mailbox resolve reject]
  (let [current (deref (:state mailbox))
        items (:items current)]
    (cond
      (> (count items) 0)
      (if (cas! (:state mailbox)
                current
                (assoc current :items (vec (rest items))))
        (resolve (first items))
        (mailbox-take-register mailbox resolve reject))

      (:closed current)
      (if (:error current)
        (reject (:error current))
        (resolve nil))

      :else
      (if (cas! (:state mailbox)
                current
                (assoc current :waiters
                       (conj (:waiters current)
                             {:resolve resolve :reject reject})))
        nil
        (mailbox-take-register mailbox resolve reject)))))

(defn- mailbox-take [mailbox]
  (promise/new
   (fn [resolve reject]
     (mailbox-take-register mailbox resolve reject))))

(defn- settle-waiters [waiters error]
  (if (> (count waiters) 0)
    (do
      (if error
        ((:reject (first waiters)) error)
        ((:resolve (first waiters)) nil))
      (settle-waiters (vec (rest waiters)) error))
    nil))

(defn- mailbox-close [mailbox error]
  (loop []
    (let [current (deref (:state mailbox))]
      (if (:closed current)
        false
        (let [next-state (assoc (assoc (assoc current :closed true)
                                       :items [])
                                :waiters [])]
          (if (cas! (:state mailbox)
                    current
                    (assoc next-state :error error))
            (do
              (settle-waiters (:waiters current) error)
              true)
            (recur)))))))

(defn- mailbox-drain [mailbox]
  (loop []
    (let [current (deref (:state mailbox))
          items (:items current)]
      (if (cas! (:state mailbox) current (assoc current :items []))
        (mapv :value items)
        (recur)))))

(defn create
  ([duplex codec] (create duplex codec {}))
  ([duplex codec options]
   (if (not (Duplex/instance? duplex))
     (throw (ex-info "Relay requires a Duplex" {:value duplex})))
   (if (not (satisfies? frame/IFrameCodec codec))
     (throw (ex-info "Relay requires an IFrameCodec" {:value codec})))
   (let [mode (or (:mode options) :serial)]
     (if (not (or (= mode :serial) (= mode :correlated)))
       (throw (ex-info "Relay mode must be :serial or :correlated" {:mode mode})))
     (if (and (= mode :correlated)
              (or (not (fn? (:prepare-request options)))
                  (not (fn? (:response-id options)))))
       (throw (ex-info "Correlated Relay requires :prepare-request and :response-id"
                       {:mode mode})))
     (Relay duplex
            codec
            (assoc (assoc options :mode mode)
                   :mailbox-limit (or (:mailbox-limit options) 256))
            (atom {:status :created
                   :next-id 0
                   :pending {}
                   :serial-active nil
                   :events-taken false
                   :error nil})
            (mailbox (or (:mailbox-limit options) 256))
            (mailbox (or (:mailbox-limit options) 256))
            (atom nil)
            (atom nil)))))

(defn state [relay]
  (deref (:state relay)))

(defn started? [relay]
  (= :started (:status (state relay))))

(defn closed? [relay]
  (or (= :closed (:status (state relay)))
      (= :failed (:status (state relay)))))

(defn- remove-pending [relay correlation-id]
  (loop []
    (let [current (state relay)
          pending (:pending current)
          entry (get pending correlation-id)]
      (if (nil? entry)
        nil
        (if (cas! (:state relay)
                  current
                  (assoc current :pending (dissoc pending correlation-id)))
          entry
          (recur))))))

(defn- remove-serial [relay]
  (loop []
    (let [current (state relay)
          entry (:serial-active current)]
      (if (nil? entry)
        nil
        (if (cas! (:state relay) current (assoc current :serial-active nil))
          entry
          (recur))))))

(defn- register-pending [relay correlation-id entry]
  (swap! (:state relay)
         (fn [current]
           (assoc current :pending
                  (assoc (:pending current) correlation-id entry))))
  entry)

(defn- register-serial [relay entry]
  (loop []
    (let [current (state relay)]
      (if (:serial-active current)
        (throw (ex-info "Relay already has an active serial exchange"
                        {:error/type :relay/serial-busy})))
      (if (cas! (:state relay) current (assoc current :serial-active entry))
        entry
        (recur)))))

(defn- reject-entry [entry error]
  (if entry ((:reject entry) error) nil))

(defn- reject-entries [entries error]
  (if (> (count entries) 0)
    (do
      (reject-entry (first entries) error)
      (reject-entries (vec (rest entries)) error))
    nil))

(defn- fail [relay error]
  (loop []
    (let [current (state relay)]
      (if (or (= :closed (:status current)) (= :failed (:status current)))
        relay
        (let [next-state (assoc (assoc (assoc current :status :failed)
                                       :pending {})
                                :serial-active nil)]
          (if (cas! (:state relay) current (assoc next-state :error error))
            (do
              (reject-entries (vec (vals (:pending current))) error)
              (reject-entry (:serial-active current) error)
              (mailbox-close (:jobs relay) error)
              (mailbox-close (:events relay) error)
              (try (Duplex/close (:duplex relay))
                   (catch Throwable ignored nil))
              relay)
            (recur)))))))

(defn- next-id [relay]
  (:next-id (swap! (:state relay) update :next-id inc)))

(defn- timeout-error [milliseconds]
  (ex-info "Relay exchange timed out"
           {:error/type :relay/timeout :timeout-ms milliseconds}))

(defn- arm-timeout [relay mode correlation-id milliseconds]
  (if milliseconds
    (promise/delay
     milliseconds
     (fn []
       (let [entry (if (= mode :correlated)
                     (remove-pending relay correlation-id)
                     (remove-serial relay))]
         (if entry (reject-entry entry (timeout-error milliseconds)) nil))))
    nil))

(defn- dispatch-frame [relay value]
  (let [mode (:mode (:options relay))]
    (if (= mode :correlated)
      (let [correlation-id ((:response-id (:options relay)) value)
            entry (if (nil? correlation-id)
                    nil
                    (remove-pending relay correlation-id))]
        (if entry
          ((:resolve entry) value)
          (mailbox-offer (:events relay) value)))
      (let [entry (remove-serial relay)]
        (if entry
          ((:resolve entry) value)
          (mailbox-offer (:events relay) value))))))

(defn- dispatch-frames [relay values]
  (loop [index 0]
    (if (< index (count values))
      (do (dispatch-frame relay (nth values index))
          (recur (inc index)))
      nil)))

(defn- reader-loop [relay]
  (promise/run
   (fn []
     (try
       (loop [codec-state (frame/initial-state (:codec relay))]
         (let [chunk (deref (Stream/next (Duplex/receive (:duplex relay))))]
           (if (nil? chunk)
             (let [final (frame/finish-frame (:codec relay) codec-state)]
               (dispatch-frames relay (:frames final))
               (fail relay (ex-info "Relay receive stream reached EOF"
                                    {:error/type :relay/eof})))
             (let [decoded (frame/feed-frame (:codec relay) codec-state chunk)]
               (dispatch-frames relay (:frames decoded))
               (recur (:state decoded))))))
       (catch Throwable error
         (fail relay error))))))

(defn- send-bytes [relay bytes]
  (deref (Duplex/send (:duplex relay) bytes)))

(defn- process-send [relay job]
  (try
    (let [count (send-bytes relay
                            (if (= :raw (:kind job))
                              (:value job)
                              (frame/encode-frame (:codec relay) (:value job))))]
      ((:resolve job) count))
    (catch Throwable error
      ((:reject job) error))))

(defn- process-exchange [relay job]
  (let [mode (:mode (:options relay))
        timeout (or (:timeout-ms (:options job))
                    (:timeout-ms (:options relay)))]
    (if (= mode :correlated)
      (let [id (next-id relay)
            prepared ((:prepare-request (:options relay)) id (:value job))
            correlation-id (nth prepared 0)
            outgoing (nth prepared 1)]
        (register-pending relay correlation-id job)
        (arm-timeout relay mode correlation-id timeout)
        (try
          (send-bytes relay (frame/encode-frame (:codec relay) outgoing))
          (catch Throwable error
            (let [entry (remove-pending relay correlation-id)]
              (reject-entry entry error)))))
      (do
        (register-serial relay job)
        (arm-timeout relay mode nil timeout)
        (try
          (send-bytes relay (frame/encode-frame (:codec relay) (:value job)))
          (deref (:promise job))
          (catch Throwable error
            (let [entry (remove-serial relay)]
              (reject-entry entry error))))))))

(defn- writer-loop [relay]
  (promise/run
   (fn []
     (try
       (loop []
         (let [envelope (deref (mailbox-take (:jobs relay)))]
           (if envelope
             (let [job (:value envelope)]
               (if (= :exchange (:kind job))
                 (process-exchange relay job)
                 (process-send relay job))
               (recur))
             nil)))
       (catch Throwable error
         (fail relay error))))))

(defn start [relay]
  (let [current (state relay)]
    (cond
      (= :started (:status current)) relay
      (not= :created (:status current))
      (throw (ex-info "Relay cannot be started from its current state"
                      {:state (:status current)}))
      (cas! (:state relay) current (assoc current :status :started))
      (do
        (reset! (:reader relay) (reader-loop relay))
        (reset! (:writer relay) (writer-loop relay))
        relay)
      :else (start relay))))

(defn relay
  ([duplex codec] (relay duplex codec {}))
  ([duplex codec options]
   (start (create duplex codec options))))

(defn- enqueue [relay kind value options]
  (if (not (started? relay))
    (promise/new
     (fn [_ reject]
       (reject (ex-info "Relay is not started" {:error/type :relay/not-started}))))
    (let [holder (atom nil)
          output (promise/new
                  (fn [resolve reject]
                    (reset! holder {:kind kind
                                    :value value
                                    :options (or options {})
                                    :resolve resolve
                                    :reject reject})))]
      (let [job (assoc (deref holder) :promise output)]
        (try
          (mailbox-offer (:jobs relay) job)
          (catch Throwable error
            ((:reject job) error)))
        output))))

(defn send [relay value]
  (enqueue relay :send value {}))

(defn send-raw [relay value]
  (enqueue relay :raw value {}))

(defn exchange
  ([relay value] (exchange relay value {}))
  ([relay value options]
   (enqueue relay :exchange value options)))

(defn receive [relay]
  (promise/then
   (mailbox-take (:events relay))
   (fn [envelope]
     (if envelope (:value envelope) nil))))

(defn events [relay]
  (let [current (state relay)]
    (if (:events-taken current)
      (throw (ex-info "Relay events stream is single-consumer"
                      {:error/type :relay/events-taken})))
    (if (cas! (:state relay) current (assoc current :events-taken true))
      (stream/unfold
       (fn [_]
         (promise/then
          (mailbox-take (:events relay))
          (fn [envelope]
            (if envelope
              [{:type :message :value (:value envelope)} nil]
              nil))))
       nil)
      (events relay))))

(defn clean [relay]
  (mailbox-drain (:events relay)))

(defn close [relay]
  (loop []
    (let [current (state relay)]
      (if (or (= :closed (:status current)) (= :failed (:status current)))
        relay
        (let [error (ex-info "Relay closed" {:error/type :relay/closed})
              next-state (assoc (assoc (assoc current :status :closed)
                                       :pending {})
                                :serial-active nil)]
          (if (cas! (:state relay) current next-state)
            (do
              (reject-entries (vec (vals (:pending current))) error)
              (reject-entry (:serial-active current) error)
              (mailbox-close (:jobs relay) error)
              (mailbox-close (:events relay) nil)
              (Duplex/close (:duplex relay))
              relay)
            (recur)))))))

(extend-type Relay std.protocol.iclose/IClose
  (close [relay] (std.lib.relay/close relay)))

(defn send-command [relay command]
  (let [command (if (string? command) {:op :string :line command} command)
        operation (:op command)]
    (cond
      (= operation :partial)
      (send relay (:line command))

      (= operation :raw)
      (send-raw relay (:line command))

      (or (= operation :line) (= operation :string))
      (promise/then
       (if (nil? (:line command))
         (receive relay)
         (exchange relay (:line command) command))
       (fn [value] {:output value}))

      (= operation :clean)
      (promise/from {:dropped (count (clean relay))})

      (or (= operation :exit) (= operation :kill))
      (promise/from (close relay))

      :else
      (promise/new
       (fn [_ reject]
         (reject (ex-info "Unsupported Relay compatibility operation"
                          {:operation operation})))))))
