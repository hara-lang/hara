;; ============================================================================
;; std.lib.context — compatibility facade for std.context.
;;
;; Canonical context registry, space, pointer, and runtime-null behavior now
;; lives in std.context. This namespace remains only while downstream callers
;; migrate to the canonical surface tracked by issue #502.
;; ============================================================================
(ns std.lib.context
  (:require [std.context :as context]))

;; Preserve access to the canonical value types without creating duplicate
;; struct identities under the legacy namespace.
(def runtime-null-type context/runtime-null-type)
(def space-type context/space-type)
(def pointer-type context/pointer-type)

;; The compatibility binding points at the canonical registry atom. New code
;; should bind or replace std.context/*registry* directly.
(def ^{:dynamic true
       :doc "Compatibility reference to the canonical std.context registry atom."}
  *registry*
  context/*registry*)

(def runtime-null context/runtime-null)
(def registry-list context/registry-list)
(def registry-get context/registry-get)
(def registry-install context/registry-install)
(def registry-uninstall context/registry-uninstall)
(def registry-runtime context/registry-runtime)
(def registry-runtime-add context/registry-runtime-add)
(def registry-runtime-remove context/registry-runtime-remove)
(def registry-scratch context/registry-scratch)
(def registry-scratch-set! context/registry-scratch-set!)

(def space context/space)
(def space? context/space?)

(def pointer context/pointer)
(def pointer? context/pointer?)
(def pointer-default context/pointer-default)

(def call context/call)
(def has-module? context/has-module?)
(def setup-module context/setup-module)
(def teardown-module context/teardown-module)
(def has-pointer? context/has-pointer?)
(def setup-pointer context/setup-pointer)
(def teardown-pointer context/teardown-pointer)
(def invoke-in context/invoke-in)

(def ptr-context context/ptr-context)
(def ptr-keys context/ptr-keys)
(def ptr-val context/ptr-val)

(def context-set context/context-set)
(def context-unset context/context-unset)
(def context-list context/context-list)
(def context-get context/context-get)

(def rt-active context/rt-active)
(def rt-get context/rt-get)
(def rt-start context/rt-start)
(def rt-started? context/rt-started?)
(def rt-stopped? context/rt-stopped?)
(def rt-stop context/rt-stop)
