(ns std.sandbox)

(defn open
  [spec]
  (Sandbox/open spec))

(defn eval
  [id source]
  (Sandbox/eval id source))

(defn call
  [id callable arguments]
  (Sandbox/call id callable arguments))

(defn cancel
  [id]
  (Sandbox/cancel id))

(defn status
  [id]
  (Sandbox/status id))

(defn close
  [id]
  (Sandbox/close id))
