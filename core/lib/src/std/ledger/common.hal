;; ============================================================================
;; std.ledger.common — data types and map-like protocol extensions for the
;; consensus-free ledger chain.
;; ============================================================================
(ns std.ledger.common)

(defstruct Block
  [index
   prev-hash
   actor
   timestamp
   source
   state
   hash])

(defstruct Chain
  [blocks
   state])

(defn block-get
  "Looks up a known keyword field on a Block."
  [b k]
  (cond (= k :index)     (:index b)
        (= k :prev-hash) (:prev-hash b)
        (= k :actor)     (:actor b)
        (= k :timestamp) (:timestamp b)
        (= k :source)    (:source b)
        (= k :state)     (:state b)
        (= k :hash)      (:hash b)
        :else            nil))

(defn chain-get
  "Looks up a known keyword field on a Chain."
  [c k]
  (cond (= k :blocks) (:blocks c)
        (= k :state)  (:state c)
        :else         nil))

(defn block-assoc
  "Returns a new Block with the given keyword field replaced."
  [b k v]
  (std.ledger.common/Block
   (if (= k :index)     v (:index b))
   (if (= k :prev-hash) v (:prev-hash b))
   (if (= k :actor)     v (:actor b))
   (if (= k :timestamp) v (:timestamp b))
   (if (= k :source)    v (:source b))
   (if (= k :state)     v (:state b))
   (if (= k :hash)      v (:hash b))))

(defn chain-assoc
  "Returns a new Chain with the given keyword field replaced."
  [c k v]
  (std.ledger.common/Chain
   (if (= k :blocks) v (:blocks c))
   (if (= k :state)  v (:state c))))

;; Map-backed defstruct makes the explicit ILookup/IAssoc extensions redundant.
;; block-get/chain-get/block-assoc/chain-assoc are still used internally by chain.hal.
