;; Familiar portable filesystem API layered over std.native.File effects.
(ns std.fs
  (:config {:override [list]})
  (:require [std.foundation.promise :as promise]
            [std.foundation.string :as str]
            [std.fs.path :as path]
            [std.fs.walk :as walk]))

(def copy-default-options
  {:replace? false
   :parents? false
   :preserve-modified? false})

(def delete-default-options
  {:recursive? false
   :missing-ok? false})

(defn- rejected
  [error]
  (promise/new (fn [_ reject] (reject error))))

(defn stat [value] (File/stat (path/normalise value)))
(defn exists? [value] (File/exists? (path/normalise value)))
(defn entries [value] (File/entries (path/normalise value)))
(defn list [value] (File/list (path/normalise value)))
(defn read-bytes [value] (File/read (path/normalise value)))

(defn write-bytes
  ([value bytes]
   (write-bytes value bytes {}))
  ([value bytes options]
   (File/write (path/normalise value) bytes options)))

(defn file?
  [value]
  (promise/then (stat value) (fn [entry] (= (:type entry) :file))))

(defn directory?
  [value]
  (promise/then (stat value) (fn [entry] (= (:type entry) :directory))))

(defn symlink?
  [value]
  (promise/then (stat value) (fn [entry] (= (:type entry) :symlink))))

(defn select
  ([value predicate]
   (select value predicate {}))
  ([value predicate options]
   (promise/then
    (walk/walk value options)
    (fn [values] (vec (filter predicate values))))))

(defn create-directory
  ([value]
   (create-directory value {}))
  ([value options]
   (File/mkdir (path/normalise value) options)))

(def mkdir create-directory)

(defn temp-file
  ([parent]
   (temp-file parent {}))
  ([parent options]
   (File/temp-file (path/normalise parent) options)))

(defn temp-directory
  ([parent]
   (temp-directory parent {}))
  ([parent options]
   (File/temp-directory (path/normalise parent) options)))

(defn copy-single
  ([source target]
   (copy-single source target {}))
  ([source target options]
   (File/copy (path/normalise source)
              (path/normalise target)
              options)))

(defn move
  ([source target]
   (move source target {}))
  ([source target options]
   (File/move (path/normalise source)
              (path/normalise target)
              options)))

(defn- map-merge
  [left right]
  (reduce (fn [output entry]
            (assoc output (nth entry 0) (nth entry 1)))
          left
          right))

(defn- copy-invalid-target?
  [source target]
  (or (= source target)
      (= source "/")
      (str/starts-with? target (str source "/"))))

(defn- delete-tree
  [value options]
  (letfn [(delete-many [children]
            (loop [index 0
                   result (promise/from [])]
              (if (= index (count children))
                result
                (recur
                 (inc index)
                 (promise/then
                  result
                  (fn [deleted]
                    (promise/then
                     (delete-node (:path (nth children index)))
                     (fn [values] (reduce conj deleted values)))))))))
          (delete-node [current]
            (promise/then
             (stat current)
             (fn [entry]
               (if (and (:recursive? options)
                        (= (:type entry) :directory))
                 (promise/then
                  (entries current)
                  (fn [children]
                    (promise/then
                     (delete-many children)
                     (fn [deleted]
                       (promise/then
                        (File/delete current {:missing-ok? false})
                        (fn [deleted-path]
                          (conj deleted deleted-path)))))))
                 (promise/then
                  (File/delete current {:missing-ok? false})
                  (fn [deleted-path] [deleted-path]))))))]
    (delete-node value)))

(defn delete
  "Deletes a file, symlink, or empty directory. With :recursive? true,
   directories are deleted in post-order and the promise resolves to the
   deleted canonical paths."
  ([value]
   (delete value {}))
  ([value options]
   (let [value (path/normalise value)
         options (merge delete-default-options options)]
     (if (= value "/")
       (rejected
        (ex-info "The mounted filesystem root cannot be deleted"
                 {:error/code :file/denied
                  :file/operation :delete
                  :file/path value
                  :file/target nil}))
       (promise/then
        (exists? value)
        (fn [present]
          (if present
            (delete-tree value options)
            (if (:missing-ok? options)
              (promise/from [])
              (promise/then
               (File/delete value {:missing-ok? false})
               (fn [deleted-path] [deleted-path]))))))))))

(defn- prepare-directory-target
  [target options]
  (promise/then
   (exists? target)
   (fn [present]
     (if present
       (if (:replace? options)
         (promise/then
          (delete target {:recursive? true :missing-ok? false})
          (fn [_]
            (create-directory target
                              {:parents? (:parents? options)
                               :exists-ok? false})))
         (rejected
          (ex-info "Copy target already exists"
                   {:error/code :file/already-exists
                    :file/operation :copy
                    :file/path target
                    :file/target target})))
       (create-directory target
                         {:parents? (:parents? options)
                          :exists-ok? false})))))

(defn- copy-tree
  [source target options]
  (letfn [(copy-many [children destination-root]
            (loop [index 0
                   result (promise/from {})]
              (if (= index (count children))
                result
                (let [entry (nth children index)
                      destination (path/join destination-root (:name entry))]
                  (recur
                   (inc index)
                   (promise/then
                    result
                    (fn [output]
                      (promise/then
                       (copy-node (:path entry) destination)
                       (fn [values] (map-merge output values))))))))))
          (copy-node [current-source current-target]
            (promise/then
             (stat current-source)
             (fn [entry]
               (cond
                 (= (:type entry) :file)
                 (promise/then
                  (copy-single current-source current-target options)
                  (fn [destination] {current-source destination}))

                 (= (:type entry) :directory)
                 (promise/then
                  (prepare-directory-target current-target options)
                  (fn [_]
                    (promise/then
                     (entries current-source)
                     (fn [children]
                       (promise/then
                        (copy-many children current-target)
                        (fn [values]
                          (assoc values current-source current-target)))))))

                 :else
                 (rejected
                  (ex-info "Only regular files and directories can be copied"
                           {:error/code :file/unsupported
                            :file/operation :copy
                            :file/path current-source
                            :file/target current-target}))))))]
    (copy-node source target)))

(defn copy
  "Copies a regular file or directory tree without following symbolic links.
   Resolves to a source-to-target map."
  ([source target]
   (copy source target {}))
  ([source target options]
   (let [source (path/normalise source)
         target (path/normalise target)
         options (merge copy-default-options options)]
     (if (copy-invalid-target? source target)
       (rejected
        (ex-info "Copy target must not be the source or one of its descendants"
                 {:error/code :file/invalid-path
                  :file/operation :copy
                  :file/path source
                  :file/target target}))
       (copy-tree source target options)))))

(defn copy-into
  ([source directory]
   (copy-into source directory {}))
  ([source directory options]
   (let [name (path/file-name source)]
     (if (= name "")
       (rejected
        (ex-info "The mounted root has no filename for copy-into"
                 {:error/code :file/invalid-path
                  :file/operation :copy
                  :file/path (path/normalise source)
                  :file/target (path/normalise directory)}))
       (copy source (path/join directory name) options)))))
