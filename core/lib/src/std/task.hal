;; ============================================================================
;; std.task — temporary compatibility facade over work.flow.task.
;; ============================================================================
(ns std.task
  (:require [work.flow.task :as task]))

(def task task/task)
(def compile task/compile)
(def invoke task/invoke)
(def request task/request)
(def invocation task/invocation)
(def invocation-arguments task/invocation-arguments)
(def task-work? task/task-work?)
(def default-task-options task/default-task-options)

(defmacro def.task
  [definition-name definition & declaration-body]
  `(work.flow.task/def.task
    ~definition-name
    ~definition
    ~@declaration-body))

(defmacro deftask
  [definition-name definition & declaration-body]
  `(work.flow.task/deftask
    ~definition-name
    ~definition
    ~@declaration-body))
