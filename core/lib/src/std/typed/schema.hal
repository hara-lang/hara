;; Experimental portable schema core for HAL metadata and relation contracts.
(ns std.typed.schema
  (:require [std.typed.registry :as registry]))

(def ^{:dynamic true} *registry* nil)

(defn- normalize-dispatch
  [schema]
  (cond
    (Schema/instance? schema)
    :schema-value

    (and (map? schema) (has? schema :kind))
    :normalized

    (keyword? schema)
    :primitive

    (and (list? schema)
         (= 2 (count schema))
         (= 'var (first schema))
         (symbol? (second schema)))
    :reference

    (and *registry* (symbol? schema))
    :registry-reference

    (not (vector? schema))
    :unknown

    (and (= 1 (count schema))
         (keyword? (first schema)))
    :primitive-vector

    :else (first schema)))

(defmulti normalize normalize-dispatch)

(defn- append-unique [values value]
  (if (any? (fn [candidate] (= candidate value)) values)
    values
    (conj values value)))

(defn- append-union-type [values value]
  (if (= :union (:kind value))
    (loop [remaining (:types value)
           output values]
      (if (empty? remaining)
        output
        (recur (rest remaining)
               (append-unique output (first remaining)))))
    (append-unique values value)))

(defn- normalize-union [types]
  (let [members
        (loop [remaining types
               output []]
          (if (empty? remaining)
            output
            (recur (rest remaining)
                   (append-union-type output
                                      (normalize (first remaining))))))]
    (if (= 1 (count members))
      (first members)
      {:kind :union :types members})))

(defn- normalize-input-vector [inputs]
  (loop [index 0
         fixed []]
    (if (= index (count inputs))
      {:fixed fixed :rest nil}
      (if (= '& (nth inputs index))
        {:fixed fixed
         :rest (normalize (nth inputs (inc index)))}
        (recur (inc index)
               (conj fixed (normalize (nth inputs index))))))))

(defn- normalize-inputs [inputs]
  (if (map? inputs)
    (let [rest-schema (get inputs :rest nil)]
      {:fixed (vec (map normalize (get inputs :fixed [])))
       :rest (if (nil? rest-schema)
               nil
               (normalize rest-schema))})
    (normalize-input-vector inputs)))

(defn- normalize-fn-map [schema]
  {:kind :fn
   :inputs (normalize-inputs (:inputs schema))
   :output (normalize (:output schema))})

(defn- normalize-function-arities [arities]
  (let [normalized
        (vec
         (map (fn [arity]
                (normalize
                 (if (and (map? arity)
                          (not (has? arity :kind)))
                   (assoc arity :kind :fn)
                   arity)))
              arities))]
    (if (= 1 (count normalized))
      (first normalized)
      {:kind :function :arities normalized})))

(defn- normalize-field [field]
  (if (map? field)
    {:name (:name field)
     :type (normalize (:type field))}
    {:name (first field)
     :type (normalize (second field))}))

(defn- canonical-normal?
  [schema]
  (and
   (map? schema)
   (let [kind (:kind schema)]
     (cond
       (= kind :primitive)
       (and (has? schema :name)
            (keyword? (:name schema)))

       (= kind :reference)
       (and (has? schema :name)
            (symbol? (:name schema)))

       (= kind :union)
       (and (vector? (:types schema))
            (every? canonical-normal? (:types schema)))

       (= kind :vector)
       (canonical-normal? (:item schema))

       (= kind :tuple)
       (and (vector? (:items schema))
            (every? canonical-normal? (:items schema)))

       (= kind :map)
       (and
        (vector? (:fields schema))
        (every?
         (fn [field]
           (and (map? field)
                (has? field :name)
                (canonical-normal? (:type field))))
         (:fields schema)))

       (= kind :fn)
       (let [inputs (:inputs schema)]
         (and
          (map? inputs)
          (vector? (:fixed inputs))
          (every? canonical-normal? (:fixed inputs))
          (or (nil? (:rest inputs))
              (canonical-normal? (:rest inputs)))
          (canonical-normal? (:output schema))))

       (= kind :function)
       (and (vector? (:arities schema))
            (every?
             (fn [arity]
               (and (= :fn (:kind arity))
                    (canonical-normal? arity)))
             (:arities schema)))

       (= kind :enum)
       (vector? (:values schema))

       (= kind :result)
       (and (map? (:properties schema))
            (canonical-normal? (:data schema)))

       (= kind :extension)
       (and (keyword? (:head schema))
            (vector? (:arguments schema))
            (has? schema :surface))

       (= kind :unknown)
       (has? schema :surface)

       :else false))))

(defn- normalize-normalized [schema]
  (if (canonical-normal? schema)
    schema
    (let [kind (:kind schema)
          children (get schema :children [])]
      (cond
        (= kind :primitive)
        (normalize
         (if (has? schema :name)
           (:name schema)
           (first children)))

        (= kind :reference)
        {:kind :reference
         :name (if (has? schema :name)
                 (:name schema)
                 (first children))}

        (or (= kind :union) (= kind :or))
        (normalize-union
         (if (has? schema :types)
           (:types schema)
           children))

        (= kind :vector)
        {:kind :vector
         :item (normalize
                (if (has? schema :item)
                  (:item schema)
                  (first children)))}

        (= kind :tuple)
        {:kind :tuple
         :items (vec
                 (map normalize
                      (if (has? schema :items)
                        (:items schema)
                        children)))}

        (= kind :map)
        {:kind :map
         :fields
         (vec
          (map normalize-field
               (if (has? schema :fields)
                 (:fields schema)
                 children)))}

        (= kind :fn)
        (normalize-fn-map schema)

        (= kind :function)
        (normalize-function-arities
         (if (has? schema :arities)
           (:arities schema)
           children))

        (= kind :enum)
        {:kind :enum
         :values (vec
                  (if (has? schema :values)
                    (:values schema)
                    children))}

        (= kind :result)
        {:kind :result
         :properties (or (:properties schema) {})
         :data (normalize (:data schema))}

        (= kind :extension)
        (let [head (if (has? schema :head)
                     (:head schema)
                     (:name schema))
              arguments (if (has? schema :arguments)
                          (:arguments schema)
                          children)]
          {:kind :extension
           :head head
           :arguments (vec arguments)
           :surface (if (has? schema :surface)
                      (:surface schema)
                      (vec (concat [head] arguments)))})

        (= kind :unknown)
        {:kind :unknown
         :surface (if (has? schema :surface)
                    (:surface schema)
                    (first children))}

        :else schema))))

(defmethod normalize :schema-value [schema]
  (normalize (Schema/ast schema)))

(defmethod normalize :normalized [schema]
  (normalize-normalized schema))

(defmethod normalize :primitive [schema]
  {:kind :primitive :name schema})

(defn- registry-reference-name
  [target]
  (if *registry*
    (registry/qualify *registry* target)
    target))

(defmethod normalize :reference [schema]
  {:kind :reference
   :name (registry-reference-name (second schema))})

(defmethod normalize :registry-reference [schema]
  {:kind :reference
   :name (registry-reference-name schema)})

(defn ^{:schema [:fn [:any :any] :map]}
  normalize-with
  "Normalizes schema using an explicit portable schema registry."
  [schema registry-value]
  (binding [*registry* (registry/ensure registry-value)]
    (normalize schema)))

(defmethod normalize :primitive-vector [schema]
  (normalize (first schema)))

(defmethod normalize :unknown [schema]
  {:kind :unknown :surface schema})

(defmethod normalize :or [schema]
  (normalize-union (rest schema)))

(defmethod normalize :maybe [schema]
  (normalize-union [(second schema) :nil]))

(defmethod normalize :vector [schema]
  {:kind :vector
   :item (normalize (second schema))})

(defmethod normalize :tuple [schema]
  {:kind :tuple
   :items (vec (map normalize (rest schema)))})

(defmethod normalize :map [schema]
  {:kind :map
   :fields (vec (map normalize-field (rest schema)))})

(defmethod normalize :fn [schema]
  (normalize-fn-map
   {:inputs (second schema)
    :output (nth schema 2)}))

(defmethod normalize :function [schema]
  (normalize-function-arities (rest schema)))

(defmethod normalize :enum [schema]
  {:kind :enum :values (vec (rest schema))})

(defn- normalize-result-properties [properties]
  (let [status (:status properties)
        error-code (:error-code properties)
        unknown (vec (filter (fn [key]
                               (not (has? #{:status :error-code} key)))
                             (keys properties)))]
    (cond
      (not (empty? unknown))
      (throw (ex-info "unsupported :result schema property"
                      {:properties unknown}))

      (and status (not (has? #{:success :error} status)))
      (throw (ex-info ":result :status must be :success or :error"
                      {:status status}))

      (and error-code (not (keyword? error-code)))
      (throw (ex-info ":result :error-code must be a keyword"
                      {:error-code error-code}))

      (and error-code (= :success status))
      (throw (ex-info ":result :error-code conflicts with success status"
                      properties))

      error-code
      (assoc (if status {:status status} {})
             :status :error
             :error-code error-code)

      status {:status status}
      :else {})))

(defmethod normalize :result [schema]
  (let [arguments (vec (rest schema))]
    (cond
      (= 1 (count arguments))
      {:kind :result
       :properties {}
       :data (normalize (first arguments))}

      (and (= 2 (count arguments)) (map? (first arguments)))
      {:kind :result
       :properties (normalize-result-properties (first arguments))
       :data (normalize (second arguments))}

      :else
      (throw (ex-info ":result expects a data schema and optional properties"
                      {:schema schema})))))

(defmethod normalize :default [schema]
  {:kind :extension
   :head (first schema)
   :arguments (vec (rest schema))
   :surface schema})

(defn- append-reference-name
  [names schema-name]
  (if (any? (fn [candidate] (= candidate schema-name)) names)
    names
    (conj names schema-name)))

(declare reference-names-normal)

(defn- collect-reference-names
  [schemas]
  (loop [remaining schemas
         output []]
    (if (empty? remaining)
      output
      (let [nested (reference-names-normal (first remaining))]
        (recur
         (rest remaining)
         (loop [nested nested
                output output]
           (if (empty? nested)
             output
             (recur (rest nested)
                    (append-reference-name output (first nested))))))))))

(defn- reference-names-normal
  [schema]
  (let [kind (:kind schema)]
    (cond
      (= kind :reference)
      [(:name schema)]

      (= kind :union)
      (collect-reference-names (:types schema))

      (= kind :vector)
      (reference-names-normal (:item schema))

      (= kind :tuple)
      (collect-reference-names (:items schema))

      (= kind :map)
      (collect-reference-names
       (map (fn [field] (:type field)) (:fields schema)))

      (= kind :fn)
      (let [inputs (:inputs schema)
            rest-schema (:rest inputs)
            members
            (vec
             (concat (:fixed inputs)
                     (if rest-schema [rest-schema] [])
                     [(:output schema)]))]
        (collect-reference-names members))

      (= kind :function)
      (collect-reference-names (:arities schema))

      (= kind :result)
      (reference-names-normal (:data schema))

      :else [])))

(defn ^{:schema [:function
                 [:fn [:any] :vector]
                 [:fn [:any :any] :vector]]}
  reference-names
  "Returns named schema references in deterministic declaration order."
  ([schema]
   (reference-names-normal (normalize schema)))
  ([schema registry-value]
   (reference-names-normal
    (normalize-with schema registry-value))))

(defn ^{:schema [:fn [:any :any] :map]}
  resolve-reference
  "Resolves one named reference, leaving unresolved references unchanged."
  [schema registry-value]
  (let [registry-value (registry/ensure registry-value)
        normalized (normalize-with schema registry-value)]
    (if (= :reference (:kind normalized))
      (let [found (registry/find-schema registry-value (:name normalized))]
        (if found
          (normalize-with (:schema found) (:registry found))
          normalized))
      normalized)))

(declare resolve-normal)

(defn- resolve-many
  [schemas registry-value visited]
  (vec
   (map (fn [schema]
          (resolve-normal schema registry-value visited))
        schemas)))

(defn- resolve-normal
  [schema registry-value visited]
  (let [kind (:kind schema)]
    (cond
      (= kind :reference)
      (let [schema-name (:name schema)]
        (if (has? visited schema-name)
          schema
          (let [found (registry/find-schema registry-value schema-name)]
            (if found
              (let [source-registry (:registry found)
                    target (normalize-with (:schema found) source-registry)]
                (resolve-normal target
                                source-registry
                                (conj visited schema-name)))
              schema))))

      (= kind :union)
      (normalize-union
       (resolve-many (:types schema) registry-value visited))

      (= kind :vector)
      (assoc schema :item
             (resolve-normal (:item schema) registry-value visited))

      (= kind :tuple)
      (assoc schema :items
             (resolve-many (:items schema) registry-value visited))

      (= kind :map)
      (assoc schema :fields
             (vec
              (map (fn [field]
                     (assoc field :type
                            (resolve-normal (:type field)
                                            registry-value
                                            visited)))
                   (:fields schema))))

      (= kind :fn)
      (let [inputs (:inputs schema)
            rest-schema (:rest inputs)]
        (assoc schema
               :inputs
               {:fixed (resolve-many (:fixed inputs)
                                     registry-value
                                     visited)
                :rest (if rest-schema
                        (resolve-normal rest-schema
                                        registry-value
                                        visited)
                        nil)}
               :output (resolve-normal (:output schema)
                                       registry-value
                                       visited)))

      (= kind :function)
      (assoc schema :arities
             (resolve-many (:arities schema) registry-value visited))

      (= kind :result)
      (assoc schema :data
             (resolve-normal (:data schema) registry-value visited))

      :else schema)))

(defn ^{:schema [:fn [:any :any] :map]}
  resolve-recursive
  "Resolves all reachable references; recursive edges remain references."
  [schema registry-value]
  (let [registry-value (registry/ensure registry-value)]
    (resolve-normal (normalize-with schema registry-value)
                    registry-value
                    #{})))

(defn ^{:schema [:fn [:any :any] :vector]}
  unresolved-references
  "Returns reachable references that are absent from registry."
  [schema registry-value]
  (let [registry-value (registry/ensure registry-value)
        resolved (resolve-recursive schema registry-value)]
    (vec
     (filter (fn [schema-name]
               (not (registry/has-schema? registry-value schema-name)))
             (reference-names-normal resolved)))))

(defn- primitive-valid? [name value]
  (cond
    (= name :any) true
    (= name :nil) (nil? value)
    (= name :bool) (boolean? value)
    (= name :boolean) (boolean? value)
    (= name :num) (number? value)
    (= name :number) (number? value)
    (= name :int) (long? value)
    (= name :integer) (long? value)
    (= name :str) (string? value)
    (= name :string) (string? value)
    (= name :keyword) (keyword? value)
    (= name :symbol) (symbol? value)
    (= name :list) (list? value)
    (= name :vector) (vector? value)
    (= name :map) (map? value)
    (= name :set) (set? value)
    (= name :bytes) (bytes? value)
    :else true))

(defn- finding [path expected value]
  {:finding/type :std.typed.schema/invalid-value
   :finding/path (vec path)
   :finding/expected expected
   :finding/value value})

(defn- validate-dispatch [schema value path]
  (:kind schema))

(defmulti validate-normal validate-dispatch)

(defmethod validate-normal :primitive [schema value path]
  (if (primitive-valid? (:name schema) value)
    []
    [(finding path schema value)]))

(defmethod validate-normal :enum [schema value path]
  (if (any? (fn [candidate] (= candidate value))
            (:values schema))
    []
    [(finding path schema value)]))

(defn- result-error-code [value]
  (if (Result/error? value)
    (get (ex-data (Result/error-value value)) :code)
    nil))

(defmethod validate-normal :result [schema value path]
  (if (not (Result/instance? value))
    [(finding path schema value)]
    (let [properties (:properties schema)
          expected-status (:status properties)
          expected-code (:error-code properties)
          actual-status (:status value)
          status-findings
          (if (and expected-status (not= expected-status actual-status))
            [(finding (conj path :status) expected-status actual-status)]
            [])
          actual-code (result-error-code value)
          code-findings
          (if (and expected-code (not= expected-code actual-code))
            [(finding (conj path :error :code) expected-code actual-code)]
            [])
          data-findings
          (if (Result/success? value)
            (validate-normal (:data schema) (Result/data value) (conj path :data))
            [])]
      (vec (concat status-findings code-findings data-findings)))))

(defmethod validate-normal :union [schema value path]
  (if (any? (fn [member]
              (empty? (validate-normal member value path)))
            (:types schema))
    []
    [(finding path schema value)]))

(defmethod validate-normal :vector [schema value path]
  (if (vector? value)
    (loop [index 0
           output []]
      (if (= index (count value))
        output
        (recur
         (inc index)
         (vec
          (concat output
                  (validate-normal (:item schema)
                                   (nth value index)
                                   (conj path index)))))))
    [(finding path schema value)]))

(defmethod validate-normal :tuple [schema value path]
  (if (and (vector? value)
           (= (count value) (count (:items schema))))
    (loop [index 0
           output []]
      (if (= index (count value))
        output
        (recur
         (inc index)
         (vec
          (concat output
                  (validate-normal (nth (:items schema) index)
                                   (nth value index)
                                   (conj path index)))))))
    [(finding path schema value)]))

(defmethod validate-normal :map [schema value path]
  (if (map? value)
    (loop [remaining (:fields schema)
           output []]
      (if (empty? remaining)
        output
        (let [field (first remaining)
              key (:name field)]
          (recur
           (rest remaining)
           (if (has? value key)
             (vec
              (concat output
                      (validate-normal (:type field)
                                       (get value key)
                                       (conj path key))))
             (conj output
                   (assoc (finding (conj path key)
                                   (:type field)
                                   nil)
                          :finding/context {:present? false})))))))
    [(finding path schema value)]))

(defn- reference-finding
  [finding-type path schema value]
  {:finding/type finding-type
   :finding/path (vec path)
   :finding/expected schema
   :finding/value value
   :finding/reference (:name schema)})

(defmethod validate-normal :reference [schema value path]
  [(reference-finding
    :std.typed.schema/unresolved-reference
    path schema value)])

(declare validate-normal-with)

(defn- validate-union-with
  [schema value path registry-value trail]
  (loop [remaining (:types schema)]
    (if (empty? remaining)
      [(finding path schema value)]
      (if (empty?
           (validate-normal-with (first remaining)
                                 value
                                 path
                                 registry-value
                                 trail))
        []
        (recur (rest remaining))))))

(defn- validate-vector-with
  [schema value path registry-value trail]
  (if (vector? value)
    (loop [index 0
           output []]
      (if (= index (count value))
        output
        (recur
         (inc index)
         (vec
          (concat output
                  (validate-normal-with (:item schema)
                                        (nth value index)
                                        (conj path index)
                                        registry-value
                                        trail))))))
    [(finding path schema value)]))

(defn- validate-tuple-with
  [schema value path registry-value trail]
  (if (and (vector? value)
           (= (count value) (count (:items schema))))
    (loop [index 0
           output []]
      (if (= index (count value))
        output
        (recur
         (inc index)
         (vec
          (concat output
                  (validate-normal-with (nth (:items schema) index)
                                        (nth value index)
                                        (conj path index)
                                        registry-value
                                        trail))))))
    [(finding path schema value)]))

(defn- validate-map-with
  [schema value path registry-value trail]
  (if (map? value)
    (loop [remaining (:fields schema)
           output []]
      (if (empty? remaining)
        output
        (let [field (first remaining)
              key (:name field)]
          (recur
           (rest remaining)
           (if (has? value key)
             (vec
              (concat output
                      (validate-normal-with (:type field)
                                            (get value key)
                                            (conj path key)
                                            registry-value
                                            trail)))
             (conj output
                   (assoc (finding (conj path key)
                                   (:type field)
                                   nil)
                          :finding/context {:present? false})))))))
    [(finding path schema value)]))

(defn- validate-reference-with
  [schema value path registry-value trail]
  (let [schema-name (:name schema)
        found (registry/find-schema registry-value schema-name)]
    (if (nil? found)
      [(reference-finding
        :std.typed.schema/unresolved-reference
        path schema value)]
      (let [source-registry (:registry found)
            qualified-name (:name found)
            visit-key [qualified-name (vec path)]]
        (if (has? trail visit-key)
          [(reference-finding
            :std.typed.schema/cyclic-reference
            path schema value)]
          (validate-normal-with
           (normalize-with (:schema found) source-registry)
           value
           path
           source-registry
           (conj trail visit-key)))))))

(defn- validate-normal-with
  [schema value path registry-value trail]
  (let [kind (:kind schema)]
    (cond
      (= kind :reference)
      (validate-reference-with schema value path registry-value trail)

      (= kind :union)
      (validate-union-with schema value path registry-value trail)

      (= kind :vector)
      (validate-vector-with schema value path registry-value trail)

      (= kind :tuple)
      (validate-tuple-with schema value path registry-value trail)

      (= kind :map)
      (validate-map-with schema value path registry-value trail)

      (= kind :result)
      (if (not (Result/instance? value))
        [(finding path schema value)]
        (let [base-findings (validate-normal schema value path)]
          (if (Result/success? value)
            (vec
             (concat
              (filter (fn [item]
                        (not= (conj path :data) (:finding/path item)))
                      base-findings)
              (validate-normal-with (:data schema)
                                    (Result/data value)
                                    (conj path :data)
                                    registry-value
                                    trail)))
            base-findings)))

      :else
      (validate-normal schema value path))))

(defmethod validate-normal :default [schema value path]
  [])

(defn ^{:schema [:function
                 [:fn [:any :any] :vector]
                 [:fn [:any :any :any] :vector]]}
  validate
  "Returns deterministic, path-aware findings for value against schema."
  ([schema value]
   (validate-normal (normalize schema) value []))
  ([schema value registry-value]
   (let [registry-value (registry/ensure registry-value)]
     (validate-normal-with
      (normalize-with schema registry-value)
      value
      []
      registry-value
      #{}))))

(defn ^{:schema [:function
                 [:fn [:any :any] :bool]
                 [:fn [:any :any :any] :bool]]}
  valid?
  "Returns true when value conforms to schema."
  ([schema value]
   (empty? (validate schema value)))
  ([schema value registry-value]
   (empty? (validate schema value registry-value))))

(defn- compatible-normal? [expected actual]
  (cond
    (= expected actual) true
    (and (= :primitive (:kind expected))
         (= :any (:name expected))) true
    (and (= :primitive (:kind actual))
         (= :any (:name actual))) true
    (= :unknown (:kind expected)) true
    (= :unknown (:kind actual)) true
    (= :union (:kind expected))
    (any? (fn [member] (compatible-normal? member actual))
          (:types expected))
    (= :union (:kind actual))
    (any? (fn [member] (compatible-normal? expected member))
          (:types actual))
    (and (= :result (:kind expected))
         (= :result (:kind actual)))
    (let [expected-status (get-in expected [:properties :status])
          actual-status (get-in actual [:properties :status])
          expected-code (get-in expected [:properties :error-code])
          actual-code (get-in actual [:properties :error-code])]
      (and (or (nil? expected-status)
               (nil? actual-status)
               (= expected-status actual-status))
           (or (nil? expected-code)
               (nil? actual-code)
               (= expected-code actual-code))
           (compatible-normal? (:data expected) (:data actual))))
    :else false))

(defn ^{:schema [:function
                 [:fn [:any :any] :bool]
                 [:fn [:any :any :any] :bool]]}
  compatible?
  "Returns true when two schemas have an overlapping value domain."
  ([expected actual]
   (compatible-normal? (normalize expected) (normalize actual)))
  ([expected actual registry-value]
   (compatible-normal?
    (resolve-recursive expected registry-value)
    (resolve-recursive actual registry-value))))

(defn ^{:schema [:function
                 [:fn [:any] :vector]
                 [:fn [:any :any] :vector]]}
  project-arities
  "Returns normalized function arities from :fn or :function schema."
  ([schema]
   (let [normalized (normalize schema)]
     (cond
       (= :fn (:kind normalized)) [normalized]
       (= :function (:kind normalized)) (:arities normalized)
       :else [])))
  ([schema registry-value]
   (let [normalized (resolve-recursive schema registry-value)]
     (cond
       (= :fn (:kind normalized)) [normalized]
       (= :function (:kind normalized)) (:arities normalized)
       :else []))))
