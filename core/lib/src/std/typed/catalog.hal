(ns std.typed.catalog
  (:require [std.typed.catalog.codec :as codec]
            [std.typed.registry :as registry]
            [std.typed.schema :as schema]))

(def +catalog-type+ :std.typed.catalog/catalog)
(def +entry-type+ :std.typed.catalog/entry)

(def +option-keys+
  #{:namespace :aliases :refers :parents})

(defn- catalog-error
  [message data]
  (throw
   (ex-info message
            (assoc data :type :std.typed.catalog/invalid-catalog))))

(defn- qualified-keyword?
  [value]
  (and (keyword? value)
       (not (nil? (namespace value)))))

(defn- qualified-symbol?
  [value]
  (and (symbol? value)
       (not (nil? (namespace value)))))

(defn- identity-name
  [identity]
  (if (qualified-keyword? identity)
    (symbol (namespace identity) (name identity))
    (catalog-error "schema identity must be a qualified keyword"
                   {:schema/id identity})))

(defn- name-identity
  [schema-name]
  (if (qualified-symbol? schema-name)
    (keyword (namespace schema-name) (name schema-name))
    (catalog-error "catalog schema names must be qualified symbols"
                   {:schema/name schema-name})))

(defn- require-version
  [version]
  (if (and (long? version) (not (< version 0)))
    version
    (catalog-error "schema version must be a non-negative integer"
                   {:schema/version version})))

(defn ^{:schema [:fn [:any] :bool]}
  entry?
  "Returns true for a canonical identified schema entry."
  [value]
  (and (map? value)
       (= +entry-type+ (:schema/entry-type value))
       (qualified-keyword? (:schema/id value))
       (long? (:schema/version value))
       (not (< (:schema/version value) 0))
       (qualified-symbol? (:schema/name value))
       (map? (:schema/ast value))
       (string? (:schema/hash value))
       (re-matches "sha256:[0-9a-f]{64}" (:schema/hash value))))

(defn ^{:schema [:fn [:any] :bool]}
  catalog?
  "Returns true for a canonical executable schema catalog."
  [value]
  (and (map? value)
       (= +catalog-type+ (:catalog/type value))
       (registry/registry? (:catalog/registry value))
       (map? (:catalog/entries value))
       (map? (:catalog/latest value))
       (vector? (:catalog/parents value))))

(defn ^{:schema [:fn [:any] :map]}
  ensure
  "Returns catalog or throws a structured catalog error."
  [value]
  (if (catalog? value)
    value
    (catalog-error "expected a schema catalog"
                   {:catalog value})))

(defn ^{:schema [:fn [:map] :map]}
  coordinate
  "Returns the exact immutable coordinate for a catalog entry."
  [entry]
  (if (entry? entry)
    {:schema/id (:schema/id entry)
     :schema/version (:schema/version entry)
     :schema/hash (:schema/hash entry)}
    (catalog-error "coordinate expects a canonical schema entry"
                   {:entry entry})))

(defn- coordinate-key
  [entry]
  [(:schema/id entry) (:schema/version entry)])

(defn- coordinate-map-key
  [coordinate]
  [(:schema/id coordinate) (:schema/version coordinate)])

(defn- append-unique
  [values value]
  (if (any? (fn [candidate] (= candidate value)) values)
    values
    (conj values value)))

(defn- append-values
  [output values]
  (loop [remaining values
         output output]
    (if (empty? remaining)
      output
      (recur (rest remaining)
             (append-unique output (first remaining))))))

(defn- require-entry-spec
  [spec]
  (if (not (map? spec))
    (catalog-error "catalog entries must be maps"
                   {:entry spec}))
  (let [identity (:schema/id spec)
        version (:schema/version spec)]
    (if (not (qualified-keyword? identity))
      (catalog-error "catalog entry :schema/id must be a qualified keyword"
                     {:entry spec :schema/id identity}))
    (require-version version)
    (if (not (has? spec :schema/form))
      (catalog-error "catalog entry requires :schema/form"
                     {:entry spec}))
    (assoc spec :schema/name (identity-name identity))))

(defn- entry-specs
  [entries]
  (let [values
        (cond
          (map? entries)
          (map
           (fn [entry]
             (let [identity (key entry)
                   value (val entry)]
               (if (map? value)
                 (if (has? value :schema/id)
                   value
                   (assoc value :schema/id identity))
                 {:schema/id identity
                  :schema/version 1
                  :schema/form value})))
           entries)

          (sequential? entries)
          entries

          :else
          (catalog-error "catalog entries must be a map or sequence"
                         {:entries entries}))]
    (vec (map require-entry-spec values))))

(defn- unique-entry-specs
  [entries]
  (loop [remaining entries
         seen #{}
         output []]
    (if (empty? remaining)
      output
      (let [entry (first remaining)
            key (coordinate-key entry)]
        (if (has? seen key)
          (catalog-error "duplicate schema identity and version"
                         {:schema/id (:schema/id entry)
                          :schema/version (:schema/version entry)})
          (recur (rest remaining)
                 (conj seen key)
                 (conj output entry)))))))

(defn- latest-specs
  [entries]
  (reduce
   (fn [output entry]
     (let [identity (:schema/id entry)
           current (get output identity nil)]
       (if (or (nil? current)
               (> (:schema/version entry)
                  (:schema/version current)))
         (assoc output identity entry)
         output)))
   {}
   entries))

(defn- registry-entry-map
  [latest]
  (reduce
   (fn [output entry]
     (assoc output
            (:schema/name entry)
            (:schema/form entry)))
   {}
   (vals latest)))

(defn- require-options
  [options]
  (if (not (map? options))
    (catalog-error "catalog options must be a map"
                   {:options options}))
  (let [unknown
        (vec
         (filter (fn [key]
                   (not (has? +option-keys+ key)))
                 (keys options)))]
    (if (not (empty? unknown))
      (catalog-error "unsupported catalog options"
                     {:options unknown}))
    options))

(defn- require-parents
  [parents]
  (let [parents (vec parents)]
    (if (every? catalog? parents)
      parents
      (catalog-error "catalog parents must be catalogs"
                     {:parents parents}))))

(defn- make-registry
  [latest options parents]
  (registry/registry
   (registry-entry-map latest)
   {:namespace (get options :namespace nil)
    :aliases (get options :aliases {})
    :refers (get options :refers {})
    :parents
    (vec
     (map (fn [parent] (:catalog/registry parent))
          parents))}))

(defn- canonical-entry
  [entry registry-value]
  (let [ast (schema/normalize-with (:schema/form entry) registry-value)
        computed (codec/hash-ast (:schema/id entry)
                                 (:schema/version entry)
                                 ast)
        supplied (get entry :schema/hash nil)]
    (if (and supplied (not= supplied computed))
      (catalog-error "schema hash does not match canonical content"
                     {:schema/id (:schema/id entry)
                      :schema/version (:schema/version entry)
                      :schema/hash supplied
                      :schema/expected-hash computed}))
    (assoc entry
           :schema/entry-type +entry-type+
           :schema/ast ast
           :schema/hash computed)))

(declare lookup)

(defn- parent-conflict
  [parents entry]
  (loop [remaining parents]
    (if (empty? remaining)
      nil
      (let [parent-entry
            (lookup (first remaining)
                    (:schema/id entry)
                    (:schema/version entry))]
        (cond
          (nil? parent-entry)
          (recur (rest remaining))

          (= (:schema/hash parent-entry)
             (:schema/hash entry))
          (recur (rest remaining))

          :else parent-entry)))))

(defn- exact-entry-map
  [entries]
  (reduce
   (fn [output entry]
     (assoc output (coordinate-key entry) entry))
   {}
   entries))

(defn- local-latest-map
  [entries]
  (reduce
   (fn [output entry]
     (let [identity (:schema/id entry)
           version (:schema/version entry)
           current (get output identity nil)]
       (if (or (nil? current) (> version current))
         (assoc output identity version)
         output)))
   {}
   entries))

(defn- identity-for
  [catalog target]
  (cond
    (qualified-keyword? target)
    target

    (keyword? target)
    (name-identity
     (registry/qualify
      (:catalog/registry catalog)
      (symbol (name target))))

    (symbol? target)
    (name-identity
     (registry/qualify (:catalog/registry catalog) target))

    :else
    (catalog-error "catalog lookup expects a schema keyword or symbol"
                   {:target target})))

(defn- local-exact
  [catalog identity version]
  (get (:catalog/entries catalog)
       [identity version]
       nil))

(defn- lookup-exact
  [catalog identity version]
  (or
   (local-exact catalog identity version)
   (loop [remaining (:catalog/parents catalog)]
     (if (empty? remaining)
       nil
       (let [found (lookup (first remaining) identity version)]
         (if found
           found
           (recur (rest remaining))))))))

(defn- newer-entry
  [current candidate]
  (cond
    (nil? candidate) current
    (nil? current) candidate
    (> (:schema/version candidate)
       (:schema/version current))
    candidate
    :else current))

(defn- lookup-latest
  [catalog identity]
  (let [local-version (get (:catalog/latest catalog) identity nil)
        local-entry (if local-version
                      (local-exact catalog identity local-version)
                      nil)]
    (loop [remaining (:catalog/parents catalog)
           output local-entry]
      (if (empty? remaining)
        output
        (recur
         (rest remaining)
         (newer-entry output
                      (lookup (first remaining) identity)))))))

(defn ^{:schema [:function
                 [:fn [:any :any] :any]
                 [:fn [:any :any :int] :any]]}
  lookup
  "Looks up the latest or an exact immutable schema entry."
  ([catalog target]
   (let [catalog (ensure catalog)
         identity (identity-for catalog target)]
     (lookup-latest catalog identity)))
  ([catalog target version]
   (let [catalog (ensure catalog)
         identity (identity-for catalog target)
         version (require-version version)]
     (lookup-exact catalog identity version))))

(defn ^{:schema [:function
                 [:fn [:any :any] :map]
                 [:fn [:any :any :int] :map]]}
  require-entry
  "Returns a catalog entry or throws a structured unresolved-coordinate error."
  ([catalog target]
   (or (lookup catalog target)
       (catalog-error "schema identity is absent from catalog"
                      {:schema/id target})))
  ([catalog target version]
   (or (lookup catalog target version)
       (catalog-error "schema coordinate is absent from catalog"
                      {:schema/id target
                       :schema/version version}))))

(defn ^{:schema [:fn [:any] :any]}
  schema-registry
  "Returns the structural registry used by catalog resolution."
  [catalog]
  (:catalog/registry (ensure catalog)))

(defn ^{:schema [:fn [:any] :vector]}
  parents
  "Returns ordered parent catalogs."
  [catalog]
  (:catalog/parents (ensure catalog)))

(defn- local-coordinates
  [catalog]
  (vec
   (sort-by str (keys (:catalog/entries catalog)))))

(defn ^{:schema [:fn [:any] :vector]}
  coordinates
  "Returns visible exact coordinates in deterministic precedence order."
  [catalog]
  (let [catalog (ensure catalog)]
    (loop [remaining (:catalog/parents catalog)
           output (local-coordinates catalog)]
      (if (empty? remaining)
        output
        (recur (rest remaining)
               (append-values output
                              (coordinates (first remaining))))))))

(defn ^{:schema [:fn [:any] :vector]}
  entries
  "Returns visible catalog entries in deterministic coordinate order."
  [catalog]
  (let [catalog (ensure catalog)]
    (vec
     (keep
      (fn [key]
        (lookup catalog (first key) (second key)))
      (coordinates catalog)))))

(defn- direct-dependencies
  [catalog entry]
  (loop [remaining (schema/reference-names (:schema/ast entry))
         output []]
    (if (empty? remaining)
      output
      (let [reference (first remaining)
            target (lookup catalog reference)]
        (if (nil? target)
          (catalog-error "catalog schema reference is unresolved"
                         {:schema/id (:schema/id entry)
                          :schema/version (:schema/version entry)
                          :reference reference})
          (recur (rest remaining)
                 (append-unique output (coordinate target))))))))

(defn- attach-dependencies
  [catalog]
  (let [updated
        (reduce
         (fn [output entry]
           (assoc output
                  (coordinate-key entry)
                  (assoc entry
                         :schema/dependencies
                         (direct-dependencies catalog entry))))
         {}
         (vals (:catalog/entries catalog)))]
    (assoc catalog :catalog/entries updated)))

(defn- alias-cycle?
  [catalog start]
  (loop [entry start
         visiting #{}]
    (let [key (coordinate-key entry)]
      (cond
        (has? visiting key)
        true

        (not= :reference (:kind (:schema/ast entry)))
        false

        :else
        (let [dependency (first (:schema/dependencies entry))
              next-entry
              (if dependency
                (lookup catalog
                        (:schema/id dependency)
                        (:schema/version dependency))
                nil)]
          (if next-entry
            (recur next-entry (conj visiting key))
            false))))))

(defn- assert-no-alias-cycles
  [catalog]
  (loop [remaining (vals (:catalog/entries catalog))]
    (if (empty? remaining)
      catalog
      (let [entry (first remaining)]
        (if (alias-cycle? catalog entry)
          (catalog-error "schema catalog contains an alias-only cycle"
                         {:schema/id (:schema/id entry)
                          :schema/version (:schema/version entry)})
          (recur (rest remaining)))))))

(defn ^{:schema [:function
                 [:fn [:any] :map]
                 [:fn [:any :map] :map]]}
  catalog
  "Creates an immutable executable catalog of identified schema versions.

   Entries carry :schema/id, :schema/version, and :schema/form. Hashes are
   computed over identity, version, and the canonical normalized AST. Named
   references are pinned to exact visible coordinates in :schema/dependencies."
  ([entries]
   (catalog entries {}))
  ([entries options]
   (let [options (require-options options)
         parents (require-parents (get options :parents []))
         specs (unique-entry-specs (entry-specs entries))
         latest (latest-specs specs)
         registry-value (make-registry latest options parents)
         canonical (vec (map (fn [entry]
                               (canonical-entry entry registry-value))
                             specs))]
     (loop [remaining canonical]
       (if (empty? remaining)
         nil
         (let [entry (first remaining)
               conflict (parent-conflict parents entry)]
           (if conflict
             (catalog-error "schema coordinate conflicts with a parent catalog"
                            {:schema/id (:schema/id entry)
                             :schema/version (:schema/version entry)
                             :schema/hash (:schema/hash entry)
                             :schema/parent-hash (:schema/hash conflict)}))
           (recur (rest remaining)))))
     (let [value
           {:catalog/type +catalog-type+
            :catalog/registry registry-value
            :catalog/entries (exact-entry-map canonical)
            :catalog/latest (local-latest-map canonical)
            :catalog/parents parents}]
       (assert-no-alias-cycles
        (attach-dependencies value))))))

(defn ^{:schema [:function
                 [:fn [:any :any] :any]
                 [:fn [:any :any :int] :any]]}
  resolve
  "Returns an entry with its recursively resolved structural AST."
  ([catalog target]
   (let [catalog (ensure catalog)
         entry (lookup catalog target)]
     (if entry
       (assoc entry
              :schema/resolved
              (schema/resolve-recursive
               (:schema/ast entry)
               (:catalog/registry catalog)))
       nil)))
  ([catalog target version]
   (let [catalog (ensure catalog)
         entry (lookup catalog target version)]
     (if entry
       (assoc entry
              :schema/resolved
              (schema/resolve-recursive
               (:schema/ast entry)
               (:catalog/registry catalog)))
       nil))))

(defn- dependency-entry
  [catalog coordinate]
  (lookup catalog
          (:schema/id coordinate)
          (:schema/version coordinate)))

(defn- walk-dependencies
  [catalog entry state]
  (let [key (coordinate-key entry)
        visiting (conj (:visiting state) key)
        state (assoc state :visiting visiting)]
    (loop [remaining (:schema/dependencies entry)
           state state]
      (if (empty? remaining)
        (let [state (assoc state
                           :visiting
                           (disj (:visiting state) key))]
          (assoc state
                 :visited
                 (conj (:visited state) key)))
        (let [dependency (first remaining)
              dependency-key (coordinate-map-key dependency)
              state (assoc state
                           :output
                           (append-unique (:output state) dependency))
              state
              (cond
                (has? (:visiting state) dependency-key)
                (assoc state
                       :recursive
                       (append-unique (:recursive state) dependency))

                (has? (:visited state) dependency-key)
                state

                :else
                (let [next-entry (dependency-entry catalog dependency)]
                  (if next-entry
                    (walk-dependencies catalog next-entry state)
                    state)))]
          (recur (rest remaining) state))))))

(defn ^{:schema [:function
                 [:fn [:any :any] :map]
                 [:fn [:any :any :int] :map]]}
  dependencies
  "Returns deterministic direct, transitive, and recursive exact dependencies."
  ([catalog target]
   (let [catalog (ensure catalog)
         entry (require-entry catalog target)
         state (walk-dependencies
                catalog
                entry
                {:visiting #{}
                 :visited #{}
                 :output []
                 :recursive []})]
     {:schema/coordinate (coordinate entry)
      :dependencies/direct (:schema/dependencies entry)
      :dependencies/transitive (:output state)
      :dependencies/recursive (:recursive state)}))
  ([catalog target version]
   (let [catalog (ensure catalog)
         entry (require-entry catalog target version)
         state (walk-dependencies
                catalog
                entry
                {:visiting #{}
                 :visited #{}
                 :output []
                 :recursive []})]
     {:schema/coordinate (coordinate entry)
      :dependencies/direct (:schema/dependencies entry)
      :dependencies/transitive (:output state)
      :dependencies/recursive (:recursive state)})))

(defn ^{:schema [:fn [:any] :bool]}
  verify-entry
  "Recomputes and verifies one canonical entry hash."
  [entry]
  (and (entry? entry)
       (= (:schema/hash entry)
          (codec/hash-ast (:schema/id entry)
                          (:schema/version entry)
                          (:schema/ast entry)))))

(defn- dependency-valid?
  [catalog dependency]
  (let [entry (dependency-entry catalog dependency)]
    (and entry
         (= (:schema/hash dependency)
            (:schema/hash entry)))))

(defn ^{:schema [:fn [:any] :map]}
  verify
  "Verifies every visible entry hash and exact dependency coordinate."
  [catalog]
  (let [catalog (ensure catalog)
        failures
        (vec
         (mapcat
          (fn [entry]
            (vec
             (concat
              (if (verify-entry entry)
                []
                [{:finding/type :std.typed.catalog/hash-mismatch
                  :schema/coordinate (coordinate entry)}])
              (map
               (fn [dependency]
                 {:finding/type :std.typed.catalog/unresolved-dependency
                  :schema/coordinate (coordinate entry)
                  :schema/dependency dependency})
               (filter
                (fn [dependency]
                  (not (dependency-valid? catalog dependency)))
                (:schema/dependencies entry))))))
          (entries catalog)))]
    {:valid (empty? failures)
     :errors failures}))
