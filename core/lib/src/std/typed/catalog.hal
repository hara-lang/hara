;; Portable identity and exact dependency coordinates for named std.typed schemas.
(ns std.typed.catalog
  (:require [std.typed.registry :as registry]
            [std.typed.schema :as schema]))

(def +catalog-type+ :std.typed.catalog/catalog)
(def +hash-format+ :std.typed.schema/catalog-v1)
(def +semantic-property-keys+
  #{:min-count :max-count :pattern :qualified :distinct
    :closed :optional :status :error-code})
(def +option-keys+ #{:aliases :refers :parents})

(defstruct SchemaCatalog [entries registry dependencies options])

(defn- catalog-error
  [message data]
  (throw
   (ex-info message
            (assoc data :type :std.typed.catalog/invalid-catalog))))

(defn ^{:schema [:fn [:any] :bool]}
  catalog?
  "Returns true when value is an immutable identified schema catalog."
  [value]
  (instance? std.typed.catalog/SchemaCatalog value))

(defn- require-map
  [value label]
  (if (map? value)
    value
    (catalog-error (str label " must be a map")
                   {:label label :value value})))

(defn- canonical-id
  [value]
  (cond
    (and (keyword? value) (namespace value)) value
    (and (symbol? value) (namespace value))
    (keyword (namespace value) (name value))
    :else
    (catalog-error
     ":schema/id must be a qualified keyword or symbol"
     {:schema/id value})))

(defn- id-symbol
  [id]
  (symbol (namespace id) (name id)))

(defn- symbol-id
  [value]
  (if (and (symbol? value) (namespace value))
    (keyword (namespace value) (name value))
    (catalog-error "schema dependency must be a qualified symbol"
                   {:dependency value})))

(defn- require-version
  [value]
  (if (and (integer? value) (>= value 0))
    value
    (catalog-error ":schema/version must be a non-negative integer"
                   {:schema/version value})))

(defn- semantic-properties
  [properties]
  (reduce-kv
   (fn [output key value]
     (if (has? +semantic-property-keys+ key)
       (assoc output key value)
       output))
   {}
   (or properties {})))

(declare semantic-value canonical-value)

(defn- semantic-value
  [value]
  (cond
    (map? value)
    (reduce-kv
     (fn [output key item]
       (if (= key :properties)
         (let [properties (semantic-properties item)]
           (if (empty? properties)
             output
             (assoc output key (semantic-value properties))))
         (assoc output key (semantic-value item))))
     {}
     value)

    (vector? value)
    (vec (map semantic-value value))

    (tuple? value)
    (apply tuple (map semantic-value value))

    (set? value)
    (set (map semantic-value value))

    (list? value)
    (apply list (map semantic-value value))

    :else value))

(defn- canonical-value
  [value]
  (cond
    (map? value)
    [:map
     (vec
      (map
       (fn [entry]
         [(canonical-value (key entry))
          (canonical-value (val entry))])
       (sort-by
        (fn [entry]
          (pr-str (canonical-value (key entry))))
        value)))]

    (vector? value)
    [:vector (vec (map canonical-value value))]

    (tuple? value)
    [:tuple (vec (map canonical-value value))]

    (set? value)
    (let [items (vec (map canonical-value value))]
      [:set (vec (sort-by (fn [item] (pr-str item)) items))])

    (list? value)
    [:list (vec (map canonical-value value))]

    (or (nil? value)
        (boolean? value)
        (string? value)
        (char? value)
        (number? value)
        (keyword? value)
        (symbol? value))
    [:scalar value]

    :else
    (catalog-error
     "schema catalog hash input contains a non-portable value"
     {:value value})))

(defn- canonical-hash
  [id version normalized]
  (let [input
        [+hash-format+
         id
         version
         (canonical-value (semantic-value normalized))]]
    (str "sha256:"
         (crypto/sha256
          (str/encode-utf8 (pr-str input))))))

(defn- require-entry
  [entry]
  (let [entry (require-map entry "schema catalog entry")]
    (if (not (has? entry :schema/id))
      (catalog-error "schema catalog entry requires :schema/id"
                     {:entry entry}))
    (if (not (has? entry :schema/version))
      (catalog-error "schema catalog entry requires :schema/version"
                     {:entry entry}))
    (if (not (has? entry :schema/form))
      (catalog-error "schema catalog entry requires :schema/form"
                     {:entry entry}))
    (assoc entry
           :schema/id (canonical-id (:schema/id entry))
           :schema/version (require-version (:schema/version entry)))))

(defn- group-entries
  [entries]
  (reduce
   (fn [output raw-entry]
     (let [entry (require-entry raw-entry)
           id (:schema/id entry)
           version (:schema/version entry)
           versions (get output id {})]
       (if (has? versions version)
         (catalog-error "duplicate schema catalog id/version"
                        {:schema/id id :schema/version version}))
       (assoc output id (assoc versions version entry))))
   {}
   entries))

(defn- latest-entry
  [versions]
  (reduce
   (fn [selected entry]
     (if (or (nil? selected)
             (> (:schema/version entry) (:schema/version selected)))
       entry
       selected))
   nil
   (vals versions)))

(defn- latest-forms
  [grouped]
  (reduce-kv
   (fn [output id versions]
     (assoc output
            (id-symbol id)
            (:schema/form (latest-entry versions))))
   {}
   grouped))

(defn- require-options
  [options]
  (let [options (require-map options "schema catalog options")
        unknown
        (vec
         (filter (fn [key] (not (has? +option-keys+ key)))
                 (keys options)))]
    (if (not (empty? unknown))
      (catalog-error "unsupported schema catalog options"
                     {:options unknown}))
    options))

(defn- entry-registry
  [base options id]
  (registry/registry
   {}
   {:namespace (symbol (namespace id))
    :aliases (get options :aliases {})
    :refers (get options :refers {})
    :parents
    (vec
     (concat [base]
             (get options :parents [])))}))

(defn- hash-entry
  [base options entry]
  (let [normalized
        (schema/normalize-with
         (:schema/form entry)
         (entry-registry base options (:schema/id entry)))
        hash
        (canonical-hash (:schema/id entry)
                        (:schema/version entry)
                        normalized)
        supplied (get entry :schema/hash nil)]
    (if (and supplied (not= supplied hash))
      (catalog-error "supplied :schema/hash does not match canonical schema"
                     {:schema/id (:schema/id entry)
                      :schema/version (:schema/version entry)
                      :schema/hash supplied
                      :schema/expected-hash hash}))
    (assoc entry
           :schema/hash hash
           :schema/coordinate
           [:schema (:schema/id entry) (:schema/version entry) hash]
           :schema/normal normalized)))

(defn- hash-entries
  [base options grouped]
  (reduce-kv
   (fn [output id versions]
     (assoc
      output id
      (reduce-kv
       (fn [version-output version entry]
         (assoc version-output version (hash-entry base options entry)))
       {}
       versions)))
   {}
   grouped))

(defn- exact-entry
  [grouped id version]
  (get (get grouped (canonical-id id) {}) (require-version version)))

(defn- coordinate-entry
  [grouped coordinate]
  (if (and (vector? coordinate)
           (= 4 (count coordinate))
           (= :schema (first coordinate)))
    (let [entry (exact-entry grouped (second coordinate) (nth coordinate 2))]
      (if (and entry (= (:schema/hash entry) (nth coordinate 3)))
        entry
        nil))
    nil))

(defn- dependency-coordinate
  [grouped reference owner]
  (let [id (symbol-id reference)
        versions (get grouped id nil)
        target (if versions (latest-entry versions) nil)]
    (if target
      (:schema/coordinate target)
      (catalog-error "identified schema dependency is not in the catalog"
                     {:schema/id (:schema/id owner)
                      :schema/version (:schema/version owner)
                      :dependency reference}))))

(defn- dependency-index
  [grouped]
  (reduce-kv
   (fn [output _ versions]
     (reduce-kv
      (fn [version-output _ entry]
        (let [references (schema/reference-names (:schema/normal entry))
              dependencies
              (set
               (map (fn [reference]
                      (dependency-coordinate grouped reference entry))
                    references))]
          (assoc version-output (:schema/coordinate entry) dependencies)))
      output
      versions))
   {}
   grouped))

(defn ^{:schema [:function
                 [:fn [:vector] :any]
                 [:fn [:vector :map] :any]]}
  catalog
  "Creates an immutable catalog of identified schema entries.

   Each entry requires qualified :schema/id, non-negative :schema/version, and
   :schema/form. Hashes are SHA-256 over a versioned canonical semantic form.
   References are qualified in the entry's own namespace and pinned to exact
   catalog coordinates."
  ([entries]
   (catalog entries {}))
  ([entries options]
   (let [entries (if (vector? entries)
                   entries
                   (catalog-error "schema catalog entries must be a vector"
                                  {:entries entries}))
         options (require-options options)
         raw-grouped (group-entries entries)
         base (registry/registry (latest-forms raw-grouped))
         grouped (hash-entries base options raw-grouped)
         dependencies (dependency-index grouped)
         visible-registry
         (registry/composite
          (vec
           (concat [base]
                   (get options :parents []))))]
     (std.typed.catalog/SchemaCatalog
      grouped visible-registry dependencies options))))

(defn ^{:schema [:function
                 [:fn [:any :any] :any]
                 [:fn [:any :any :int] :any]]}
  lookup
  "Returns the latest entry for id, or an exact version when supplied."
  ([catalog-value id]
   (let [catalog-value
         (if (catalog? catalog-value)
           catalog-value
           (catalog-error "lookup expects a schema catalog"
                          {:catalog catalog-value}))
         versions (get (:entries catalog-value) (canonical-id id) nil)]
     (if versions (latest-entry versions) nil)))
  ([catalog-value id version]
   (if (not (catalog? catalog-value))
     (catalog-error "lookup expects a schema catalog"
                    {:catalog catalog-value}))
   (exact-entry (:entries catalog-value) id version)))

(defn ^{:schema [:fn [:any :any :int] :vector]}
  coordinate
  "Returns the exact [kind id version hash] coordinate for a catalog entry."
  [catalog-value id version]
  (let [entry (lookup catalog-value id version)]
    (if entry
      (:schema/coordinate entry)
      (catalog-error "schema catalog coordinate is unresolved"
                     {:schema/id id :schema/version version}))))

(defn ^{:schema [:fn [:any :vector] :any]}
  resolve
  "Resolves an exact schema coordinate, rejecting stale or mismatched hashes."
  [catalog-value schema-coordinate]
  (if (not (catalog? catalog-value))
    (catalog-error "resolve expects a schema catalog"
                   {:catalog catalog-value}))
  (let [entry (coordinate-entry (:entries catalog-value) schema-coordinate)]
    (if entry
      entry
      (catalog-error "schema catalog coordinate is unresolved"
                     {:schema/coordinate schema-coordinate}))))

(defn ^{:schema [:fn [:any] :map]}
  schema-registry
  "Returns the ordinary registry view used for existing symbol references."
  [catalog-value]
  (if (catalog? catalog-value)
    (:registry catalog-value)
    (catalog-error "schema-registry expects a schema catalog"
                   {:catalog catalog-value})))

(defn ^{:schema [:fn [:any :vector] :vector]}
  dependencies
  "Returns deterministic direct exact dependency coordinates."
  [catalog-value schema-coordinate]
  (if (not (catalog? catalog-value))
    (catalog-error "dependencies expects a schema catalog"
                   {:catalog catalog-value}))
  (vec
   (sort-by
    (fn [coordinate-value] (pr-str coordinate-value))
    (get (:dependencies catalog-value) schema-coordinate #{}))))

(extend-type SchemaCatalog IDeps
  (dep-get [catalog-value schema-coordinate]
    (coordinate-entry (:entries catalog-value) schema-coordinate))
  (dep-entries [catalog-value schema-coordinate]
    (get (:dependencies catalog-value) schema-coordinate #{}))
  (dep-keys [catalog-value]
    (vec
     (sort-by
      (fn [schema-coordinate] (pr-str schema-coordinate))
      (keys (:dependencies catalog-value))))))
