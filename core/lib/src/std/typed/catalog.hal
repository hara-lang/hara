(ns std.typed.catalog
  (:require [std.typed.catalog.base]
            [std.typed.catalog.codec]
            [std.typed.catalog.graph]))

(def +catalog-type+ std.typed.catalog.base/+catalog-type+)
(def +entry-type+ std.typed.catalog.base/+entry-type+)

(def entry? std.typed.catalog.base/entry?)
(def catalog? std.typed.catalog.base/catalog?)
(def ensure std.typed.catalog.base/ensure)
(def coordinate std.typed.catalog.base/coordinate)
(def lookup std.typed.catalog.base/lookup)
(def require-entry std.typed.catalog.base/require-entry)
(def schema-registry std.typed.catalog.base/schema-registry)
(def parents std.typed.catalog.base/parents)
(def coordinates std.typed.catalog.base/coordinates)
(def entries std.typed.catalog.base/entries)
(def resolve std.typed.catalog.base/resolve)

(def dependencies std.typed.catalog.graph/dependencies)
(def verify-entry std.typed.catalog.graph/verify-entry)
(def verify std.typed.catalog.graph/verify)

(def canonical-value std.typed.catalog.codec/canonical-value)
(def hash-ast std.typed.catalog.codec/hash-ast)
(def content-hash std.typed.catalog.codec/content-hash)

(defn ^{:schema [:function
                 [:fn [:any] :map]
                 [:fn [:any :map] :map]]}
  catalog
  "Creates an immutable executable catalog around the canonical anonymous schema AST."
  ([entries]
   (std.typed.catalog.graph/link
    (std.typed.catalog.base/catalog entries)))
  ([entries options]
   (std.typed.catalog.graph/link
    (std.typed.catalog.base/catalog entries options))))
