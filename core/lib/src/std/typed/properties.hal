;; Portable Malli-style schema properties layered on std.typed.schema's
;; extensible normalization and validation ABI.
(ns std.typed.properties
  (:require [std.typed.schema :as schema]))

(defn- invalid-value
  [path expected value]
  {:finding/type :std.typed.schema/invalid-value
   :finding/path (vec path)
   :finding/expected expected
   :finding/value value})

(defn- property-finding
  [path expected value constraint property-value]
  {:finding/type :std.typed.schema/property-violation
   :finding/path (vec path)
   :finding/expected expected
   :finding/value value
   :finding/context
   {:constraint constraint
    :expected property-value}})

(defn- missing-key-finding
  [path field]
  (let [key (:name field)]
    {:finding/type :std.typed.schema/missing-key
     :finding/path (conj (vec path) key)
     :finding/expected (:type field)
     :finding/value nil
     :finding/context
     {:present? false
      :constraint :required
      :key key
      :parent-path (vec path)}}))

(defn- closed-key-finding
  [path expected key value]
  {:finding/type :std.typed.schema/closed-map-key
   :finding/path (conj (vec path) key)
   :finding/expected expected
   :finding/value value
   :finding/context
   {:constraint :closed
    :key key}})

(defn- qualified-keyword?
  [value]
  (and (keyword? value)
       (str/includes? (str value) "/")))

(defn- value-count
  [value]
  (cond
    (string? value) (str/length value)
    (or (vector? value)
        (set? value)
        (map? value)
        (list? value))
    (count value)
    :else nil))

(defn- distinct-values?
  [value]
  (if (or (vector? value) (list? value))
    (apply distinct? (vec value))
    true))

(defn- validate-properties
  [expected value path properties]
  (let [count-value (value-count value)
        min-count (:min-count properties)
        max-count (:max-count properties)
        pattern (:pattern properties)
        qualified (:qualified properties)
        distinct (:distinct properties)]
    (vec
     (concat
      (if (and min-count count-value (< count-value min-count))
        [(property-finding path expected value :min-count min-count)]
        [])
      (if (and max-count count-value (> count-value max-count))
        [(property-finding path expected value :max-count max-count)]
        [])
      (if (and pattern
               (string? value)
               (not (re-matches pattern value)))
        [(property-finding path expected value :pattern pattern)]
        [])
      (if (and (= true qualified)
               (not (qualified-keyword? value)))
        [(property-finding path expected value :qualified true)]
        [])
      (if (and (= true distinct)
               (not (distinct-values? value)))
        [(property-finding path expected value :distinct true)]
        [])))))

(defn- ensure-properties
  [kind properties allowed]
  (let [unknown
        (vec
         (filter (fn [key]
                   (not (has? allowed key)))
                 (keys properties)))]
    (if (empty? unknown)
      properties
      (throw
       (ex-info
        (str "unsupported " kind " schema property")
        {:kind kind :properties unknown})))))

(defn- rebase-finding
  [path finding]
  (assoc finding
         :finding/path
         (vec
          (concat path
                  (or (:finding/path finding) [])))))

(defn- validate-at
  [schema-value value path registry-value]
  (let [findings
        (if registry-value
          (schema/validate schema-value value registry-value)
          (schema/validate schema-value value))]
    (vec
     (map (fn [finding]
            (rebase-finding path finding))
          findings))))

(defn- normalize-field
  [field]
  (cond
    (map? field)
    {:name (:name field)
     :properties
     (ensure-properties
      :map-entry
      (or (:properties field) {})
      #{:optional})
     :type (schema/normalize (:type field))}

    (and (vector? field) (= 2 (count field)))
    {:name (first field)
     :properties {}
     :type (schema/normalize (second field))}

    (and (vector? field)
         (= 3 (count field))
         (map? (second field)))
    {:name (first field)
     :properties
     (ensure-properties :map-entry (second field) #{:optional})
     :type (schema/normalize (nth field 2))}

    :else
    (throw
     (ex-info
      "map schema entries must be [key schema] or [key properties schema]"
      {:entry field}))))

(defn- custom-field?
  [field]
  (not (empty? (:properties field))))

(defn- plain-field
  [field]
  {:name (:name field)
   :type (:type field)})

(defmethod schema/normalize :map
  [surface]
  (let [arguments (vec (rest surface))
        property-form? (and (not (empty? arguments))
                            (map? (first arguments)))
        properties
        (ensure-properties
         :map
         (if property-form? (first arguments) {})
         #{:closed :min-count :max-count})
        fields
        (vec
         (map normalize-field
              (if property-form?
                (rest arguments)
                arguments)))]
    (if (or (not (empty? properties))
            (any? custom-field? fields))
      {:kind :std.typed/map
       :registry schema/*registry*
       :properties properties
       :fields fields}
      {:kind :map
       :fields (vec (map plain-field fields))})))

(defmethod schema/normalize :vector
  [surface]
  (let [arguments (vec (rest surface))
        property-form? (and (not (empty? arguments))
                            (map? (first arguments)))
        properties
        (ensure-properties
         :vector
         (if property-form? (first arguments) {})
         #{:min-count :max-count :distinct})
        item-form
        (if property-form?
          (if (> (count arguments) 1) (second arguments) :any)
          (first arguments))]
    (if property-form?
      {:kind :std.typed/vector
       :registry schema/*registry*
       :properties properties
       :item (schema/normalize item-form)}
      {:kind :vector
       :item (schema/normalize item-form)})))

(defmethod schema/normalize :set
  [surface]
  (let [arguments (vec (rest surface))
        property-form? (and (not (empty? arguments))
                            (map? (first arguments)))
        properties
        (ensure-properties
         :set
         (if property-form? (first arguments) {})
         #{:min-count :max-count :distinct})
        item-form
        (if property-form?
          (if (> (count arguments) 1) (second arguments) :any)
          (if (empty? arguments) :any (first arguments)))]
    {:kind :std.typed/set
     :registry schema/*registry*
     :properties properties
     :item (schema/normalize item-form)}))

(defn- normalize-primitive-properties
  [surface]
  (if (and (= 2 (count surface))
           (map? (second surface)))
    {:kind :std.typed/refine
     :registry schema/*registry*
     :base (schema/normalize (first surface))
     :properties
     (ensure-properties
      (first surface)
      (second surface)
      #{:min-count :max-count :pattern :qualified :distinct})}
    (throw
     (ex-info
      "primitive property schema expects one property map"
      {:schema surface}))))

(defmethod schema/normalize :str [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :string [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :keyword [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :symbol [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :list [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :bytes [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :int [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :integer [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :num [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :number [surface]
  (normalize-primitive-properties surface))
(defmethod schema/normalize :any [surface]
  (normalize-primitive-properties surface))

(defmethod schema/validate-normal :std.typed/refine
  [expected value path]
  (let [base-findings
        (validate-at (:base expected)
                     value
                     path
                     (:registry expected))]
    (if (empty? base-findings)
      (validate-properties expected value path (:properties expected))
      base-findings)))

(defn- validate-items
  [expected item values path registry-value]
  (loop [index 0
         values (vec values)
         output []]
    (if (= index (count values))
      output
      (recur
       (inc index)
       values
       (vec
        (concat output
                (validate-at item
                             (nth values index)
                             (conj path index)
                             registry-value)))))))

(defmethod schema/validate-normal :std.typed/vector
  [expected value path]
  (if (vector? value)
    (vec
     (concat
      (validate-properties expected value path (:properties expected))
      (validate-items expected
                      (:item expected)
                      value
                      path
                      (:registry expected))))
    [(invalid-value path expected value)]))

(defmethod schema/validate-normal :std.typed/set
  [expected value path]
  (if (set? value)
    (let [values (vec (sort-by str value))]
      (vec
       (concat
        (validate-properties expected value path (:properties expected))
        (validate-items expected
                        (:item expected)
                        values
                        path
                        (:registry expected)))))
    [(invalid-value path expected value)]))

(defn- field-present?
  [value field]
  (has? value (:name field)))

(defn- field-optional?
  [field]
  (= true (:optional (:properties field))))

(defn- known-field?
  [expected key]
  (any? (fn [field]
          (= key (:name field)))
        (:fields expected)))

(defn- validate-map-fields
  [expected value path]
  (vec
   (mapcat
    (fn [field]
      (let [key (:name field)]
        (cond
          (field-present? value field)
          (validate-at (:type field)
                       (get value key)
                       (conj path key)
                       (:registry expected))

          (field-optional? field)
          []

          :else
          [(missing-key-finding path field)])))
    (:fields expected))))

(defn- validate-closed-map
  [expected value path]
  (if (= true (:closed (:properties expected)))
    (vec
     (mapcat
      (fn [key]
        (if (known-field? expected key)
          []
          [(closed-key-finding path expected key (get value key))]))
      (sort-by str (keys value))))
    []))

(defmethod schema/validate-normal :std.typed/map
  [expected value path]
  (if (map? value)
    (vec
     (concat
      (validate-properties expected value path (:properties expected))
      (validate-map-fields expected value path)
      (validate-closed-map expected value path)))
    [(invalid-value path expected value)]))
