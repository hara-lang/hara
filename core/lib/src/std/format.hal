(ns std.format
  (:require [std.format.common :as common]
            [std.format.table :as table]
            [std.format.report :as report-format]
            [std.format.terminal :as terminal]))

(def line common/line)
(def value-text common/value-text)
(def truncate common/truncate)
(def pad common/pad)

(def table-lines table/table-lines)

(def report-lines report-format/report-lines)

(defn report
  "Renders a report document as plain text by default or ANSI when enabled."
  ([document]
   (report document {}))
  ([document options]
   (terminal/render
    (report-format/report-lines document options)
    options)))

(def render-lines terminal/render-lines)
(def render terminal/render)
(def emit-lines terminal/emit-lines)
