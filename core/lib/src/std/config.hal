(ns std.config
  (:config {:override [resolve load]})
  (:require [std.config.global :as config-global]
            [std.config.resolve :as config-resolve]))

(def load config-resolve/load)
(def resolve config-resolve/resolve)
(def global config-global/global)

(defn get-session
  "Returns portable session overrides."
  []
  (deref config-global/+session+))

(defn swap-session
  "Updates portable session overrides."
  [function & arguments]
  (apply swap! config-global/+session+ function arguments))

(defn clear-session
  "Clears portable session overrides."
  []
  (reset! config-global/+session+ {}))

(def register-directive
  config-resolve/register-directive)

(def register-type
  config-resolve/register-type)
