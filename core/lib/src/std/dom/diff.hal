(ns std.dom.diff
  (:require [std.dom.type :as type]
            [std.dom.common :as dom]))

(defmulti dom-ops
  (fn [tag old-props new-props] (:metaclass (type/metaprops tag))))

(defn diff-list-element [index old new]
  (cond (dom/dom-tags-equal? old new)
        (if (dom/value? old)
          (if (dom/dom-props-equal? (:props old) (:props new))
            nil
            [:list-set index new old])
          (let [ops (dom-ops (:tag old) (:props old) (:props new))]
            (if-not (empty? ops) [:list-update index ops])))

        (= old new) nil
        :else [:list-set index new old]))

(defn diff-list-elements [old new]
  (vec (keep identity (map diff-list-element (range) old new))))

(defn- common-prefix-count [old new]
  (loop [index 0]
    (if (and (< index (count old))
             (< index (count new))
             (dom/dom-equal? (get old index) (get new index)))
      (recur (inc index))
      index)))

(defn- common-suffix-count [old new prefix]
  (loop [suffix-count 0]
    (let [old-index (- (count old) suffix-count 1)
          new-index (- (count new) suffix-count 1)]
      (if (and (>= old-index prefix)
               (>= new-index prefix)
               (dom/dom-equal? (get old old-index) (get new new-index)))
        (recur (inc suffix-count))
        suffix-count))))

(defn- diff-list-splice [old new]
  (let [prefix (common-prefix-count old new)
        suffix (common-suffix-count old new prefix)
        remove-count (- (count old) prefix suffix)
        insert-values (vec (take (- (count new) prefix suffix) (drop prefix new)))]
    (vec (concat (if (> remove-count 0) [[:list-remove prefix remove-count]] [])
                 (if (empty? insert-values) [] [[:list-insert prefix insert-values]])))))

(defn diff-list-dom [old new]
  (if (= (count old) (count new))
    (diff-list-elements old new)
    (diff-list-splice old new)))

(defn diff-list [old new]
  (let [element (first old)]
    (cond (= old new) []
          (and (dom/dom? element) (= (count old) (count new)))
          (diff-list-elements old new)
          :else (diff-list-splice old new))))

(defn diff-props-element [key old new]
  (cond (dom/dom-tags-equal? old new)
        (if (dom/value? old)
          (if (dom/dom-props-equal? (:props old) (:props new))
            nil
            [:set key new old])
          (let [ops (dom-ops (:tag old) (:props old) (:props new))]
            (if-not (empty? ops) [:update key ops])))

        (and (sequential? new) (sequential? old))
        (let [ops (diff-list old new)]
          (if-not (empty? ops) [:update key ops]))

        (= old new) nil
        :else [:set key new old]))

(defn diff-props [old new]
  (let [added (keep (fn [[key value]]
                      (diff-props-element key (get old key) value))
                    new)
        removed (reduce (fn [output [key value]]
                          (conj output [:delete key value]))
                        []
                        (apply dissoc old (keys new)))]
    (vec (concat added removed))))

(defn dom-ops-default [tag old new]
  (if (dom/dom-props-equal? old new) [] (diff-props old new)))

(defmethod dom-ops :default [tag old new]
  (dom-ops-default tag old new))

(defn dom-diff [old new]
  (cond (dom/dom-tags-equal? old new)
        (if (dom/value? old)
          (if (dom/dom-props-equal? (:props old) (:props new))
            []
            [[:replace new old]])
          (dom-ops (:tag old) (:props old) (:props new)))
        :else [[:replace new old]]))
