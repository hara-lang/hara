(ns work.provider.inline
  (:require [work.provider.profile :as profile]
            [work.base.execution :as execution]))

(defn inline-executor
  ([]
   (inline-executor {}))
  ([handlers]
   (execution/normalise-provider
    (profile/baseline
     {:provider/role :work/executor
      :provider/id :inline
      :provider/capabilities #{:synchronous :sequential :cleanup}
      :provider/operations {:execute execution/execute-node}
      :provider/handlers
      (merge execution/default-handlers
             (or handlers {}))}))))
