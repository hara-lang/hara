(ns work.agent.algebra)

;; Agent operations are Work extension values. They are interpreted by
;; work.agent providers and preserve the normal Work execution model.

(defn request
  [agent request]
  {:op :agent/request
   :agent agent
   :request request})

(defn delegate
  [from to task]
  {:op :agent/delegate
   :agent/from from
   :agent/to to
   :task task})

(defn await
  [reference]
  {:op :agent/await
   :reference reference})

(defn message
  [from to content]
  {:op :agent/message
   :agent/from from
   :agent/to to
   :content content})

(defn complete
  [reference result]
  {:op :agent/complete
   :reference reference
   :result result})

(defn review
  [reviewer reference decision]
  {:op :agent/review
   :reviewer reviewer
   :reference reference
   :decision decision})
