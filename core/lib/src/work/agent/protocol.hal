(ns work.agent.protocol)

;; Agent is intentionally data-first. These protocols are capability boundaries,
;; not an agent object model.

(defprotocol IAgent
  (agent-id [agent])
  (agent-profile [agent])
  (agent-capabilities [agent]))

(defprotocol IAgentCoordinator
  (agent-submit [coordinator command])
  (agent-query [coordinator query]))

(defprotocol IAgentAuthority
  (agent-sign [authority envelope])
  (agent-verify [authority envelope])
  (agent-authorize [authority request]))

(defn agent?
  [value]
  (satisfies? IAgent value))
