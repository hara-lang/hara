(ns work.agent.driver.openai
  (:require [work.base :as work]
            [work.agent.protocol :as protocol]
            [work.agent.openai :as openai]
            [work.agent.tool :as agent-tool]))

(defstruct OpenAIDriver [options])

(defn- failed-limit
  [message data]
  (throw (ex :limit data :ex/message message)))

(defn turn-id
  [agent-id turn suffix]
  [:agent/openai agent-id :turn turn suffix])

(declare turn-work)

(defn next-turn-work
  [configuration agent-id input response turn tool-count values]
  (let [outputs (openai/tool-output-items values)
        next-input
        (into input
              (concat (:response/output response)
                      outputs))]
    (turn-work configuration
               agent-id
               next-input
               turn
               tool-count)))

(defn tool-round-work
  [configuration agent-id input response turn tool-count calls]
  (let [call-works
        (agent-tool/call-works (:tool-index configuration) calls)
        tools
        (work/all
         {:id (turn-id agent-id turn :tools)}
         call-works)]
    (work/bind
     {:id (turn-id agent-id turn :tool-round)}
     tools
     (work/pure
      {:id (turn-id agent-id turn :after-tools)}
      (fn [values context]
        (next-turn-work configuration
                        agent-id
                        input
                        response
                        turn
                        tool-count
                        values))))))

(defn response-work
  [configuration agent-id input response turn tool-count]
  (let [calls (:response/tool-calls response)
        next-turn (inc turn)
        next-tool-count (+ tool-count (count calls))
        maximum-turns (:max-turns configuration)
        maximum-tool-calls (:max-tool-calls configuration)]
    (cond
      (> next-turn maximum-turns)
      (failed-limit
       "Agent turn limit reached"
       {:agent/turn next-turn
        :agent/max-turns maximum-turns})

      (> next-tool-count maximum-tool-calls)
      (failed-limit
       "Agent tool-call limit reached"
       {:agent/tool-calls next-tool-count
        :agent/max-tool-calls maximum-tool-calls})

      (empty? calls)
      (work/pure
       {:id (turn-id agent-id turn :result)}
       (fn [response-value context]
         (:response/text response-value)))

      :else
      (tool-round-work configuration
                       agent-id
                       input
                       response
                       next-turn
                       next-tool-count
                       calls))))

(defn model-step
  [configuration agent-id input turn]
  (work/step
   {:id (turn-id agent-id turn :model)}
   (fn [ignored context]
     (if (>= turn (:max-turns configuration))
       (failed-limit
        "Agent turn limit reached"
        {:agent/turn turn
         :agent/max-turns (:max-turns configuration)}))
     (openai/complete
      (:client configuration)
      {:instructions (:instructions configuration)
       :tools (:tools configuration)
       :input input
       :request (:request configuration)}))))

(defn turn-work
  [configuration agent-id input turn tool-count]
  (work/bind
   {:id (turn-id agent-id turn :interaction)}
   (model-step configuration agent-id input turn)
   (work/pure
    {:id (turn-id agent-id turn :response)}
    (fn [response context]
      (response-work configuration
                     agent-id
                     input
                     response
                     turn
                     tool-count)))))

(defn- configuration
  [driver agent]
  (let [options (merge (:options driver)
                       (or (:agent/openai agent) {}))
        client (:client options)
        tools (agent-tool/normalize-all (:tools options))]
    (if (nil? client)
      (throw
       (ex :dependency {:agent/id (:agent/id agent)}
           :ex/message "OpenAI agent driver requires a client")))
    {:client client
     :instructions (:instructions options)
     :tools tools
     :tool-index (agent-tool/index tools)
     :request (or (:request options) {})
     :max-turns (or (:max-turns options) 8)
     :max-tool-calls (or (:max-tool-calls options) 32)}))

(extend-type OpenAIDriver protocol/IAgentDriver
  (agent-drive [driver agent intent context]
    (let [configuration (configuration driver agent)]
      (turn-work configuration
                 (:agent/id agent)
                 [(openai/input-message intent)]
                 0
                 0))))

(defn driver
  ([]
   (driver {}))
  ([options]
   (work.agent.driver.openai/OpenAIDriver (or options {}))))
