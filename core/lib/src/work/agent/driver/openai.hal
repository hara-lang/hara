(ns work.agent.driver.openai
  (:require [work.base :as work]
            [work.agent.protocol :as protocol]
            [work.agent.openai :as openai]
            [work.agent.result :as result]
            [work.agent.tool :as agent-tool]))

(defstruct OpenAIDriver [options])

(defn- failed-limit
  [message data]
  (throw (ex-info message data)))

(declare run-turn)

(defn- continue-after-tools
  [configuration input response turn tool-count calls]
  (result/then
   (agent-tool/invoke-all (:tool-index configuration) calls)
   (fn [values]
     (let [outputs (openai/tool-output-items values)]
       (run-turn configuration
                 (into input (concat (:response/output response) outputs))
                 turn
                 tool-count)))))

(defn- process-response
  [configuration input response turn tool-count]
  (let [calls (:response/tool-calls response)
        next-turn (inc turn)
        next-tool-count (+ tool-count (count calls))
        maximum-turns (:max-turns configuration)
        maximum-tool-calls (:max-tool-calls configuration)]
    (cond
      (> next-turn maximum-turns)
      (failed-limit
       "Agent turn limit reached"
       {:agent/turn next-turn
        :agent/max-turns maximum-turns})

      (> next-tool-count maximum-tool-calls)
      (failed-limit
       "Agent tool-call limit reached"
       {:agent/tool-calls next-tool-count
        :agent/max-tool-calls maximum-tool-calls})

      (empty? calls)
      (:response/text response)

      :else
      (continue-after-tools configuration
                            input
                            response
                            next-turn
                            next-tool-count
                            calls))))

(defn- run-turn
  [configuration input turn tool-count]
  (if (>= turn (:max-turns configuration))
    (failed-limit
     "Agent turn limit reached"
     {:agent/turn turn
      :agent/max-turns (:max-turns configuration)}))
  (result/then
   (openai/complete
    (:client configuration)
    {:instructions (:instructions configuration)
     :tools (:tools configuration)
     :input input
     :request (:request configuration)})
   (fn [response]
     (process-response configuration input response turn tool-count))))

(defn- configuration
  [driver agent]
  (let [options (merge (:options driver)
                       (or (:agent/openai agent) {}))
        client (:client options)
        tools (agent-tool/normalize-all (:tools options))]
    (if (nil? client)
      (throw
       (ex-info "OpenAI agent driver requires a client"
                {:agent/id (:agent/id agent)})))
    {:client client
     :instructions (:instructions options)
     :tools tools
     :tool-index (agent-tool/index tools)
     :request (or (:request options) {})
     :max-turns (or (:max-turns options) 8)
     :max-tool-calls (or (:max-tool-calls options) 32)}))

(extend-type OpenAIDriver protocol/IWorkAgentDriver
  (agent-drive [driver agent intent context]
    (let [configuration (configuration driver agent)]
      (work/step
       {:id [:agent/openai (:agent/id agent)]}
       (fn [input work-context]
         (run-turn configuration
                   [(openai/input-message intent)]
                   0
                   0))))))

(defn driver
  ([]
   (driver {}))
  ([options]
   (work.agent.driver.openai/OpenAIDriver (or options {}))))
