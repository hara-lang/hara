(ns work.agent.tool
  (:require [work.base :as work]
            [work.agent.result :as result]))

(defn tool
  "Creates one callable agent tool.

   Names use the OpenAI function-name form. Parameters are a JSON Schema map.
   Pure tool implementations receive decoded arguments and return a value.
   Non-pure tool implementations are Work factories: they receive decoded
   arguments and must return stable, explicitly identified IWork."
  ([name description parameters invoke]
   (tool name description parameters invoke {}))
  ([name description parameters invoke options]
   {:tool/name name
    :tool/description description
    :tool/parameters parameters
    :tool/strict (not (= false (:strict options)))
    :tool/effect (or (:effect options) :pure)
    :tool/invoke invoke}))

(defn normalize
  "Validates one tool and fills its optional fields."
  [value]
  (let [name (:tool/name value)
        description (:tool/description value)
        parameters (:tool/parameters value)
        invoke (:tool/invoke value)]
    (if (or (not (string? name))
            (= name ""))
      (throw
       (ex :argument {:tool value} :ex/message "Agent tool name must be a non-empty string")))
    (if (not (string? description))
      (throw
       (ex :argument {:tool/name name} :ex/message "Agent tool description must be a string")))
    (if (not (map? parameters))
      (throw
       (ex :serialization {:tool/name name} :ex/message "Agent tool parameters must be a JSON Schema map")))
    (if (not (fn? invoke))
      (throw
       (ex :argument {:tool/name name} :ex/message "Agent tool implementation must be callable")))
    (merge
     {:tool/strict true
      :tool/effect :pure}
     value)))

(defn normalize-all
  "Validates tools and preserves declaration order."
  [tools]
  (vec (map normalize (or tools []))))

(defn index
  "Builds a unique name-to-tool index."
  [tools]
  (reduce
   (fn [output value]
     (let [value (normalize value)
           name (:tool/name value)]
       (if (get output name)
         (throw
          (ex :argument {:tool/name name} :ex/message "Agent tool names must be unique")))
       (assoc output name value)))
   {}
   tools))

(defn openai-spec
  "Converts one tool to the OpenAI Responses function-tool shape.

   Effect metadata controls execution after selection; it does not hide an
   otherwise authorized tool from the model."
  [value]
  (let [value (normalize value)]
    {:type "function"
     :name (:tool/name value)
     :description (:tool/description value)
     :parameters (:tool/parameters value)
     :strict (:tool/strict value)}))

(defn openai-specs
  "Converts tools to OpenAI Responses function-tool definitions."
  [tools]
  (vec (map openai-spec tools)))

(defn- failed-result
  [call code message data]
  {:call/id (:call/id call)
   :tool/name (:tool/name call)
   :tool/status :error
   :tool/error
   (merge
    {:code code
     :message message}
    (or data {}))})

(defn successful-result
  [call output]
  {:call/id (:call/id call)
   :tool/name (:tool/name call)
   :tool/status :ok
   :tool/value output})

(defn- invoke-found
  [value call]
  (if (not= :pure (:tool/effect value))
    (failed-result
     call
     :tool/requires-work
     "Effectful agent tools must lower to Work"
     {:tool/effect (:tool/effect value)})
    (result/attempt
     (fn []
       (result/then
        ((:tool/invoke value) (:call/arguments call))
        (fn [output]
          (successful-result call output))))
     (fn [error]
       (failed-result
        call
        :tool/failed
        (str error)
        {})))))

(defn invoke
  "Invokes one normalized pure model tool call.

   Unknown tools and pure-tool exceptions become structured results returned to
   the model. Effectful tools are not invoked and return `:tool/requires-work`."
  [tool-index call]
  (let [value (get tool-index (:tool/name call))]
    (if (nil? value)
      (failed-result
       call
       :tool/unknown
       "The requested tool is not available"
       {})
      (invoke-found value call))))

(defn invoke-all
  "Invokes pure model tool calls and resolves direct and Promise results together."
  [tool-index calls]
  (result/all
   (map
    (fn [call]
      (invoke tool-index call))
    calls)))

(defn call-id
  [call suffix]
  [:agent/tool (:call/id call) suffix])

(defn unknown-call-work
  [call]
  (work/pure
   {:id (call-id call :unknown)}
   (fn [input context]
     (failed-result
      call
      :tool/unknown
      "The requested tool is not available"
      {}))))

(defn pure-call-work
  [value call]
  (work/pure
   {:id (call-id call :pure)}
   (fn [input context]
     (invoke-found value call))))

(defn effect-work
  [value call]
  (let [produced ((:tool/invoke value) (:call/arguments call))]
    (if (not (satisfies? IWork produced))
      (throw
       (ex :state
           {:work/error :work/agent-tool-not-work
            :tool/name (:tool/name value)
            :tool/effect (:tool/effect value)
            :call/id (:call/id call)}
           :ex/message "Effectful agent tool factory must return Work")))
    (let [spec (work/work-spec produced)]
      (if (nil? (:id spec))
        (throw
         (ex :dependency
             {:work/error :work/agent-tool-unstable-work
              :tool/name (:tool/name value)
              :tool/effect (:tool/effect value)
              :call/id (:call/id call)
              :produced/op (:op spec)}
             :ex/message "Effectful agent tool Work requires a stable :id"))))
    produced))

(defn effect-call-work
  [value call]
  (let [produced (effect-work value call)]
    (work/chain
     {:id (call-id call :effect)}
     [(work/pure
       {:id (call-id call :arguments)}
       (fn [input context]
         (:call/arguments call)))
      produced
      (work/pure
       {:id (call-id call :result)}
       (fn [output context]
         (successful-result call output)))])))

(defn call-work
  "Lowers one model-selected tool call to ordinary Work.

   Pure tools become pure Work. Non-pure tool functions are invoked only as
   Work factories and their returned Work executes through the normal runtime.
   Effectful Work receives the decoded call arguments as its canonical input.
   The result is always a tool-result value suitable for provider translation."
  [tool-index call]
  (let [value (get tool-index (:tool/name call))]
    (cond
      (nil? value)
      (unknown-call-work call)

      (= :pure (:tool/effect value))
      (pure-call-work value call)

      :else
      (effect-call-work value call))))

(defn call-works
  "Lowers model-selected tool calls to Work while preserving call order."
  [tool-index calls]
  (vec
   (map
    (fn [call]
      (call-work tool-index call))
    calls)))
