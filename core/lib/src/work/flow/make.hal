(ns work.flow.make
  (:config {:override [compile run]})
  (:require [work.flow :as flow]
            [work.flow.make.base :as base]
            [work.flow.make.compile :as compile-base]
            [work.flow.make.run :as run-base]))

(def path [:make])

(def +flow+
  {:flow/path path
   :flow/version 1
   :flow/product :host
   :flow/normalise base/normalise
   :flow/compile compile-base/compile
   :flow/reconcile base/reconcile})

(flow/register! +flow+)

(def make-host? base/make-host?)
(def state base/state)
(def definition base/definition)
(def targets base/targets)
(def compile compile-base/compile)
(def compile-target compile-base/compile-target)
(def run run-base/run)
(def build run-base/build)
(def input run-base/input)
(def triggered run-base/triggered)
(def run-triggered run-base/run-triggered)