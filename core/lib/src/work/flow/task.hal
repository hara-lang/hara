(ns work.flow.task
  (:require [work.flow :as flow]
            [std.work.template.task :as task]))

(def path [:task])

(defn normalise
  [profile qualified-name raw-definition declaration-body]
  (if (not (map? raw-definition))
    (throw
     (ex-info "Task workflow definition must be a map"
              {:workflow/name qualified-name
               :workflow/definition raw-definition})))
  (let [options (:workflow/options profile)
        definition (flow/merge-options options raw-definition)]
    (if (or (:task/id definition) (:id definition))
      definition
      (assoc definition :task/id qualified-name))))

(defn compile
  [profile definition]
  (task/compile definition))

(defn reconcile
  [profile previous candidate definition]
  candidate)

(def +flow+
  {:flow/path path
   :flow/version 1
   :flow/product :work
   :flow/normalise normalise
   :flow/compile compile
   :flow/reconcile reconcile})

(flow/register! +flow+)

(def request task/request)
(def invocation task/invocation)
(def invocation-arguments task/invocation-arguments)
(def task-work? task/task-work?)