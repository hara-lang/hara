(ns work.base.model
  (:config {:override [Runtime]})
  (:require [std.work.protocol :as protocol]))

(defstruct Work [spec])
(defstruct WorkRef [id])
(defstruct WorkObserver [function state])
(defstruct Runtime
  [mode store executor receipt observer definitions runtime-version schema-version])

(defn runtime-mode
  [runtime]
  (:mode runtime))

(defn runtime-store
  [runtime]
  (:store runtime))

(defn runtime-executor
  [runtime]
  (:executor runtime))

(defn runtime-receipt
  [runtime]
  (:receipt runtime))

;; Compatibility accessors for the pre-provider runtime layout. New runtime
;; code should use runtime-store and runtime-executor directly.
(defn runtime-backend
  [runtime]
  (let [store (runtime-store runtime)]
    (or (:provider/legacy store)
        (:provider/operations store)
        store)))

(defn runtime-handlers
  [runtime]
  (or (:provider/handlers (runtime-executor runtime)) {}))

(defn runtime-observer
  [runtime]
  (:observer runtime))

(defn runtime-definitions
  [runtime]
  (:definitions runtime))

(defn runtime-code-version
  [runtime]
  (:runtime-version runtime))

(defn runtime-schema-version
  [runtime]
  (:schema-version runtime))

(extend-type Work IWork
  (work-spec [work]
    (:spec work)))

(extend-type Work std.protocol.ifn/IFn
  (invoke [work & arguments]
    (let [function (:work/invoke (:spec work))]
      (if function
        (apply function work arguments)
        (throw
         (ex-info
          "Work value is not directly callable"
          {:work/id (:id (:spec work))}))))))

(extend-type WorkRef IWorkRef
  (work-id [reference]
    (:id reference)))

(extend-type WorkObserver protocol/IWorkObserver
  (work-event [observer event]
    ((:function observer) event)))

(defn work-value
  [spec]
  (work.base.model/Work spec))

(defn work-spec-map
  [work]
  (if (and (map? work)
           (has? work :op))
    work
    (if (nil? work)
      (throw (ex-info "Work value cannot be nil" {}))
      (let [spec (IWork/work-spec work)]
        (if (map? spec)
          spec
          (throw
           (ex-info "IWork/work-spec must return a map"
                    {:work work
                     :spec spec})))))))

(defn work-reference
  [id]
  (work.base.model/WorkRef id))

(defn reference-id
  [reference]
  (cond
    (instance? work.base.model/WorkRef reference)
    (:id reference)

    (and reference
         (satisfies? IWorkRef reference))
    (IWorkRef/work-id reference)

    :else
    reference))

(defn observer
  [function]
  (work.base.model/WorkObserver function nil))

(defn recording-observer
  []
  (let [state (atom [])]
    (work.base.model/WorkObserver
     (fn [event]
       (swap! state conj event))
     state)))

(defn observer-events
  [observer]
  (let [state (if observer (:state observer) nil)]
    (if state
      (vec (deref state))
      [])))

;; ---------------------------------------------------------------------------
;; Compatibility seams
;; ---------------------------------------------------------------------------

(defn backend-call
  "Deprecated compatibility dispatch for legacy backend maps."
  [backend operation & arguments]
  (let [operations (or (:provider/operations backend) backend)
        function (get operations operation)]
    (if function
      (apply function arguments)
      (throw
       (ex-info "Work backend operation is not installed"
                {:operation operation})))))

(defn provider-capability?
  [provider capability]
  (reduce
   (fn [found installed]
     (or found (= capability installed)))
   false
   (or (:provider/capabilities provider) [])))

(defn compatible-run?
  [existing proposed]
  (and (= (:run/work-root existing) (:run/work-root proposed))
       (= (:run/work-version existing) (:run/work-version proposed))
       (= (:run/input existing) (:run/input proposed))))

(defn durable?
  [runtime]
  (and (= :durable (runtime-mode runtime))
       (provider-capability? (runtime-store runtime) :checkpoints)))

(defn register-definition!
  [runtime root version work]
  (swap! (runtime-definitions runtime) assoc [root version] work)
  work)

(defn resolve-definition
  [runtime root version]
  (get (deref (runtime-definitions runtime)) [root version]))

;; ---------------------------------------------------------------------------
