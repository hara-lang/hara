(ns work.base.execution
  (:require [work.base.model :as base]
            [work.base.frame :as frame]
            [work.base.result :as result]
            [work.base.execution.step :as step]
            [work.base.execution.collection :as collection]
            [work.base.execution.graph :as graph]
            [work.base.execution.ensure :as ensure]
            [work.base.execution.batch :as batch]))

(defn provider-operations
  [provider]
  (or (:provider/operations provider) provider))

(defn assert-role!
  [provider]
  (if (not= :work/executor (:provider/role provider))
    (throw
     (ex-info "Work provider does not have the executor role"
              {:provider/role (:provider/role provider)
               :provider/id (:provider/id provider)})))
  provider)

(defn validate-provider
  [provider]
  (let [provider (assert-role! provider)
        execute (get (provider-operations provider) :execute)]
    (if (nil? execute)
      (throw
       (ex-info "Work executor provider is missing :execute"
                {:provider/id (:provider/id provider)})))
    (if (:provider/handlers provider)
      provider
      (assoc provider :provider/handlers {}))))

(defn legacy-provider
  [provider]
  {:provider/role :work/executor
   :provider/id (or (:provider/id provider) :legacy-executor)
   :provider/capabilities (or (:provider/capabilities provider) #{})
   :provider/operations provider
   :provider/handlers (or (:handlers provider) {})
   :provider/legacy provider})

(defn normalise-provider
  [provider]
  (cond
    (nil? provider)
    (throw (ex-info "Work runtime requires an executor provider" {}))

    (and (map? provider)
         (= :work/executor (:provider/role provider)))
    (validate-provider provider)

    (and (map? provider)
         (:provider/role provider))
    (assert-role! provider)

    (map? provider)
    (validate-provider (legacy-provider provider))

    :else
    (throw
     (ex-info "Work executor provider must be a descriptor or operation map"
              {:provider provider}))))

(defn call
  [provider operation & arguments]
  (let [function (get (provider-operations provider) operation)]
    (if function
      (apply function arguments)
      (throw
       (ex-info "Work executor operation is not installed"
                {:provider/id (:provider/id provider)
                 :operation operation})))))

(defn execute-work
  [runtime frame work input]
  (call (base/runtime-executor runtime)
        :execute
        runtime
        frame
        work
        input))

(defn with-handler
  [provider operation handler]
  (assoc provider
         :provider/handlers
         (assoc (or (:provider/handlers provider) {})
                operation
                handler)))

(defn with-handlers
  [provider handlers]
  (assoc provider
         :provider/handlers
         (merge (or (:provider/handlers provider) {})
                (or handlers {}))))

(def default-handlers
  {:pure step/run-pure
   :step step/run-step
   :chain collection/run-chain
   :each collection/run-each
   :filter collection/run-filter
   :fold collection/run-fold
   :all collection/run-all
   :choose collection/run-choose
   :ensure ensure/run-ensure
   :batch batch/run-batch
   :graph graph/run-graph})

(declare execute-node)

(defn execute-node-handler
  [runtime frame spec operation handler input]
  (result/attempt
   (fn []
     (result/then
      (handler execute-node runtime frame spec input)
      (fn [value]
        (result/then
         (frame/emit! runtime frame :work/node-completed
                      {:operation operation
                       :node/id (:id spec)})
         (fn [_]
           value)))))
   (fn [error]
     (result/then
      (frame/emit! runtime frame :work/node-failed
                   {:operation operation
                    :node/id (:id spec)
                    :error (str error)})
      (fn [_]
        (throw error))))))

(defn execute-node
  [runtime frame work input]
  (result/then
   (frame/assert-running! runtime frame)
   (fn [_]
     (let [spec (base/work-spec-map work)
           operation (:op spec)
           handler (get (base/runtime-handlers runtime) operation)]
       (if (nil? handler)
         (throw
          (ex-info "Work operation is not installed"
                   {:operation operation
                    :node/path (:node/path frame)}))
         (result/then
          (frame/emit! runtime frame :work/node-started
                       {:operation operation
                        :node/id (:id spec)})
          (fn [_]
            (execute-node-handler runtime
                                  frame
                                  spec
                                  operation
                                  handler
                                  input))))))))
