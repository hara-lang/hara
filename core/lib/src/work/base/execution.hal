(ns work.base.execution
  (:require [work.base.model :as base]
            [work.base.frame :as frame]
            [work.base.result :as result]
            [work.base.execution.step :as step]
            [work.base.execution.collection :as collection]
            [work.base.execution.graph :as graph]
            [work.base.execution.ensure :as ensure]
            [work.base.execution.batch :as batch]))

(defn provider-operations
  [provider]
  (or (:provider/operations provider) provider))

(defstruct LegacyExecutor [provider legacy])

(extend-type LegacyExecutor IWorkExecutor
  (work-execute [executor request]
    (let [provider (:provider executor)
          execute (get (provider-operations provider) :execute)
          compatibility (:work/compatibility request)]
      (if execute
        (execute (:runtime compatibility)
                 (:frame compatibility)
                 (:work compatibility)
                 (:work/input request))
        (throw
         (ex :not-found {:provider/id (:provider/id provider)} :ex/message "Legacy Work executor is missing :execute"))))))

(defn assert-role
  [provider]
  (if (not= :work/executor (:provider/role provider))
    (throw
     (ex :generic {:provider/role (:provider/role provider)
               :provider/id (:provider/id provider)} :ex/message "Work provider does not have the executor role")))
  provider)

(defn validate-provider
  [provider]
  (let [provider (assert-role provider)
        execute (get (provider-operations provider) :execute)]
    (if (nil? execute)
      (throw
       (ex :not-found {:provider/id (:provider/id provider)} :ex/message "Work executor provider is missing :execute")))
    (if (:provider/handlers provider)
      provider
      (assoc provider :provider/handlers {}))))

(defn legacy-provider
  [provider]
  {:provider/role :work/executor
   :provider/id (or (:provider/id provider) :legacy-executor)
   :provider/capabilities (or (:provider/capabilities provider) #{})
   :provider/operations provider
   :provider/handlers (or (:handlers provider) {})
   :provider/legacy provider})

(defn normalise-provider
  [provider]
  (cond
    (nil? provider)
    (throw (ex :dependency {} :ex/message "Work runtime requires an executor provider"))

    (satisfies? IWorkExecutor provider)
    provider

    (and (map? provider)
         (= :work/executor (:provider/role provider)))
    (work.base.execution/LegacyExecutor (validate-provider provider) true)

    (and (map? provider)
         (:provider/role provider))
    (assert-role provider)

    (map? provider)
    (work.base.execution/LegacyExecutor
     (validate-provider (legacy-provider provider))
     true)

    :else
    (throw
     (ex :generic {:provider provider} :ex/message "Work executor must implement IWorkExecutor or be a legacy provider"))))

(defn executor-descriptor
  [executor]
  (if (instance? work.base.execution/LegacyExecutor executor)
    (:provider executor)
    (or (:descriptor executor) executor)))

(defn executor-id
  [executor]
  (or (:provider/id (executor-descriptor executor))
      (:id executor)
      :executor))

(defn call
  [provider operation & arguments]
  (let [function (get (provider-operations provider) operation)]
    (if function
      (apply function arguments)
      (throw
       (ex :generic {:provider/id (:provider/id provider)
                 :operation operation} :ex/message "Work executor operation is not installed")))))

(declare execute-node)

(defn execute-work
  [runtime frame work input]
  (execute-node runtime frame work input))

(def default-handlers
  {:pure step/run-pure
   :step step/run-step
   :chain collection/run-chain
   :each collection/run-each
   :filter collection/run-filter
   :fold collection/run-fold
   :all collection/run-all
   :choose collection/run-choose
   :ensure ensure/run-ensure
   :batch batch/run-batch
   :graph graph/run-graph})

(defn evaluator-handlers
  [runtime]
  (merge default-handlers
         (or (:work/handlers (base/runtime-hooks runtime)) {})))

(defn execute-node-handler
  [runtime frame spec operation handler input]
  (result/attempt
   (fn []
     (result/then
      (handler execute-node runtime frame spec input)
      (fn [value]
        (result/then
         (frame/emit runtime frame :work/node-completed
                      {:operation operation
                       :node/id (:id spec)})
         (fn [_]
           value)))))
   (fn [error]
     (result/then
      (frame/emit runtime frame :work/node-failed
                   {:operation operation
                    :node/id (:id spec)
                    :error (str error)})
      (fn [_]
        (throw error))))))

(defn execute-node
  [runtime frame work input]
  (result/then
   (frame/assert-running runtime frame)
   (fn [_]
     (let [spec (base/work-spec-map work)
           operation (:op spec)
           handler (get (evaluator-handlers runtime) operation)]
       (if (nil? handler)
         (throw
          (ex :io {:operation operation
                    :node/path (:node/path frame)} :ex/message "Work operation is not installed"))
         (result/then
          (frame/emit runtime frame :work/node-started
                       {:operation operation
                        :node/id (:id spec)})
          (fn [_]
            (execute-node-handler runtime
                                  frame
                                  spec
                                  operation
                                  handler
                                  input))))))))
