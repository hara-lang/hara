(ns work.base.execution.ephemeral
  (:require [work.base.execution :as execution]
            [work.base.model :as base]))

(def executor
  {:provider/role :work/executor
   :provider/id :ephemeral
   :provider/capabilities #{:sequential :cleanup :native-events}
   :provider/operations {:execute execution/execute-node}
   :provider/handlers execution/default-handlers})

(defn execution-runtime
  []
  (base/runtime-map
   executor
   nil
   (atom {})
   {:work/mode :native
    :work/runtime-version 1
    :work/schema-version 1}
   {}))

(defn root-id
  [spec options]
  (or (:work-root options)
      (:root spec)
      (:id spec)
      :anonymous))

(defn initial-frame
  [spec options run-id]
  {:run/id run-id
   :work/root (root-id spec options)
   :work/version (or (:work-version options) (:version spec) 1)
   :node/path []
   :item/id nil
   :item/path []
   :context (or (:context options) {})
   :options options})

(defn execute
  [work input options run-id]
  (let [options (or options {})
        spec (base/work-spec-map work)]
    (execution/execute-node
     (execution-runtime)
     (initial-frame spec options run-id)
     work
     input)))
