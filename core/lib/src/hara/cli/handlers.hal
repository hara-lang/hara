(ns hara.cli.handlers
  (:require [code.manage.cli :as manage]
            [code.test.cli :as code-test]
            [lang.seedgen.cli :as seedgen]))

(def +registry+
  {:hara.cli.handler/manage manage/handler
   :hara.cli.handler/project-test code-test/handler
   :hara.cli.handler/seedgen seedgen/handler})

(defn registry
  ([] +registry+)
  ([overrides] (merge +registry+ overrides)))
