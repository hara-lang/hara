;; ============================================================================
;; tool.sh.misc — desktop command builders; platform inspection stays in OS.
;; ============================================================================
(ns tool.sh.misc
  (:require [tool.sh :as sh]))

(defn say-command
  [platform phrase]
  (cond (= platform :macos) ["say" phrase]
        (= platform :linux) ["spd-say" phrase]
        :else (throw (ex :host {:platform platform} :ex/message "Speech command is unavailable"))))

(defn notify-command
  [platform title message]
  (cond (= platform :macos)
        ["alerter" "-message" message "-title" title "-sound" "BELL"]
        (= platform :linux)
        ["notify-send" title message]
        :else
        (throw (ex :host {:platform platform :title title :message message} :ex/message "Desktop notification is unavailable"))))

(defn terminal-command
  [platform command]
  (cond (= platform :macos) (into ["ttab"] command)
        (= platform :linux) (into ["x-terminal-emulator" "-e"] command)
        :else (throw (ex :host {:platform platform} :ex/message "Terminal launch is unavailable"))))

(defn beep-command
  [platform]
  (cond (= platform :macos) ["afplay" "/System/Library/Sounds/Funk.aiff"]
        (= platform :linux) ["paplay" "/usr/share/sounds/freedesktop/stereo/bell.oga"]
        :else (throw (ex :host {:platform platform} :ex/message "Beep command is unavailable"))))

(defn say
  [& phrase]
  (sh/execute-checked (say-command (OS/platform) (str/join " " (map str phrase))) {}))

(defn notify
  ([title message] (notify title message {}))
  ([title message options]
   (sh/execute-checked (notify-command (or (:platform options) (OS/platform)) title message)
                options)))

(defn run-terminal
  ([command] (run-terminal command {}))
  ([command options]
   (sh/execute-checked (terminal-command (or (:platform options) (OS/platform)) command)
                options)))

(defn beep
  ([] (beep {}))
  ([options]
   (sh/execute-checked (beep-command (or (:platform options) (OS/platform))) options)))
