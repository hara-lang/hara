;; ============================================================================
;; tool.sh.network — explicit network command builders over tool.sh.
;; ============================================================================
(ns tool.sh.network
  (:require [tool.sh :as sh]))

(defn wget-command
  [root-url file output arguments]
  (let [command ["wget" (str root-url file)]
        command (if output (into command ["-O" output]) command)]
    (into command (or arguments []))))

(defn download
  ([url] (download url {}))
  ([url options]
   (let [command (wget-command "" url (:output options) (:arguments options))]
     (sh/execute-checked command options))))

(defn wget-bulk
  "Downloads Foundation-style file descriptors through injectable runners."
  ([root-url root-path files]
   (wget-bulk root-url root-path files []))
  ([root-url root-path files arguments]
   (mapv (fn [file]
           (let [descriptor (if (vector? file) file [file nil])
                 source (nth descriptor 0)
                 output (nth descriptor 1)
                 options {:cwd (str "resources/" root-path)}]
             (sh/execute-checked (wget-command root-url source output arguments) options)))
         files)))
