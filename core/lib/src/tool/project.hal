(ns tool.project
  (:require [code.framework :as framework]
            [tool.project.production :as production]))

(def +defaults+
  {:root "."
   :source-paths ["src"]
   :test-paths ["test"]
   :extension ".hal"
   :test-suffix "-test"})

(defn project-options
  "Applies portable project defaults without discarding host-specific keys."
  [project]
  (merge +defaults+ project))

(defn join-path
  [parts]
  (str/join "/"
               (filter (fn [part]
                         (not (str/blank? (str part))))
                       parts)))

(defn namespace-stem
  [namespace]
  (str/replace
   (str/replace (str namespace) "." "/") "-" "_"))

(defn path-namespace
  "Converts a source-relative HAL path into its namespace convention."
  [path]
  (let [without-extension (if (str/ends-with? path ".hal")
                            (str/slice path 0 (- (str/length path) 4))
                            path)]
    (symbol
     (str/replace
      (str/replace without-extension "/" ".") "_" "-"))))

(defn test-suffix [project]
  (:test-suffix (project-options project)))

(defn source-namespace
  [project namespace]
  (let [value (str namespace)
        suffix (test-suffix project)]
    (if (str/ends-with? value suffix)
      (symbol (str/slice value 0 (- (str/length value)
                                       (str/length suffix))))
      (symbol value))))

(defn test-namespace
  [project namespace]
  (let [value (str namespace)
        suffix (test-suffix project)]
    (if (str/ends-with? value suffix)
      (symbol value)
      (symbol (str value suffix)))))

(defn source-candidates
  [project namespace]
  (let [options (project-options project)
        relative (str (namespace-stem (source-namespace options namespace))
                      (:extension options))]
    (vec (map (fn [root]
                (join-path [(:root options) root relative]))
              (:source-paths options)))))

(defn test-candidates
  [project namespace]
  (let [options (project-options project)
        relative (str (namespace-stem (source-namespace options namespace))
                      "_test"
                      (:extension options))]
    (vec (map (fn [root]
                (join-path [(:root options) root relative]))
              (:test-paths options)))))

(defn source-path [project namespace]
  (first (source-candidates project namespace)))

(defn test-path [project namespace]
  (first (test-candidates project namespace)))

(defn index-entry
  [path entry]
  (merge {:path path :namespace (path-namespace path)}
         (if (map? entry) entry {:source entry})))

(defn project-index
  "Builds path and namespace indexes from host-discovered source records."
  [project entries]
  (let [options (project-options project)
        files (vec (map (fn [entry]
                          (if (string? entry)
                            (index-entry entry nil)
                            (index-entry (:path entry) entry)))
                        entries))]
    {:project options
     :paths (reduce (fn [out entry]
                      (assoc out (:path entry) entry))
                    {}
                    files)
     :namespaces (reduce (fn [out entry]
                           (assoc out (:namespace entry) entry))
                         {}
                         files)}))

(defn lookup-path [index path]
  (get (:paths index) path))

(defn lookup-namespace [index namespace]
  (get (:namespaces index) (symbol (str namespace))))

(def +required-keys+
  [:hara/type :hara/version :project/id :project/version
   :project/source-paths :project/test-paths :project/extension-paths
   :project/capabilities])

(def +inrepl-capabilities+
  #{:inrepl/loopback})

(defn inrepl-capabilities
  "Returns the optional agent in-REPL policy after rejecting unknown entries."
  [document]
  (let [declared (or (:project/inrepl-capabilities document) #{})]
    (if (not (set? declared))
      (throw (ex-info ":project/inrepl-capabilities must be a set"
                      {:value declared})))
    (let [unknown (filter (fn [capability]
                            (not (has? +inrepl-capabilities+ capability)))
                          declared)]
      (if (not (empty? unknown))
        (throw (ex-info "project.edn declares an unknown in-REPL capability"
                        {:unknown (vec unknown)})))
      declared)))

(defn inrepl-loopback?
  "True only when the project explicitly permits the loopback in-REPL client."
  [document]
  (has? (inrepl-capabilities document) :inrepl/loopback))


(def +legacy-runtime-keys+
  {:jvm/source-paths
   [:project/runtime-profiles :jvm :runtime/native-source-paths]
   :jvm/dependencies
   [:project/runtime-profiles :jvm :runtime/dependencies :maven]
   :jvm/target-path
   [:project/runtime-profiles :jvm :runtime/target-path]})

(defn reject-legacy-runtime-keys
  [document]
  (let [legacy-key
        (if (has? document :jvm/source-paths)
          :jvm/source-paths
          (if (has? document :jvm/dependencies)
            :jvm/dependencies
            (if (has? document :jvm/target-path)
              :jvm/target-path
              nil)))]
    (if legacy-key
      (let [replacement (get +legacy-runtime-keys+ legacy-key)]
        (throw
         (ex-info
          (str "project.edn " legacy-key
               " is no longer supported; use " replacement)
          {:type :legacy-runtime-key
           :key legacy-key
           :replacement replacement})))
      document)))

(defn- runtime-path-vector
  [container key label]
  (let [value (or (get container key) [])]
    (if (vector? value)
      value
      (throw
       (ex-info
        (str label " must be a vector of project-relative path strings")
        {:type :invalid-runtime-profile
         :key key
         :value value})))))

(defn- runtime-map
  [value label]
  (let [value (or value {})]
    (if (map? value)
      value
      (throw
       (ex-info
        (str label " must be a map")
        {:type :invalid-runtime-profile
         :value value})))))

(defn runtime-profile
  [document runtime]
  (if-not (or (= runtime :jvm) (= runtime :rust))
    (throw
     (ex-info
      (str "unsupported project runtime profile " runtime)
      {:type :invalid-runtime-profile
       :runtime runtime})))
  (let [profiles (runtime-map (:project/runtime-profiles document)
                              ":project/runtime-profiles")
        profile (or (get profiles runtime) {})]
    (runtime-map profile (str ":project/runtime-profiles " runtime))))

(defn- merge-runtime-hara-dependencies
  [shared additions runtime]
  (reduce
   (fn [output [coordinate declaration]]
     (if (and (has? output coordinate)
              (not= (get output coordinate) declaration))
       (throw
        (ex-info
         (str "conflicting Hara dependency requirements for " coordinate
              " in runtime profile " runtime)
         {:type :runtime-profile-conflict
          :runtime runtime
          :coordinate coordinate
          :shared (get output coordinate)
          :runtime-requirement declaration}))
       (assoc output coordinate declaration)))
   shared
   additions))

(defn resolve-runtime-profile
  [document runtime]
  (let [document (reject-legacy-runtime-keys document)
        profile (runtime-profile document runtime)
        dependency-groups
        (runtime-map (:runtime/dependencies profile)
                     (str ":runtime/dependencies for " runtime))
        shared-hara
        (runtime-map (:project/dependencies document)
                     ":project/dependencies")
        runtime-hara
        (runtime-map (:hara dependency-groups)
                     (str ":runtime/dependencies :hara for " runtime))
        maven
        (runtime-map (:maven dependency-groups)
                     (str ":runtime/dependencies :maven for " runtime))]
    {:runtime runtime
     :source-paths
     (vec (concat
           (runtime-path-vector document
                                :project/source-paths
                                ":project/source-paths")
           (runtime-path-vector profile
                                :runtime/source-paths
                                ":runtime/source-paths")))
     :test-paths
     (vec (concat
           (runtime-path-vector document
                                :project/test-paths
                                ":project/test-paths")
           (runtime-path-vector profile
                                :runtime/test-paths
                                ":runtime/test-paths")))
     :extension-paths
     (vec (concat
           (runtime-path-vector document
                                :project/extension-paths
                                ":project/extension-paths")
           (runtime-path-vector profile
                                :runtime/extension-paths
                                ":runtime/extension-paths")))
     :native-source-paths
     (runtime-path-vector profile
                          :runtime/native-source-paths
                          ":runtime/native-source-paths")
     :target-path (:runtime/target-path profile)
     :hara-dependencies
     (merge-runtime-hara-dependencies shared-hara runtime-hara runtime)
     :maven-dependencies maven}))

(defn select-runtime
  [document runtime]
  (let [resolved (resolve-runtime-profile document runtime)]
    (assoc document
           :project/runtime runtime
           :project/source-paths (:source-paths resolved)
           :project/test-paths (:test-paths resolved)
           :project/extension-paths (:extension-paths resolved)
           :project/native-source-paths (:native-source-paths resolved)
           :project/runtime-target-path (:target-path resolved)
           :project/dependencies (:hara-dependencies resolved)
           :project/maven-dependencies (:maven-dependencies resolved))))

(defn- validate-runtime-profiles
  [document]
  (let [document (reject-legacy-runtime-keys document)
        profiles (runtime-map (:project/runtime-profiles document)
                              ":project/runtime-profiles")]
    (reduce
     (fn [output runtime]
       (do
         (resolve-runtime-profile document runtime)
         output))
     document
     (keys profiles))))

(defn missing-keys [document]
  (vec (filter (fn [key] (not (has? document key))) +required-keys+)))

(defn validate [document]
  (let [document (validate-runtime-profiles document)
        missing (missing-keys document)]
    (cond
      (not (map? document))
      (throw (ex-info "project.edn must be an EDN map" {}))
      (not (empty? missing))
      (throw (ex-info (str "project.edn missing required keys: " missing)
                      {:missing missing}))
      (not= :project (:hara/type document))
      (throw (ex-info "project.edn :hara/type must be :project" {}))
      :else (production/normalize-project document))))

(defn read-text [path]
  (str/decode-utf8 (deref (File/read path))))

(defn read-project
  ([manifest-path] (read-project manifest-path {}))
  ([manifest-path options]
   (let [document (validate (Edn/read (read-text manifest-path)))
         project (assoc document
                        :project/root (File/parent manifest-path)
                        :project/manifest-path manifest-path)]
     (if (:runtime options)
       (select-runtime project (:runtime options))
       project))))

(defn start-directory [path]
  (let [metadata (deref (File/stat path))]
    (if (= :directory (:type metadata)) path (File/parent path))))

(defn discover [start]
  (loop [current (start-directory start)]
    (if (nil? current)
      (throw (ex-info (str "no project.edn found above " start) {:start start}))
      (let [manifest (File/join current "project.edn")]
        (if (deref (File/exists? manifest))
          (read-project manifest)
          (recur (File/parent current)))))))

(defn walk-files [path]
  (vec (deref (File/walk path))))

(defn files-in
  ([project roots] (files-in project roots nil))
  ([project roots suffix]
   (let [root (:project/root project)
         files (reduce (fn [output path]
                         (into output (walk-files (File/join root path))))
                       []
                       roots)]
     (if suffix
       (reduce (fn [output path]
                 (if (str/ends-with? path suffix)
                   (conj output path)
                   output))
               []
               files)
       files))))

(defn declared-resources [project]
  (:resources
   (reduce
    (fn [state path]
      (let [source (read-text path)
            namespace (framework/namespace-name source)]
        (if (nil? namespace)
          (throw (ex-info (str path " does not declare an ns or ns+ namespace")
                          {:path path})))
        (if (has? (:names state) namespace)
          (throw (ex-info "duplicate namespace in effective project profile"
                          {:type :duplicate-namespace
                           :namespace namespace
                           :paths [(get (:names state) namespace) path]})))
        {:names (assoc (:names state) namespace path)
         :resources
         (conj (:resources state)
               {:resource/name namespace
                :resource/path path
                :resource/source source})}))
    {:names {} :resources []}
    (files-in project (:project/source-paths project) ".hal"))))

(defn register-resources! [project]
  (reduce
   (fn [registered resource]
     (Kernel/resource-register (:resource/name resource)
                                          (:resource/source resource))
     (conj registered (:resource/name resource)))
   []
   (declared-resources project)))

(defn namespace-path [namespace]
  (str (namespace-stem namespace) ".hal"))

(defn main-file [project]
  (let [main (:project/main project)]
    (if (nil? main)
      (throw (ex-info "project.edn is missing :project/main" {}))
      (let [relative (namespace-path main)
            found (first
                   (filter
                    (fn [path] (deref (File/exists? path)))
                    (map (fn [root]
                           (File/join
                            (File/join (:project/root project) root)
                            relative))
                         (:project/source-paths project))))]
        (if found
          found
          (throw (ex-info
                  (str "cannot find :project/main " main
                       " in :project/source-paths")
                  {:project/main main})))))))
