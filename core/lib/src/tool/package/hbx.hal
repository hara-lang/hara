(ns tool.package.hbx
  (:require [tool.package :as package]))

(def +format+ :hbx)
(def +version+ 0)
(defn encode [modules] (package/pack modules))
(defn decode [bytes] (package/unpack bytes))
(defn validate [bytes] (package/validate bytes))
(defn inspect [bytes] (package/inspect bytes))
(defn modules [bytes] (package/unpack bytes))
(defn extract [bytes resource]
  (first
   (filter (fn [module] (= resource (:module/resource module)))
           (modules bytes))))
