(ns tool.vm.halc
  (:require [tool.vm :as vm]))

(def +format+ :halc)
(def +version+ 1)

(defn artifact
  "Wraps canonical HALC Bytes as a portable tool.vm artifact."
  ([bytes] (artifact bytes nil))
  ([bytes provenance]
   (vm/artifact
    (merge
     {:artifact/format +format+
      :artifact/version +version+
      :artifact/bytes bytes}
     (if (nil? provenance)
       {}
       {:artifact/provenance provenance})))))

(defn validate
  "Validates canonical HALC Bytes through the current or selected provider."
  ([bytes] (vm/validate (artifact bytes)))
  ([bytes options] (vm/validate (artifact bytes) options)))

(defn inspect
  "Returns portable metadata for canonical HALC Bytes."
  ([bytes] (vm/inspect (artifact bytes)))
  ([bytes options] (vm/inspect (artifact bytes) options)))
