(ns tool.vm.hbc
  (:require [tool.vm :as vm]))

(def +format+ :hbc)
(def +version+ 0)

(defn artifact
  "Wraps canonical HBC0 Bytes as a portable tool.vm artifact."
  ([bytes] (artifact bytes nil))
  ([bytes provenance]
   (vm/artifact
    (merge
     {:artifact/format +format+
      :artifact/version +version+
      :artifact/bytes bytes}
     (if (nil? provenance)
       {}
       {:artifact/provenance provenance})))))

(defn validate
  "Validates canonical HBC0 Bytes through the current or selected provider."
  ([bytes] (vm/validate (artifact bytes)))
  ([bytes options] (vm/validate (artifact bytes) options)))

(defn inspect
  "Returns portable metadata for canonical HBC0 Bytes."
  ([bytes] (vm/inspect (artifact bytes)))
  ([bytes options] (vm/inspect (artifact bytes) options)))

(defn disassemble
  "Returns deterministic HBC0 diagnostics; this is not source decompilation."
  ([bytes] (vm/disassemble (artifact bytes)))
  ([bytes options] (vm/disassemble (artifact bytes) options)))
