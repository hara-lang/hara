(ns tool.cli.handlers
  (:require [code.manage.cli :as manage]
            [code.test.cli :as code-test]
            [tool.cli.asset :as asset]
            [tool.cli.extension :as extension]
            [tool.cli.identity :as identity]
            [tool.cli.host :as cli-host]
            [tool.cli.language :as language]
            [tool.cli.lint :as lint]
            [tool.cli.package :as package]
            [tool.cli.project-command :as project-command]
            [tool.cli.snapshot :as snapshot]
            [tool.cli.spec :as spec]
            [tool.cli.tap :as tap]
            [lang.seedgen.cli :as seedgen]))

(def +registry+
  {:tool.cli.handler/eval language/eval-handler
   :tool.cli.handler/run-file language/run-file-handler
   :tool.cli.handler/project-run language/project-run-handler
   :tool.cli.handler/lint lint/handler
   :tool.cli.handler/manage manage/handler
   :tool.cli.handler/project-test code-test/handler
   :tool.cli.handler/project-new project-command/handler
   :tool.cli.handler/project-check project-command/handler
   :tool.cli.handler/project-build project-command/handler
   :tool.cli.handler/project-add project-command/handler
   :tool.cli.handler/project-remove project-command/handler
   :tool.cli.handler/project-sync project-command/handler
   :tool.cli.handler/project-update project-command/handler
   :tool.cli.handler/asset asset/handler
   :tool.cli.handler/extension extension/handler
   :tool.cli.handler/identity identity/handler
   :tool.cli.handler/stdin cli-host/handler
   :tool.cli.handler/repl cli-host/handler
   :tool.cli.handler/server cli-host/handler
   :tool.cli.handler/remote cli-host/handler
   :tool.cli.handler/compile-halc cli-host/handler
   :tool.cli.handler/package package/handler
   :tool.cli.handler/tap tap/handler
   :tool.cli.handler/snapshot snapshot/handler
   :tool.cli.handler/spec spec/handler
   :tool.cli.handler/seedgen seedgen/handler})

(defn registry
  ([] +registry+)
  ([overrides] (merge +registry+ overrides)))
