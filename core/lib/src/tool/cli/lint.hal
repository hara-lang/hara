(ns tool.cli.lint
  (:require [std.work :as work]
            [tool.cli.model :as model]
            [tool.lint :as lint]
            [tool.lint.model :as lint-model]
            [tool.lint.profile :as profile]
            [tool.lint.report :as report]
            [tool.project :as project]))

(defn parse-arguments
  [arguments]
  (loop [remaining arguments format :text schema-mode nil paths []]
    (if (empty? remaining)
      {:format format :schema-mode schema-mode :paths paths}
      (let [argument (first remaining)]
        (cond
          (= "--format" argument)
          (if (< (count remaining) 2)
            (throw (ex-info "lint --format requires text or edn" {}))
            (let [selected (keyword (second remaining))]
              (if (has? #{:text :edn} selected)
                (recur (vec (drop 2 remaining)) selected schema-mode paths)
                (throw (ex-info "lint --format requires text or edn" {})))))

          (= "--schema-mode" argument)
          (if (< (count remaining) 2)
            (throw (ex-info "lint --schema-mode requires off, warn, or error" {}))
            (let [selected (keyword (second remaining))]
              (if (has? #{:off :warn :error} selected)
                (recur (vec (drop 2 remaining)) format selected paths)
                (throw (ex-info "lint --schema-mode requires off, warn, or error" {})))))

          :else
          (recur (vec (rest remaining)) format schema-mode
                 (conj paths argument)))))))

(defn lint-options
  [parsed]
  (if (:schema-mode parsed)
    {:schema-mode (:schema-mode parsed)}
    {}))

(defn lint-target
  [path options]
  (let [metadata (deref (file/stat path))]
    (if (= :directory (:type metadata))
      (lint/lint-project (project/discover path) options)
      (let [findings (report/sort-findings (lint/lint-file path options))]
        {:profile profile/+profile+
         :schema-index nil
         :documents []
         :findings findings
         :summary (lint-model/summarize findings)}))))

(defn merge-schema-indexes
  [results]
  (let [indexes (vec (filter identity
                             (map (fn [result] (:schema-index result)) results)))]
    (when (not (empty? indexes))
      {:definitions (reduce (fn [output index]
                              (merge output (:definitions index)))
                            {} indexes)
       :values (reduce (fn [output index]
                         (merge output (:values index)))
                       {} indexes)
       :functions (reduce (fn [output index]
                            (merge output (:functions index)))
                          {} indexes)
       :inferred-functions
       (reduce (fn [output index]
                 (merge output (:inferred-functions index)))
               {} indexes)
       :mode (:mode (first indexes))})))

(defn combine-results
  [results]
  (let [results (vec results)
        findings (report/sort-findings
                  (reduce (fn [output result]
                            (into output (:findings result)))
                          [] results))]
    {:profile profile/+profile+
     :schema-index (merge-schema-indexes results)
     :documents (reduce (fn [output result]
                          (into output (:documents result)))
                        [] results)
     :findings findings
     :summary (lint-model/summarize findings)}))

(defn execute
  [request]
  (let [parsed (parse-arguments (:request/arguments request))
        options (lint-options parsed)
        cwd (or (:request/cwd request) (os/cwd))
        paths (:paths parsed)
        result (if (empty? paths)
                 (lint/lint-project (project/discover cwd) options)
                 (combine-results
                  (map (fn [path] (lint-target path options)) paths)))
        findings (:findings result)
        output (if (= :edn (:format parsed))
                 (str (pr-str (report/edn findings profile/+profile+)) "\n")
                 (report/text findings))
        messages [(model/message output)]]
    (if (pos? (get-in result [:summary :error]))
      (model/result :tool.cli.outcome/failed result messages)
      (model/success result messages))))

(def +command-work+
  (work/step {:id 'tool.cli/lint :version 1}
             (fn [request context] (execute request))))

(defn handler [request]
  (work/run (work/local-runtime) +command-work+ request))
