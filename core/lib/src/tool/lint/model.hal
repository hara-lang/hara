(ns tool.lint.model
  (:require [std.block :as block]))

(defn span
  [block]
  (let [info (block/info block)]
    {:file (or (:file info) "<memory>")
     :row (or (:row info) 1)
     :col (or (:col info) 1)
     :end-row (or (:end-row info) (:row info) 1)
     :end-col (or (:end-col info) (:col info) 1)
     :start-offset (or (:start-offset info) 0)
     :end-offset (or (:end-offset info) 0)}))

(defn finding
  [block code level message requirement]
  (merge (span block)
         {:type code
          :level level
          :message message
          :spec/requirement requirement}))

(defn summarize
  [findings]
  (reduce (fn [summary finding]
            (let [level (:level finding)]
              (assoc (assoc summary :total (inc (:total summary)))
                     level
                     (inc (or (get summary level) 0)))))
          {:total 0 :error 0 :warning 0}
          findings))
