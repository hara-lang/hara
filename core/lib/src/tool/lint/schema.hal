;; Lint-owned adapter over the portable std.typed implementation.
;;
;; Keep direct std.typed dependencies here so source analysis can evolve its
;; block adapter without pulling std.block, tool.lint, or code.test into the
;; portable typed namespaces.
(ns tool.lint.schema
  (:require [std.typed.infer :as infer]
            [std.typed.schema :as schema]))

(def +unknown-schema+ infer/+unknown-schema+)
(def result infer/result)
(def unknown infer/unknown)
(def literal-result infer/literal-result)
(def call-result infer/call-result)
(def infer-result infer/infer-result)
(def infer-function-arity infer/infer-function-arity)
(def compatible? schema/compatible?)
