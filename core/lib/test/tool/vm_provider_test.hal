(ns tool.vm-provider-test
  (:require [tool.vm :as vm]
            [tool.vm.halc :as halc]
            [tool.vm.hbc :as hbc]
            [std.lib.encode.hex :as hex]))

(defn- failure-data
  [function]
  (try
    (do
      (function)
      nil)
    (catch Throwable error
      (ex-data error))))

(def provider
  (vm/current-provider))

(def provider-id
  (:provider/id provider))

(def golden-hbc
  (hbc/artifact
   (hex/decode
    "484243300000005f0000010000000475736572000000010000000d4854413003000000000000002a0000000000000000000000000000000000000001000000000000000000000100000002000000000018000000020100000000000000010000000100000000006073811fa3086d8edff969b6f31169f2d358937b295630863ec63366450debec")))

(def malformed-hbc
  (hbc/artifact (str/encode-utf8 "HBC0")))

(def hbc-corpus
  {:corpus/id :tool.vm/hbc-cross-runtime
   :corpus/format :hbc
   :corpus/cases
   [{:case/id :rust-golden/value-42
     :case/artifact golden-hbc
     :case/expect {:value 42}}
    {:case/id :malformed/truncated-envelope
     :case/artifact malformed-hbc
     :case/expect {:error true}}]})

(def results
  [(test-check "current provider is normalized ordinary Hara data"
               [(has? #{:rust :truffle} provider-id)
                (:provider/operations provider)
                (:provider/transforms provider)
                (:provider/engines provider)
                (:provider/profiles provider)
                (get (:provider/formats provider) :halc)
                (get (:provider/formats provider) :hbc)]
               [true
                (if (= provider-id :rust)
                  [:validate :inspect :execute :disassemble :conform]
                  [:validate :inspect :transform :execute :disassemble :conform])
                (if (= provider-id :rust) [] [[:hal :halc]])
                (if (= provider-id :rust)
                  {:hbc :stack-vm}
                  {:halc :ast-lowering :hbc :reference-vm})
                (if (= provider-id :rust)
                  [:rust-stack-vm]
                  [:java-reference-vm])
                (if (= provider-id :rust)
                  [:validate :inspect]
                  [:validate :inspect :execute :conform])
                [:validate :inspect :execute :disassemble :conform]])

   (test-check "advertised transformation preserves exact provenance"
               (if (= provider-id :rust)
                 :compiler-free
                 (let [artifact
                       (vm/transform
                        "(ns tool.vm.sample) (def value 42)"
                        :halc
                        {:provider provider-id
                         :resource "tool/vm/sample.hal"})]
                   [(select-keys artifact
                                 [:artifact/format :artifact/version])
                    (:artifact/provenance artifact)
                    (vm/validate artifact)]))
               (if (= provider-id :rust)
                 :compiler-free
                 [{:artifact/format :halc
                   :artifact/version 1}
                  {:transform/provider provider-id
                   :transform/from :hal
                   :transform/to :halc
                   :transform/options {:resource "tool/vm/sample.hal"}
                   :transform/source-provenance nil}
                  true]))

   (test-check "current provider rejects unadvertised transforms without fallback"
               (select-keys
                (failure-data
                 (fn []
                   (vm/transform
                    "(+ 19 23)"
                    (if (= provider-id :rust) :halc :hbc)
                    {:provider provider-id})))
                [:type :operation :from :to :provider :available])
               {:type :tool.vm/capability-unavailable
                :operation :transform
                :from :hal
                :to (if (= provider-id :rust) :halc :hbc)
                :provider provider-id
                :available []})

   (test-check "authenticated HBC execution returns an ordinary Hara value"
               (vm/execute golden-hbc {:provider provider-id})
               42)

   (test-check "malformed HBC fails with provider and engine data before execution"
               (select-keys
                (failure-data
                 (fn []
                   (vm/execute malformed-hbc {:provider provider-id})))
                [:type :operation :format :provider :engine])
               {:type :tool.vm/execution-failed
                :operation :execute
                :format :hbc
                :provider provider-id
                :engine (if (= provider-id :rust) :stack-vm :reference-vm)})

   (test-check "portable conformance reports golden and malformed artifact cases"
               (let [report
                     (vm/conform hbc-corpus {:provider provider-id})]
                 (select-keys
                  report
                  [:corpus/id
                   :corpus/format
                   :conformance/provider
                   :conformance/engine
                   :conformance/passed
                   :conformance/failed]))
               {:corpus/id :tool.vm/hbc-cross-runtime
                :corpus/format :hbc
                :conformance/provider provider-id
                :conformance/engine
                (if (= provider-id :rust) :stack-vm :reference-vm)
                :conformance/passed 2
                :conformance/failed 0})

   (test-check "convenience namespaces construct exact portable artifacts"
               [(select-keys
                 (halc/artifact (str/encode-utf8 "HALC"))
                 [:artifact/format :artifact/version])
                (select-keys
                 (hbc/artifact (str/encode-utf8 "HBC0"))
                 [:artifact/format :artifact/version])]
               [{:artifact/format :halc :artifact/version 1}
                {:artifact/format :hbc :artifact/version 0}])

   (test-check "one-arity operations select the current provider explicitly"
               (select-keys
                (failure-data
                 (fn []
                   (halc/validate (str/encode-utf8 "HALC"))))
                [:type :operation :format :provider])
               {:type :tool.vm/artifact-invalid
                :operation :validate
                :format :halc
                :provider provider-id})

   (test-check "requesting another provider never falls back to the current runtime"
               (select-keys
                (failure-data
                 (fn []
                   (hbc/validate
                    (str/encode-utf8 "HBC0")
                    {:provider :not-current})))
                [:type :operation :format :provider :available])
               {:type :tool.vm/capability-unavailable
                :operation :validate
                :format :hbc
                :provider :not-current
                :available [provider-id]})

   (test-check "HALC does not acquire HBC-only disassembly by provider-wide inference"
               (select-keys
                (failure-data
                 (fn []
                   (vm/disassemble
                    (halc/artifact (str/encode-utf8 "HALC")))))
                [:type :operation :format :provider :available])
               {:type :tool.vm/capability-unavailable
                :operation :disassemble
                :format :halc
                :provider provider-id
                :available []})

   (test-check "provider options reject unknown routing keys"
               (select-keys
                (failure-data
                 (fn []
                   (hbc/inspect
                    (str/encode-utf8 "HBC0")
                    {:provider provider-id
                     :fallback :rust})))
                [:type :field :unknown])
               {:type :tool.vm/invalid-request
                :field :options
                :unknown [:fallback]})])

results
