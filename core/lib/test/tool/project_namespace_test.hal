(ns tool.project-namespace-test
  (:use code.test)
  (:require [tool.project :as project]))

(fact "project namespace inventory uses already-read native forms"
  [(project/namespace-from-forms
    '[(comment before) (ns demo.fast (:require [demo.dep])) (def value 1)])
   (project/namespace-from-forms
    '[(ns+ demo.extension) (def value 1)])
   (project/namespace-from-forms
    '[(comment no-namespace)])]
  => ["demo.fast" "demo.extension" nil])

(pr-str (run {:namespace "tool.project-namespace-test"}))
