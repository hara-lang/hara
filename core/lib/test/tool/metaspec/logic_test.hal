(ns tool.metaspec.logic-test
  (:use code.test)
  (:require [tool.metaspec.logic :as metaspec]
            [tool.metaspec.model :as model]
            [std.logic.kanren :as logic]
            [std.logic.relational :as relational]))

(def document
  {:document/id :demo/metaspec
   :document/type :demo/metaspec
   :document/version "0.1.0"
   :document/status :draft
   :document/title "Demo"
   :document/summary "Relational demo"
   :spec/conforms-to {:spec/id :demo/metaspec :spec/version "0.1.0"}
   :spec/artifact-kind :demo/artifact
   :meta/document-schema
   {:schema/id :demo/document
    :schema/type :map
    :schema/properties
    {:demo/value {:schema/ref :missing/value}}}
   :meta/schemas
   [{:schema/id :demo/value :schema/type :string}
    {:schema/id :demo/value :schema/type :string}]
   :meta/cross-references []
   :meta/requirements
   [{:requirement/id :demo/evidence
     :requirement/level :must
     :requirement/text "Evidence is required"}]
   :metaspec/generation
   {:generation/input {}
    :generation/output {}
    :generation/process []
    :generation/acceptance {}}})

^{:refer 'tool.metaspec.logic/analyze
  :id 'relational-metaspec-findings}
(fact "derives duplicate IDs, unresolved references, and missing evidence"
  (let [analysis (metaspec/analyze document)]
    [(empty? (:missing-required-keys analysis))
     (count (:duplicate-schemas analysis))
     (:unresolved-schema-references analysis)
     (:missing-evidence analysis)])
  => [true
      2
      [[[:meta/document-schema :schema/properties
         :demo/value :schema/ref]
        :missing/value]]
      [[:demo/evidence [:meta/requirements 0]]]])

^{:refer 'tool.metaspec.logic/compare-imperative
  :id 'imperative-relational-rule-parity}
(fact "maps relational results back to the imperative stable rule IDs"
  (:relational (metaspec/compare-imperative document))
  => {:required-key []
      :duplicate-id [:tool.metaspec.rule/duplicate-id]
      :schema-reference [:tool.metaspec.rule/schema-reference]
      :missing-evidence [:tool.metaspec.rule/missing-evidence]})

^{:refer 'tool.metaspec.logic/schema-refo
  :id 'bidirectional-schema-reference}
(fact "queries schema references bidirectionally through the shared projection"
  (let [projected (model/project document)]
    (relational/query*
     (fn [query]
       (logic/fresh
        (fn [path]
          (logic/all
           (metaspec/schema-refo projected path :missing/value)
           (logic/== query path)))))))
  => [[:meta/document-schema :schema/properties
       :demo/value :schema/ref]])

(pr-str (run '[tool.metaspec.logic-test]))
