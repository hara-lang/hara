(ns tool.sh.git-test
  (:use code.test)
  (:require [tool.sh.git :as git]))

(defn fake-runner
  [argv options]
  {:command argv :stdout "abc123" :stderr "" :exit 0})

(def results
  [(fact "Git roots use -C inside the argv vector"
     (git/command ["status" "--short"] {:root "/repo"})
     => ["git" "-C" "/repo" "status" "--short"])

   (fact "Git operations return the standard command result"
     (git/git ["rev-parse" "HEAD"] {:tool.sh/runner fake-runner})
     => {:command ["git" "rev-parse" "HEAD"]
         :stdout "abc123" :stderr "" :exit 0})

   (fact "rev-parse extracts canonical stdout"
     (git/rev-parse "HEAD" {:tool.sh/runner fake-runner})
     => "abc123")])

(pr-str (run '[tool.sh.git-test]))
