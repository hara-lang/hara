(ns tool.sh.docker-test
  (:use code.test)
  (:require [tool.sh.docker :as docker]))

(defn fake-runner
  [argv options]
  {:command argv :stdout "ok" :stderr "" :exit 0})

(def results
  [(fact "Docker map options are emitted deterministically"
     (docker/append-map ["docker" "run"] "-e" {"Z" "9" "A" "1"})
     => ["docker" "run" "-e" "A=1" "-e" "Z=9"])

   (fact "Docker run is an argv-only builder"
     (docker/run-command
      {:id :pg
       :image "postgres:16"
       :environment {"POSTGRES_USER" "hara"}
       :ports [5432]
       :cmd ["postgres" "-c" "fsync=off"]})
     => ["docker" "run"
         "-e" "POSTGRES_USER=hara"
         "-p" "127.0.0.1::5432"
         "-d" "--rm"
         "--add-host=host.docker.internal:host-gateway"
         "--name" "testing_pg" "postgres:16"
         "postgres" "-c" "fsync=off"])

   (fact "Docker execution accepts an injected runner"
     (docker/command-result ["docker" "version"] {:tool.sh/runner fake-runner})
     => {:command ["docker" "version"] :stdout "ok" :stderr "" :exit 0})])

(pr-str (run '[tool.sh.docker-test]))
