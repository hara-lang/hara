(ns tool.sh.domain-test
  (:use code.test)
  (:require [tool.sh.misc :as misc]
            [tool.sh.network :as network]
            [tool.sh.tmux :as tmux]))

(def results
  [(fact "tmux builders keep cwd and environment as arguments"
     (tmux/new-session-command "DEV" {:root "/repo" :env {:path "bin"}})
     => ["tmux" "new-session" "-d" "-s" "DEV" "-n" "CMD"
         "-c" "/repo" "-e" "PATH=bin"])

   (fact "network downloads are argv-only"
     (network/wget-command "https://example.test/" "a b" "out" ["--quiet"])
     => ["wget" "https://example.test/a b" "-O" "out" "--quiet"])

   (fact "desktop notification values are not shell quoted"
     (misc/notify-command :linux "Build ready" "Open + inspect")
     => ["notify-send" "Build ready" "Open + inspect"])

   (fact "terminal commands retain their argv boundaries"
     (misc/terminal-command :linux ["hara" "test" "name with spaces"])
     => ["x-terminal-emulator" "-e" "hara" "test" "name with spaces"])])

(pr-str (run '[tool.sh.domain-test]))
