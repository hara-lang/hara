(ns tool.package-test
  (:require [tool.package :as package]
            [tool.package.hbx :as hbx]))

(def results
  [(test-check "HBX is a distinct executable package format"
               [(mapv :format/id (package/formats))
                (package/spec)
                (package/detect (str/encode-utf8 "HBX0"))]
               [[:hbx]
                {:spec/id :hal/hbx0-wire
                 :spec/format :hbx
                 :spec/kind :wire
                 :spec/path "01-lang/010-bytecode/draft/hbx0-wire.edn"
                 :spec/corpora [:hal/hbx0-golden :hal/hbx0-malformed]}
                :hbx])
   (test-check "runtime capabilities distinguish builders from readers"
               (let [provider (package/current-provider)]
                 [(:provider/id provider)
                  (:provider/operations provider)])
               (if (= :rust (:provider/id (package/current-provider)))
                 [:rust [:validate :inspect :pack :unpack :conform]]
                 [:truffle [:validate :inspect :unpack :conform]]))
   (test-check "HBX convenience facade exposes the exact identity"
               [hbx/+format+ hbx/+version+]
               [:hbx 0])])

results
