(ns tool.cli.project-command-test
  (:require [tool.cli.project-command :as command]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "project names retain the native CLI contract"
              [(command/valid-name? "hello-app")
               (command/valid-name? "Hello")
               (command/valid-name? "")]
              [true false false])
  (test/check "dependency coordinates split at their final range marker"
              [(command/split-coordinate "hara:hara/graph@^1.2.0")
               (command/normalize-coordinate "official:hara/graph")
               (command/normalize-coordinate "hara/graph")]
              [["hara:hara/graph" "^1.2.0"]
               "hara:hara/graph"
               "hara:hara/graph"])
  (test/check "project sync modes are Hara-owned"
              [(command/sync-mode
                {:request/arguments [] :request/options {:offline true}})
               (command/sync-mode
                {:request/arguments ["--locked"] :request/options {}})]
              [:offline :locked])
  (test/check
   "project builds fail closed until the analyzer and pruned emitter exist"
   (let [result
         (command/build-unavailable-result
          {:project/id 'demo-app
           :project/version "0.1.0"
           :profile/name :production
           :profile/language :hara
           :profile/main 'app.main
           :build/entrypoints ['app.main/start]
           :build/keep-vars []
           :build/keep-namespaces []
           :build/output-bundle "target/demo-app-production.hbx"
           :build/output-report "target/demo-app-production.shake.edn"})]
     [(:result/outcome result)
      (:result/exit result)
      (get-in result [:result/data :build/report :shake/status])
      (str/includes? (get-in result [:result/data :build/report-source])
                     ":pending-analysis")])
   [:tool.cli.outcome/unavailable 2 :pending-analysis true])])
