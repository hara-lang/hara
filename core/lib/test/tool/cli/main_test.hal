(ns tool.cli.main-test
  (:require [tool.cli.main :as main]
            [tool.cli.model :as model]
            ))

(def manifest
  {:document/id :demo/cli
   :document/type :tool/cli-application
   :document/version "1.2.3"
   :document/status :stable
   :document/title "Demo"
   :document/summary "Demo CLI"
   :spec/conforms-to {:spec/id :demo/cli :spec/version "1"}
   :cli/apps []
   :cli/routes [{:route/id :demo.route/echo
                 :route/path ["echo"]
                 :route/aliases [["say"]]
                 :route/handler :demo.handler/echo
                 :route/tier :public
                 :route/summary "Echo"
                 :route/options []}]
   :cli/options []
   :cli/outcomes [{:outcome/id :tool.cli.outcome/success :outcome/exit 0}]
   :cli/handlers [{:handler/id :demo.handler/echo}]})

(def handlers
  {:demo.handler/echo
   (fn [request]
     (model/success {:arguments (:request/arguments request)
                     :alias (:request/alias request)}))})

(def context
  {:runtime/id :tool.runtime/rust
   :runtime/cwd "."
   :runtime/project nil
   :runtime/capabilities []})

[(test-check "Hara owns route resolution and closed handler dispatch"
              (:result/data
               (main/run manifest ["say" "hello"] context handlers))
              {:arguments ["hello"] :alias true})
  (test-check "global options reach handlers as ordinary data"
              (get-in
               (main/run manifest ["--offline" "echo"] context
                         {:demo.handler/echo
                          (fn [request]
                            (model/success (:request/options request)))})
               [:result/data :offline])
              true)
  (test-check "unknown routes have the stable usage exit"
              (:result/exit
               (main/run manifest ["missing"] context handlers))
              2)
  (test-check "help is generated from the manifest by Hara"
              (get-in (main/run manifest ["--help"] context handlers)
                      [:result/data :help/version])
              "1.2.3")]
