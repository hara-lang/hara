(ns tool.cli.model-test
  (:require [tool.cli.model :as model]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "outcome classes have stable exits"
              (vec
               (map model/outcome-exit
                    [:tool.cli.outcome/success
                     :tool.cli.outcome/failed
                     :tool.cli.outcome/read-error
                     :tool.cli.outcome/interrupted]))
              [0 1 2 130])
  (test/check "requests contain ordinary canonical data"
              (model/request
               :demo/run
               ["main.hal"]
               {:option/format :edn}
               {:runtime/id :tool.runtime/rust
                :runtime/cwd "."
                :runtime/project nil
                :runtime/capabilities []})
              {:request/route :demo/run
               :request/arguments ["main.hal"]
               :request/options {:option/format :edn}
               :request/runtime :tool.runtime/rust
               :request/cwd "."
               :request/project nil
               :request/capabilities []})
  (test/check "failed results cannot report a zero exit"
              (:result/exit
               (model/result :tool.cli.outcome/failed nil []))
              1)])
