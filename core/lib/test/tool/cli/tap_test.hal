(ns tool.cli.tap-test
  (:require [tool.cli.tap :as tap]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "tap arguments preserve repeated mirrors"
              (tap/parse-arguments
               ["demo" "--registry" "https://one"
                "--registry" "https://two" "--identity-key" "sha256:abc"])
              {:positionals ["demo"]
               :options {:registry ["https://one" "https://two"]
                         :identity-key "sha256:abc"}})
  (test/check "tap routes select Hara operations"
              (tap/operation-request
               {:request/route :tool.cli.route/tap-remove
                :request/arguments ["demo"]})
              {:operation :remove :arguments ["demo"]})])
