(ns tool.cli.options-test
  (:require [tool.cli.options :as options]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "global options remain separate from command argv"
              (options/parse ["--project=core" "--allow-process"
                              "manage" "ns-format" "code.manage"])
              {:action :run
               :options {:host "127.0.0.1" :port 1311
                         :project "core" :allow-process true}
               :arguments ["manage" "ns-format" "code.manage"]})
  (test/check "the option terminator preserves application arguments"
              (:arguments (options/parse ["--offline" "--" "-x" "--write"]))
              ["-x" "--write"])
  (test/check "help and version are launcher actions"
              (map (fn [argv] (:action (options/parse argv)))
                   [["--help"] ["-V"]])
              [:help :version])
  (test/check "numeric ports are validated"
              (:port (:options (options/parse ["--port" "0" "repl"])))
              0)])
