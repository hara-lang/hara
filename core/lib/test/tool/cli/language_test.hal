(ns tool.cli.language-test
  (:require [tool.cli.language :as language]
            ))

[(test-check "language evaluation results use the stable CLI protocol"
              (select-keys
               (language/evaluation-result 42 {:evaluation/project nil})
               [:result/outcome :result/exit :result/messages])
              {:result/outcome :tool.cli.outcome/success
               :result/exit 0
               :result/messages
               [{:message/stream :stdout :message/text "42\n"}]})
  (test-check "application results preserve stdout stderr and exit"
              (select-keys
               (language/application-result
                {:hara.app/stdout "ok\n"
                 :hara.app/stderr "note\n"
                 :hara.app/exit 7}
                {})
               [:result/outcome :result/exit :result/messages])
              {:result/outcome :tool.cli.outcome/success
               :result/exit 7
               :result/messages
               [{:message/stream :stdout :message/text "ok\n"}
                {:message/stream :stderr :message/text "note\n"}]})]
