(ns tool.cli.handlers-test
  (:require [tool.cli.handlers :as handlers]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "ported handlers live in the closed Hara registry"
              (sort (keys (handlers/registry)))
              [:tool.cli.handler/asset
               :tool.cli.handler/compile-halc
               :tool.cli.handler/eval
               :tool.cli.handler/extension
               :tool.cli.handler/identity
               :tool.cli.handler/lint
               :tool.cli.handler/manage
               :tool.cli.handler/package
               :tool.cli.handler/project-add
               :tool.cli.handler/project-build
               :tool.cli.handler/project-check
               :tool.cli.handler/project-new
               :tool.cli.handler/project-remove
               :tool.cli.handler/project-run
               :tool.cli.handler/project-sync
               :tool.cli.handler/project-test
               :tool.cli.handler/project-update
               :tool.cli.handler/remote
               :tool.cli.handler/repl
               :tool.cli.handler/run-file
               :tool.cli.handler/seedgen
               :tool.cli.handler/server
               :tool.cli.handler/snapshot
               :tool.cli.handler/spec
               :tool.cli.handler/stdin
               :tool.cli.handler/tap])])
