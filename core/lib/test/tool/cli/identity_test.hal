(ns tool.cli.identity-test
  (:require [tool.cli.identity :as identity]
            ))

[(test-check "identity enrollment bytes are stable"
              (identity/canonical-enrollment
               "hara" "alice"
               "abababababababababababababababababababababababababababababababab"
               "challenge-1")
              (str "{:enrollment/format \"0.0.0-alpha\" :enrollment/tap \"hara\""
                   " :enrollment/provider :github :enrollment/owner \"alice\""
                   " :enrollment/public-key \"abababababababababababababababababababababababababababababababab\""
                   " :enrollment/challenge \"challenge-1\"}\n"))
  (test-check "identity key material requires lowercase 32-byte hex"
              [(identity/valid-hex?
                "abababababababababababababababababababababababababababababababab" 32)
               (identity/valid-hex?
                "ABABABABABABABABABABABABABABABABABABABABABABABABABABABABABAB" 32)]
              [true false])
  (test-check "identity routes resolve in Hara"
              (identity/operation-request
               {:request/route :tool.cli.route/id-status :request/arguments []})
              {:operation :status :arguments []})
  (test-check "identity one-shot input uses canonical stdin"
              (identity/run-process ["cat"] "signed\n")
              {:stdout "signed\n" :stderr "" :exit 0})
  (test-check "identity failure preserves its public error shape"
              (try
                (identity/run-process
                 ["sh" "-c" "printf 'bad\n' >&2; exit 12"] nil)
                nil
                (catch Throwable error
                  [(ex-message error) (ex-data error)]))
              ["bad" {:stdout "" :stderr "bad\n" :exit 12}])]
