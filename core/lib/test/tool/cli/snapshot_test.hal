(ns tool.cli.snapshot-test
  (:require [tool.cli.snapshot :as snapshot]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "snapshot options are parsed in Hara"
              (snapshot/parse-arguments
               ["input.edn" "--output" "output.hss"])
              {:positionals ["input.edn"]
               :options {:output "output.hss"}})])
