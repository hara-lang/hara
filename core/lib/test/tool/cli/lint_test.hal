(ns tool.cli.lint-test
  (:use code.test)
  (:require [tool.cli.lint :as cli]
            [tool.lint :as lint]))

^{:refer 'tool.cli.lint/parse-arguments
  :id 'schema-mode-cli}
(fact "parses schema mode independently from output format and paths"
  (cli/parse-arguments
   ["--schema-mode" "error" "--format" "edn" "src"])
  => {:format :edn :schema-mode :error :paths ["src"]})

^{:refer 'tool.cli.lint/parse-arguments
  :id 'schema-mode-cli-validation}
(fact "rejects missing and unsupported schema modes"
  [(try (cli/parse-arguments ["--schema-mode"])
        :missing-error
        (catch Exception _ :error))
   (try (cli/parse-arguments ["--schema-mode" "strict"])
        :missing-error
        (catch Exception _ :error))]
  => [:error :error])

^{:refer 'tool.lint/project-options
  :id 'schema-mode-project-precedence}
(fact "uses analyzer options ahead of project lint configuration"
  [(lint/project-options {:lint {:schema-mode :error}} {})
   (lint/project-options {:lint {:schema-mode :error}}
                         {:schema-mode :off})]
  => [{:schema-mode :error}
      {:schema-mode :off}])

(pr-str (run '[tool.cli.lint-test]))
