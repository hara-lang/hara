(ns tool.cli.asset-test
  (:require [tool.cli.asset :as asset]
            ))

[(test-check "asset routes resolve to Hara operations"
              (asset/operation-request
               {:request/route :tool.cli.route/asset-build
                :request/arguments ["collection"]})
              {:operation :build :arguments ["collection"]})
  (test-check "asset paths normalize portable separators"
              (asset/safe-path "images\\hero.png")
              "images/hero.png")
  (test-check "asset paths reject parent traversal"
              (try
                (asset/safe-path "../escape")
                false
                (catch Throwable error true))
              true)
  (test-check "asset output options retain CLI compatibility"
              (asset/option-value ["collection" "--output" "manifest.edn"]
                                  "--output")
              "manifest.edn")]
