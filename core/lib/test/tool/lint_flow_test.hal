(ns tool.lint.flow-test
  (:use code.test)
  (:require [tool.lint.analyze :as analyze]
            [tool.lint.flow :as flow]
            [work.base :as work]
            [work.flow.task :as task]))

(def +scans+
  [(analyze/scan-source
    "(ns demo.a)\n(def x 1)"
    {:file "a.hal"})
   (analyze/scan-source
    "(ns demo.b)\ndemo.a/x\nmissing"
    {:file "b.hal"})])

^{:refer 'tool.lint.flow/lint-scans
  :id 'project-context-and-stable-order}
(fact "prepares project context before ordered task item analysis"
  (let [output (flow/lint-scans +scans+)
        definition
        (get-in (work/work-spec flow/lint-scans-work)
                [:template/definition])]
    [(task/task-work? flow/lint-scans-work)
     (get-in definition [:execution :parallel])
     (get-in definition [:execution :order])
     (vec (map (fn [document]
                 (get-in document [:namespace :name]))
               (:documents output)))
     (vec (map :type (:findings output)))
     (:summary output)])
  => [true
      false
      :input
      [demo.a demo.b]
      [:tool.lint/unresolved-symbol]
      {:total 1 :error 1 :warning 0}])

^{:refer 'tool.lint.flow/prepare-scans
  :id 'shared-namespace-context}
(fact "discovers all project namespaces before any document runs"
  (:known-namespaces (flow/prepare-scans +scans+ {}))
  => #{demo.a demo.b})

(pr-str (run '[tool.lint.flow-test]))
