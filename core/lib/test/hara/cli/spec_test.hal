(ns hara.cli.spec-test
  (:require [hara.cli.spec :as spec]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "spec route operations and formats are Hara-owned"
              [(spec/operation-request
                {:request/route :hara.cli.route/spec
                 :request/arguments ["lint" "demo.edn"]})
               (spec/parse-format ["demo.edn" "--format" "edn"])]
              [{:operation :lint :arguments ["demo.edn"]}
               {:format :edn :arguments ["demo.edn"]}])
  (test/check "the normative metaspec template is emitted by Hara"
              (select-keys (spec/template [])
                           [:result/outcome :result/exit :result/data])
              {:result/outcome :hara.cli.outcome/success
               :result/exit 0
               :result/data spec/+template+})])
