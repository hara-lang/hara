(ns hara.cli.handlers-test
  (:require [hara.cli.handlers :as handlers]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "ported handlers live in the closed Hara registry"
              (sort (keys (handlers/registry)))
              [:hara.cli.handler/manage
               :hara.cli.handler/project-test
               :hara.cli.handler/seedgen])])
