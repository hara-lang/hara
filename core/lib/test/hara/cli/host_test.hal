(ns hara.cli.host-test
  (:require [hara.cli.host :as host]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "interactive routes return closed host actions"
              (:result/data
               (host/execute
                {:request/route :hara.cli.route/remote
                 :request/arguments ["127.0.0.1:1311"]}))
              {:host/action :remote
               :host/arguments ["127.0.0.1:1311"]})])
