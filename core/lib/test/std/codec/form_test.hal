(ns std.codec.form-test
  (:use code.test)
  (:require [std.codec.form :as form]))

(def results
  [(fact "forms are deterministic, nested, indexed and nil-free"
     (form/encode {:name "Hara λ"
                   :items ["a b" "+"]
                   :nested {:enabled true :missing nil}})
     => "items[0]=a%20b&items[1]=%2B&name=Hara%20%CE%BB&nested[enabled]=true")

   (fact "form pairs expose the portable flattened representation"
     (form/pairs {:items [1 2]})
     => [["items[0]" "1"] ["items[1]" "2"]])

   (fact "form encoding requires a map"
     (try (form/encode [1 2]) false (catch Throwable error true))
     => true)])

(pr-str (run '[std.codec.form-test]))
