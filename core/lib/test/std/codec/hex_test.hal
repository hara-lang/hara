(ns std.codec.hex-test
  (:use code.test)
  (:require [std.codec.hex :as hex]))

(def results
  [(fact "hex uses lowercase UTF-8 output"
     (hex/encode "Hara λ")
     => "4861726120cebb")

   (fact "hex round trips bytes"
     (= (hex/decode "00ff10") (bytes 0 255 16))
     => true)

   (fact "hex rejects odd and invalid input"
     [(try (hex/decode "0") false (catch Throwable error true))
      (try (hex/decode "zz") false (catch Throwable error true))]
     => [true true])])

(pr-str (run '[std.codec.hex-test]))
