(ns std.codec.base64-test
  (:use code.test)
  (:require [std.codec.base64 :as base64]))

(def results
  [(fact "Base64 emits canonical RFC 4648 padding"
     [(base64/encode "")
      (base64/encode "f")
      (base64/encode "fo")
      (base64/encode "foo")
      (base64/encode "foobar")]
     => ["" "Zg==" "Zm8=" "Zm9v" "Zm9vYmFy"])

   (fact "Base64 decodes portable bytes"
     (= (base64/decode "SGFyYSDOuw==") (str/encode-utf8 "Hara λ"))
     => true)

   (fact "Base64 rejects malformed and non-canonical values"
     [(try (base64/decode "abc") false (catch Throwable error true))
      (try (base64/decode "Zg=A") false (catch Throwable error true))
      (try (base64/decode "Zh==") false (catch Throwable error true))]
     => [true true true])])

(pr-str (run '[std.codec.base64-test]))
