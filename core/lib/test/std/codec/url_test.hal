(ns std.codec.url-test
  (:use code.test)
  (:require [std.codec.url :as url]))

(def results
  [(fact "URL components distinguish spaces from literal plus"
     (url/encode "Hara + λ")
     => "Hara%20%2B%20%CE%BB")

   (fact "URL components decode UTF-8 and leave plus literal"
     [(url/decode "Hara%20%2B%20%CE%BB")
      (url/decode "a+b")]
     => ["Hara + λ" "a+b"])

   (fact "URL components reject incomplete and invalid escapes"
     [(try (url/decode "%") false (catch Throwable error true))
      (try (url/decode "%GG") false (catch Throwable error true))]
     => [true true])])

(pr-str (run '[std.codec.url-test]))
