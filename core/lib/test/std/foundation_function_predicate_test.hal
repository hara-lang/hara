(ns std.foundation-function-predicate-test
  (:use code.test))

(defstruct Invokable [value])

(extend-type Invokable IFn
  (invoke [self] (:value self)))

(def results
  [(fact "distinguishes IFn values from native function values"
     (let [function (fn [value] value)
           pointer (pointer {:context :kernel :id "ROOT"})]
       [[(fn? function) (function? function)]
        [(fn? inc) (function? inc)]
        [(fn? :key) (function? :key)]
        [(fn? {:key 1}) (function? {:key 1})]
        [(fn? #{:key}) (function? #{:key})]
        [(fn? Invokable) (function? Invokable)]
        [(fn? pointer) (function? pointer)]
        [(fn? (Invokable 1)) (function? (Invokable 1))]
        [(fn? 42) (function? 42)]
        (nil? (resolve 'callable?))])
     => [[true true]
         [true true]
         [true false]
         [true false]
         [true false]
         [true false]
         [true false]
         [true false]
         [false false]
         true])])

(pr-str (run '[std.foundation-function-predicate-test]))
