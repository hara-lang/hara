^{:refer std.block.construct/max-width :added "3.0"}
(do (base/block-info (parse/parse-string "\"\n\"")) (Test/run [{:name "gets the max width of given block, along with starting offset #1", :test (fn [] [(max-width (parse/parse-string "")) (base/block-info (parse/parse-string ""))]), :expected [0 {:type :void, :tag :eof, :string "", :height 0, :width 0}]} {:name "gets the max width of given block, along with starting offset #2", :test (fn [] [(max-width (parse/parse-root "")) (base/block-info (parse/parse-root ""))]), :expected [0 {:type :container, :tag :root, :string "", :height 0, :width 0}]} {:name "gets the max width of given block, along with starting offset #3", :test (fn [] [(max-width (parse/parse-string "\"\n\"")) (base/block-info (parse/parse-string "\"\n\""))]), :expected [1 {:type :token, :tag :string, :string "\"\n\"", :height 1, :width 1}]} {:name "gets the max width of given block, along with starting offset #4", :test (fn [] (base/block-info (parse/parse-string "\"\n\n\""))), :expected {:type :token, :tag :string, :string "\"\n\n\"", :height 2, :width 1}} {:name "gets the max width of given block, along with starting offset #5", :test (fn [] (base/block-info (block [:very-long-line (construct/newline) (void) 2]))), :expected {:type :container, :tag :vector, :string "[:very-long-line\n 2]", :height 1, :width 3}} {:name "gets the max width of given block, along with starting offset #6", :test (fn [] (max-width (block [:very-long-line (construct/newline) (void) 2]))), :expected 16} {:name "gets the max width of given block, along with starting offset #7", :test (fn [] (max-width (block [:very-long-line (construct/newline) (void) 2]) 10)), :expected 16} {:name "gets the max width of given block, along with starting offset #8", :test (fn [] (max-width (block [(construct/newline) (void) :very-long-line (construct/newline) (void) 2]))), :expected 16} {:name "gets the max width of given block, along with starting offset #9", :test (fn [] (max-width (block [(construct/newline) (void) :very-long-line (construct/newline) (void) 2]) 10)), :expected 6}] migration-test-check))

^{:refer std.block.construct/line-width :added "4.0"}
(Test/run
 [{:name "get the width at the line which it finishes #1"
   :test (fn [] (line-width (block [:very-long-line (construct/newline) (void) 2])))
   :expected 3}
  {:name "get the width at the line which it finishes #2"
   :test (fn [] (line-width (block [:very-long-line (construct/newline) (void) 2]) 3))
   :expected 0}]
 migration-test-check)

^{:refer std.block.construct/rep :added "4.0"}
(Test/run
 [{:name "returns the clojure forms representation of the dsl"
   :test (fn [] (rep (block [1 2 3 4])))
   :expected [1 2 3 4]}]
 migration-test-check)

^{:refer std.block.construct/get-lines :added "4.0"}
(Test/run
 [{:name "gets the lines for a block"
   :test (fn []
             (get-lines (block [(construct/newline) (void) :very-long-line (construct/newline) (void) 2])))
   :expected ["[" " :very-long-line" " 2]"]}]
 migration-test-check)

^{:refer std.block.construct/line-split :added "4.0"}
(Test/run
 [{:name "splits a block collection into  #1"
   :test (fn []
             (std.block.base/block-representation (line-split (block [(construct/newline) (void) :very-long-line (construct/newline) (void) 2]))))
   :expected "{:tag :vector, :lines [[] [␣ :very-long-line] [␣ 2]]}"}
  {:name "splits a block collection into  #2"
   :test (fn []
             (rep (line-split (block [(construct/newline) 1
                                      (construct/newline) [(construct/newline)
                                                           2
                                                           (construct/newline)
                                                           [(construct/newline) 3 (construct/newline)]]]))))
   :expected {:tag :vector
              :lines [[] [1] [{:lines [[] [2] [{:lines [[] [3]] :tag :vector}]] :tag :vector}]]}}]
 migration-test-check)

^{:refer std.block.construct/line-restore :added "4.0"}
(Test/run
 [{:name "restores a dom rep, adding body indentation #1"
   :test (fn []
             (mapv (fn [offset]
                       (std.block.base/block-representation (line-restore (line-split (block [(construct/newline) (void) :very-long-line (construct/newline) (void) 2]))
                                                                          offset)))
                   [0 2 5 10]))
   :expected ["[
 :very-long-line
 2]" "[
   :very-long-line
   2]"
              "[
      :very-long-line
      2]" "[
           :very-long-line
           2]"]}
  {:name "restores a dom rep, adding body indentation #2"
   :test (fn []
             (mapv (fn [offset]
                       (std.block.base/block-representation (line-restore (line-split (parse/parse-string "(defn add 
  []
  (+ x y))"))
                                                                          offset)))
                   [0 2 5 10]))
   :expected ["(defn add 
  []
  (+ x y))" "(defn add 
    []
    (+ x y))"
              "(defn add 
       []
       (+ x y))" "(defn add 
            []
            (+ x y))"]}]
 migration-test-check)

^{:refer std.block.construct/indent-body :added "4.0"}
(Test/run
 [{:name "indents the body given offset"
   :test (fn []
             (std.block.base/block-representation (indent-body (block [1 2 (construct/newline) 3 4]) 5)))
   :expected "[1 2
     3 4]"}]
 migration-test-check)
