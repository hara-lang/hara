(ns std.block.construct-test
  (:require [std.block.base :as base]
    [std.block.construct :refer :all :as construct]
    [std.block.parse :as parse]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic])
  (:config {:override [empty newline comment]}))

(defn migration-test-check
  [test expected]
  (let [result (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

(defn migration-meta-tree
  [value]
  (let [metadata   (select-keys (or (meta value) {}) [:readable-len :tag :spec])
        normalized (cond
                    (vector? value) (mapv migration-meta-tree value)
                    (map? value)    (reduce-kv
                                     (fn
                                      [output key item] (assoc output (migration-meta-tree key) (migration-meta-tree item))) {}
                                     value)
                    (set? value)    (set (map migration-meta-tree value))
                    (seq? value)    (apply list (map migration-meta-tree value))
                    :else           value)]
    {:meta metadata :value normalized}))

^{:refer std.block.construct/void :added "3.0"}
(Test/run
 [{:name "creates a void block"
   :test (fn [] (std.block.base/block-representation (void)))
   :expected "␣"}]
 migration-test-check)

^{:refer std.block.construct/space :added "3.0"}
(Test/run
 [{:name "creates a space block"
   :test (fn [] (std.block.base/block-representation (space)))
   :expected "␣"}]
 migration-test-check)

^{:refer std.block.construct/spaces :added "3.0"}
(Test/run
 [{:name "creates multiple space blocks"
   :test (fn [] (apply str (map std.block.base/block-representation (spaces 5))))
   :expected "␣␣␣␣␣"}]
 migration-test-check)

^{:refer std.block.construct/tab :added "3.0"}
(Test/run [{:name "creates a tab", :test (fn [] (std.block.base/block-representation (tab))), :expected "\\t"}] migration-test-check)

^{:refer std.block.construct/tabs :added "3.0"}
(Test/run [{:name "creates multiple tabs", :test (fn [] (apply str (map std.block.base/block-representation (tabs 5)))), :expected "\\t\\t\\t\\t\\t"}] migration-test-check)

^{:refer std.block.construct/newline :added "3.0"}
(Test/run [{:name "creates a newline", :test (fn [] (std.block.base/block-representation (construct/newline))), :expected "\\n"}] migration-test-check)

^{:refer std.block.construct/newlines :added "3.0"}
(Test/run [{:name "creates multiple newlines", :test (fn [] (apply str (map std.block.base/block-representation (newlines 5)))), :expected "\\n\\n\\n\\n\\n"}] migration-test-check)

^{:refer std.block.construct/newline? :added "4.0"}
(Test/run
 [{:name "checks if a block is a newline"
   :test (fn [] (newline? (construct/newline)))
   :expected true}]
 migration-test-check)

^{:refer std.block.construct/comment :added "3.0"}
(Test/run
 [{:name "creates a comment block"
   :test (fn [] (std.block.base/block-representation (construct/comment ";hello")))
   :expected ";hello"}]
