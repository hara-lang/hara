(ns std.block.value-test
  (:require [std.block.base :as base]
    [std.block.construct :as construct]
    [std.block.parse :as parse]
    [std.block.value :refer :all]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic]))

(defn migration-test-check
  [test expected]
  (let [result (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

^{:refer std.block.value/apply-modifiers :added "3.0"}
(Test/run
 [{:name "applys the modifiers within a container"
   :test (fn [] (apply-modifiers [(construct/uneval) (construct/uneval) 1 2 3]))
   :expected [3]}]
 migration-test-check)

^{:refer std.block.value/child-values :added "3.0"}
(Test/run
 [{:name "returns child values of a container"
   :test (fn [] (child-values (parse/parse-string "[1 #_2 3]")))
   :expected [1 3]}]
 migration-test-check)

^{:refer std.block.value/root-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :root block"
   :test (fn [] (root-value (parse/parse-root "1 2 3")))
   :expected (quote (do 1 2 3))}]
 migration-test-check)

^{:refer std.block.value/from-value-string :added "3.0"}
(Test/run
 [{:name "reads value from value-string"
   :test (fn [] (from-value-string (parse/parse-string "(+ 1 1)")))
   :expected (quote (+ 1 1))}]
 migration-test-check)

^{:refer std.block.value/list-value :added "3.0"}
(Test/run
 [{:name "returns the value of an :list block"
   :test (fn [] (list-value (parse/parse-string "(+ 1 1)")))
   :expected (quote (+ 1 1))}]
 migration-test-check)

^{:refer std.block.value/map-value :added "3.0"}
(Test/run
 [{:name "returns the value of an :map block #1"
   :test (fn [] (map-value (parse/parse-string "{1 2 3 4}")))
   :expected {1 2 3 4}}
  {:name "returns the value of an :map block #2"
   :test (fn [] (map-value (parse/parse-string "{1 2 3}")))
   :expected (checker/throws)}]
 migration-test-check)

^{:refer std.block.value/set-value :added "3.0"}
(Test/run
 [{:name "returns the value of an :set block"
   :test (fn [] (set-value (parse/parse-string "#{1 2 3 4}")))
   :expected #{1 4 3 2}}]
 migration-test-check)

^{:refer std.block.value/vector-value :added "3.0"}
(Test/run
 [{:name "returns the value of an :vector block"
   :test (fn [] (vector-value (parse/parse-string "[1 2 3 4]")))
   :expected [1 2 3 4]}]
 migration-test-check)

^{:refer std.block.value/deref-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :deref block"
   :test (fn [] (deref-value (parse/parse-string "@hello")))
   :expected (quote (deref hello))}]
 migration-test-check)

^{:refer std.block.value/meta-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :meta block #1"
   :test (fn []
             ((juxt meta identity) (meta-value (parse/parse-string "^:dynamic {:a 1}"))))
   :expected [{:dynamic true} {:a 1}]}
  {:name "returns the value of a :meta block #2"
   :test (fn []
             ((juxt meta identity) (meta-value (parse/parse-string "^String {:a 1}"))))
   :expected [{:tag (quote String)} {:a 1}]}]
 migration-test-check)

^{:refer std.block.value/quote-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :quote block"
   :test (fn [] (quote-value (parse/parse-string "'hello")))
   :expected (quote (quote hello))}]
 migration-test-check)

^{:refer std.block.value/var-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :var block"
   :test (fn [] (var-value (parse/parse-string "#'hello")))
   :expected (quote (var hello))}]
 migration-test-check)

^{:refer std.block.value/hash-keyword-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :hash-keyword block"
   :test (fn [] (hash-keyword-value (parse/parse-string "#:hello{:a 1 :b 2}")))
   :expected {:hello/a 1 :hello/b 2}}]
 migration-test-check)

^{:refer std.block.value/select-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :select block"
   :test (fn [] (select-value (parse/parse-string "#?(:clj hello)")))
   :expected (quote (? {:clj hello}))}]
 migration-test-check)

^{:refer std.block.value/select-splice-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :select-splice block"
   :test (fn [] (select-splice-value (parse/parse-string "#?@(:clj hello)")))
   :expected (quote (?-splicing {:clj hello}))}]
 migration-test-check)

^{:refer std.block.value/unquote-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :unquote block"
   :test (fn [] (unquote-value (parse/parse-string "~hello")))
   :expected (quote (unquote hello))}]
 migration-test-check)

^{:refer std.block.value/unquote-splice-value :added "3.0"}
(Test/run
 [{:name "returns the value of a :unquote-splice block"
   :test (fn [] (unquote-splice-value (parse/parse-string "~@hello")))
   :expected (quote (unquote-splicing hello))}]
 migration-test-check)
