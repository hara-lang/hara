   :expected ["#{:a 1 :b" "  2}"]}]
 migration-test-check)

^{:refer std.block.layout.common/layout-multiline-vector :added "4.0"}
(do
 (bind/layout-default-fn
  (with-meta (vector (quote col-align) (quote columns)) {:spec {:columns 1}})
  {})
 (Test/run
  [{:name "layouts the vector #1"
    :test (fn []
              (-> (common/layout-multiline-vector [:a 1 :b 2] {:spec {:col-align true}})
                  (base/block-string) (std.foundation.string/split-lines)))
    :expected ["[:a" " 1" " :b" " 2]"]}
   {:name "layouts the vector #2"
    :test (fn []
              (binding [common/*layout-fn* bind/layout-default-fn]
                       (-> (common/layout-multiline-vector (vector (Algo/ordered-map :keys
                                                                                     (with-meta (vector (quote col-align) (quote columns))
                                                                                                {:readable-len 10 :spec {:columns 1}}) :as
                                                                                     (quote spec))
                                                                   (list (quote merge) (Algo/ordered-map :columns 2 :col-align false) (quote spec)) (quote hello)
                                                                   (quote world))
                                                           {:spec {:col-align true :columns 2}})
                           (base/block-string) (std.foundation.string/split-lines))))
    :expected ["[{:keys [col-align" "         columns]"
               "  :as spec}        (merge {:col-align false :columns 2}" "                          spec)"
               " hello             world]"]}
   {:name "layouts the vector #3"
    :test (fn []
              (binding [common/*layout-fn* bind/layout-default-fn]
                       (-> (bind/layout-default-fn (list (quote let)
                                                         (vector (Algo/ordered-map :keys
                                                                                   (vector (quote col-align) (quote columns)) :as
                                                                                   (quote spec))
                                                                 (list (quote merge) (Algo/ordered-map :columns 2 :col-align false) (quote spec)) (quote hello)
                                                                 (quote world)))
                                                   {})
                           (base/block-string) (std.foundation.string/split-lines))))
    :expected ["(let [{:keys [col-align" "              columns]"
               "       :as spec}        (merge {:col-align false :columns 2}" "                               spec)"
               "      hello             world])"]}]
  migration-test-check))

^{:refer std.block.layout.common/layout-with-bindings :added "4.0"}
(Test/run
 [{:name "layout with bindings #1"
   :test (fn []
             (-> (common/layout-with-bindings (list (quote let)
                                                    (vector (quote a) 1 (quote b) 2) (list (quote +) (quote a) (quote b))
                                                    (list (quote +) (quote a) (quote b)) (list (quote +) (quote a) (quote b)))
                                              {})
                 (base/block-string) (std.foundation.string/split-lines)))
   :expected ["(let [a 1 b 2]" " (+ a b)" " (+ a b)" " (+ a b))"]}
  {:name "layout with bindings #2"
   :test (fn []
             (-> (common/layout-with-bindings (list (quote binding)
                                                    (vector (quote *ns*) 1) (list (quote do) (list (quote make-something-with) (quote *ns*) 1 2 3)))
                                              {})
                 (base/block-string) (std.foundation.string/split-lines)))
   :expected ["(binding [*ns* 1]" " (do (make-something-with *ns* 1 2 3)))"]}]
 migration-test-check)

^{:refer std.block.layout.common/layout-multiline-basic :added "4.0"}
(Test/run
 [{:name "layout standard multiline forms"
   :test (fn []
             (-> (common/layout-multiline-basic (list (quote apply) 1 2 3 4) {:indents 0})
                 (base/block-string) (std.foundation.string/split-lines)))
   :expected ["(apply 1" "       2" "       3" "       4)"]}]
 migration-test-check)

^{:refer std.block.layout/layout-default-fn-fix :added "4.0"}
(Test/run
 [{:name "layout standard vectors as 1 column, but bindings as 2 #1"
   :test (fn [] (split-block [:a 1 :b 2 :c 3]))
   :expected ["[:a 1 :b 2 :c 3]"]}
  {:name "layout standard vectors as 1 column, but bindings as 2 #2"
   :test (fn [] (split-block [:this-is-long-1 :this-is-long-2 :this-is-long-3]))
   :expected ["[:this-is-long-1" " :this-is-long-2" " :this-is-long-3]"]}
  {:name "layout standard vectors as 1 column, but bindings as 2 #3"
   :test (fn []
             (split-block (list (quote let)
                                (vector (quote variable-a)
                                        100 (quote variable-b)
                                        200 (quote variable-c)
                                        (list (quote +) (quote variable-a) (quote variable-b))) (list (quote println) (quote variable-c)))))
   :expected ["(let [variable-a 100" "      variable-b 200"
              "      variable-c (+ variable-a variable-b)]" "  (println variable-c))"]}
  {:name "layout standard vectors as 1 column, but bindings as 2 #4"
   :test (fn []
             (split-block (list (quote cond)
                                (list (quote =) (quote x) 1) :one
                                (list (quote =) (quote x) 2) :two
                                :else :other)))
   :expected ["(cond (= x 1) :one" "      (= x 2) :two" "      :else   :other)"]}]
 migration-test-check)
