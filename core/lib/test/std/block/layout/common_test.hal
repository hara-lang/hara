^{:refer std.block.layout.common/layout-multiline-list :added "4.0"}
(Test/run [{:name "layout standard paired inputs #1", :test (fn [] (-> (common/layout-multiline-list (list (quote defn) (quote hello) "oeuoeu" (Algo/ordered-map :add 1) (vector (quote x)) (list (quote +) (quote x) 1)) {:spec {:col-from 1, :col-start 2}}) (base/block-string) (std.foundation.string/split-lines))), :expected ["(defn hello" "  \"oeuoeu\"" "  {:add 1}" "  [x]" "  (+ x 1))"]} {:name "layout standard paired inputs #2", :test (fn [] (-> (common/layout-multiline-list (list (quote assoc) (quote hello) :key1 (quote val) :key2-oeueu-oeue (quote val2)) {:spec {:columns 2, :col-from 1, :col-align true}}) (base/block-string) (std.foundation.string/split-lines))), :expected ["(assoc hello" "       :key1            val" "       :key2-oeueu-oeue val2)"]} {:name "layout standard paired inputs #3", :test (fn [] (-> (common/layout-multiline-list (list (quote assoc) (quote hello) :key1 (quote val) :key2-oeueu-oeue (quote val2)) {:spec {:columns 2, :col-from 1, :col-align false}}) (base/block-string) (std.foundation.string/split-lines))), :expected ["(assoc hello" "       :key1 val" "       :key2-oeueu-oeue val2)"]} {:name "layout standard paired inputs #4", :test (fn [] (-> (common/layout-multiline-list (list (quote hash-map) :key1 (quote val) :key2-oeueu-oeue (quote val2)) {:spec {:columns 2, :col-from 0, :col-align true}}) (base/block-string) (std.foundation.string/split-lines))), :expected ["(hash-map :key1            val" "          :key2-oeueu-oeue val2)"]} {:name "layout standard paired inputs #5", :test (fn [] (-> (common/layout-multiline-list (list (quote hash-map) :key1 (quote val) :key2-oeueu-oeue (quote val2)) {:spec {:columns 2, :col-from 0, :col-align false}}) (base/block-string) (std.foundation.string/split-lines))), :expected ["(hash-map :key1 val" "          :key2-oeueu-oeue val2)"]} {:name "layout standard paired inputs #6", :test (fn [] (-> (common/layout-multiline-list (list (quote case) (list (quote type)) :a 1 :b 2) {:spec {:columns 2, :col-from 1, :col-start 2}}) (base/block-string) (std.foundation.string/split-lines))), :expected ["(case (type)" "  :a 1" "  :b 2)"]} {:name "layout standard paired inputs #7", :test (fn [] (-> (common/layout-multiline-list (list (quote something) (quote to) (quote do) (list (quote type)) :a 1 :b 2) {:spec {:columns 2, :col-from 3, :col-start 2}}) (base/block-string) (std.foundation.string/split-lines))), :expected ["(something to do (type)" "  :a 1" "  :b 2)"]} {:name "layout standard paired inputs #8", :test (fn [] (-> (common/layout-multiline-list (list (quote something) (quote to) (quote do) (list (quote type)) :a 1 :b 2) {:spec {:columns 2, :col-from 3, :col-start 2}}) (base/block-string) (std.foundation.string/split-lines))), :expected ["(something to do (type)" "  :a 1" "  :b 2)"]}] migration-test-check)

^{:refer std.block.layout.common/layout-multiline-hiccup :added "4.0"}
(do
 (->
  (common/layout-multiline-hiccup
   [:hello {:a 1 :b 2} [:world {}]]
   {:spec {:col-from 1 :col-start 1}})
  (base/block-string)
  (std.foundation.string/split-lines))
 ["[:hello {:a 1 :b 2}" " [:world {}]]"]
 (Test/run
  [{:name "generates hiccup code"
    :test (fn []
              (-> (common/layout-multiline-hiccup [:hello {:a 1 :b 2} [:world {}]]
                                                  {:spec {:col-from 0 :col-start 1}})
                  (base/block-string) (std.foundation.string/split-lines)))
    :expected ["[:hello" " {:a 1 :b 2}" " [:world {}]]"]}]
  migration-test-check))

^{:refer std.block.layout.common/layout-multiline-paired :added "4.0"}
(do
 (->
  (common/layout-multiline-paired
   (list (quote something) (quote to) (quote do) (list (quote type)) :a 1 :b 2)
   {:spec {:col-from 3 :col-start 2}})
  (base/block-string)
  (std.foundation.string/split-lines))
 (Test/run
  [{:name "layout standard paired inputs #1"
    :test (fn []
              (-> (common/layout-multiline-paired (list (quote assoc)
                                                        (quote hello) :key1
                                                        (quote val) :key2-oeueu-oeue
                                                        (quote val2))
                                                  {:spec {:col-align true :col-from 1}})
                  (base/block-string) (std.foundation.string/split-lines)))
    :expected ["(assoc hello" "       :key1            val" "       :key2-oeueu-oeue val2)"]}
   {:name "layout standard paired inputs #2"
    :test (fn []
              (-> (common/layout-multiline-paired (list (quote assoc)
                                                        (quote hello) :key1
                                                        (quote val) :key2-oeueu-oeue
                                                        (quote val2))
                                                  {:spec {:col-align false :col-from 1}})
                  (base/block-string) (std.foundation.string/split-lines)))
    :expected ["(assoc hello" "       :key1 val" "       :key2-oeueu-oeue val2)"]}
   {:name "layout standard paired inputs #3"
    :test (fn []
              (-> (common/layout-multiline-paired (list (quote hash-map) :key1 (quote val) :key2-oeueu-oeue (quote val2))
                                                  {:spec {:col-align true :col-from 0}})
                  (base/block-string) (std.foundation.string/split-lines)))
    :expected ["(hash-map :key1            val" "          :key2-oeueu-oeue val2)"]}
   {:name "layout standard paired inputs #4"
    :test (fn []
              (-> (common/layout-multiline-paired (list (quote hash-map) :key1 (quote val) :key2-oeueu-oeue (quote val2))
                                                  {:spec {:col-align false :col-from 0}})
                  (base/block-string) (std.foundation.string/split-lines)))
    :expected ["(hash-map :key1 val" "          :key2-oeueu-oeue val2)"]}
   {:name "layout standard paired inputs #5"
    :test (fn []
              (-> (common/layout-multiline-paired (list (quote case) (list (quote type)) :a 1 :b 2)
                                                  {:spec {:col-from 1 :col-start 2}})
                  (base/block-string) (std.foundation.string/split-lines)))
    :expected ["(case (type)" "  :a 1" "  :b 2)"]}
   {:name "layout standard paired inputs #6"
    :test (fn []
              (-> (common/layout-multiline-paired (list (quote something) (quote to) (quote do) (list (quote type)) :a 1 :b 2)
                                                  {:spec {:col-from 3 :col-start 2}})
                  (base/block-string) (std.foundation.string/split-lines)))
    :expected ["(something to do (type)" "  :a 1" "  :b 2)"]}]
  migration-test-check))

