 [{:name "joins block-arrays together with a spacing array"
   :test (fn [] (common/join-block-arrays [nil nil] [[1 2] [3 4 5] [6 7]]))
   :expected (list 1 2 nil nil 3 4 5 nil nil 6 7)}]
 migration-test-check)

^{:refer std.block.layout.common/format-multiline-string :added "4.0"}
(Test/run [{:name "makes a multiline string into a form", :test (fn [] (common/format-multiline-string "hoeuoeu\noeuoeuoeu\noeuoeuoe\noeoeuoe")), :expected (list (quote String/join) "\\n" (vector "hoeuoeu" "oeuoeuoeu" "oeuoeuoe" "oeoeuoe"))}] migration-test-check)

^{:refer std.block.layout.common/layout-single-row :added "4.0"}
