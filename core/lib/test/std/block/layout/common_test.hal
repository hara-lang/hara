^{:refer std.block.layout.common/layout-two-column :added "4.0"}
(Test/run
 [{:name "layout for 2 column bindings and :key val combinations #1"
   :test (fn []
             (pr-str (construct/rep (common/layout-two-column (list (list :key1 (quote val)) (list :key2-oeueu-oeue (quote val2)))
                                                              {:col-align false} {:indent 10}))))
   :expected (pr-str (vector (vector :key1 (quote ␣) (quote val))
                             (vector :key2-oeueu-oeue (quote ␣) (quote val2))))}
  {:name "layout for 2 column bindings and :key val combinations #2"
   :test (fn []
             (pr-str (construct/rep (common/layout-two-column (list (list :key1 (quote val)) (list :key2-oeueu-oeue (quote val2)))
                                                              {:col-align true} {:indent 10}))))
   :expected (pr-str (vector (list :key1
                                   (quote ␣) (quote ␣)
                                   (quote ␣) (quote ␣)
                                   (quote ␣) (quote ␣)
                                   (quote ␣) (quote ␣)
                                   (quote ␣) (quote ␣)
                                   (quote ␣) (quote ␣)
                                   (quote val))
                             (list :key2-oeueu-oeue (quote ␣) (quote val2))))}
  {:name "layout for 2 column bindings and :key val combinations #3"
   :test (fn []
             (pr-str (construct/rep (common/layout-two-column (Algo/ordered-map :a 1 :b 2)
                                                              {:col-align true} {:indent 10}))))
   :expected (pr-str (vector (list :a (quote ␣) 1) (list :b (quote ␣) 2)))}]
 migration-test-check)

