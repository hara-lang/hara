^{:refer std.block.layout.common/layout-n-column-pad :added "4.0"}
(Test/run
 [{:name "layouts a set of columns with single space #1"
   :test (fn []
             (pr-str (construct/rep (common/layout-n-column-pad [[100 2 3] [3 400] [6 7 600 7 8]] {:col-pad 4} {}))))
   :expected (pr-str (vector (vector 100 (quote ␣) (quote ␣) 2 (quote ␣) (quote ␣) (quote ␣) (quote ␣) 3)
                             (vector 3 (quote ␣) (quote ␣) (quote ␣) (quote ␣) 400) (vector 6
                                                                                            (quote ␣) (quote ␣)
                                                                                            (quote ␣) (quote ␣)
                                                                                            7 (quote ␣)
                                                                                            (quote ␣) (quote ␣)
                                                                                            (quote ␣) 600
                                                                                            (quote ␣) (quote ␣)
                                                                                            7 (quote ␣)
                                                                                            (quote ␣) (quote ␣)
                                                                                            (quote ␣) 8)))}
  {:name "layouts a set of columns with single space #2"
   :test (fn []
             (pr-str (construct/rep (common/layout-n-column-pad [[100 2 3] [3 400] [6 7 600 7 8]]
                                                                {:col-pad [8 7 6 5 4]} {}))))
   :expected (pr-str (vector (vector 100
                                     (quote ␣) (quote ␣)
                                     (quote ␣) (quote ␣)
                                     (quote ␣) (quote ␣)
                                     2 (quote ␣)
                                     (quote ␣) (quote ␣)
                                     (quote ␣) (quote ␣)
                                     (quote ␣) (quote ␣)
                                     3)
                             (vector 3
                                     (quote ␣) (quote ␣)
                                     (quote ␣) (quote ␣)
                                     (quote ␣) (quote ␣)
                                     (quote ␣) (quote ␣)
                                     400) (vector 6
                                                  (quote ␣) (quote ␣)
                                                  (quote ␣) (quote ␣)
                                                  (quote ␣) (quote ␣)
                                                  (quote ␣) (quote ␣)
                                                  7 (quote ␣)
                                                  (quote ␣) (quote ␣)
                                                  (quote ␣) (quote ␣)
                                                  (quote ␣) (quote ␣)
                                                  600 (quote ␣)
                                                  (quote ␣) (quote ␣)
                                                  (quote ␣) 7
                                                  (quote ␣) (quote ␣)
                                                  (quote ␣) (quote ␣)
                                                  (quote ␣) 8)))}]
