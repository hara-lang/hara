(ns std.block.template-test
  (:require [std.foundation.string]
    [std.block.template :as gen]
    [std.block :as b]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic]))

(defn migration-test-check
  [test expected]
  (let [result (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

(defn migration-meta-tree
  [value]
  (let [metadata   (select-keys (or (meta value) {}) [:readable-len :tag :spec])
        normalized (cond
                    (vector? value) (mapv migration-meta-tree value)
                    (map? value)    (reduce-kv
                                     (fn
                                      [output key item] (assoc output (migration-meta-tree key) (migration-meta-tree item))) {}
                                     value)
                    (set? value)    (set (map migration-meta-tree value))
                    (seq? value)    (apply list (map migration-meta-tree value))
                    :else           value)]
    {:meta metadata :value normalized}))

(def PUBLIC_QUERY
  (apply str
    (interpose "
"
      ["(defn.pg ^{:%% :sql"
       "           :- :json"
       "           :api/meta {:sb/grant :all}}"
       "  hello"
       "  []"
       "  (hello-name (szndb.core.fn-util/auth-uid) 1 2 3))"])))

(def TEMPLATE_QUERY
  (apply str
    (interpose "
"
      ["(defn.pg ^{:%% :sql"
       "           :- ~return"
       "           :api/meta ~meta-entry}"
       "  ~sym"
       "  []"
       "  (~name (szndb.core.fn-util/auth-uid) ~@hello))"])))

^{:refer std.block.template/get-template-params :added "4.0"}
(Test/run
 [{:name "gets the template params in the query"
   :test (fn [] (gen/get-template-params (b/parse-first TEMPLATE_QUERY)))
   :expected (quote ((unquote return) (unquote meta-entry)
                                      (unquote sym) (unquote name)
                                      (unquote-splicing hello)))}]
 migration-test-check)

^{:refer std.block.template/get-template :added "4.0"}
(Test/run
 [{:name "gets the template"
   :test (fn [] (gen/get-template TEMPLATE_QUERY))
   :expected map?}]
 migration-test-check)

^{:refer std.block.template/fill-template :added "4.0"}
(Test/run
 [{:name "fills out the template"
   :test (fn []
             (std.foundation.string/split-lines (gen/fill-template (gen/get-template TEMPLATE_QUERY)
                                                                   (quote {return     :json
                                                                           meta-entry {:sb/grant :all}
                                                                           sym        hello
                                                                           name       hello-name
                                                                           hello      (1 2 3)}))))
   :expected ["(defn.pg ^{:%% :sql" "           :- :json"
              "           :api/meta {:sb/grant :all}}" "  hello"
              "  []" "  (hello-name (szndb.core.fn-util/auth-uid) 1 2 3))"]}]
 migration-test-check)

^{:refer std.block.template/defn-form :added "4.1.4"}
(Test/run
 [{:name "creates a standard defn form"
   :test (fn []
             (gen/defn-form (quote {fsym      hello
                                    doc       "Greets."
                                    base-args [client]
                                    opts-args [client opts]
                                    body-form (greet client opts)})))
   :expected (quote (defn hello
                          "Greets." ([client] (hello client {}))
                          ([client opts] (greet client opts))))}]
 migration-test-check)
