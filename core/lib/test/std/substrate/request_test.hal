(ns std.substrate.request-test
  (:use code.test)
  (:require [std.substrate :as substrate]
            [std.substrate.frame :as frame]
            [std.substrate.request :as request]))

(fact "normalises raw values to promises"
  (promise/value (request/ensure-promise {"ok" true}))
  => {"ok" true})

(fact "tracks and settles successful pending requests"
  (let [node (substrate/node-create "node/pending")
        resolved (atom [])
        rejected (atom [])
        outgoing (frame/request-frame "room/a" "echo" [1 2] nil)]
    (request/add-pending
     node outgoing
     (fn [value] (reset! resolved (conj @resolved value)))
     (fn [value] (reset! rejected (conj @rejected value)))
     {"transport_id" "peer-a"})
    (let [before (vec (keys (substrate/node-section node :pending)))]
      (request/settle-pending
       node
       (frame/response-ok-frame
        (get outgoing "id") "room/a" {"ok" true} nil))
      [(count before)
       @resolved
       @rejected
       (substrate/node-section node :pending)]))
  => [1 [{"ok" true}] [] {}])

(fact "removes pending request entries by id"
  (let [node (substrate/node-create "node/remove-pending")
        outgoing (frame/request-frame "room/a" "echo" [] nil)]
    (request/add-pending node outgoing identity identity nil)
    (let [removed (request/remove-pending node (get outgoing "id"))]
      [(string? (get-in removed ["request" "id"]))
       (substrate/node-section node :pending)]))
  => [true {}])

(fact "settles rejected pending requests with the response frame"
  (let [node (substrate/node-create "node/reject")
        rejected (atom nil)
        outgoing (frame/request-frame "room/a" "echo" [] nil)
        response (frame/response-error-frame
                  (get outgoing "id") "room/a"
                  {"message" "boom"} nil)]
    (request/add-pending
     node outgoing identity (fn [value] (reset! rejected value)) nil)
    (request/settle-pending node response)
    [(get-in @rejected ["error" "message"])
     (substrate/node-section node :pending)])
  => ["boom" {}])

(fact "invokes handlers against the selected space"
  (let [node (substrate/node-create "node/handler")
        calls (atom [])]
    (substrate/section-put
     node :handlers "echo"
     {"id" "echo"
      "fn" (fn [space args incoming current-node]
             (reset! calls
                     (conj @calls
                           [(get space "id")
                            args
                            (get incoming "action")
                            (:id current-node)]))
             {"space" (get space "id")
              "args" args})
      "meta" {}})
    (let [output
          (promise/value
           (request/invoke-handler
            node
            (frame/request-frame "room/a" "echo" [1 2] nil)))]
      [output @calls]))
  => [{"space" "room/a" "args" [1 2]}
      [["room/a" [1 2] "echo" "node/handler"]]])

(fact "normalises successful response bodies"
  (promise/value
   (request/response-body
    (frame/response-ok-frame
     "req-1" "room/a" {"ok" true} nil)))
  => {"ok" true})

(fact "rejects errored response bodies"
  (promise/state
   (request/response-body
    (frame/response-error-frame
     "req-1" "room/a" {"message" "boom"} nil)))
  => :rejected)

(pr-str (run '[std.substrate.request-test]))
