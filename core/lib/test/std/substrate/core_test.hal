(ns std.substrate.core-test
  (:require
            [std.substrate :as substrate]
            [std.substrate.core :as state]))

(def results
  [(test-check
    "canonical substrate core owns node state"
    (let [node (substrate/node-create {"id" "core-test"})]
      (state/section-put node :services :alpha {:value 1})
      (let [before
            [(instance? substrate/SubstrateNode node)
             (substrate/node? node)
             (substrate/node-id node)
             (get (substrate/node-section node :services) :alpha)
             (set (keys (substrate/node-state node)))]
            removed (state/section-remove node :services :alpha)]
        [before removed (substrate/node-section node :services)]))
    [[true true "core-test" {:value 1}
      #{:spaces :services :handlers :triggers
        :pending :router :transports :meta}]
     {:value 1}
     {}])])

results
