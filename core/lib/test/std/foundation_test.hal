^{:refer std.foundation/map}
(Test/run
 [{:name "preserves vector shape and metadata"
   :test (fn []
           (let [output (f/map inc (with-meta (vec [1 2]) {:tag :sample}))]
             [output (f/meta output)]))
   :expected [[2 3] {:tag :sample}]}])

