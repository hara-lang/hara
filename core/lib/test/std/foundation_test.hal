(ns std.foundation-test
  (:require [std.foundation :as f]))

^{:refer std.foundation/code-line}
(Test/run [])

^{:refer std.foundation/code-column}
(Test/run [])

^{:refer std.foundation/read-forms}
(Test/run [])

^{:refer std.foundation/meta}
(Test/run
 [{:name "returns nil for values without IObjType"
   :test (fn [] (f/meta 42))
   :expected nil}
  {:name "returns attached metadata"
   :test (fn [] (f/meta (with-meta [1] {:tag :sample})))
   :expected {:tag :sample}}])

