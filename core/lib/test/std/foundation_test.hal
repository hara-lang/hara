^{:refer std.foundation/reduced}
(Test/run
 [{:name "marks and unwraps reduced values"
   :test (fn [] [(f/reduced? (f/reduced 42))
                 (f/unreduced (f/reduced 42))])
   :expected [true 42]}])

^{:refer std.foundation/reduced?}
(Test/run
 [{:name "rejects ordinary values"
   :test (fn [] (f/reduced? 42))
   :expected false}])

^{:refer std.foundation/unreduced}
(Test/run
 [{:name "leaves ordinary values unchanged"
   :test (fn [] (f/unreduced 42))
   :expected 42}])

^{:refer std.foundation/reduce-in}
(Test/run
 [{:name "reduces into a persistent collection"
   :test (fn [] (f/reduce-in [] conj [1 2 3]))
   :expected [1 2 3]}
  {:name "honors reduced early termination"
   :test (fn []
           (f/reduce-in 0
                        (fn [total value]
                          (if (= value 3)
                            (f/reduced total)
                            (+ total value)))
                        [1 2 3 4]))
   :expected 3}])

^{:refer std.foundation/empty?}
(Test/run
 [{:name "uses counted collection capability"
   :test (fn [] [(f/empty? []) (f/empty? [1])])
   :expected [true false]}])

^{:refer std.foundation/first}
(Test/run
 [{:name "peeks without changing collection semantics"
   :test (fn [] [(f/first [1 2]) (f/first [])])
   :expected [1 nil]}])

