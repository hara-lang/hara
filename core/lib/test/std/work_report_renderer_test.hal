(ns std.work-report-renderer-test
  (:require [std.lib.test :as test]
            [std.work.protocol :as protocol]
            [std.work.report :as report]
            [std.work.report.plain :as plain]
            [std.work.report.terminal :as terminal]))

(def item-a
  {:item/id :alpha
   :item/index 0
   :item/total 2
   :status :return
   :item/display "changed"
   :elapsed 3})

(def item-b
  {:item/id :beta
   :item/index 1
   :item/total 2
   :status :warn
   :data "review"
   :elapsed 4})

(def columns
  [{:key :path :label "PATH" :width 8}
   {:key :functions :label "FUN" :width 3 :align :right}
   {:key :inserts :label "INS" :width 3 :align :right}])

(def rows
  [{:path "a.clj" :functions 2 :inserts 3 :status :return}
   {:path "b.clj" :functions 1 :inserts 0 :status :return}])

(def summary
  {:items 2
   :results 2
   :warnings 1
   :errors 0
   :cumulative 7
   :elapsed 8})

(def document
  (report/complete
   (report/add-section
    (report/add-section
     (report/add-section
      (report/add-section
       (report/document
        :example/transform
        {:title "TRANSFORM CODE"
         :status :warning
         :annotations ["Done"]
         :profile
         {:sections [:items :warnings :results :summary]}})
       (report/section
        :items
        :progress
        [item-a item-b]
        {:section/title "ITEMS"}))
      (report/section
       :warnings
       :diagnostics
       [item-b]
       {:section/title "WARNINGS"}))
     (report/section
      :results
      :table
      rows
      {:section/title "RESULTS"
       :section/columns columns}))
    (report/section
     :summary
     :summary
     [summary]
     {:section/title "SUMMARY"
      :section/fields
      [:items :results :warnings :errors :cumulative :elapsed]}))
   :warning))

(def expected
  (str/join
   "\n"
   ["TRANSFORM CODE"
    ""
    "ITEMS"
    "1/2  :alpha  ok  changed  3ms"
    "2/2  :beta  warn  review  4ms"
    ""
    "WARNINGS"
    ":beta  warn  review"
    ""
    "RESULTS"
    "PATH      FUN  INS"
    "--------  ---  ---"
    "a.clj       2    3"
    "b.clj       1    0"
    ""
    "SUMMARY"
    "Items: 2"
    "Results: 2"
    "Warnings: 1"
    "Errors: 0"
    "Cumulative: 7ms"
    "Elapsed: 8ms"
    ""
    "Done"]))

(def events
  [{:event :task/run-started
    :report/title "TRANSFORM CODE"
    :report/profile (:report/profile document)}
   {:event :task/item-completed :record item-a}
   {:event :task/item-completed :record item-b}
   {:event :task/run-completed :report document}])

(def live-output (atom []))
(def live-observer
  (terminal/observer
   {:ansi false
    :emit
    (fn [text]
      (swap! live-output conj text))}))

(def _live-events
  (reduce
   (fn [count event]
     (protocol/work-event live-observer event)
     (inc count))
   0
   events))

(def replay-output (atom []))
(def replay-count
  (terminal/replay!
   events
   {:ansi false
    :emit
    (fn [text]
      (swap! replay-output conj text))}))

(def ansi-title
  (first (terminal/render-lines document)))

(def results
  [(test/check
    "plain reports render titles, progress, diagnostics, fixed-width tables, summaries, and annotations"
    (plain/render document)
    expected)

   (test/check
    "plain event replay produces the same task report as the completed document"
    (plain/render-events events)
    expected)

   (test/check
    "live terminal observers and stored-history replay use the same event projection"
    [(str/join "\n" (deref live-output))
     (str/join "\n" (deref replay-output))
     replay-count
     (count (deref live-output))]
    [expected expected
     (count (deref replay-output))
     (count (deref replay-output))])

   (test/check
    "terminal styling is a renderer option rather than report data"
    [(str/starts-with? ansi-title "\u001b[1;36m")
     (str/ends-with? ansi-title "\u001b[0m")
     (terminal/render document {:ansi false})]
    [true true expected])

   (test/check
    "column widths and alignment remain structured report configuration"
    [(get-in
      (report/section-by-id document :results)
      [:section/columns 0 :width])
     (plain/table-text
      (plain/realised-columns columns rows)
      (first rows))]
    [8 "a.clj       2    3"])

   (test/check
    "plain truncation uses the portable string slice primitive"
    [(plain/truncate "abcdef" 3)
     (plain/truncate "abcdefgh" 6)]
    ["abc" "abc..."])

   (test/check
    "empty sections are hidden unless explicitly requested"
    [(plain/render
      (report/add-section
       (report/document
        :empty/report
        {:title "EMPTY"
         :profile {:sections [:errors]}})
       (report/section :errors :diagnostics [])))
     (plain/render
      (report/add-section
       (report/document
        :empty/report
        {:title "EMPTY"
         :profile {:sections [:errors]}})
       (report/section :errors :diagnostics []))
      {:include-empty true})]
    ["EMPTY" "EMPTY\n\nerrors"])])

(test/print-results results)
