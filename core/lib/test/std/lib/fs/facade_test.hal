(ns std.lib.fs.facade-test
  (:use code.test)
  (:require [std.foundation.string :as str]
            [std.lib.fs :as fs]
            [std.lib.fs.path :as path]
            [std.lib.fs.walk :as walk]))

(def test-root
  (fs/temp-directory "/" {:prefix "std-fs-sync-"}))

(def source-root (path/join test-root "source"))
(def nested-root (path/join source-root "nested"))
(def alpha-path (path/join source-root "alpha.txt"))
(def beta-path (path/join source-root "beta.txt"))
(def gamma-path (path/join nested-root "gamma.txt"))
(def copy-root (path/join test-root "copy"))
(def single-path (path/join test-root "single.txt"))
(def moved-path (path/join test-root "moved.txt"))
(def into-root (path/join test-root "into"))
(def into-beta (path/join into-root "beta.txt"))

(defn- caught-data
  [function]
  (try
    (do
      (function)
      nil)
    (catch Throwable error
      (ex-data error))))

(def results
  [(fact "low-level-file-effects-remain-promise-based"
     [(promise? (File/stat test-root))
      (promise? (File/exists? test-root))
      (promise? (File/entries test-root))
      (promise? (File/read (path/join test-root "missing")))
      (promise? (File/copy (path/join test-root "missing-source")
                           (path/join test-root "missing-target")))
      (promise? (File/move (path/join test-root "missing-source")
                           (path/join test-root "missing-target")))]
     => [true true true true true true])

   (fact "std-fs-returns-direct-metadata-predicate-byte-and-mutation-values"
     (let [directory (fs/create-directory nested-root {:parents? true})
           alpha (fs/write-bytes alpha-path (str/encode-utf8 "alpha"))
           beta (fs/write-bytes beta-path (str/encode-utf8 "beta"))
           gamma (fs/write-bytes gamma-path (str/encode-utf8 "gamma"))
           bytes-value (fs/read-bytes alpha-path)
           entry (fs/stat alpha-path)]
       [(promise? directory)
        (promise? alpha)
        (promise? bytes-value)
        (= directory nested-root)
        (= alpha alpha-path)
        (= beta beta-path)
        (= gamma gamma-path)
        (= (str/decode-utf8 bytes-value) "alpha")
        (= (:path entry) alpha-path)
        (= (:name entry) "alpha.txt")
        (= (:type entry) :file)
        (= (:size entry) 5)
        (map? (:extensions entry))
        (fs/exists? alpha-path)
        (fs/file? alpha-path)
        (fs/directory? nested-root)
        (fs/symlink? alpha-path)])
     => [false false false
         true true true true true
         true true true true true
         true true true false])

   (fact "std-fs-provider-and-validation-failures-throw-synchronously"
     [(get
       (caught-data
        (fn []
          (fs/write-bytes alpha-path (str/encode-utf8 "replacement"))))
       :error/code)
      (get
       (caught-data
        (fn []
          (fs/read-bytes (path/join test-root "missing"))))
       :error/code)
      (get
       (caught-data
        (fn []
          (fs/copy source-root source-root)))
       :error/code)
      (get
       (caught-data
        (fn []
          (fs/copy-into "/" test-root)))
       :error/code)]
     => [:file/already-exists
         :file/not-found
         :file/invalid-path
         :file/invalid-path])

   (fact "list-walk-and-select-return-deterministic-vectors"
     (let [listed (fs/list source-root)
           walked (vec (map :path (walk/walk source-root)))
           selected (vec (map :path
                              (fs/select source-root
                                         (fn [entry]
                                           (= (:type entry) :file)))))
           shallow (vec (map :path
                             (walk/walk source-root {:max-depth 1})))
           pruned (vec (map :path
                            (walk/walk
                             source-root
                             {:exclude
                              (fn [entry]
                                (= (:name entry) "nested"))})))]
       [(promise? listed)
        (promise? walked)
        listed
        walked
        selected
        shallow
        pruned])
     => [false
         false
         [alpha-path beta-path nested-root]
         [alpha-path beta-path nested-root gamma-path]
         [alpha-path beta-path gamma-path]
         [alpha-path beta-path nested-root]
         [alpha-path beta-path]])

   (fact "copy-copy-into-and-move-return-direct-results"
     (let [mapping (fs/copy source-root copy-root)
           into-directory (fs/create-directory into-root)
           into-mapping (fs/copy-into beta-path into-root)
           copied-single (fs/copy-single alpha-path single-path)
           moved (fs/move single-path moved-path)]
       [(promise? mapping)
        (promise? into-mapping)
        (= (get mapping source-root) copy-root)
        (= (get mapping alpha-path) (path/join copy-root "alpha.txt"))
        (= (get mapping gamma-path) (path/join copy-root "nested/gamma.txt"))
        (= into-directory into-root)
        (= (get into-mapping beta-path) into-beta)
        (= copied-single single-path)
        (= moved moved-path)
        (= (str/decode-utf8
            (fs/read-bytes (path/join copy-root "nested/gamma.txt")))
           "gamma")
        (= (str/decode-utf8 (fs/read-bytes into-beta)) "beta")
        (not (fs/exists? single-path))
        (fs/file? moved-path)])
     => [false false
         true true true true true true true
         true true true true])

   (fact "recursive-delete-is-post-order-and-simple-delete-is-a-path"
     (let [deleted (fs/delete source-root {:recursive? true})
           simple (fs/delete moved-path)]
       [deleted
        simple
        (fs/exists? source-root)
        (fs/exists? moved-path)])
     => [[alpha-path beta-path gamma-path nested-root source-root]
         moved-path
         false
         false])

   (fact "filesystem-defaults-and-public-contract-remain-stable"
     [[fs/copy-default-options fs/delete-default-options]
      walk/default-options
      (every? (fn [symbol]
                (not (nil? (resolve symbol))))
              '[std.lib.fs/copy
                std.lib.fs/copy-default-options
                std.lib.fs/copy-into
                std.lib.fs/copy-single
                std.lib.fs/create-directory
                std.lib.fs/delete
                std.lib.fs/delete-default-options
                std.lib.fs/directory?
                std.lib.fs/entries
                std.lib.fs/exists?
                std.lib.fs/file?
                std.lib.fs/list
                std.lib.fs/mkdir
                std.lib.fs/move
                std.lib.fs/read-bytes
                std.lib.fs/select
                std.lib.fs/stat
                std.lib.fs/symlink?
                std.lib.fs/temp-directory
                std.lib.fs/temp-file
                std.lib.fs/write-bytes
                std.lib.fs.walk/default-options
                std.lib.fs.walk/walk])]
     => [[{:replace? false
           :parents? false
           :preserve-modified? false}
          {:recursive? false
           :missing-ok? false}]
         {:include-root? false
          :max-depth nil
          :include nil
          :exclude nil}
         true])

   (fact "test-filesystem-is-cleaned-up"
     (let [deleted (fs/delete test-root {:recursive? true :missing-ok? true})]
       [(vector? deleted)
        (fs/exists? test-root)])
     => [true false])])

(pr-str (run '[std.lib.fs.facade-test]))
