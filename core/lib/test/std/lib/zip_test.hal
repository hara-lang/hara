(ns std.lib.zip-test (:require [std.lib.zip :refer :all :as zip] [code.test.work :as code.test] [code.test.base.process :as process] [code.test.checker.common :as checker] [code.test.checker.collection :as collection]) (:config {:override [get find prewalk postwalk]}))

(do
 (->>
  (from-status
   (quote [1 [[[2 |]] 3]]))
  at-end?)
 (->
  (vector-zip
   [1 [2 [6 7] 3] [4 5]])
  (find-next #{3})
  status)
 (form-zip :hello)
 (->
  (form-zip (quote ([nil] 1)))
  step-next
  step-next
  step-next
  status)
 nil)

(let [results (Test/run
               [{:name "registers a zip type #1"
                 :meta {:refer (quote std.lib.zip/register-type)
                        :added "4.0"}
                 :test (fn []
                           (resolve (quote register-type)))
                 :expected (fn [actual]
                               (= :std.native.Var
                                  (type actual)))}
                {:name "unregisters a zip type #2"
                 :meta {:refer (quote std.lib.zip/unregister-type)
                        :added "4.0"}
                 :test (fn []
                           (resolve (quote unregister-type)))
                 :expected (fn [actual]
                               (= :std.native.Var
                                  (type actual)))}
                {:name "checks that the zipper contains valid functions #3"
                 :meta {:refer (quote std.lib.zip/check-context)
                        :added "3.0"}
                 :test (fn [] (check-context {}))
                 :expected (checker/throws)}
                {:name "checks that the meta contains valid functions #4"
                 :meta {:refer (quote std.lib.zip/check-optional)
                        :added "3.0"}
                 :test (fn [] (check-optional {}))
                 :expected (checker/throws)}
                {:name "checks to see if an object is a zipper #5"
                 :meta {:refer (quote std.lib.zip/zipper?)
                        :added "3.0"}
                 :test (fn [] (zipper? 1))
                 :expected false}
                {:name "constructs a zipper #6"
                 :meta {:refer (quote std.lib.zip/zipper)
                        :added "3.0"}
                 :test (fn []
                           (resolve (quote zipper)))
                 :expected (fn [actual]
                               (= :std.native.Var
                                  (type actual)))}
                {:name "element directly left of current position #7"
                 :meta {:refer (quote std.lib.zip/left-element)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 3 | 4]))
                               left-element))
                 :expected 3}
                {:name "element directly left of current position #8"
                 :meta {:refer (quote std.lib.zip/left-element)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 [2 [| 3]]]))
                               left-element))
                 :expected nil}
                {:name "element directly left of current position #9"
                 :meta {:refer (quote std.lib.zip/left-element)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 [2 [nil | 3]]]))
                               left-element))
                 :expected nil}
                {:name "element directly right of current position #10"
                 :meta {:refer (quote std.lib.zip/right-element)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 3 | 4]))
                               right-element))
                 :expected 4}
                {:name "all elements left of current position #11"
                 :meta {:refer (quote std.lib.zip/left-elements)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | 3 4]))
                               left-elements))
                 :expected (quote (1 2))}
                {:name "all elements right of current position #12"
                 :meta {:refer (quote std.lib.zip/right-elements)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | 3 4]))
                               right-elements))
                 :expected (quote (3 4))}
                {:name "all elements left and right of current position #13"
                 :meta {:refer (quote std.lib.zip/current-elements)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | 3 4]))
                               current-elements))
                 :expected (quote (1 2 3 4))}
                {:name "all elements left and right of current position #14"
                 :meta {:refer (quote std.lib.zip/current-elements)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 [2 | 3] 4]))
                               current-elements))
                 :expected (quote (2 3))}
                {:name "checks zip given a predicate #15"
                 :meta {:refer (quote std.lib.zip/is)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [0 1 2 3 4])
                               step-inside (is zero?)))
                 :expected true}
                {:name "gets the value of the zipper #16"
                 :meta {:refer (quote std.lib.zip/get)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [0 1 2 3 4])
                               step-inside zip/get))
                 :expected 0}
                {:name "checks if node on either side is a container #17"
                 :meta {:refer (quote std.lib.zip/is-container?)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [1 2 3])
                               (is-container? :right)))
                 :expected true}
                {:name "checks if node on either side is a container #18"
                 :meta {:refer (quote std.lib.zip/is-container?)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [1 2 3])
                               (is-container? :left)))
                 :expected false}
                {:name "check if current container is empty #19"
                 :meta {:refer (quote std.lib.zip/is-empty-container?)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [])
                               is-empty-container?))
                 :expected true}
                {:name "check if at left-most point of a container #20"
                 :meta {:refer (quote std.lib.zip/at-left-most?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status [1 2 [(quote |) 3 4] 5 6])
                               at-left-most?))
                 :expected true}
                {:name "check if at right-most point of a container #21"
                 :meta {:refer (quote std.lib.zip/at-right-most?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 4 |]]))
                               at-right-most?))
                 :expected true}
                {:name "check if at inside-most point of a container #22"
                 :meta {:refer (quote std.lib.zip/at-inside-most?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 4 |]]))
                               at-inside-most?))
                 :expected true}
                {:name "check if at inside-most left point of a container #23"
                 :meta {:refer (quote std.lib.zip/at-inside-most-left?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [| 1 2]]))
                               at-inside-most-left?))
                 :expected true}
                {:name "check if at outside-most point of the tree #24"
                 :meta {:refer (quote std.lib.zip/at-outside-most?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status [1 2 [3 4 (quote |)]])
                               at-outside-most?))
                 :expected false}
                {:name "check if at outside-most point of the tree #25"
                 :meta {:refer (quote std.lib.zip/at-outside-most?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 4 |]]))
                               step-outside step-outside
                               at-outside-most?))
                 :expected true}
                {:name "constructs a sequence zipper #26"
                 :meta {:refer (quote std.lib.zip/seq-zip)
                        :added "3.0"}
                 :test (fn []
                           (seq-zip (quote (1 2 3 4 5))))
                 :expected (collection/contains {:right (quote ((1 2 3 4 5)))
                                                 :left  ()})}
                {:name "constructs a vector based zipper #27"
                 :meta {:refer (quote std.lib.zip/vector-zip)
                        :added "3.0"}
                 :test (fn []
                           (vector-zip [1 2 3 4 5]))
                 :expected (collection/contains {:right (quote ([1 2 3 4 5]))
                                                 :left  ()})}
                {:name "lists elements of a container  #28"
                 :meta {:refer (quote std.lib.zip/list-child-elements)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [1 2 3])
                               (list-child-elements :right)))
                 :expected (quote (1 2 3))}
                {:name "lists elements of a container  #29"
                 :meta {:refer (quote std.lib.zip/list-child-elements)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip 1)
                               (list-child-elements :right)))
                 :expected (checker/throws)}
                {:name "updates elements of a container #30"
                 :meta {:refer (quote std.lib.zip/update-child-elements)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [1 2])
                               (update-child-elements [1 2 3 4]
                                                      :right) right-element))
                 :expected [1 2 3 4]}
                {:name "check if can step left from current status #31"
                 :meta {:refer (quote std.lib.zip/can-step-left?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 | 4]]))
                               can-step-left?))
                 :expected true}
                {:name "check if can step left from current status #32"
                 :meta {:refer (quote std.lib.zip/can-step-left?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [| 3 4]]))
                               can-step-left?))
                 :expected false}
                {:name "check if can step right from current status #33"
                 :meta {:refer (quote std.lib.zip/can-step-right?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 | 4]]))
                               can-step-right?))
                 :expected true}
                {:name "check if can step right from current status #34"
                 :meta {:refer (quote std.lib.zip/can-step-right?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 4 |]]))
                               can-step-right?))
                 :expected false}
                {:name "check if can step down from current status #35"
                 :meta {:refer (quote std.lib.zip/can-step-inside?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 4 |]]))
                               can-step-inside?))
                 :expected false}
                {:name "check if can step down from current status #36"
                 :meta {:refer (quote std.lib.zip/can-step-inside?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | [3 4]]))
                               can-step-inside?))
                 :expected true}
                {:name "check if can step left inside a container #37"
                 :meta {:refer (quote std.lib.zip/can-step-inside-left?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [[3 4] |]))
                               can-step-inside-left?))
                 :expected true}
                {:name "check if can step up from current status #38"
                 :meta {:refer (quote std.lib.zip/can-step-outside?)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 4 |]]))
                               can-step-outside?))
                 :expected true}
                {:name "step left from current status #39"
                 :meta {:refer (quote std.lib.zip/step-left)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 4 |]]))
                               step-left status))
                 :expected (quote ([1 2 [3 | 4]]))}
                {:name "step right from current status #40"
                 :meta {:refer (quote std.lib.zip/step-right)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [| 3 4]]))
                               step-right status))
                 :expected (quote ([1 2 [3 | 4]]))}
                {:name "step down from current status #41"
                 :meta {:refer (quote std.lib.zip/step-inside)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | [3 4]]))
                               step-inside status))
                 :expected (quote ([1 2 [| 3 4]]))}
                {:name "steps into the form on the left side #42"
                 :meta {:refer (quote std.lib.zip/step-inside-left)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [[1 2] |]))
                               step-inside-left status))
                 :expected (quote ([[1 2 |]]))}
                {:name "step out to the current container #43"
                 :meta {:refer (quote std.lib.zip/step-outside)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [| 3 4]]))
                               step-outside status))
                 :expected (quote ([1 2 | [3 4]]))}
                {:name "the right of the current container #44"
                 :meta {:refer (quote std.lib.zip/step-outside-right)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [| 3 4]]))
                               step-outside-right status))
                 :expected (quote ([1 2 [3 4] |]))}
                {:name "step to left-most point of current container #45"
                 :meta {:refer (quote std.lib.zip/step-left-most)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [3 4 |]]))
                               step-left-most status))
                 :expected (quote ([1 2 [| 3 4]]))}
                {:name "step to right-most point of current container #46"
                 :meta {:refer (quote std.lib.zip/step-right-most)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [| 3 4]]))
                               step-right-most status))
                 :expected (quote ([1 2 [3 4 |]]))}
                {:name "step to at-inside-most point of current container #47"
                 :meta {:refer (quote std.lib.zip/step-inside-most)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | [[3] 4]]))
                               step-inside-most status))
                 :expected (quote ([1 2 [[| 3] 4]]))}
                {:name "steps all the way inside to the left side #48"
                 :meta {:refer (quote std.lib.zip/step-inside-most-left)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [[1 [2]] | 3 4]))
                               step-inside-most-left status))
                 :expected (quote ([[1 [2 |]] 3 4]))}
                {:name "step to outside-most point of the tree #49"
                 :meta {:refer (quote std.lib.zip/step-outside-most)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [| 3 4]]))
                               step-outside-most status))
                 :expected (quote (| [1 2 [3 4]]))}
                {:name "step to outside-most point of the tree to the right #50"
                 :meta {:refer (quote std.lib.zip/step-outside-most-right)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [| 3 4]]))
                               step-outside-most-right status))
                 :expected (quote ([1 2 [3 4]] |))}
                {:name "steps status to container directly at end #51"
                 :meta {:refer (quote std.lib.zip/step-end)
                        :added "3.0"}
                 :test (fn []
                           (->> (from-status (quote [1 | [[]]]))
                                step-end status))
                 :expected (quote ([1 [[|]]]))}
                {:name "insert element/s left of the current status #52"
                 :meta {:refer (quote std.lib.zip/insert-left)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 [[| 3] 4]]))
                               (insert-left 1 2 3) status))
                 :expected (quote ([1 2 [[1 2 3 | 3] 4]]))}
                {:name "delete element/s left of the current status #53"
                 :meta {:refer (quote std.lib.zip/delete-left)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | 3]))
                               delete-left status))
                 :expected (quote ([1 | 3]))}
                {:name "delete element/s right of the current status #54"
                 :meta {:refer (quote std.lib.zip/delete-right)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | 3]))
                               delete-right status))
                 :expected (quote ([1 2 |]))}
                {:name "replace element left of the current status #55"
                 :meta {:refer (quote std.lib.zip/replace-left)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | 3]))
                               (replace-left "10") status))
                 :expected (quote ([1 "10" | 3]))}
                {:name "replace element right of the current status #56"
                 :meta {:refer (quote std.lib.zip/replace-right)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 2 | 3]))
                               (replace-right "10") status))
                 :expected (quote ([1 2 | "10"]))}
                {:name "replace element right of the current status #57"
                 :meta {:refer (quote std.lib.zip/hierarchy)
                        :added "3.0"}
                 :test (fn []
                           (->> (from-status (quote [1 [[|]]]))
                                hierarchy (map right-element)))
                 :expected [[] [[]] [1 [[]]]]}
                {:name "replace element right of the current status #58"
                 :meta {:refer (quote std.lib.zip/at-end?)
                        :added "3.0"}
                 :test (fn []
                           (->> (from-status (quote [1 [[|]]]))
                                at-end?))
                 :expected true}
                {:name "replace element right of the current status #59"
                 :meta {:refer (quote std.lib.zip/at-end?)
                        :added "3.0"}
                 :test (fn []
                           (->> (from-status (quote [1 [[[2 |]] 3]]))
                                at-end?))
                 :expected false}
                {:name "nests elements in current block within another container #60"
                 :meta {:refer (quote std.lib.zip/surround)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip 3)
                               (insert-left 1 2) surround
                               status))
                 :expected (quote (| [1 2 3]))}
                {:name "nests elements in current block within another container #61"
                 :meta {:refer (quote std.lib.zip/surround)
                        :added "3.0"}
                 :test (fn []
                           (->> (from-status (quote [1 [1 2 | 3 4]]))
                                surround status))
                 :expected (quote ([1 [| [1 2 3 4]]]))}
                {:name "accesses the top level node #62"
                 :meta {:refer (quote std.lib.zip/root-element)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [[[3] 2] 1])
                               step-inside-most root-element))
                 :expected [[[3] 2] 1]}
                {:name "returns the form with the status showing #63"
                 :meta {:refer (quote std.lib.zip/status)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [1 [[2] 3]])
                               step-inside step-right
                               step-inside step-inside
                               status))
                 :expected (quote ([1 [[| 2] 3]]))}
                {:name "returns the string form of the status #64"
                 :meta {:refer (quote std.lib.zip/status-string)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [1 [[2] 3]])
                               step-inside step-right
                               status-string))
                 :expected "[1 | [[2] 3]]"}
                {:name "step status through the tree in depth first order #65"
                 :meta {:refer (quote std.lib.zip/step-next)
                        :added "3.0"}
                 :test (fn []
                           (->> (from-status (quote [| 1 [2 [6 7] 3] [4 5]]))
                                (iterate step-next) (take-while identity)
                                (map right-element)))
                 :expected (quote (1 [2 [6 7] 3]
                                     2 [6 7]
                                     6 7
                                     3 [4 5]
                                     4 5))}
                {:name "step status in reverse through the tree in depth first order #66"
                 :meta {:refer (quote std.lib.zip/step-prev)
                        :added "3.0"}
                 :test (fn []
                           (->> (from-status (quote [1 [2 [6 7] 3] [4 | 5]]))
                                (iterate step-prev) (take 10)
                                (map right-element)))
                 :expected (quote (5 4
                                     [4 5] 3
                                     7 6
                                     [6 7] 2
                                     [2 [6 7] 3] 1))}
                {:name "steps status left to search predicate #67"
                 :meta {:refer (quote std.lib.zip/find-left)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [0 1 [2 3] [4 5] 6 |]))
                               (find-left odd?) status))
                 :expected (quote ([0 | 1 [2 3] [4 5] 6]))}
                {:name "steps status left to search predicate #68"
                 :meta {:refer (quote std.lib.zip/find-left)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [0 1 [2 3] [4 5] 6 |]))
                               (find-left keyword?)))
                 :expected nil}
                {:name "steps status right to search for predicate #69"
                 :meta {:refer (quote std.lib.zip/find-right)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [0 | 1 [2 3] [4 5] 6]))
                               (find-right even?) status))
                 :expected (quote ([0 1 [2 3] [4 5] | 6]))}
                {:name "step status through the tree in depth first order to the first matching element #70"
                 :meta {:refer (quote std.lib.zip/find-next)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [1 [2 [6 7] 3] [4 5]])
                               (find-next #{7}) status))
                 :expected (quote ([1 [2 [6 | 7] 3] [4 5]]))}
                {:name "step status through the tree in depth first order to the first matching element #71"
                 :meta {:refer (quote std.lib.zip/find-next)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [1 [2 [6 7] 3] [4 5]])
                               (find-next keyword)))
                 :expected nil}
                {:name "step status through the tree in reverse order to the last matching element #72"
                 :meta {:refer (quote std.lib.zip/find-prev)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 [2 [6 | 7] 3] [4 5]]))
                               (find-prev even?) status))
                 :expected (quote ([1 [2 [| 6 7] 3] [4 5]]))}
                {:name "step status through the tree in reverse order to the last matching element #73"
                 :meta {:refer (quote std.lib.zip/find-prev)
                        :added "3.0"}
                 :test (fn []
                           (-> (from-status (quote [1 [2 [[[6 7]]] [3]] | [4 5]]))
                               (find-prev even?) status))
                 :expected (quote ([1 [2 [[[| 6 7]]] [3]] [4 5]]))}
                {:name "returns a zipper given a data structure with | as the status #74"
                 :meta {:refer (quote std.lib.zip/from-status)
                        :added "3.0"}
                 :test (fn []
                           (from-status (quote [1 2 3 | 4])))
                 :expected (collection/contains {:right (quote (4))
                                                 :left  (quote (3 2 1))})}
                {:name "creates a form zip #75"
                 :meta {:refer (quote std.lib.zip/form-zip)
                        :added "4.0"}
                 :test (fn []
                           (-> (form-zip (quote ([x] 1)))
                               step-next status))
                 :expected (quote ((| [x] 1)))}
                {:name "creates a form zip #76"
                 :meta {:refer (quote std.lib.zip/form-zip)
                        :added "4.0"}
                 :test (fn []
                           (-> (form-zip (quote ([x] 1)))
                               step-next step-next
                               step-next status))
                 :expected (quote (([x] | 1)))}
                {:name "creates a form zip #77"
                 :meta {:refer (quote std.lib.zip/form-zip)
                        :added "4.0"}
                 :test (fn []
                           (-> (form-zip (quote ([nil] 1)))
                               step-next step-next
                               step-next status))
                 :expected (quote (([nil] | 1)))}
                {:name "creates a form zip #78"
                 :meta {:refer (quote std.lib.zip/form-zip)
                        :added "4.0"}
                 :test (fn []
                           (-> (form-zip (quote (1 nil 2 3)))
                               step-next step-next
                               step-next status))
                 :expected (quote ((1 nil | 2 3)))}
                {:name "creates a form zip #79"
                 :meta {:refer (quote std.lib.zip/form-zip)
                        :added "4.0"}
                 :test (fn []
                           (-> (form-zip (quote (defn hello [x] (+ 1 2 3))))
                               (find-next #{3}) status))
                 :expected (quote ((defn hello [x] (+ 1 2 | 3))))}
                {:name "creates a form zip #80"
                 :meta {:refer (quote std.lib.zip/form-zip)
                        :added "4.0"}
                 :test (fn []
                           (-> (form-zip {:a 1 :b 2})
                               step-inside (insert-left [:c 4])
                               step-outside status))
                 :expected (quote (| {:a 1 :b 2 :c 4}))}
                {:name "creates a form zip #81"
                 :meta {:refer (quote std.lib.zip/form-zip)
                        :added "4.0"}
                 :test (fn []
                           (-> (form-zip #{:c :b :a})
                               step-inside (insert-left :e)
                               step-outside status))
                 :expected (quote (| #{:e :c :b :a}))}
                {:name "emulates std.lib.walk/prewalk behavior with zipper #82"
                 :meta {:refer (quote std.lib.zip/prewalk)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [[1 2] [3 4]])
                               (zip/prewalk (fn [v]
                                                (if (vector? v)
                                                    (conj v 100) (+ v 100)))) root-element))
                 :expected [[101 102 200] [103 104 200]
                            200]}
                {:name "emulates std.lib.walk/postwalk behavior with zipper #83"
                 :meta {:refer (quote std.lib.zip/postwalk)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [[1 2] [3 4]])
                               (zip/postwalk (fn [v]
                                                 (if (vector? v)
                                                     (conj v 100) (+ v 100)))) root-element))
                 :expected [[101 102 100] [103 104 100]
                            100]}
                {:name "performs a match at each level #84"
                 :meta {:refer (quote std.lib.zip/matchwalk)
                        :added "3.0"}
                 :test (fn []
                           (-> (matchwalk (vector-zip [1 [2 [3 [4]]]])
                                          [(fn [zip]
                                             (= 2
                                               (first (right-element zip)))) (fn [zip]
                                                                               (= 4
                                                                                 (first (right-element zip))))] delete-left)
                               root-element))
                 :expected [1 [2 [[4]]]]}
                {:name "performs a match at the same level #85"
                 :meta {:refer (quote std.lib.zip/levelwalk)
                        :added "3.0"}
                 :test (fn []
                           (-> (vector-zip [1 2 3 4])
                               step-inside (levelwalk [(fn [zip]
                                                         (odd? (right-element zip)))]
                                                      delete-right)
                               root-element))
                 :expected [2 4]}]
               process/check)]
  (mapv (fn [result]
          (select-keys result
            [:name :pass :status :error]))
    results))
