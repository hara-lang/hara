(ns std.lib.context.registry-test
  (:require [std.lib.context.registry :as registry]))

(def results
  (Test/run
   [{:name "null runtime and initial registry are installed"
     :test (fn []
             [(registry/rt-null? registry/+rt-null+)
              (set (registry/registry-list))
              (set (registry/registry-rt-list :null))])
     :expected [true #{:null} #{:default}]}
    {:name "registry operations preserve names and nested configuration"
     :test (fn []
             (binding [registry/*registry* (atom {})]
               (registry/registry-install
                :demo
                {:rt {:default {:key :default
                                :create (fn [config] config)
                                :config {:outer {:left 1}}}}})
               (registry/registry-rt-add
                :demo {:key :other :config {:value 2}})
               (let [runtime (registry/registry-rt :demo :default)]
                 (registry/registry-scratch-set :demo {:scratch true})
                 [(:config runtime)
                  (set (registry/registry-rt-list :demo))
                  (registry/registry-scratch :demo)
                  (let [removed (registry/registry-uninstall :demo)]
                    [(get-in removed [:rt :default :key])
                     (fn? (get-in removed [:rt :default :create]))
                     (get-in removed [:rt :other :config])])])))
     :expected [{:outer {:left 1}}
                #{:default :other}
                {:scratch true}
                [:default true {:value 2}]]}]))

(pr-str results)
