(ns std.lib.format.prose-test
  (:use code.test)
  (:require [std.lib.format.prose :as prose]))

^{:refer std.lib.format.prose/has-quotes?}
(fact "detects surrounding quotes"
  [(prose/has-quotes? "\"hello\"")
   (prose/has-quotes? "hello")]
  => [true false])

^{:refer std.lib.format.prose/strip-quotes}
(fact "strips one surrounding quote pair"
  [(prose/strip-quotes "\"hello\"")
   (prose/strip-quotes "hello")]
  => ["hello" "hello"])

^{:refer std.lib.format.prose/whitespace?}
(fact "recognises empty and whitespace-only strings"
  [(prose/whitespace? "")
   (prose/whitespace? "  \t")
   (prose/whitespace? "x")]
  => [true true false])

^{:refer std.lib.format.prose/escape-dollars}
(fact "escapes dollar signs"
  (prose/escape-dollars "$")
  => "\\$")

^{:refer std.lib.format.prose/escape-newlines}
(fact "makes newlines printable"
  (prose/escape-newlines "a\nb")
  => "a\\nb")

^{:refer std.lib.format.prose/escape-escapes}
(fact "duplicates a backslash before an escape"
  (prose/escape-escapes "\\n")
  => "\\\\n")

^{:refer std.lib.format.prose/escape-quotes}
(fact "escapes quotes for readable string output"
  (prose/escape-quotes "\"hello\"")
  => "\\\"hello\\\"")

^{:refer std.lib.format.prose/filter-empty-lines}
(fact "removes blank lines"
  (prose/filter-empty-lines "a\n  \n   \nb")
  => "a\nb")

^{:refer std.lib.format.prose/single-line}
(fact "joins lines with spaces"
  (prose/single-line "a\nb\nc")
  => "a b c")

^{:refer std.lib.format.prose/join-lines}
(fact "joins values with newlines"
  (prose/join-lines ["hello" "world"])
  => "hello\nworld")

^{:refer std.lib.format.prose/|}
(fact "joins variadic values with newlines"
  (prose/| "abc" "def")
  => "abc\ndef")

^{:refer std.lib.format.prose/lines}
(fact "returns a namespaced line form"
  (map str (prose/lines "abc\ndef"))
  => ["std.lib.format.prose/|" "abc" "def"])

^{:refer std.lib.format.prose/spaces}
(fact "creates spaces"
  (prose/spaces 4)
  => "    ")

^{:refer std.lib.format.prose/write-line}
(fact "writes nested data compactly"
  (prose/write-line [:a :b ["hello" "world"]])
  => "a b hello world")

^{:refer std.lib.format.prose/write-lines}
(fact "writes a block of values"
  (prose/write-lines ["a" "b" "c"])
  => "a\nb\nc")

^{:refer std.lib.format.prose/indent}
(fact "indents every line"
  [(prose/indent "a\nb" 2)
   (prose/indent "a\nb" 1 {:custom ">"})]
  => ["  a\n  b" " >a\n >b"])

^{:refer std.lib.format.prose/indent-rest}
(fact "indents every line after the first"
  (prose/indent-rest "a\nb\nc" 2)
  => "a\n  b\n  c")

^{:refer std.lib.format.prose/multi-line?}
(fact "detects line breaks"
  [(prose/multi-line? "a\nb")
   (prose/multi-line? "a")]
  => [true false])

^{:refer std.lib.format.prose/single-line?}
(fact "detects single-line text"
  [(prose/single-line? "a\nb")
   (prose/single-line? "a")]
  => [false true])

^{:refer std.lib.format.prose/layout-lines}
(fact "packs tokens below a maximum width"
  (prose/layout-lines ["hello" "world" "again" "a" "b"] 8)
  => "hello\nworld\nagain a\nb")

(pr-str (run {:namespace "std.lib.format.prose-test"}))
