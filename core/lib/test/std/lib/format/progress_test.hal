(ns std.lib.format.progress-test
  (:use code.test)
  (:require [std.lib.format.progress :as progress]))

^{:refer std.lib.format.progress/replace-center}
(fact "replaces the center of a background with text"
  (progress/replace-center "=================" " hello ")
  => "===== hello =====")

^{:refer std.lib.format.progress/progress-bar-string}
(fact "converts progress to a bar string"
  (progress/progress-bar-string 50 100 (:bar progress/+progress-defaults+))
  => "===================== 50/100                      ")

^{:refer std.lib.format.progress/progress-spinner-string}
(fact "converts progress to a spinner string"
  [(progress/progress-spinner-string 9 20)
   (progress/progress-spinner-string 20 20)]
  => ["-" ""])

^{:refer std.lib.format.progress/progress-eta}
(fact "calculates estimated time remaining"
  (progress/progress-eta 100 90 90)
  => 10)

^{:refer std.lib.format.progress/progress}
(fact "creates a progress meter with a resettable state boundary"
  (let [meter (progress/progress {:total 12 :label "Load"})]
    (select-keys (deref (:state meter)) [:total :current :label])
    => {:total 12 :current 0 :label "Load"}))

^{:refer std.lib.format.progress/progress-string}
(fact "formats a progress meter state"
  (progress/progress-string
   {:total 100 :current 9 :label ""
    :start-time 1 :update-time 11}
   progress/+progress-defaults+)
  => "[=====                 9/100                       ] 101s -")

^{:refer std.lib.format.progress/progress-update}
(fact "updates and caps the progress state"
  (let [meter (progress/progress {:total 3})]
    (progress/progress-update meter 2)
    (progress/progress-update meter 2)
    (:current (deref (:state meter))))
  => 3)

^{:refer std.lib.format.progress/progress-test}
(fact "runs a deterministic progress demonstration"
  (progress/progress-test)
  => "[====================== 3/3 =======================] 0s ")

(pr-str (run {:namespace "std.lib.format.progress-test"}))
