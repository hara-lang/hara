(ns std.lib.format.chart-test
  (:use code.test)
  (:require [std.lib.format.chart :as chart]))

(defn ascii [values]
  (str/join "\n" values))

^{:refer std.lib.format.chart/lines-bar-graph}
   (fact "formats an ASCII bar graph"
     (chart/lines-bar-graph (range 10) 6)
     => ["    ▟" "  ▗██" " ▟███"])

   ^{:refer std.lib.format.chart/bar-graph}
   (fact "constructs a bar graph"
     (str/split-lines (chart/bar-graph (range 10) 6))
     => ["    ▟" "  ▗██" " ▟███"])

   ^{:refer std.lib.format.chart/sparkline}
   (fact "formats a sparkline"
     [(chart/sparkline (range 8))
      (chart/sparkline [1 3 5 7 3 4 6 8 4 2 4 5 7 10])]
     => [" ▁▂▃▅▆▇█" " ▂▄▆▂▃▅▇▃▁▃▄▆█"])

   ^{:refer std.lib.format.chart/tree-graph}
   (fact "renders a tree with indentation"
     (vec (butlast
           (str/split-lines
            (chart/tree-graph '[{a "1.1"}
                                [{b "1.2"}
                                 [{c "1.3"}
                                  {d "1.4"}]]]))))
     => ["{a \"1.1\"}" " {b \"1.2\"}" "  {c \"1.3\"}" "  {d \"1.4\"}"])

   ^{:refer std.lib.format.chart/table-basic-format}
   (fact "formats a basic table"
     (chart/table-basic-format [:id :value]
                               [{:id 1 :value "a"}
                                {:id 2 :value "b"}])
     => (ascii ["| :id | :value |"
                "|-----+--------|"
                "|   1 |    \"a\" |"
                "|   2 |    \"b\" |"]))

   ^{:refer std.lib.format.chart/table-basic-parse}
   (fact "parses a basic table"
     (chart/table-basic-parse
      (ascii ["| :id | :value |"
              "|-----+--------|"
              "|   1 |    \"a\" |"
              "|   2 |    \"b\" |"]))
     => {:headers [:id :value]
         :data [{:id 1 :value "a"}
                {:id 2 :value "b"}]})

   ^{:refer std.lib.format.chart/table}
   (fact "formats a keyed table"
     (chart/table {"a@a.com" {:id 1 :value "a"}
                   "b@b.com" {:id 2 :value "b"}}
                  {:headers [:id :email :value]
                   :sort-key :email
                   :id-key :email})
     => (ascii ["| :id |    :email | :value |"
                "|-----+-----------+--------|"
                "|   1 | \"a@a.com\" |    \"a\" |"
                "|   2 | \"b@b.com\" |    \"b\" |"]))

   ^{:refer std.lib.format.chart/table-parse}
   (fact "parses a keyed table"
     (chart/table-parse
      (ascii ["| :id |    :email | :value |"
              "|-----+-----------+--------|"
              "|   1 | \"a@a.com\" |    \"a\" |"
              "|   2 | \"b@b.com\" |    \"b\" |"])
      {:headers [:id :email :value]
       :sort-key :email
       :id-key :email})
     => {"a@a.com" {:id 1 :value "a"}
         "b@b.com" {:id 2 :value "b"}})

(pr-str (run {:namespace "std.lib.format.chart-test"}))
