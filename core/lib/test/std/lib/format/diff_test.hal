(ns std.lib.format.diff-test
  (:require [code.test.base.process :as process]
            [std.lib.format.diff :as diff]))

(defn check [test expected] (process/check test expected))

(Test/run
 [{:name "renders Foundation-compatible ANSI diff output"
   :test (fn [] (diff/->string (diff/diff "a\nold" "a\nnew")))
   :expected "\u001B[1m@@ -1,1 +1,1 \u001B[0m\n\u001B[31m-\u001B[31m\u001B[40mold\u001B[0m\u001B[0m\n\u001B[32m+\u001B[32m\u001B[40mnew\u001B[0m\u001B[0m\n"}]
 check)
