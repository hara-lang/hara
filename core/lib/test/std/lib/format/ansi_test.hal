(ns std.lib.format.ansi-test
  (:use code.test)
  (:require [std.lib.format.ansi :as ansi]))

^{:refer std.lib.format.ansi/encode-raw}
(fact "encodes raw ANSI modifier codes"
  (ansi/encode-raw [30 20])
  => "\u001b[30;20m")

^{:refer std.lib.format.ansi/encode}
(fact "encodes named and custom modifiers"
  [(ansi/encode :bold)
   (ansi/encode :warn)]
  => ["\u001b[1m" "\u001b[33m"])

^{:refer std.lib.format.ansi/style}
(fact "styles one value with multiple modifiers"
  (ansi/style "hello" [:bold :red])
  => "\u001b[1;31mhello\u001b[0m")

^{:refer std.lib.format.ansi/style-remove}
(fact "removes an ANSI-only control string and preserves text"
  [(ansi/style-remove "\u001b[0m")
   (ansi/style-remove "hello")]
  => ["" "hello"])

^{:refer std.lib.format.ansi/style-values}
(fact "styles each value independently before resetting"
  (ansi/style-values :red ["a" "b"])
  => "\u001b[31ma\u001b[31mb\u001b[0m")

^{:refer std.lib.format.ansi/grey}
 (fact "grey applies its modifier" (ansi/grey "hello") => "\u001b[30mhello\u001b[0m")
^{:refer std.lib.format.ansi/red}
 (fact "red applies its modifier" (ansi/red "hello") => "\u001b[31mhello\u001b[0m")
