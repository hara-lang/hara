(ns std.lib.format.plural-test
  (:use code.test)
  (:require [std.lib.format.plural :as plural]))

^{:refer std.lib.format.plural/uncountable?}
   (fact "recognises uncountable words"
     [(plural/uncountable? "gold")
      (plural/uncountable? "moose")]
     => [true true])

   ^{:refer std.lib.format.plural/irregular?}
   (fact "recognises irregular words"
     (plural/irregular? "geese") => true)

   ^{:refer std.lib.format.plural/resolve-rules}
   (fact "resolves the first matching rule"
     [(plural/resolve-rules @plural/*singular-rules* "hello")
      (plural/resolve-rules @plural/*singular-rules* "hellos")]
     => [nil "hello"])

   ^{:refer std.lib.format.plural/singular}
   (fact "converts plural words to singular"
     [(plural/singular "rats")
      (plural/singular "geese")]
     => ["rat" "goose"])

^{:refer std.lib.format.plural/plural}
   (fact "converts singular words to plural"
     [(plural/plural "man")
      (plural/plural "rate")
      (plural/plural "inventory")
      (plural/plural "moose")]
     => ["men" "rates" "inventories" "moose"])

(pr-str (run {:namespace "std.lib.format.plural-test"}))
