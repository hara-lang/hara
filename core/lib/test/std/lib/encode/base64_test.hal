(ns std.lib.encode.base64-test
  (:require [std.lib.encode.base64 :as base64]))

(def +all-bytes+ (apply bytes (range 0 256)))

(def results
  [(test-check "Base64 emits canonical padded RFC 4648 output"
               [(base64/encode (str/encode-utf8 ""))
                (base64/encode (str/encode-utf8 "f"))
                (base64/encode (str/encode-utf8 "fo"))
                (base64/encode (str/encode-utf8 "foo"))
                (base64/encode (str/encode-utf8 "foobar"))]
               ["" "Zg==" "Zm8=" "Zm9v" "Zm9vYmFy"])

   (test-check "Base64 decodes UTF-8 bytes and round trips every byte"
               [(= (base64/decode "SGFyYSDOuw==")
                   (str/encode-utf8 "Hara λ"))
                (= (base64/decode (base64/encode +all-bytes+))
                   +all-bytes+)]
               [true true])

   (test-check "Base64 rejects non-Bytes encode input and malformed values"
               [(try (base64/encode "f") false
                     (catch Throwable error true))
                (try (base64/decode "abc") false
                     (catch Throwable error true))
                (try (base64/decode "Zm$=") false
                     (catch Throwable error true))
                (try (base64/decode "Zg=A") false
                     (catch Throwable error true))
                (try (base64/decode "Zg==AAAA") false
                     (catch Throwable error true))
                (try (base64/decode "Zh==") false
                     (catch Throwable error true))
                (try (base64/decode "Zg") false
                     (catch Throwable error true))]
               [true true true true true true true])])

results
