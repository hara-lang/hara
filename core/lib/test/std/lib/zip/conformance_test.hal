^{:refer std.lib.zip/at-end? :added "3.0"}
(Test/run
 [  {:name "std/lib/zip/at-end?-000"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(->> (from-status (quote [1 [[|]]])) (at-end?))"}))
   :expected true}
    {:name "std/lib/zip/at-end?-001"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(->> (from-status (quote [1 [[[2 |]] 3]])) (at-end?))"}))
   :expected false}]
 conformance-test-check)

