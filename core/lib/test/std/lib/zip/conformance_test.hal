(Test/run
 [  {:name "std/lib/zip/step-inside-most-left-000"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(-> (from-status (quote [[1 [2]] | 3 4])) (step-inside-most-left) (status))"}))
   :expected (quote ([[1 [2 |]] 3 4]))}]
 conformance-test-check)

