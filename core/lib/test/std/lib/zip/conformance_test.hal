^{:refer std.lib.zip/surround :added "3.0"}
(Test/run
 [  {:name "std/lib/zip/surround-000"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(-> (vector-zip 3) (insert-left 1 2) (surround) (status))"}))
   :expected (quote (| [1 2 3]))}
    {:name "std/lib/zip/surround-001"
