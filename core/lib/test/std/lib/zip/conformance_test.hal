^{:refer std.lib.zip/form-zip :added "3.0"}
(Test/run
 [  {:name "std/lib/zip/form-zip-000"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(do (form-zip :hello) (-> (form-zip (quote ([x] 1))) (step-next) (status)))"}))
   :expected (quote ((| [x] 1)))}
    {:name "std/lib/zip/form-zip-001"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(-> (form-zip (quote ([x] 1))) (step-next) (step-next) (step-next) (status))"}))
   :expected (quote (([x] | 1)))}
    {:name "std/lib/zip/form-zip-002"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(do (-> (form-zip (quote ([nil] 1))) (step-next) (step-next) (step-next) (status)) (-> (form-zip (quote ([nil] 1))) (step-next) (step-next) (step-next) (status)))"}))
   :expected (quote (([nil] | 1)))}
    {:name "std/lib/zip/form-zip-003"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(-> (form-zip (quote (1 nil 2 3))) (step-next) (step-next) (step-next) (status))"}))
   :expected (quote ((1 nil | 2 3)))}
    {:name "std/lib/zip/form-zip-004"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(-> (form-zip (quote (defn hello [x] (+ 1 2 3)))) (find-next #{3}) (status))"}))
   :expected (quote ((defn hello [x] (+ 1 2 | 3))))}
    {:name "std/lib/zip/form-zip-005"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(-> (form-zip {:b 2, :a 1}) (step-inside) (insert-left [:c 4]) (step-outside) (status))"}))
   :expected (quote (| {:c 4 :b 2 :a 1}))}
    {:name "std/lib/zip/form-zip-006"
   :test (fn [] (evaluate-in-hara {:ns 'std.lib.zip :expr "(-> (form-zip #{:c :b :a}) (step-inside) (insert-left :e) (step-outside) (status))"}))
   :expected (quote (| #{:e :c :b :a}))}]
 conformance-test-check)

