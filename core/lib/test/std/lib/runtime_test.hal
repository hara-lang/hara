(ns std.lib.runtime-test
  (:require [std.lib.runtime :as runtime]))

(Test/run
 [{:name "exposes the active Runtime through a portable namespace"
   :test (fn []
           [(runtime/current)
            (runtime/load-string "(+ 19 23)")
            (symbol? (runtime/gensym "runtime"))
            (runtime/var-sym (var std.lib.runtime/current))
            (map? (runtime/snapshot))
            (map? (runtime/vars))
            (vector? (runtime/namespaces))
            (get (runtime/namespace 'std.lib.runtime) :namespace/state)
            (runtime/resolve 'missing/value)
            (runtime/eval '(+ 19 23))
            (runtime/eval-in 'std.lib.runtime-test '[(+ 20 22)])])
   :expected ['std.lib.runtime-test 42 true 'std.lib.runtime/current
              true true true :loaded nil 42 42]}])
