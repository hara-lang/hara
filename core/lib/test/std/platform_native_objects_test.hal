(ns std.platform-native-objects-test
  (:use code.test))

(def results
  [(fact "native data and capability objects are static aliases, not loadable Foundation namespaces"
     [(= Edn std.native.Edn)
      (= Json std.native.Json)
      (= Crypto std.native.Crypto)
      (= OS std.native.OS)
      (= Process std.native.Process)]
     => [true true true true true])
   (fact "Edn owns native EDN parsing and rendering"
     [(Edn/read "{:a [1 2] :b #{:x}}")
      (Edn/write {:a [1 2]})
      (Edn/pretty [:a 1] {})
      (Edn/read "(+ 1 2)")]
     => [{:a [1 2] :b #{:x}}
         "{:a [1 2]}"
         "[:a 1]"
         '(+ 1 2)])
   (fact "Edn rejects malformed pretty options with the rejected value"
     (try
       (Edn/pretty [:a 1] nil)
       (catch Throwable error
         (ex-data error)))
     => {:options nil})
   (fact "Json owns native JSON parsing and rendering"
     [(Json/read "{\"a\":[1,2]}")
      (Json/write {"a" [1 2]})
      (Json/pretty {"a" 1} {})]
     => [{"a" [1 2]}
         "{\"a\":[1,2]}"
         "{\n  \"a\": 1\n}"])
   (fact "Crypto owns native SHA-256"
     (Crypto/sha256 (str/encode-utf8 "abc"))
     => "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
   (fact "OS exposes native host identity without a Foundation child namespace"
     [(keyword? (OS/platform))
      (keyword? (OS/arch))
      (string? (OS/cwd))]
     => [true true true])])

(pr-str (run '[std.platform-native-objects-test]))
