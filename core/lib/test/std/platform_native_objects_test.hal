(ns std.platform-native-objects-test
  (:use code.test))

(def results
  [(fact "Edn is available as a native static object without a Foundation child require"
     [(Edn/read "{:a [1 2] :b #{:x}}")
      (Edn/write {:a [1 2]})
      (Edn/pretty [:a 1] {})
      (Edn/read "(+ 1 2)")]
     => [{:a [1 2] :b #{:x}}
         "{:a [1 2]}"
         "[:a 1]"
         '(+ 1 2)])
   (fact "Edn rejects malformed pretty options with the rejected value"
     (try
       (Edn/pretty [:a 1] nil)
       (catch Throwable error
         (ex-data error)))
     => {:options nil})
   (fact "Json is available as a native static object without a Foundation child require"
     [(Json/read "{\"a\":[1,2]}")
      (Json/write {"a" [1 2]})
      (Json/pretty {"a" 1} {})]
     => [{"a" [1 2]}
         "{\"a\":[1,2]}"
         "{\n  \"a\": 1\n}"])
   (fact "Crypto is available as a native static object without a Foundation child require"
     (Crypto/sha256 (str/encode-utf8 "abc"))
     => "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")])

(pr-str (run '[std.platform-native-objects-test]))
