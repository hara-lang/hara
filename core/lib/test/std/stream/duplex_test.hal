(ns std.stream.duplex-test
  (:require [std.stream.duplex :as duplex]))

(Test/run
 [{:name "facade creates, recognises, reads, sends, and closes Duplex values"
   :test (fn []
           (let [closed (atom 0)
                 source (stream (fn [] (co/yield :received)))
                 connection (duplex/create
                             source
                             (fn [value] (promise/from [:sent value]))
                             (fn [] (swap! closed inc)))]
             (let [received (deref (IStream/next (duplex/receive connection)))
                   sent (deref (duplex/send connection :value))]
               (duplex/close connection)
               (duplex/close connection)
               [(duplex/instance? connection)
                received
                sent
                (deref closed)
                (stream? source)])))
   :expected [true :received [:sent :value] 1 true]}
  {:name "facade recognises process Duplex values"
   :test (fn []
           (let [process (Process/spawn
                          ["sh" "-c" "read line; printf reply:$line"])
                 connection (Process/duplex process)]
             (deref (duplex/send connection (str/encode-utf8 "hello\n")))
             (Process/close-input process)
             (let [reply (str/decode-utf8
                          (deref (IStream/next (duplex/receive connection))))
                   status (deref (Process/wait process))]
               (duplex/close connection)
               [(duplex/instance? connection) reply status])))
   :expected [true "reply:hello" 0]}])

