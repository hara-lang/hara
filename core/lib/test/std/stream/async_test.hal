(ns std.stream.async-test
  (:require [std.stream.async :as async]))

(def results
  (Test/run
    [{:name "recognises native and managed streams"
      :test (fn []
              [(stream? (stream (fn [] nil)))
               (stream? (async/from-iterator [1]))
               (stream? [1])])
      :expected [true true false]}
     {:name "bridges iterators and composes transforms"
      :test (fn []
              (deref
                (async/collect
                  (async/take 3
                    (async/filter odd?
                      (async/map inc (async/from-iterator [0 1 2 3 4 5])))))))
      :expected [1 3 5]}
     {:name "unfold accepts promised steps"
      :test (fn []
              (deref
                (async/collect
                  (async/unfold
                    (fn [index]
                      (promise/from
                        (if (< index 3) [index (inc index)] nil)))
                    0))))
      :expected [0 1 2]}
     {:name "reduces asynchronously"
      :test (fn []
              (deref (async/reduce + 10 (async/from-iterator [1 2 3]))))
      :expected 16}
     {:name "rejects nil stream items"
      :test (fn []
              (try
                (do
                  (deref (async/next
                           (stream (fn [] (co/yield nil)))))
                  false)
                (catch Throwable error true)))
      :expected true}]))

results


