(ns std.platform-imatch-test
  (:require [code.test :as code-test]))

(defstruct EqualMatcher [expected])

(extend-type EqualMatcher IMatch
  (match-value [matcher actual]
    (Test/result
     nil actual (:expected matcher)
     (Test/compare actual (:expected matcher)))))

(def custom-result
  (IMatch/match-value
   (std.platform-imatch-test/EqualMatcher 42)
   42))

(def code-test-result
  (IMatch/match-value (code-test/exactly 42) 42))

(def nested-result
  (code-test/check
   (fn [] {:values [1 2 3]})
   (code-test/contains {:values [1 2]})))

(def results
  [(test-check
    "IMatch is the sole retained test-related protocol identity"
    [(boolean IMatch)
     (Test/passed? custom-result)]
    [true true])

   (test-check
    "code.test matchers implement the platform-owned IMatch contract directly"
    [(Test/passed? code-test-result)
     (Test/actual code-test-result)
     (Test/expected code-test-result)]
    [true 42 42])

   (test-check
    "nested code.test matching dispatches through the same platform protocol"
    [(Test/passed? nested-result)
     (Test/actual nested-result)]
    [true {:values [1 2 3]}])])

results
