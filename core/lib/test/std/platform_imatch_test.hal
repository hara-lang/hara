(ns std.platform-imatch-test
  (:require [code.test :as code-test]
            [std.lib.test :as test]
            [std.protocol.imatch :as match]))

(defstruct EqualMatcher [expected])

(extend-type EqualMatcher match/IMatch
  (match-value [matcher actual]
    {:pass (= (field matcher :expected) actual)
     :actual actual
     :expected (field matcher :expected)}))

(def custom-result
  (match/match-value
   (std.platform-imatch-test/EqualMatcher 42)
   42))

(def code-test-result
  (match/match-value (code-test/exactly 42) 42))

(def nested-result
  (code-test/check
   (fn [] {:values [1 2 3]})
   (code-test/contains {:values [1 2]})))

(def results
  [(test/check
    "IMatch is the sole retained test-related protocol identity"
    [(= match/IMatch std.protocol.imatch/IMatch)
     custom-result]
    [true {:pass true :actual 42 :expected 42}])

   (test/check
    "code.test matchers implement the platform-owned IMatch contract directly"
    [(:pass code-test-result)
     (:actual code-test-result)
     (:expected code-test-result)]
    [true 42 42])

   (test/check
    "nested code.test matching dispatches through the same platform protocol"
    [(:pass nested-result)
     (:actual nested-result)]
    [true {:values [1 2 3]}])])

(test/print-results results)
