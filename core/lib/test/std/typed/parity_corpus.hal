;; Shared portable/Rust/JVM parity corpus for std.typed schemas.
(ns std.typed.parity-corpus)

(def +cases+
  [[:normalize :primitive-alias
    ":integer"
    "primitive(:int)"]

   [:normalize :nested-union
    "[:or :int [:or :str :int] :str]"
    "union[primitive(:int),primitive(:str)]"]

   [:normalize :maybe-singleton
    "[:maybe :nil]"
    "primitive(:nil)"]

   [:normalize :qualified-reference
    "#'demo/Customer"
    "reference(demo/Customer)"]

   [:normalize :vector
    "[:vector :integer]"
    "vector(primitive(:int))"]

   [:normalize :tuple
    "[:tuple :keyword :int :str]"
    "tuple[primitive(:keyword),primitive(:int),primitive(:str)]"]

   [:normalize :map
    "[:map [:name :str] [:age :int]]"
    "map[:name=primitive(:str),:age=primitive(:int)]"]

   [:normalize :variadic-function
    "[:fn [:str & :any] :str]"
    "fn(fixed=[primitive(:str)],rest=primitive(:any),output=primitive(:str))"]

   [:normalize :multi-arity-function
    "[:function [:fn [:int] :int] [:fn [:str & :str] :str]]"
    "function[fn(fixed=[primitive(:int)],rest=none,output=primitive(:int)),fn(fixed=[primitive(:str)],rest=primitive(:str),output=primitive(:str))]"]

   [:normalize :enum-deduplication
    "[:enum :must :may :must]"
    "enum[:must,:may]"]

   [:error :unsupported-primitive
    ":instant"
    :unsupported-primitive]

   [:error :empty-schema
    "[]"
    :empty-schema]

   [:error :invalid-head
    "[Schema :int]"
    :invalid-head]

   [:error :vector-arity
    "[:vector]"
    :invalid-arity]

   [:error :map-field
    "[:map [:name]]"
    :invalid-map-field]

   [:error :duplicate-map-field
    "[:map [:name :str] [:name :int]]"
    :duplicate-map-field]

   [:error :function-inputs
    "[:fn :int :str]"
    :invalid-function-inputs]

   [:error :function-rest
    "[:fn [:str & :int :bool] :str]"
    :invalid-function-rest]

   [:error :function-member
    "[:function [:vector :int]]"
    :invalid-function-member]

   [:error :empty-enum
    "[:enum]"
    :empty-enum]

   [:error :unsupported-form
    "[:vec :any]"
    :unsupported-form]

   [:error :unsupported-value
    "\"not-a-schema\""
    :unsupported-value]

   [:assignable :integer-to-number
    ":num" ":int" true]

   [:assignable :number-to-integer
    ":int" ":num" false]

   [:assignable :union-subset
    "[:or :int :str]" ":int" true]

   [:compatible :numeric-overlap
    ":int" ":num" true]

   [:compatible :disjoint-primitives
    ":int" ":str" false]

   [:infer :integer-literal
    "1"
    "primitive(:int)"]

   [:infer :mixed-vector
    "[1 \"two\"]"
    "vector(union[primitive(:int),primitive(:str)])"]

   [:infer :let-arithmetic
    "(let [x 1] (+ x 2))"
    "primitive(:int)"]

   [:infer :branch-union
    "(if true 1 \"two\")"
    "union[primitive(:int),primitive(:str)]"]

   [:infer :implicit-nil-branch
    "(if true 1)"
    "union[primitive(:int),primitive(:nil)]"]

   [:infer :do-result
    "(do 1 \"done\")"
    "primitive(:str)"]

   [:infer :unknown-propagation
    "(+ missing 1)"
    "unknown"]

   [:infer-call :known-call
    "(label 1)"
    "label"
    "[:fn [:int] :str]"
    "primitive(:str)"]])
