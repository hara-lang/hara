(ns std.typed.schema-native-test
  (:use code.test)
  (:require [std.typed.schema :as schema]))

^{:refer 'std.typed.schema/normalize
  :id 'native-schema-and-canonical-primitive-forms}
(fact "normalizes native SchemaType values and canonical one-item primitive forms"
  (let [primitive (std.foundation/schema :int)
        user (std.foundation/schema [:map [:name :str]])]
    [(= (schema/normalize :int)
        (schema/normalize [:int]))
     (= (schema/normalize :int)
        (schema/normalize primitive))
     (schema/valid? [:int] 42)
     (schema/valid? [:int] "42")
     (schema/valid? user {:name "Ada"})
     (schema/valid? user {:name 42})
     (schema/compatible? primitive :int)])
  => [true true true false true false true])

(pr-str (run '[std.typed.schema-native-test]))
