(ns std.typed.explain-probe
  (:require [std.typed.explain :as explain]
            [std.typed.registry :as registry]))

(def nodes
  (registry/local
   'demo
   {'Node '[:map [:value :int] [:next [:maybe Node]]]}))

(pr-str
 (let [union (explain/explain [:or :int :str] :wrong)
      recursive (explain/explain 'Node
                                 {:value 1
                                  :next {:value "two" :next nil}}
                                 nodes)
      result (explain/check :int 42)]
  [(nil? (explain/explain :int 42))
   (:failure/code (first (:failures union)))
   (count (:failure/children (first (:failures union))))
   (every? explain/failure?
           (:failure/children (first (:failures union))))
   (:failure/path (first (:failures recursive)))
   (Result/success? result)
   (Result/data result)]))
