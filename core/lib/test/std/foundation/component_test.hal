(ns std.foundation.component-test
  (:require [std.lib.test :as test]
            [std.foundation.component :as component]))

(defstruct component-fixture [events property])

(extend-type component-fixture IComponent
  (props [fixture]
    {:value {:get (fn [] (deref (:property fixture)))
             :set (fn [value] (reset! (:property fixture) value))}
     :read-only {:get (fn [] :fixed)}})
  (status [fixture] :ready)
  (started? [fixture] false)
  (stopped? [fixture] false)
  (start [fixture]
    (do (swap! (:events fixture) conj :start) fixture))
  (stop [fixture]
    (do (swap! (:events fixture) conj :stop) fixture))
  (kill [fixture]
    (do (swap! (:events fixture) conj :kill) fixture))
  (remote? [fixture] false))

(defn fixture []
  (std.foundation.component-test/component-fixture (atom []) (atom 1)))

(def functions
  {:pre-start (fn [value]
                (do (swap! (:events value) conj :pre-start) value))
   :post-start (fn [value]
                 (do (swap! (:events value) conj :post-start) value))
   :pre-stop (fn [value]
               (do (swap! (:events value) conj :pre-stop) value))
   :post-stop (fn [value]
                (do (swap! (:events value) conj :post-stop) value))})

(def lifecycle-options
  {:functions functions
   :hooks {:pre-start [:pre-start]
           :post-start [:post-start]
           :pre-stop [:pre-stop]
           :post-stop [:post-stop]}})

(def results
  [(test/check "canonical component lifecycle preserves hook order"
               (let [value (fixture)]
                 (component/start value lifecycle-options)
                 (component/stop value lifecycle-options)
                 (deref (:events value)))
               [:pre-start :start :post-start :pre-stop :stop :post-stop])
   (test/check "canonical component properties retain getter and setter behavior"
               (let [value (fixture)
                     before (component/get-prop value :value)
                     written (component/set-prop value :value 42)
                     after (component/get-prop value :value)]
                 [before written after (set (component/all-props value))])
               [1 42 42 #{:value :read-only}])
   (test/check "with-component always stops after a thrown body"
               (let [value (fixture)]
                 (try
                   (component/with-component [running value]
                     (throw "component body failed"))
                   (catch Throwable error nil))
                 (deref (:events value)))
               [:start :stop])])

(test/print-results results)
