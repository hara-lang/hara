(ns std.foundation.os-test
  (:require [std.foundation.os :as os]
            [std.lib.test :as test]))

(test/print-results
 [(test/check "OS facade delegates to canonical native interfaces"
              [(keyword? (os/platform))
               (keyword? (os/arch))
               (string? (os/cwd))
               (= OS std.native.OS)
               (= Process std.native.Process)]
              [true true true true true])])
