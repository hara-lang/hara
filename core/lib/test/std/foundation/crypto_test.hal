(ns std.foundation.crypto-test
  (:use code.test)
  (:require [std.foundation.crypto :as crypto]))

(def results
  [(fact "sha256 returns a lowercase deterministic digest"
     (crypto/sha256 (str/encode-utf8 "abc"))
     => "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")])

(pr-str (run '[std.foundation.crypto-test]))
