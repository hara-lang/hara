;; Path algebra is part of std.fs.
(ns std.fs.path-test
  (:use code.test)
  (:require [std.fs.path :as path]))

(defn error-data
  [function]
  (try
    (do
      (function)
      nil)
    (catch Throwable error
      (ex-data error))))

(def results
  [(fact "normalise-roots-relative-paths-and-collapses-segments"
     [(path/normalise "")
      (path/normalise ".")
      (path/normalise "/")
      (path/normalise "src//./main.hal")
      (path/normalise "/src/lib/../main.hal")]
     => ["/" "/" "/" "/src/main.hal" "/src/main.hal"])

   (fact "normalise-does-not-expand-home-or-host-working-directory"
     [(path/normalise "~")
      (path/normalise "~/src")
      (path/normalise "src")]
     => ["/~" "/~/src" "/src"])

   (fact "normalise-rejects-mount-escape-host-separators-and-drives"
     (mapv
      (fn [value]
        (select-keys
         (error-data (fn [] (path/normalise value)))
         [:ex/code :file/operation :file/path :file/target]))
      ["../outside"
       "src\\main.hal"
       "C:/src/main.hal"
       "//C:/src/main.hal"])
     => [{:ex/code :file/outside-root
          :file/operation :normalise
          :file/path "../outside"
          :file/target nil}
         {:ex/code :file/invalid-path
          :file/operation :normalise
          :file/path "src\\main.hal"
          :file/target nil}
         {:ex/code :file/invalid-path
          :file/operation :normalise
          :file/path "C:/src/main.hal"
          :file/target nil}
         {:ex/code :file/invalid-path
          :file/operation :normalise
          :file/path "//C:/src/main.hal"
          :file/target nil}])

   (fact "normalise-rejects-non-string-inputs-synchronously"
     (select-keys
      (error-data (fn [] (path/normalise :src)))
      [:ex/code :file/operation :file/path :file/target])
     => {:ex/code :file/invalid-path
         :file/operation :normalise
         :file/path :src
         :file/target nil})

   (fact "join-appends-while-resolve-resets-on-absolute-components"
     [(path/join "/workspace" "/src" "main.hal")
      (path/resolve "/workspace" "/src" "main.hal")
      (path/resolve "/workspace/lib" "../src" "./main.hal")]
     => ["/workspace/src/main.hal"
         "/src/main.hal"
         "/workspace/src/main.hal"])

   (fact "join-and-resolve-reject-escape-above-the-mounted-root"
     [(get (error-data (fn [] (path/join "/src" "../.." "outside")))
           :ex/code)
      (get (error-data (fn [] (path/resolve "/src" "../.." "outside")))
           :ex/code)]
     => [:file/outside-root :file/outside-root])

   (fact "parent-root-file-name-and-segments-use-logical-semantics"
     [(path/parent "/")
      (path/parent "src/main.hal")
      (path/root "src/main.hal")
      (path/file-name "/")
      (path/file-name "src/main.hal")
      (path/segments "/")
      (path/segments "src/main.hal")]
     => ["/" "/src" "/" nil "main.hal" [] ["src" "main.hal"]])

   (fact "relativize-produces-portable-relative-paths"
     [(path/relativize "/src/lib" "/src/lib")
      (path/relativize "/src/lib" "/src/test/main.hal")
      (path/relativize "/" "/src/main.hal")
      (path/relativize "/src/main.hal" "/")]
     => ["." "../test/main.hal" "src/main.hal" "../.."])

   (fact "subpath-selects-and-re-roots-canonical-segments"
     [(path/subpath "/usr/local/bin/hara" 1)
      (path/subpath "/usr/local/bin/hara" 1 3)]
     => ["/local/bin/hara" "/local/bin"])

   (fact "subpath-rejects-empty-reversed-and-out-of-range-selections"
     (mapv
      (fn [indexes]
        (get
         (error-data
          (fn []
            (path/subpath "/a/b" (first indexes) (second indexes))))
         :ex/code))
      [[0 0] [2 1] [-1 1] [0 3]])
     => [:file/invalid-path
         :file/invalid-path
         :file/invalid-path
         :file/invalid-path])

   (fact "suffix-operations-are-logical-and-dotfile-aware"
     [(path/suffix "/src/main.hal")
      (path/suffix "/src/archive.tar.gz")
      (path/suffix "/src/.env")
      (path/suffix "/src/name.")
      (path/remove-suffix "/src/archive.tar.gz")
      (path/remove-suffix "/src/.env")
      (path/add-suffix "/src/main" "hal")
      (path/add-suffix "/src/main" ".hal")
      (path/replace-suffix "/src/main.clj" "hal")
      (path/replace-suffix "/src/main" "hal")]
     => ["hal" "gz" nil nil
         "/src/archive.tar" "/src/.env"
         "/src/main.hal" "/src/main.hal"
         "/src/main.hal" "/src/main.hal"])

   (fact "suffix-mutations-reject-the-root-and-nested-suffixes"
     [(get (error-data (fn [] (path/add-suffix "/" "hal")))
           :ex/code)
      (get (error-data (fn [] (path/add-suffix "/src/main" "tar.gz")))
           :ex/code)]
     => [:file/invalid-path :file/invalid-path])

   (fact "replace-suffix-preserves-its-operation-in-structured-errors"
     (select-keys
      (error-data (fn [] (path/replace-suffix "/" "hal")))
      [:ex/code :file/operation :file/path :file/target])
     => {:ex/code :file/invalid-path
         :file/operation :replace-suffix
         :file/path "/"
         :file/target nil})

   ;; `ns-publics` includes runtime bootstrap bindings in some profiles.
   ;; Resolve the canonical qualified names instead of treating that
   ;; implementation inventory as the portable module contract.
   (fact "foundation-path-contract-symbols-are-resolvable"
     (every?
      (fn [symbol]
        (not (nil? (resolve symbol))))
      '[std.fs.path/add-suffix
        std.fs.path/file-name
        std.fs.path/join
        std.fs.path/normalise
        std.fs.path/parent
        std.fs.path/relativize
        std.fs.path/remove-suffix
        std.fs.path/replace-suffix
        std.fs.path/resolve
        std.fs.path/root
        std.fs.path/segments
        std.fs.path/subpath
        std.fs.path/suffix])
     => true)])

(pr-str (run '[std.fs.path-test]))
