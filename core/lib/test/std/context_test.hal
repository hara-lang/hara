(ns std.context-test
  (:require [std.lib.test :as test]
            [std.context :as context]
            [std.lib.context :as legacy]))

(defstruct recording-runtime [events config])

(extend-type recording-runtime IContext
  (call [runtime & args]
    [(:config runtime) (vec args)]))

(extend-type recording-runtime IComponent
  (props [runtime] {})
  (status [runtime] :ready)
  (started? [runtime] false)
  (stopped? [runtime] false)
  (start [runtime]
    (do (swap! (:events runtime) conj [:start (:config runtime)]) runtime))
  (stop [runtime]
    (do (swap! (:events runtime) conj [:stop (:config runtime)]) runtime))
  (kill [runtime]
    (do (swap! (:events runtime) conj [:kill (:config runtime)]) runtime))
  (remote? [runtime] false))

(extend-type recording-runtime IContextLifeCycle
  (has-module? [runtime module] false)
  (setup-module [runtime module] runtime)
  (teardown-module [runtime module] runtime)
  (has-pointer? [runtime pointer] false)
  (setup-pointer [runtime pointer] runtime)
  (teardown-pointer [runtime pointer] runtime))

(defn with-test-context
  [function]
  (let [previous context/*registry*]
    (binding [context/*registry* (atom {})]
      (function))))

(def results
  [(test/check
    "canonical context creates, starts, invokes, and stops a registered runtime"
    (with-test-context
     (fn []
       (let [events (atom [])
             scratch (std.context-test/recording-runtime events {:scratch true})
             space (context/space)
             pointer (context/pointer :context-test {:answer 42})]
         (context/registry-install
          :context-test
          {:runtimes
           {:default
            {:create (fn [config]
                       (std.context-test/recording-runtime events config))
             :config {:base 1}}}})
         (context/registry-scratch-set! :context-test scratch)
         (context/context-set space :context-test :default {:local 2})
         (let [started (context/rt-start space :context-test)
               result
               [(context/space? space)
                (context/pointer? pointer)
                (instance? context/runtime-null-type (context/runtime-null))
                (instance? context/space-type space)
                (instance? context/pointer-type pointer)
                (context/ptr-context pointer)
                (context/ptr-val pointer :answer)
                (set (context/ptr-keys pointer))
                (context/context-list space)
                (context/rt-active space)
                (context/rt-started? space :context-test)
                (context/call started :a :b)
                (std.foundation/invoke-as pointer :x :y)
                (context/invoke-in pointer started :z)]]
           (context/rt-stop space :context-test)
           (conj result
                 (context/rt-stopped? space :context-test)
                 (deref events)))))))
    [true true true true true
     :context-test 42 #{:answer}
     [:context-test] [:context-test] true
     [{:base 1 :local 2} [:a :b]]
     [{:scratch true} [:x :y]]
     [{:base 1 :local 2} [:z]]
     true
     [[:start {:base 1 :local 2}]
      [:stop {:base 1 :local 2}]]])

   (test/check
    "legacy context facade returns canonical value identities"
    (with-test-context
     (fn []
       (let [runtime (legacy/runtime-null)
             space (legacy/space)
             pointer (legacy/pointer :legacy {:value 1})]
         [(instance? context/runtime-null-type runtime)
          (instance? context/space-type space)
          (instance? context/pointer-type pointer)
          (legacy/space? space)
          (legacy/pointer? pointer)
          (legacy/ptr-context pointer)])))
    [true true true true true :legacy])])

(test/print-results results)
