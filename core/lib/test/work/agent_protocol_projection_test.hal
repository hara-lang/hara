(ns work.agent-protocol-projection-test
  (:require [work.agent :as agent]
            [work.agent.ephemeral :as ephemeral]))

(def results
  [(test-check
    "IAgent projection and plain Agent maps share the same semantic representation"
    (let [spec {:agent/id :compiler
                :agent/driver :driver}
          wrapped (ephemeral/agent spec)]
      [(agent/agent-spec spec)
       (agent/agent-spec wrapped)])
    [{:agent/id :compiler
      :agent/driver :driver}
     {:agent/id :compiler
      :agent/driver :driver}])])

results
