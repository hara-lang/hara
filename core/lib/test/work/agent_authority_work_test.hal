(ns work.agent-authority-work-test
  (:require [work.base :as work]
            [work.agent :as agent]))

(def value
  {:agent/id :release
   :agent/driver
   (agent/ephemeral-work-driver
    :release-driver
    (fn [agent intent context input work-context] intent))
   :agent/authority
   (agent/ephemeral-authority :release-authority)})

(def results
  [(test-check
    "authority helpers produce Work before authorization or signing executes"
    (let [authorization (agent/authorize value {:action :release})
          signing (agent/sign value {:action :release})]
      [(satisfies? IWork authorization)
       (satisfies? IWork signing)
       (:authorized? (work/run authorization nil))
       (:authority/id (work/run signing nil))])
    [true true true :release-authority])])

results
