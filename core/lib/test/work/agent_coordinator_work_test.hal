(ns work.agent-coordinator-work-test
  (:require [work.base :as work]
            [work.agent :as agent]))

(def value
  {:agent/id :planner
   :agent/driver
   (agent/ephemeral-work-driver
    :planner-driver
    (fn [agent intent context input work-context] intent))
   :agent/coordinator
   (agent/ephemeral-coordinator)})

(def results
  [(test-check
    "coordination helpers produce Work before coordinator dispatch executes"
    (let [coordination (agent/coordinate value {:task/id :build})]
      [(satisfies? IWork coordination)
       (:op (work/work-spec coordination))
       (:task/id (work/run coordination nil))])
    [true :step :build])])

results
