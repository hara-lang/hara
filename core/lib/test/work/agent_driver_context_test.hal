(ns work.agent-driver-context-test
  (:require [work.base :as work]
            [work.agent :as agent]))

(def context-agent
  {:agent/id :contextual
   :agent/driver
   (agent/ephemeral-work-driver
    :contextual-drive
    (fn [agent intent context input work-context]
      {:intent intent
       :context context
       :input input}))})

(def results
  [(test-check
    "driver context is data carried into the generated Work"
    (work/run
     (agent/drive context-agent :inspect {:scope :repository})
     :payload)
    {:intent :inspect
     :context {:scope :repository}
     :input :payload})])

results
