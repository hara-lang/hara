(ns work.agent-capability-boundary-test
  (:require [work.agent :as agent]))

(def results
  [(test-check
    "driving requires an explicit driver capability"
    (try
      (agent/drive {:agent/id :missing-driver} :intent)
      :not-rejected
      (catch Throwable error
        (:agent/capability (ex-data error))))
    :agent/driver)

   (test-check
    "coordination requires an explicit coordinator capability"
    (try
      (agent/coordinate {:agent/id :missing-coordinator} {:task/id :one})
      :not-rejected
      (catch Throwable error
        (:agent/capability (ex-data error))))
    :agent/coordinator)

   (test-check
    "authority operations require an explicit authority capability"
    (try
      (agent/sign {:agent/id :missing-authority} {:action :one})
      :not-rejected
      (catch Throwable error
        (:agent/capability (ex-data error))))
    :agent/authority)])

results
