(ns work.flow.make.bulk-test
  (:require [work.flow.make.bulk :as bulk]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic]))

(defn migration-test-check
  [test expected]
  (let [result (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

^{:refer work.flow.make.bulk/make-bulk-filter :added "4.0"}
(Test/run [] migration-test-check)

^{:refer work.flow.make.bulk/make-bulk-get-keys :added "4.0"}
(Test/run
 [{:name "bulk get keys"
   :test (fn [] (bulk/make-bulk-get-keys {:a true} {:a {:deps []}}))
   :expected (quote [(:a) (:a)])}]
 migration-test-check)

^{:refer work.flow.make.bulk/make-bulk-build :added "4.0"}
(Test/run
 [{:name "build make bulk datastructure"
   :test (fn [] (bulk/make-bulk-build {:configs {}}))
   :expected [{} {}]}]
 migration-test-check)

^{:refer work.flow.make.bulk/make-bulk :added "4.0"}
(Test/run
 [{:name "make bulk"
   :test (fn [] (bulk/make-bulk {:actions {} :configs {} :name "test"}))
   :expected (collection/contains {:built {} :bulked {} :total number?})}]
 migration-test-check)

^{:refer work.flow.make.bulk/make-bulk-container-filter :added "4.0"}
(Test/run
 [{:name "filters configs based on container membership"
   :test (fn [] (bulk/make-bulk-container-filter {} []))
   :expected {}}]
 migration-test-check)

^{:refer work.flow.make.bulk/make-bulk-container-build :added "4.0"}
(Test/run
 [{:name "builds containers for bulk configs"
   :test (fn [] (bulk/make-bulk-container-build {} []))
   :expected (collection/contains {:built {} :bulked {} :total number?})}]
 migration-test-check)

^{:refer work.flow.make.bulk/make-bulk-gh-init :added "4.0"}
(Test/run
 [{:name "make bulk init github"
   :test (fn [] (bulk/make-bulk-gh-init {}))
   :expected {}}]
 migration-test-check)

^{:refer work.flow.make.bulk/make-bulk-gh-push :added "4.0"}
(Test/run
 [{:name "make bulk push github"
   :test (fn [] (bulk/make-bulk-gh-push {}))
   :expected {}}]
 migration-test-check)
