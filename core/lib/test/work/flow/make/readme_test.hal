(ns work.flow.make.readme-test
  (:require [work.flow.make.readme :refer :all]
    [std.lib.encode.base64 :as base64]
    [code.test.base.process :as process]
    [code.test.checker.common :as checker]
    [code.test.checker.collection :as collection]
    [code.test.checker.logic :as logic]))

(defn migration-test-check
  [test expected]
  (let [result (process/check test expected)]
    (if (not (Test/passed? result))
      (println :failure
               {:actual (Test/actual result)
                :expected (Test/expected result)
                :failures (Test/failures result)}))
    result))

^{:refer work.flow.make.readme/has-orgfile? :added "4.0"}
(Test/run [] migration-test-check)

^{:refer work.flow.make.readme/tangle-params :added "4.0"}
(Test/run [] migration-test-check)

^{:refer work.flow.make.readme/tangle-parse :added "4.0"}
(Test/run [] migration-test-check)

^{:refer work.flow.make.readme/tangle :added "4.0"}
(Test/run [] migration-test-check)

^{:refer work.flow.make.readme/make-readme-raw :added "4.0"}
(Test/run [] migration-test-check)

^{:refer work.flow.make.readme/make-readme :added "4.0"}
(Test/run [] migration-test-check)
