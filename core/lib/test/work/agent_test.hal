(ns work.agent-test
  (:require [work.base :as work]
            [work.agent :as agent]
            [work.agent.ephemeral :as ephemeral]
            [work.agent.openai :as openai]
            [work.agent.tool :as agent-tool]))

(def response-one
  {:id "resp_1"
   :status "completed"
   :output
   [{:type "function_call"
     :call_id "call_1"
     :name "add"
     :arguments "{\"a\":20,\"b\":22}"}]})

(def response-two
  {:id "resp_2"
   :status "completed"
   :output
   [{:type "message"
     :role "assistant"
     :content
     [{:type "output_text"
       :text "42"}]}]})

(defn fake-transport
  [request]
  (let [body (Json/read (:body request))
        input (get body "input")
        function-output (if (= 3 (count input)) (nth input 2) nil)
        response
        (cond
          (= 1 (count input))
          response-one

          (and (= "gpt-5" (get body "model"))
               (= "Use tools when useful." (get body "instructions"))
               (= "add" (get-in body ["tools" 0 "name"]))
               (= "function_call_output" (get function-output "type"))
               (= "call_1" (get function-output "call_id"))
               (= (openai/wire-value {:ok true :value 42})
                  (Json/read (get function-output "output"))))
          response-two

          :else
          (throw
           (ex-info "OpenAI driver emitted an invalid request transcript"
                    {:request/body body})))]
    {:status 200
     :body (Json/write (openai/wire-value response))}))

(def add-tool
  (agent/tool
   "add"
   "Adds two integers."
   {:type "object"
    :properties
    {:a {:type "integer"}
     :b {:type "integer"}}
    :required ["a" "b"]
    :additionalProperties false}
   (fn [arguments]
     (+ (get arguments "a")
        (get arguments "b")))))

(def effectful-tool
  (agent/tool
   "publish"
   "Publishes an external action."
   {:type "object"
    :properties {}
    :additionalProperties false}
   (fn [arguments]
     (throw
      (ex-info "Effectful callable crossed the Work boundary"
               {:tool/name "publish"})))
   {:effect :external}))

(def client
  (agent/openai-client
   {:model "gpt-5"
    :api-key "test-key"
    :transport fake-transport}))

(def openai-agent
  {:agent/id :calculator
   :agent/driver
   (agent/openai-driver
    {:client client
     :instructions "Use tools when useful."
     :tools [add-tool]
     :max-turns 4})})

(def driven-work
  (agent/drive openai-agent "What is 20 plus 22?"))

(def final-result
  (work/run driven-work nil))

(def coordination
  (agent/ephemeral-coordinator))

(def authority
  (agent/ephemeral-authority :test-authority {:release false}))

(def chief-agent
  {:agent/id :chief
   :agent/driver
   (agent/ephemeral-work-driver
    :research
    (fn [agent intent context input work-context]
      {:agent/id (:agent/id agent)
       :intent intent
       :input input}))
   :agent/coordinator coordination
   :agent/authority authority})

(def protocol-agent
  (ephemeral/agent chief-agent))

(def results
  [(test-check
    "Agent is ordinary data and protocol-backed agents project to the same map"
    [(agent/agent-spec chief-agent)
     (agent/agent-spec protocol-agent)
     (agent/agent-id protocol-agent)]
    [chief-agent chief-agent :chief])

   (test-check
    "drivers lower intent to existing Work operations"
    [(satisfies? IWork driven-work)
     (:op (work/work-spec driven-work))
     final-result]
    [true :step "42"])

   (test-check
    "OpenAI tool execution and request transcripts stay inside canonical Work"
    final-result
    "42")

   (test-check
    "effectful model tools are rejected before callable execution"
    (let [exposure
          (try
            (openai/request-body
             client
             {:input []
              :tools [effectful-tool]})
            :not-rejected
            (catch Throwable error
              [(:work/error (ex-data error))
               (:tool/effect (ex-data error))]))
          invocation
          (agent-tool/invoke
           (agent-tool/index [effectful-tool])
           {:call/id "effect-1"
            :tool/name "publish"
            :call/arguments {}})]
      [exposure
       (:tool/status invocation)
       (get-in invocation [:tool/error :code])
       (get-in invocation [:tool/error :tool/effect])])
    [[:work/agent-tool-requires-work :external]
     :error
     :tool/requires-work
     :external])

   (test-check
    "ephemeral coordination is a capability while execution remains Work"
    (let [coordination-work
          (agent/coordinate chief-agent {:task/id :compile})
          value (work/run coordination-work {:source :unit})]
      [(satisfies? IWork coordination-work)
       (:op (work/work-spec coordination-work))
       (:task/id value)
       (:agent/id value)
       (:work/input value)])
    [true :step :compile :chief {:source :unit}])

   (test-check
    "ephemeral authority decisions and signatures are ordinary Work results"
    (let [authorization
          (work/run (agent/authorize chief-agent {:action :release}) nil)
          signature
          (work/run (agent/sign chief-agent {:action :handoff}) nil)]
      [(:authorized? authorization)
       (:authority/id authorization)
       (:authority/id signature)
       (first (:signature signature))])
    [false :test-authority :test-authority :test-authority])

   (test-check
    "ephemeral drivers also return Work rather than executing intent"
    (let [value (agent/drive chief-agent :inspect)]
      [(satisfies? IWork value)
       (:op (work/work-spec value))
       (work/run value :payload)])
    [true :step
     {:agent/id :chief
      :intent :inspect
      :input :payload}])])

results
