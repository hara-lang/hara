(ns work.agent-map-shape-test
  (:require [work.agent :as agent]))

(def results
  [(test-check
    "richer Agent maps compose capabilities without changing representation"
    (let [value
          {:agent/id :chief-research-agent
           :agent/driver :driver
           :agent/coordinator :coordinator
           :agent/authority :authority
           :agent/capabilities #{:research :review}}]
      (agent/agent-spec value))
    {:agent/id :chief-research-agent
     :agent/driver :driver
     :agent/coordinator :coordinator
     :agent/authority :authority
     :agent/capabilities #{:research :review}})])

results
