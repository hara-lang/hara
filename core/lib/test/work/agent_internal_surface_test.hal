(ns work.agent-internal-surface-test
  (:use code.test)
  (:require [work.agent.tool]
            [work.agent.tool.work]
            [work.agent.driver.openai]
            [work.agent.driver.openai.work]))

(defn resolved?
  [namespace name]
  (not
   (nil?
    (resolve
     (symbol namespace name)))))

(def results
  [(test-check
    "agent tool Work lowering is owned only by the internal namespace"
    [(resolved? "work.agent.tool.work" "call-work")
     (resolved? "work.agent.tool.work" "call-works")
     (resolved? "work.agent.tool.work" "effect-work")
     (resolved? "work.agent.tool" "call-work")
     (resolved? "work.agent.tool" "call-works")
     (resolved? "work.agent.tool" "effect-work")]
    [true true true false false false])

   (test-check
    "OpenAI Work graph construction is owned only by the internal namespace"
    [(resolved? "work.agent.driver.openai.work" "turn-work")
     (resolved? "work.agent.driver.openai.work" "model-step")
     (resolved? "work.agent.driver.openai.work" "tool-round-work")
     (resolved? "work.agent.driver.openai" "turn-work")
     (resolved? "work.agent.driver.openai" "model-step")
     (resolved? "work.agent.driver.openai" "tool-round-work")]
    [true true true false false false])])

results
