(ns work.bind-host-test
  (:use code.test)
  (:require [work.base :as work]))

(fact "the default ephemeral IWorkHost executes bind through the canonical evaluator"
  (let [workflow
        (work/bind
         {:id :host-bind}
         (work/pure :host-source
           (fn [input context]
             (inc input)))
         (work/pure :host-continuation
           (fn [value context]
             (work/step :host-produced
               (fn [produced-input produced-context]
                 (* produced-input 2))))))]
    (work/run workflow 4))
  => 10)

(pr-str (run '[work.bind-host-test]))
