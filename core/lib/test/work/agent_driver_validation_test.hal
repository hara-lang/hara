(ns work.agent-driver-validation-test
  (:require [work.agent :as agent]))

(def invalid-agent
  {:agent/id :invalid
   :agent/driver
   (agent/ephemeral-driver
    (fn [agent intent context]
      {:not-work true}))})

(def results
  [(test-check
    "agent drive rejects non-Work driver output at the capability boundary"
    (try
      (agent/drive invalid-agent :intent)
      :not-rejected
      (catch Throwable error
        (:agent/boundary (ex-data error))))
    :driver)])

results
