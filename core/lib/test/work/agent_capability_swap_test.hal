(ns work.agent-capability-swap-test
  (:require [work.base :as work]
            [work.agent :as agent]))

(defn signed-by
  [authority-id]
  (let [value {:agent/id :worker
               :agent/driver
               (agent/ephemeral-work-driver
                :worker
                (fn [agent intent context input work-context] intent))
               :agent/authority
               (agent/ephemeral-authority authority-id)}]
    (:authority/id
     (work/run (agent/sign value {:action :handoff}) nil))))

(def results
  [(test-check
    "authority providers are replaceable without changing agent algebra"
    [(signed-by :one) (signed-by :two)]
    [:one :two])])

results
