(ns work.agent-no-compat-test
  (:require [work.agent :as agent]))

(def results
  [(test-check
    "work.agent canonical entrypoints are capability and Work oriented"
    [(fn? agent/agent-spec)
     (fn? agent/drive)
     (fn? agent/coordinate)
     (fn? agent/authorize)
     (fn? agent/sign)]
    [true true true true true])])

results
