(ns work.agent-driver-work-test
  (:require [work.base :as work]
            [work.agent :as agent]))

(def value
  {:agent/id :builder
   :agent/driver
   (agent/ephemeral-work-driver
    :builder-driver
    (fn [agent intent context input work-context]
      [intent input]))})

(def results
  [(test-check
    "agent drive returns Work before intent execution"
    (let [driven (agent/drive value :build)]
      [(satisfies? IWork driven)
       (:op (work/work-spec driven))
       (work/run driven :source)])
    [true :step [:build :source]])])

results
