(ns work.agent-work-only-test
  (:require [work.base :as work]
            [work.agent :as agent]))

(def value
  {:agent/id :worker
   :agent/driver
   (agent/ephemeral-work-driver
    :worker-drive
    (fn [agent intent context input work-context]
      intent))})

(def results
  [(test-check
    "agent intent is represented by canonical Work before execution"
    (let [work-value (agent/drive value :compile)]
      [(satisfies? IWork work-value)
       (:op (work/work-spec work-value))])
    [true :step])])

results
