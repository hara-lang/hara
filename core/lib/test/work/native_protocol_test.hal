(ns work.native-protocol-test
  (:require [std.work.protocol :as protocol]
            [std.work.runtime.base :as base]))

(defstruct TestWorkHost [value])
(defstruct TestWorkRun [id])

(extend-type TestWorkHost IComponent
  (props [host] {})
  (status [host] :started)
  (started? [host] true)
  (stopped? [host] false)
  (start [host] host)
  (stop [host] host)
  (kill [host] host)
  (remote? [host] false))

(extend-type TestWorkHost protocol/IWorkHost
  (work-submit [host work input options]
    [work input options])
  (work-resolve [host reference]
    reference))

(extend-type TestWorkRun protocol/IWorkRef
  (work-id [run]
    (:id run)))

(extend-type TestWorkRun IClosed
  (closed? [run]
    true))

(extend-type TestWorkRun protocol/IWorkRun
  (work-status [run]
    :completed)
  (work-result [run]
    nil)
  (work-events [run options]
    nil)
  (work-cancel [run reason]
    nil))

(def results
  [(test-check
    "std.work compatibility Vars share the native protocol identities"
    [ (= protocol/IWork std.protocol.iwork/IWork)
      (= protocol/IWorkRef std.protocol.iworkref/IWorkRef)
      (= protocol/IWorkHost std.protocol.iworkhost/IWorkHost)
      (= protocol/IWorkRun std.protocol.iworkrun/IWorkRun)]
    [true true true true])

   (test-check
    "existing Work and WorkRef values satisfy the native contracts"
    (let [work (base/work-value {:op :pure :id :native-work})
          reference (base/work-reference "run-1")]
      [(satisfies? protocol/IWork work)
       (protocol/work-spec work)
       (satisfies? protocol/IWorkRef reference)
       (protocol/work-id reference)
       (base/reference-id reference)])
    [true
     {:op :pure :id :native-work}
     true
     "run-1"
     "run-1"])

   (test-check
    "HAL types extend the native host and run protocols with their parents"
    (let [host (TestWorkHost nil)
          run (TestWorkRun "run-2")]
      [(satisfies? protocol/IWorkHost host)
       (protocol/work-submit host :work :input {:priority :high})
       (protocol/work-resolve host "run-2")
       (satisfies? protocol/IWorkRun run)
       (protocol/work-status run)
       (protocol/work-id run)
       (closed? run)])
    [true
     [:work :input {:priority :high}]
     "run-2"
     true
     :completed
     "run-2"
     true])])

results
