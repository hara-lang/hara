(ns work.agent-plain-map-test
  (:require [work.agent :as agent]))

(def results
  [(test-check
    "plain maps are canonical Agent values without wrappers"
    (let [value {:agent/id :compiler
                 :agent/driver :placeholder}]
      [(agent/agent-spec value)
       (agent/agent-id value)])
    [{:agent/id :compiler
      :agent/driver :placeholder}
     :compiler])])

results
