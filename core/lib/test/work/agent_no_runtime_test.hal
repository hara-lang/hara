(ns work.agent-no-runtime-test
  (:require [work.agent :as agent]))

(def results
  [(test-check
    "work.agent exposes capability constructors rather than an agent runtime"
    [(fn? agent/ephemeral-coordinator)
     (fn? agent/ephemeral-authority)
     (fn? agent/openai-driver)]
    [true true true])])

results
