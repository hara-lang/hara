(ns work.agent-ephemeral-state-test
  (:require [work.base :as work]
            [work.agent :as agent]
            [work.agent.ephemeral :as ephemeral]))

(def results
  [(test-check
    "ephemeral mutable state records coordination only"
    (let [coordinator (agent/ephemeral-coordinator)
          value {:agent/id :planner
                 :agent/driver
                 (agent/ephemeral-work-driver
                  :planner
                  (fn [agent intent context input work-context] intent))
                 :agent/coordinator coordinator}]
      (work/run (agent/coordinate value {:task/id :one}) nil)
      (ephemeral/coordination-records coordinator))
    [{:task/id :one
      :agent/id :planner
      :work/input nil
      :coordination/index 1}])])

results
