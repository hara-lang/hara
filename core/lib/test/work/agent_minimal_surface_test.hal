(ns work.agent-minimal-surface-test
  (:require [work.agent.protocol :as protocol]))

(def results
  [(test-check
    "the minimal work.agent protocol family is present"
    [(nil? protocol/IAgent)
     (nil? protocol/IWorkAgentDriver)
     (nil? protocol/IWorkAgentCoordinator)
     (nil? protocol/IWorkAgentAuthority)]
    [false false false false])])

results
