(ns work.base-test
  (:require [work.base :as work]
            [std.work :as legacy]))

(def increment
  (work/pure
   :increment
   (fn [value context]
     (inc value))))

(def pipeline
  (work/chain
   {:id :pipeline}
   [increment
    (work/step
     :double
     (fn [value context]
       (* 2 value)))]))

(def area-graph
  (work/graph
   {:width (work/input :width)
    :height (work/input :height)
    :area (work/node [:width :height]
                     (fn [width height]
                       (* width height)))
    :label (work/node [:area]
                      (fn [area]
                        (str "Area: " area)))}))

(def results
  [(test-check
    "work graphs expose their dependency context through IDeps"
    [(satisfies? IDeps area-graph)
     (set (IDeps/dep-keys area-graph))
     (set (IDeps/dep-entries area-graph :area))
     (instance? work.base/GraphNode
                (IDeps/dep-get area-graph :area))]
    [true
     #{:width :height :area :label}
     #{:width :height}
     true])

   (test-check
    "work.base preserves the current work algebra"
    [(get (work/work-spec increment) :id)
     (get (work/work-spec increment) :op)
     (get (work/work-spec pipeline) :id)
     (get (work/work-spec pipeline) :op)]
    [:increment :pure :pipeline :chain])

   (test-check
    "work.base and std.work construct equivalent definitions"
    [(select-keys
      (work/work-spec
       (work/pure :value identity))
      [:id :op])
     (select-keys
      (legacy/work-spec
       (legacy/pure :value identity))
      [:id :op])]
    [{:id :value :op :pure}
     {:id :value :op :pure}])

   (test-check
    "work.base executes through the existing local runtime"
    (work/run (work/local-runtime) pipeline 4)
    10)

   (test-check
    "work.base eagerly executes a named computation graph"
    (work/run (work/local-runtime)
              area-graph
              {:width 6 :height 7})
    {:width 6 :height 7 :area 42 :label "Area: 42"})

   (test-check
    "work.base lazily executes only a requested dependency closure"
    (work/run (work/local-runtime)
              area-graph
              {:width 6 :height 7}
              {:evaluation :lazy
               :outputs [:area]})
    {:area 42})])

results
