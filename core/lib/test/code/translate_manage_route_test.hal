(ns code.translate-manage-route-test
  (:require [code.manage :as manage]
            [std.lib.test :as test]
            [std.work :as work]))

(def results
  [(test/check
    "code.manage exposes only the declared code.translate task"
    (let [task manage/clojure-to-hal
          spec (work/work-spec task)]
      [(:id spec)
       (:task/tasklet spec)
       (= task
          (manage/command-task
           :clojure-to-hal))
       (get manage/editing-operations
            :clojure-to-hal)])
    [:code.translate/clojure-to-hal-project
     'code.translate.clojure/migrate-source-unit
     true
     true])])

(test/print-results results)
