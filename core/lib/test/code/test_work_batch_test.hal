(ns code.test-work-batch-test
  (:require [code.test :as fact]
            [code.test.work :as test-work]
            [std.lib.test :as test]
            [std.work :as work]))

(def passing-count (atom 0))
(def failing-count (atom 0))

(fact/fact "batch passing fact"
  {:test/definition "definition:batch-passing-v1"}
  (do
    (swap! passing-count inc)
    1)
  => 1)

(fact/fact "batch failing fact"
  (do
    (swap! failing-count inc)
    1)
  => 2)

(def options
  {:namespace 'code.test-work-batch-test
   :test/revision 11})

(def runtime (work/durable-runtime))
(def reference
  (test-work/start-batch
   runtime
   options
   {:id "test-fact-batch"}))
(def durable-result (work/result runtime reference))
(def durable-manifest (test-work/fact-manifest options {} 11))
(def durable-summary (test-work/batch-result runtime reference))
(def durable-counts [(deref passing-count) (deref failing-count)])
(def same-reference
  (test-work/start-batch
   runtime
   options
   {:id "test-fact-batch"}))
(def replay-counts [(deref passing-count) (deref failing-count)])

(def local-summary
  (test-work/run-batch
   (work/local-runtime)
   options))
(def final-counts [(deref passing-count) (deref failing-count)])
(def fail-fast-before [(deref passing-count) (deref failing-count)])
(def fail-fast-summary
  (test-work/run-batch
   (work/local-runtime)
   (assoc options :fail-fast true)))
(def fail-fast-after [(deref passing-count) (deref failing-count)])

(def digest-fact
  {:namespace 'code.test-work-batch-test
   :name "synthetic digest fact"
   :meta {:test/digest "sha256:synthetic-v2"}})

(def results
  [(test/check
    "fact batch manifests are deterministic and definition aware"
    [(:op (work/work-spec (test-work/fact-batch-work 11)))
     (vec (map (fn [item] (:item/id item))
               durable-manifest))]
    [:chain
     [[:test/fact
       "code.test-work-batch-test"
       "batch failing fact"
       11
       11]
      [:test/fact
       "code.test-work-batch-test"
       "batch passing fact"
       11
       "definition:batch-passing-v1"]]])

   (test/check
    "explicit source digests invalidate checkpoint identity"
    [(test-work/fact-definition-token digest-fact 11)
     (test-work/fact-item-coordinate digest-fact 11)]
    ["sha256:synthetic-v2"
     [:test/fact
      "code.test-work-batch-test"
      "synthetic digest fact"
      11
      "sha256:synthetic-v2"]])

   (test/check
    "durable batches checkpoint each fact and preserve test-domain results"
    [(work/status runtime reference)
     (:status durable-summary)
     (get-in durable-summary [:counts :passed])
     (get-in durable-summary [:counts :failed])
     (:facts durable-summary)
     (:checks durable-summary)
     (count (work/checkpoints runtime reference))
     durable-counts]
    [:completed :failed 1 1 2 2 12 [1 1]])

   (test/check
    "idempotent starts reuse completed fact checkpoints"
    [(= (:run/id (work/run-record runtime reference))
        (:run/id (work/run-record runtime same-reference)))
     replay-counts]
    [true [1 1]])

   (test/check
    "local and durable fact batches return the ordinary code.test summary"
    [(:status local-summary)
     (get-in local-summary [:counts :passed])
     (get-in local-summary [:counts :failed])
     (:facts local-summary)
     final-counts]
    [:failed 1 1 2 [2 2]])

   (test/check
    "fail-fast is a generic batch stop policy with cancelled remaining facts"
    [(:status fail-fast-summary)
     (get-in fail-fast-summary [:counts :failed])
     (get-in fail-fast-summary [:counts :cancelled])
     fail-fast-before
     fail-fast-after]
    [:failed 1 1 [2 2] [2 3]])

   (test/check-error
    "prepared fact definitions reject registry drift"
    (test-work/resolve-subject-fact
     {:namespace 'code.test-work-batch-test
      :name "batch passing fact"
      :test/revision 11
      :test/definition "definition:wrong"}))])

(test/print-results results)
