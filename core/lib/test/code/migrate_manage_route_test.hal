(ns code.migrate-manage-route-test
  (:require [code.manage :as manage]
            
            [work.base :as work]))

(def results
  [(test-check
    "code.manage exposes only the declared code.migrate.project task"
    (let [task manage/clojure-to-hal
          spec (work/work-spec task)]
      [(:id spec)
       (:task/tasklet spec)
       (= task
          (manage/command-task
           :clojure-to-hal))
       (has? manage/editing-operations
             :clojure-to-hal)])
    [:code.migrate/clojure-to-hal-project
     'code.migrate.clojure/migrate-source-unit
     true
     true])])

results
