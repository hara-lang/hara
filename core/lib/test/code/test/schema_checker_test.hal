(ns code.test.schema-checker-test
  (:use code.test))

^{:refer 'code.test.checker.schema/conforms
  :id 'portable-schema-checker}
(fact "checks schemas explicitly and reports portable checker data"
  (let [checker (conforms [:map [:name :str]])
        matched (check (fn [] {:name "Ada"}) checker)
        mismatched (check (fn [] {:name 42}) checker)]
    [(Result/data matched)
     (Result/data mismatched)
     (comparison-expected mismatched)
     (has? (comparison-expected mismatched) :fn)])
  => [true false
      {:checker/type :typed/schema
       :checker/form [:map [:name :str]]}
      false])

(pr-str (run '[code.test.schema-checker-test]))
