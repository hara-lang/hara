(ns code.test.selector-test
  (:use code.test)
  (:require [code.test.selector :as selector]))

(def metadata
  {:unit #{:web :slow}
   :refer 'sample.core/render
   :namespace 'sample.core})

(fact "Foundation include/exclude metadata selectors are portable"
  [(selector/matches-options? metadata {:include [{:unit #{:web}}]})
   (selector/matches-options? metadata {:include [{:namespaces ['sample]}]})
   (selector/matches-options? metadata {:include [{:unit #{:web}}]
                                        :exclude [{:refers ['sample.core/render]}]})
   (selector/matches-options? metadata {})]
  => [true true false false])

(pr-str (run {:namespace "code.test.selector-test"}))
