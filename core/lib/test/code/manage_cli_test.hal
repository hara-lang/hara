(ns code.manage-cli-test
  (:require [code.manage.cli :as cli]))

[(test-check "manage owns operation and write argument parsing"
              (cli/parse-arguments
               ["ns-rename" "code.manage" "--from" "code.manage"
                "--to" "code.manage.next" "--write"])
              {:operation :ns-rename
               :write true
               :namespaces ["code.manage"]
               :options {:from "code.manage" :to "code.manage.next"}})
  (test-check "repeated patterns remain one ordered option"
              (:options
               (cli/parse-arguments
                ["purge" "--pattern" "TODO" "--pattern" "FIXME"]))
              {:patterns ["TODO" "FIXME"]})
  (test-check "namespace selectors use source path spelling"
              (cli/selected? "/project/src/code/manage.hal" ["code.manage"])
              true)
  (test-check "translation selectors are exact corpus namespaces"
              [(cli/translation-selected?
                {:namespace "std.lib.component"}
                ["std.lib.component"])
               (cli/translation-selected?
                {:namespace "std.lib.component.track"}
                ["std.lib.component"])
               (cli/translation-selected?
                {:namespace "std.lib.context.registry"
                 :recipe {:mode "aggregate"}}
                ["std.lib.context"])
               (cli/translation-selected? nil [])]
              [true false true false])
  (test-check "translation CLI retains Foundation and Hara roots"
              (cli/parse-arguments
               ["clojure-to-hal" "std.lib.component"
                "--from" "/foundation" "--to" "/hara"
                "--corpus" "/hara/routes.json"])
              {:operation :clojure-to-hal
               :write false
               :namespaces ["std.lib.component"]
               :options {:from "/foundation"
                         :to "/hara"
                         :corpus "/hara/routes.json"}})
  (test-check "semantic aggregation emits one unit for each target"
              (let [units
                    (cli/dedupe-translation-units
                     [{:source/path "registry.clj" :target/path "std/context.hal"}
                      {:source/path "space.clj" :target/path "std/context.hal"}
                      {:source/path "component.clj" :target/path "std/lib/component.hal"}])]
                [(vec (map :source/path units))
                 (:recipe/sources (first units))])
              [["registry.clj" "component.clj"]
               ["registry.clj" "space.clj"]])]
