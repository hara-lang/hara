(ns code.manage-transform-test
  (:use code.test)
  (:require [code.manage.unit :as unit]))

(def sample-unit
  {:path "sample.hal"
   :source "(ns sample.core)\n\n(defn answer [] 42)\n"})

(fact "transform options distinguish native functions from other IFn values"
  (let [append-newline (fn [source] (str source "\n"))
        direct
        (unit/transform-code
         sample-unit
         append-newline)
        configured
        (unit/transform-code
         sample-unit
         {:transform append-newline})]
    [(:after direct)
     (:after configured)])
  => [(str (:source sample-unit) "\n")
      (str (:source sample-unit) "\n")])

(pr-str (run {:namespace "code.manage-transform-test"}))
