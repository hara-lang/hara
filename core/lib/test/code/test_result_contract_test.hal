(ns code.test-result-contract-test
  (:use code.test))

^{:refer 'code.test.result/compare
  :id 'result-comparison-contract}
(fact "returns Result booleans and portable schema failures"
  (let [matched (comparison-result "match" 42 42 (compare 42 42))
        mismatched (compare {:name 42}
                            (conforms [:map [:name :str]]))]
    [(comparison-passed? matched)
     (comparison-actual matched)
     (comparison-expected matched)
     (Result/success? mismatched)
     (Result/data mismatched)
     (comparison-failure-count mismatched)
     (comparison-failure? (comparison-failure mismatched 0))])
  => [true 42 42 true false 1 true])

(pr-str (run '[code.test-result-contract-test]))
