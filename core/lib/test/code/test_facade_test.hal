(ns code.test-facade-test
  (:use code.test)
  (:require [code.test.base.runtime :as runtime]
            [code.test.work :as test-work]
            [work.base :as work]))

(fact "facade assertion calls remain available through :use and qualification"
  (select-keys (check (fn [] 42) 42) [:pass :status :actual])
  => {:pass true :status :success :actual 42}

  (select-keys (code.test/check (fn [] :ready) :ready)
               [:pass :status :actual])
  => {:pass true :status :success :actual :ready})

(fact:template "facade macros register through the canonical runtime"
  (select-keys
   (runtime/get-fact
    "code.test-facade-test"
    "facade macros register through the canonical runtime")
   [:namespace :name])
  => {:namespace "code.test-facade-test"
      :name "facade macros register through the canonical runtime"}

  [(:op (work/work-spec +runner-work+))
   (:op (work/work-spec test-work/+runner-work+))]
  => [:chain :chain])

(pr-str (run {:namespace "code.test-facade-test"}))
