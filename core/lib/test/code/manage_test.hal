(ns code.manage-test
  (:use code.test)
  (:require [code.manage :as manage]
            [code.manage.ns-rename :as ns-rename]
            [code.manage.unit :as unit]
            [code.manage.unit.scaffold :as scaffold]
            [code.manage.unit.template :as template]
            [std.work :as work]
            [std.work.command.task :as task-command]))

(def sample-unit
  {:path "sample.hal"
   :source "(ns sample.core)\n\n(defn answer [] 42)\n;; TODO document\n"})

(fact "Foundation-shaped namespaces own the functions and tasklets"
  [(task-command/tasklet? unit/analyse-unit)
   (task-command/tasklet? unit/heal-unit)
   (task-command/tasklet? ns-rename/ns-rename-unit)
   (:id (work/work-spec unit/heal-unit))
   (= (work/work-spec manage/heal-unit)
      (work/work-spec unit/heal-unit))
   (= (work/work-spec manage/ns-rename-unit)
      (work/work-spec ns-rename/ns-rename-unit))]
  => [true true true :code.manage/heal-code true true])

(fact "code.manage remains a public facade over independently declared tasklets"
  (let [direct (template/run-unit unit/analyse-unit sample-unit)
        result
        (work/run
         (work/local-runtime)
         (template/task-work unit/analyse-unit)
         {:units [sample-unit]})
        bulk (:item/value (first (:results result)))]
    [(:item/id direct)
     (:count (:summary result))
     (:results (:summary result))
     (get-in direct [:data :namespace])
     (= direct bulk)])
  => ["sample.hal" 1 1 "sample.core" true])

(fact "a namespace-owned tasklet remains an ordinary composable work value"
  (let [heal-then-analyse
        (work/chain
         {:id :code.manage/heal-then-analyse}
         [unit/heal-unit
          (work/pure
           :code.manage/use-healed-source
           (fn [record context]
             {:path (get-in record [:data :path])
              :source (get-in record [:data :after])}))
          unit/analyse-unit])
        result
        (work/run
         (work/local-runtime)
         heal-then-analyse
         {:path "composed.hal"
          :source "(ns composed.core)  "})]
    [(:item/id result)
     (get-in result [:data :namespace])
     (str/ends-with? (get-in result [:data :source]) "\n")])
  => ["composed.hal" "composed.core" true])

(fact "source edits are owned by code.manage.unit and remain dry-run"
  (let [edit (unit/grep-replace sample-unit "42" "43")]
    [(:changed edit) (:write edit) (:after edit)])
  => [true false "(ns sample.core)\n\n(defn answer [] 43)\n;; TODO document\n"])

(fact "maintenance reports preserve source location and do not write"
  (let [code-unit
        {:path "unclean.hal"
         :source "(ns unclean)  \n;; note"}
        result
        (manage/run :unclean-findings
                    {:units [code-unit]})
        findings
        (get-in result [:results 0 :item/value :data])]
    [(map (fn [entry] (:path entry)) findings)
     (map (fn [entry] (:kind entry)) findings)])
  => [["unclean.hal" "unclean.hal"]
      [:trailing-whitespace :missing-final-newline]])

(fact "the Foundation task inventory keeps the facade compatibility boundary"
  [(count manage/legacy-operations)
   (count manage/parity-inventory)
   (get-in manage/parity-inventory [:ns-rename :boundary])
   (get-in manage/parity-inventory [:find-usages :boundary])]
  => [35 35 :pure-edit-plan :portable-inspection])

(fact "plan and direct execution use the same namespace-owned tasklet"
  (let [code-unit
        {:path "src/demo/core.hal"
         :source
         "(ns demo.core)\n(defn beta [] 2)\n(defn alpha [] 1)\n"}
        options {:from 'demo.core :to 'demo.next}
        direct
        (template/run-unit
         ns-rename/ns-rename-unit
         code-unit
         options)
        plan
        (manage/plan
         :ns-rename
         {:units [code-unit]
          :options options})]
    [(= (:data direct)
        (get-in plan [:results 0 :item/value]))
     (get-in plan [:summary :changed])
     (get-in plan [:edits 0 :before])
     (get-in plan [:edits 0 :after])
     (get-in plan [:edits 0 :write])])
  => [true
      1
      "(ns demo.core)\n(defn beta [] 2)\n(defn alpha [] 1)\n"
      "(ns demo.next)\n(defn beta [] 2)\n(defn alpha [] 1)\n"
      false])

(fact "scaffolding is owned by code.manage.unit.scaffold"
  (let [edit
        (scaffold/scaffold
         {:path "src/demo/core.hal"
          :source "(ns demo.core)\n(defn answer [] 42)\n"}
         {:test-path "test/demo/core_test.hal"})]
    [(:path edit)
     (:create edit)
     (:before edit)
     (:write edit)
     (string? (:after edit))])
  => ["test/demo/core_test.hal" true "" false true])

(pr-str (run {:namespace "code.manage-test"}))
