(ns code.project.deploy.runtime-test
  (:require [code.project.deploy.runtime :as runtime]))

(def results
  [(test-check
    "deploy commands preserve exact output through tool.sh"
    (runtime/run ["sh" "-c" "printf 'artifact\n'"])
    {:command ["sh" "-c" "printf 'artifact\n'"]
     :stdout "artifact\n"
     :stderr ""
     :exit 0})

   (test-check
    "deploy commands apply their explicit failure policy"
    (try
      (runtime/run ["sh" "-c" "printf failure >&2; exit 4"])
      nil
      (catch Throwable error
        [(ex-message error)
         (select-keys (ex-data error) [:command :stdout :stderr :exit])
         (:ex/code (ex-data error))]))
    ["Hara package command failed"
     {:command ["sh" "-c" "printf failure >&2; exit 4"]
      :stdout ""
      :stderr "failure"
      :exit 4}
     :hara/dependency])])

results
