(ns code.migrate-bang-test
  (:use code.test)
  (:require [code.migrate.bang :as bang]
            [tool.project :as project]))

(def +sample-units+
  [{:path "a.hal"
    :source "(ns sample.a)\n(defn run [x] x)\n(defn run! [x] (run x))\n"}
   {:path "b.hal"
    :source "(ns sample.b (:require [sample.a :as a :refer [run!]]))\n(defn use-it [x] [(a/run! x) (run! x)])\n"}])

(def results
  [(fact "canonical reference mutations are excluded by qualified identity"
     (let [ledger
           (bang/rename-ledger
            [{:path "foundation.hal"
              :source
              "(ns std.foundation)\n(defn reset! [r v] v)\n(defn swap! [r f] (f r))\n(defn swap-return! [r f] (f r))\n(defn cas! [r a b] true)\n(defn reset-cache! [] nil)\n"}])]
       (mapv :source/refer ledger))
     => ['std.foundation/reset-cache!])

   (fact "a rename plan updates definitions aliases refers and calls"
     (let [migration
           (bang/plan +sample-units+ {'sample.a/run! 'sample.a/run-effect})
           outputs
           (reduce (fn [out unit] (assoc out (:path unit) (:after unit)))
                   {}
                   (:edits migration))]
       [(:valid migration)
        (:records migration)
        (get outputs "a.hal")
        (get outputs "b.hal")])
     => [true
         1
         "(ns sample.a)\n(defn run [x] x)\n(defn run-effect [x] (run x))\n"
         "(ns sample.b (:require [sample.a :as a :refer [run-effect]]))\n(defn use-it [x] [(a/run-effect x) (run-effect x)])\n"])

   (fact "suffix removal fails closed when the target already exists"
     (let [migration
           (bang/plan
            [{:path "collision.hal"
              :source "(ns sample.collision)\n(defn run [] nil)\n(defn run! [] nil)\n"}]
            {})]
       [(:valid migration)
        (mapv :migration/error (:diagnostics migration))])
     => [false [:bang-rename/existing-target]])])

(fact "Hara-owned production roots contain no disallowed bang definitions"
  (let [current-project (project/read-project "project.edn")
        migration
        (bang/plan
         (bang/project-units
          current-project
          (vec (concat (:project/source-paths current-project)
                       ["rust/hal-src"]))))]
    [(:valid migration)
     (:records migration)
     (:changed/files migration)
     (:diagnostics migration)])
  => [true 0 0 []])

(pr-str (run '[code.migrate-bang-test]))
