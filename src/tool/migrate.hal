(ns tool.migrate
  (:config {:role :facade})
  (:require [tool.migrate.common.transform]
            [tool.migrate.common.project :as project]
            [tool.migrate.policy.foundation.core :as foundation-core]
            [tool.migrate.policy.foundation.xt :as foundation-xt]))

;; The public facade keeps the historical task surface while making the
;; registry-backed common transform directly available.
(intern-all tool.migrate.common.transform)

(intern-in
 [foundation-xt-transform-source foundation-xt/transform-source]
 [foundation-xt-plan foundation-xt/xt-plan]
 [foundation-xt-validate-plan foundation-xt/validate-plan]
 [foundation-xt-apply-plan foundation-xt/apply-plan]
 [foundation-xt-inventory foundation-xt/xt-inventory]
 [foundation-xt-write-inventory foundation-xt/write-inventory]
 [foundation-lang-inventory foundation-core/foundation-lang-inventory]
 [foundation-lang-authority-paths foundation-core/foundation-lang-authority-paths]
 [foundation-lang-authority-units foundation-core/foundation-lang-authority-units]
 [foundation-lang-authority-inventory foundation-core/foundation-lang-authority-inventory]
 [foundation-lang-authority-plan foundation-core/foundation-lang-authority-plan]
 [foundation-lang-authority-apply foundation-core/foundation-lang-authority-apply]
 [foundation-lang-staged-paths foundation-core/foundation-lang-staged-paths]
 [foundation-lang-staged-units foundation-core/foundation-lang-staged-units]
 [foundation-lang-staged-inventory foundation-core/foundation-lang-staged-inventory]
 [foundation-lang-staged-apply-files foundation-core/foundation-lang-staged-apply-files]
 [foundation-lang-staged-plan foundation-core/foundation-lang-staged-plan]
 [foundation-lang-staged-apply foundation-core/foundation-lang-staged-apply]
 [foundation-common-test-source foundation-core/migrate-foundation-common-test-source]
 [foundation-lang-plan foundation-core/foundation-lang-plan]
 [foundation-lang-validate-plan foundation-core/foundation-lang-validate-plan]
 [foundation-lang-apply-plan foundation-core/foundation-lang-apply-plan]
 [foundation-script-inventory foundation-core/foundation-script-inventory]
 [foundation-lang-base-hard-cut-inventory foundation-core/foundation-lang-base-hard-cut-inventory]
 [foundation-lang-base-hard-cut-plan foundation-core/foundation-lang-base-hard-cut-plan]
 [foundation-lang-base-hard-cut-apply foundation-core/foundation-lang-base-hard-cut-apply]
 [project-plan project/plan]
 [project-validate-write-plan project/validate-write-plan])
