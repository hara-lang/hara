;; ============================================================================
;; tool.sh — canonical argv-only host command boundary.
;;
;; Command strings are never interpreted implicitly. Development hosts provide
;; std.native.Process; browser/Wasm hosts fail through structured exceptions.
;; ============================================================================
(ns tool.sh)

(def +option-keys+ #{:cwd :env :stdin :timeout})

(defn command
  "Validates and returns one argv vector."
  [argv]
  (if (and (vector? argv)
           (not (empty? argv))
           (every? string? argv))
    argv
    (throw
     (ex :dependency
         {:tool.sh/error :invalid-command
          :command argv}
         :ex/message "tool.sh requires a non-empty argv vector of strings"))))

(defn string-map?
  [value]
  (and (map? value)
       (every? (fn [key]
                 (and (string? key)
                      (string? (get value key))))
               (keys value))))

(defn options
  "Validates the closed process option map.

   Supported keys are :cwd, :env, :stdin, and :timeout. :stdin accepts a string
   or Bytes; :timeout accepts a non-negative integer and is consumed by run.
   Stdin is consumed only by execute/run/run-checked and never by spawn."
  [value]
  (let [value (or value {})]
    (if (not (map? value))
      (throw
       (ex :dependency
           {:tool.sh/error :invalid-options
            :options value}
           :ex/message "tool.sh options must be a map")))
    (let [unknown (vec (sort-by str
                               (filter
                                (fn [key]
                                  (not (has? +option-keys+ key)))
                                (keys value))))]
      (if (not (empty? unknown))
        (throw
         (ex :dependency
             {:tool.sh/error :unknown-options
              :options value
              :unknown unknown}
             :ex/message "tool.sh received unknown process options"))))
    (if (and (has? value :cwd)
             (not (string? (:cwd value))))
      (throw
       (ex :dependency
           {:tool.sh/error :invalid-cwd
            :options value}
           :ex/message "tool.sh :cwd must be a string")))
    (if (and (has? value :env)
             (not (string-map? (:env value))))
      (throw
       (ex :dependency
           {:tool.sh/error :invalid-env
            :options value}
           :ex/message "tool.sh :env must be a string-to-string map")))
    (if (and (has? value :stdin)
             (not (or (string? (:stdin value))
                      (bytes? (:stdin value)))))
      (throw
       (ex :dependency
           {:tool.sh/error :invalid-stdin
            :options value}
           :ex/message "tool.sh :stdin must be a string or Bytes")))
    (if (and (has? value :timeout)
            (not (or (nil? (:timeout value))
                     (and (long? (:timeout value))
                          (<= 0 (:timeout value))))))
      (throw
      (ex :dependency
          {:tool.sh/error :invalid-timeout
           :options value}
          :ex/message "tool.sh :timeout must be a non-negative integer")))
    value))

(defn process-options
  "Selects the options understood by Process/spawn."
  [value]
  (select-keys (options value) [:cwd :env]))

(defn process-failure
  [operation argv error]
  (let [data {:tool.sh/error :process-unavailable
              :tool.sh/operation operation
              :command argv
              :cause/message (ex-message error)
              :cause/data (ex-data error)}]
    (throw
     (if (ex? error)
       (ex :host data
           :ex/message "tool.sh process access is unavailable or failed"
           :ex/cause error)
       (ex :host data
           :ex/message "tool.sh process access is unavailable or failed")))))

(defn spawn
  "Starts one argv vector and returns the native process without closing stdin."
  ([argv]
   (spawn argv {}))
  ([argv value]
   (let [argv (command argv)
         selected (process-options value)]
     (try
       (if (empty? selected)
         (Process/spawn argv)
         (Process/spawn argv selected))
       (catch error
         (process-failure :spawn argv error))))))

(defn stdout
  "Returns the process stdout Promise."
  [process]
  (Process/stdout process))

(defn stderr
  "Returns the process stderr Promise."
  [process]
  (Process/stderr process))

(defn wait
  "Returns the process exit-status Promise."
  [process]
  (Process/wait process))

(defn write
  "Writes string or Bytes input to a process without closing stdin."
  [process value]
  (let [bytes (if (string? value)
                (str/encode-utf8 value)
                value)]
    (if (bytes? bytes)
      (Process/write process bytes)
      (throw
       (ex :dependency
           {:tool.sh/error :invalid-stdin
            :stdin value}
           :ex/message "tool.sh/write requires a string or Bytes")))))

(defn close-input
  "Closes process stdin."
  [process]
  (Process/close-input process))

(defn alive?
  "Returns true while the native process is alive."
  [process]
  (Process/alive? process))

(defn kill
  "Terminates the native process."
  [process]
  (Process/kill process))

(defn result
  [argv values]
  {:command argv
   :exit (nth values 2)
   :stdout (str/decode-utf8 (nth values 0))
   :stderr (str/decode-utf8 (nth values 1))})

(defn start-execution
  [argv value]
  (let [process (spawn argv value)]
    (try
      (if (has? value :stdin)
        (write process (:stdin value)))
      (close-input process)
      {:process process
       :promise (-> (promise/all [(stdout process)
                                  (stderr process)
                                  (wait process)])
                    (promise/then (fn [values] (result argv values))))}
      (catch error
        (do
          (try
            (kill process)
            (catch ignored nil))
          (throw error))))))

(defn execute
  "Runs argv asynchronously and returns a Promise of the complete result.

   Optional stdin is written and closed before stdout, stderr, and exit status
   are joined. Output is decoded as UTF-8 without trimming. :timeout is
   validated here and applied by run at the synchronous completion boundary."
  ([argv]
   (execute argv {}))
  ([argv value]
   (let [argv (command argv)
         value (options value)]
     (try
       (let [started (start-execution argv value)]
         (promise/catch
          (:promise started)
          (fn [error]
            (process-failure :execute argv error))))
       (catch error
         (if (= :process-unavailable (:tool.sh/error (ex-data error)))
           (throw error)
           (process-failure :execute argv error)))))))

(defn run-context
  [argv]
  {:tool.sh/operation :run
   :tool.sh/command argv})

(defn timed-out?
  [outcome]
  (and (Result/error? outcome)
       (= true (get (or (Result/context outcome) {}) :result/timeout))))

(defn completion-result
  [argv outcome]
  (if (Result/success? outcome)
    (let [record (Result/data outcome)]
      (if (= 0 (:exit record))
        outcome
        (Result/create
         :error
         (ex :dependency record :ex/message "Command failed")
         (Result/context outcome))))
    outcome))

(defn run
  "Runs argv synchronously and returns a native Result of the complete result.

   A zero exit is Result/success with the command record. Non-zero exits,
   process failures, and timeout are Result/error outcomes. Timeout requests
   best-effort process termination after synchronization."
  ([argv]
   (run argv {}))
  ([argv value]
   (let [argv (command argv)
         value (options value)
         context (run-context argv)]
     (try
       (let [started (start-execution argv value)
             sync-options (if (nil? (:timeout value))
                            {:context context}
                            {:timeout (:timeout value)
                             :context context})
             outcome (Result/synchronize (:promise started) sync-options)]
         (if (timed-out? outcome)
           (try
             (kill (:process started))
             (catch ignored nil))
           nil)
         (completion-result argv outcome))
       (catch error
         (Result/create :error error context))))))

(defn result-record
  "Returns a process record from a Result or an existing record.

   Process failures retain their command, output, and exit data. Other errors
   are rethrown."
  [value]
  (if (result? value)
    (if (Result/success? value)
      (Result/data value)
      (let [error (Result/error-value value)
            data (select-keys (or (ex-data error) {})
                              [:command :stdout :stderr :exit])]
        (if (and (map? data) (has? data :exit))
          data
          (throw error))))
    value))

(defn run-record
  "Runs argv synchronously and returns the ordinary completion record.

   This compatibility adapter preserves the pre-Result map boundary."
  ([argv]
   (run-record argv {}))
  ([argv value]
   (let [outcome (Result/synchronize (execute argv value))]
     (if (Result/error? outcome)
       (throw (Result/error-value outcome))
       (Result/data outcome)))))

(defn require-success
  "Returns a successful command result or throws a structured exception containing it."
  ([value]
   (require-success "Command failed" value))
  ([message value]
   (if (result? value)
     (if (Result/success? value)
       (require-success message (Result/data value))
       (let [error (Result/error-value value)
             data (dissoc (or (ex-data error) {})
                          :ex/code
                          :ex/message
                          :ex/class
                          :ex/cause)]
         (if (and (map? data) (has? data :exit))
           (throw
            (ex :dependency
                data
                :ex/message message
                :ex/cause error))
           (throw error))))
     (if (= 0 (:exit value))
       value
       (throw (ex :dependency value :ex/message message))))))

(defn run-checked
  "Runs argv and throws a structured exception on non-zero exit."
  ([argv]
   (run-checked argv {}))
  ([argv value]
   (require-success (run argv value))))

;; Foundation shell semantics live here, not in migrated callers.
;; Unlike run, sh selects output without treating a nonzero exit as failure.
(defn shell-options
  "Normalizes Foundation shell options without changing the strict run options.
   Inherited stdio is explicitly unsupported until native Process provides it.
   Environment conversion and trimming are intentionally lossy; sh results
   retain the original options and untrimmed record in their Result context."
  [value]
  (let [value (or value {})
        allowed #{:root :env :wait :output :trim :wrap :async :inherit
                  :print :output-errors :ignore-errors}
        unknown (if (map? value)
                  (vec (sort-by str (filter (fn [key] (not (has? allowed key)))
                                           (keys value))))
                  [])]
    (if (not (map? value))
      (throw (ex :argument {:tool.sh/error :invalid-options}
                 :ex/message "tool.sh/sh options must be a map")))
    (if (not (empty? unknown))
      (throw (ex :argument {:tool.sh/error :unknown-options :unknown unknown}
                 :ex/message "tool.sh/sh received unknown options")))
    (if (:inherit value)
      (throw (ex :host {:tool.sh/error :unsupported-inherit}
                 :ex/message "Native Process does not support inherited stdio")))
    (if (and (not (nil? (:root value))) (not (string? (:root value))))
      (throw (ex :argument {:tool.sh/error :invalid-cwd}
                 :ex/message "tool.sh/sh :root must be a string")))
    (if (and (not (nil? (:env value))) (not (map? (:env value))))
      (throw (ex :argument {:tool.sh/error :invalid-env}
                 :ex/message "tool.sh/sh :env must be a map")))
    (let [wait (if (nil? (:wait value)) true (:wait value))
          output (if (nil? (:output value)) (if wait true false) (:output value))]
      (if (and output (not wait))
        (throw (ex :argument {:tool.sh/error :output-without-wait}
                   :ex/message "tool.sh/sh output requires waiting for completion")))
      (assoc (merge {:trim true :wrap true} value)
             :wait wait :output output))))

(defn shell-output
  "Selects Foundation stdout/stderr semantics from an untrimmed process record.
   Stderr-only output throws unless ignored or explicitly selected. Exit status
   alone is not failure. Result context preserves the record and input options."
  [record value]
  (let [out (:stdout record)
        err (:stderr record)
        selected (cond
                   (:output-errors value) err
                   (and (empty? out) (not (empty? err))
                        (not (:ignore-errors value)))
                   (throw (ex :host record :ex/message err))
                   :else out)
        selected (if (:trim value) (str/trim selected) selected)]
    (if (:wrap value)
      (Result/create :success selected
                     {:tool.sh/operation :sh
                      :tool.sh/options value
                      :tool.sh/record record})
      selected)))

(defn ^{:public true} sh
  "Runs Foundation-style argv with native Process, Promise, and Result.
   Accepts a map with :args, or an executable followed by arguments and an
   optional options map. Strings are never interpreted by a shell.

   Defaults: wait and select trimmed stdout, wrapped in Result. :wrap false
   returns a string; :output false returns the completed Process; :wait false
   returns a live Process. :async true returns a Promise of the same outcome.
   Stdin stays open, as in Foundation; callers own close-input/kill for returned
   processes. No timeout, inherited stdio, or descendant-kill contract is added.
   :print prints argv only, not Foundation's source-location diagnostic header."
  [first-arg & more]
  (let [map-form (map? first-arg)
        _ (if (and map-form (not (empty? more)))
            (throw (ex :argument {:tool.sh/error :invalid-command}
                       :ex/message "tool.sh/sh map form takes one argument")))
        all (cons first-arg more)
        value (if map-form
                (dissoc first-arg :args)
                (if (map? (last all)) (last all) {}))
        argv (command (if map-form
                        (vec (:args first-arg))
                        (vec (if (map? (last all)) (butlast all) all))))
        normalized (shell-options value)
        process-value (cond-> {:cwd (or (:root normalized) (OS/getenv "PWD") (OS/cwd))}
                        (:env normalized)
                        (assoc :env (into {} (map (fn [[key item]] [(str key) (str item)])
                                                 (:env normalized)))))
        _ (if (:print normalized) (println argv))
        process (spawn argv process-value)]
    (try
      (let [pending (if (:output normalized)
                      (promise/then
                       (promise/all [(stdout process) (stderr process) (wait process)])
                       (fn [values]
                         (result argv values)))
                      (if (:wait normalized)
                        (promise/then (wait process) (fn [exit] process))
                        (promise/from process)))]
        (if (:async normalized)
          (if (:output normalized)
            (promise/then pending (fn [record] (shell-output record normalized)))
            pending)
          (let [outcome (Result/synchronize pending)]
            (if (Result/error? outcome)
              (throw (Result/error-value outcome))
              (if (:output normalized)
                (shell-output (Result/data outcome) normalized)
                (Result/data outcome))))))
      (catch error
        (do
          (try (kill process) (catch ignored nil))
          (throw error))))))
