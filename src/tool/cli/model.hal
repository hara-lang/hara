(ns tool.cli.model)

(def ^{:public true} +outcome-exits+
  {:tool.cli.outcome/success 0
   :tool.cli.outcome/failed 1
   :tool.cli.outcome/usage-error 2
   :tool.cli.outcome/read-error 2
   :tool.cli.outcome/resolution-error 2
   :tool.cli.outcome/unavailable 2
   :tool.cli.outcome/internal-error 2
   :tool.cli.outcome/interrupted 130})

(defn ^{:public true} outcome-exit
  [outcome]
  (get +outcome-exits+ outcome 2))

(defn ^{:public true} request
  [route arguments options context]
  {:request/route route
   :request/arguments (vec arguments)
   :request/options options
   :request/runtime (:runtime/id context)
   :request/cwd (:runtime/cwd context)
   :request/project (:runtime/project context)
   :request/capabilities (vec (:runtime/capabilities context))})

(defn ^{:public true} result
  ([outcome]
   (result outcome nil []))
  ([outcome data messages]
   {:result/outcome outcome
    :result/exit (outcome-exit outcome)
    :result/data data
    :result/messages (vec messages)}))

(defn ^{:public true} message
  ([text] (message :stdout text))
  ([stream text]
   {:message/stream stream
    :message/text (str text)}))

(defn ^{:public true} success
  ([data] (success data []))
  ([data messages]
   (result :tool.cli.outcome/success data messages)))

(defn ^{:public true} failure
  ([outcome type text]
   (failure outcome type text nil))
  ([outcome type text data]
   (result outcome
           (merge {:error/type type :error/message text} (or data {}))
           [(message :stderr text)])))

(defn ^{:public true} success?
  [value]
  (= :tool.cli.outcome/success (:result/outcome value)))
