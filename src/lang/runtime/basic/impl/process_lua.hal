(ns lang.runtime.basic.impl.process-lua
  (:config {:role :internal})
  (:require [lang.core.runtime :as runtime]
            [lang.runtime.basic.type-basic :as basic]
            [lang.runtime.basic.type-common :as common]
            [lang.runtime.basic.type-oneshot :as oneshot]
            [lang.runtime.basic.type-verify :as verify]
            [lang.runtime.basic.impl.source-lua :as source]))

(def +lua-init+
  (common/put-program-options
   :lua
   {:default {:oneshot :lua
              :verify :lua
              :basic :lua}
    :env {:lua {:exec "lua"
                :extension "lua"
                :flags {:oneshot ["-e" "loadstring=loadstring or load;unpack=unpack or table.unpack" "-e"]
                        :verify ["-e" "local loader=loadstring or load; assert(loader(io.read('*a'), '@<hara>'))"]
                        :basic ["-e"]}}
          :luajit {:exec "luajit"
                   :extension "lua"
                   :flags {:oneshot ["-e"]
                           :verify ["-e" "local loader=loadstring or load; assert(loader(io.read('*a'), '@<hara>'))"]
                   :basic ["-e"]}}}}))

(defn lua-basic-script-globalize-entry
  "Converts Lua basic-runtime declarations to globals for later eval chunks."
  [body opts]
  (let [op-key (get-in opts [:entry :op-key])]
    (cond
      ;; XTalk declarations retain their target-qualified entry key (for
      ;; example :defn.xt), so declaration text is the stable lifecycle
      ;; boundary here rather than the host macro key.
      (str/starts-with? body "local function ")
      (str "function "
           (str/slice body 15 (str/length body)))

      (= op-key :def)
      (if (str/starts-with? body "local ")
        (str/slice body 6 (str/length body))
        body)

      :else body)))

(def +lua-basic-script-emit+
  {:code {:transforms {:entry [lua-basic-script-globalize-entry]}}})

(def +lua-oneshot-config+
  (common/set-context-options
   [:lua :oneshot :default]
   {:main {} :emit {} :json :full}))

(def +lua-verify-config+
  (common/set-context-options
   [:lua :verify :default]
   {:main {}
    :emit {}
    :json false
    :transport :process-stdin}))

(def +lua-basic-config+
  (common/set-context-options
   [:lua :basic :default]
   {:main {} :emit +lua-basic-script-emit+ :json :full :encode :json :timeout 2000
    :transport :process-socket
    :bootstrap source/transport-source
    :profile {:input []
              :source []
              :response [[:lang/node-response 1]]}}))

(def +lua-oneshot+
  (runtime/install-type
   :lua :oneshot
   {:type :lang/rt.oneshot
    :instance {:create oneshot/rt-oneshot:create
               :raw-eval oneshot/raw-eval-oneshot}}))

(def +lua-verify+
  (runtime/install-type
   :lua :verify
   {:type :lang/rt.verify
    :instance {:create oneshot/rt-oneshot:create
               :raw-eval verify/raw-eval-verify}}))

(def +lua-basic+
  (runtime/install-type
   :lua :basic
   {:type :lang/rt.basic
    :config {:layout :full}
    :instance {:create basic/rt-basic:create
               :start basic/start-basic
               :stop basic/stop-basic
               :raw-eval basic/raw-eval-basic}}))

(def +init+
  {:lang :lua :program +lua-init+
   :oneshot +lua-oneshot+
   :verify +lua-verify+
   :basic +lua-basic+})
