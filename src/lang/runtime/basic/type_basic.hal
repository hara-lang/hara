(ns lang.runtime.basic.type-basic
  (:config {:role :internal})
  (:require [lang.core.eval :as evaluation]
            [lang.runtime.basic.transport-node :as node]
            [lang.runtime.basic.type-oneshot :as oneshot]))

(defstruct RuntimeBasic
  [id lang runtime program exec process state transport profile timeout])

(defn default-id
  [language]
  (keyword (str (name language) ".basic")))

(defn rt-basic:create
  "Creates a basic runtime with a runtime-owned evaluation profile."
  [options]
  (let [id (get options :id)
        lang (get options :lang)
        runtime (or (get options :runtime) :basic)
        exec (get options :exec)
        program (get options :program)
        process (get options :process)
        timeout (or (get options :timeout)
                    (get process :timeout)
                    2000)
        [program process exec]
        (oneshot/rt-oneshot-setup lang program process exec runtime)
        persistent? (= :process-socket (get process :transport))
        eval-transport (if persistent?
                         (node/create lang exec process timeout)
                         nil)
        profile (if persistent?
                  (or (get process :profile)
                      {:input []
                       :source []
                       :response [[:lang/node-response 1]]})
                  {:input [] :source [] :response []})
        process (merge process
                       {:transport (if persistent? :process-socket :oneshot)
                        :persistent persistent?})]
    (lang.runtime.basic.type-basic/RuntimeBasic
     (or id (default-id lang))
     lang
     runtime
     program
     exec
     process
     (atom {:status :created
            :transport (get process :transport)})
     eval-transport
     profile
     timeout)))

(defn start-basic
  [runtime]
  (try
    (do
      (if (get runtime :transport)
        (node/start (get runtime :transport)))
      (reset! (get runtime :state)
              {:status :started
               :transport (get-in runtime [:process :transport])})
      runtime)
    (catch error
      (do
        (if (get runtime :transport)
          (node/stop (get runtime :transport)))
        (reset! (get runtime :state)
                {:status :failed
                 :transport (get-in runtime [:process :transport])
                 :error (ex-data error)})
        (throw error)))))

(defn rt-basic-port
  "Returns the bound port for a persistent basic runtime."
  [runtime]
  (or (if (get runtime :transport)
        (node/port (get runtime :transport))
        nil)
      (get-in runtime [:process :port])))

(defn stop-basic
  [runtime]
  (if (get runtime :transport)
    (node/stop (get runtime :transport)))
  (reset! (get runtime :state)
          {:status :stopped
           :transport (get-in runtime [:process :transport])})
  runtime)

(defn basic-state
  [runtime]
  (deref (get runtime :state)))

(defn eval-basic
  "Promise-first semantic evaluation."
  ([runtime source]
   (eval-basic runtime source {}))
  ([runtime source options]
   (if (= :started (get (basic-state runtime) :status))
     (if (get runtime :transport)
       (evaluation/eval-context runtime source options)
       (promise/run
        (fn []
          (oneshot/raw-eval-oneshot runtime source))))
     (throw
      (ex :host {:id (get runtime :id)
                :lang (get runtime :lang)
                :state (basic-state runtime)} :ex/message "Basic runtime is not started")))))

(defn eval-raw-basic
  "Promise-first raw exchange evaluation, bypassing semantic plugins."
  ([runtime source]
   (eval-raw-basic runtime source {}))
  ([runtime source options]
   (if (= :started (get (basic-state runtime) :status))
     (if (get runtime :transport)
       (evaluation/eval-raw-context runtime source options)
       (promise/run
        (fn []
          (oneshot/raw-eval-oneshot runtime source))))
     (throw
      (ex :host {:id (get runtime :id)
                :lang (get runtime :lang)
                :state (basic-state runtime)} :ex/message "Basic runtime is not started")))))

(defn raw-eval-basic
  "Blocking compatibility adapter. Target errors are thrown."
  [runtime source]
  (evaluation/await (eval-basic runtime source {})
                    (get runtime :timeout)))

(defn rt-basic
  "Creates and starts a basic runtime, matching Foundation's public function."
  [options]
  (start-basic (rt-basic:create options)))

(extend-type RuntimeBasic IContextEval
  (evaluate [runtime request options]
    (eval-basic runtime request options))
  (evaluate-raw [runtime request options]
    (eval-raw-basic runtime request options)))

(extend-type RuntimeBasic IContext
  (call [runtime & arguments]
    (raw-eval-basic runtime (first arguments))))

(extend-type RuntimeBasic IComponent
  (props [runtime]
    {:state {:get (fn [] (basic-state runtime))}
     :transport {:get (fn [] (get runtime :transport))}})
  (status [runtime]
    (get (basic-state runtime) :status))
  (started? [runtime]
    (= :started (get (basic-state runtime) :status)))
  (stopped? [runtime]
    (= :stopped (get (basic-state runtime) :status)))
  (start [runtime]
    (start-basic runtime))
  (stop [runtime]
    (stop-basic runtime))
  (kill [runtime]
    (stop-basic runtime))
  (remote? [runtime]
    false))
