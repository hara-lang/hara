(ns lang.runtime.basic.transport-node
  (:config {:role :internal})
  (:require [tool.sh :as sh]
            [lang.core.eval :as evaluation]
            [lang.protocol.runtime :as protocol]
            [lang.runtime.basic.server-node :as server]
            [std.stream.frame :as frame]
            [std.stream.duplex :as duplex]
            [std.stream.relay :as relay]))

(defstruct ProcessTransport [lang exec process-options timeout state])

(defn wire-get
  [value key]
  (or (get value key)
      (get value (name key))))

(defn transport-source
  "Builds process source through the language-owned basic bootstrap factory."
  [node port]
  (let [bootstrap (get (get node :process-options) :bootstrap)]
    (if (fn? bootstrap)
      (bootstrap port)
      (throw
       (ex :host {:error/type :lang/runtime-bootstrap
                  :lang (get node :lang)
                  :process-options (select-keys (get node :process-options)
                                                [:transport :persistent])}
           :ex/message "Basic runtime has no language bootstrap factory")))))

(defn create
  ([exec process-options timeout] (create :js exec process-options timeout))
  ([lang exec process-options timeout]
   (lang.runtime.basic.transport-node/ProcessTransport
    lang exec process-options timeout (atom {:status :created
                                              :relay nil}))))

(defn state
  [node]
  (deref (get node :state)))

(defn process-options
  [node]
  (select-keys (or (get node :process-options) {}) [:cwd :env]))

(defn started?
  [node]
  (= :started (get (state node) :status)))

(defn port
  "Returns the bound host port while a persistent transport is running."
  [node]
  (get (state node) :port))

(defn fail-start
  [node error]
  (let [current (state node)
        child (get current :process)
        request-connection (get current :request-connection)
        server (get current :server)]
    (if request-connection
      (try (Socket/close request-connection)
           (catch ignored nil)))
    (if child
      (try (Process/kill child)
           (catch ignored nil)))
    (if server
      (try (server/stop-server server)
           (catch ignored nil)))
    (let [stderr
          (if child
            (try
              (str/decode-utf8
               (evaluation/await (Process/stderr child) 1000))
              (catch ignored nil))
            nil)
          data {:error/type :lang/runtime-start
                :lang (get node :lang)
                :argv (get node :exec)
                :timeout (get node :timeout)
                :stderr stderr
                :cause-data (ex-data error)}]
      (reset! (get node :state)
              {:status :failed
               :error data})
      (throw
       (if (ex? error)
         (ex :host data :ex/message (str "Failed to start "
                       (name (get node :lang))
                       " basic runtime: "
                       (or (ex-message error) (str error)))
             :ex/cause error)
         (ex :host data :ex/message (str "Failed to start "
                       (name (get node :lang))
                       " basic runtime: "
                       (or (ex-message error) (str error)))))))))

(defn start
  [node]
  (if (started? node)
    node
    (try
      (letfn [(line-index [values]
                (loop [index 0]
                  (if (= index (count values))
                    nil
                    (if (= 10 (nth values index))
                      index
                      (recur (inc index))))))
              (process-port [process]
                (let [stream (Process/stdout-stream process)]
                  (letfn [(read-port [buffer]
                            (let [chunk (evaluation/await
                                         (IStream/next stream)
                                         (get node :timeout))]
                              (if (nil? chunk)
                                (throw
                                 (ex :io {:error/type :lang/runtime-port}
                                     :ex/message "Hara child exited before publishing its socket port"))
                                (let [values (frame/append-bytes buffer chunk)
                                      index (line-index values)]
                                  (if (nil? index)
                                    (read-port values)
                                    (let [line (str/trim
                                                (str/decode-utf8
                                                 (apply Bytes/new (take index values))))
                                          remaining (vec (drop (inc index) values))
                                          value (try
                                                  (read-string line)
                                                  (catch ignored nil))]
                                      (if (and (long? value)
                                               (> value 0)
                                               (< value 65536))
                                        value
                                        (read-port remaining))))))))]
                    (read-port []))))
              (connect-hara-request [port]
                (let [pending
                      (promise/new
                       (fn [resolve reject]
                         (Socket/connect
                          "127.0.0.1"
                          port
                          {}
                          (fn [error connection]
                            (if error
                              (reject
                               (ex :io {:error/type :lang/runtime-request-connect
                                        :port port
                                        :error error}
                                   :ex/message "Hara child request socket failed"))
                              (resolve connection))))))]
                  (evaluation/await pending (get node :timeout))))
              (hara-duplex [connection request-connection]
                (duplex/create
                 (Socket/receive-stream connection)
                 (fn [value]
                   (promise/from (Socket/send request-connection value)))
                 (fn []
                   (Socket/close connection)
                   (Socket/close request-connection))
                 (fn [_]
                   (Socket/close connection)
                   (Socket/close request-connection))))]
        (let [server (server/create-basic-server
                      "127.0.0.1"
                      0
                      (get node :timeout))]
          (reset! (get node :state)
                  {:status :starting
                   :server server
                   :port (server/get-port server)})
          (let [source (transport-source node (server/get-port server))
                argv (conj (get node :exec) source)
                child (sh/spawn argv (process-options node))]
            (swap! (get node :state) assoc :process child)
            (if (= :hara (get node :lang))
              (let [request-port (process-port child)
                    request-connection (connect-hara-request request-port)
                    _ (server/wait-ready server)
                    connection (server/get-connection server)
                    bridge (hara-duplex connection request-connection)
                    channel (server/attach-relay server bridge)]
                (swap! (get node :state)
                       assoc
                       :status :started
                       :connection connection
                       :request-connection request-connection
                       :relay channel)
                node)
              (let [_ (server/wait-ready server)
                    connection (server/get-connection server)
                    _ (server/mark-started server)]
                (swap! (get node :state)
                       assoc
                       :status :started
                       :connection connection
                       :relay nil)
                node)))))
      (catch error
        (fail-start node error)))))

(defn stop
  [node]
  (let [current (state node)
        request-connection (get current :request-connection)
        server (get current :server)
        child (get current :process)]
    (if request-connection
      (try (Socket/close request-connection)
           (catch ignored nil)))
    (if server
      (try (server/stop-server server)
           (catch ignored nil)))
    (if child
      (try (Process/kill child)
           (catch ignored nil)))
    (swap! (get node :state)
           (fn [value]
             (assoc (dissoc value
                            :server
                            :process
                            :connection
                            :request-connection
                            :relay)
                    :status :stopped)))
    node))

(defn exchange
  [node source options]
  (if-not (started? node)
    (throw
     (ex :host {:error/type :lang/transport
               :lang (get node :lang)
               :state (state node)} :ex/message "Process transport is not started"))
    (let [timeout (or (get options :timeout) (get node :timeout))
          request {"source" source
                   "timeout" timeout}
          response (server/request-response
                    (get (state node) :server)
                    request)]
      (lang.core.eval/EvalExchange
       (get node :lang) request response {:persistent true
                                          :process (get (state node) :process)}))))

(extend-type ProcessTransport protocol/IEvalTransport
  (exchange [node request options]
    (promise/run
     (fn []
       (lang.runtime.basic.transport-node/exchange node request options)))))

(defn wire-value
  [value]
  (cond
    (nil? value)
    nil

    (vector? value)
    (vec (map wire-value value))

    (map? value)
    (if (= "float" (get value "$tahto"))
      (read-string (get value "value"))
      (reduce (fn [out entry]
                (assoc out
                       (first entry)
                       (wire-value (second entry))))
              {}
              value))

    :else value))

(defn response-plugin
  [frame]
  (let [wire (get frame :response)]
    (if (wire-get wire :ok)
      (let [response (wire-get wire :response)]
        (if (= "error" (wire-get response :type))
          (let [error (wire-value (wire-get response :value))]
            (throw
             (ex :io {:error/type :lang/target
                       :target (get-in frame [:context :lang])
                       :target-error error}
                 :ex/message (or (wire-get error :message)
                                 "Target evaluation failed"))))
          (assoc frame
                 :result
                 (wire-value (wire-get response :value)))))
      (let [error (wire-get wire :error)]
        (throw
         (ex :io {:error/type :lang/target
                   :target (get-in frame [:context :lang])
                   :target-error error} :ex/message (or (wire-get error :message)
                      "Target evaluation failed")))))))

(def +response-plugin+
  (evaluation/register-plugin
   :lang/node-response 1 :response response-plugin))
