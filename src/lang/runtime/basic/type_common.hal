(ns lang.runtime.basic.type-common
  (:config {:role :internal})
  (:require [lang.core.registry :as registry]))

(defonce ^:dynamic *context-options* (atom {}))

(defn get-context-options
  "gets all or a section of the `*context-options*` structure"
  {:added "4.0"}
  ([]
   @*context-options*)
  ([lang]
   (get @*context-options* lang))
  ([lang context]
   (get-in @*context-options* [lang context]))
  ([lang context program]
   (get-in @*context-options* [lang context program])))

(defn clear-context-options
  "clear entries from the `*context-options*` structure"
  {:added "4.0"}
  ([] (swap-return! *context-options* (fn [m] [m {}])))
  ([lang]
    (swap-return!
      *context-options*
      (fn [m] [(get m lang) (dissoc m lang)])))
  ([lang context]
    (swap-return!
      *context-options*
      (fn [m] [(get-in m [lang context])
               (update-in m [lang] dissoc context)])))
  ([lang context program]
    (swap-return!
      *context-options*
      (fn [m] [(get-in m [lang context program])
               (update-in m [lang context] dissoc program)]))))

(defn put-context-options
  "puts entries into context options"
  {:added "4.0"}
  [[lang context] m]
  (swap-return!
    *context-options*
    (fn [previous]
      (let [old (get-in previous [lang context])
            new (letfn
                  [(merge-options
                     [left right]
                     (cond
                       (and (nil? left) (nil? right)) nil
                       (and
                         (or (nil? left) (map? left))
                         (or (nil? right) (map? right))) (merge-with
                                                           merge-options
                                                           left
                                                           right)
                       :else right))]
                  (merge-options old m))]
        [[old new] (assoc-in previous [lang context] new)]))))

(defn set-context-options
  "sets a entry into context options"
  {:added "4.0"}
  [[lang context program] opts]
  (swap-return!
    *context-options*
    (fn [previous] [(list
                      [[lang context program]
                       (get-in previous [lang context program])
                       opts])
                    (assoc-in previous [lang context program] opts)])))

(defonce ^:dynamic *program-options* (atom {}))

(def +valid-contexts+
  #{:oneshot
    :twostep
    :verify
    :interactive
    :basic
    :websocket
    :remote-port
    :remote-ws})

(defn available-runtimes
  "lists installed runtimes for a language"
  {:added "4.0"}
  [lang]
  (->> @registry/+registry+
       keys
       (keep (fn [[k-lang runtime]]
               (when (= k-lang lang)
                 runtime)))
       sort
       vec))

(defn valid-context!
  "checks that the runtime context is valid"
  {:added "4.0"}
  [context]
  (if (not (has? +valid-contexts+ context))
    (throw
      (ex :argument {} :ex/message (str "Invalid context: " context)))))

(defn require-runtime!
  "loads the runtime implementation if it has been registered"
  {:added "4.0"}
  [lang context]
  (valid-context! context)
  (if-let [ns (get (std.foundation/deref registry/+registry+) [lang context])]
    (do (eval (list (quote require) (list (quote quote) ns))) ns)
    (throw (ex :runtime/configuration
             {:available (available-runtimes lang) :lang lang :runtime context}
             :ex/message
             "Runtime not installed"))))

(defn program-exists? "checks if an executable exists\n\n   (program-exists? \"gcc\")\n   => true" {:added "4.0"} [exec] (try (let [process (Process/spawn ["which" exec])] (try (Result/synchronize (Process/wait process)) (let [output (Result/synchronize (Process/stdout process))] (if (Result/success? output) (not= "" (str/trim (String/decode-utf8 (Result/data output)))) false)) (finally (Process/kill process)))) (catch error false)))

(defn get-program-options
  "gets all program options"
  {:added "4.0"}
  ([]
   @*program-options*)
  ([lang]
   (get @*program-options* lang)))

(defn put-program-options
  "puts configuration into program options"
  {:added "4.0"}
  [lang m]
  (let [[old new] (swap-return!
                    *program-options*
                    (fn [previous]
                      (let [old (get-in previous [lang])
                            new (letfn
                                  [(merge-options
                                     [left right]
                                     (cond
                                       (and (nil? left) (nil? right))
                                       nil
                                       (and
                                         (or (nil? left) (map? left))
                                         (or
                                           (nil? right)
                                           (map? right)))
                                       (merge-with
                                         merge-options
                                         left
                                         right)
                                       :else right))]
                                  (merge-options old m))]
                        [[old new] (assoc-in previous [lang] new)])))]
    (letfn
      [(changes
         [new old]
         (reduce-kv
           (fn [out key value]
             (cond
               (not (has? (or old {}) key)) (assoc out key value)
               (and (map? value) (map? (get old key))) (let
                                                         [nested
                                                          (changes
                                                            value
                                                            (get
                                                              old
                                                              key))]
                                                         (if
                                                           (empty?
                                                             nested)
                                                           out
                                                           (assoc
                                                             out
                                                             key
                                                             nested)))
               (= value (get old key)) out
               :else (assoc out key value)))
           {}
           new))]
      (let [changed (changes new old)]
        (if (empty? changed) [:no-change] [:changed changed])))))

(defn swap-program-options
  "swaps out the program options using a funciotn"
  {:added "4.0"}
  [lang f & args]
  (apply
    swap!
    *program-options*
    update-in
    [lang]
    (if (= (type f) :std.native.Var) (deref f) f)
    args))

(defn get-program-default
  "gets the default program"
  {:added "4.0"}
  [lang context program]
  (let [_ (require-runtime! lang context)
        all (get-program-options lang)]
    (or
      program
      (get-in all [:default context])
      (throw
        (ex
          :runtime/configuration
          {:lang lang,
           :runtime context,
           :available (-> all :env keys sort vec)}
          :ex/message
          "No program found for runtime")))))

(defn get-program-flags
  "gets program flags"
  {:added "4.0"}
  [lang program]
  (get-in (get-program-options lang) [:env program :flags]))

(defn get-program-exec
  "gets running parameters for program"
  {:added "4.0"}
  [lang context program]
  (let [_ (require-runtime! lang context)
        all (get-program-options lang)
        env (get-in all [:env program])
        {:keys [exec flags]} env
        args (get flags context)]
    (if args
      (vec (cons exec args))
      (throw
        (ex
          :runtime/configuration
          {:lang lang,
           :runtime context,
           :program program,
           :available
           (->>
             (reduce-kv
               (fn [out key env]
                 (if (get-in env [:flags context]) (conj out key) out))
               []
               (:env all))
             sort
             vec)}
          :ex/message
          "Program does not support runtime")))))

(defn get-options
  "gets merged options for context"
  {:added "4.0"}
  [lang context program]
  (let [_     (require-runtime! lang context)
        copts (get-in (std.foundation/deref *context-options*) [lang context])]
    (when (not copts)
      (throw (ex :runtime/configuration
               {:available (available-runtimes lang) :lang lang :runtime context}
               :ex/message
               "Runtime configuration not installed")))
    (letfn [(merge-options
             [left right]
             (cond
              (and (nil? left) (nil? right))
              nil
              (and (or (nil? left) (map? left)) (or (nil? right) (map? right)))
              (merge-with merge-options left right)
              :else
              right))]
      (reduce merge-options
        nil
        [(:default copts)
         (get-in (get-program-options lang) [:env program])
         (get copts program)]))))
