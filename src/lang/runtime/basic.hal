(ns lang.runtime.basic
  (:config {:role :facade})
  (:require [lang.runtime.basic.type-basic :as basic]
            [lang.runtime.basic.type-hara :as hara-basic]
            [lang.runtime.basic.type-oneshot :as oneshot]
            [lang.runtime.basic.type-verify :as verify]))

(intern-in
 [rt-basic basic/rt-basic]
 [rt-basic:create basic/rt-basic:create]
 [rt-basic-port basic/rt-basic-port]
 [start-basic basic/start-basic]
 [stop-basic basic/stop-basic]
 [raw-eval-basic basic/raw-eval-basic]
 [basic-state basic/basic-state]
 [rt-oneshot oneshot/rt-oneshot]
 [rt-oneshot:create oneshot/rt-oneshot:create]
 [raw-eval-oneshot oneshot/raw-eval-oneshot]
 [verify-execute verify/verify-execute]
 [verify-result verify/verify-result]
 [verify-source verify/verify-source]
 [raw-eval-verify verify/raw-eval-verify]
 [rt-hara-basic hara-basic/rt-hara-basic]
 [rt-hara-basic:create hara-basic/rt-hara-basic:create]
 [start-hara-basic hara-basic/start-hara-basic]
 [stop-hara-basic hara-basic/stop-hara-basic]
 [raw-eval-hara-basic hara-basic/raw-eval-hara-basic]
 [hara-basic-state hara-basic/hara-basic-state])
