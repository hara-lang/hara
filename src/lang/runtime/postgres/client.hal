(ns lang.runtime.postgres.client
  (:require [db.protocol :as protocol]
            [db.postgres.connection :as connection]
            [lang.core.compile :as compile]
            [lang.core.library :as library]
            [lang.core.registry :as registry]
            [lang.core.script :as script]
            [std.lib.context.registry :as context]))

(defstruct PostgresClient
  [id language runtime options connection state modules pointers notifications])

(def +required-capabilities+ ["sql"])
(def +notification-capability+ "notifications")

(defn await
  "Returns a settled promise value or an already synchronous adapter value."
  [value]
  (if (promise? value) (deref value) value))

(defn adapter
  "Selects a runtime-local provider operation, falling back to the host bridge."
  [client key fallback]
  (or (get-in (:options client) [:adapter key]) fallback))

(defn connection-options
  "Removes runtime-local settings before opening a PostgreSQL connection."
  [client]
  (dissoc (:options client) :id :runtime :adapter :timeout))

(defn provider-capabilities
  "Reads the selected provider's advertised capabilities without retaining its handle."
  [value]
  (or (:capabilities (protocol/db-info value)) []))

(defn missing-capabilities
  "Returns required capabilities that are absent from a selected provider."
  [value required]
  (vec
   (filter (fn [capability]
             (nil? (some (fn [candidate] (= candidate capability))
                         (provider-capabilities value))))
           required)))

(defn require-capabilities
  "Returns a compatible provider value or raises a stable capability error."
  [client value required]
  (let [missing (missing-capabilities value required)]
    (if (empty? missing)
      value
      (throw
       (ex :database/unsupported-capability
           {:id (:id client)
            :provider (protocol/db-provider value)
            :required (vec required)
            :available (provider-capabilities value)
            :missing missing}
           :ex/message "PostgreSQL provider does not support the requested capability")))))

(defn rt-create
  "Creates an unstarted PostgreSQL client runtime."
  [options]
  (let [options (or options {})]
    (lang.runtime.postgres.client/PostgresClient
     (or (:id options) :postgres.client)
     :postgres
     (or (:runtime options) :client)
     options
     (atom nil)
     (atom {:status :created})
     (atom #{})
     (atom #{})
     (atom {}))))

(defn start-runtime
  "Opens the configured provider connection once and marks the runtime started."
  [client]
  (if (deref (:connection client))
    (do
      (reset! (:state client) {:status :started})
      client)
    (try
      (let [open (adapter client :open connection/open)
            value (require-capabilities
                   client
                   (await (open (connection-options client)))
                   +required-capabilities+)]
        (reset! (:connection client) value)
        (reset! (:state client) {:status :started})
        client)
      (catch error
        (do
          (reset! (:connection client) nil)
          (reset! (:state client) {:status :created})
          (throw error))))))

(defn stop-runtime
  "Closes every notification and the connection, restoring a stopped baseline."
  [client]
  (try
    (let [unlisten (adapter client :unlisten connection/unlisten)]
      (reduce (fn [_ subscription]
                (await (unlisten subscription)))
              nil
              (vals (deref (:notifications client)))))
    (finally
      (reset! (:notifications client) {})
      (let [value (deref (:connection client))]
        (if value
          (await ((adapter client :close connection/close) value))))
      (reset! (:connection client) nil)
      (reset! (:state client) {:status :stopped})))
  client)

(defn add-notify
  "Registers one provider notification subscription by stable caller id."
  [client id config]
  (let [current (get (deref (:notifications client)) id)]
    (if current
      current
      (let [value (deref (:connection client))]
        (if (nil? value)
          (throw (ex :database {:id (:id client)}
                     :ex/message "PostgreSQL runtime is not started"))
          (let [value (require-capabilities client value [+notification-capability+])
                listen (adapter client :listen connection/listen)
                subscription (await (listen value config))]
            (swap! (:notifications client) assoc id subscription)
            subscription))))))

(defn remove-notify
  "Closes and removes a notification subscription; removal is idempotent."
  [client id]
  (let [subscription (get (deref (:notifications client)) id)]
    (if subscription
      (do
        (try
          (await ((adapter client :unlisten connection/unlisten) subscription))
          (finally
            (swap! (:notifications client) dissoc id)))
        subscription)
      nil)))

(defn execute-only?
  "Recognizes SQL statements whose stable result is command execution."
  [source]
  (let [statement (str/upper (str/trim source))]
    (boolean
     (first
      (filter (fn [prefix] (str/starts-with? statement prefix))
              ["DO " "BEGIN " "DECLARE " "INSERT " "UPDATE " "DELETE "
               "CREATE " "DROP " "ALTER " "GRANT " "REVOKE " "TRUNCATE "
               "COMMENT " "VACUUM "])))))

(defn normalize-query
  "Maps a one-column result set to scalars while retaining composite rows."
  [response]
  (let [columns (:columns response)
        rows (:rows response)
        values (if (= 1 (count columns)) (map first rows) rows)]
    (if (= 1 (count values)) (first values) (vec values))))

(defn raw-eval
  "Executes SQL through the active connection and returns the normalized result."
  [client source]
  (let [value (deref (:connection client))]
    (if (nil? value)
      (throw (ex :database {:id (:id client)}
                 :ex/message "PostgreSQL runtime is not started"))
      (if (execute-only? source)
        (await ((adapter client :exec connection/exec) value source []))
        (normalize-query
         (await ((adapter client :query connection/query) value source [])))))))

(defn evaluate-async
  "Runs raw SQL evaluation through the portable promise boundary."
  [client source options]
  (promise/run (fn [] (raw-eval client source))))

(defn postgres-book
  "Returns the registered standalone PostgreSQL book and its lifecycle metadata."
  []
  (registry/registry-book :postgres :default nil))

(defn lifecycle-hook
  "Returns one BookMeta lifecycle function when PostgreSQL declares it."
  [hook]
  (get (:meta (postgres-book)) hook))

(defn lifecycle-module
  "Resolves a module id to its registered portable source module when available."
  [module]
  (if (map? module)
    module
    (let [loaded (if (symbol? module)
                   (try (script/load-module :postgres module) (catch error module))
                   module)]
      (or (get (library/library-book-modules (library/runtime-library) :postgres)
               loaded)
          {:id module :lang :postgres :code {} :fragment {}}))))

(defn lifecycle-module-id
  "Returns the stable lifecycle identity for a source module or caller id."
  [module]
  (if (map? module) (or (:id module) module) module))

(defn lifecycle-form
  "Builds one BookMeta form against a module or pointer lifecycle target."
  [hook target]
  (let [function (lifecycle-hook hook)]
    (if function (function target) nil)))

(defn lifecycle-forms
  "Normalizes one lifecycle form into executable units while preserving do composition."
  [form]
  (cond (nil? form) []
        (and (list? form) (= 'do (first form))) (vec (rest form))
        :else [form]))

(defn compile-lifecycle-form
  "Compiles a BookMeta form through the configured PostgreSQL grammar boundary."
  [client module form]
  (let [compile-form (get-in (:options client) [:adapter :compile-lifecycle])]
    (if compile-form
      (await (compile-form client module form))
      (script/compile-form :postgres (:id module) form))))

(defn lifecycle-eval
  "Executes compiled lifecycle output, allowing an isolated adapter in tests."
  [client source]
  (let [evaluate (get-in (:options client) [:adapter :lifecycle-eval])]
    (if evaluate
      (await (evaluate client source))
      (raw-eval client source))))

(defn run-lifecycle-form
  "Compiles then executes one lifecycle form, retaining the provider result."
  [client module form]
  (if (nil? form)
    nil
    (lifecycle-eval client (compile-lifecycle-form client module form))))

(defn run-lifecycle-forms
  "Executes a composed BookMeta lifecycle form in its declared order."
  [client module form]
  (vec
   (map (fn [item]
          (run-lifecycle-form client module item))
        (lifecycle-forms form))))

(defn remote-present?
  "Normalizes provider existence responses without retaining local lifecycle state."
  [value]
  (cond (nil? value) false
        (boolean? value) value
        (vector? value) (if (= 1 (count value))
                          (remote-present? (first value))
                          (every? remote-present? value))
        (map? value) (if (has? value :exists)
                       (remote-present? (:exists value))
                       false)
        (number? value) (not (= 0 value))
        :else true))

(defn module-source?
  "Returns true only for a module registered by the script source pipeline."
  [module]
  (and (symbol? (:id module))
       (has? (library/library-book-modules (library/runtime-library) :postgres)
             (:id module))))

(defn compile-module-output
  "Compiles one registered PostgreSQL module or delegates to an isolated adapter."
  [client module]
  (let [compile-module (get-in (:options client) [:adapter :compile-module])]
    (if compile-module
      (await (compile-module client module))
      (let [result (compile/compile-module
                    {:lang :postgres
                     :main (:id module)
                     :layout :module
                     :lang/eval-literal
                     (fn [form]
                       (first (eval-in-ns (:id module) [form])))})]
        (if (empty? (:diagnostics result))
          (:output result)
          (throw (ex :runtime/compile-failed
                     {:id (:id client)
                      :module (:id module)
                      :diagnostics (:diagnostics result)}
                     :ex/message "PostgreSQL module compilation failed")))))))

(defn run-module-code
  "Compiles and executes registered module code once its lifecycle setup has run."
  [client module]
  (if (module-source? module)
    (let [output (compile-module-output client module)]
      (if (empty? (str/trim output)) nil (lifecycle-eval client output)))
    nil))

(defn pointer-entry
  "Resolves a pointer's embedded or registered PostgreSQL code entry."
  [pointer]
  (or (get pointer :entry)
      (let [module (or (get pointer :module) (get pointer :namespace))
            id (get pointer :id)]
        (if (and module id)
          (get-in (library/library-book-modules (library/runtime-library) :postgres)
                  [module :code (script/symbol-id id)])))))

(defn lifecycle-pointer
  "Supplies BookMeta with source entry metadata when a pointer can be resolved."
  [pointer]
  (or (pointer-entry pointer) pointer))

(defn pointer-unsupported
  "Creates the stable error used by PostgreSQL's intentionally unsupported pointer boundary."
  [client operation pointer]
  (ex :runtime/unsupported {:id (:id client)
                            :status :unsupported
                            :operation operation
                            :pointer pointer}
      :ex/message "PostgreSQL client does not support pointer evaluation"))

(extend-type PostgresClient IContextEval
  (evaluate [client request options]
    (evaluate-async client request options))
  (evaluate-raw [client request options]
    (evaluate-async client request options))
  (eval-ptr [client pointer arguments options]
    (promise/run (fn [] (throw (pointer-unsupported client :eval-ptr pointer)))))
  (eval-await-ptr [client pointer arguments options]
    (await (IContextEval/eval-ptr client pointer arguments options)))
  (tags-ptr [client pointer] [])
  (deref-ptr [client pointer]
    (throw (pointer-unsupported client :deref-ptr pointer)))
  (display-ptr [client pointer] (Edn/write pointer))
  (invoke-ptr [client pointer arguments]
    (IContextEval/eval-await-ptr client pointer arguments {}))
  (transform-in-ptr [client pointer arguments] arguments)
  (transform-out-ptr [client pointer value] value))

(extend-type PostgresClient IContext
  (call [client & arguments]
    (raw-eval client (first arguments))))

(extend-type PostgresClient IComponent
  (props [client]
    {:state {:get (fn [] (deref (:state client)))}
     :connection {:get (fn [] (deref (:connection client)))}
     :notifications {:get (fn [] (deref (:notifications client)))}})
  (status [client] (:status (deref (:state client))))
  (started? [client] (= :started (:status (deref (:state client)))))
  (stopped? [client] (= :stopped (:status (deref (:state client)))))
  (start [client] (start-runtime client))
  (stop [client] (stop-runtime client))
  (kill [client] (stop-runtime client))
  (remote? [client] (nil? (get-in (:options client) [:container]))))

(extend-type PostgresClient IContextLifeCycle
  (has-module? [client module]
    (let [source (lifecycle-module module)
          module-id (lifecycle-module-id source)
          form (lifecycle-form :has-module source)]
      (if form
        (remote-present? (run-lifecycle-forms client source form))
        (has? (deref (:modules client)) module-id))))
  (setup-module [client module]
    (let [source (lifecycle-module module)
          module-id (lifecycle-module-id source)]
      (if (not (has? (deref (:modules client)) module-id))
        (do
          (run-lifecycle-forms client source (lifecycle-form :setup-module source))
          (run-module-code client source)
          (swap! (:modules client) conj module-id)))
    client))
  (teardown-module [client module]
    (let [source (lifecycle-module module)
          module-id (lifecycle-module-id source)]
      (try
        (run-lifecycle-forms client source (lifecycle-form :teardown-module source))
        (finally
          (swap! (:modules client) disj module-id))))
    client)
  (has-setup-ptr? [client pointer]
    (let [target (lifecycle-pointer pointer)
          form (lifecycle-form :has-ptr target)]
      (if form
        (remote-present? (run-lifecycle-forms client
                                               (lifecycle-module
                                                (or (:module target) (:namespace target)))
                                               form))
        false)))
  (setup-ptr [client pointer]
    (let [target (lifecycle-pointer pointer)
          module (lifecycle-module (or (:module target) (:namespace target)))
          form (lifecycle-form :setup-ptr target)]
      (if (or (has? (deref (:pointers client)) pointer)
              (IContextLifeCycle/has-setup-ptr? client pointer))
        client
        (if (nil? form)
          (throw (pointer-unsupported client :setup-ptr pointer))
          (do
            (run-lifecycle-forms client module form)
            (swap! (:pointers client) conj pointer)
            client))))
    client)
  (teardown-ptr [client pointer]
    (let [target (lifecycle-pointer pointer)
          module (lifecycle-module (or (:module target) (:namespace target)))
          form (lifecycle-form :teardown-ptr target)]
      (try
        (run-lifecycle-forms client module form)
        (finally
          (swap! (:pointers client) disj pointer))))
    client))

(def +runtime+
  {:language :postgres
   :runtime :client
   :key :client
   :capabilities +required-capabilities+
   :config {}
   :create rt-create})

(defn runtime-entry
  "Returns the sole selectable PostgreSQL client runtime entry."
  []
  +runtime+)

(defn install
  "Registers the capability-gated PostgreSQL client runtime coordinate."
  [context-id]
  (context/registry-rt-add context-id (runtime-entry)))
