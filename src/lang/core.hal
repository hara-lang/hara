(ns lang.core
  (:config {:role :facade})
  (:require [lang.core.compile :as compile]
            [lang.core.eval :as evaluation]
            [lang.core.library :as library]
            [lang.core.manage :as manage]
            [lang.core.runtime :as runtime]
            [lang.core.script :as script]
            [lang.core.script-annex :as annex]))

(intern-in
 [bootstrap runtime/bootstrap]
 [install-lang runtime/install-lang]
 [install-type runtime/install-type]
 [select-lang-version runtime/select-lang-version]
 [rt-create runtime/rt-create]
 [rt-start runtime/rt-start]
 [rt-stop runtime/rt-stop]
 [rt-eval runtime/rt-eval]
 [rt-raw-eval runtime/rt-raw-eval]
 [runtime-spec runtime/runtime-spec]
 [default-library library/default-library]
 [default-library:reset library/default-library:reset]
 [runtime-library library/runtime-library]
 [with:library library/with:library]
 [get-snapshot library/library-snapshot]
 [get-book-raw library/library-get-book-raw]
 [get-book library/library-get-book]
 [get-module library/library-get-module]
 [get-entry library/library-get-entry]
 [delete-module! library/library-delete-module!]
 [delete-entry! library/library-delete-entry!]
 [purge-book! library/library-purge-book!]
 [compile-module compile/compile-module]
 [lib:overview manage/lib-overview]
 [lib:module manage/lib-module]
 [lib:entries manage/lib-entries]
 [lib:purge manage/lib-purge]
 [with:cache-none script/with:cache-none]
 [with:cache-force script/with:cache-force]
 [script script/script]
 [script- script/script-]
 [script+ annex/script+]
 [! annex/!]
 [defn.xt script/defn.xt]
 [defmacro.xt script/defmacro.xt]
 [compile-form script/compile-form]
 [restart script/restart]
 [stop script/stop]
 [rt:restart script/restart]
 [rt:stop script/stop]
 [annex:start annex/annex:start]
 [annex:get annex/annex:get]
 [annex:stop annex/annex:stop]
 [annex:start-all annex/annex:start-all]
 [annex:stop-all annex/annex:stop-all]
 [annex:restart-all annex/annex:restart-all]
 [annex:list annex/annex:list]
 [eval-await evaluation/eval-await])
