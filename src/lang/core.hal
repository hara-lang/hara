(ns lang.core
  (:config {:role :facade})
  (:require [lang.core.compile :as compile]
            [lang.core.eval :as evaluation]
            [lang.core.impl :as impl]
            [lang.core.impl-entry :as entry]
            [lang.core.library :as library]
            [lang.core.manage :as manage]
            [lang.core.script :as script]
            [lang.core.script-control :as control]
            [lang.model.v1.spec-xtalk]
            [lang.model.v1.spec-js]
            [lang.model.v1.spec-lua]
            [lang.model.v1.spec-python]))

(intern-in
 [default-library impl/default-library]
 [default-library:reset impl/default-library:reset]
 [runtime-library impl/runtime-library]
 [with:library impl/with:library]
 [get-snapshot library/get-snapshot]
 [get-book-raw library/get-book-raw]
 [get-book library/get-book]
 [get-module library/get-module]
 [get-entry library/get-entry]
 [delete-module! library/delete-module!]
 [delete-entry! library/delete-entry!]
 [purge-book! library/purge-book!]
 [compile-module compile/compile-module]
 [lib:overview manage/lib-overview]
 [lib:module manage/lib-module]
 [lib:entries manage/lib-entries]
 [lib:purge manage/lib-purge]
 [with:cache-none entry/with:cache-none]
 [with:cache-force entry/with:cache-force]
 [script script/script]
 [script- script/script-]
 [script+ script/script+]
 [! script/!]
 [restart control/script-rt-restart]
 [stop control/script-rt-stop]
 [rt:restart control/script-rt-restart]
 [rt:stop control/script-rt-stop]
 [annex:start script/annex:start]
 [annex:get script/annex:get]
 [annex:stop script/annex:stop]
 [annex:start-all script/annex:start-all]
 [annex:stop-all script/annex:stop-all]
 [annex:restart-all script/annex:restart-all]
 [annex:list script/annex:list]
 [eval-await evaluation/eval-await])
