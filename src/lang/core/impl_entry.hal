(ns lang.core.impl-entry
  (:config {:role :internal})
  (:require [lang.base.book :as book]
            [lang.base.emit-template :as impl-template]
            [lang.base.emit :as emit]
            [lang.base.emit-preprocess :as preprocess]
            [lang.base.preprocess-base :as preprocess-base]
            [lang.base.emit-rewrite :as rewrite]
            [lang.base.grammar-xtalk-system :as xtalk-system]
            [lang.base.provenance :as provenance]
            [lang.base.util :as ut]
            [std.lib.time :as time]
            [std.lib.format.ansi :as ansi]))

;;;;
;;
;; CREATE ENTRY
;;

(def ^:dynamic *extra* {})

(defn create-common
  "create entry common keys from metadata"
  {:added "4.0"}
  [{:keys [lang namespace module line time],
    :or {namespace (ns-current)},
    :as meta}]
  (merge
    {:lang lang,
     :namespace namespace,
     :module (or module namespace),
     :line line,
     :time time}
    (qualified-keys meta [:static :rt :api])))

(defn create-code-raw
  "creates a raw entry compatible with submit"
  {:added "4.0"}
  [[op sym & body :as form-raw] reserved meta]
  (let [{:keys [section
                priority
                format
                format-hook]
         :or {priority 5}}   reserved
        modifiers            (:- (std.foundation/meta sym))
        sym                  (if (some symbol? modifiers)
                               (with-meta sym
                                 (assoc (std.foundation/meta sym)
                                   :-
                                   (mapv (fn [migration-argument-0]
                                           (if (symbol? migration-argument-0)
                                             (if-let [v (resolve migration-argument-0)] (var-sym v) migration-argument-0)
                                             migration-argument-0))
                                     modifiers)))
                               sym)
        form-raw             (if (some symbol? modifiers) (apply list op sym body) form-raw)
        [tmeta
         form]               (if format
                               ((if (= :std.native.Var (Base/type format)) (deref format) format) form-raw)
                               [nil form-raw])
        form-input           (-> form preprocess/to-input preprocess/eval-template-forms)
        entry                (book/book-entry
                              (merge
                               {:op         op
                                :op-key     (:op reserved)
                                :id         (cond (vector? sym) (first (filter symbol? sym)) :else sym)
                                :form-input form-input
                                :section    (or section :code)
                                :priority   priority}
                               tmeta
                               (create-common meta)))]
    (if format-hook
      ((if (= :std.native.Var (Base/type format-hook)) (deref format-hook) format-hook) entry))
    [tmeta entry]))

(defn create-code-base
  "creates the base code entry"
  {:added "4.0"}
  [[op sym & body :as form] meta grammar]
  (let [reserved (get-in grammar [:reserved op])]
    (second (create-code-raw form reserved meta))))

(defn hydrate-form
  "hydrates a raw input form using the reserved hydrate hook"
  {:added "4.1"}
  [form-input reserved grammar & [mopts]]
  (let [{:keys [hydrate]} reserved]
    (if hydrate
      (hydrate form-input grammar mopts)
      [nil form-input])))

(defn create-code-hydrate
  "hydrates the forms"
  {:added "4.0"}
  [entry reserved grammar modules & [mopts]]
  (let [{:keys [hydrate-hook]}     reserved
        {:keys [hmeta
                form
                deps
                deps-fragment
                deps-native
                xtalk-ops
                xtalk-profiles
                polyfill-modules]} (impl-template/create-code-state entry reserved grammar modules mopts)
        entry                      (reduce-kv
                                    assoc
                                    (assoc
                                     entry
                                     :form
                                     form
                                     :deps
                                     deps
                                     :deps-fragment
                                     deps-fragment
                                     :deps-native
                                     deps-native
                                     :xtalk-ops
                                     xtalk-ops
                                     :xtalk-profiles
                                     xtalk-profiles
                                     :polyfill-modules
                                     polyfill-modules)
                                    (merge hmeta *extra*))
        entry                      (cond-> entry
                                     (not (:static/code.cache entry)) (assoc :static/code.cache (atom {})))
        entry                      (if hydrate-hook (or (hydrate-hook entry) entry) entry)]
    entry))

(defn prepare-code-entry
  "prepares a raw code entry for storage without eager hydration"
  {:added "4.1"}
  [entry]
  (let [entry (reduce-kv assoc entry (merge *extra*))]
    (cond->
      entry
      (not (:static/code.cache entry))
      (assoc :static/code.cache (atom {})))))

(defn create-code
  "creates the code entry"
  {:added "4.0"}
  ([form meta book]
   (create-code form meta book {}))
  ([form meta book mopts]
   (let [{:keys [modules]} book]
     (create-code form meta
                  (:grammar book)
                  (:modules book)
                  (merge {:module (-> modules
                                      (get (:module meta))
                                      (assoc :display :brief))}
                         mopts))))
  ([[op sym & body :as form] meta grammar modules mopts]
   (let [reserved (get-in grammar [:reserved op])]
     (-> form
         (create-code-raw reserved meta)
         second
         (create-code-hydrate reserved grammar modules mopts)))))

(defn create-fragment
  "creates a fragment"
  {:added "4.0"}
  [[_ sym value] {return :-, :as meta}]
  (book/book-entry
    (merge
      {:op 'def$,
       :id sym,
       :form value,
       :section :fragment,
       :static/return return}
      (create-common meta)
      (qualified-keys meta :rt))))

(defn create-fragment-hydrate
  "hydrates the forms"
  {:added "4.0"}
  [entry grammar modules mopts]
  (if (:template entry)
    (let [deps-native (preprocess/find-natives entry mopts)]
      (assoc entry :deps #{} :deps-fragment #{} :deps-native deps-native))
    (let [{:keys [form]}             entry
          [_
           deps
           deps-fragment
           deps-native]              (preprocess/to-staging form grammar modules mopts)
          {:keys [ops
                  profiles
                  polyfill-modules]} (xtalk-system/scan-xtalk form grammar)]
      (assoc entry
        :deps
        #{}
        :deps-fragment
        deps-fragment
        :deps-native
        deps-native
        :xtalk-ops
        ops
        :xtalk-profiles
        profiles
        :polyfill-modules
        polyfill-modules))))

(defn create-macro
  "creates a macro"
  {:added "4.0"}
  [[_ sym & body] {return :-, :keys [standalone], :as meta}]
  (let [form (apply list 'fn body) template (eval form)]
    (book/book-entry
      (merge
        {:op 'defmacro,
         :id sym,
         :form form,
         :template template,
         :section :fragment,
         :standalone standalone,
         :static/return return}
        (create-common meta)
        (qualified-keys meta :rt)))))


;;;;
;;
;; EMIT ENTRY
;;
;; This is the major workhorse function for
;; most of the library and optimisations should
;; start from here because it's used everywhere
;;
;; Methods for generation of code from entries
;; - single entry (for use in modules)
;; - entry and all dependencies (with native imports and declarations at the top)
;;    - layout can be specified
;;

(def ^:dynamic *cache-none* false)

(def ^:dynamic *cache-force* false)

(defmacro with:cache-none
  "skips the cache"
  {:added "4.0"}
  [& body]
  (apply list 'binding ['lang.core.impl-entry/*cache-none* true] body))

(defmacro with:cache-force
  "forces the cache to update"
  {:added "4.0"}
  [& body]
  (apply list 'binding ['lang.core.impl-entry/*cache-force* true] body))

(defn emit-entry-raw
  "emits using the raw entry"
  {:added "4.0"}
  [grammar entry {:as mopts :keys [emit]}]
  (if (not entry) (throw (ex :argument {} :ex/message "Entry cannot be null")))
  (let [lang           (or (:lang mopts) (:lang entry))
        book           (or (:book mopts)
                           (when-let [snapshot (:snapshot mopts)] (book/book-from snapshot lang)))
        modules        (or (:modules mopts)
                           (:modules book)
                           (get-in mopts [:snapshot lang :book :modules]))
        reserved       (get-in grammar [:reserved (:op entry)])
        entry          (if (and reserved modules)
                         (impl-template/materialize-code-entry {:grammar grammar :lang lang :modules modules}
                           entry
                           (assoc mopts :lang lang))
                         entry)
        {:keys [form]} entry
        form           (if (:transform emit) ((:transform emit) form mopts) form)
        form           (if (= :python lang)
                         (rewrite/rewrite-stage :staging form grammar (assoc mopts :entry entry))
                         form)
        mopts          (->
                        mopts
                        (assoc :entry (assoc entry :display :brief))
                        (provenance/with-provenance
                         {:lang/phase     :emit/entry
                          :lang/subsystem :lang.core.impl-entry/emit-entry-raw
                          :lang/form      form
                          :lang/lang      lang
                          :lang/module    (:module entry)
                          :lang/namespace (:namespace entry)
                          :lang/entry     (ut/entry-summary entry)}))]
    (binding [preprocess-base/*macro-opts* mopts preprocess-base/*macro-grammar* grammar]
      (try (emit/emit form grammar (:namespace entry) mopts)
        (catch t
          (do (println (str (:module entry)
                         " - ["
                         (:line entry)
                         "] - "
                         (:id entry)
                         "
"
                         (ansi/red (time/now))))
            (println form)
            (ut/throw-with-context "tahto.core entry emit failed"
              (:lang/provenance mopts)
              t)))))))

(def +cached-emit-keys+
  [:transform
   :label
   :trim])

(def +cached-keys+
  [:layout :emit])

(def +emit-entry-cached+ (atom {}))

(defn emit-entry-cached-state
  "Returns cache state for snapshot/restore; retained objects preserve identity."
  []
  (IDeref/deref +emit-entry-cached+))

(defn emit-entry-cached-reset
  "Clears the cache or restores a previously captured state."
  ([] (emit-entry-cached-reset {}))
  ([state] (IReset/reset +emit-entry-cached+ state)))

(defn emit-entry-cached-raw
  "Original generated helper for lang.core.impl-entry/emit-entry-cached."
  [{:keys [grammar entry mopts]}]
  (emit-entry-raw grammar entry mopts))

(defn emit-entry-cached
  "Emits using the original recent-cache policy with actual object identity."
  [{:keys [grammar entry mopts], :as obj} & args]
  (let [k [(ut/sym-full entry) (select-keys mopts +cached-keys+)]
        tag [(:lang mopts)
             grammar
             entry
             (select-keys mopts +cached-keys+)
             (qualified-keys mopts :lang)]
        rec (get (IDeref/deref +emit-entry-cached+) k)
        [old-lang old-grammar old-entry old-options old-qualified] (:tag
                                                                     rec)
        matches (and
                  rec
                  (= old-lang (:lang mopts))
                  (Base/identical? old-grammar grammar)
                  (Base/identical? old-entry entry)
                  (= old-options (select-keys mopts +cached-keys+))
                  (= old-qualified (qualified-keys mopts :lang)))]
    (if (or *cache-force* (not matches))
      (let [return (emit-entry-cached-raw obj)]
        (swap! +emit-entry-cached+ assoc k {:tag tag, :return return})
        return)
      (:return rec))))

(defn emit-entry-label
  "emits the entry label"
  {:added "4.0"}
  [grammar entry]
  (let [{:keys [prefix suffix]} (get-in grammar [:default :comment])]
    (str prefix " " (ut/sym-full entry) " [" (:line entry) "] " suffix)))

(defn emit-entry
  "emits a given entry"
  {:added "4.0"}
  [grammar entry {:as mopts :keys [snapshot module emit]}]
  (if (not (:suppress emit))
    (let [mopts                      (or
                                      (and
                                       (not module)
                                       snapshot
                                       (let
                                        [{:keys [lang module]} entry book (book/book-from snapshot lang)]
                                        (assoc
                                         mopts
                                         :book
                                         book
                                         :modules
                                         (:modules book)
                                         :module
                                         (get-in book [:modules module]))))
                                      mopts)
          {:keys [label trim cache]} emit
          body                       (cond
                                      (or *cache-none* (:static/no-cache entry) (= cache :none)) (emit-entry-raw grammar entry mopts)
                                      :else                                                      (binding
                                                                                                  [*cache-force* (or *cache-force* (= cache :force))] (emit-entry-cached {:entry entry :grammar grammar :mopts mopts})))
          body                       (reduce
                                      (fn
                                       [body transform]
                                       ((if (= :std.native.Var (Base/type transform)) (deref transform) transform)
                                        body
                                        {:entry entry :grammar grammar :mopts mopts}))
                                      body
                                      (-> emit :code :transforms :entry))
          body                       (reduce
                                      (fn
                                       [body transform]
                                       ((if (= :std.native.Var (Base/type transform)) (deref transform) transform)
                                        body
                                        {:entry entry :grammar grammar :mopts mopts}))
                                      body
                                      (get-in snapshot [(:lang mopts) :book :meta :transforms :entry]))
          body                       (cond->> body label (str (emit-entry-label grammar entry) "
") trim (trim))]
      body)))

(comment
  (-> (tahto.core/get-snapshot
       (tahto.core/default-library))
      :js
      :book
      :meta)

  (:meta (tahto.core/grammar :js))

  )

(defn entry-symbol
  "Returns the fully qualified Book coordinate for one code entry."
  [entry]
  (symbol (str (:module entry)) (name (:id entry))))
