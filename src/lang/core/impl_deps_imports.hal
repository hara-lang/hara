(ns lang.core.impl-deps-imports
  (:config {:role :internal})
  (:require [lang.base.book :as b]
            [lang.base.book-module :as module]
            [lang.base.emit-template :as impl-template]
            [lang.base.util :as ut]))

(defn materialize-import-entry [book entry]
  (if (= :code (:section entry))
    (impl-template/materialize-code-entry book entry)
    entry))

(defn get-entry-imports
  "gets all fragment imports from code entries"
  {:added "4.0"}
  ([entries]
    (->>
      entries
      (filter (comp not-empty :deps-native))
      (map
        (fn [entry-value] [(ut/sym-full entry-value)
                           (:deps-native entry-value)]))
      (into {})))
  ([book entries]
    (get-entry-imports
      (map (partial materialize-import-entry book) entries))))

(defn get-namespace-imports
  "merges imports for both fragment and code entries"
  {:added "4.0"}
  [imports]
  (->> (seq imports)
    (map (fn [[sym m]] {(symbol (namespace sym)) m}))
    (apply merge-with
      (fn [migration-argument-0 migration-argument-1]
        (merge-with union migration-argument-0 migration-argument-1)))))

;;
;; script imports
;;

(defn get-fragment-deps
  "gets all the fragment dependencies"
  {:added "4.0"}
  ([book entries] (get-fragment-deps book entries #{}))
  ([book entries seen] (let [entries   (map (partial materialize-import-entry book) entries)
                             fragments (->> (map :deps-fragment entries)
                                            (apply union)
                                            (filter (fn [fragment-id] (not (has? seen fragment-id)))))]
                         (if (empty? fragments)
                           seen
                           (get-fragment-deps book
                             (map (fn [migration-argument-0] (b/get-fragment-entry book migration-argument-0))
                               fragments)
                             (union seen (set fragments)))))))

(defn format-namespace-imports
  [book ns-imports]
  (reduce (fn [out [module-id m]]
            (let [module  (b/get-module book module-id)
                  imports (select-keys (:native module) (keys m))]
              (merge out imports)))
          {}
          ns-imports))

(defn script-import-deps
  "collect all native imports"
  {:added "4.0"}
  [book entries]
  (let [fragments (get-fragment-deps book entries)
        fentries  (map (fn [migration-argument-0] (b/get-fragment-entry book migration-argument-0))
                       fragments)
        fnatives  (get-entry-imports book fentries)
        natives   (get-entry-imports book entries)]
    (get-namespace-imports (concat natives fnatives))))

(defn script-imports
  "gets the ns imports for a script"
  {:added "4.0"}
  [book entries]
  (let [ns-imports  (script-import-deps book entries)]
    (format-namespace-imports book ns-imports)))

;;
;;
;;

(defn module-imports
  "gets the ns imports for a script"
  {:added "4.0"}
  [book module-id]
  (let [module    (module/module-derived-view book
                                              (b/get-module book module-id))
         links     (module/module-deps-code book module)
         entries   (vals (:code module))]
     {:native (script-imports book entries)
      :direct links}))

(defn module-code-deps
  "resolves all dependencies"
  {:added "3.0"}
  ([book module-ids] (module-code-deps book module-ids {:all #{} :graph {}}))
  ([book module-ids deps] (let [submap (into
                                        {}
                                        (map
                                         (fn
                                          [migration-map-juxt-value]
                                          [(identity migration-map-juxt-value)
                                           ((fn
                                             [module-id]
                                             (->> (b/get-module book module-id) (module/module-deps-code book) set))
                                            migration-map-juxt-value)])
                                         module-ids))
                                ndeps  (-> deps (update :graph merge submap) (update :all into (concat module-ids)))
                                nids   (difference (apply union (vals (:graph ndeps))) (:all ndeps))]
                            (if (not-empty nids) (module-code-deps book nids ndeps) ndeps))))
