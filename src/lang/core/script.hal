;; ============================================================================
;; lang.core.script — native source registration and target evaluation.
;; ============================================================================
(ns lang.core.script
  (:require [lang.common.book :as book]
            [lang.common.compiler :as compiler]
            [lang.core.eval :as evaluation]
            [lang.core.library :as library]
            [lang.core.registry :as registry]
            [lang.core.runtime :as runtime]))

(def +scripts+ (atom {}))
(def +compile-cache+ (atom {}))

(def ^{:dynamic true} *cache-none* false)
(def ^{:dynamic true} *cache-force* false)

(def ^{:dynamic true} *module-compiler*
  (fn [options]
    (let [_ (require 'lang.core.compile)
          compile-module (deref (resolve 'lang.core.compile/compile-module))]
      (compile-module options))))

(def ^{:dynamic true} *module-evaluator*
  (fn [instance source options]
    (evaluation/eval-await instance source options)))

(def +module-metadata-keys+
  [:static :application :schema :source :require-impl :implements :import
   :specialize :includes :export :file :display :emit :module/primary])

(defn script-snapshot
  "Captures Library source state plus owned runtime records and structural cache."
  []
  {:library (library/library-raw-snapshot (library/default-library))
   :scripts (deref +scripts+)
   :compile-cache (deref +compile-cache+)})

(defn script-restore!
  "Restores a Library-owned script snapshot; nil returns every owned state to baseline."
  [snapshot]
  (let [snapshot (or snapshot {})]
    (if (has? snapshot :modules)
      (throw (ex :argument {:snapshot snapshot}
                 :ex/message "Script snapshots must contain :library, not legacy :modules")))
    (library/library-restore! (library/default-library) (:library snapshot))
    (reset! +scripts+ (or (:scripts snapshot) {}))
    (reset! +compile-cache+ (or (:compile-cache snapshot) {}))
    (script-snapshot)))

(defn script-reset!
  "Clears registered source, runtime, and cache state idempotently."
  []
  (script-restore! nil))

(defn reset-compile-cache!
  "Invalidates memoised structural compilation results."
  []
  (reset! +compile-cache+ {})
  nil)

(defn register-library-module!
  "Writes a source module through the active Library."
  [language module-value]
  (let [stored (library/library-add-module! (library/runtime-library)
                                            language module-value)]
    (reset-compile-cache!)
    stored))

(defn register-library-entry!
  "Writes a source entry through the active Library."
  [language entry-value]
  (let [stored (library/library-set-entry! (library/runtime-library)
                                           language entry-value)]
    (reset-compile-cache!)
    stored))

(defmacro with:cache-none
  [& body]
  `(binding [lang.core.script/*cache-none* true] ~@body))

(defmacro with:cache-force
  [& body]
  `(binding [lang.core.script/*cache-force* true] ~@body))

(defn namespace-symbol
  []
  (symbol (str (ns-current))))

(defn module-symbol
  []
  (or (:id (second (library/library-find-module-by-source
                    (library/runtime-library)
                    (namespace-symbol))))
      (namespace-symbol)))

(defn current-module-id
  []
  (module-symbol))

(defn symbol-id
  [value]
  (symbol (name value)))

(defn require-module
  [spec]
  (if (symbol? spec) spec (first spec)))

(defn require-primary?
  [spec]
  (if (not (vector? spec))
    false
    (loop [index 1]
      (if (>= index (count spec))
        false
        (if (and (= :primary (nth spec index))
                 (= true (nth spec (inc index))))
          true
          (recur (+ index 2)))))))

(defn require-link
  [spec]
  (let [module (require-module spec)
        values (if (symbol? spec) [] (vec (rest spec)))]
    (loop [remaining values]
      (if (empty? remaining)
        [module module]
        (if (= :as (first remaining))
          [(let [alias (second remaining)]
             (if (vector? alias) (last alias) alias))
           module]
          (recur (vec (rest remaining))))))))

(defn module-config
  [lang module config]
  (let [config (or config {})
        requires (vec (or (:require config) []))
        explicit-links (or (:link config) {})
        links (reduce (fn [out spec]
                        (let [[alias target] (require-link spec)]
                          (assoc out alias target)))
                      (merge {'- module} explicit-links)
                      requires)]
    (merge {:id module
            :lang lang
            :require requires
            :require-impl (vec (or (:require-impl config) []))
            :implements (book/module-normalize-implements (:implements config))
            :link links
            :code {}
            :fragment {}}
           (select-keys config +module-metadata-keys+))))

(defn configure-module
  ([lang config]
   (configure-module lang (namespace-symbol) config (namespace-symbol)))
  ([lang module config]
   (configure-module lang module config (namespace-symbol)))
  ([lang module config source]
   (let [source (or source (namespace-symbol))
         current (get (library/library-raw-book-modules (library/runtime-library) lang)
                      module)
         configured (merge current (module-config lang module config))
         configured (assoc configured
                           :source source
                           :code (or (:code current) {})
                           :fragment (or (:fragment current) {}))
         configured (if (:native current)
                      (assoc configured :native (:native current))
                      configured)]
     (register-library-module! lang configured))))

(defn portable-schema-form
  "Retains source schemas as data without leaking mutable host descriptors."
  [value]
  (cond (vector? value) (vec (map portable-schema-form value))
        (list? value) (apply list (map portable-schema-form value))
        (map? value) (reduce-kv (fn [out key item]
                                  (assoc out (portable-schema-form key)
                                         (portable-schema-form item)))
                                {}
                                value)
        (set? value) (set (map portable-schema-form value))
        :else value))

(defn schema-value-form
  [variable]
  (let [value (deref variable)
        value-type (type value)]
    (cond (= :std.native.SchemaType value-type)
          (portable-schema-form (Schema/form value))

          (or (= :std.native.StructType value-type)
              (= :std.native.MutableType value-type))
          (let [schema-value (Schema/of variable)]
            (if schema-value (portable-schema-form (Schema/form schema-value))))

          :else nil)))

(defn module-source-symbol
  ([module-id]
   (module-source-symbol (or (first (library/library-find-module
                                     (library/runtime-library)
                                     module-id))
                             :xtalk)
                         module-id))
  ([language module-id]
   (let [current-library (library/runtime-library)
         module (or (get (library/library-book-modules current-library language)
                         module-id)
                    (library/library-get-source-module current-library language module-id)
                    (second (library/library-find-module current-library module-id)))]
     (let [source (:source module)]
     (or (when (symbol? source) source)
         module-id)))))

(defn module-schema-values
  ([module-id]
   (module-schema-values (or (first (library/library-find-module
                                     (library/runtime-library)
                                     module-id))
                             :xtalk)
                         module-id))
  ([language module-id]
   (let [source (module-source-symbol language module-id)]
     (if (not= :loaded (:namespace/state (ns-info source)))
       {}
       (reduce-kv (fn [out var-name variable]
                    (let [form (schema-value-form variable)]
                      (if form (assoc out (symbol (str source) (name var-name)) form) out)))
                  {}
                  (Runtime/vars source))))))

(defn refresh-module-schemas
  ([module-id]
   (refresh-module-schemas (or (first (library/library-find-module
                                       (library/runtime-library)
                                       module-id))
                               :xtalk)
                           module-id))
  ([language module-id]
   (let [current-library (library/runtime-library)
         module (or (get (library/library-book-modules current-library language)
                         module-id)
                    (library/library-get-source-module current-library language module-id))]
     (if (nil? module)
       (throw (ex :not-found {:language language :module module-id}
                  :ex/message "Script module is not registered"))
       (let [updated (assoc module :schema
                            (merge (or (:schema module) {})
                                   (module-schema-values language module-id)))]
         (register-library-module! (:lang updated) updated))))))

(defn code-operation-key
  "Returns the grammar declaration key retained by a registered code entry."
  [form]
  (let [operation (first form)]
    (if (has? #{'defn 'deftype 'deftrigger 'defenum 'defconst} operation)
      (keyword (name operation))
      :def)))

(defn register-code
  ([form] (register-code nil form nil))
  ([explicit-language form] (register-code explicit-language form nil))
  ([explicit-language form declaration-metadata]
   (let [module (module-symbol)
         entry-symbol (second form)
         metadata (merge (or (meta entry-symbol) {})
                         (or declaration-metadata {}))
         entry-symbol (with-meta entry-symbol metadata)
         form (apply list (first form) entry-symbol (drop 2 form))
         id (symbol-id entry-symbol)
         current-library (library/runtime-library)
         current (or (library/library-get-source-module
                      current-library (or explicit-language :xtalk) module)
                     (second (library/library-find-module current-library module))
                     (module-config (or explicit-language :xtalk) module {}))
         language (or explicit-language (:lang current) :xtalk)
         entry (merge metadata
                      {:id id :symbol (symbol (str module "/" (name id)))
                       :module module
                       :lang language
                       :section :code :op (first form)
                       :op-key (code-operation-key form)
                       :declaration-meta metadata
                       :form form :form-input form})
         entry (if (has? metadata :public)
                 (assoc entry :static/public (:public metadata))
                 entry)]
     (if (nil? (library/library-raw-book-record (library/runtime-library) language))
       (register-library-module! language current))
     (register-library-entry! language entry))))

(defn register-fragment
  ([form template]
   (register-fragment nil form template nil))
  ([explicit-language form template]
   (register-fragment explicit-language form template nil))
  ([explicit-language form template declaration-metadata]
   (let [module (module-symbol)
         entry-symbol (second form)
         metadata (merge (or (meta entry-symbol) {})
                         (or declaration-metadata {}))
         entry-symbol (with-meta entry-symbol metadata)
         form (apply list (first form) entry-symbol (drop 2 form))
         id (symbol-id entry-symbol)
         current-library (library/runtime-library)
         current (or (library/library-get-source-module
                      current-library (or explicit-language :xtalk) module)
                     (second (library/library-find-module current-library module))
                     (module-config (or explicit-language :xtalk) module {}))
         language (or explicit-language (:lang current) :xtalk)
         entry (merge metadata
                      {:id id :symbol (symbol (str module "/" (name id)))
                       :module module :lang language :section :fragment
                       :op 'defmacro :op-key :defmacro
                       :form form :form-input form :template template})]
     (if (nil? (library/library-raw-book-record (library/runtime-library) language))
       (register-library-module! language current))
     (register-library-entry! language entry))))

(defn register-fragment-pointer
  "Registers a def$.<tag> fragment and returns its portable language pointer."
  [explicit-language declaration-symbol value metadata]
  (let [module (module-symbol)
        id (symbol-id declaration-symbol)
        current-library (library/runtime-library)
        current (or (library/library-get-source-module
                     current-library (or explicit-language :xtalk) module)
                    (second (library/library-find-module current-library module))
                    (module-config :xtalk module {}))
        language (or explicit-language (:lang current) :xtalk)
        return-value (or (:static/return metadata) (get metadata :-))
        entry (merge (or metadata {})
                     {:id id
                      :symbol (symbol (str module "/" (name id)))
                      :module module
                      :lang language
                      :section :fragment
                      :op 'def$
                      :op-key :def$
                      :form value
                      :form-input value
                      :template nil})
        entry (if return-value
                (assoc entry :static/return return-value)
                entry)
        context (script-context language)]
    (if (nil? (library/library-raw-book-record (library/runtime-library) language))
      (register-library-module! language current))
    (register-library-entry! language entry)
    (pointer (assoc entry :entry entry :context context))))

(defn register-macro-fragment
  "Registers a defmacro.<tag> source macro as a target-language fragment."
  ([explicit-language form template]
   (register-macro-fragment explicit-language form template nil))
  ([explicit-language form template declaration-metadata]
   (register-fragment explicit-language form template declaration-metadata)
   nil))

(defn script-context
  "Returns the language context key carried by registered source pointers."
  [lang]
  (keyword "lang" (name lang)))

(defn register-code-pointer
  "Registers a grammar declaration and returns its portable language pointer."
  ([form]
   (register-code-pointer nil form nil))
  ([explicit-language form]
   (register-code-pointer explicit-language form nil))
  ([explicit-language form declaration-metadata]
   (let [entry (register-code explicit-language form declaration-metadata)
         context (script-context (:lang entry))]
     (pointer (assoc entry :entry entry :context context)))))

(def +script-tag-aliases+
  {:xtalk :xt
   :postgres :pg})

(defn script-tags
  "Returns the selected grammar tag and its Foundation declaration tag."
  [lang]
  (let [info (registry/registry-book-macro-info lang)
        tag (or (:tag info) lang)
        alias (or (get +script-tag-aliases+ lang) tag)]
    (if (= alias tag) [tag] [alias tag])))

(defn script-definition-symbols
  "Lists top-level grammar definitions that must receive source macros."
  [lang]
  (:definitions (registry/registry-book-macro-info lang)))

(defn script-highlight-symbols
  "Lists grammar highlight forms that must remain callable after script setup."
  [lang]
  (:highlights (registry/registry-book-macro-info lang)))

(defn script-quote-macro-expansion
  "Wraps target macro output so the host macro does not eagerly execute it."
  [forms]
  (list 'list
        (list 'quote 'quote)
        (apply list 'do forms)))

(defn script-runtime-macro-body
  "Converts a source macro body into the quoted target fragment contract."
  [body]
  (let [[prefix declarations]
        (loop [prefix [] declarations (vec body)]
          (if (or (string? (first declarations))
                  (map? (first declarations)))
            (recur (conj prefix (first declarations))
                   (vec (rest declarations)))
            [prefix declarations]))
        transformed
        (if (vector? (first declarations))
          [(first declarations)
           (script-quote-macro-expansion (vec (rest declarations)))]
          (map (fn [clause]
                 (list (first clause)
                       (script-quote-macro-expansion (vec (rest clause)))))
               declarations))]
    (vec (concat prefix transformed))))

(defn script-defmacro-expansion
  "Defines a host macro and registers its target-language fragment template."
  [lang declaration-symbol body namespace-symbol]
  (let [metadata (or (meta declaration-symbol) {})
        declaration-symbol (with-meta declaration-symbol metadata)
        form (apply list 'defmacro declaration-symbol body)
        runtime-form (apply list 'defmacro declaration-symbol
                            (script-runtime-macro-body body))
        qualified (symbol (str namespace-symbol) (name declaration-symbol))]
    `(do
       ~runtime-form
       (lang.core.script/register-macro-fragment
        ~lang
        '~form
        (fn [& args]
          (let [expanded (macroexpand-1 (apply list '~qualified args))]
            (if (and (list? expanded)
                     (= 'quote (first expanded)))
              (second expanded)
              expanded)))
        '~metadata))))

(defn script-eval-macro-form
  "Builds the caller-local !.<tag> evaluator macro for one language."
  [lang tag]
  (let [macro-symbol (symbol (str "!." (name tag)))]
    (if (= lang :postgres)
      (list 'defmacro
            macro-symbol
            (vector '& 'body)
            (list 'list
                  (list 'quote 'lang.core.script/eval-forms)
                  lang
                  (list 'list (list 'quote 'quote) 'body)))
      (list 'defmacro
            macro-symbol
            (vector '& 'body)
            (list 'list
                  (list 'quote 'lang.core.script/eval-form)
                  lang
                  (list 'list
                        (list 'quote 'quote)
                        (list 'if
                              (list '= 1 (list 'count 'body))
                              (list 'first 'body)
                              (list 'apply 'list (list 'quote 'do) 'body))))))))

(defn script-definition-macro-form
  "Builds one namespace-local def.<tag> declaration registration macro."
  [lang tag operation]
  (let [macro-symbol (symbol (str (name operation) "." (name tag)))]
    (list
     'defmacro
     macro-symbol
     (vector 'symbol '& 'body)
     (list
      'list
      (list 'quote 'def)
      'symbol
      (list
       'list
       (list 'quote 'lang.core.script/register-code-pointer)
       lang
       (list
        'list
        (list 'quote 'quote)
        (list
         'apply
         'list
         (list 'quote operation)
         'symbol
         'body))
       (list
        'list
        (list 'quote 'quote)
        (list 'merge
              (list 'or (list 'meta 'symbol) {})
              (list 'or (list 'meta (list 'second '&form)) {}))))))))

(defn script-fragment-macro-form
  "Builds one def$.<tag> fragment pointer declaration macro."
  [lang tag]
  (let [macro-symbol (symbol (str "def$." (name tag)))]
    (list 'defmacro
          macro-symbol
          (vector 'symbol 'value)
          (list 'list
                (list 'quote 'def)
                'symbol
                (list 'list
                      (list 'quote 'lang.core.script/register-fragment-pointer)
                      lang
                      (list 'list (list 'quote 'quote) 'symbol)
                      (list 'list (list 'quote 'quote) 'value)
                      (list 'list
                            (list 'quote 'quote)
                            (list 'or (list 'meta 'symbol) {})))))))

(defn script-defmacro-macro-form
  "Builds one defmacro.<tag> source macro registration form."
  [lang tag]
  (let [macro-symbol (symbol (str "defmacro." (name tag)))]
    (list 'defmacro
          macro-symbol
          (vector 'symbol '& 'body)
          (list 'lang.core.script/script-defmacro-expansion
                lang
                'symbol
                'body
                (list :ns '&env)))))

(defn script-highlight-macro-form
  "Builds an inert host declaration for a grammar-highlighted macro symbol."
  [lang highlight-symbol]
  (let [operation (get-in (registry/registry-book-macro-info lang)
                          [:highlight-meta highlight-symbol])
        macro-symbol (with-meta (symbol (name highlight-symbol))
                       (select-keys (or operation {}) [:arglists :style/indent]))]
    (list 'defmacro macro-symbol (vector '& 'body) nil)))

(defn script-macro-forms
  "Builds the complete grammar-derived macro surface for one script declaration."
  [lang]
  (let [tags (script-tags lang)
        definitions (script-definition-symbols lang)
        highlights (script-highlight-symbols lang)
        evaluator-forms (map (fn [tag] (script-eval-macro-form lang tag)) tags)
        special-forms (mapcat (fn [tag]
                                [(script-fragment-macro-form lang tag)
                                 (script-defmacro-macro-form lang tag)])
                              tags)
        definition-forms
        (mapcat
         (fn [tag]
           (map (fn [operation]
                  (script-definition-macro-form lang tag operation))
                definitions))
         tags)
        highlight-forms (map (fn [symbol]
                               (script-highlight-macro-form lang symbol))
                             highlights)]
    (vec
     (concat evaluator-forms special-forms definition-forms highlight-forms))))

(defn script-macro-parts
  "Splits a generated grammar macro symbol into operation and language tag."
  [form]
  (let [parts (str/split (name (first form)) ".")]
    {:operation (first parts)
     :tag (keyword (last parts))}))

(defn script-macro-language
  "Resolves the canonical language name carried by a generated macro symbol."
  [form]
  (let [tag (:tag (script-macro-parts form))]
    (case tag
      :xt :xtalk
      :pg :postgres
      :py :python
      tag)))

(defn script-generated-macro-source
  "Returns the stable macro Var source for one generated grammar alias."
  [form]
  (let [macro-symbol (second form)
        macro-name (name macro-symbol)]
    (cond
      (str/starts-with? macro-name "!.")
      'lang.core.script/script-generated-eval

      (str/starts-with? macro-name "def$.")
      'lang.core.script/script-generated-fragment

      (str/starts-with? macro-name "defmacro.")
      'lang.core.script/script-generated-defmacro

      (str/includes? macro-name ".")
      'lang.core.script/script-generated-definition

      :else
      'lang.core.script/script-generated-highlight)))

(defn script-macro-bindings
  "Builds generated grammar macro aliases and their stable implementation Vars."
  [lang]
  (let [tags (script-tags lang)
        definitions (script-definition-symbols lang)
        highlights (script-highlight-symbols lang)
        evaluator-bindings
        (map (fn [tag]
               [(symbol (str "!." (name tag)))
                'lang.core.script/script-generated-eval])
             tags)
        special-bindings
        (mapcat (fn [tag]
                  [[(symbol (str "def$." (name tag)))
                    'lang.core.script/script-generated-fragment]
                   [(symbol (str "defmacro." (name tag)))
                    'lang.core.script/script-generated-defmacro]])
                tags)
        definition-bindings
        (mapcat
         (fn [tag]
           (map (fn [operation]
                  [(symbol (str (name operation) "." (name tag)))
                   'lang.core.script/script-generated-definition])
                definitions))
         tags)
        highlight-bindings
        (map (fn [highlight]
               [(symbol (name highlight))
                'lang.core.script/script-generated-highlight])
             highlights)]
    (vec
     (concat evaluator-bindings
             special-bindings
             definition-bindings
             highlight-bindings))))

(defn script-intern-macros!
  "Interns missing generated grammar macro Vars into a caller namespace."
  [namespace-symbol lang]
  (reduce
   (fn [_ [macro-symbol source]]
     (let [qualified (symbol (str namespace-symbol) (name macro-symbol))]
       (when (nil? (Base/resolve qualified))
         (Runtime/intern-var namespace-symbol
                             macro-symbol
                             (Base/resolve source)
                             {:macro true
                              :arglists '([& body])}))))
   nil
   (script-macro-bindings lang)))

(defmacro script-generated-eval
  "Expansion source used by the generated !.<tag> evaluator aliases."
  [& body]
  (let [lang (script-macro-language &form)
        module (symbol (str (:ns &env)))
        target-form (if (= 1 (count body))
                      (first body)
                      (apply list 'do body))]
    (if (= lang :postgres)
      (list 'lang.core.script/eval-forms
            lang
            (list 'quote module)
            (list 'quote body))
      (list 'lang.core.script/eval-form
            lang
            (list 'quote module)
            (list 'quote target-form)))))

(defmacro script-generated-definition
  "Expansion source used by grammar-derived target declaration aliases."
  [declaration-symbol & body]
  (let [{:keys [operation]} (script-macro-parts &form)
        operation (symbol operation)
        declaration-metadata (merge (or (meta declaration-symbol) {})
                                    (or (meta (second &form)) {})
                                    (or (meta &form) {}))
        declaration-symbol (with-meta declaration-symbol
                             declaration-metadata)
        target-form (apply list operation declaration-symbol body)]
    (list 'def
          declaration-symbol
          (list 'lang.core.script/register-code-pointer
                (script-macro-language &form)
                (list 'quote target-form)
                (list 'quote declaration-metadata)))))

(defmacro script-generated-fragment
  "Expansion source used by generated def$.<tag> fragment aliases."
  [symbol value]
  (list 'def
        symbol
        (list 'lang.core.script/register-fragment-pointer
              (script-macro-language &form)
              (list 'quote symbol)
              (list 'quote value)
              (list 'quote (or (meta symbol) {})))))

(defmacro script-generated-defmacro
  "Expansion source used by generated defmacro.<tag> aliases."
  [symbol & body]
  (script-defmacro-expansion
   (script-macro-language &form)
   symbol
   body
   (:ns &env)))

(defmacro script-generated-highlight
  "Expansion source used by inert grammar highlight aliases."
  [& body]
  nil)

(defn script-install-macro-form
  "Interns each generated macro only when the source namespace does not own it."
  [form]
  (let [macro-symbol (second form)
        source (script-generated-macro-source form)]
    (list 'if
          (list 'resolve (list 'quote macro-symbol))
          nil
          (list 'intern-var
                (list 'ns-current)
                (list 'quote macro-symbol)
                (list 'var source)))))

(defmacro defn.xt
  [symbol & body]
  `(do
     (lang.core.script/register-code '~(apply list 'defn symbol body))
     (defn ~symbol ~@body)))

(defmacro defmacro.xt
  [symbol & body]
  `(do
     (lang.core.script/register-fragment '~(apply list 'defmacro symbol body) nil)
     (defmacro ~symbol ~@body)))

(defn module-loaded?
  ([module]
   (not (nil? (library/library-find-module (library/runtime-library) module))))
  ([language module]
   (not (nil? (library/library-get-source-module (library/runtime-library)
                                                  language
                                                  module)))))

(defn load-module
  ([spec]
   (let [source (require-module spec)
         current-library (library/runtime-library)
         [language module-value] (or (library/library-find-module-by-source
                                      current-library source)
                                     (library/library-find-module current-library source)
                                     [nil nil])
         language (or language :xtalk)]
     (load-module language spec)))
  ([language spec]
   (let [source (require-module spec)
         current-library (library/runtime-library)
         [_ current] (or (library/library-find-module-by-source
                          current-library source)
                         [nil nil])
         module (or (:id current) source)]
     (if (not (module-loaded? language module))
       (eval (list 'require (list 'quote source))))
     (let [[_ current] (or (library/library-find-module-by-source
                            current-library source)
                           [nil nil])
           module (or (:id current) module)
           value (or (library/library-get-source-module current-library language module)
                     current)]
       (if (nil? value)
         (throw (ex :dependency {:language language :module module :source source}
                    :ex/message "Required namespace did not provide a script module"))
         (do
           (refresh-module-schemas (:lang value) module)
           module))))))

(defn script-options
  [options]
  (cond (empty? options) [(namespace-symbol) {}]
        (map? (first options)) [(namespace-symbol) (first options)]
        (symbol? (first options)) [(first options) (or (second options) {})]
        :else (throw (ex :argument {:options options}
                   :ex/message "script expects an optional module symbol and config map"))))

(defn script-ns-import
  [lang config]
  (reduce (fn [primary spec]
            (let [source (require-module spec)]
              (load-module lang spec)
              (if (require-primary? spec) (conj primary source) primary)))
          #{}
          (concat (or (:require-impl config) [])
                  (book/module-normalize-implements (:implements config))
                  (or (:require config) []))))

(defn setup
  ([lang config test?]
   (setup lang (namespace-symbol) config test?))
  ([lang module config test?]
   (let [source (namespace-symbol)
         config (or config {})
         primary (script-ns-import lang config)
         configured (configure-module lang module
                                      (assoc config :module/primary primary)
                                      source)]
     (if test?
       (swap! +scripts+ assoc [module lang]
              {:lang lang :module module :source source
               :config config :runtime nil}))
     configured)))

(defn compile-script-module
  "Compiles one selected script module through its active Library Book."
  [lang module config]
  (let [current-library (library/runtime-library)]
    (*module-compiler*
      {:lang lang
       :main module
       :layout :flat
       :emit (or (:emit config) {})
      :book (library/library-get-book current-library lang)})))

(defn script-module-source?
  "Returns whether a selected script module owns emitted source declarations."
  [lang module]
  (let [module-value (get (library/library-book-modules (library/runtime-library)
                                                           lang)
                          module)]
    (or (not (empty? (:code module-value)))
        (not (empty? (:fragment module-value))))))

(defn initialize-script!
  "Compiles and injects a selected basic-runtime module after transport startup."
  [instance lang module config]
  (let [compiled (if (script-module-source? lang module)
                   (compile-script-module lang module config)
                   {:output "" :diagnostics []})
        diagnostics (or (:diagnostics compiled) [])
        output (or (:output compiled) "")]
    (if (not (empty? diagnostics))
      (throw
       (ex :dependency {:lang lang
                        :module module
                        :diagnostics diagnostics}
           :ex/message "Script module compilation failed"))
      (do
        (if (not (empty? output))
          (*module-evaluator* instance output
                             {:timeout (or (:timeout config)
                                           (:timeout instance)
                                           2000)}))
        instance))))

(defn start-runtime
  "Creates and starts one runtime through the shared script lifecycle."
  [lang runtime-id config]
  (let [config (or config {})
        module (:module config)
        instance (runtime/rt-start
                  (runtime/rt-create lang (or runtime-id :default) config))
        instance (if (and (= runtime-id :basic) module)
                   (try
                     (initialize-script! instance lang module config)
                     (catch error
                       (do
                         (runtime/rt-stop instance)
                         (throw error))))
                   instance)]
    (if (= lang :postgres)
      (reduce
       (fn [current spec]
         (if (require-primary? spec)
           (IContextLifeCycle/setup-module current (first spec))
           current))
       instance
       (or (:require config) []))
      instance)))

(defn start-script
  "Creates, starts, and records the selected runtime for one script coordinate."
  [lang module config]
  (let [config (or config {})
        coordinate [module lang]
        previous (get-in (deref +scripts+) [coordinate :runtime])
        _ (if previous (runtime/rt-stop previous))
        runtime-id (or (:runtime config) :default)
        instance (start-runtime lang runtime-id (assoc config :module module))
        record {:lang lang
                :module module
                :source (namespace-symbol)
                :config config
                :runtime instance}]
    (swap! +scripts+ assoc coordinate record)
    instance))

(defn script-form
  ([lang options]
   (script-form (namespace-symbol) lang options))
  ([source lang options]
   (let [[module config]
         (cond (empty? options) [source {}]
               (map? (first options)) [source (first options)]
               (symbol? (first options)) [(first options) (or (second options) {})]
               :else (throw (ex :argument {:options options}
                                  :ex/message "script expects an optional module symbol and config map")))]
     (list 'lang.core.script/setup (list 'quote lang) (list 'quote module)
           (list 'quote config) false))))

(defn script-test-form
  ([lang options]
   (script-test-form (namespace-symbol) lang options))
  ([source lang options]
   (let [[module config]
         (cond (empty? options) [source {}]
               (map? (first options)) [source (first options)]
               (symbol? (first options)) [(first options) (or (second options) {})]
               :else (throw (ex :argument {:options options}
                                  :ex/message "script expects an optional module symbol and config map")))]
     (list 'lang.core.script/setup (list 'quote lang) (list 'quote module)
           (list 'quote config) true))))

(defn script-expansion
  "Builds ordinary or deferred script setup with grammar-derived declarations."
  [source lang options test?]
  (let [setup-form (if test?
                     (script-test-form source lang options)
                     (script-form source lang options))
        [module config] (script-options options)
        final-form (if test?
                     nil
                     (list 'lang.core.script/start-script
                           (list 'quote lang)
                           (list 'quote module)
                           (list 'quote config)))]
    (apply list
           'do
           (concat [setup-form]
                   [final-form]))))

(defmacro script
  [lang & options]
  (let [namespace-symbol (symbol (str (:ns &env)))]
    (lang.core.script/script-intern-macros! namespace-symbol lang)
    (lang.core.script/script-expansion namespace-symbol lang options false)))

(defmacro script-
  [lang & options]
  (let [namespace-symbol (symbol (str (:ns &env)))]
    (lang.core.script/script-intern-macros! namespace-symbol lang)
    (lang.core.script/script-expansion namespace-symbol lang options true)))

(defn selected-book
  [lang]
  (library/library-get-book (library/runtime-library) lang))

(defn compile-cache-key
  [lang module form]
  [lang module form
   (:revision (library/library-snapshot (library/runtime-library)))])

(defn compile-one
  [lang form module entry]
  (let [book (selected-book lang)
        modules (:modules book)
        context {:book book
                 :modules modules :module module :entry entry
                 :lang lang :layout :flat}
        work (fn []
               (if entry
                 (compiler/compile-entry (compiler/compiler) entry (:selection book) context)
                 (compiler/compile (compiler/compiler) form (:selection book) context)))
        key (compile-cache-key lang (:id module) form)]
    (cond *cache-none* (work)
          *cache-force* (let [result (work)] (swap! +compile-cache+ assoc key result) result)
          :else (or (get (deref +compile-cache+) key)
                    (let [result (work)]
                      (swap! +compile-cache+ assoc key result)
                      result)))))

(defn compile-form
  "Compiles a single target expression against registered module source."
  [lang module form]
  (let [module-value (or (get (:modules (selected-book lang)) module)
                         (module-config lang module {}))]
    (:output (compile-one lang form module-value nil))))

(defn restart
  []
  (reduce (fn [_ pair]
            (let [[_ script] pair]
              (start-script (:lang script) (:module script) (:config script))))
          nil
          (deref +scripts+))
  nil)

(defn stop
  []
  (reduce (fn [_ pair]
            (let [[coordinate script] pair
                  instance (:runtime script)]
              (if instance (runtime/rt-stop instance))
              (swap! +scripts+ assoc coordinate (assoc script :runtime nil))))
          nil
          (deref +scripts+))
  nil)

(defn eval-form
  ([lang form]
   (eval-form lang (namespace-symbol) form))
  ([lang module form]
   (let [script (get (deref +scripts+) [module lang])
         instance (:runtime script)]
     (if (nil? script)
       (throw (ex :dependency {:module module :lang lang}
                  :ex/message "Script is not configured"))
       (if (nil? instance)
         (throw (ex :dependency {:module module :lang lang}
                    :ex/message "Script runtime is not started"))
         (evaluation/eval-await instance (compile-form lang module form) {}))))))

(defn eval-forms
  ([lang forms]
   (eval-forms lang (namespace-symbol) forms))
  ([lang module forms]
   (let [results (vec (map (fn [form] (eval-form lang module form)) forms))]
     (if (= 1 (count results)) (first results) results))))
