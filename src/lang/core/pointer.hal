(ns lang.core.pointer
  (:require [lang.base.emit-common :as common]
    [std.lib.context.pointer]
    [lang.core.library :as lib]
    [lang.core.impl :as impl]
    [lang.core.library-snapshot :as snap]
    [lang.base.book :as book]
    [lang.base.book-module :as module]
    [lang.base.util :as ut]))

(defn default-rt-wrap [f] (fn [rt input] (f rt input)))

;; controls whether to copy a form
(def ^:dynamic *clip* nil)

;; controls whether to copy a form
(def ^:dynamic *rt-wrap* #'default-rt-wrap)

;; controls whether to print a form
(def ^:dynamic *print* #{})

;; controls whether to shortcut at the input string
(def ^:dynamic *input* #{})

;; controls returning the raw output
(def ^:dynamic *output* #{:full})

(defmacro with:clip
  "form to control `clip` option"
  {:added "4.0"}
  [& body]
  (apply list 'binding ['lang.core.pointer/*clip* true] body))

(defmacro ^{:style/indent 0} with:print
  "form to control `print` option"
  {:added "4.0"}
  [& body]
  (let [[params & body] (if (and
                              (vector? (first body))
                              (not-empty (first body)))
                          body
                          (cons #{:input} body))]
    (apply
      list
      'binding
      ['lang.core.pointer/*print* (set params)]
      body)))

(defmacro ^{:style/indent 0} with:print-all
  "toggles print for all intermediate steps"
  {:added "4.0"}
  [& body]
  (apply
    list
    'binding
    ['lang.core.pointer/*print* #{:input-form :raw-output :raw-input}]
    body))

(defmacro with:rt-wrap
  "wraps an additional function to the invoke function"
  {:added "4.0"}
  [[f] & body]
  (apply list 'binding ['lang.core.pointer/*rt-wrap* f] body))

(defmacro with:rt "forcibly applies a runtime" {:added "4.0"} [[rt] & body] (apply list (quote binding) [(quote std.lib.context.pointer/*runtime*) rt] body))

(defmacro ^{:style/indent 0} with:input
  "form to control `input` option"
  {:added "4.0"}
  [& body]
  (let [[params & body] (if (and
                              (vector? (first body))
                              (not-empty (first body)))
                          body
                          (cons #{:default} body))]
    (apply
      list
      'binding
      ['lang.core.pointer/*input* (set params)]
      body)))

(defmacro with:raw
  "form to control `raw` option"
  {:added "4.0"}
  [& body]
  (apply list 'binding ['lang.core.pointer/*output* #{:raw}] body))

(defn get-entry
  "gets the library entry given pointer"
  {:added "4.0"}
  [{:as ptr :keys [lang id module section library runtime]}]
  (let [library (or library (impl/runtime-library))] (lib/get-entry library ptr)))

;;
;;
;;

(defn ptr-tag
  "creates a tag for the pointer"
  {:added "4.0"}
  [ptr tag]
  (vec (cons tag [(ut/sym-full ptr) (:section ptr)])))

(defn free-form
  "normalizes free-pointer body forms into a canonical pointer form"
  {:added "4.1"}
  [body]
  (let [forms (if (vector? body) body (vec body))]
    (case (count forms)
      0 '(do)
      1 (first forms)
      (apply list 'do forms))))

(defn free-form-body
  "returns the body forms for a canonical free-pointer form"
  {:added "4.1"}
  [form]
  (cond
    (nil? form) []
    (and (form? form) (= 'do (first form))) (rest form)
    :else [form]))

(defn ptr-deref
  "gets the entry or the free pointer data"
  {:added "4.0"}
  [ptr]
  (let [{:keys [lang module id]} ptr]
    (if (and lang module id) (get-entry ptr) (into {} ptr))))

(defn ptr-display
  "emits the display string for pointer"
  {:added "4.0"}
  [{:as ptr :keys [lang form id module section library]} meta]
  (let [library (or library (impl/runtime-library))
        meta    (assoc meta :lang lang :module module :library library)]
    (cond form
      (impl/emit-str form meta)
      (not id)
      (cond-> "<free" module (str ":" module) :then (str ">"))
      :else
      (let [entry (cond-> (get-entry ptr)
                    (not= :fragment section) (or (book/get-code-entry-view (lib/get-book library lang) (ut/sym-full ptr))))]
        (cond (nil? entry)
          (str (ptr-tag ptr :not-found))
          (= :fragment section)
          (let [{:keys [form standalone template]} entry]
            (cond (form? standalone)
              (str/trim (pretty/pprint-str (second standalone)))
              (symbol? form)
              (str form)
              (not template)
              (impl/emit-str form meta)
              :else
              (let [args (second form)]
                (str/trim (pretty/pprint-str (or (try (list (quote fn:>)
                                                        args
                                                        (apply (if (= (type template) :std.native.Var) (deref template) template) args))
                                                   (catch error nil))
                                               form))))))
          :else
          (impl/emit-entry entry meta))))))

(defn ptr-invoke-meta
  "prepares the meta for a pointer"
  {:added "4.0"}
  [{:keys [library] :as ptr} {:keys [module
                                        emit]
                                 :as meta}]
  (let [lang     (or (:lang meta)
                     (:lang ptr))
        library  (or library (impl/runtime-library))
        snapshot (cond-> (lib/get-snapshot library)
                   module (-> (snap/set-module module) second)) 
        book     (snap/get-book snapshot lang)
        module   (module/resolve-module-view
                  book
                  (or module
                      (:module ptr)))

        module   (if-let [internal (-> emit :runtime :module/internal)]
                   (-> module
                       (update :link merge (transpose internal))
                       (update :internal merge internal))
                    module)]
    (assoc meta
            :lang lang
            :book book
            :snapshot snapshot
            :module module)))

(defn rt-macro-opts
  "creates the default macro-opts for a runtime"
  {:added "4.0"}
  [lang-or-runtime]
  (let [{:keys [lang module] :as rt} (if (keyword? lang-or-runtime)
                                       (ut/lang-rt lang-or-runtime)
                                       lang-or-runtime)]
    (ptr-invoke-meta (ut/lang-pointer lang
                                      {:module module})
                     (select-keys rt [:lang :layout :emit]))))

(defn ptr-invoke-string
  "emits the invoke string"
  {:added "4.0"}
  [ptr args meta]
  (let [meta (ptr-invoke-meta ptr meta)]
    (binding [impl/*print-form* (:input-form *print*)]
      (cond (:form ptr)
            (impl/emit-str (:form ptr) meta)

            (:id ptr)
            (let [entry (-> (snap/get-book (:snapshot meta)
                                           :lang)

                             (book/get-base-entry (:module ptr)
                                                 (:id ptr)
                                                 (:section ptr)))]
              (if (= :defrun (:op-key entry))
                (impl/emit-str (apply list 'do (drop 2 (:form @ptr))) meta)
               (impl/emit-str (apply list ptr args) meta)))

            :else
            (impl/emit-str (with-meta (vec args)
                             {:bulk true})
                           meta)))))

(defn ptr-invoke-script
  "emits a script with dependencies"
  {:added "4.0"}
  [ptr args meta]
  (let [meta (ptr-invoke-meta ptr (merge {:layout :full}
                                         meta))]
    (binding [impl/*print-form* (:input-form *print*)]
      (cond (:form ptr)
            (impl/emit-script (:form ptr) meta)

            (:id ptr)
            (if (= :defrun (:op-key @ptr))
              (impl/emit-script (apply list 'do (drop 2 (:form @ptr))) meta)
              (impl/emit-script (apply list ptr args) meta))

            :else
            (impl/emit-script (with-meta (vec args)
                                {:bulk true})
                              meta)))))

(defn ptr-intern
  "interns the symbol into the workspace environment"
  {:added "4.0"}
  [ns name {:keys [lang id module section form template standalone] :as m}]
  (let [ks [:lang :id :module :section]
        ptr (ut/lang-pointer lang (select-keys m ks))]
    (intern ns name ptr)))

(defn ptr-output-json
 "Decodes a wire return envelope; raw values use native Result."
 {:added "4.0"}
 ([out] (ptr-output-json out nil))
 ([out {:keys [preserve-errors preserve-payload]}]
  (let [kind (if (map? out) (get out "type") nil)
        kind (if (coll? kind) (first kind) kind)
        value (if (map? out) (get out "value") nil)
        decoded
        (case kind
         "data" (if preserve-payload out value)
         "raw" (if preserve-payload out
                 (Result/create :success value
                   {:type (get out "return") :payload out}))
         "error" (if preserve-errors out
                   (throw (ex :runtime/output
                            (if (map? value) value
                              {:err (vec (filter not-empty (str/split-lines (str value))))})
                            :ex/message "")))
         out)]
   (when (*print* :output) (println decoded))
   decoded)))

(defn ptr-output
 "Decodes runtime output, preserving undecodable text in a native Result."
 {:added "4.0"}
 ([out json] (ptr-output out json nil))
 ([out json opts]
  (cond
   (*output* :raw) out
   (or (= (type json) :std.native.Var) (function? json))
   (let [decode (if (= (type json) :std.native.Var) (deref json) json)]
    (decode out))
   :else
   (let [out (if (= json :string)
               (str (if (result? out) (deref out) out))
               out)]
    (if (and (string? out) json)
      (let [decoded (try (Json/read out)
                        (catch error
                          (Result/create :success out {:format :text})))]
       (if (*output* :json) decoded
         (if (and (= json :full) (not (result? decoded)))
           (ptr-output-json decoded opts)
           decoded)))
      out)))))

(defn ptr-invoke
  "invokes the pointer"
  {:added "4.0"}
  [rt raw-eval body main json]
  (let [in-fn (fn [body]
                (if-let [callback (:in main)]
                  ((if (= (type callback) :std.native.Var)
                     (deref callback)
                     callback)
                    body)
                  body))
        out-fn (fn [body]
                 (if-let [callback (:out main)]
                   ((if (= (type callback) :std.native.Var)
                      (deref callback)
                      callback)
                     body)
                   body))
        _ (when *clip*
            (OS/clipboard-copy
              (if (string? body) body (pretty/pprint-str body))))
        _ (when (*print* :input) (println body))]
    (cond
      (not-empty *input*) (cond-> body (*input* :raw) in-fn)
      :else (let [input (in-fn body)
                  _ (when (*print* :raw-input)
                      (println
                        "\n"
                        (str/join
                          "\n"
                          (map-indexed
                            (fn [i line]
                              (str
                                " "
                                (str/pad-left (str (inc i)) 2 "0")
                                "  "
                                line))
                            (str/split-lines input)))
                        "\n"))
                  raw-eval (if *rt-wrap*
                             ((if (= (type *rt-wrap*) :std.native.Var)
                                (deref *rt-wrap*)
                                *rt-wrap*)
                               raw-eval)
                             raw-eval)
                  raw (try
                        (out-fn (raw-eval rt input))
                        (catch
                          t
                          (do
                            (when common/*explode*
                              (println :OUTPUT-ERROR t))
                            (throw t))))
                  _ (when (*print* :raw-output)
                      (try
                        (let [data (Json/read raw)
                              type (get data "type")
                              value (get data "value")]
                          (cond
                            (= type "error") (doseq
                                               [[k v] value]
                                               (println
                                                 (str k ":\n" v)))))
                        (catch t (do (println raw)))))
                  output (ptr-output
                           raw
                           json
                           {:preserve-payload
                            (or
                              (when (and
                                      (associative? rt)
                                      (not (sequential? rt)))
                                (get rt :output/preserve-payload))
                              (let [runtime-options
                                    (when
                                      (and
                                        (associative? rt)
                                        (not (sequential? rt)))
                                      rt)
                                    process-options
                                    (:process runtime-options)]
                                (when
                                  (and
                                    (associative? process-options)
                                    (not
                                      (sequential? process-options)))
                                  (get
                                    process-options
                                    :output/preserve-payload)))),
                            :preserve-errors
                            (or
                              (when (and
                                      (associative? rt)
                                      (not (sequential? rt)))
                                (get rt :output/preserve-errors))
                              (let [runtime-options
                                    (when
                                      (and
                                        (associative? rt)
                                        (not (sequential? rt)))
                                      rt)
                                    process-options
                                    (:process runtime-options)]
                                (when
                                  (and
                                    (associative? process-options)
                                    (not
                                      (sequential? process-options)))
                                  (get
                                    process-options
                                    :output/preserve-errors))))})]
              output))))
