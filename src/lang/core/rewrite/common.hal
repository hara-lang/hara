(ns lang.core.rewrite.common (:config {:role :internal}))

(defn with-form-meta
  [source out]
  (if (satisfies? IObjType out) (with-meta out (meta source)) out))

(defn stable-symbol
  "returns a deterministic generated symbol for a source form"
  [prefix form]
  (let [source [(select-keys (or (meta form) {}) [:file :line :column])
                form]
        suffix (bit-and (hash source) 4294967295)]
    (symbol (str prefix suffix))))
