;; ============================================================================
;; lang.core.script-annex — tagged, reversible runtime contexts.
;;
;; The archive annex owned an independent runtime per source namespace and tag.
;; This native port retains that geometry while compiling forms through the
;; selected language book and the current IContext lifecycle.
;; ============================================================================
(ns lang.core.script-annex
  (:require [lang.core.library :as library]
            [lang.core.runtime :as runtime]
            [lang.core.script :as script]
            [std.lib.component :as component]))

(defstruct RuntimeAnnex [id library state])

(def +annexes+ (atom {}))

(defn current-namespace-symbol
  []
  (symbol (str (ns-current))))

(defn coordinate
  [namespace tag]
  [namespace tag])

(defn annex?
  "Returns true when value owns one child Library and tagged runtime state."
  [value]
  (instance? lang.core.script-annex/RuntimeAnnex value))

(defn annex-create
  "Creates one namespace-owned RuntimeAnnex inheriting the default Library."
  [namespace]
  (lang.core.script-annex/RuntimeAnnex
   namespace
   (library/library-create {:id [:annex namespace]
                            :parent (library/default-library)})
   (atom {:registry {} :runtimes {}})))

(defn annex-existing
  "Returns one existing namespace-owned RuntimeAnnex without creating state."
  [namespace]
  (get (deref +annexes+) namespace))

(defn annex-in
  "Returns one namespace-owned RuntimeAnnex, creating it exactly once."
  [namespace]
  (let [current (annex-existing namespace)]
    (if current
      current
      (let [created (annex-create namespace)]
        (swap! +annexes+
               (fn [annexes]
                 (if (get annexes namespace)
                   annexes
                   (assoc annexes namespace created))))
        (annex-existing namespace)))))

(defn annex-library-in
  "Returns the namespace-owned child Library, inheriting the default Library."
  [namespace]
  (:library (annex-in namespace)))

(defn annex-library
  "Returns the child Library owned by the current source namespace."
  []
  (annex-library-in (current-namespace-symbol)))

(defn annex-snapshot
  "Captures tagged runtime registration and live-runtime state."
  []
  (let [annexes (deref +annexes+)]
    {:registry
     (reduce-kv
      (fn [output namespace current]
        (reduce-kv (fn [output tag record]
                     (assoc output (coordinate namespace tag) record))
                   output
                   (:registry (deref (:state current)))))
      {}
      annexes)
     :runtimes
     (reduce-kv
      (fn [output namespace current]
        (reduce-kv (fn [output tag instance]
                     (assoc output (coordinate namespace tag) instance))
                   output
                   (:runtimes (deref (:state current)))))
      {}
      annexes)
     :libraries
     (reduce-kv (fn [output namespace current]
                  (assoc output namespace
                         (library/library-raw-snapshot (:library current))))
                {}
                annexes)
     :active
     (reduce-kv
      (fn [output namespace current]
        (reduce-kv (fn [output tag instance]
                     (if (component/started? instance)
                       (conj output (coordinate namespace tag))
                       output))
                   output
                   (:runtimes (deref (:state current)))))
      #{}
      annexes)}))

(defn annex-restore!
  "Restores a tagged runtime snapshot, stopping superseded live runtimes."
  [snapshot]
  (let [snapshot (or snapshot {})
        desired-runtimes (or (:runtimes snapshot) {})
        desired-registry (or (:registry snapshot) {})
        active (or (:active snapshot) #{})
        library-snapshots (or (:libraries snapshot) {})
        existing (deref +annexes+)
        namespaces (set (concat (keys library-snapshots)
                                (map first (keys desired-registry))
                                (map first (keys desired-runtimes))))]
    (reduce-kv
     (fn [_ _ current]
       (reduce-kv (fn [_ _ instance]
                    (runtime/rt-stop instance))
                  nil
                  (:runtimes (deref (:state current))))
       (library/library-reset! (:library current)))
     nil
     existing)
    (reset! +annexes+
            (reduce
             (fn [output namespace]
               (let [current (or (get existing namespace)
                                 (annex-create namespace))
                     registry
                     (reduce-kv (fn [output coordinate-value record]
                                  (if (= namespace (first coordinate-value))
                                    (assoc output (second coordinate-value) record)
                                    output))
                                {}
                                desired-registry)
                     runtimes
                     (reduce-kv (fn [output coordinate-value instance]
                                  (if (= namespace (first coordinate-value))
                                    (assoc output (second coordinate-value) instance)
                                    output))
                                {}
                                desired-runtimes)]
                 (library/library-restore! (:library current)
                                            (get library-snapshots namespace))
                 (reset! (:state current) {:registry registry :runtimes runtimes})
                 (assoc output namespace current)))
             {}
             (sort-by str namespaces)))
    (reduce (fn [_ coordinate-value]
              (let [instance (runtime-in (first coordinate-value)
                                         (second coordinate-value))]
                (if instance (runtime/rt-start instance))))
            nil
            active)
    (annex-snapshot)))

(defn annex-reset!
  "Stops and removes all tagged runtime state idempotently."
  []
  (annex-restore! nil))

(defn register-tag-in
  [namespace tag lang runtime-id config]
  (let [current (annex-in namespace)
        previous (get-in (deref (:state current)) [:registry tag])
        record {:namespace namespace
                :tag tag
                :lang lang
                :runtime (or runtime-id :default)
                :config (or config {})}]
    (swap! (:state current) assoc-in [:registry tag] record)
    [previous lang]))

(defn register-tag
  [tag lang runtime-id config]
  (register-tag-in (current-namespace-symbol) tag lang runtime-id config))

(defn deregister-tag-in
  [namespace tag]
  (let [current (annex-existing namespace)
        previous (if current
                   (get-in (deref (:state current)) [:registry tag]))]
    (if current
      (swap! (:state current) update :registry dissoc tag))
    previous))

(defn deregister-tag
  [tag]
  (deregister-tag-in (current-namespace-symbol) tag))

(defn tag-info-in
  [namespace tag]
  (let [current (annex-existing namespace)]
    (if current (get-in (deref (:state current)) [:registry tag]))))

(defn tag-info
  [tag]
  (tag-info-in (current-namespace-symbol) tag))

(defn runtime-in
  [namespace tag]
  (let [current (annex-existing namespace)]
    (if current (get-in (deref (:state current)) [:runtimes tag]))))

(defn get-runtime
  [tag]
  (runtime-in (current-namespace-symbol) tag))

(defn start-runtime
  [lang runtime-id config]
  (script/start-runtime lang runtime-id config))

(defn same-runtime?
  [instance lang runtime-id config]
  (= (select-keys instance [:lang :runtime :layout :emit])
     (select-keys (merge {:lang lang :runtime (or runtime-id :default)}
                         (or config {}))
                  [:lang :runtime :layout :emit])))

(defn add-runtime-in
  [namespace tag instance]
  (let [current (annex-in namespace)
        previous (get-in (deref (:state current)) [:runtimes tag])]
    (if previous (runtime/rt-stop previous))
    (swap! (:state current) assoc-in [:runtimes tag] instance)
    [previous instance]))

(defn remove-runtime-in
  [namespace tag]
  (let [current (annex-existing namespace)
        previous (if current (get-in (deref (:state current)) [:runtimes tag]))]
    (if previous (runtime/rt-stop previous))
    (if current
      (swap! (:state current) update :runtimes dissoc tag))
    previous))

(defn start-tag-in
  [namespace tag]
  (let [record (tag-info-in namespace tag)]
    (if (nil? record)
      (throw (ex :dependency {:namespace namespace :tag tag}
                 :ex/message "Script annex tag is not registered"))
      (let [lang (:lang record)
            runtime-id (:runtime record)
            config (:config record)
            module (or (:module config) namespace)
            previous (runtime-in namespace tag)]
        (if (and previous
                 (same-runtime? previous lang runtime-id
                                (assoc config :module module)))
          [previous previous]
          (let [_ (if previous (runtime/rt-stop previous))
                current (annex-library-in namespace)
                started (library/with:library [current]
                          (script/configure-module lang module config namespace)
                          (script/start-runtime lang runtime-id
                                                (assoc config :module module)))]
            (swap! (:state (annex-in namespace)) assoc-in [:runtimes tag] started)
            [previous started]))))))

(defn start-tag
  [tag]
  (start-tag-in (current-namespace-symbol) tag))

(defn stop-tag-in
  [namespace tag]
  (remove-runtime-in namespace tag))

(defn stop-tag
  [tag]
  (stop-tag-in (current-namespace-symbol) tag))

(defn restart-tag-in
  [namespace tag]
  (do
    (stop-tag-in namespace tag)
    (start-tag-in namespace tag)))

(defn restart-tag
  [tag]
  (restart-tag-in (current-namespace-symbol) tag))

(defn namespace-tags
  [state namespace]
  (reduce-kv
   (fn [out key value]
     (if (= namespace (first key))
       (conj out (second key))
       out))
   #{}
   state))

(defn status-in
  [namespace]
  (let [current (annex-existing namespace)
        state (if current (deref (:state current)) {:registry {} :runtimes {}})]
    {:registered (set (keys (:registry state)))
     :active (set (keys (:runtimes state)))}))

(defn status
  []
  (status-in (current-namespace-symbol)))

(defn start-all-in
  [namespace]
  (reduce (fn [out tag]
            (assoc out tag (start-tag-in namespace tag)))
          {}
          (:registered (status-in namespace))))

(defn start-all
  []
  (start-all-in (current-namespace-symbol)))

(defn stop-all-in
  [namespace]
  (reduce (fn [out tag]
            (assoc out tag (stop-tag-in namespace tag)))
          {}
          (:active (status-in namespace))))

(defn stop-all
  []
  (stop-all-in (current-namespace-symbol)))

(defn restart-all-in
  [namespace]
  (do
    (stop-all-in namespace)
    (start-all-in namespace)))

(defn restart-all
  []
  (restart-all-in (current-namespace-symbol)))

(defn clear-in
  [namespace]
  (do
    (stop-all-in namespace)
    (let [current (annex-existing namespace)]
      (if current
        (library/library-reset! (:library current))))
    (swap! +annexes+ dissoc namespace)
    (status-in namespace)))

(defn clear
  []
  (clear-in (current-namespace-symbol)))

(defn eval-tag-in
  [namespace tag form]
  (let [record (tag-info-in namespace tag)
        instance (runtime-in namespace tag)]
    (if (nil? record)
      (throw (ex :dependency {:namespace namespace :tag tag}
                 :ex/message "Script annex tag is not registered"))
      (if (nil? instance)
        (throw (ex :dependency {:namespace namespace :tag tag}
                   :ex/message "Script annex tag is not started"))
        (let [config (:config record)
              module (or (:module config) namespace)
              source (library/with:library [(annex-library-in namespace)]
                       (script/compile-form (:lang record) module form))]
          (runtime/rt-raw-eval instance source))))))

(defn eval-tag
  [tag form]
  (eval-tag-in (current-namespace-symbol) tag form))

(defn script-ext-form
  [namespace coordinate-value config]
  (let [tag (first coordinate-value)
        lang (second coordinate-value)
        config (or config {})
        runtime-id (or (:runtime config) :default)]
    (list 'do
          (list 'lang.core.script-annex/register-tag-in
                (list 'quote namespace)
                tag
                lang
                runtime-id
                (list 'quote config))
          (list 'lang.core.script-annex/start-tag-in
                (list 'quote namespace)
                tag))))

(defn script-eval-form
  [namespace tag body]
  (if (vector? tag)
    (list 'lang.core.script-annex/eval-tag-in
          (list 'quote namespace)
          (first tag)
          (list 'quote body))
    nil))

(defmacro script+
  [coordinate-value & options]
  (script-ext-form
   (symbol (str (:ns &env)))
   coordinate-value
   (if (empty? options) {} (first options))))

(defmacro !
  [tag body]
  (script-eval-form
   (symbol (str (:ns &env)))
   tag
   body))

;; Archive lang.core convenience surface, kept here so lang.core stays a
;; publication-only facade under the current namespace-role geometry.
(defn annex:start
  ([tag] (start-tag tag))
  ([tag namespace] (start-tag-in namespace tag)))

(defn annex:get
  ([tag] (get-runtime tag))
  ([tag namespace] (runtime-in namespace tag)))

(defn annex:stop
  ([tag] (stop-tag tag))
  ([tag namespace] (stop-tag-in namespace tag)))

(defn annex:start-all
  ([] (start-all))
  ([namespace] (start-all-in namespace)))

(defn annex:stop-all
  ([] (stop-all))
  ([namespace] (stop-all-in namespace)))

(defn annex:restart-all
  ([] (restart-all))
  ([namespace] (restart-all-in namespace)))

(defn annex:list
  ([] (status))
  ([namespace] (status-in namespace)))
