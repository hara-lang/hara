(ns lang.core.script-annex
  (:config {:role :internal})
  (:require [lang.core.impl :as impl]
            [lang.core.registry :as sreg]
            [lang.core.library :as lib]
            [lang.core.library-snapshot :as snap]
            [lang.base.util :as ut]
            [std.lib.component :as component]
            [std.lib.context.registry :as reg]
            [std.lib.context.space :as space]
            [std.lib.context.resource :as resource]))

(defn rt-annex-string
  "returns the annex string"
  {:added "4.0"}
  ([{:keys [runtimes]}]
    (str
      "#lang.annex "
      (vec
        (sort
          (map (fn [[k rt]] [k (:lang rt)]) (seq (deref runtimes))))))))

(do
  (defstruct ^{:open true} RuntimeAnnex [id registry runtimes library])
  (extend-type
    RuntimeAnnex
    IDisplay
    (display [annex] (rt-annex-string annex))))

(defn rt-annex?
  "checks that object is an annex"
  {:added "4.0"}
  ([obj]
   (instance? RuntimeAnnex obj)))

(defn rt-annex:create
  "creates an annex object
   
   
   (annex/rt-annex:create {})
   => annex/rt-annex?"
  {:added "4.0"}
  ([{:keys [id] :as m}]
   (let [runtimes (atom {})
         registry (atom {})
         library  (lib/library {:parent #'impl/default-library})]
     (map->RuntimeAnnex (merge m {:library library
                                  :registry registry
                                  :runtimes runtimes})))))

(def +init-annex+
 [(resource/spec-add
    {:type :tahto/lang.rt.annex,
     :config {},
     :instance
     {:create rt-annex:create, :setup identity, :teardown identity}})
  (reg/registry-install
    :lang.annex
    {:config {}, :rt {:default {:resource :tahto/lang.rt.annex}}})])



(defn annex-current
  "gets the current annex. May not exist\n \n   (annex/annex-current)\n   => any?"
  {:added "4.0"}
  ([] (annex-current (ns-current)))
  ([ns]
    (let [{:keys [state], :as sp} (space/space ns)
          rec (:lang.annex (deref state))]
      (if rec (:instance rec)))))

(defn annex-reset
  "resets the current annex"
  {:added "4.0"}
  ([] (annex-reset (ns-current)))
  ([ns]
    (let [sp (space/space ns)]
      (let [previous-instance (:instance
                                (get (deref (:state sp)) :lang.annex))]
        (std.lib.context.space/space:rt-stop sp :lang.annex)
        previous-instance))))

(defn get-annex
  "gets the current annex in the namespace"
  {:added "4.0"}
  ([] (get-annex (ns-current)))
  ([ns]
    (let [{:keys [state], :as sp} (space/space ns)
          check (or
                  (:lang.annex (deref state))
                  (space/space:context-set
                    sp
                    :lang.annex
                    :default
                    {}))]
      (space/space:rt-start sp :lang.annex))))

(defn clear-annex
  "clears all runtimes in the annex"
  {:added "4.0"}
  ([] (clear-annex (ns-current)))
  ([ns]
    (let [{:keys [runtimes]} (get-annex ns)]
      (swap-return!
        runtimes
        (fn [m] [(map-vals
                   (fn [value]
                     (if (Base/supports-method? IComponent 'stop value)
                       (std.lib.component/stop value)
                       value))
                   m)
                 {}])))))

(defn get-annex-library
  "gets the current annex library
 
   (annex/get-annex-library (h/ns-sym))
   => lib/library?"
  {:added "4.0"}
  ([ns]
   (:library (get-annex ns))))

(defn get-annex-book
  "gets the current book in the annex\n  \n   (annex/get-annex-book (h/ns-sym) :lua)\n   => book/book?"
  {:added "4.0"}
  ([ns lang]
    (let [curr (:library (get-annex ns))]
      (or
        (snap/get-book (deref (:instance curr)) lang)
        (let [default-lib (impl/default-library)
              book (or
                     (lib/get-book default-lib lang)
                     (do
                       (when-let [book-ns (sreg/registry-book-ns lang)]
                         (eval (list 'require (list 'quote book-ns))))
                       (lib/get-book default-lib lang))
                     (throw
                       (ex
                         :lang/script-annex
                         {:lang lang,
                          :available
                          (map first (sreg/registry-book-list))}
                         :ex/message
                         "Book not found")))]
          (lib/add-book! curr (assoc book :modules {})))))))

(defn add-annex-runtime
  "adds a runtime to the annex"
  {:added "4.0"}
  [ns tag rt]
  (let [{:keys [registry runtimes]} (get-annex ns)]
    (swap-return!
      runtimes
      (fn [m]
        (let [curr (get m tag)
              _ (if curr
                  ((fn [value]
                     (if (Base/supports-method? IComponent 'stop value)
                       (std.lib.component/stop value)
                       value))
                    curr))]
          [[curr rt] (assoc m tag rt)])))))

(defn get-annex-runtime
  "gets the annex rutime"
  {:added "4.0"}
  [ns tag]
  (let [{:keys [runtimes]} (get-annex ns)] (get (deref runtimes) tag)))

(defn remove-annex-runtime
  "removes the annex runtime"
  {:added "4.0"}
  [ns tag]
  (let [{:keys [runtimes]} (get-annex ns)]
    (swap-return!
      runtimes
      (fn [m]
        (let [curr (get m tag)
              _ (if curr
                  ((fn [value]
                     (if (Base/supports-method? IComponent 'stop value)
                       (std.lib.component/stop value)
                       value))
                    curr))]
          [curr (dissoc m tag)])))))

(defn register-annex-tag
  "registers a config for the tag"
  {:added "4.0"}
  [ns tag lang runtime config]
  (let [{:keys [registry]} (get-annex ns)]
    (swap-return!
      registry
      (fn [m] [[(get m tag) lang]
               (assoc
                 m
                 tag
                 {:lang lang, :runtime runtime, :config config})]))))

(defn deregister-annex-tag
  "removes the config for the tag"
  {:added "4.0"}
  [ns tag]
  (let [{:keys [registry]} (get-annex ns)]
    (swap-return! registry (fn [m] [(get m tag) (dissoc m tag)]))))

(defn start-runtime
  "starts the runtime in the annex"
  {:added "4.0"}
  [lang runtime config]
  (let [ctx (ut/lang-context lang)
        {:keys [resource], :as reg} (reg/registry-rt ctx runtime)
        spec (resource/spec-get resource)
        {:keys [instance]} spec]
    (-> ((:create instance)
          (merge (:config reg) {:lang lang, :runtime runtime} config))
     ((:setup instance)))))

(defn same-runtime?
  "checks that one runtime is the same as another"
  {:added "4.0"}
  [rt lang runtime config]
  (let [ctx (ut/lang-context lang)
        reg (reg/registry-rt ctx runtime)
        ckeys [:lang :runtime :layout :emit]
        new-conf (-> (merge (:config reg)
                            {:lang lang
                             :runtime runtime}
                            config)
                     (select-keys ckeys))
        old-conf (select-keys rt ckeys)]
    (= new-conf old-conf)))
