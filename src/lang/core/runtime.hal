(ns lang.core.runtime
  (:config {:role :internal})
  (:require [lang.core.runtime-proxy :as proxy]
            [lang.core.pointer :as ptr]
            [lang.base.util :as ut]
            [std.lib.context.registry :as reg]
            [std.lib.context.resource :as resource]
            [lang.core.impl :as impl]
            [lang.core.library :as lib]
            [lang.core.library-snapshot :as snap]
            [lang.base.book-module :as book-module]
            [lang.core.impl-lifecycle :as lifecycle]
            [lang.base.emit-common :as common]
            [lang.core.impl-deps :as deps]
            [lang.base.book :as book]))

(defn default-tags-ptr
  "runtime default args"
  {:added "4.0"}
  [rt ptr]
  (ptr/ptr-tag ptr (:runtime rt)))

(defn default-deref-ptr
  "runtime default deref"
  {:added "4.0"}
  [{:as rt :keys [library]} ptr]
  (ptr/ptr-deref (assoc (into {} ptr) :library library)))

(defn default-invoke-ptr
  "runtime default invoke"
  {:added "4.0"}
  [{:as rt :keys [id library layout emit]} ptr args]
  (ptr/ptr-invoke-string ptr
    args
    {:library library
     :layout  layout
     :emit    (merge emit
                     {:transform (fn [args {:as mopts :keys [bulk]}]
                                     (if bulk (if (vector? args) (apply list (quote do) args) args) args))
                      :runtime   (assoc rt :type (:runtime rt) :namespace (ns-current))})}))

(defn default-init-ptr
  "will init pointer if there is a :rt/init key"
  {:added "4.0"}
  [{:as rt :keys [id lang library layout module emit]} entry]
  (when (and (#{:defglobal :defrun} (:op-key entry)) (:rt/init entry))
    (IContextEval/invoke-ptr rt
      (ut/lang-pointer lang {:module module})
      [(:form-input entry)])))

(do
  (defstruct ^{:open true} RuntimeDefault [lang redirect])
  (extend-type
    RuntimeDefault
    IContextEval
    (evaluate-raw
      [rt string options]
      (let [{:keys [redirect lang]} rt]
        (if redirect
          (proxy/proxy-raw-eval rt string)
          (default-raw-eval rt string))))
    (tags-ptr
      [rt ptr]
      (let [{:keys [redirect lang]} rt]
        (if redirect
          (proxy/proxy-tags-ptr rt ptr)
          (default-tags-ptr rt ptr))))
    (deref-ptr
      [rt ptr]
      (let [{:keys [redirect lang]} rt]
        (if redirect
          (proxy/proxy-deref-ptr rt ptr)
          (default-deref-ptr rt ptr))))
    (display-ptr
      [rt ptr]
      (let [{:keys [redirect lang]} rt]
        (if redirect
          (proxy/proxy-display-ptr rt ptr)
          (default-display-ptr rt ptr))))
    (invoke-ptr
      [rt ptr args]
      (let [{:keys [redirect lang]} rt]
        (if redirect
          (proxy/proxy-invoke-ptr rt ptr args)
          (default-invoke-ptr rt ptr args))))
    (transform-in-ptr
      [rt ptr args]
      (let [{:keys [redirect lang]} rt]
        (if redirect
          (proxy/proxy-transform-in-ptr rt ptr args)
          (default-transform-in-ptr rt ptr args))))
    (transform-out-ptr
      [rt ptr return]
      (let [{:keys [redirect lang]} rt]
        (if redirect
          (proxy/proxy-transform-out-ptr rt ptr return)
          (default-transform-out-ptr rt ptr return)))))
  (extend-type
    RuntimeDefault
    IContextLifeCycle
    (setup-ptr
      [rt ptr]
      (let [{:keys [redirect lang]} rt]
        (if redirect
          (proxy/proxy-init-ptr rt ptr)
          (default-init-ptr rt ptr)))))
  (extend-type
    RuntimeDefault
    IComponent
    (start
      [component]
      (let [{:keys [redirect lang]} component]
        (if redirect
          (let [rt (proxy/proxy-get-rt redirect lang)
                _ (reduce-kv
                    (fn [_ module shortcut]
                      (when (not= module redirect)
                        (try
                          (eval
                            (list
                              'require
                              (list 'quote [module :as shortcut])))
                          (catch error nil))))
                    nil
                    (or (:module/internal rt) {}))]
            component)
          component)))
    (stop
      [component]
      (let [{:keys [redirect lang]} component] component))
    (kill
      [component]
      (let [{:keys [redirect lang]} component] component))
    (started?
      [component]
      (let [{:keys [redirect lang]} component]
        (if redirect (proxy/proxy-started? component) true)))
    (stopped?
      [component]
      (let [{:keys [redirect lang]} component]
        (if redirect (proxy/proxy-stopped? component) true)))
    (info
      [component level]
      (let [{:keys [redirect lang]} component]
        (if redirect (proxy/proxy-info component level) {})))
    (remote?
      [component]
      (let [{:keys [redirect lang]} component]
        (if redirect (proxy/proxy-remote? component) false)))
    (health
      [component]
      (let [{:keys [redirect lang]} component]
        (if redirect (proxy/proxy-health component) true))))
  (extend-type
    RuntimeDefault
    IDisplay
    (display [component] (rt-default-string component))))

(defn rt-default-string [{:keys [lang]}] (str "#rt:lang" [lang]))

(defn rt-default
  "creates a lang runtime"
  {:added "4.0"}
  [{:as m :keys [lang runtime]}]
  (map->RuntimeDefault (merge m {:runtime :default})))

(defn rt-default?
  "checks if object is default runtime"
  {:added "4.0"}
  [obj]
  (instance? RuntimeDefault obj))

(defn rt-null
  "creates a default null runtime"
  {:added "4.0"}
  [m]
  (rt-default (assoc m :lang :null)))

(defn install-lang!
  "installs a language within `std.lib.context`"
  {:added "4.0"}
  [lang & [options]]
  (let [ctx   (ut/lang-context lang)]
    (reg/registry-install
     ctx
     {:config {:context ctx :lang lang}
      :scratch (rt-default {:context ctx :lang lang
                            :options (or options
                                         {})})
      :rt  {:default {:resource :tahto/lang.rt}}})))

(def default-raw-eval
  (fn [_ string] string))

(def default-transform-in-ptr
  (fn [_ _ args] args))

(def default-transform-out-ptr
  (fn [_ _ return] return))

(defn return-format-simple
  "format forms for return"
  {:added "4.0"}
  [forms]
  (concat (butlast forms)
          [(list 'return (last forms))]))

(defn return-format
  "standard format for return"
  {:added "4.0"}
  [forms & [opts]]
  (let [v (last forms)
        v (if (and
                (form? v)
                ((union '#{:- return break var := throw} opts)
                  (first v)))
            v
            (list 'return v))]
    (concat (butlast forms) [v])))

(defn return-wrap-invoke
  "wraps forms to be invoked"
  {:added "4.0"}
  [forms]
  (list (list 'quote (list (apply list 'fn [] forms)))))

(defn normalize-body-forms
  "normalizes runtime eval input into a flat sequence of body forms"
  {:added "4.1"}
  [input {:keys [bulk] :as mopts}]
  (if bulk
    input
    (ptr/free-form-body input)))

(defn return-transform
  "standard return transform"
  {:added "4.0"}
  [input {:keys [bulk], :as mopts} & [{:keys [wrap-fn format-fn]}]]
  (let [forms (normalize-body-forms input mopts)
        wrap-fn (or wrap-fn return-wrap-invoke)
        format-fn (or format-fn return-format)]
    (wrap-fn (format-fn forms))))

(resource/spec-add
  {:type :tahto/lang.rt,
   :config {:bootstrap false},
   :instance {:create rt-default}})

(resource/spec-add
  {:type :tahto/context.rt.null, :instance {:create rt-null}})

(intern 'std.lib.context.registry '+rt-null+ (rt-null reg/+null+))

(defn install-type!
  "installs a specific runtime type given `:lang`"
  {:added "4.0"}
  [lang runtime {:as spec :keys [type config]}]
  (let [ctx    (ut/lang-context lang)
        spec   (dissoc spec :config)
        config (merge {:runtime runtime} config)
        r-spec (when (or (not (try (resource/spec-get type) (catch error nil)))
                       (seq (dissoc spec :type)))
                 (resource/spec-add spec))
        r-ctx  (reg/registry-rt-add ctx {:config config :key runtime :resource type})]
    {:context r-ctx :spec r-spec}))

(defn default-lifecycle-prep
  "prepares mopts for lifecycle"
  {:added "4.0"}
  [{:keys [id layout lang module library lifecycle emit], :as rt}]
  (let [library (or library (impl/runtime-library))
        module-id module
        [snapshot book module] (loop
                                 [snapshot (lib/get-snapshot library)
                                  book (snap/get-book snapshot lang)
                                  module
                                  (get-in book [:modules module-id])]
                                 (let
                                   [missing
                                    (when
                                      module
                                      (->>
                                        (book-module/module-deps-code
                                          book
                                          module)
                                        (remove
                                          (fn
                                            [dependency]
                                            (get-in
                                              book
                                              [:modules dependency])))
                                        seq))]
                                   (if
                                     (seq missing)
                                     (do
                                       (impl/with:library
                                         [library]
                                         (doseq
                                           [dep missing]
                                           (eval
                                             (list
                                               'require
                                               (list 'quote dep)))))
                                       (let
                                         [snapshot
                                          (lib/get-snapshot library)
                                          book
                                          (snap/get-book
                                            snapshot
                                            lang)]
                                         (recur
                                           snapshot
                                           book
                                           (get-in
                                             book
                                             [:modules module-id]))))
                                     [snapshot book module])))]
    (merge
      {:layout layout,
       :book book,
       :lang lang,
       :snapshot snapshot,
       :module module,
       :emit
       (assoc
         (or emit {})
         :runtime
         {:id id,
          :lang (:lang rt),
          :type (:runtime rt),
          :module (:module rt),
          :namespace (ns-current)})}
      lifecycle)))

(defn default-setup-module-emit
  "emits the string for the module"
  {:added "4.0"}
  [rt module-id]
  (let [{:keys [book], :as meta, setup :rt/setup} (default-lifecycle-prep
                                                    rt)]
    (lifecycle/emit-module-setup
      module-id
      (update
        meta
        :emit
        (fn [existing additions]
          (letfn
            [(merge-values
               [left right]
               (if (and (nil? left) (nil? right))
                 nil
                 (reduce-kv
                   (fn [out key value]
                     (let [previous (get out key)]
                       (assoc
                         out
                         key
                         (if (and
                               (has? out key)
                               (or (map? previous) (nil? previous))
                               (or (map? value) (nil? value)))
                           (merge-values previous value)
                           value))))
                   (or left {})
                   (or right {}))))]
            (merge-values additions existing)))
        setup))))

(defn multistage-invoke
  "invokes a multistage pipeline given deps function"
  {:added "4.0"}
  [rt module-id module-fn deps-fn]
  (let [{:keys [book], :as meta} (default-lifecycle-prep rt)
        module-ids ((if (= (type deps-fn) :std.native.Var)
                      (deref deps-fn)
                      deps-fn)
                     book
                     module-id)]
    (mapv
      (fn [module-id] [module-id
                       ((if (= (type module-fn) :std.native.Var)
                          (deref module-fn)
                          module-fn)
                         rt
                         module-id
                         meta)])
      module-ids)))

(defn default-display-ptr
  "runtime default display"
  {:added "4.0"}
  [{:as rt :keys [lang library module emit]} ptr]
  (cond (#{:defglobal} (:op-key (std.foundation/deref ptr)))
    (let [body (impl/emit-as lang [(ut/sym-full ptr)] {:emit emit :layout :full})]
      (ptr/ptr-invoke rt
        (fn [runtime body] (IContextEval/evaluate-raw runtime body {}))
        body
        (:main emit)
        (or (:json emit) :full)))
    (= :xtalk lang)
    (let [entry (ptr/ptr-deref (assoc (into {} ptr) :library library))]
      (cond (:form entry)
        (pretty/pprint-str (:form entry))
        (:form-input entry)
        (pretty/pprint-str (:form-input entry))
        :else
        (ptr/ptr-display ptr {:emit emit :library library})))
    :else
    (ptr/ptr-display ptr {:emit emit :library library})))

(defn default-invoke-script
  "default invoke script call used by most runtimes"
  {:added "4.0"}
  [{:keys [id
           lang
           library
           layout]
    :as rt}
   ptr
   args
   f
   {:keys [json
           main
           emit]
    :or {json :full}
    :as params}]
  (let [emit (merge-nested emit (:emit rt))
        emit (assoc emit
                    :input   {:args args :pointer ptr}
                    :runtime (assoc rt :type (:runtime rt) :namespace (ns-current)))
        _    (if common/*trace* (println emit params))
        body (ptr/ptr-invoke-script ptr
                                    args
                                    {:emit emit :lang lang :layout (or (:layout params) layout) :library library})]
    (ptr/ptr-invoke rt f body main json)))

(defn default-scaffold-setup-for
  "setup native modules, defglobals and defruns in the runtime"
  {:added "4.0"}
  [rt module-id]
  (let [meta (default-lifecycle-prep rt)
        body (impl/emit-scaffold-for module-id meta)]
    (ptr/ptr-invoke
      rt
      (fn [runtime body] (IContextEval/evaluate-raw runtime body {}))
      body
      (:main meta)
      (:json meta))))

(defn default-scaffold-setup-to
  "setup scaffold up to but not including the current module in the runtime"
  {:added "4.0"}
  [rt module-id]
  (let [meta (default-lifecycle-prep rt)
        body (impl/emit-scaffold-to module-id meta)]
    (ptr/ptr-invoke
      rt
      (fn [runtime body] (IContextEval/evaluate-raw runtime body {}))
      body
      (:main meta)
      (:json meta))))

(defn default-scaffold-imports
  "embed native imports to be globally accessible"
  {:added "4.0"}
  [rt module-id]
  (let [meta (default-lifecycle-prep rt)
        body (impl/emit-scaffold-imports module-id meta)]
    (ptr/ptr-invoke
      rt
      (fn [runtime body] (IContextEval/evaluate-raw runtime body {}))
      body
      (:main meta)
      (:json meta))))

(defn default-lifecycle-fn
  "constructs a lifecycle fn"
  {:added "4.0"}
  [f]
  (fn [rt & args]
    (let [{:keys [book], :as meta} (default-lifecycle-prep rt)
          form (apply f book args)]
      (if form
        (let [body (impl/emit-str form meta)]
          (ptr/ptr-invoke
            rt
            (fn [runtime body]
              (IContextEval/evaluate-raw runtime body {}))
            body
            (:main meta)
            (:json meta)))))))

(def ^{:arglists ([rt module-id])} default-has-module?
 (default-lifecycle-fn deps/has-module-form))

(def ^{:arglists ([rt ptr])} default-has-ptr?
 (default-lifecycle-fn deps/has-ptr-form))

(def ^{:arglists ([rt ptr])} default-setup-ptr
 (default-lifecycle-fn deps/setup-ptr-form))

(def ^{:arglists ([rt ptr])} default-teardown-ptr
 (default-lifecycle-fn deps/teardown-ptr-form))

(defn default-setup-module-basic
  "basic setup module action"
  {:added "4.0"}
  [rt module-id]
  (let [{:keys [book], :as meta, setup :rt/setup} (default-lifecycle-prep
                                                    rt)
        body (lifecycle/emit-module-setup
               module-id
               (update
                 meta
                 :emit
                 (fn [existing additions]
                   (merge-nested additions existing))
                 setup))]
    (ptr/ptr-invoke
      rt
      (fn [runtime body] (IContextEval/evaluate-raw runtime body {}))
      body
      (:main meta)
      (:json meta))))

(defn default-teardown-module-basic
  "basic teardown module action"
  {:added "4.0"}
  [rt module-id]
  (let [{:keys [], :as meta, teardown :rt/teardown} (default-lifecycle-prep
                                                      rt)
        body (lifecycle/emit-module-teardown
               module-id
               (update
                 meta
                 :emit
                 (fn [existing additions]
                   (merge-nested additions existing))
                 teardown))]
    (ptr/ptr-invoke
      rt
      (fn [runtime body] (IContextEval/evaluate-raw runtime body {}))
      body
      (:main meta)
      (:json meta))))

(defn default-scaffold-array [rt arr]
  (reduce
    (fn [acc [k body]]
      (try
        (conj
          acc
          [k
           (ptr/ptr-invoke
             rt
             (fn [runtime body]
               (IContextEval/evaluate-raw runtime body {}))
             body
             nil
             nil)])
        (catch t (do (reduced (conj acc [k body (ex-message t)]))))))
    []
    arr))

(defn default-setup-module
  "default setup module (with error isolation)"
  {:added "4.0"}
  [rt module-id & [meta]]
  (let [{:keys [book], :as meta, setup :rt/setup} (or
                                                    meta
                                                    (default-lifecycle-prep
                                                      rt))
        raw (lifecycle/emit-module-setup-raw
              module-id
              (update
                meta
                :emit
                (fn [existing additions]
                  (merge-nested additions existing))
                setup))
        body (lifecycle/emit-module-setup-join raw)]
    (if (not-empty body)
      (try
        (ptr/ptr-invoke
          rt
          (fn [runtime body]
            (IContextEval/evaluate-raw runtime body {}))
          body
          (:main meta)
          (:json meta))
        (catch
          t
          (do
            (let [arr (lifecycle/emit-module-setup-concat raw)]
              (mapv
                (fn [part]
                  (try
                    (ptr/ptr-invoke
                      rt
                      (fn [runtime body]
                        (IContextEval/evaluate-raw runtime body {}))
                      part
                      (:main meta)
                      (:json meta))
                    (catch
                      t
                      (do
                        (throw
                          (ex
                            :generic
                            {:part (vec (str/split-lines part)),
                             :message
                             (loop [t t c (ex-cause ^Throwable t)]
                               (if
                                 c
                                 (recur c (ex-cause ^Throwable c))
                                 (ex-message ^Throwable t)))}
                            :ex/message
                            "Error at:"))))))
                arr))))))))

(defn default-teardown-module
  "default teardown module (with error isolation)"
  {:added "4.0"}
  [rt module-id & [meta]]
  (let [{:keys [book], :as meta, teardown :rt/teardown} (or
                                                          meta
                                                          (default-lifecycle-prep
                                                            rt))
        raw (lifecycle/emit-module-teardown-raw
              module-id
              (update
                meta
                :emit
                (fn [existing additions]
                  (merge-nested additions existing))
                teardown))
        body (lifecycle/emit-module-teardown-join raw)]
    (if (not-empty body)
      (try
        (ptr/ptr-invoke
          rt
          (fn [runtime body]
            (IContextEval/evaluate-raw runtime body {}))
          body
          (:main meta)
          (:json meta))
        (catch
          t
          (do
            (let [arr (lifecycle/emit-module-teardown-concat raw)]
              (mapv
                (fn [part]
                  (try
                    (ptr/ptr-invoke
                      rt
                      (fn [runtime body]
                        (IContextEval/evaluate-raw runtime body {}))
                      part
                      (:main meta)
                      (:json meta))
                    (catch
                      t
                      (do
                        (throw
                          (ex
                            :generic
                            {:part (vec (str/split-lines part)),
                             :message
                             (loop [t t c (ex-cause ^Throwable t)]
                               (if
                                 c
                                 (recur c (ex-cause ^Throwable c))
                                 (ex-message ^Throwable t)))}
                            :ex/message
                            "Error at:"))))))
                arr))))))))

(defn multistage-setup-for "setup for a given namespace" {:added "4.0"} [rt module-id] (multistage-invoke rt module-id default-setup-module (fn [book module-id] (deps-ordered book [module-id]))))

(defn multistage-setup-to "setup to a given namespcase" {:added "4.0"} [rt module-id] (multistage-invoke rt module-id default-setup-module (fn [book module-id] (butlast (deps-ordered book [module-id])))))

(defn multistage-teardown-for "teardown for a given namespace" {:added "4.0"} [rt module-id] (multistage-invoke rt module-id default-teardown-module (fn [book module-id] (reverse (deps-ordered book [module-id])))))

(defn multistage-teardown-at "teardown all dependents including this" {:added "4.0"} [rt module-id] (multistage-invoke rt module-id default-teardown-module (fn [book module-id] (binding [book/*dep-types* :module] (dependents-ordered book module-id)))))

(defn multistage-teardown-to "teardown all dependents upto this" {:added "4.0"} [rt module-id] (multistage-invoke rt module-id default-teardown-module (fn [book module-id] (binding [book/*dep-types* :module] (butlast (dependents-ordered book module-id))))))
