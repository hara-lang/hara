(ns lang.model.v1.spec-dart.rewrite
  (:config {:role :internal})
  (:require [lang.base.preprocess-base :as preprocess]
            [lang.core.rewrite.conditional :as conditional]
            [lang.core.rewrite.common :as common]
            [lang.core.rewrite.fn :as fnrw]
            [lang.core.rewrite.hoist :as hoist]
            [lang.core.rewrite.statement :as statement]
            [lang.core.rewrite.truthy :as truthy]
            [lang.core.rewrite.unpack :as unpack]
            [lang.core.rewrite.walk :as walk]
            [lang.typed.xtalk-parse :as xtalk-parse]))

(def +dart-rewriter+
  (hoist/create-rewriter
   {:symbol-prefix "dart_callback__"
    :symbol-fn (fn [form] (common/stable-symbol "dart_callback__" form))
    :lambda-compatible? (fn [_ _] true)}))

(def +dart-boolish-ops+
  #{'and 'not 'or '< '<= '== '> '>= 'not=
    'x:eq 'x:neq 'x:lt 'x:lte 'x:gt 'x:gte
    'x:nil? 'x:not-nil? 'x:zero? 'x:neg? 'x:pos? 'x:even? 'x:odd?
    'x:has-key? 'x:is-array? 'x:is-boolean? 'x:is-function?
    'x:is-integer? 'x:is-number? 'x:is-object? 'x:is-string?
    'x:iter-eq 'x:iter-has? 'x:iter-native?})

(def +dart-statement-heads+
  #{'do 'do* 'let 'let* 'var 'var* ':= 'return 'if 'cond 'when 'while
    'try 'for 'for:async 'for:index 'for:object 'for:array 'for:iter 'br*
    'throw 'x:throw 'x:err 'break 'continue 'defn 'defn- 'defgen 'fn})

(def +dart-dot-boolish-calls+
  #{'contains 'containsKey 'endsWith 'moveNext 'startsWith})

(declare dart-rewrite-conditional-expression)
(declare dart-rewrite-expression)
(declare dart-rewrite-statement)
(declare dart-rewrite-statements)
(declare rewrite-fn)
(declare rewrite-for-async-form)

(def with-form-meta
  walk/with-form-meta)

(defn dart-optional-input?
  [input]
  (= :maybe (get-in input [:type :kind])))

(defn dart-function-var-symbol?
  [symbol]
  (and (symbol? symbol)
       (let [text (name symbol)]
         (or (str/starts-with? text "dart_callback__")
             (str/ends-with? text "-fn")
             (str/ends-with? text "_fn")
             (has? #{"handler" "resolve" "reject" "process" "guard" "wrapper"}
                   text)))))

(defn dart-cast-function
  [form]
  (list :%
        (list :- "(")
        form
        (list :- " as Function)")))

(defn dart-qualified-symbol
  [sym]
  (let [module-id (get-in (preprocess/macro-opts) [:module :id])]
    (if (or (nil? sym)
            (namespace sym)
            (:inner (meta sym))
            (nil? module-id))
      sym
      (symbol (name module-id) (name sym)))))

(defn dart-resolve-function-def
  [head]
  (if (symbol? head)
    (try
      (let [qualified (dart-qualified-symbol head)
            module-name (namespace qualified)
            analysis (when module-name
                       (xtalk-parse/analyze-module (symbol module-name)))]
        (first
         (filter (fn [definition]
                   (= (name qualified) (str (:name definition))) )
                 (:functions analysis))))
      (catch error nil))
    nil))

(defn dart-pad-optional-args
  [head args]
  (if-not (symbol? head)
    args
    (let [definition (dart-resolve-function-def head)
          inputs (or (:inputs definition) [])
          optional-count (count (take-while dart-optional-input? (reverse inputs)))
          missing-count (- (count inputs) (count args))]
      (if (and definition
               (pos? optional-count)
               (pos? missing-count)
               (<= missing-count optional-count))
        (concat args (repeat missing-count nil))
        args))))

(defn dart-boolish-form?
  [form]
  (truthy/boolish-form?
   form
   {:boolish-ops +dart-boolish-ops+
    :dot-boolish-calls +dart-dot-boolish-calls+}))

(defn simple-truthy-source?
  [form]
  (or (symbol? form)
      (keyword? form)
      (string? form)
      (number? form)
      (boolean? form)
      (nil? form)))

(defn dart-wrap-truthy-check
  [source form grammar]
  (if (simple-truthy-source? form)
    (truthy/wrap-truthy-check source form)
    (let [value (common/stable-symbol "dart_truthy__" form)]
      (with-form-meta
        source
        (list
         (rewrite-fn
          (list 'fn []
                (list 'var value form)
                (list 'return (truthy/truthy-check-form value)))
          grammar))))))

(defn dart-truthy-form
  [source form grammar]
  (truthy/truthy-form
   source form dart-boolish-form?
   (fn [inner-source inner-form]
     (dart-wrap-truthy-check inner-source inner-form grammar))))

(defn ensure-return
  [statement-form]
  (cond
    (and (std.foundation/form? statement-form)
         (has? +dart-statement-heads+ (first statement-form)))
    (if (has? #{'do 'do*} (first statement-form))
      (let [body (rest statement-form)
            prefix (butlast body)
            tail (last body)]
        (with-form-meta
          statement-form
          (apply list (first statement-form)
                 (concat prefix [(ensure-return tail)]))))
      statement-form)

    :else
    (list 'return statement-form)))

(defn ensure-tail-return
  [statements]
  (if (seq statements)
    (concat (butlast statements) [(ensure-return (last statements))])
    statements))

(defn dart-normalize-let
  [form]
  (let [bindings (second form)
        body (drop 2 form)]
    (with-form-meta
      form
      (apply list
             'do
             (concat (map (fn [[symbol value]]
                            (if (= '_ symbol)
                              value
                              (list 'var symbol ':= value)))
                          (partition 2 bindings))
                     body)))))

(defn rewrite-fn
  [form grammar]
  (fnrw/rewrite-fn-form
   form
   (fn [forms] (dart-rewrite-statements forms grammar))
   {:prepare-body ensure-tail-return}))

(defn rewrite-for-statement
  [form grammar]
  (statement/rewrite-for-statement
   form
   (fn [binding]
     (walk/rewrite-binding-vector
      binding
      (fn [value] (dart-rewrite-expression value grammar))))
   (fn [forms] (dart-rewrite-statements forms grammar))))

(defn rewrite-cond-statement
  [form grammar]
  (statement/rewrite-cond-statement
   form
   (fn [value] (dart-rewrite-conditional-expression value grammar))
   (fn [value] (dart-rewrite-statement value grammar))))

(defn rewrite-branch-control
  [form grammar]
  (statement/rewrite-branch-control
   form
   (fn [value] (dart-rewrite-conditional-expression value grammar))
   (fn [forms] (dart-rewrite-statements forms grammar))))

(defn rewrite-branch-statement
  [form grammar]
  (statement/rewrite-branch-statement
   form
   (fn [branch] (rewrite-branch-control branch grammar))))

(defn rewrite-or-expression
  [form grammar]
  (let [args (walk/rewrite-coll
              (rest form)
              (fn [value] (dart-rewrite-expression value grammar)))]
    (with-form-meta
      form
      (apply list
             (if (every? dart-boolish-form? args) 'or 'dart:or)
             args))))

(defn rewrite-and-step
  [source lhs rhs grammar]
  (if (simple-truthy-source? lhs)
    (with-form-meta
      source
      (list ':? (dart-truthy-form source lhs grammar) rhs lhs))
    (let [value (common/stable-symbol "dart_and__" [source lhs rhs])]
      (with-form-meta
        source
        (list
         (rewrite-fn
          (list 'fn []
                (list 'var value lhs)
                (list 'return
                      (list ':?
                            (truthy/truthy-check-form value)
                            rhs
                            value)))
          grammar))))))

(defn rewrite-and-expression
  [form grammar]
  (let [args (walk/rewrite-coll
              (rest form)
              (fn [value] (dart-rewrite-expression value grammar)))]
    (with-form-meta
      form
      (cond
        (empty? args) true
        (= 1 (count args)) (first args)
        (every? dart-boolish-form? args) (apply list 'and args)
        :else (reduce (fn [lhs rhs] (rewrite-and-step form lhs rhs grammar))
                      (first args)
                      (rest args))))))

(defn rewrite-ternary-expression
  [form grammar]
  (let [test (second form)
        then (nth form 2)
        else (nth form 3)
        test* (dart-rewrite-expression test grammar)
        then* (dart-rewrite-expression then grammar)
        else* (dart-rewrite-expression else grammar)]
    (with-form-meta
      form
      (list (if (dart-boolish-form? test*) :? 'dart:ternary)
            test* then* else*))))

(defn spread-form?
  [form]
  (and (std.foundation/form? form)
       (= :.. (first form))
       (= 2 (count form))))

(defn rewrite-invoke-expression
  [form grammar]
  (let [head (first form)
        head* (if (std.foundation/form? head)
                (dart-rewrite-expression head grammar)
                head)
        original-args (rest form)
        spread? (some spread-form? original-args)
        unpack? (or (unpack/any-unpack? original-args) spread?)
        apply? (or unpack?
                   (dart-function-var-symbol? head*)
                   (dart-function-var-symbol? head))
        args (if unpack?
               original-args
               (dart-pad-optional-args head original-args))
        args* (map (fn [arg]
                     (cond
                       (spread-form? arg)
                       (list :.. (dart-rewrite-expression (second arg) grammar))

                       (unpack/unpack-form? arg)
                       (list :.. (dart-rewrite-expression (second arg) grammar))

                       :else
                       (dart-rewrite-expression arg grammar)))
                   args)]
    (with-form-meta
      form
      (if apply?
        (list 'Function.apply
              (if (or (dart-function-var-symbol? head*)
                      (dart-function-var-symbol? head))
                (dart-cast-function head*)
                head*)
              (vec args*))
        (apply list head* args*)))))

(defn rewrite-expression-list
  [form grammar]
  (let [tag (first form)]
    (cond
      (= 'quote tag) form
      (has? #{'do 'do*} tag)
      (with-form-meta form
        (list (rewrite-fn (apply list 'fn '[] (rest form)) grammar)))
      (has? #{'let 'let*} tag)
      (dart-rewrite-expression (dart-normalize-let form) grammar)
      (= 'fn tag) (rewrite-fn form grammar)
      (= 'and tag) (rewrite-and-expression form grammar)
      (= 'or tag) (rewrite-or-expression form grammar)
      (= :? tag) (rewrite-ternary-expression form grammar)
      (= 'for:async tag) (rewrite-for-async-form form grammar)
      :else (rewrite-invoke-expression form grammar))))

(defn rewrite-for-async-form
  [form grammar]
  (let [binding (second form)
        res (first (first binding))
        err (second (first binding))
        call-form (second binding)
        handlers (nth form 2)
        success (:success handlers)
        error (:error handlers)
        finally (:finally handlers)
        promise (list 'x:promise
                      (list 'fn []
                            (list 'return
                                  (dart-rewrite-expression call-form grammar))) )
        success-promise (list 'x:promise-then
                              promise
                              (list 'fn [res]
                                    (dart-rewrite-statement success grammar)))
        error-promise (list 'x:promise-catch
                            success-promise
                            (list 'fn [err]
                                  (dart-rewrite-statement error grammar)))]
    (with-form-meta
      form
      (if finally
        (list 'x:promise-finally
              error-promise
              (list 'fn []
                    (dart-rewrite-statement finally grammar)))
        error-promise))))

(defn rewrite-conditional-expression-list
  [form grammar]
  (conditional/rewrite-conditional-expression-list
   form
   (fn [value] (rewrite-fn value grammar))
   (fn [value] (dart-rewrite-conditional-expression value grammar))
   (fn [value] (dart-rewrite-expression value grammar))))

(defn dart-rewrite-conditional-expression
  [form grammar]
  (conditional/rewrite-conditional-expression
   form
   (fn [value] (rewrite-conditional-expression-list value grammar))
   (fn [value] (dart-rewrite-expression value grammar))
   (fn [source value] (dart-truthy-form source value grammar))))

(defn dart-global-assign?
  [form]
  (and (std.foundation/form? form)
       (= ':= (first form))
       (std.foundation/form? (second form))
       (= '!:G (first (second form)))
       (= 2 (count (second form)))))

(defn dart-rewrite-global-assign
  [form grammar]
  (let [target (second form)
        key (second target)
        value (nth form 2)]
    (dart-rewrite-statement
     (list 'x:set-key '!:G (str key) value)
     grammar)))

(defn dart-global-read?
  [form]
  (and (std.foundation/form? form)
       (= '!:G (first form))
       (= 2 (count form))))

(defn dart-rewrite-global-read
  [form grammar]
  (dart-rewrite-expression
   (list 'x:get-key '!:G (str (second form)))
   grammar))

(defn dart-rewrite-expression
  [form grammar]
  (or (when (dart-global-read? form)
        (dart-rewrite-global-read form grammar))
      (walk/rewrite-form
       form
       (fn [value] (rewrite-expression-list value grammar))
       (fn [value] (dart-rewrite-expression value grammar)))))

(defn rewrite-do-statement
  [form grammar]
  (statement/rewrite-do-statement
   (if (= 'do* (first form))
     (with-form-meta form (apply list 'do (rest form)))
     form)
   (fn [forms] (dart-rewrite-statements forms grammar))))

(defn rewrite-var-statement
  [form grammar]
  (statement/rewrite-var-statement
   form
   (fn [value] (dart-rewrite-expression value grammar))))

(defn rewrite-return-statement
  [form grammar]
  (statement/rewrite-return-statement
   form
   (fn [value] (dart-rewrite-expression value grammar))))

(defn rewrite-throw-statement
  [form grammar]
  (list 'throw (dart-rewrite-expression (second form) grammar)))

(defn rewrite-if-statement
  [form grammar]
  (statement/rewrite-if-statement
   form
   (fn [value] (dart-rewrite-conditional-expression value grammar))
   (fn [value] (dart-rewrite-statement value grammar))))

(defn rewrite-when-statement
  [form grammar]
  (statement/rewrite-when-statement
   form
   (fn [value] (dart-rewrite-conditional-expression value grammar))
   (fn [forms] (dart-rewrite-statements forms grammar))))

(defn rewrite-while-statement
  [form grammar]
  (statement/rewrite-while-statement
   form
   (fn [value] (dart-rewrite-conditional-expression value grammar))
   (fn [forms] (dart-rewrite-statements forms grammar))))

(defn rewrite-defn-statement
  [form grammar]
  (statement/rewrite-defn-statement
   form
   (fn [forms] (dart-rewrite-statements forms grammar))
   ensure-tail-return))

(defn dart-rewrite-statement
  [form grammar]
  (cond
    (not (std.foundation/form? form))
    (dart-rewrite-expression form grammar)

    (dart-global-assign? form)
    (dart-rewrite-global-assign form grammar)

    :else
    (let [tag (first form)]
      (cond
        (has? #{'do 'do*} tag) (rewrite-do-statement form grammar)
        (has? #{'let 'let*} tag)
        (dart-rewrite-statement (dart-normalize-let form) grammar)
        (has? #{'var 'var* ':=} tag) (rewrite-var-statement form grammar)
        (= 'cond tag) (rewrite-cond-statement form grammar)
        (= 'br* tag) (rewrite-branch-statement form grammar)
        (has? #{'for:index 'for:object 'for:array 'for:iter} tag)
        (rewrite-for-statement form grammar)
        (= 'for:async tag) (rewrite-for-async-form form grammar)
        (= 'return tag) (rewrite-return-statement form grammar)
        (= 'throw tag) (rewrite-throw-statement form grammar)
        (= 'if tag) (rewrite-if-statement form grammar)
        (= 'when tag) (rewrite-when-statement form grammar)
        (= 'while tag) (rewrite-while-statement form grammar)
        (has? #{'defn 'defn- 'defgen} tag) (rewrite-defn-statement form grammar)
        (= 'fn tag) (rewrite-fn form grammar)
        :else (dart-rewrite-expression form grammar)))))

(defn dart-rewrite-statements
  [forms grammar]
  (map (fn [form] (dart-rewrite-statement form grammar)) forms))

(defn dart-rewrite-stage
  [form {:keys [grammar] :as options}]
  (let [form ((:rewrite-stage +dart-rewriter+) form options)]
    (cond
      (and (std.foundation/form? form)
           (has? #{'do 'do*} (first form)))
      (dart-rewrite-expression form grammar)

      (std.foundation/form? form)
      (dart-rewrite-statement form grammar)

      (vector? form)
      (with-form-meta
        form
        (mapv (fn [value] (dart-rewrite-statement value grammar)) form))

      :else
      form)))
