(ns lang.model.v1.spec-hara.hara-grammar
  (:config {:role :internal})
  (:require [lang.base.emit :as emit]
            [lang.base.grammar :as grammar]))

(def +language+ :hara)
(def +tag+ :hara)
(def +grammar-version+ 1)

(def +grammar+
  (let [features (grammar/build)]
    (grammar/grammar +tag+
                     (grammar/to-reserved features)
                     (emit/default-grammar))))
