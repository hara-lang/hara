(ns lang.model.v1.spec-hara.hara-grammar
  (:config {:role :internal})
  (:require [lang.base.v1.grammar-spec :as spec]
            [lang.common.grammar-api :as grammar]
            [lang.model.v1.spec-xtalk :as xtalk]))

(def +language+ :hara)
(def +tag+ :hara)
(def +grammar-version+ spec/+version+)

(def +grammar+
  (grammar/definition
   {:grammar/id +tag+
    :grammar/version +grammar-version+
    :grammar/release "hara-v1"
    :grammar/language +language+
    :grammar/tag +tag+
    :grammar/engine {:minimum 1 :maximum 1}
    :grammar/parent
    {:grammar/id xtalk/+tag+
     :grammar/version xtalk/+grammar-version+}}))

