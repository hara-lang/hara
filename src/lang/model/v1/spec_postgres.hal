(ns lang.model.v1.spec-postgres
  (:require [lang.common.book :as book]
            [lang.common.grammar-api :as grammar]
            [lang.common.registry :as registry]
            [lang.model.v1.spec-postgres.meta :as meta]
            [lang.model.v1.spec-postgres.postgres-grammar :as model]))

(def +language+ :postgres)
(def +tag+ :postgres)
(def +version+ 1)
(def +grammar-version+ model/+grammar-version+)
(def +template+ model/+template+)
(def +profile+ model/+profile+)
(def +grammar+ model/+grammar+)
(defn install-source [catalog source]
  (if (registry/find catalog (grammar/source-coordinate source)) catalog
      (registry/install catalog source)))
(defn install [catalog]
  (let [catalog (install-source catalog +template+)
        catalog (install-source catalog +profile+)]
    (install-source catalog +grammar+)))
(defn catalog [] (install (registry/registry)))
(defn select
  ([] (select (catalog)))
  ([catalog] (registry/resolve catalog {:grammar/id +tag+ :grammar/version +grammar-version+})))
(def +selection+ (select))
(def +book+ (book/book {:lang +language+ :version +version+
                        :coordinate (:coordinate +selection+)
                        :grammar (:grammar +selection+) :selection +selection+
                        :meta meta/+meta+}))
(def +init+ +book+)
