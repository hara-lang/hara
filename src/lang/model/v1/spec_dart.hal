(ns lang.model.v1.spec-dart
  (:require [lang.base.book :as book]
            [lang.base.book-meta :as book-meta]
            [lang.base.grammar-api :as grammar-api]
            [lang.base.registry :as registry]
            [lang.model.v1.spec-dart.dart-grammar :as model]
            [lang.model.v1.spec-xtalk :as xtalk]))

(def +language+ :dart)
(def +tag+ :dt)
(def +version+ 1)
(def +grammar-version+ model/+grammar-version+)
(def +template+ model/+template-source+)
(def +profile+ model/+profile+)
(def +grammar+ model/+grammar+)

(def +coordinate+
  {:grammar/id +tag+
   :grammar/version +grammar-version+
   :grammar/release "alpha"
   :grammar/facets []})

(defn install-source
  [catalog source]
  (if (registry/find catalog (grammar-api/source-coordinate source))
    catalog
    (registry/install catalog source)))

(defn install
  [catalog]
  (let [catalog (xtalk/install catalog)
        catalog (install-source catalog +template+)
        catalog (install-source catalog +profile+)]
    (install-source catalog +grammar+)))

(defn catalog
  []
  (install (registry/registry)))

(defn select
  ([] (select (catalog)))
  ([catalog]
   (registry/resolve catalog
                     {:grammar/id +tag+
                      :grammar/version +grammar-version+})))

(def +meta+
  (book-meta/book-meta
   {:module-current (fn [] nil)
    :module-import
    (fn [name options _mopts]
      (let [alias (:as options)
            suffix (:suffix options)]
        (list :-
              (str "import '" name (or suffix "") "'"
                   (if alias
                     (str " as "
                          (str/replace (str alias) "-" "_"))
                     "")
                   ";"))))}))

(def +selection+ (select))

(def +book+
  (book/book {:lang +language+
              :meta +meta+
              :parent :xtalk
              :version +version+
              :coordinate +coordinate+
              :grammar (:grammar +selection+)
              :selection +selection+}))

(def +init+ +book+)
