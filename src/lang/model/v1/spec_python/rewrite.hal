(ns lang.model.v1.spec-python.rewrite
  (:config {:role :internal})
  (:require [lang.core.rewrite.hoist :as hoist]
            [lang.core.rewrite.inline-do :as inline]
            [lang.core.rewrite.common :as rewrite-common]
            [lang.core.rewrite.walk :as walk]))

(def +python-lambda-disallowed-emits+
 #{:with-rand
   :with-lang
   :with-eval
   :do
   :return
   :with-uuid
   :abstract
   :do*
   :assign
   :def-assign
   :comment
   :with-deref
   :discard
   :with-decorate
   :with-global
   :with-module})

(def +python-lambda-disallowed-types+ #{:block :free :def})

(def +python-lambda-disallowed-ops+ #{:throw})

(defn python-lambda-entry [form grammar]
  (when (form? form)
    (let [op (first form)]
      (or
        (get-in grammar [:reserved op])
        (when (and (symbol? op) (namespace op))
          (get-in grammar [:reserved (symbol (name op))]))))))

(comment
  "Native namespace compilation resolves forward references."
  (declare python-lambda-compatible?))

(defn python-lambda-expr?
  [form grammar]
  (cond (or (nil? form)
          (symbol? form)
          (string? form)
          (keyword? form)
          (number? form)
          (boolean? form))
    true
    (vector? form)
    (every? (fn [migration-argument-0] (python-lambda-expr? migration-argument-0 grammar))
      form)
    (set? form)
    (every? (fn [migration-argument-0] (python-lambda-expr? migration-argument-0 grammar))
      form)
    (map? form)
    (every? (fn [[k v]]
              (and (python-lambda-expr? k grammar) (python-lambda-expr? v grammar)))
      form)
    (and (form? form) (= (quote quote) (first form)))
    true
    (and (form? form) (= (quote return) (first form)))
    (let [[_ value & more] form more (not-empty (apply list (vec more)))]
      (and (empty? more) (python-lambda-expr? value grammar)))
    (and (form? form) (= (quote fn) (first form)))
    (python-lambda-compatible? form grammar)
    (and (form? form) (has? (quote #{:*= :+= :-= :=}) (first form)))
    false
    (form? form)
    (let [entry (python-lambda-entry form grammar)]
      (if-let [macro-fn (:macro entry)]
        (let [expanded ((if (= :std.native.Var (type macro-fn)) (deref macro-fn) macro-fn) form)]
          (if (= expanded form)
            (and (not (has? +python-lambda-disallowed-ops+ (:op entry)))
              (not (has? +python-lambda-disallowed-types+ (:type entry)))
              (not (has? +python-lambda-disallowed-emits+ (:emit entry)))
              (every? (fn [migration-argument-0] (python-lambda-expr? migration-argument-0 grammar))
                (rest form)))
            (python-lambda-expr? expanded grammar)))
        (and (not (has? +python-lambda-disallowed-ops+ (:op entry)))
          (not (has? +python-lambda-disallowed-types+ (:type entry)))
          (not (has? +python-lambda-disallowed-emits+ (:emit entry)))
          (every? (fn [migration-argument-0] (python-lambda-expr? migration-argument-0 grammar))
            (rest form)))))
    :else
    true))

(defn python-lambda-compatible? [form grammar]
  (let [[_ head & tail] form
        tail (not-empty (apply list (vec tail)))
        [name body] (if (symbol? head) [head (rest tail)] [nil tail])]
    (and
      (nil? name)
      (or
        (empty? body)
        (and
          (= 1 (count body))
          (python-lambda-expr? (first body) grammar))))))

(def +python-rewriter+
  (hoist/create-rewriter {:fn-tags            #{(quote fn.inner) (quote fn)}
                          :symbol-prefix      "py_callback__"
                          :symbol-fn          (fn [migration-argument-0]
                                                  (rewrite-common/stable-symbol "py_callback__" migration-argument-0))
                          :lambda-compatible? python-lambda-compatible?}))

(def with-form-meta walk/with-form-meta)

(def python-rewrite-expression
  (:rewrite-expression +python-rewriter+))

(def python-rewrite-statement
  (:rewrite-statement +python-rewriter+))

(def python-rewrite-statements
  (:rewrite-statements +python-rewriter+))

(comment
  "Native namespace compilation resolves forward references."
  (declare python-normalize-form))

(defn python-handler-form? [tag form]
  (and (form? form) (= tag (first form))))

(defn python-value-catch-binding? [binding]
  (and (symbol? binding) (not (re-find #"^[A-Z]" (name binding)))))

(defn python-catch-binding [binding err-sym]
  (with-form-meta binding ['Exception :as err-sym]))

(defn python-catch-value [err-sym]
  (list
    ':?
    (list 'hasattr err-sym "__xt_value__")
    (list '. err-sym '__xt_value__)
    err-sym))

(defn python-rewrite-throw [form]
  (let [[_ value] form
        value (python-normalize-form value)
        value-sym (rewrite-common/stable-symbol
                    "py_throw_value__"
                    form)
        err-sym (rewrite-common/stable-symbol "py_throw_err__" form)
        native? (list 'isinstance value-sym 'BaseException)]
    (with-form-meta
      form
      (list
        'do
        (list 'var value-sym ':= value)
        (list
          'var
          err-sym
          ':=
          (list ':? native? value-sym (list 'Exception value-sym)))
        (list
          'when
          (list 'not native?)
          (list 'setattr err-sym "__xt_value__" value-sym))
        (list 'throw err-sym)))))

(defn python-rewrite-handler [form]
  (case
    (first form)
    catch
    (let [[_ binding & body] form
          body (not-empty (apply list (vec body)))]
      (if (python-value-catch-binding? binding)
        (let [err-sym (rewrite-common/stable-symbol
                        "py_catch_err__"
                        form)]
          (with-form-meta
            form
            (apply
              list
              'catch
              (python-catch-binding binding err-sym)
              (concat
                [(list 'var binding ':= (python-catch-value err-sym))]
                (map python-normalize-form body)))))
        (with-form-meta
          form
          (apply
            list
            'catch
            binding
            (map python-normalize-form body)))))
    finally
    (with-form-meta
      form
      (apply list 'finally (map python-normalize-form (rest form))))
    form))

(defn python-rewrite-try [form]
  (let [[_ & items] form
        items (not-empty (apply list (vec items)))
        [body handlers] (split-with
                          (fn [x]
                            (not
                              (or
                                (python-handler-form? 'catch x)
                                (python-handler-form? 'finally x))))
                          items)]
    (with-form-meta
      form
      (apply
        list
        'try
        (concat
          (map python-normalize-form body)
          (map python-rewrite-handler handlers))))))

(defn python-rewrite-list [form]
  (cond
    (not (form? form)) form
    (= 'quote (first form)) form
    (= 'throw (first form)) (python-rewrite-throw form)
    (= 'try (first form)) (python-rewrite-try form)
    (and
      (= ':= (first form))
      (form? (second form))
      (= '. (first (second form)))
      (vector? (first (drop 2 (second form))))
      (= 1 (count (nth (second form) 2)))) (let
                                             [[_ [_ obj props] value]
                                              form]
                                             (with-form-meta
                                               form
                                               (list
                                                 ':=
                                                 (list
                                                   '.
                                                   obj
                                                   (list
                                                     'setitem
                                                     (first props)))
                                                 value)))
    :else (with-form-meta
            form
            (apply list (map python-normalize-form form)))))

(defn python-normalize-form
  [form]
  (walk/rewrite-form form
                     python-rewrite-list
                     python-normalize-form))

(defn python-rewrite-stage
  [form opts]
  (-> ((:rewrite-stage +python-rewriter+) form opts)
      (python-normalize-form)
      (inline/rewrite-inline-do)))

