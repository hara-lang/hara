(ns lang.model.v1.spec-python.python-rewrite
  (:config {:role :internal})
  (:require [lang.core.rewrite.hoist :as hoist]
            [lang.core.rewrite.inline-do :as inline]
            [lang.core.rewrite.common :as rewrite-common]
            [lang.core.rewrite.walk :as walk]
            ))

(def +python-lambda-disallowed-emits+
  #{:abstract
    :assign
    :comment
    :def-assign
    :discard
    :do
    :do*
    :return
    :with-decorate
    :with-deref
    :with-eval
    :with-global
    :with-lang
    :with-module
    :with-rand
    :with-uuid})

(def +python-lambda-disallowed-types+
  #{:block
    :def
    :free})

(def +python-lambda-disallowed-ops+
  #{:throw})

(defn python-lambda-entry
  [form grammar]
  (when (list? form)
    (let [op (first form)]
      (or (get-in grammar [:reserved op])
          (when (and (symbol? op)
                     (namespace op))
            (get-in grammar [:reserved (symbol (name op))]))))))

(declare python-lambda-compatible?)

(defn python-lambda-expr?
  [form grammar]
  (cond (or (nil? form)
            (symbol? form)
            (string? form)
            (keyword? form)
            (number? form)
            (boolean? form))
        true

        (vector? form)
        (every? (fn [value] (python-lambda-expr? value grammar)) form)

        (set? form)
        (every? (fn [value] (python-lambda-expr? value grammar)) form)

        (map? form)
        (reduce-kv (fn [valid key value]
                     (and valid
                          (python-lambda-expr? key grammar)
                          (python-lambda-expr? value grammar)))
                   true
                   form)

        (and (list? form)
             (= 'quote (first form)))
        true

        (and (list? form)
             (= 'return (first form)))
        (let [[_ value & more] form]
          (and (empty? more)
               (python-lambda-expr? value grammar)))

        (and (list? form)
             (= 'fn (first form)))
        (python-lambda-compatible? form grammar)

        (and (list? form)
             (not (nil? (#{:= :+= :-= :*=} (first form)))))
        false

        (list? form)
        (let [entry (python-lambda-entry form grammar)]
          (if-let [macro-fn (:macro entry)]
            (let [expanded (macro-fn form)]
              (if (= expanded form)
                (and (nil? (+python-lambda-disallowed-ops+ (:op entry)))
                     (nil? (+python-lambda-disallowed-types+ (:type entry)))
                     (nil? (+python-lambda-disallowed-emits+ (:emit entry)))
                     (every? (fn [value] (python-lambda-expr? value grammar)) (rest form)))
                (python-lambda-expr? expanded grammar)))
            (and (nil? (+python-lambda-disallowed-ops+ (:op entry)))
                 (nil? (+python-lambda-disallowed-types+ (:type entry)))
                 (nil? (+python-lambda-disallowed-emits+ (:emit entry)))
                 (every? (fn [value] (python-lambda-expr? value grammar)) (rest form)))))

        :else
        true))

(defn python-lambda-compatible?
  [form grammar]
  (let [[_ head & tail] form
        [name body]      (if (symbol? head)
                           [head (rest tail)]
                           [nil tail])]
    (and (nil? name)
         (or (empty? body)
             (and (= 1 (count body))
                  (python-lambda-expr? (first body) grammar))))))

(def +python-rewriter+
  (hoist/create-rewriter
   {:fn-tags #{'fn 'fn.inner}
     :symbol-prefix "py_callback__"
     :symbol-fn (fn [form] (rewrite-common/stable-symbol "py_callback__" form))
     :lambda-compatible? python-lambda-compatible?}))

(def with-form-meta
  walk/with-form-meta)

(def python-rewrite-expression
  (:rewrite-expression +python-rewriter+))

(def python-rewrite-statement
  (:rewrite-statement +python-rewriter+))

(def python-rewrite-statements
  (:rewrite-statements +python-rewriter+))

(declare python-normalize-form)

(defn python-handler-form?
  [tag form]
  (and (list? form)
       (= tag (first form))))

(defn python-value-catch-binding?
  [binding]
  (and (symbol? binding)
       (= (name binding) (str/lower (name binding)))))

(defn python-catch-binding
  [binding err-sym]
  (with-form-meta binding
    ['Exception :as err-sym]))

(defn python-catch-value
  [err-sym]
  (list ':?
        (list 'hasattr err-sym "__xt_value__")
        (list '. err-sym '__xt_value__)
        err-sym))

(defn python-rewrite-throw
  [form]
  (let [[_ value] form
        value (python-normalize-form value)
        value-sym (rewrite-common/stable-symbol "py_throw_value__" form)
        err-sym (rewrite-common/stable-symbol "py_throw_err__" form)
        native? (list 'isinstance value-sym 'BaseException)]
    (with-form-meta form
      (list 'do
            (list 'var value-sym ':= value)
            (list 'var err-sym ':=
                  (list ':? native?
                        value-sym
                        (list 'Exception value-sym)))
            (list 'when
                  (list 'not native?)
                  (list 'setattr err-sym "__xt_value__" value-sym))
            (list 'throw err-sym)))))

(defn python-rewrite-handler
  [form]
  (cond (= (first form) (quote catch))
    (let [[_ binding & body] form]
      (if (python-value-catch-binding? binding)
        (let [err-sym (rewrite-common/stable-symbol "py_catch_err__" form)]
          (with-form-meta form
            (apply list 'catch
                   (python-catch-binding binding err-sym)
                   (concat [(list 'var binding ':=
                                  (python-catch-value err-sym))]
                           (map python-normalize-form body)))))
        (with-form-meta form
          (apply list 'catch
                 binding
                 (map python-normalize-form body)))))

    (= (first form) (quote finally))
    (with-form-meta form
      (apply list 'finally
             (map python-normalize-form (rest form))))

    :else form))

(defn python-rewrite-try
  [form]
  (let [[_ & items] form
        [body handlers] (split-with (fn [x]
                                      (not (or (python-handler-form? 'catch x)
                                               (python-handler-form? 'finally x))))
                                    items)]
    (with-form-meta form
      (apply list 'try
             (concat (map python-normalize-form body)
                     (map python-rewrite-handler handlers))))))

(defn python-normalize-for
  "Normalizes Foundation numeric loops to Python range loops."
  [form]
  (let [params (second form)
        init (first params)
        check (second params)
        update (nth params 2)
        index (second init)
        start (if (= := (nth init 2)) (nth init 3) (nth init 2))
        stop (nth check 2)
        step-form (nth update 2)
        step (if (and (list? step-form)
                      (= index (second step-form)))
               (if (= '+ (first step-form))
                 (nth step-form 2)
                 (if (= '- (first step-form))
                   (list '- 0 (nth step-form 2))
                   1))
               1)
        range-form (list 'range start stop step)
        body (map python-normalize-form (drop 2 form))]
    (with-form-meta form
      (apply list 'for
             (concat [[index :in range-form]] body)))))

(defn python-numeric-for?
  "Checks for the generic numeric loop shape produced by Foundation."
  [form]
  (let [params (second form)
        init (if (vector? params) (first params) nil)
        check (if (vector? params) (second params) nil)
        update (if (and (vector? params) (> (count params) 2))
                 (nth params 2)
                 nil)
        step-form (if (and (list? update) (> (count update) 2))
                   (nth update 2)
                   nil)]
    (and (list? form)
         (= 'for (first form))
         (vector? params)
         (= 3 (count params))
         (list? init)
         (= 'var (first init))
         (list? check)
         (or (= '< (first check)) (= '> (first check)))
         (list? update)
         (= := (first update))
         (= (second init) (second update))
         (list? step-form)
         (= (second init) (second step-form))
         (or (= '+ (first step-form)) (= '- (first step-form))))))

(defn python-rewrite-list
  [form]
  (cond
    (not (list? form))
    form

    (= 'quote (first form))
    form

    (= 'throw (first form))
    (python-rewrite-throw form)

    (= 'try (first form))
    (python-rewrite-try form)

    (let [target (if (> (count form) 1) (nth form 1) nil)
          props (if (and (list? target) (> (count target) 2))
                  (nth target 2)
                  nil)]
      (and (= ':= (first form))
           (list? target)
           (= '. (first target))
           (vector? props)
           (= 1 (count props))))
    (let [target (nth form 1)
          props (nth target 2)]
      (with-form-meta form
        (list ':=
              (list '. (nth target 1) (list 'setitem (first props)))
              (nth form 2))))

    (python-numeric-for? form)
    (python-normalize-for form)


    :else
    (with-form-meta form
      (apply list (map python-normalize-form form)))))

(defn python-normalize-form
  [form]
  (walk/rewrite-form form
                     python-rewrite-list
                     python-normalize-form))

(defn python-rewrite-stage
  [form opts]
  (-> ((:rewrite-stage +python-rewriter+) form opts)
      (python-normalize-form)
      (inline/rewrite-inline-do)))
