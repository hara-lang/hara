(ns lang.model.v1.spec-xtalk.fn-dart
  (:config {:role :internal}))

(defn dart-method0
  [obj method]
  (list :% (list :- "(") obj (list :- ").") method (list :- "()")))

(defn dart-call
  [f args]
  (list 'Function.apply f (vec args)))

(defn dart-runtime-type-string
  [obj]
  (dart-method0 (list '. obj 'runtimeType) 'toString))

(defn dart-string-compare-expr
  [a b]
  (list '. (dart-method0 a 'toString)
        (list 'compareTo (dart-method0 b 'toString))))

(defn dart-comparison-form
  [a b numeric-op string-op]
  (let [string-side? (fn [value]
                       (list '== "String"
                             (dart-runtime-type-string value)))]
    (list ':?
          (list 'or (string-side? a) (string-side? b))
          (list string-op (dart-string-compare-expr a b) 0)
          (list numeric-op a b))))

(defn dart-is-map
  [obj]
  (list :% (list :- "(") obj (list :- " is Map)")))

(defn dart-map-get
  [obj key]
  (list :% (list :- "((") obj
        (list :- (str " as Map)[\"" key "\"])"))))

(defn dart-xt-exception?
  [obj]
  (list 'and
        (dart-is-map obj)
        (list '== "xt.exception" (dart-map-get obj "__type__"))))

(defn dart-tf-x-len
  [form]
  (list '. (second form) 'length))

(defn dart-tf-x-cat
  [form]
  (apply list '+ (drop 1 form)))

(defn dart-tf-x-print
  [form]
  (let [args (drop 1 form)
        value (if (= 1 (count args))
                (first args)
                (apply list '+ args))]
    (list (list 'fn []
                (list 'print value)
                (list 'return nil)))))

(defn dart-tf-x-arr-push
  [form]
  (list '. (second form) (list 'add (nth form 2))))

(defn dart-tf-x-apply
  [form]
  (dart-call (second form) [(nth form 2)]))

(defn dart-tf-x-construct
  [form]
  (dart-call (second form) [(nth form 2)]))

(defn dart-tf-x-now-ms
  [_]
  (list '. (list 'DateTime.now) 'millisecondsSinceEpoch))

(defn dart-tf-x-random
  [_]
  (dart-method0 (list 'math.Random) 'nextDouble))

(defn dart-tf-x-type-native
  [form]
  (let [obj (second form)
        rtype (gensym "rtype")
        sval (gensym "sval")]
    (list (list 'fn []
                (list 'if (list '== obj nil) (list 'return nil))
                (list 'var rtype (dart-runtime-type-string obj))
                (list 'var sval (dart-method0 obj 'toString))
                (list 'if (list '== "String" rtype)
                      (list 'return "string"))
                (list 'if (list 'or (list '== "int" rtype)
                                  (list '== "double" rtype)
                                  (list '== "num" rtype))
                      (list 'return "number"))
                (list 'if (list '== "bool" rtype)
                      (list 'return "boolean"))
                (list 'if (list 'or
                                (list '. rtype (list 'contains "Function"))
                                (list '. rtype (list 'contains "=>"))
                                (list '. sval (list 'startsWith "Closure")))
                      (list 'return "function"))
                (list 'if (list 'or
                                (list '== "List" rtype)
                                (list '. rtype (list 'contains "List")))
                      (list 'return "array"))
                (list 'if (list 'or
                                (list '== "Map" rtype)
                                (list '. rtype (list 'contains "Map")))
                      (list 'return "object"))
                (list 'return (list '. rtype (list 'toLowerCase)))))))

(defn dart-tf-x-del
  [form]
  (let [obj (second form)]
    (if (and (std.foundation/form? obj)
             (= '. (first obj))
             (= 3 (count obj))
             (vector? (nth obj 2))
             (= 1 (count (nth obj 2))))
      (list '. (second obj) (list 'remove (first (nth obj 2))))
      (list '. obj (list 'remove nil)))))

(defn dart-tf-x-eval
  [_]
  (list 'throw "eval not supported in Dart"))

(defn dart-tf-x-ex-native?
  [form]
  (dart-xt-exception? (second form)))

(defn dart-tf-x-ex-new
  [form]
  (let [tail (drop 1 form)]
    {"__type__" "xt.exception"
     "message" (first tail)
     "data" (if (> (count tail) 1) (second tail) nil)}))

(defn dart-tf-x-ex-message
  [form]
  (let [value (second form)]
    (list ':? (dart-xt-exception? value)
          (dart-map-get value "message")
          nil)))

(defn dart-tf-x-ex-data
  [form]
  (let [value (second form)]
    (list ':? (dart-xt-exception? value)
          (dart-map-get value "data")
          nil)))

(defn dart-tf-x-has-key?
  [form]
  (let [obj (second form)
        key (nth form 2)
        check (if (> (count form) 3) (nth form 3) nil)]
    (if (not (nil? check))
      (list 'and
            (list '. obj (list 'containsKey key))
            (list '== check (list '. obj (vector key))))
      (list '. obj (list 'containsKey key)))))

(defn dart-tf-x-del-key
  [form]
  (list '. (second form) (list 'remove (nth form 2))))

(defn dart-tf-x-lt [form]
  (dart-comparison-form (second form) (nth form 2) '< '<))

(defn dart-tf-x-lte [form]
  (dart-comparison-form (second form) (nth form 2) '<= '<=))

(defn dart-tf-x-gt [form]
  (dart-comparison-form (second form) (nth form 2) '> '>))

(defn dart-tf-x-gte [form]
  (dart-comparison-form (second form) (nth form 2) '>= '>=))

(def +dart-core+
  {:x-print {:macro dart-tf-x-print :emit :macro :value true}
   :x-len {:macro dart-tf-x-len :emit :macro :value true}
   :x-cat {:macro dart-tf-x-cat :emit :macro :value true}
   :x-apply {:macro dart-tf-x-apply :emit :macro}
   :x-construct {:macro dart-tf-x-construct :emit :macro}
