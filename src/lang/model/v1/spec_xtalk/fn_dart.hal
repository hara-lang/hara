(defn dart-tf-x-socket-connect
  [form]
  (let [host (second form)
        port (nth form 2)
        callback (nth form 4)
        call-ok (dart-call callback (vector nil 'conn))
        call-err (dart-call callback (vector 'error nil))]
    (list '. (list 'Socket.connect host port)
          (list 'then (list 'fn (vector 'conn)
                            (list 'return call-ok)))
          (list 'catchError (list 'fn (vector 'error)
                                  (list 'return call-err))))))

(defn dart-tf-x-socket-send
