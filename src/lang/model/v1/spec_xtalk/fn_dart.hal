(defn dart-tf-x-m-log10 [form]
  (list '/ (list 'math.log (second form)) 'math.ln10))

(defn dart-tf-x-m-max
  [form]
  (reduce (fn [acc arg] (list ':? (list '> acc arg) acc arg))
          (drop 1 form)))

(defn dart-tf-x-m-min
  [form]
  (reduce (fn [acc arg] (list ':? (list '< acc arg) acc arg))
          (drop 1 form)))

(defn dart-tf-x-m-mod [form]
  (list :% (second form) (list :- " % ") (nth form 2)))

(defn dart-tf-x-m-pow [form]
  (list 'math.pow (second form) (nth form 2)))

(defn dart-tf-x-m-quot [form]
  (list :% (second form) (list :- " ~/ ") (nth form 2)))

(defn dart-tf-x-m-cosh [form]
  (let [x (second form)]
    (list '/ (list '+ (list 'math.exp x)
                  (list 'math.exp (list '- x)))
          2)))

(defn dart-tf-x-m-sinh [form]
  (let [x (second form)]
    (list '/ (list '- (list 'math.exp x)
                  (list 'math.exp (list '- x)))
          2)))

(defn dart-tf-x-m-tanh [form]
  (let [x (second form)]
    (list '/ (list '- (list 'math.exp (list '* 2 x)) 1)
          (list '+ (list 'math.exp (list '* 2 x)) 1))))

