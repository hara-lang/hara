   :x-lte {:macro dart-tf-x-lte :emit :macro}
   :x-gt {:macro dart-tf-x-gt :emit :macro}
   :x-gte {:macro dart-tf-x-gte :emit :macro}
   :x-unpack {:emit :alias :raw '...}})

