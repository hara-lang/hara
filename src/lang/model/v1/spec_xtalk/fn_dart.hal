        key (nth form 2)
        direct (gensym "direct")
        proto (gensym "proto")]
    (list
     (list 'fn []
           (list 'var direct (list 'x:get-key obj key nil))
           (list 'if (list 'not= nil direct) (list 'return direct))
           (list 'var proto (list 'proto:get obj))
           (list 'if (list '== nil proto) (list 'return nil))
           (list 'return (list 'x:get-key proto key nil))))))

(defn dart-tf-x-prototype-tostring [_]
