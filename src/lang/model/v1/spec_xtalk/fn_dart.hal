(defn dart-tf-x-pwd [_]
  (list :- "(Platform.environment[\"PWD\"] ?? Directory.current.path)"))

(defn dart-tf-x-file-resolve
  [form]
  (let [root (second form)
        path (nth form 2)]
    (list
     (list 'fn (vector)
           (list 'var 'base root)
           (list 'return
                 (list ':?
                       (list 'or (list '== nil 'base)
                             (list '. path (list 'startsWith "/")))
                       path
                       (list '+ 'base "/" path)))))))

(defn dart-tf-x-file-slurp
  [form]
  (let [filename (second form)
        callback (nth form 2)
        call-ok (dart-call callback (vector nil 'out))
        call-err (dart-call callback (vector 'error nil))]
    (list '. (list '. (list 'File filename) (list 'readAsString))
          (list 'then (list 'fn (vector 'out) (list 'return call-ok)))
          (list 'catchError (list 'fn (vector 'error)
                                  (list 'return call-err))))))

(defn dart-tf-x-file-spit
  [form]
  (let [filename (second form)
        value (nth form 2)
        callback (nth form 3)
        call-ok (dart-call callback (vector nil filename))
        call-err (dart-call callback (vector 'error nil))]
    (list '. (list '. (list 'Directory
                                  (list '. (list '. (list 'File filename)
                                                'parent)
                                        'path))
                        (list 'create :recursive true))
          (list 'then
                (list 'fn (vector '_)
                      (list 'return
                            (list '. (list '. (list 'File filename)
                                          (list 'writeAsString value))
                                  (list 'then
                                        (list 'fn (vector '_)
                                              (list 'return call-ok)))
                                  (list 'catchError
                                        (list 'fn (vector 'error)
                                              (list 'return call-err)))))))
          (list 'catchError (list 'fn (vector 'error)
                                  (list 'return call-err))))))

