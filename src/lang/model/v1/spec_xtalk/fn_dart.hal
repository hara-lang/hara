(defn dart-tf-x-return-encode
  [form]
  (let [out (second form)
        id (nth form 2)
        key (nth form 3)
        outtype (gensym "outtype")
        outstr (gensym "outstr")
        compact (gensym "compact")]
    (list 'do
          (list 'if (list '== out nil)
                (list 'return
                      (list 'json.encode
                            {"id" id "key" key "type" "data"
                             "return" "nil" "value" nil})))
          (list 'var outtype (dart-runtime-type-string out))
          (list 'var outstr (dart-method0 out 'toString))
          (list 'var compact (dart-json-compact-expr out))
          (list 'if (list '== "String" outtype)
                (list 'return
                      (list 'json.encode
                            {"id" id "key" key "type" "data"
                             "return" "string" "value" out})))
          (list 'if (list 'or (list '== "int" outtype)
                          (list '== "double" outtype)
                          (list '== "num" outtype))
                (list 'return
                      (list 'json.encode
                            {"id" id "key" key "type" "data"
                             "return" "number" "value" out})))
          (list 'if (list '== "bool" outtype)
                (list 'return
                      (list 'json.encode
                            {"id" id "key" key "type" "data"
                             "return" "boolean" "value" out})))
          (list 'if (list 'or (list '== "List" outtype)
                          (list '. outtype (list 'contains "List")))
                (list 'return
                      (list 'json.encode
                            {"id" id "key" key "type" "data"
                             "return" "array" "value" compact})))
          (list 'if (list 'or (list '== "Map" outtype)
                          (list '. outtype (list 'contains "Map")))
                (list 'return
                      (list 'json.encode
                            {"id" id "key" key "type" "data"
                             "return" "object" "value" compact})))
          (list 'if (list 'or
                          (list '. outtype (list 'contains "Function"))
                          (list '. outtype (list 'contains "=>"))
                          (list '. outstr (list 'startsWith "Closure")))
                (list 'return
                      (list 'json.encode
                            {"id" id "key" key "type" "raw"
                             "return" "function" "value" outstr})))
          (list 'return
                (list 'json.encode
                      {"id" id "key" key "type" "raw"
                       "return" (list '. outtype (list 'toLowerCase))
                       "value" outstr})))))

(defn dart-tf-x-return-wrap
  [form]
  (let [f (second form)
        encode-fn (nth form 2)]
    (list 'try
          (list 'var 'out (list f))
          (list 'try
                (list 'return (dart-call encode-fn (vector 'out)))
                (list 'catch '_
                      (list 'return (dart-call encode-fn (vector 'out nil nil)))))
          (list 'catch 'error
                (list 'return
                      (list 'json.encode
                            {:type "error"
                             :value {:message (list '. 'error
                                                    (list 'toString))}}))))))

(defn dart-tf-x-return-eval
  [_]
  (list 'throw "eval not supported in Dart"))

(def +dart-return+
  {:x-return-encode {:macro dart-tf-x-return-encode :emit :macro}
   :x-return-wrap {:macro dart-tf-x-return-wrap :emit :macro}
   :x-return-eval {:macro dart-tf-x-return-eval :emit :macro}})

(defn dart-tf-x-with-delay
  [form]
  (let [ms (second form)
        thunk (nth form 2)
        call (dart-call thunk (vector))]
    (list '. (list 'Future.delayed
                  (list :% (list :- "Duration(milliseconds: ")
                        ms
                        (list :- ")")))
          (list 'then
                (list 'fn (vector '_)
                      (list 'return
                            (list 'Future.sync
                                  (list 'fn (vector)
                                        (list 'return call)))))))))

(defn dart-tf-x-async-run [form]
  (list 'Future.sync (second form)))

(defn dart-tf-x-promise [form]
  (list 'Future.sync (second form)))

(defn dart-tf-x-promise-new
  [form]
  (let [thunk (second form)
        call (dart-call thunk
                        (vector (list :- "completer.complete")
                                (list :- "completer.completeError")))]
    (list 'Future.sync
          (list 'fn (vector)
                (list 'var 'completer (list :- "Completer<dynamic>()"))
                call
                (list 'return (list '. 'completer 'future))))))

(defn dart-tf-x-promise-all
  [form]
  (list :% (list :- "Future.wait(List<Future<dynamic>>.from((")
        (second form)
        (list :- ").map((entry) => Future.sync(() => entry))))")))

(defn dart-tf-x-promise-then
  [form]
  (let [promise (second form)
        call (dart-call (nth form 2) (vector 'value))]
    (list :% (list :- "((Future.sync(() => ")
          promise
          (list :- ")) as Future<dynamic>).then((value) async { return await ")
          call
          (list :- "; })"))))

(defn dart-tf-x-promise-catch
  [form]
  (let [promise (second form)
        call (dart-call (nth form 2) (vector 'error))]
    (list :% (list :- "(() async { try { return await ((Future.sync(() => ")
          promise
          (list :- ")) as Future<dynamic>); } catch (error) { return await Future.sync(() => ")
          call
          (list :- "); } })()"))))

(defn dart-tf-x-promise-finally
  [form]
  (let [promise (second form)
        call (dart-call (nth form 2) (vector))]
    (list :% (list :- "((Future.sync(() => ")
          promise
          (list :- ")) as Future<dynamic>).whenComplete(() async { await ")
          call
          (list :- "; })"))))

(defn dart-tf-x-promise-native?
  [form]
  (let [value (second form)
        rtype (dart-runtime-type-string value)]
    (list 'and (list 'not= nil value)
          (list 'or (list '== "Future" rtype)
                (list '. rtype (list 'startsWith "Future<"))))))

(def +dart-promise+
  {:x-async-run {:macro dart-tf-x-async-run :emit :macro}
   :x-promise {:macro dart-tf-x-promise :emit :macro}
   :x-promise-new {:macro dart-tf-x-promise-new :emit :macro}
   :x-promise-all {:macro dart-tf-x-promise-all :emit :macro}
   :x-promise-then {:macro dart-tf-x-promise-then :emit :macro}
   :x-promise-catch {:macro dart-tf-x-promise-catch :emit :macro}
   :x-promise-finally {:macro dart-tf-x-promise-finally :emit :macro}
   :x-promise-native? {:macro dart-tf-x-promise-native? :emit :macro}})

