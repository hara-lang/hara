(defn dart-tf-x-to-string [form]
  (dart-method0 (second form) 'toString))

(defn dart-tf-x-to-number [form]
  (list 'num.parse (second form)))

(defn dart-tf-x-is-string? [form]
  (list '== "String" (dart-runtime-type-string (second form))))

(defn dart-tf-x-is-number? [form]
  (let [rtype (dart-runtime-type-string (second form))]
    (list 'or (list '== "int" rtype)
          (list '== "double" rtype)
          (list '== "num" rtype))))

(defn dart-tf-x-is-integer? [form]
  (list '== "int" (dart-runtime-type-string (second form))))

(defn dart-tf-x-is-boolean? [form]
  (list '== "bool" (dart-runtime-type-string (second form))))

(defn dart-tf-x-is-function? [form]
  (let [x (second form)
        rtype (dart-runtime-type-string x)
        sval (dart-method0 x 'toString)]
    (list 'or (list '. rtype (list 'contains "Function"))
          (list '. rtype (list 'contains "=>"))
          (list '. sval (list 'startsWith "Closure")))))

(defn dart-tf-x-is-object? [form]
  (let [rtype (dart-runtime-type-string (second form))]
    (list 'or (list '== "Map" rtype)
          (list '. rtype (list 'startsWith "_Map"))
          (list '. rtype (list 'startsWith "LinkedMap")))))

(defn dart-tf-x-is-array? [form]
  (let [rtype (dart-runtime-type-string (second form))]
    (list 'or (list '. rtype (list 'startsWith "List"))
          (list '. rtype (list 'startsWith "_GrowableList")))))

