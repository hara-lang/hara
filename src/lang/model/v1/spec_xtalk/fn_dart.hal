(defn dart-tf-x-shell
  [form]
  (let [source (second form)
        root (nth form 2)
        callback (nth form 3)
        command (list ':?
                      (list 'or (list '== nil root) (list '== "" root))
                      source
                      (list '+ "cd " root " && " source))
        failure (dart-call callback
                           (vector {:code (list '. 'result 'exitCode)
                                    :err (list '. 'result 'stderr)
                                    :out (list '. 'result 'stdout)}
                                   nil))
        success (dart-call callback (vector nil (list '. 'result 'stdout)))
        error (dart-call callback (vector 'error nil))]
    (list 'do
          (list 'var 'shell-command command)
          (list 'return
                (list '. (list 'Process.run "sh"
                              (list :- "<String>[\"-lc\",shell-command]"))
                      (list 'then
                            (list 'fn (vector 'result)
                                  (list 'if (list 'not= 0
                                                 (list '. 'result 'exitCode))
                                        (list 'return failure)
                                        (list 'return success))))
                      (list 'catchError
                            (list 'fn (vector 'error)
                                  (list 'return error))))))))

(def +dart-shell+
