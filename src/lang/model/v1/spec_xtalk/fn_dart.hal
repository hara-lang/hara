(defn dart-tf-x-iter-eq
  [form]
  (let [a (second form)
        b (nth form 2)
        eq-fn (nth form 3)]
    (list
     (list 'fn []
           (list 'while (list '. a (list 'moveNext))
                 (list 'if (list 'not (list '. b (list 'moveNext)))
                       (list 'return false))
                 (list 'if (list 'not
                                (list eq-fn (list '. a 'current)
                                      (list '. b 'current)))
                       (list 'return false)))
           (list 'return (list 'not (list '. b (list 'moveNext))))))))

