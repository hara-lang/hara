(ns lang.model.v1.spec-xtalk.fn-lua
  (:config {:role :internal})
  (:require [lang.model.v1.spec-lua.lua-native :as native]))

(def +lua-core+
  {
    :x-print {:raw "print" :emit :invoke}
    :x-del {:macro native/lua-x-del :emit :macro}
    :x-eval {:macro native/lua-x-eval :emit :macro}
    :x-construct {:macro native/lua-x-construct :emit :macro}
    :x-len {:macro native/lua-x-len :emit :macro}
    :x-cat {:macro native/lua-x-cat :emit :macro}
    :x-err {:raw "error" :emit :invoke}
    :x-ex-native? {:macro native/lua-ex-native :emit :macro}
    :x-ex-new {:macro native/lua-ex-new :emit :macro}
    :x-ex-message {:macro native/lua-ex-message :emit :macro}
    :x-ex-data {:macro native/lua-ex-data :emit :macro}
    :x-now-ms {:default (quote (math.floor (* 1000 (os.clock)))) :emit :unit}
    :x-unpack {:raw "unpack" :emit :invoke}
    :x-random {:raw "math.random" :emit :invoke}
    :x-apply {:macro native/lua-apply :emit :macro}})

(def +lua-global+
  {
    :x-global-has? {:macro native/lua-x-global-has :emit :macro}
    :x-global-set {:macro native/lua-x-global-set :emit :macro}
    :x-global-del {:macro native/lua-x-global-del :emit :macro}
})

(def +lua-custom+
  {
    :x-has-key? {:macro native/lua-x-has-key :emit :macro}})

(def +lua-math+
  {
    :x-m-abs {:raw "math.abs" :emit :invoke}
    :x-m-acos {:raw "math.acos" :emit :invoke}
    :x-m-asin {:raw "math.asin" :emit :invoke}
    :x-m-atan {:raw "math.atan" :emit :invoke}
    :x-m-ceil {:raw "math.ceil" :emit :invoke}
    :x-m-cos {:raw "math.cos" :emit :invoke}
    :x-m-cosh {:raw "math.cosh" :emit :invoke}
    :x-m-exp {:raw "math.exp" :emit :invoke}
    :x-m-floor {:raw "math.floor" :emit :invoke}
    :x-m-loge {:raw "math.log" :emit :invoke}
    :x-m-log10 {:raw "math.log10" :emit :invoke}
    :x-m-max {:raw "math.max" :emit :invoke}
    :x-m-min {:raw "math.min" :emit :invoke}
    :x-m-mod {:raw "%" :emit :infix}
    :x-m-pow {:raw "math.pow" :emit :invoke}
    :x-m-quot {:macro native/lua-math-quot :emit :macro}
    :x-m-sin {:raw "math.sin" :emit :invoke}
    :x-m-sinh {:raw "math.sinh" :emit :invoke}
    :x-m-sqrt {:raw "math.sqrt" :emit :invoke}
    :x-m-tan {:raw "math.tan" :emit :invoke}
    :x-m-tanh {:raw "math.tanh" :emit :invoke}})

(defn lua-tf-x-is-string?
  [form]
  (native/lua-type-predicate "string" form))

(defn lua-tf-x-is-number?
  [form]
  (native/lua-type-predicate "number" form))

(defn lua-tf-x-is-boolean?
  [form]
  (native/lua-type-predicate "boolean" form))

(defn lua-tf-x-is-function?
  [form]
  (native/lua-type-predicate "function" form))

(def +lua-type+
  {
    :x-type-native {:macro native/lua-type-native :emit :macro}
    :x-to-string {:raw "tostring" :emit :invoke}
    :x-to-number {:raw "tonumber" :emit :invoke}
    :x-is-string? {:macro lua-tf-x-is-string? :emit :macro}
    :x-is-number? {:macro lua-tf-x-is-number? :emit :macro}
    :x-is-integer? {:macro native/lua-is-integer :emit :macro}
    :x-is-boolean? {:macro lua-tf-x-is-boolean? :emit :macro}
    :x-is-function? {:macro lua-tf-x-is-function? :emit :macro}
    :x-is-object? {:macro native/lua-is-object :emit :macro}
    :x-is-array? {:macro native/lua-is-array :emit :macro}})

(def +lua-lu+
  {
    :x-lu-create {:macro native/lua-x-lu-create :emit :macro}
    :x-lu-get {:macro native/lua-x-lu-get :emit :macro}
    :x-lu-set {:macro native/lua-x-lu-set :emit :macro}
    :x-lu-del {:macro native/lua-x-lu-del :emit :macro}})

(defn lua-tf-x-bit-and
  [form]
  (native/lua-x-bit-binary :and form))

(defn lua-tf-x-bit-or
  [form]
  (native/lua-x-bit-binary :or form))

(defn lua-tf-x-bit-xor
  [form]
  (native/lua-x-bit-binary :xor form))

(def +lua-bit+
  {
    :x-bit-not {:macro native/lua-x-bit-not :emit :macro}
    :x-bit-and {:macro lua-tf-x-bit-and :emit :macro}
    :x-bit-or {:macro lua-tf-x-bit-or :emit :macro}
    :x-bit-xor {:macro lua-tf-x-bit-xor :emit :macro}
    :x-bit-lshift {:macro native/lua-x-bit-lshift :emit :macro}
    :x-bit-rshift {:macro native/lua-x-bit-rshift :emit :macro}})

(def +lua-obj+
  {
})

(def +lua-arr+
  {
    :x-arr-clone {:macro native/lua-x-arr-clone :emit :macro}
    :x-arr-slice {:macro native/lua-x-arr-slice :emit :macro}
    :x-arr-push {:raw "table.insert" :emit :invoke}
    :x-arr-pop {:raw "table.remove" :emit :invoke}
    :x-arr-push-first {:macro native/lua-x-arr-push-first :emit :macro}
    :x-arr-pop-first {:macro native/lua-x-arr-pop-first :emit :macro}
    :x-arr-remove {:macro native/lua-x-arr-remove :emit :macro}
    :x-arr-find {:macro native/lua-x-arr-find :emit :macro}
    :x-arr-insert {:macro native/lua-x-arr-insert :emit :macro}})

(def +lua-str+
  {
    :x-str-comp {:macro native/lua-x-str-comp :emit :macro}
    :x-str-char {:raw "string.byte" :emit :invoke}
    :x-str-split {:macro native/lua-x-str-split :emit :macro}
    :x-str-join {:macro native/lua-x-str-join :emit :macro}
    :x-str-index-of {:macro native/lua-x-str-index-of :emit :macro :wrappable true}
    :x-str-substring {:raw "string.sub" :emit :invoke}
    :x-str-to-upper {:raw "string.upper" :emit :invoke}
    :x-str-to-lower {:raw "string.lower" :emit :invoke}
    :x-str-to-fixed {:macro native/lua-x-str-to-fixed :emit :macro}
    :x-str-replace {:macro native/lua-x-str-replace :emit :macro}
    :x-str-trim {:macro native/lua-x-str-trim :emit :macro}
    :x-str-trim-left {:macro native/lua-x-str-trim-left :emit :macro}
    :x-str-trim-right {:macro native/lua-x-str-trim-right :emit :macro}
    :x-str-encode {:macro native/lua-x-str-encode :emit :macro}
    :x-str-decode {:macro native/lua-x-str-decode :emit :macro}})

(def +lua-bytes+
  {
    :x-bytes-new {:macro native/lua-x-bytes-new :emit :macro :type :template}
    :x-bytes-get {:macro native/lua-x-bytes-get :emit :macro}
    :x-bytes-set {:macro native/lua-x-bytes-set :emit :macro}
    :x-bytes-copy {:macro native/lua-x-bytes-copy :emit :macro :type :template}
    :x-bytes-slice {:macro native/lua-x-bytes-slice :emit :macro :type :template}
    :x-bytes-u8 {:macro native/lua-x-bytes-u8 :emit :macro}
    :x-bytes-s8 {:macro native/lua-x-bytes-s8 :emit :macro}})

(def +lua-js+
  {
    :x-json-encode {:raw "cjson.encode" :emit :invoke}
    :x-json-decode {:raw "cjson.decode" :emit :invoke}})

(def +lua-return+
  {
    :x-return-encode {:macro native/lua-return-encode :emit :macro}
    :x-return-wrap {:macro native/lua-return-wrap :emit :macro}
    :x-return-eval {:macro native/lua-return-eval :emit :macro}})

(defn lua-tf-x-socket-connect
  [form]
  (let [host (nth form 1)
        port (nth form 2)
        cb (nth form 4)]
    (list 'do*
          (list 'when (list '== host "host.docker.internal")
                (list 'var 'handle
                      (list '. 'io
                            (list 'popen
                                  (list 'cat
                                        "ping host.docker.internal -c 1 -q 2>&1"
                                        " | "
                                        "grep -Po \"(\\d{1,3}\\.){3}\\d{1,3}\""))))
                (list ':= host (list '. 'handle (list 'read "*a")))
                (list ':= host
                      (list 'string.sub host 1
                            (list '- (list 'len host) 1)))
                (list '. 'handle (list 'close)))
          (list 'var 'socket (list 'require "socket"))
          (list 'var (list 'quote ['conn 'err])
                (list '. 'socket (list 'connect host port)))
          (list 'if 'err
                (list 'return (list cb 'err nil))
                (list 'return (list cb nil 'conn))))))

(defn lua-tf-x-socket-send
  [form]
  (list '. (nth form 1)
        (list 'send (list 'x:str-decode (nth form 2)))))

(defn lua-tf-x-socket-close
  [form]
  (list '. (nth form 1) (list 'close)))

(def +lua-socket+
  {
    :x-socket-connect {:macro lua-tf-x-socket-connect :emit :macro
                       :op-spec {:allow-blocks true}}
    :x-socket-send {:macro lua-tf-x-socket-send :emit :macro}
    :x-socket-close {:macro lua-tf-x-socket-close :emit :macro}})

(def +lua-iter+
  {
    :x-iter-from-obj {:macro native/lua-x-iter-from-obj :emit :macro}
    :x-iter-from-arr {:macro native/lua-x-iter-from-arr :emit :macro}
    :x-iter-from {:macro native/lua-x-iter-from :emit :macro}
    :x-iter-eq {:macro native/lua-x-iter-eq :emit :macro :op-spec {:allow-blocks true}}
    :x-iter-null {:default (quote (coroutine.wrap (fn []))) :emit :unit}
    :x-iter-next {:macro native/lua-x-iter-next :emit :macro}
    :x-iter-has? {:macro native/lua-x-iter-has :emit :macro}
    :x-iter-native? {:macro native/lua-x-iter-native :emit :macro}})

(def +lua-promise+
  {
    :x-async-run {:macro native/lua-async-run :emit :macro}
    :x-with-delay {:emit :hard-link
                   :raw 'xt.lang.common-promise/with-delay}})

(def +lua-file+
  {
    :x-file-resolve {:macro native/lua-x-file-resolve :emit :macro}
    :x-file-read {:macro native/lua-x-file-read :emit :macro}
    :x-file-write {:macro native/lua-x-file-write :emit :macro}})

(def +lua-shell+
  {
    :x-pwd {:macro native/lua-x-pwd :emit :macro}
    :x-shell {:macro native/lua-x-shell :emit :macro :op-spec {:allow-blocks true}}})

(def +lua+
  (merge +lua-core+
         +lua-global+
         +lua-custom+
         +lua-math+
         +lua-type+
         +lua-lu+
         +lua-bit+
         +lua-obj+
         +lua-arr+
         +lua-str+
         +lua-bytes+
         +lua-js+
         +lua-return+
         +lua-socket+
         +lua-iter+
         +lua-promise+
         +lua-file+
         +lua-shell+))
