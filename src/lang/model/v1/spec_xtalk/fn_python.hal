(defn python-tf-x-json-encode
  [[_ obj]]
  (list (quote .)
    (list (quote __import__) "json")
    (list (quote dumps) obj :separators ["," ":"])))

(defn python-tf-x-json-decode
  [[_ s]]
  (list (quote .) (list (quote __import__) "json") (list (quote loads) s)))

