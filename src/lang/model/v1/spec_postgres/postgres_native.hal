(ns lang.model.v1.spec-postgres.postgres-native
  (:require
            [lang.base.v1.grammar-spec :as spec]
            [lang.common.emit :as emit]
            [lang.common.emit-helper :as helper]
            [lang.common.grammar-api :as grammar]
            [lang.common.grammar-spec :as grammar-spec]
            [lang.common.registry :as registry]
            [lang.model.v1.spec-postgres.postgres-common :as common]
            [lang.model.v1.spec-postgres.postgres-const :as const]
            [lang.model.v1.spec-postgres.postgres-deftype :as deftype]
            [lang.model.v1.spec-postgres.postgres-enum :as enum]
            [lang.model.v1.spec-postgres.postgres-form-defrole :as role]
            [lang.model.v1.spec-postgres.postgres-form-let :as form-let]
            [lang.model.v1.spec-postgres.postgres-form-vec :as form-vec]
            [lang.model.v1.spec-postgres.postgres-partition :as partition]
            [lang.model.v1.spec-postgres.postgres-tf :as tf]
            [lang.model.v1.spec-postgres.postgres-trigger :as trigger]))

(def +language+ :postgres)
(def +tag+ :postgres)
(def +version+ "alpha")
(def +grammar-version+ spec/+version+)

(def +defn-language-tags+
  {:default "plpgsql"
   :postgres "plpgsql"
   :sql "sql"
   :js "plv8"
   :python "plpython3u"
   :lua "pllua"})

(def +pg-defnlang-types+
  {:default {:tag "plpgsql" :lang :postgres}
   :postgres {:tag "plpgsql" :lang :postgres}
   :sql {:tag "sql" :lang :postgres}
   :js {:tag "plv8" :lang :js}
   :python {:tag "plpython3u"}
   :lua {:tag "pllua"}})

(defn pg-string
  "Emits a PostgreSQL string literal."
  ([value]
   (helper/pr-single value))
  ([value grammar]
   (helper/pr-single value)))

(defn pg-symbol
  "Emits PostgreSQL identifiers using Foundation's dash-to-underscore rule."
  [value grammar context]
  (str/replace (name value) "-" "_"))

(defn pg-type-name
  [value]
  (str/upper (str/replace (name value) "-" " ")))

(defn pg-type-part
  [value]
  (cond (keyword? value) (pg-type-name value)
        (symbol? value) (pg-type-name value)
        (string? value) (str/upper value)
        (and (vector? value) (= 0 (count value))) "[]"
        (vector? value) (str "[" (str/join "," (map str value)) "]")
        :else (str value)))

(defn pg-type-output
  [values]
  (reduce
   (fn [output value]
     (let [part (pg-type-part value)]
       (if (vector? value)
         (str output part)
         (if (= "" output)
           part
           (str output " " part)))))
   ""
   (or values [])))

(defn pg-typecast
  [form grammar context]
  (str "(" (emit/*emit-fn* (nth form 1) grammar context) ")::"
       (pg-type-name (nth form 2))))

(defn pg-keyword-invoke
  [form grammar context]
  (let [values (vec form)
        target (last values)
        casts (drop 1 (reverse values))]
    (str "(" (emit/*emit-fn* target grammar context) ")::"
         (str/join " " (map pg-type-name (reverse casts))))))

(defn pg-array
  [form grammar context]
  (str "ARRAY["
       (str/join "," (map (fn [item]
                                (emit/*emit-fn* item grammar context))
                              (rest form)))
       "]"))

(defn pg-raw
  [form grammar context]
  (str (nth form 1)))

(defn pg-scalar
  [form grammar context]
  (str "(" (emit/*emit-fn* (second form) grammar context) ")"))

(defn pg-tag-string
  [value]
  (if (nil? value) "nil" (str value)))

(defn pg-throw-value
  [value tag grammar context]
  (str "RAISE EXCEPTION USING DETAIL = ("
       (emit/*emit-fn* value grammar context)
       ")::TEXT, MESSAGE = "
       (pg-string (pg-tag-string tag))))

(defn pg-map-entries
  "Emits ordered key/value pairs as a jsonb_build_object expression."
  [entries grammar context]
  (str "jsonb_build_object("
       (str/join
        ","
        (mapcat (fn [entry]
                  (let [entry-value (second entry)]
                    [(pg-string (let [key (first entry)]
                                  (if (string? key) key (name key))))
                     (if (keyword? entry-value)
                       (pg-string (str entry-value))
                       (emit/*emit-fn* entry-value grammar context))]))
                (if (map? entries)
                  (sort-by
                   (fn [entry]
                     (let [key (first entry)]
                       (cond (= :status key) 0
                             (= :tag key) 1
                             :else 2)))
                   (seq entries))
                  (seq entries))))
       ")"))

(defn pg-throw
  [form grammar context]
  (pg-throw-value (nth form 1) (nth form 2) grammar context))

(defn pg-assert
  [form grammar context]
  (let [check (nth form 1)
        tag (nth form 2)
        data (nth form 3)
        detail-entries (if (map? data)
                         (let [detail (merge {:status "error" :tag tag} data)]
                           (concat [[:status (:status detail)] [:tag (:tag detail)]]
                                   (filter (fn [entry]
                                             (and (not= :status (first entry))
                                                  (not= :tag (first entry))))
                                           (seq data))))
                         [[:status "error"] [:tag tag] [:data data]])
        detail-output (pg-map-entries detail-entries grammar context)]
    (str "IF NOT (" (emit/*emit-fn* check grammar context) ") THEN\n"
         "  RAISE EXCEPTION USING DETAIL = (" detail-output
         ")::TEXT, MESSAGE = " (pg-string (pg-tag-string tag)) ";\n"
         "END IF")))

(defn pg-stack-diagnostics
  [form grammar context]
  (str "GET STACKED DIAGNOSTICS\n"
       "  e_code := RETURNED_SQLSTATE,\n"
       "  e_msg := MESSAGE_TEXT,\n"
       "  e_detail := PG_EXCEPTION_DETAIL,\n"
       "  e_hint := PG_EXCEPTION_HINT,\n"
       "  e_context := PG_EXCEPTION_CONTEXT"))

(defn pg-reduce
  [form grammar context]
  (let [out (nth form 1)
        f (nth form 2)
        type (nth form 3)
        arr (nth form 4)]
    (str "DECLARE e " (pg-type-name type) ";\n"
         "BEGIN\n"
         "  FOREACH e IN ARRAY " (emit/*emit-fn* arr grammar context) " LOOP\n"
         "    " (emit/*emit-fn* out grammar context) " := "
         (emit/*emit-fn* (list f out 'e) grammar context) ";\n"
         "  END LOOP;\n"
         "  RETURN " (emit/*emit-fn* out grammar context) ";\n"
         "END")))

(defn pg-terminated
  [output]
  (if (str/ends-with? output ";") output (str output ";")))

(defn pg-query-output?
  [output]
  (let [trimmed (str/trim output)]
    (or (str/starts-with? trimmed "SELECT ")
        (str/starts-with? trimmed "WITH ")
        (str/starts-with? trimmed "INSERT ")
        (str/starts-with? trimmed "UPDATE ")
        (str/starts-with? trimmed "DELETE "))))

(defn pg-outer-parenthesized?
  [value]
  (if (and (str/starts-with? value "(")
           (str/ends-with? value ")"))
    (loop [index 0
           depth 0]
      (if (= index (count value))
        (= depth 0)
        (let [character (str/char-at value index)
              next-depth (cond (= character \() (+ depth 1)
                               (= character \)) (- depth 1)
                               :else depth)]
          (if (and (= next-depth 0)
                   (< index (- (count value) 1)))
            false
            (recur (+ index 1) next-depth)))))
    false))

(defn pg-return
  [form grammar context]
  (let [output (emit/emit-return form {:raw "RETURN"} grammar context)
        value-output (if (> (count output) 7) (str/slice output 7) "")]
    (cond (pg-query-output? value-output)
          (str "RETURN (" value-output ")")

          (and (emit/emit-wrappable? (second form) grammar)
               (pg-outer-parenthesized? value-output))
          (str "RETURN "
               (str/slice value-output 1 (- (count value-output) 1)))

          :else output)))

(defn pg-assignment
  [form grammar context]
  (let [target-output (emit/*emit-fn* (second form) grammar context)
        value-output (emit/*emit-fn* (nth form 2) grammar context)]
    (if (pg-query-output? value-output)
      (str value-output " INTO " target-output)
      (str target-output " := " value-output))))

(defn pg-do-plpgsql
  [form grammar context]
  (let [body (map (fn [item]
                    (str "  " (pg-terminated
                               (emit/*emit-fn* item grammar context))))
                  (rest form))]
    (str "DO $$\nBEGIN\n"
         (str/join "\n" body)
         "\nEND\n$$ LANGUAGE plpgsql")))

(defn pg-map
  "Emits host maps as jsonb_build_object expressions."
  [value grammar context]
  (pg-map-entries value grammar context))

(defn pg-column-token
  [value grammar context]
  (if (set? value)
    (let [identifier (first value)]
      (str "\"" (str/replace (str identifier) "\"" "\"\"") "\""))
    (emit/*emit-fn* value grammar context)))

(defn pg-columns
  [form grammar context]
  (str/join
   ","
   (map (fn [value] (pg-column-token value grammar context))
        (second form))))

(defn pg-tuple
  [form grammar context]
  (str "("
       (str/join
        ","
        (map (fn [value] (pg-column-token value grammar context))
             (second form)))
       ")"))

(defn pg-section-keyword
  [value]
  (let [raw (name value)]
    (cond (= value :->) "->"
          (= value :->>) "->>"
          (= value :#>>) "#>>"
          :else (str/upper (str/replace raw "-" " ")))))

(defn pg-assignment-map
  [value grammar context]
  (str/join
   ","
        (map (fn [entry]
          (let [key (first entry)
                raw (if (string? key) key (name key))]
            (str "\"" (str/replace raw "-" "_") "\" = "
                 (emit/*emit-fn* (second entry) grammar context))))
        (seq value))))

(def +condition-operators+
  {:eq "=" :not-eq "<>" :neq "<>"
   :gt ">" :gte ">=" :lt "<" :lte "<="
   :in "IN" :not-in "NOT IN"
   :like "LIKE" :ilike "ILIKE"
   :is "IS" :is-not "IS NOT"
   :is-null "IS NULL" :is-not-null "IS NOT NULL"})

(def +condition-unary-operators+ #{:is-null :is-not-null})

(defn pg-condition-entry
  [entry grammar context]
  (let [key (first entry)
        raw (if (string? key) key (name key))
        condition (second entry)
        structured (and (vector? condition)
                        (keyword? (first condition))
                        (get +condition-operators+ (first condition)))
        operator (if structured
                   (get +condition-operators+ (first condition))
                   "=")
        operand (if structured (second condition) condition)
        unary (and structured
                   (has? +condition-unary-operators+ (first condition)))]
    (str "\"" (str/replace raw "-" "_") "\" " operator
         (if unary
           ""
           (str " " (emit/*emit-fn* operand grammar context))))))

(defn pg-condition-map
  [value grammar context]
  (str/join
   " AND "
   (map (fn [entry] (pg-condition-entry entry grammar context)) (seq value))))

(defn pg-section-item
  ([value grammar context]
   (pg-section-item value nil grammar context))
  ([value clause grammar context]
   (cond (= value \\) "\n"
         (keyword? value) (pg-section-keyword value)
         (and (map? value) (or (= clause :where) (= clause :having)))
         (pg-condition-map value grammar context)
         (map? value) (pg-assignment-map value grammar context)
         :else (emit/*emit-fn* value grammar context))))

(defn pg-section
  "Emits SQL clause vectors while retaining JSON array values for data vectors."
  [value grammar context]
  (let [entry (get-in grammar [:reserved (first value)])
        emitter (:emit entry)]
    (if (fn? emitter)
      (emitter value grammar context)
      (if (and (> (count value) 0)
               (reduce (fn [found item]
                         (or found (keyword? item)))
                       false
                       value))
    (let [parts
          (loop [remaining value
                 clause nil
                 output []]
            (if (= 0 (count remaining))
              output
              (let [item (first remaining)]
                (recur (vec (rest remaining))
                       (if (keyword? item) item clause)
                       (conj output
                             (if (and (= clause :as) (vector? item))
                               (str "(" (pg-section-item item clause grammar context) ")")
                               (pg-section-item item clause grammar context)))))))]
      (str/replace
       (str/replace
        (str/replace
         (str/join " " parts)
         " \n " "\n")
        "\n " "\n")
       " \n" "\n"))
        (str "jsonb_build_array("
             (str/join "," (map (fn [item]
                                      (emit/*emit-fn* item grammar context))
                                    value))
             ")")))))

(defn pg-sym-meta
  "Normalizes historical PostgreSQL function metadata."
  [symbol]
  (let [metadata (or (meta symbol) {})
        return-type (or (get metadata :-) [:jsonb])
        language (or (get metadata :static/language)
                     (get metadata :%%)
                     :default)
        props (or (get metadata :static/props)
                  (get metadata :props)
                  [])]
    (assoc (dissoc metadata :%% :props)
           :- return-type
           :static/return return-type
           :static/language language
           :static/props props)))

(defn pg-defn-format
  "Formats a registered defn entry and retains typed input metadata."
  [form]
  (let [formatted (grammar-spec/format-defn form)
        entry-metadata (first formatted)
        normalized (second formatted)
        op (first normalized)
        symbol (second normalized)
        args (nth normalized 2)
        body (drop 3 normalized)
        source-symbol (IObjType/with-meta
                       symbol
                       (merge (or (meta symbol) {}) entry-metadata))
        symbol-metadata (assoc (pg-sym-meta source-symbol)
                               :static/input
                               (helper/emit-typed-args args {}))
        next-symbol (IObjType/with-meta symbol symbol-metadata)]
    [(merge entry-metadata symbol-metadata)
     (apply list op next-symbol args body)]))

(def pg-defnformat pg-defn-format)

(defn pg-module-static
  "Hydrates declaration metadata from a portable Tahto module record."
  [module]
  (let [static (or (:static module) {})
        schemas (or (get-in static [:all :schema]) [])
        static-schema (if (> (count schemas) 0) (first schemas) nil)
        direct-schema (:schema module)
        direct-schema (if (or (string? direct-schema)
                              (symbol? direct-schema)
                              (keyword? direct-schema))
                        direct-schema
                        nil)
        schema (or static-schema direct-schema)
        application (or (:application module)
                        (:application static))
        output {}
        output (if schema (assoc output :static/schema schema) output)
        output (if application
                 (assoc output :static/application application)
                 output)]
    output))

(defn pg-hydrate
  "Adds module-level PostgreSQL metadata to a formatted declaration."
  [form grammar context]
  (let [static (pg-module-static (:module context))
        symbol (second form)
        next-symbol (IObjType/with-meta symbol
                                       (merge (or (meta symbol) {}) static))
        next-form (apply list (first form) next-symbol (drop 2 form))]
    [static next-form]))

(defn pg-identifier-value
  [value]
  (cond (keyword? value) (name value)
        (symbol? value) (name value)
        :else (str value)))

(defn pg-ddl-value
  "Emits one portable DDL identifier, including the archived singleton-set form."
  [value]
  (let [value (if (set? value) (first value) value)]
    (str "\""
         (str/replace (pg-identifier-value value) "\"" "\"\"")
         "\"")))

(defn pg-ddl-target
  "Emits a portable DDL target, preserving dotted schema/object composition."
  [value]
  (if (and (list? value) (= '. (first value)))
    (str/join "." (map pg-ddl-value (rest value)))
    (pg-ddl-value value)))

(defn pg-create-schema
  "Emits [:create-schema :if-not-exists #{schema}] lifecycle forms."
  [form grammar context]
  (let [guarded (= :if-not-exists (nth form 1))
        schema (if guarded (nth form 2) (nth form 1))]
    (str "CREATE SCHEMA "
         (if guarded "IF NOT EXISTS " "")
         (pg-ddl-value schema))))

(defn pg-drop-schema
  "Emits [:drop-schema :if-exists #{schema} :cascade] lifecycle forms."
  [form grammar context]
  (let [guarded (= :if-exists (nth form 1))
        schema (if guarded (nth form 2) (nth form 1))
        cascade (= :cascade (last form))]
    (str "DROP SCHEMA "
         (if guarded "IF EXISTS " "")
         (pg-ddl-value schema)
         (if cascade " CASCADE" ""))))

(defn pg-create-extension
  "Emits [:create-extension :if-not-exists #{extension}] lifecycle forms."
  [form grammar context]
  (let [guarded (= :if-not-exists (nth form 1))
        extension (if guarded (nth form 2) (nth form 1))]
    (str "CREATE EXTENSION "
         (if guarded "IF NOT EXISTS " "")
         (pg-ddl-value extension))))

(defn pg-drop-extension
  "Emits [:drop-extension :if-exists #{extension} :cascade] lifecycle forms."
  [form grammar context]
  (let [guarded (= :if-exists (nth form 1))
        extension (if guarded (nth form 2) (nth form 1))
        cascade (= :cascade (last form))]
    (str "DROP EXTENSION "
         (if guarded "IF EXISTS " "")
         (pg-ddl-value extension)
         (if cascade " CASCADE" ""))))

(defn pg-drop-policy
  "Emits [:drop-policy :if-exists #{policy} :on target] lifecycle forms."
  [form grammar context]
  (let [guarded (= :if-exists (nth form 1))
        policy (if guarded (nth form 2) (nth form 1))
        index (if guarded 3 2)
        target (if (= :on (nth form index))
                 (nth form (+ index 1))
                 nil)]
    (if (nil? target)
      (throw (ex :syntax {:form form}
                 :ex/message "PostgreSQL DROP POLICY requires an :on target"))
      (str "DROP POLICY "
           (if guarded "IF EXISTS " "")
           (pg-ddl-value policy)
           " ON " (pg-ddl-target target)))))

(defn pg-drop
  "Emits [:drop type :if-exists target :cascade] pointer teardown forms."
  [form grammar context]
  (let [object-type (nth form 1)
        guarded (= :if-exists (nth form 2))
        target (if guarded (nth form 3) (nth form 2))
        cascade (= :cascade (last form))]
    (str "DROP " (pg-type-name object-type) " "
         (if guarded "IF EXISTS " "")
         (pg-ddl-target target)
         (if cascade " CASCADE" ""))))

(defn pg-ddl-roles
  "Emits one or more PostgreSQL role identifiers without quoted SQL literals."
  [value grammar context]
  (let [roles (if (and (list? value) (= 'quote (first value)))
                (second value)
                value)
        roles (if (or (vector? roles) (list? roles) (set? roles)) roles [roles])]
    (str/join "," (map (fn [role] (pg-symbol role grammar context)) roles))))

(defn pg-ddl-function-target
  "Emits the archived dotted function target used by GRANT and REVOKE forms."
  [value grammar context]
  (if (and (list? value) (= '. (first value)))
    (let [schema (second value)
          signature (nth value 2)
          function-name (first signature)
          argument-types (rest signature)]
      (str (pg-ddl-value schema)
           "."
           (pg-symbol function-name grammar context)
           "("
           (str/join "," (map pg-type-output argument-types))
           ")"))
    (pg-ddl-target value)))

(defn pg-section-position
  "Returns the position of a clause keyword in a portable section vector."
  [form clause]
  (loop [index 0]
    (if (= index (count form))
      nil
      (if (= clause (nth form index))
        index
        (recur (+ index 1))))))

(defn pg-quoted-values
  [value]
  (let [value (if (and (list? value) (= 'quote (first value))) (second value) value)
        value (if (or (vector? value) (list? value) (set? value)) value [value])]
    (str/join "," (map pg-string value))))

(defn pg-create-table
  "Emits portable CREATE TABLE sections, including partition clauses."
  [form grammar context]
  (let [guarded (= :if-not-exists (nth form 1))
        target (if guarded (nth form 2) (nth form 1))
        partition-index (pg-section-position form :partition-of)
        parent (if partition-index (nth form (+ partition-index 1)) nil)
        for-index (pg-section-position form :for)
        values (if for-index (nth form (+ for-index 3)) nil)
        partition-index-2 (pg-section-position form :partition-by)
        method (if partition-index-2 (nth form (+ partition-index-2 1)) nil)
        columns (if partition-index-2 (nth form (+ partition-index-2 2)) nil)
        default? (not (nil? (pg-section-position form :default)))]
    (str "CREATE TABLE "
         (if guarded "IF NOT EXISTS " "")
         (pg-ddl-target target)
         (if partition-index
           (if default?
             (str " PARTITION OF " (pg-ddl-target parent) " DEFAULT")
             (str " PARTITION OF " (pg-ddl-target parent)
                  (if for-index
                    (str " FOR VALUES IN (" (pg-quoted-values values) ")")
                    "")))
           "")
         (if partition-index-2
           (str " PARTITION BY " (pg-section-keyword method)
                " (" (str/join "," (map pg-ddl-target
                                           (if (and (list? columns)
                                                    (= 'quote (first columns)))
                                             (second columns)
                                             columns))) ")")
           "")
         "")))

(defn pg-clause-token
  [value]
  (cond (= value \\) ""
        (keyword? value) (pg-section-keyword value)
        (set? value) (pg-ddl-target value)
        (and (list? value) (= 'quote (first value)))
        (pg-clause-token (second value))
        (symbol? value) (pg-ddl-target value)
        :else (str value)))

(defn pg-create-index
  "Emits a portable CREATE INDEX section."
  [form grammar context]
  (let [guarded (= :if-not-exists (nth form 1))
        symbol (if guarded (nth form 2) (nth form 1))
        on-index (pg-section-position form :on)
        table (nth form (+ on-index 1))
        columns (nth form (+ on-index 2))
        columns (if (and (list? columns) (= 'quote (first columns))) (second columns) columns)
        columns (if (and (list? columns) (= 1 (count columns))
                         (vector? (first columns)))
                  (first columns)
                  columns)]
    (str "CREATE INDEX "
         (if guarded "IF NOT EXISTS " "")
         (pg-ddl-target symbol)
         " ON " (pg-ddl-target table)
         " (" (str/join "," (map pg-ddl-target columns)) ")")))

(defn pg-drop-policy-if-exists
  [form grammar context]
  (str "DROP POLICY IF EXISTS " (pg-ddl-target (nth form 1))
       " ON " (pg-ddl-target (nth form 3))))

(defn pg-create-policy
  [form grammar context]
  (let [on-index (pg-section-position form :on)
        policy (nth form 1)
        table (nth form (+ on-index 1))
        body (drop (+ on-index 2) form)]
    (str "CREATE POLICY " (pg-ddl-target policy)
         " ON " (pg-ddl-target table)
         (if (seq body)
           (str " " (str/join " " (map pg-clause-token body)))
           ""))))

(defn pg-drop-publication-if-exists
  [form grammar context]
  (str "DROP PUBLICATION IF EXISTS " (pg-ddl-target (nth form 1))))

(defn pg-create-publication
  [form grammar context]
  (str "CREATE PUBLICATION " (pg-ddl-target (nth form 1))
       (if (> (count form) 2)
         (str " " (str/join " " (map pg-clause-token (drop 2 form))))
         "")))

(defn pg-drop-subscription-if-exists
  [form grammar context]
  (str "DROP SUBSCRIPTION IF EXISTS " (pg-ddl-target (nth form 1))))

(defn pg-create-subscription
  [form grammar context]
  (str "CREATE SUBSCRIPTION " (pg-ddl-target (nth form 1))
       " CONNECTION " (pg-string (nth form 3))
       " PUBLICATION " (pg-ddl-target (nth form 5))))

(defn pg-drop-trigger-if-exists
  [form grammar context]
  (str "DROP TRIGGER IF EXISTS " (pg-ddl-target (nth form 1))
       " ON " (pg-ddl-target (nth form 3))))

(defn pg-create-trigger
  [form grammar context]
  (let [on-index (pg-section-position form :on)
        name (nth form 1)
        table (nth form (+ on-index 1))
        body (drop (+ on-index 2) form)]
    (str "CREATE TRIGGER " (pg-ddl-target name)
         " ON " (pg-ddl-target table)
         (if (seq body)
           (str " " (str/join " " (map pg-clause-token body)))
           ""))))

(defn pg-create-role
  [form grammar context]
  (str "CREATE ROLE " (pg-ddl-target (nth form 1)) " "
       (pg-section-keyword (nth form 2))))

(defn pg-drop-role
  [form grammar context]
  (str "DROP ROLE IF EXISTS " (pg-ddl-target (nth form 2))))

(defn pg-grant-usage
  [form grammar context]
  (str "GRANT USAGE ON SCHEMA " (pg-ddl-target (nth form 2))
       " TO " (pg-ddl-target (nth form 4))))

(defn pg-revoke-all-on-function
  "Emits [:revoke-all-on-function target :from-public]."
  [form grammar context]
  (str "REVOKE ALL ON FUNCTION "
       (pg-ddl-function-target (nth form 1) grammar context)
       " FROM PUBLIC"))

(defn pg-grant-execute-on-function
  "Emits [:grant-execute-on-function target :to roles]."
  [form grammar context]
  (str "GRANT EXECUTE ON FUNCTION "
       (pg-ddl-function-target (nth form 1) grammar context)
       " TO "
       (pg-ddl-roles (nth form 3) grammar context)))

(defn pg-alter-table
  "Emits the Supabase row-level-security ALTER TABLE form."
  [form grammar context]
  (str "ALTER TABLE "
       (pg-ddl-target (nth form 1))
       " ENABLE ROW LEVEL SECURITY"))

(defn pg-grant
  "Emits [:grant operations :on-table target :to roles] permission forms."
  [form grammar context]
  (let [operations (nth form 1)
        operations (if (and (list? operations) (= 'quote (first operations)))
                     (second operations)
                     operations)
        operations (if (or (vector? operations) (list? operations) (set? operations))
                     operations
                     [operations])]
    (str "GRANT "
         (str/join "," (map pg-type-name operations))
         " ON TABLE "
         (pg-ddl-target (nth form 3))
         " TO "
         (pg-ddl-roles (nth form 5) grammar context))))

(defn pg-qualified-function
  [symbol schema grammar context]
  (let [function-name (pg-symbol symbol grammar context)]
    (if schema
      (str "\"" (pg-identifier-value schema) "\"." function-name)
      function-name)))

(defn pg-argument-output
  [argument grammar context]
  (let [symbol-output (pg-symbol (:symbol argument) grammar context)
        type-output (pg-type-output (:modifiers argument))
        default-output
        (if (or (:force argument) (has? argument :value))
          (str " DEFAULT "
               (emit/*emit-fn* (:value argument) grammar context))
          "")]
    (str symbol-output
         (if (= "" type-output) "" (str " " type-output))
         default-output)))

(defn pg-argument-list
  [args grammar context]
  (let [arguments (helper/emit-typed-args args grammar)]
    (if (= 0 (count arguments))
      "()"
      (str "(\n  "
           (str/join
            ",\n  "
            (map (fn [argument]
                   (pg-argument-output argument grammar context))
                 arguments))
           "\n)"))))

(defn pg-indent
  [output]
  (str "  " (str/replace output "\n" "\n  ")))

(defn pg-let-target
  [binding]
  (if (symbol? binding) binding (last binding)))

(defn pg-let-declaration
  [binding]
  (let [target (pg-let-target binding)
        types (if (symbol? binding) [:jsonb] (butlast binding))]
    (cond (= '_ binding) nil
          (or (symbol? binding) (list? binding))
          (list 'pg:raw
                (str (str/replace (name target) "-" "_")
                     " " (pg-type-output types)))
          :else
          (throw (ex :syntax {:binding binding} :ex/message "Unsupported PostgreSQL let binding")))))

(declare pg-statement-form?)

(defn pg-let-assignment
  [binding value]
  (let [target (pg-let-target binding)]
    (cond (and (= '_ binding)
               (or (vector? value)
                   (pg-statement-form? value))) value
          (= '_ binding) [:perform value]
          (and (vector? value)
               (= [target :into] (vec (take 2 (reverse value)))))
          value
          (vector? value) (conj (conj value :into) target)
          :else (list ':= target value))))

(defn pg-let-transform
  "Transforms portable let bindings into a PL/pgSQL declaration block."
  [form]
  (let [bindings (nth form 1)
        body (drop 2 form)
        pairs (vec (partition 2 bindings))
        declarations
        (vec (filter (fn [value] (not (nil? value)))
                     (map (fn [pair]
                            (pg-let-declaration (first pair)))
                          pairs)))
        assignments
        (map (fn [pair]
               (pg-let-assignment (first pair) (second pair)))
             pairs)]
    (list 'do
          (vec (concat
                (if (= 0 (count declarations))
                  []
                  [:declare \\
                   (apply list 'do declarations)
                   \\])
                [:begin \\
                 (apply list 'do (concat assignments body))
                 \\ :end])))))

(defn pg-statement-form?
  [form]
  (and (list? form)
       (let [head (first form)]
         (or (has? #{'return 'let 'let:block 'do 'do* 'if 'when 'cond
                     'for 'while 'loop 'pg:throw 'pg:assert 'pg:do-plpgsql}
                   head)
             (and (symbol? head)
                  (namespace head)
                  (has? #{"assert" "throw"} (name head)))))))

(defn pg-plpgsql-body
  [body grammar context]
  (if (and (= 1 (count body))
           (list? (first body))
           (has? #{'let 'let:block} (first (first body))))
    (emit/*emit-fn* (first body) grammar context)
    (let [forms (vec body)
          last-index (- (count forms) 1)
          statements
          (loop [index 0
                 remaining forms
                 output []]
            (if (= 0 (count remaining))
              output
              (let [form (first remaining)
                    statement (emit/*emit-fn* form grammar context)
                    implicit-return
                    (and (= index last-index)
                         (not (pg-statement-form? form))
                         (not (vector? form)))
                    statement
                    (if implicit-return
                      (if (pg-query-output? statement)
                        (str "RETURN (" statement ")")
                        (str "RETURN " statement))
                      statement)]
                (recur (+ index 1)
                       (vec (rest remaining))
                       (conj output
                             (pg-indent (pg-terminated statement)))))))]
      (str "BEGIN"
           (if (= 0 (count statements))
             ""
             (str "\n" (str/join "\n" statements)))
           "\nEND;"))))

(defn pg-sql-body
  [body grammar context]
  (if (= 1 (count body))
    (let [raw-form (first body)
          form (if (and (list? raw-form)
                        (= 'return (first raw-form)))
                 (second raw-form)
                 raw-form)
          statement (if (vector? form) form [:select form])]
      (pg-indent
       (pg-terminated (pg-section statement grammar context))))
    (throw (ex :database {:body body} :ex/message "PostgreSQL SQL functions require one expression"))))

(defn pg-defn-body
  [language body grammar context]
  (cond (or (= language :default)
            (= language :postgres))
        (pg-plpgsql-body body grammar context)

        (= language :sql)
        (pg-sql-body body grammar context)

        :else
        (throw (ex :database {:language language} :ex/message "Portable PostgreSQL function language is unsupported"))))

(defn pg-property-output
  [props]
  (str/join " " (map pg-type-name (or props []))))

(defn pg-defn
  "Emits a complete CREATE OR REPLACE FUNCTION declaration."
  [form grammar context]
  (let [symbol (second form)
        args (nth form 2)
        body (drop 3 form)
        metadata (pg-sym-meta symbol)
        schema (get (meta symbol) :static/schema)
        return-output (pg-type-output (:static/return metadata))
        language (:static/language metadata)
        language-tag (or (get +defn-language-tags+ language)
                         (name language))
        props-output (pg-property-output (:static/props metadata))
        body-output (pg-defn-body language body grammar context)]
    (str "CREATE OR REPLACE FUNCTION "
         (pg-qualified-function symbol schema grammar context)
         (pg-argument-list args grammar context)
         " RETURNS " return-output " AS $$\n"
         body-output "\n"
         "$$ LANGUAGE '" language-tag "'"
         (if (= "" props-output) "" (str " " props-output))
         ";")))

(def +operators+
  {:override {
    :eq {:symbol #{'== '=} :raw "="}
    :mul {:raw "*" :value true}
    :not {:raw "NOT " :wrap true}
    :or {:raw "OR" :wrap true}
    :and {:raw "AND" :wrap true}
    :try {:op :try :symbol #{'try} :type :block
          :block {:main #{:body}
                  :control [[:catch {:required true :main #{:parameter :body}}]
                            [:finally {:main #{:body}}]]}}
    :while {:op :while :symbol #{'while} :type :block
            :emit form-let/pg-while-block}
    :case {:op :case :symbol #{'case} :type :block
           :emit form-let/pg-case-block}
    :seteq {:raw ":=" :value true :emit pg-assignment}
    :ret {:emit pg-return}
    :let-bind {:lower pg-let-transform
               :macro #'pg-let-transform :emit :macro}
   :defn {:format pg-defn-format
             :hydrate pg-hydrate
             :emit pg-defn
             :static/dbtype :function}
    :defrun {:hydrate pg-hydrate
             :static/return [:block]}
    :def {:emit :macro
          :format common/pg-format
          :hydrate common/pg-hydrate
          :macro common/pg-defblock}
    :for {:macro tf/pg-tf-for :emit :macro}}
   :define {
    :doblk {:op :doblk :symbol #{'do:block} :type :block
               :emit form-let/pg-do-block}
    :dosup {:op :dosup :symbol #{'do:suppress} :type :block
                  :emit form-let/pg-do-suppress}
    :doast {:op :doast :symbol #{'do:assert} :type :block
                :emit common/pg-do-assert :style/indent 1}
    :letblk {:op :letblk :symbol #{'let:block} :type :block
                :macro form-let/pg-tf-let-block :emit :macro}
    :let {:op :let :symbol #{'let} :type :block
          :macro pg-let-transform :emit :macro}
    :loop {:op :loop :symbol #{'loop} :type :block
           :emit form-let/pg-loop-block}
    :forech {:op :forech :symbol #{'for:each} :type :block
               :macro tf/pg-tf-foreach :emit :macro}
    :fdata {:op :fdata :symbol #{'>-<} :type :block
                :macro tf/pg-tf-free-data :emit :macro}
    :fvec {:op :fvec :symbol #{'---} :type :block
                  :macro tf/pg-tf-free-vec :emit :macro}
    :deftype {:op :deftype
       :symbol #{'deftype}
       :type :def
       :section :code
       :format deftype/pg-deftype-format
       :hydrate deftype/pg-deftype-hydrate
       :emit deftype/pg-deftype
       :static/dbtype :table}
    :deftrigger {:op :deftrigger
       :symbol #{'deftrigger}
       :type :def
       :section :code
       :format trigger/pg-trigger-format
       :hydrate trigger/pg-trigger-hydrate
       :emit trigger/pg-trigger
       :static/dbtype :trigger}
    :defenum {:op :defenum
       :symbol #{'defenum}
       :type :def
       :section :code
       :format enum/pg-enum-format
       :hydrate enum/pg-enum-hydrate
       :emit enum/pg-enum
       :static/dbtype :enum}
    :defconst {:op :defconst
       :symbol #{'defconst}
       :type :def
       :section :code
       :format const/pg-const-format
       :hydrate const/pg-const-hydrate
       :emit const/pg-const
       :static/dbtype :const}
    :defindex {:op :defindex
       :symbol #{'defindex 'defindex.pg}
       :type :def :section :code :emit :macro
       :format common/pg-format
       :hydrate common/pg-hydrate
       :macro common/pg-defindex
       :static/dbtype :index}
    :defpolicy {:op :defpolicy
       :symbol #{'defpolicy 'defpolicy.pg}
       :type :def :section :code :emit :macro
       :format common/pg-policy-format
       :hydrate common/pg-hydrate
       :macro common/pg-defpolicy
       :static/dbtype :policy}
    :defpublication {:op :defpublication
       :symbol #{'defpublication 'defpublication.pg}
       :type :def :section :code :emit :macro
       :format common/pg-publication-format
       :hydrate common/pg-hydrate
       :macro common/pg-defpublication
       :static/dbtype :publication}
    :defsubscription {:op :defsubscription
       :symbol #{'defsubscription 'defsubscription.pg}
       :type :def :section :code :emit :macro
       :format common/pg-subscription-format
       :hydrate common/pg-hydrate
       :macro common/pg-defsubscription
       :static/dbtype :subscription}
    :defpartition {:op :defpartition
       :symbol #{'defpartition 'defpartition.pg}
       :type :def :section :code :emit :macro
       :hydrate common/pg-hydrate
       :macro partition/pg-defpartition
       :static/dbtype :partition}
    :defrole {:op :defrole
       :symbol #{'defrole 'defrole.pg}
       :type :def :section :code :emit :macro
       :macro role/pg-defrole
       :static/dbtype :role}
    :concat {:op :concat :symbol #{'||} :raw "||" :emit :infix :value true}
    :find {:op :find :symbol #{'find} :raw "?" :emit :infix}
    :findm {:op :findm :symbol #{'findm} :raw "@>" :emit :infix}
    :remc {:op :remc :symbol #{'re} :raw "~" :emit :bi}
    :remi {:op :remi :symbol #{'re:*} :raw "~*" :emit :bi}
    :array {:op :array :symbol #{'array} :emit pg-array}
    :js {:op :js :symbol #{'js} :type :block
         :macro tf/pg-tf-js :emit :macro}
    :create-table {:op :create-table :symbol #{:create-table} :emit pg-create-table}
    :create-index {:op :create-index :symbol #{:create-index} :emit pg-create-index}
    :drop-policy-if-exists {:op :drop-policy-if-exists
                            :symbol #{:drop-policy-if-exists}
                            :emit pg-drop-policy-if-exists}
    :create-policy {:op :create-policy :symbol #{:create-policy} :emit pg-create-policy}
    :drop-publication-if-exists {:op :drop-publication-if-exists
                                 :symbol #{:drop-publication-if-exists}
                                 :emit pg-drop-publication-if-exists}
    :create-publication {:op :create-publication :symbol #{:create-publication}
                         :emit pg-create-publication}
    :drop-subscription-if-exists {:op :drop-subscription-if-exists
                                  :symbol #{:drop-subscription-if-exists}
                                  :emit pg-drop-subscription-if-exists}
    :create-subscription {:op :create-subscription :symbol #{:create-subscription}
                          :emit pg-create-subscription}
    :drop-trigger-if-exists {:op :drop-trigger-if-exists
                             :symbol #{:drop-trigger-if-exists}
                             :emit pg-drop-trigger-if-exists}
    :create-trigger {:op :create-trigger :symbol #{:create-trigger}
                     :emit pg-create-trigger}
    :create-role {:op :create-role :symbol #{:create-role} :emit pg-create-role}
    :drop-role {:op :drop-role :symbol #{:drop-role} :emit pg-drop-role}
    :grant-usage {:op :grant-usage :symbol #{:grant-usage} :emit pg-grant-usage}
    :pg-columns {:op :pg-columns :symbol #{'---} :emit pg-columns}
    :pg-tuple {:op :pg-tuple :symbol #{'>-<} :emit pg-tuple}
    :cast {:op :cast :symbol #{'++} :emit pg-typecast}
    :pg-array {:op :pg-array :symbol #{'pg:array} :emit pg-array}
    :pg-raw {:op :pg-raw :symbol #{'pg:raw} :emit pg-raw}
    :pg-scalar {:op :pg-scalar :symbol #{'pg:scalar} :emit pg-scalar}
    :pg-throw {:op :pg-throw :symbol #{'pg:throw} :emit pg-throw}
    :pg-assert {:op :pg-assert :symbol #{'pg:assert} :emit pg-assert}
    :pg-stack-diagnostics {:op :pg-stack-diagnostics
                             :symbol #{'pg:stack-diagnostics}
                             :emit pg-stack-diagnostics}
    :pg-reduce {:op :pg-reduce :symbol #{'pg:reduce} :emit pg-reduce}
    :pg-do-plpgsql {:op :pg-do-plpgsql :symbol #{'pg:do-plpgsql} :emit pg-do-plpgsql}
    :create-schema {:op :create-schema :symbol #{:create-schema} :emit pg-create-schema}
    :drop-schema {:op :drop-schema :symbol #{:drop-schema} :emit pg-drop-schema}
    :create-extension {:op :create-extension :symbol #{:create-extension} :emit pg-create-extension}
    :drop-extension {:op :drop-extension :symbol #{:drop-extension} :emit pg-drop-extension}
    :drop-policy {:op :drop-policy :symbol #{:drop-policy} :emit pg-drop-policy}
    :drop {:op :drop :symbol #{:drop} :emit pg-drop}
    :revoke-all-on-function {:op :revoke-all-on-function
                              :symbol #{:revoke-all-on-function}
                              :emit pg-revoke-all-on-function}
    :grant-execute-on-function {:op :grant-execute-on-function
                                :symbol #{:grant-execute-on-function}
                                :emit pg-grant-execute-on-function}
    :alter-table {:op :alter-table :symbol #{:alter-table} :emit pg-alter-table}
    :grant {:op :grant :symbol #{:grant} :emit pg-grant}
    :json-index {:op :json-index :symbol #{:->} :raw "->" :emit :infix :value true}
    :json-index-text {:op :json-index-text :symbol #{:->>} :raw "->>" :emit :infix :value true}
    :json-path-text {:op :json-path-text :symbol #{:#>>} :raw "#>>" :emit :infix :value true}}})

(def +emit+
  {:defaults
     {:banned #{}
      :default
      {:comment {:prefix "--"}
       :common {:start "(" :end ")" :space " " :assign ":=" :sep ","
                :statement ";" :namespace "." :newline "\n" :indent 2}
       :invoke {:start "(" :end ")" :sep "," :space ""
                :keyword-fn pg-keyword-invoke}}
      :token
      {:nil "NULL"
       :true "TRUE"
       :false "FALSE"
       :string {:quote :single :custom pg-string}
       :symbol {:namespace "."
                :emit-fn pg-symbol
                :replace {"-" "_" "?" "p_"}}}
      :data
      {:vector {:custom pg-section}
       :map {:custom pg-map}
       :set {:custom common/pg-set}}
      :block
      {:while {:parameter {:start " " :end " "}
               :body {:start "LOOP" :end "END LOOP;"}}
       :for {:parameter {:start " " :end " "}
             :body {:start "LOOP" :end "END LOOP;"}}
       :branch
       {:wrap {:start "" :end "END IF;"}
        :control
        {:default {:parameter {:start " " :end " THEN"}
                   :body {:start "" :end "" :append true}}
         :if {:raw "IF"}
         :elseif {:raw "ELSIF"}
         :else {:raw "ELSE"}}}}}})
