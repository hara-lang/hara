(ns lang.model.v1.spec-postgres.postgres-grammar
  (:require [lang.base.v1.grammar-spec :as spec]
            [lang.base.emit :as emit]
            [lang.base.emit-helper :as helper]
            [lang.base.grammar :as grammar]
            [lang.base.grammar-api :as grammar-api]
            [lang.model.v1.spec-postgres.postgres-form-vec :as form-vec]
            [lang.model.v1.spec-postgres.postgres-native :as native]
            [lang.model.v1.spec-postgres.postgres-tf :as tf]
))

(def +language+ :postgres)
(def +tag+ :postgres)
(def +grammar-version+ spec/+version+)

(defn pg-vector
  "Emits PostgreSQL vectors as JSONB data or composable SQL sections."
  [value grammar context]
  (if (:js (meta value))
    (emit/*emit-fn* (tf/pg-tf-js [nil value]) grammar context)
    (form-vec/pg-section value grammar context)))

(def +features+
  (-> (grammar/build)
      (grammar/build:override (get native/+operators+ :override))
      (grammar/build:extend (get native/+operators+ :define))))

(def +template+
  (grammar-api/emit-template
   {:template/id +tag+
    :template/version +grammar-version+
    :template/value helper/+default+}))

(def +profile+
  (grammar-api/profile
   {:profile/id +tag+
    :profile/version +grammar-version+
    :profile/operators +features+}))

(def +grammar+
  (grammar-api/definition
   {:grammar/id +tag+
    :grammar/version +grammar-version+
    :grammar/release "alpha"
    :grammar/language +language+
    :grammar/tag +tag+
    :grammar/engine {:minimum 1 :maximum 1}
    :grammar/emit-template
    {:template/id +tag+
     :template/version +grammar-version+}
    :grammar/profiles
    [{:profile/id +tag+
      :profile/version +grammar-version+}]
    :emit native/+emit+}))
