(ns lang.model.v1.spec-postgres.postgres-tf)

(def ^:dynamic *input-syms* nil)

(defn pg-js-idx
  "ignores single letter prefix"
  {:added "4.0"}
  [esym]
  (let [estr (str esym)
        estr (if (re-find #"\w-\w+" estr) (str/slice estr 2) estr)]
    (str/snake-case estr)))

(defn pg-tf-js
  "converts a map to js object"
  {:added "4.0"}
  [[_ val]]
  (let [obj-fn (letfn
                 [(obj-fn
                    [val]
                    (cond
                      (map? val) (let
                                   [arr
                                    (mapcat
                                      (fn
                                        [[k v]]
                                        [(obj-fn k) (obj-fn v)])
                                      (seq val))]
                                   (apply
                                     list
                                     'jsonb-build-object
                                     arr))
                      (vector? val) (let
                                      [arr (map obj-fn val)]
                                      (apply
                                        list
                                        'jsonb-build-array
                                        arr))
                      (keyword? val) (str/snake-case (str/tag val))
                      (set? val) (let
                                   [pairs
                                    (loop
                                      [acc []
                                       [x & more :as arr]
                                       (vec (seq val))]
                                      (cond
                                        (empty? arr) acc
                                        (keyword? x)
                                        (recur
                                          (conj
                                            acc
                                            [(str/snake-case
                                               (str/tag x))
                                             (obj-fn (first more))])
                                          (rest more))
                                        (symbol? x)
                                        (recur
                                          (conj acc [(pg-js-idx x) x])
                                          more)
                                        :else
                                        (throw
                                          (ex
                                            :generic
                                            {:value x}
                                            :ex/message
                                            "Not Valid"))))]
                                   (apply
                                     list
                                     'jsonb-build-object
                                     (apply concat pairs)))
                      :else val))]
                 obj-fn)]
    (cond
      (string? val) (str "\"" val "\"")
      (number? val) (str val)
      :else (obj-fn val))))

(defn pg-tf-for
  "creates for loop"
  {:added "4.0"}
  [[_ args & body]]
  (apply
    vector
    (seq
      (concat
        (list :FOR)
        args
        (list :LOOP)
        (list \\)
        (list
          (seq
            (concat (list \|) (list (seq (concat (list 'do) body))))))
        (list \\)
        (list :END-LOOP)
        (list \;)))))

(defn pg-tf-foreach
  "creates foreach loop"
  {:added "4.0"}
  [[_ args & body]]
  (apply
    vector
    (seq
      (concat
        (list :FOREACH)
        args
        (list :LOOP)
        (list \\)
        (list
          (seq
            (concat (list \|) (list (seq (concat (list 'do) body))))))
        (list \\)
        (list :END-LOOP)
        (list \;)))))

(defn pg-tf-loop
  "creates loop"
  {:added "4.0"}
  [[_ & body]]
  (apply
    vector
    (seq
      (concat
        (list :LOOP)
        (list \\)
        (list
          (seq
            (concat (list \|) (list (seq (concat (list 'do) body))))))
        (list \\)
        (list :END-LOOP)
        (list \;)))))

;;
;; js basic
;;

(defn pg-tf-throw
  "creates throw transform"
  {:added "4.0"}
  [[_ {:as m} tag]]
  [:raise-exception
   :using
   (list
     'quote
     [[:detail := (list :text (list '% m))]
      [:message := (str/tag tag)]])])

(defn pg-tf-error
  "creates error transform"
  {:added "4.0"}
  [[_ & [{:as m} tag]]]
  (let [m (if (map? m) m {:value m})]
    (pg-tf-throw [nil (merge {:status "error"} m) tag])))

(defn pg-tf-assert
  "creates assert transform"
  {:added "4.0"}
  [[_ chk [tag data]]]
  (let [m (if (map? data)
            (merge {:tag tag} data)
            {:tag tag, :data data})]
    (seq
      (concat
        (list 'if)
        (list
          (apply
            vector
            (seq
              (concat
                (list :NOT)
                (list
                  (seq
                    (concat
                      (list 'quote)
                      (list (seq (concat (list chk)))))))))))
        (list (pg-tf-error [nil m tag]))))))


(comment
  (env/pl (tahto.core/pg
         (let [(:jsonb out)  {}
               _  (do:reduce out || :jsonb arr)]
           (return out))))
  (env/pl (tahto.core/pg (do:reduce out || :json [{} {}]))))






;; Existing native helper surface retained during faithful transform cutover.
(defn pg-json-value
  "Recursively converts one portable value to a JSONB constructor form."
  [value]
  (cond
    (map? value)
    (apply list 'jsonb-build-object
           (mapcat (fn [entry]
                     [(pg-json-value (first entry))
                      (pg-json-value (second entry))])
                   (sort-by (fn [entry] (str (first entry))) (seq value))))

    (vector? value)
    (apply list 'jsonb-build-array (map pg-json-value value))

    (keyword? value)
    (str/snake-case (name value))

    (set? value)
    (apply list 'jsonb-build-object
           (mapcat
            (fn [entry]
              (cond
                (keyword? entry)
                [(str/snake-case (name entry)) nil]

                (symbol? entry)
                [(pg-js-idx entry) entry]

                :else
                (throw (ex :syntax {:value entry}
                           :ex/message "Invalid PostgreSQL JSONB set entry"))))
            (seq value)))

    :else value))

(defn pg-tf-free-data
  "Wraps free data in the archived quoted JSONB shape."
  [form]
  (list 'quote (list (list 'quote (vec (second form))))))

(defn pg-tf-free-vec
  "Wraps a free vector in the archived quoted shape."
  [form]
  (list 'quote (vec (second form))))
