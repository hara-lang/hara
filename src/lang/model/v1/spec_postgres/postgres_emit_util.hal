(ns lang.model.v1.spec-postgres.postgres-emit-util
  (:config {:blank true})
  (:require [lang.common.emit-helper :as helper]
            [std.foundation :refer :all]))

(defn pg-string
  "Emits a PostgreSQL string literal."
  ([value]
   (helper/pr-single value))
  ([value grammar]
   (helper/pr-single value)))

(defn pg-symbol
  "Emits PostgreSQL identifiers using Foundation's dash-to-underscore rule."
  [value grammar context]
  (str/replace (name value) "-" "_"))

(defn pg-identifier-value
  [value]
  (cond (keyword? value) (name value)
        (symbol? value) (name value)
        :else (str value)))

(defn pg-qualified-function
  [symbol schema grammar context]
  (let [function-name (pg-symbol symbol grammar context)]
    (if schema
      (str "\"" (pg-identifier-value schema) "\"." function-name)
      function-name)))
