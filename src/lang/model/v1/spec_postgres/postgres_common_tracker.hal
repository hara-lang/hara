(ns lang.model.v1.spec-postgres.postgres-common-tracker)

(defn tracker-string
  "Formats archived PostgreSQL tracker metadata."
  [tracker]
  (let [name (:name tracker)
        values (concat
                 (if (:disable tracker)
                   [[":disable" (:disable tracker)]]
                   [])
                 (if (:in tracker) [[":in" true]] [])
                 (if (:out tracker) [[":out" true]] []))
        body (str/join
               ", "
               (map
                 (fn [entry] (str (first entry) " " (second entry)))
                 values))]
    (str "#pg.tracker [" name "] {" body "}")))

(defstruct
  ^{:open true} Tracker
  []
  IDisplay
  (display [tracker] (tracker-string tracker)))

(defn add-tracker
  "call to adjust data to that of the tracker"
  {:added "4.0"}
  [params tracker spec op]
  (let [_ (if (get (:disable tracker) op)
            (throw
              (ex
                :generic
                {}
                :ex/message
                (str op " disabled for spec" {:op op, :spec spec}))))]
    (cond
      (= :ignore (:track params)) params
      (and
        (:in tracker)
        (not (:track params))
        (not (get (:ignore tracker) op))) (throw
                                            (ex
                                              :generic
                                              {:spec spec}
                                              :ex/message
                                              (str
                                                "`:track` key required for spec")))
      :else (assoc params :static/tracker tracker))))

(defn tracker-map-in
  "creates the insert map"
  {:added "4.0"}
  [{:keys [track], :as params, tracker :static/tracker}]
  (if-let [kmp (:create (:in tracker))]
    (map-vals
      (fn [k] (list :->> track (str/snake-case (name k))))
      kmp)))

(defn tracker-map-modify
  "creates the modify map"
  {:added "4.0"}
  [{:keys [track], :as params, tracker :static/tracker}]
  (if-let [kmp (:modify (:in tracker))]
    (map-vals
      (fn [k] (list :->> track (str/snake-case (name k))))
      kmp)))

;; Existing native tracker helper surface retained.
(defn tracker-map
  [tracker direction]
  (or (get-in tracker [:in direction]) {}))

(defn tracker-map-output
  [tracker direction track]
  (let [values (tracker-map tracker direction)]
    (if (seq values)
      (reduce-kv (fn [result key _]
                   (assoc result key (list :->> track (str/snake-case (name key)))))
                 {}
                 values)
      nil)))
