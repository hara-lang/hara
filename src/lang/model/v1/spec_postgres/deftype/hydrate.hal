(ns lang.model.v1.spec-postgres.deftype.hydrate
  (:require [lang.base.grammar-spec :as grammar-spec]
            [lang.model.v1.spec-postgres.deftype.common :as common]
            [lang.model.v1.spec-postgres.postgres-common :as postgres-common]
            [lang.base.util :as ut]
            [postgres.application :as app]
            [std.lib.schema :as schema]))

(def normalize-params common/normalize-params)
(def normalize-columns common/normalize-columns)
(def normalize-columns-preserve common/normalize-columns-preserve)
(def expand-fragments common/expand-fragments)
(def module-static common/module-static)
(def target-link common/target-link)
(def linked-entry common/linked-entry)
(def linked-entry-form common/linked-entry-form)
(def linked-entry-schema common/linked-entry-schema)
(def primary-descriptors common/primary-descriptors)

(defn pg-deftype-format
  "Formats a portable PostgreSQL table declaration."
  [form]
  (let [formatted (grammar-spec/format-defn form)
        definition-metadata (first formatted)
        normalized (second formatted)
        op (first normalized)
        symbol (second normalized)
        spec (nth normalized 2)
        params (normalize-params (if (> (count normalized) 3)
                                   (nth normalized 3)
                                   nil))
        symbol-host-metadata (or (meta symbol) {})
        columns (normalize-columns spec)
        symbol-metadata
        (merge symbol-host-metadata
               definition-metadata
               {:static/dbtype :table
                :static/tracker (:track symbol-host-metadata)
                :static/public (:public symbol-host-metadata)
                :static/columns columns})
        next-symbol (IObjType/with-meta symbol symbol-metadata)]
    [(merge definition-metadata symbol-metadata)
     (list op next-symbol
           (vec (mapcat identity columns))
           params)]))

(defn linked-column-attributes
  [entry column context]
  (let [form (linked-entry-form entry)
        _ (if (or (nil? form)
                  (not (= 'deftype (first form))))
            (throw (ex :database {:entry (:id entry)
                             :form form} :ex/message "Referenced PostgreSQL entry is not a table")))
        formatted (pg-deftype-format form)
        normalized (second formatted)
        symbol (second normalized)
        spec (nth normalized 2)
        metadata (or (meta symbol) {})
        raw-spec (expand-fragments (:raw metadata) context)
        prepend-spec (expand-fragments (:prepend metadata) context)
        append-spec (expand-fragments (:append metadata) context)
        columns
        (vec
         (concat
          (normalize-columns-preserve prepend-spec)
          (normalize-columns (vec (concat raw-spec spec)))
          (normalize-columns-preserve append-spec)))]
    (get (into {} columns) column)))

(defn explicit-reference
  [reference]
  (cond
    (vector? reference)
    {:schema (nth reference 0)
     :table (nth reference 1)
     :type (if (> (count reference) 2) (nth reference 2) :uuid)
     :column (or (if (> (count reference) 3)
                   (:column (nth reference 3))
                   nil)
                 :id)}

    (:current reference)
    (let [current (:current reference)]
      {:schema (:schema current)
       :table (:id current)
       :type (or (:type current) :uuid)
       :column (or (:column reference) :id)})

    (and (:schema reference) (:table reference))
    {:schema (:schema reference)
     :table (:table reference)
     :type (or (:type reference) :uuid)
     :column (or (:column reference) :id)}

    :else nil))

(defn resolve-reference
  [reference context]
  (or (explicit-reference reference)
      (let [link (or (:link reference)
                     (target-link (:ns reference) context))
            entry (if link (linked-entry context link) nil)]
        (if entry
          (let [column (or (:column reference) :id)
                attributes (linked-column-attributes entry column context)]
            (if (nil? attributes)
              (throw (ex :not-found {:reference reference
                               :column column
                               :entry (:id entry)} :ex/message "Referenced PostgreSQL table column is missing"))
              {:schema (linked-entry-schema context link entry)
               :table (:id entry)
               :type (or (:type attributes) :uuid)
               :column column}))
          (throw (ex :database {:reference reference} :ex/message "Portable PostgreSQL reference requires an explicit target or module link"))))))

(defn resolve-enum
  [enum context]
  (cond
    (and (:schema enum) (:id enum))
    {:schema (:schema enum) :id (:id enum)}

    (:current enum)
    {:schema (get-in enum [:current :schema])
     :id (get-in enum [:current :id])}

    (or (:link enum) (:ns enum))
    (let [link (or (:link enum)
                   (target-link (:ns enum) context))
          entry (if link (linked-entry context link) nil)]
      (if entry
        {:schema (linked-entry-schema context link entry)
         :id (:id entry)}
        (throw (ex :not-found {:enum enum
                         :link link} :ex/message "Referenced PostgreSQL enum is missing"))))

    :else
    (throw (ex :database {:enum enum} :ex/message "Portable PostgreSQL enum requires an explicit target or module link"))))

(defn hydrate-column
  [column attributes context]
  (cond
    (= :ref (:type attributes))
    [column (assoc attributes :ref/resolved
                   (resolve-reference (:ref attributes) context))]

    (= :enum (:type attributes))
    [column (assoc attributes :enum/resolved
                   (resolve-enum (:enum attributes) context))]

    :else
    [column attributes]))

(defn pg-deftype-hydrate
  "Hydrates schema, references, enum coordinates, and primary metadata without
   mutating a host application registry."
  [form grammar context]
  (let [op (first form)
        symbol (second form)
        spec (nth form 2)
        params (nth form 3)
        symbol-metadata (or (meta symbol) {})
        raw-spec (expand-fragments (:raw symbol-metadata) context)
        prepend-spec (expand-fragments (:prepend symbol-metadata) context)
        append-spec (expand-fragments (:append symbol-metadata) context)
        normalized-columns
        (vec
         (concat
          (normalize-columns-preserve prepend-spec)
          (normalize-columns (vec (concat raw-spec spec)))
          (normalize-columns-preserve append-spec)))
        columns (vec
                 (map (fn [pair]
                        (hydrate-column (first pair)
                                        (second pair)
                                        context))
                      normalized-columns))
        primaries (primary-descriptors columns)]
    (if (= 0 (count primaries))
      (throw (ex :database {:table symbol} :ex/message "PostgreSQL deftype requires a primary column"))
      (let [static (module-static (:module context))
            schema-primary (if (= 1 (count primaries))
                             (first primaries)
                             primaries)
            schema-seed {(keyword (str symbol)) (into {} columns)}
            metadata (merge (or (meta symbol) {})
                            static
                            {:static/dbtype :table
                             :static/schema-primary schema-primary
                             :static/schema-seed schema-seed
                             :static/columns columns})
            next-symbol (IObjType/with-meta symbol metadata)
            next-form (list op next-symbol
                            (vec (mapcat identity columns))
                            params)
            hydration (merge static
                             {:static/dbtype :table
                              :static/schema-primary schema-primary
                              :static/schema-seed schema-seed
                              :static/columns columns})]
        [hydration next-form]))))

(defn pg-deftype-hydrate-check-link
  "Checks that a link exists and has the expected PostgreSQL entry type."
  {:added "4.0"}
  [snapshot module link type]
  (let [[_ entry] (postgres-common/pg-resolve-entry link
                                           {:snapshot snapshot
                                            :module module
                                            :lang :postgres})
        dbtype (:static/dbtype entry)]
    (cond (nil? entry)
          (throw (ex :not-found {:input link}
                     :ex/message "Entry not found."))
          (not= dbtype type)
          (throw (ex :database {:type type :input entry}
                     :ex/message "Entry type not correct."))
          :else true)))

(defn pg-deftype-hydrate-link
  "Resolves a PostgreSQL hydration link against the current module or Var."
  {:added "4.0"}
  [sym module {:keys [ns] :as ref}]
  (if (= "-" (namespace ns))
    [{:section :code
      :lang :postgres
      :module (:id module)
      :id (symbol (name ns))}
     false]
    (let [resolved (Base/resolve ns)]
      (if resolved
        [(select-keys (deref resolved) [:id :module :lang :section]) true]
        (throw (ex :not-found {:input ref}
                   :ex/message "Not found"))))))

(defn pg-deftype-hydrate-process-sql
  "Resolves symbols embedded in a SQL process expression."
  {:added "4.0"}
  [sql k attrs module]
  (if (:process sql)
    (assoc sql :process
           (prewalk
            (fn [value]
              (if (symbol? value)
                (let [local (and (= "-" (namespace value))
                                 module
                                 (Base/resolve (postgres-common/pg-link-symbol
                                                {:module (:id module)
                                                 :id (symbol (name value))})))]
                  (var-sym
                   (or local
                       (Base/resolve value)
                       (throw (ex :not-found {:symbol value
                                              :col k
                                              :attrs attrs}
                                  :ex/message "Cannot resolve symbol")))))
                value))
            (:process sql)))
    sql))

(defn pg-deftype-hydrate-process-foreign
  "Resolves foreign-key links and validates referenced tables."
  {:added "4.0"}
  [foreign resolve-link-fn snapshot module]
  (map-vals
   (fn [f-spec]
     (if (:ns f-spec)
       (let [[link check] (resolve-link-fn f-spec)]
         (if (and check (not (:self f-spec)))
           (pg-deftype-hydrate-check-link snapshot module link :table))
         (merge f-spec {:ns (keyword (name (:ns f-spec)))
                        :link link}))
       f-spec))
   foreign))

(defn pg-deftype-hydrate-process-ref
  "Resolves a reference attribute and preserves explicit coordinates."
  {:added "4.0"}
  [k {:keys [ref] :as attrs} resolve-link-fn snapshot module]
  (if (vector? ref)
    [k {:type :ref
        :required true
        :ref (merge {:ns (str (first ref) "." (second ref))
                     :current {:id (second ref)
                               :schema (first ref)
                               :type (nth ref 2)}}
                    (nth ref 3))
        :scope :-/ref}]
    (let [[link check] (resolve-link-fn ref)
          next-attrs (assoc attrs :ref
                            (merge (:ref attrs)
                                   {:ns (keyword (name (:ns ref)))
                                    :link link}))]
      (if check
        (pg-deftype-hydrate-check-link snapshot module link :table))
      [k next-attrs])))

(defn pg-deftype-hydrate-process-enum
  "Resolves an enum attribute and stores its canonical link symbol."
  {:added "4.0"}
  [k attrs resolve-link-fn snapshot module]
  (let [[link check] (resolve-link-fn (:enum attrs))]
    (if check
      (pg-deftype-hydrate-check-link snapshot module link :enum))
    [k (assoc-in attrs [:enum :ns] (ut/sym-full link))]))

(defn pg-deftype-hydrate-attr
  "Hydrates one PostgreSQL column attribute."
  {:added "4.0"}
  [k {:keys [type primary sql foreign] :as attrs}
   {:keys [resolve-link-fn snapshot module capture]}]
  (let [sql (if sql (pg-deftype-hydrate-process-sql sql k attrs module))
        foreign (if foreign
                  (pg-deftype-hydrate-process-foreign foreign
                                                       resolve-link-fn
                                                       snapshot
                                                       module))
        attrs (cond-> attrs
                sql (assoc :sql sql)
                foreign (assoc :foreign foreign))]
    (if primary
      (swap! capture conj (assoc (select-keys attrs [:type :enum :ref]) :id k)))
    (cond (= :ref type)
          (pg-deftype-hydrate-process-ref k attrs resolve-link-fn snapshot module)
          (= :enum type)
          (pg-deftype-hydrate-process-enum k attrs resolve-link-fn snapshot module)
          :else [k attrs])))

(defn pg-deftype-hydrate-spec
  "Hydrates each column in a flat PostgreSQL type specification."
  {:added "4.0"}
  [spec mopts]
  (vec
   (mapcat (fn [[k attrs]]
             (pg-deftype-hydrate-attr k attrs mopts))
           (partition 2 spec))))

(defn pg-deftype-hydrate-original
  "Hydrates a PostgreSQL deftype using the original Foundation pipeline."
  {:added "4.0"}
  [[op sym spec params] grammar {:keys [module book snapshot] :as mopts}]
  (let [resolve-link-fn (fn [ref] (pg-deftype-hydrate-link sym module ref))
        capture (atom [])
        spec (pg-deftype-hydrate-spec spec {:resolve-link-fn resolve-link-fn
                                            :snapshot snapshot
                                            :module module
                                            :capture capture})
        presch (schema/schema [(keyword (str sym)) spec])
        captured @capture
        schema-primary (cond (empty? captured)
                             (throw (ex :database {}
                                        :ex/message "Primary not available"))
                             (= 1 (count captured))
                             (first captured)
                             :else captured)
        hmeta (assoc (postgres-common/pg-hydrate-module-static module)
                     :static/schema-seed presch
                     :static/schema-primary schema-primary)]
    [hmeta
     (list op (with-meta sym (merge (meta sym) hmeta)) spec params)]))

(defn pg-deftype-hydrate-hook
  "Updates the registered PostgreSQL application schema after hydration."
  {:added "4.0"}
  [entry]
  (let [schema-seed (:static/schema-seed entry)
        application (:static/application entry)
        id (:id entry)
        rec (get (into {} (map vec (partition 2 (:vec schema-seed))))
                 (keyword (str id)))]
    (doseq [name application]
      (if (not= rec (get-in (deref app/*applications*) [name :tables id]))
        (do
          (swap! app/*applications*
                 (fn [state]
                   (assoc-in
                    (assoc-in state [name :tables id] rec)
                    [name :pointers id]
                    (select-keys entry [:id :module :lang :section]))))
          (app/app-rebuild name))))
    entry))
