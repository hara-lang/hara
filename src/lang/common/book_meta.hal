(ns lang.common.book-meta)

(defn filter-values
  [value]
  (reduce-kv (fn [output key entry]
               (if entry
                 (assoc output key entry)
                 output))
             {}
             value))

(defn book-meta-string
  [value]
  (str "#book.meta "
       " "
       (vec (keys (filter-values value)))))

(defstruct BookMeta [bootstrap
                     module-import
                     module-export
                     module-link
                     has-module
                     setup-module
                     teardown-module
                     has-ptr
                     setup-ptr
                     teardown-ptr])

(defn book-meta?
  [value]
  (instance? BookMeta value))

(defn ^{:public true} book-meta
  "Creates provider-independent Book lifecycle metadata."
  [value]
  (map->BookMeta value))

(defn book-meta-data
  [value]
  (if (not (book-meta? value))
    (throw (ex :argument {:book-meta value}
               :ex/message "Expected a BookMeta value")))
  value)
