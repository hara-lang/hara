(ns lang.base.preprocess-assign
  (:require [lang.base.emit-helper :as helper]
    [lang.base.preprocess-base :as preprocess-base]
    [lang.base.preprocess-value :as value]
    [lang.base.util :as ut]
    [lang.base.grammar-spec :as spec]))

(defn process-inline-assignment
  "prepares the form for inline assignment"
  {:added "4.0"}
  [form modules mopts & [unwrapped]]
  (let [[bind-form rdecl] (cond
                            (= :inline (last form)) [(nth
                                                       form
                                                       (-
                                                         (count form)
                                                         2))
                                                     (drop-last
                                                       2
                                                       form)]
                            (-> form last meta :inline) [(last form)
                                                         (butlast
                                                           form)])
        _ (or
            bind-form
            (throw
              (ex
                :host
                {:form form}
                :ex/message
                "Not a valid inline assignment form.")))
        [f & args] bind-form
        [sym-ns sym-id] (ut/sym-pair f)
        {:keys [module]} mopts
        f-module (or
                   (if (= '- sym-ns) (:id module))
                   (get (:link module) sym-ns)
                   (if (get modules sym-ns) sym-ns))
        _ (or
            f-module
            (throw
              (ex
                :host
                {:input f, :current module, :modules (keys modules)}
                :ex/message
                "Cannot resolve Module.")))
        _ (or
            (get-in modules [f-module :code sym-id])
            (throw
              (ex
                :host
                {:input f, :form form}
                :ex/message
                "Code entry not found:")))]
    (apply
      list
      (into
        (vec rdecl)
        [(with-meta
           (apply
             list
             (cond->
               (ut/sym-full f-module sym-id)
               (not unwrapped)
               (atom))
             args)
           (assoc (or (meta bind-form) {}) :assign/inline true))]))))

(def +tail-block-heads+ '#{let do:> do when-not when let* do*})

(defn rebuild-form [form head items]
  (with-meta (apply list head items) (meta form)))

(defn rewrite-tail-return [form target]
  (let [form (if (form? form) (spec/as-list form) form)]
    (cond
      (not (form? form)) (list := target form)
      (= 'return (first form)) (list := target (second form))
      (+tail-block-heads+ (first form)) (let
                                          [head (first form)
                                           items (vec (rest form))]
                                          (case
                                            head
                                            let
                                            (let
                                              [bindings (first items)
                                               body (vec (rest items))]
                                              (rebuild-form
                                                form
                                                head
                                                (concat
                                                  [bindings]
                                                  (butlast body)
                                                  [(rewrite-tail-return
                                                     (last body)
                                                     target)])))
                                            let*
                                            (let
                                              [bindings (first items)
                                               body (vec (rest items))]
                                              (rebuild-form
                                                form
                                                head
                                                (concat
                                                  [bindings]
                                                  (butlast body)
                                                  [(rewrite-tail-return
                                                     (last body)
                                                     target)])))
                                            (rebuild-form
                                              form
                                              head
                                              (concat
                                                (butlast items)
                                                [(rewrite-tail-return
                                                   (last items)
                                                   target)]))))
      (= 'if (first form)) (let [[head test then else] form]
                             (rebuild-form
                               form
                               head
                               [test
                                (rewrite-tail-return then target)
                                (rewrite-tail-return else target)]))
      (= 'if-not (first form)) (let
                                 [[head test then else] form]
                                 (rebuild-form
                                   form
                                   head
                                   [test
                                    (rewrite-tail-return then target)
                                    (rewrite-tail-return
                                      else
                                      target)]))
      (= 'cond (first form)) (let [[head & clauses] form]
                               (rebuild-form
                                 form
                                 head
                                 (mapcat
                                   (fn
                                     [[pred expr]]
                                     [pred
                                      (rewrite-tail-return
                                        expr
                                        target)])
                                   (partition 2 clauses))))
      (= 'try (first form)) (let [head (first form)
                                  items (vec (rest form))
                                  [body handlers]
                                  (mapv
                                    vec
                                    (split-with
                                      (fn
                                        [x]
                                        (not
                                          (and
                                            (form? x)
                                            (#{'finally 'catch}
                                              (first x)))))
                                      items))
                                  body
                                  (concat
                                    (butlast body)
                                    [(rewrite-tail-return
                                       (last body)
                                       target)])
                                  handlers
                                  (map
                                    (fn
                                      [h]
                                      (if
                                        (= 'catch (first h))
                                        (rebuild-form
                                          h
                                          'catch
                                          (concat
                                            (butlast (rest h))
                                            [(rewrite-tail-return
                                               (last h)
                                               target)]))
                                        h))
                                    handlers)]
                              (rebuild-form
                                form
                                head
                                (concat body handlers)))
      :else (list := target form))))

(defn assignment-target [form grammar]
  (case
    (get-in grammar [:reserved (first form) :emit])
    :assign
    (let [[_ target value] form]
      (when value {:declare? false, :target target, :value value}))
    :def-assign
    (let [args (helper/emit-typed-args
                 (rest form)
                 grammar
                 {:shorthand (get-in grammar [:define :shorthand])})]
      (when (= 1 (count args))
        (let [{:keys [symbol value]} (first args)]
          (when value
            {:declare? true, :target symbol, :value value}))))
    nil))

(defn process-template-assignment
  "rewrites rewrite-block xtalk macros in assignment position"
  {:added "4.1"}
  ([form grammar mopts]
    (process-template-assignment form grammar nil mopts))
  ([form grammar modules mopts]
    (let [form (or
                 (when-let [{:keys [emit macro]} (get-in
                                                   grammar
                                                   [:reserved
                                                    (first form)])]
                   (when (and
                           (= :macro emit)
                           (when-let [op
                                      (:op
                                        (get-in
                                          grammar
                                          [:reserved (first form)]))]
                             (str/starts-with? (name op) "var-"))
                           macro)
                     (let [expanded (binding
                                      [preprocess-base/*macro-form*
                                       form
                                       preprocess-base/*macro-grammar*
                                       grammar
                                       preprocess-base/*macro-opts*
                                       mopts]
                                      ((if
                                         (=
                                           :std.native.Var
                                           (type macro))
                                         (deref macro)
                                         macro)
                                        form))]
                       (when (assignment-target expanded grammar)
                         (with-meta
                           expanded
                           (merge (meta form) (meta expanded)))))))
                 form)
          form (if-let [{:keys [value]} (assignment-target
                                          form
                                          grammar)]
                 (if-let [resolved (value/resolve-block-form
                                     value
                                     grammar
                                     modules
                                     mopts)]
                   (with-meta
                     (prewalk-replace {value resolved} form)
                     (meta form))
                   form)
                 form)]
      (when-let [{:keys [declare? target value]} (assignment-target
                                                   form
                                                   grammar)]
        (when-let [expanded (value/expand-value-block
                              value
                              grammar
                              modules
                              mopts)]
          (let [rewritten (rewrite-tail-return expanded target)]
            (let [migration-assignment (if
                                         declare?
                                         (with-meta
                                           (list
                                             'do
                                             (with-meta
                                               (apply
                                                 list
                                                 (concat
                                                   (butlast form)
                                                   [nil]))
                                               (meta form))
                                             rewritten)
                                           (meta form))
                                         (with-meta
                                           rewritten
                                           (meta form)))]
              (with-meta
                migration-assignment
                (assoc
                  (or (meta migration-assignment) {})
                  :assign/template-default
                  true)))))))))

(defn protect-reserved-head [form]
  (with-meta (apply list (atom (first form)) (rest form)) (meta form)))

(defstruct ProtectedHead [value])
^{:line 10, :column 22}
(defn protected-head? [value]
  (or (atom? value) (instance? ProtectedHead value)))
^{:line 11, :column 28}
(defn unwrap-protected-head [value]
  (if (atom? value) (deref value) (:value value)))
(defn fail [message data] (throw (ex :host data :ex/message message)))
