(ns lang.base.emit-special
  (:require [lang.base.book :as book]
            [lang.base.emit-common :as common]
            [lang.base.emit-data :as data]
            [lang.base.emit-helper :as helper]
            [lang.base.emit-preprocess :as preprocess]))

(defn emit-with-module-all-ids
  "emits the module given snapshot in opts"
  {:added "4.0"}
  [snapshot lang module-id allow]
  (let [book (book/book-from snapshot lang)
        module (book/get-module book module-id)
        ids (map
              :id
              (filter
                (fn [{:keys [op id]}] (and (allow op)))
                (sort-by
                  (juxt :priority :time :line)
                  (vals (:code module)))))]
    ids))

(defn emit-with-module
  "emits the module given snapshot in opts"
  {:added "4.0"}
  [_ _ [_ lang module-id] grammar {:keys [snapshot], :as mopts}]
  (let [lang (or lang (:lang mopts))
        module-id (or module-id (:id (:module mopts)))
        {:keys [key-fn allow]} (helper/get-options
                                 grammar
                                 [:default :module])
        token-opts (get-in grammar [:token :symbol])
        module-key-fn (fn [id]
                        (let [text (apply
                                     str
                                     (map
                                       (fn
                                         [ch]
                                         (get
                                           (:replace token-opts)
                                           ch
                                           ch))
                                       (seq (name id))))]
                          ((if (= :std.native.Var (type key-fn))
                             (deref key-fn)
                             key-fn)
                            text)))
        ids (emit-with-module-all-ids snapshot lang module-id allow)
        args (mapv
               (fn [id] [(module-key-fn id)
                         (symbol (name module-id) (name id))])
               ids)]
    (data/emit-table nil nil (cons 'tab args) grammar mopts)))

;;
;; EVAL and LANG
;;

(defn emit-with-preprocess
  "emits an eval form\n \n   (emit-with-preprocess '(L.core/sub 1 2)\n                         (:grammar prep/+book-min+)\n                         {:lang :lua\n                          :module   (lib/get-module +library-ext+ :lua 'L.core)\n                          :snapshot (lib/get-snapshot +library-ext+)})\n   => \"(- 1 2)\""
  {:added "4.0"}
  [form grammar {:keys [lang snapshot], :as mopts}]
  (let [book (book/book-from snapshot lang)
        [body] (preprocess/to-staging
                 (preprocess/to-input form)
                 grammar
                 (:modules book)
                 mopts)]
    (common/*emit-fn* body grammar mopts)))

(defn emit-with-eval
  "emits an eval form"
  {:added "4.0"}
  [_ _ [_ form] grammar {:keys [lang snapshot], :as mopts}]
  (let [value (if-let [namespace (:namespace mopts)]
                (eval-in-ns namespace [form])
                (eval form))]
    (emit-with-preprocess value grammar mopts)))

(defn emit-with-deref
  "emits an embedded var"
  {:added "4.0"}
  [_ _ [_ form] grammar mopts]
  (if (= 'var (first form))
    (emit-with-preprocess
      (deref
        (if-let [namespace (:namespace mopts)]
          (eval-in-ns namespace [form])
          (eval form)))
      grammar
      mopts)
    (throw
      (ex :generic {} :ex/message "Needs to be a clojure.lang.Var"))))

(defn emit-with-lang
  "emits an embedded eval"
  {:added "4.0"}
  [_ _ form grammar {:keys [snapshot], :as mopts}]
  (let [[_ {:keys [lang module], :as opts} body] form
        module (or module
                   (get-in mopts [:module :id])
                   (ns-current))
        book (or
               (book/book-from snapshot lang)
               (throw
                 (ex
                   :generic
                   {:lang lang, :available (keys snapshot)}
                   :ex/message
                   "Lang not found.")))
        {:keys [grammar]} book
        module (book/get-module book module)
        mopts (merge (assoc mopts :book book :module module) opts)
        [body] (preprocess/to-staging
                 (preprocess/to-input body)
                 grammar
                 (:modules book)
                 mopts)]
    (common/*emit-fn* body grammar mopts)))

;;
;; TESTING
;;

(defn test-special-loop
  "test step for special ops"
  {:added "4.0"}
  [form grammar mopts]
  (common/emit-common-loop form
                           grammar
                           mopts
                           (assoc common/+emit-lookup+
                                  :data data/emit-data)
                           (fn [key form grammar mopts]
                             (common/emit-op key form grammar mopts
                                             {:quote data/emit-quote
                                              :table data/emit-table
                                              :with-module emit-with-module
                                              :with-lang emit-with-lang
                                              :with-eval emit-with-eval
                                              :with-deref emit-with-deref}))))

(defn test-special-emit
  "test function for special ops"
  {:added "4.0"}
  [form grammar mopts]
  (binding [common/*emit-fn* test-special-loop]
    (test-special-loop form grammar mopts)))

(comment
  (./create-tests)
  )

(defn allowed-op? [allow op]
  (if (nil? allow)
    true
    (reduce (fn [found candidate] (or found (= candidate op)))
            false allow)))
