(ns lang.base.emit-top-level
  (:require [lang.base.emit-assign :as assign]
            [lang.base.emit-block :as block]
            [lang.base.emit-common :as common]
            [lang.base.emit-data :as data]
            [lang.base.emit-fn :as fn]
            [lang.base.emit-helper :as helper]
            [lang.base.provenance :as provenance]
            [lang.base.emit-special :as special]))

(defn transform-defclass-inner
  "transforms the body to be fn.inner and var.inner"
  {:added "4.0"}
  [body]
  (mapv
    (fn [form]
      (if (form? form)
        (cond
          (= (first form) 'fn) (apply
                                 list
                                 'fn.inner
                                 (apply
                                   list
                                   (with-meta
                                     (second form)
                                     (meta form))
                                   (drop 2 form)))
          (= (first form) 'var) (apply list 'var.inner (rest form))
          :else form)
        form))
    body))

(defn emit-def
  "creates the def string"
  {:added "3.0"}
  ([key [tag sym body :as form] grammar mopts]
    (let [{:keys [raw space assign statement], :as props} (helper/get-options
                                                            grammar
                                                            [:define
                                                             key])
          typestr (fn/emit-def-type
                    sym
                    (or
                      raw
                      ((fn [value]
                         (cond
                           (bytes? value) (str/decode-utf8 value)
                           (keyword? value) (str/to-string value)
                           (string? value) value
                           :else (pr-str value)))
                        tag))
                    grammar
                    mopts)
          sym-str (case
                    key
                    :defglobal
                    (common/emit-with-global
                      nil
                      [nil sym]
                      grammar
                      mopts)
                    (common/*emit-fn* sym grammar mopts))]
      (str
        typestr
        (if (not-empty typestr) space)
        sym-str
        space
        assign
        space
        (common/*emit-fn* body grammar mopts)
        statement))))

(defn emit-declare
  "emits declared \n \n   (emit-declare :def\n                 '(declare a b c)\n                 +grammar+\n                 {})\n   => \"def a,b,c\""
  {:added "4.0"}
  ([key [tag & syms] grammar mopts]
    (let [syms (not-empty (apply list (vec syms)))]
      (let [{:keys [raw space sep]} (helper/get-options
                                      grammar
                                      [:define key])
            pre (str (or raw tag))]
        (str
          pre
          space
          (str/join
            sep
            (common/emit-array (vec syms) grammar mopts)))))))

(defn emit-top-level
  "generic define form\n \n   (binding [common/*emit-fn* common/emit-common]\n     (emit-top-level :defn\n                     '(defn abc [a := 0]\n                        (+ 1 2 3))\n                     +grammar+\n                     {}))\n   => \"function abc(a = 0){\\n  1 + 2 + 3;\\n}\""
  {:added "3.0"}
  ([key [tag sym & more :as form] grammar mopts]
    (let [more (not-empty (apply list (vec more)))]
      (let [module-id (or
                        (:module (:entry mopts))
                        (:id (:module mopts)))
            sym (if (and
                      (not (:inner (meta sym)))
                      (or
                        (#{:full :host} (:layout mopts))
                        (= key :defglobal)))
                  (do
                    (or
                      module-id
                      (throw
                        (ex
                          :generic
                          (select-keys mopts [:module :entry])
                          :ex/message
                          "Module not found")))
                    (with-meta
                      (symbol (name module-id) (name sym))
                      (meta sym)))
                  sym)
            form (apply list tag sym more)]
        (case
          key
          :def
          (emit-def key form grammar mopts)
          :defglobal
          (emit-def key form grammar mopts)
          :defrun
          (block/emit-do (drop 2 form) grammar mopts)
          :defn
          (fn/emit-fn key form grammar mopts)
          :defgen
          (fn/emit-fn key form grammar mopts)
          :declare
          (emit-declare key form grammar mopts))))))

(def +emit-lookup+
  (assoc common/+emit-lookup+
         :data  #'data/emit-data
         :block #'block/emit-block))

(defn emit-form
  "creates a customisable emit and integrating both top-level and statements\n   ^:hiddn\n   \n   (emit-form :custom\n              '(custom 1 2 3)\n              (assoc-in +grammar+\n                        [:reserved 'custom]\n                        {:emit  (fn [_ _ _]\n                                  'CUSTOM)})\n             [])\n   => 'CUSTOM"
  {:added "4.0"}
  ([key [sym & args :as form] {:keys [reserved], :as grammar} mopts]
    (let [args (not-empty (apply list (vec args)))]
      (let [{:keys [emit type], :as props} (get reserved sym)]
        (if common/*trace* (prn form))
        (try
          (cond
            (or
              (and (fn? emit) (not (keyword? emit)))
              (= :std.native.Var (Base/type emit))) ((if
                                                       (=
                                                         :std.native.Var
                                                         (Base/type
                                                           emit))
                                                       (deref emit)
                                                       emit)
                                                      form
                                                      grammar
                                                      mopts)
            (keyword? emit) (common/emit-op
                              key
                              form
                              grammar
                              mopts
                              {:def-assign #'assign/emit-def-assign,
                               :quote #'data/emit-quote,
                               :table #'data/emit-table,
                               :with-module #'special/emit-with-module,
                               :with-lang #'special/emit-with-lang,
                               :with-eval #'special/emit-with-eval,
                               :with-deref #'special/emit-with-deref})
            :else (case
                    type
                    :fn
                    (fn/emit-fn key form grammar mopts)
                    :def
                    (emit-top-level key form grammar mopts)
                    (throw
                      (ex
                        :generic
                        {:key key,
                         :symbol sym,
                         :props props,
                         :entry (get reserved sym)}
                        :ex/message
                        "Missing key"))))
          (catch
            t
            (do
              (if common/*explode* (prn :EMIT-ERROR form t))
              (provenance/throw-with-provenance
                "lang.core emit form failed"
                (provenance/provenance
                  (:lang/provenance mopts)
                  {:lang/phase :emit/form,
                   :lang/subsystem :lang.base.emit-top-level/emit-form,
                   :lang/line
                   (or
                     (:lang/line (:lang/provenance mopts))
                     (provenance/line-of form)),
                   :lang/form form,
                   :lang/symbol sym})
                t))))))))

(defn member? [values target]
  (reduce (fn [found value] (or found (= value target))) false values))
