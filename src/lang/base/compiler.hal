(ns lang.base.compiler
  (:require [lang.base.emit :as emit]
            [lang.base.preprocess-assign :as assign]
            [lang.base.preprocess-base :as preprocess-base]
            [lang.base.preprocess-input :as input]
            [lang.base.preprocess-staging :as staging]
            [lang.base.provenance :as provenance]
            [lang.protocol.compiler :as protocol]))

(def +rewrite-phases+ [:canonical :target :staging])

(def +empty-dependencies+
  {:code #{}
   :fragment #{}
   :native {}})

;; `:tahto/*` identifiers are intentionally not a supported input vocabulary.
;; The archive compatibility mapper translated them; this native pipeline
;; rejects them at its map boundaries instead of silently retaining aliases.
(def +rejected-metadata-root+ "tahto")

(defn legacy-language-key?
  "Returns true when a key belongs to the rejected archive metadata namespace."
  [value]
  (let [key-namespace (if (keyword? value) (namespace value) nil)]
    (and key-namespace
         (or (= key-namespace +rejected-metadata-root+)
             (str/starts-with? key-namespace
                               (str +rejected-metadata-root+ "."))))))

(defn assert-canonical-map
  "Returns a metadata map after rejecting unsupported archive-key namespaces."
  [value]
  (if (map? value)
    (let [legacy (first (filter legacy-language-key? (keys value)))]
      (if legacy
        (throw
         (ex :argument
             {:key legacy :value value}
             :ex/message "Legacy Tahto metadata keys are not supported"))
        value))
    value))

(defstruct InputNormalizer [])

(extend-type InputNormalizer protocol/INormalizer
  (normalize-form [normalizer raw context]
    (input/to-input raw)))

(defn built-grammar
  "Returns the concrete grammar map from a selection or an already-built grammar."
  [selected]
  (or (:grammar selected) selected))

(defn entry-form
  "Selects the most source-faithful form retained by a compiler entry."
  [entry]
  (let [form (or (:form-raw entry)
                 (:form-input entry)
                 (:form entry))
        declaration-symbol (if (and (list? form)
                                    (symbol? (second form)))
                             (second form)
                             nil)
        declaration-metadata (or (:declaration-meta entry) {})]
    (if declaration-symbol
      (apply list
             (first form)
             (with-meta declaration-symbol
               (merge (or (meta declaration-symbol) {})
                      declaration-metadata))
             (drop 2 form))
      form)))

(defn reserved-entry
  "Returns grammar metadata for an entry operation."
  [entry selected]
  (get-in (built-grammar selected)
          [:reserved (:op entry)]))

(defstruct IdentityEntryFormatter [])

(extend-type IdentityEntryFormatter protocol/IEntryFormatter
  (format-entry [formatter entry selected context]
    (if (:form-input entry)
      entry
      (assoc entry :form-input (entry-form entry)))))

(defn format-result
  "Merges a formatter metadata/form pair or records its direct formatted form."
  [entry value]
  (if (and (vector? value) (= 2 (count value)))
    (merge entry
           (assert-canonical-map (or (first value) {}))
           {:form-input (second value)})
    (assoc entry :form-input value)))

(defstruct GrammarEntryFormatter [])

(extend-type GrammarEntryFormatter protocol/IEntryFormatter
  (format-entry [formatter entry selected context]
    (let [form (entry-form entry)
          hook (:format (reserved-entry entry selected))]
      (if (nil? form)
        (throw (ex :generic {:entry entry} :ex/message "Entry has no input form"))
        (if hook
          (format-result entry (hook form))
          (assoc entry :form-input form))))))

(defstruct IdentityEntryHydrator [])

(extend-type IdentityEntryHydrator protocol/IEntryHydrator
  (hydrate-entry [hydrator entry normalized selected context]
    {:entry entry
     :form normalized
     :contributions []}))

(defn hydration-result
  "Normalizes a grammar hydration result while preserving explicit contributions."
  [entry normalized value]
  (cond (and (map? value) (:form value))
        {:entry (merge entry
                       (assert-canonical-map (or (:metadata value) {}))
                       (assert-canonical-map (or (:entry value) {})))
         :form (:form value)
         :contributions (vec (or (:contributions value) []))}

        (and (vector? value) (= 2 (count value)))
        (let [metadata (assert-canonical-map (or (first value) {}))]
          {:entry (merge entry metadata)
           :form (second value)
           :contributions (vec (or (:lang/contributions metadata) []))})

        :else
        {:entry entry
         :form (or value normalized)
         :contributions []}))

(defstruct GrammarEntryHydrator [])

(extend-type GrammarEntryHydrator protocol/IEntryHydrator
  (hydrate-entry [hydrator entry normalized selected context]
    (let [hook (:hydrate (reserved-entry entry selected))]
      (if hook
        (hydration-result
         entry
         normalized
         (hook normalized
               (built-grammar selected)
               (assoc context :entry entry)))
        {:entry entry
         :form normalized
         :contributions []}))))

(defstruct StructuralStager [])

(extend-type StructuralStager protocol/IStager
  (stage-form [stager normalized selected context]
    {:form normalized
     :dependencies +empty-dependencies+}))

(defstruct GrammarStager [])

(defn unwrap-protected-form
  "Removes native staging head wrappers before grammar rewrites and emission."
  [form]
  (cond
    (assign/protected-head? form)
    (assign/unwrap-protected-head form)

    (std.foundation/form? form)
    (apply list (map unwrap-protected-form form))

    (vector? form)
    (vec (map unwrap-protected-form form))

    (map? form)
    (reduce-kv (fn [output key value]
                 (assoc output
                        (unwrap-protected-form key)
                        (unwrap-protected-form value)))
               {}
               form)

    (set? form)
    (set (map unwrap-protected-form form))

    :else form))

(extend-type GrammarStager protocol/IStager
  (stage-form [stager normalized selected context]
    (let [grammar (built-grammar selected)
          modules (or (:modules context)
                      (get-in context [:book :modules])
                      (:modules selected)
                      {})
          options (assoc (dissoc context :lang/provenance :lang/provenance-stack)
                         :grammar grammar)
          staged (staging/to-staging normalized grammar modules options)]
      {:form (unwrap-protected-form (nth staged 0))
       :dependencies {:code (nth staged 1)
                      :fragment (nth staged 2)
                      :native (nth staged 3)}})))

(defstruct EmptyInferencer [])

(extend-type EmptyInferencer protocol/IInferencer
  (infer-form [inferencer canonical selected context]
    {:types {}}))

(defstruct EmptyLinter [])

(extend-type EmptyLinter protocol/ILinter
  (lint-form [linter canonical inference selected context]
    []))

(defn apply-rewrite-phase
  "Runs one selected grammar rewrite phase in declared order."
  [phase form selected context]
  (reduce
   (fn [rewritten hook]
     (hook rewritten
           (assoc context
                  :grammar (:grammar selected)
                  :rewrite/phase phase
                  :lang/hook hook)))
   form
   (or (get-in selected [:rewrite phase]) [])))

(defn lower-form
  "Lowers canonical operations to target grammar forms before emission."
  [form grammar context]
  (letfn [(control-heads
            [entry]
            (reduce (fn [heads key]
                      (conj (conj heads key)
                            (if (keyword? key)
                              (symbol (name key))
                              key)))
                    #{}
                    (keys (or (get-in entry [:block :control]) {}))))

          (lower-value
            [value protected]
            (cond
              (and (sequential? value)
                   (not (vector? value)))
              (let [head (first value)
                    entry (get-in grammar [:reserved head])
                    lower (:lower entry)]
                (if (and lower (not (has? protected head)))
                  (lower-value (lower value) protected)
                  (let [base-protected (if (has? protected head)
                                         (dissoc protected head)
                                         protected)
                        controls (control-heads entry)]
                    (apply list
                           (map (fn [child]
                                  (let [child-head (if (and (sequential? child)
                                                             (not (vector? child)))
                                                     (first child)
                                                     nil)
                                        child-protected
                                        (if (and (sequential? child)
                                                 (not (vector? child))
                                                 (has? controls child-head))
                                          (conj base-protected child-head)
                                          base-protected)]
                                    (lower-value child child-protected)))
                                value)))))

              (vector? value)
              (vec (map (fn [child]
                          (lower-value child protected))
                        value))

              (map? value)
              (reduce-kv (fn [output key item]
                           (assoc output
                                  (lower-value key protected)
                                  (lower-value item protected)))
                         {}
                         value)

              (set? value)
              (set (map (fn [child]
                          (lower-value child protected))
                        value))

              :else value))]
    (lower-value form #{})))

(defstruct GrammarRewriter [])

(extend-type GrammarRewriter protocol/IRewriter
  (rewrite-form [rewriter phase form selected context]
    (let [grammar (built-grammar selected)
          rewritten (apply-rewrite-phase phase form selected context)]
      (if (= phase :target)
        (binding [preprocess-base/*macro-grammar* grammar
                  preprocess-base/*macro-opts* context]
          (lower-form rewritten grammar context))
        rewritten))))

(defn input-normalizer []
  (lang.base.compiler/InputNormalizer))

(defn identity-entry-formatter []
  (lang.base.compiler/IdentityEntryFormatter))

(defn grammar-entry-formatter []
  (lang.base.compiler/GrammarEntryFormatter))

(defn identity-entry-hydrator []
  (lang.base.compiler/IdentityEntryHydrator))

(defn grammar-entry-hydrator []
  (lang.base.compiler/GrammarEntryHydrator))

(defn structural-stager []
  (lang.base.compiler/StructuralStager))

(defn grammar-stager []
  (lang.base.compiler/GrammarStager))

(defn empty-inferencer []
  (lang.base.compiler/EmptyInferencer))

(defn empty-linter []
  (lang.base.compiler/EmptyLinter))

(defn grammar-rewriter []
  (lang.base.compiler/GrammarRewriter))

(defn phase-error-code
  "Returns the stable compiler error code for one pipeline phase."
  [phase]
  (cond (= phase :format) :lang/error-format
        (= phase :normalize) :lang/error-normalize
        (= phase :hydrate) :lang/error-hydrate
        (= phase :stage) :lang/error-stage
        (= phase :rewrite/canonical) :lang/error-rewrite-canonical
        (= phase :infer) :lang/error-infer
        (= phase :lint) :lang/error-lint
        (= phase :rewrite/target) :lang/error-rewrite-target
        (= phase :rewrite/staging) :lang/error-rewrite-staging
        (= phase :emit) :lang/error-emit
        (= phase :publish) :lang/error-publish
        :else :lang/error-compiler))

(defn phase-context
  "Attaches the exact materialized grammar provenance to one compiler phase."
  [context selected phase]
  (provenance/with-provenance
   (assoc context
          :compiler/phase phase
          :lang/phase phase
          :lang/grammar-coordinate (:coordinate selected)
          :lang/grammar-fingerprint (:fingerprint selected))
   context))

(defn run-phase
  "Runs one phase once, preserving its source provenance when it fails."
  [phase selected context function]
  (let [current (phase-context context selected phase)]
    (try
      (function current)
      (catch error
        (provenance/throw-with-provenance
         (str "Language compiler phase failed: " (name phase))
         (assoc current :lang/error-code (phase-error-code phase))
         error)))))

(defn normalize-dependencies
  "Normalizes stage dependency output into code, fragment, and native buckets."
  [dependencies]
  (cond (nil? dependencies) +empty-dependencies+
        (map? dependencies) (merge +empty-dependencies+ dependencies)
        (set? dependencies) (assoc +empty-dependencies+ :code dependencies)
        :else (throw (ex :argument {:dependencies dependencies}
                         :ex/message "Invalid staged dependencies"))))

(defn stage-result
  "Normalizes a stager return into form and dependency fields."
  [value]
  (if (and (map? value) (:form value))
    (assoc value :dependencies
           (normalize-dependencies (:dependencies value)))
    {:form value
     :dependencies +empty-dependencies+}))

(defn worklog-fields
  "Selects explicit work attribution without inferring missing metadata."
  [context]
  (select-keys context [:lang/actor :lang/source :lang/work]))

(defn worklog-event
  "Builds one ordered compiler worklog event."
  [index phase value context]
  (merge {:index index
          :phase phase
          :value value}
         (worklog-fields context)))

(defn append-event
  "Appends one compiler phase event with its next deterministic index."
  [events phase value context]
  (conj events (worklog-event (count events) phase value context)))

(defn compile-staged
  "Runs staging through emission after a normalized input has been established."
  [compiler selected context initial-stages initial-events normalized]
  (let [staged-result
        (stage-result
         (run-phase
          :stage selected context
          (fn [current]
            (protocol/stage-form (:stager compiler)
                                 normalized selected current))))
        staged (:form staged-result)
        stages (assoc initial-stages :staged staged)
        events (append-event initial-events :stage staged-result context)
        canonical
        (run-phase
         :rewrite/canonical selected context
         (fn [current]
           (protocol/rewrite-form (:rewriter compiler)
                                  :canonical staged selected current)))
        stages (assoc stages :canonical canonical)
        events (append-event events :rewrite/canonical canonical context)
        inference
        (run-phase
         :infer selected context
         (fn [current]
           (protocol/infer-form (:inferencer compiler)
                                canonical selected current)))
        events (append-event events :infer inference context)
        diagnostics
        (vec
         (run-phase
          :lint selected (assoc context :inference inference)
          (fn [current]
            (protocol/lint-form (:linter compiler)
                                canonical inference selected current))))
        events (append-event events :lint diagnostics context)
        analysis-context (assoc context
                                :inference inference
                                :diagnostics diagnostics)
        targeted
        (run-phase
         :rewrite/target selected analysis-context
         (fn [current]
           (protocol/rewrite-form (:rewriter compiler)
                                  :target canonical selected current)))
        stages (assoc stages :target targeted)
        events (append-event events :rewrite/target targeted context)
        rewritten
        (run-phase
         :rewrite/staging selected analysis-context
         (fn [current]
           (protocol/rewrite-form (:rewriter compiler)
                                  :staging targeted selected current)))
        stages (assoc stages :staging rewritten :rewritten rewritten)
        events (append-event events :rewrite/staging rewritten context)
        output
        (run-phase
         :emit selected analysis-context
         (fn [current]
           (protocol/emit-form (:emitter compiler)
                               rewritten selected current)))
        events (append-event events :emit output context)]
    {:output output
     :grammar selected
     :dependencies (:dependencies staged-result)
     :inference inference
     :diagnostics diagnostics
     :stages stages
     :provenance
     (merge
      {:grammar (:provenance selected)
       :events events
       :phases events}
      (worklog-fields context))}))

(defstruct Compiler
  [formatter normalizer hydrator stager inferencer linter rewriter emitter])

(defn ^{:public true} compiler
  "Creates a compiler over an already materialized grammar selection."
  ([] (compiler {}))
  ([components]
   (lang.base.compiler/Compiler
    (or (:formatter components) (grammar-entry-formatter))
    (or (:normalizer components) (input-normalizer))
    (or (:hydrator components) (grammar-entry-hydrator))
    (or (:stager components) (grammar-stager))
    (or (:inferencer components) (empty-inferencer))
    (or (:linter components) (empty-linter))
    (or (:rewriter components) (grammar-rewriter))
    (or (:emitter components) (emit/emitter)))))

(defn ^{:public true} compile
  "Compiles one raw form using an already materialized grammar selection."
  ([compiler raw selected]
   (compile compiler raw selected {}))
  ([compiler raw selected context]
   (protocol/compile-form compiler raw selected (assert-canonical-map context))))

(defn emit-direct
  "Emits a prepared grammar form without restaging or publishing it."
  ([form selected]
   (emit-direct form selected {}))
  ([form selected context]
   (emit/emit form selected context)))

(defn ^{:public true} compile-entry
  "Compiles one entry without publishing its returned contributions."
  ([compiler entry selected]
   (compile-entry compiler entry selected {}))
  ([compiler entry selected context]
   (protocol/compile-entry compiler
                            (assert-canonical-map entry)
                            selected
                            (assert-canonical-map context))))

(extend-type Compiler protocol/ICompiler
  (compile-form [compiler raw selected context]
    (let [context (assert-canonical-map context)
          normalized
          (run-phase
           :normalize selected context
           (fn [current]
             (protocol/normalize-form (:normalizer compiler) raw current)))
          stages {:raw raw :normalized normalized}
          events [(worklog-event 0 :normalize normalized context)]]
      (compile-staged compiler selected context stages events normalized))))

(extend-type Compiler protocol/IEntryCompiler
  (compile-entry [compiler entry selected context]
    (let [entry (assert-canonical-map entry)
          context (assert-canonical-map context)
          formatted
          (run-phase
           :format selected (assoc context :lang/entry entry)
           (fn [current]
             (protocol/format-entry (:formatter compiler)
                                    entry selected current)))
          events [(worklog-event 0 :format formatted context)]
          normalized
          (run-phase
           :normalize selected (assoc context :lang/entry formatted)
           (fn [current]
             (protocol/normalize-form (:normalizer compiler)
                                      (:form-input formatted)
                                      current)))
          events (append-event events :normalize normalized context)
          hydrated
          (run-phase
           :hydrate selected (assoc context :lang/entry formatted)
           (fn [current]
             (protocol/hydrate-entry (:hydrator compiler)
                                     formatted normalized selected current)))
          hydrated-entry (:entry hydrated)
          hydrated-form (:form hydrated)
          contributions (vec (or (:contributions hydrated) []))
          events (append-event events :hydrate hydrated context)
          result
          (compile-staged
           compiler selected
           (assoc context :lang/entry hydrated-entry)
           {:raw entry
            :formatted formatted
            :normalized normalized
            :hydrated hydrated-form}
           events
           hydrated-form)]
      (assoc result
             :entry hydrated-entry
             :contributions contributions))))

(defstruct IdentityEntryPublisher [])

(extend-type IdentityEntryPublisher protocol/IEntryPublisher
  (publish-entry [publisher entry contributions context]
    {:published false
     :entry entry
     :contributions (vec contributions)}))

(defstruct GrammarEntryPublisher [selected])

(extend-type GrammarEntryPublisher protocol/IEntryPublisher
  (publish-entry [publisher entry contributions context]
    (let [hook (:hydrate-hook (reserved-entry entry (:selected publisher)))]
      (if hook
        {:published true
         :value (hook entry)
         :entry entry
         :contributions (vec contributions)}
        {:published false
         :entry entry
         :contributions (vec contributions)}))))

(defn identity-entry-publisher []
  (lang.base.compiler/IdentityEntryPublisher))

(defn grammar-entry-publisher
  [selected]
  (lang.base.compiler/GrammarEntryPublisher selected))

(defn ^{:public true} publish
  "Explicitly publishes the contributions from a successful entry result."
  ([publisher compiled]
   (publish publisher compiled {}))
  ([publisher compiled context]
   (let [context (assert-canonical-map context)
         selected (:grammar compiled)
         entry (assert-canonical-map (:entry compiled))
         contributions (:contributions compiled)]
     (run-phase
      :publish selected (assoc context :lang/entry entry)
      (fn [current]
        (protocol/publish-entry publisher entry contributions current))))))
