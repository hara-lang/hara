(ns lang.base.emit-data
  (:require [lang.base.emit-common :as common]
            [lang.base.emit-helper :as helper]
            [lang.base.util :as ut]
            [std.lib.format.prose :as prose]))

;;
;; DATA
;;

(defn default-map-key
  "emits a default map key"
  {:added "4.0"}
  [key grammar nsp]
  (let [key-str (if (keyword? key)
                  (ut/sym-default-str key)
                  key)]
    (common/*emit-fn* key-str grammar nsp)))

(defn emit-map-key
  "emits the map key"
  {:added "4.0"}
  [form grammar mopts]
  (cond (keyword? form)
    (let [convert (or (get-in grammar [:data :map-entry :keyword]) :string)
          tok     (case
                   convert                                              :symbol
                   (symbol
                    ((fn
                      [value] (cond
                               (bytes? value)   (str/decode-utf8 value)
                               (keyword? value) (str/to-string value)
                               (string? value)  value
                               :else            (pr-str value)))
                     form))                                             :string
                   ((fn
                     [value] (cond
                              (bytes? value)   (str/decode-utf8 value)
                              (keyword? value) (str/to-string value)
                              (string? value)  value
                              :else            (pr-str value)))
                    form)                                               :keyword
                   form)]
      (common/*emit-fn* tok grammar mopts))
    :else
    (common/*emit-fn* form grammar mopts)))

(defn emit-map-entry
  "emits the map entry"
  {:added "3.0"}
  [[k v] grammar mopts]
  (let [{:keys [start
                end
                sep
                space
                assign
                key-fn
                val-fn]
         :or {key-fn emit-map-key
              val-fn common/*emit-fn*}} (helper/get-options grammar [:data :map-entry])
        val-e                           ((if (= :std.native.Var (type val-fn)) (deref val-fn) val-fn) v grammar mopts)
        val-e                           (if (prose/multi-line? val-e) (prose/indent-rest val-e 2) val-e)]
    (str start
      (str/join (str assign space)
        [((if (= :std.native.Var (type key-fn)) (deref key-fn) key-fn) k grammar mopts)
         val-e])
      end)))

(defn emit-singleline-array?
  "checks that array is all single lines\n \n   (emit-singleline-array? [\"1\" \"2\" \"3\"])\n   => true\n \n   (emit-singleline-array? [\"1\" \"\\n2\" \"3\"])\n   => false"
  {:added "4.0"}
  [body-arr]
  (and
    (every? prose/single-line? body-arr)
    (and
      (not common/*multiline*)
      (< (reduce + 0 (map count body-arr)) common/*max-len*))))

(defn emit-maybe-multibody
  "checks that array is all single lines
 
   (emit-maybe-multibody [\"1\" \"2\"] \"hello\")
   => \"2hello\"
 
   (emit-maybe-multibody [\"1\" \"2\"] \"\\nhello\")
   => \"1  \\n  hello\""
  {:added "4.0"}
  [[prefix-yes prefix-no] body & [indent]]
  (if (prose/multi-line? body)
    (str prefix-yes (prose/indent body (or indent
                                     (+ 2 common/*indent*))))
    (str prefix-no body)))

(defn emit-coll-layout
  "constructs the collection"
  {:added "4.0"}
  [key indent str-array grammar mopts]
  (let [{:as opts :keys [sep space tighten]} (helper/get-options grammar [:data key])]
    (cond (emit-singleline-array? str-array)
      (-> (str/join sep str-array) (common/wrapped-str [:data key] grammar))
      tighten
      (-> (str/join (str sep "
  ") str-array)
        (common/wrapped-str [:data key] grammar)
        (prose/indent indent))
      :else
      (-> (str "
"
            (prose/indent (str "  " (str/join (str sep "
  ") str-array) "
") indent))
        (common/wrapped-str [:data key] grammar)))))

(defn emit-coll
  "emits a collection"
  {:added "3.0"}
  ([key form grammar mopts]
   (emit-coll key form grammar mopts common/*emit-fn*))
  ([key form grammar mopts emit-fn]
   (let [indent     common/*indent*
         form      (if (map? form)
                     (sort-by  (fn [[k v]]
                                 (cond (= k :#)
                                       -1
                                       
                                       (= k :..)
                                       1

                                       :else 0))
                               (seq form))
                     form)
         str-array (binding [common/*indent* 0]
                     (common/emit-array form grammar mopts emit-fn))]
     (emit-coll-layout key indent str-array grammar mopts))))

(defn emit-data-standard
  "emits either a custom string or default coll"
  {:added "4.0"}
  [key form grammar mopts]
  (let [{:keys [custom]} (helper/get-options grammar [:data key])]
    (if custom
      ((if (= :std.native.Var (type custom)) (deref custom) custom) form
        grammar
        mopts)
      (emit-coll key form grammar mopts))))

(defn emit-data
  "main function for data forms"
  {:added "3.0"}
  [key form grammar mopts]
  (let [emit (get-in grammar [:data key :emit])]
    (cond emit
      ((if (= :std.native.Var (type emit)) (deref emit) emit) form grammar mopts)
      (= key :map-entry)
      (emit-map-entry form grammar mopts)
      :else
      (emit-data-standard key form grammar mopts))))

(defn emit-quote "emit quote structures\n \n   (emit-quote nil nil ''(1 2 3) +grammar+ {})\n   => \"(1,2,3)\"" {:added "4.0"} [key props [sym & args :as form] grammar mopts] (let [args (not-empty (apply list (vec args)))] (if (= 1 (count args)) (let [coll (first args)] (cond (vector? coll) (emit-data :free coll grammar mopts) (form? coll) (emit-data :tuple coll grammar mopts) :else (emit-data :tuple [coll] grammar mopts))) (emit-data :tuple args grammar mopts))))

(defn emit-table-group
  "gets table group
 
   (emit-table-group [:a 1 :b 2 :c :d])"
  {:added "4.0"}
  [args]
  (let [is-key (fn [x] (or (keyword? x) (and (form? x) (= :% (first x)))))]
    (loop [args (vec args) out []]
      (if (empty? args)
        out
        (let [e (first args)]
          (if (is-key e)
            (if (or (is-key (second args)) (empty? (rest args)))
              (recur (vec (rest args))
                (conj out
                  (symbol ((fn [value]
                             (cond (bytes? value)
                               (str/decode-utf8 value)
                               (keyword? value)
                               (str/to-string value)
                               (string? value)
                               value
                               :else
                               (pr-str value)))         e))))
              (recur (vec (drop 2 args)) (conj out (vec (take 2 args)))))
            (recur (vec (rest args)) (conj out e))))))))

(defn emit-table "emit quote structures\n \n   (emit-table nil nil '(tab :a 1 :b 2) +grammar+ {})\n   => \"{\\\"a\\\":1,\\\"b\\\":2}\"" {:added "4.0"} [_ _ [_ & args] grammar mopts] (let [args (not-empty (apply list (vec args)))] (let [args (emit-table-group args) entry-fn (fn [e] (if (vector? e) (emit-map-entry e grammar mopts) (common/*emit-fn* e grammar mopts))) indent common/*indent* str-array (binding [common/*indent* 0] (mapv entry-fn args))] (emit-coll-layout :map indent str-array grammar mopts))))

;;
;; TESTING
;;

(defn test-data-loop
  "emit for data structures
 
   (test-data-loop '[(+ 1 2)]
                         +grammar+
                         {})
   => \"[(+ 1 2)]\"
 
   (test-data-loop '{:a (+ 1 2)}
                         +grammar+
                         {})
   => \"{[:a (+ 1 2)]}\"
 
   (test-data-loop '#{(+ 1 2)}
                         +grammar+
                         {})
   => throws
 
   
   [:quote]
   (test-data-loop ''((+ A B) C)
                         +grammar+
                         {})
   => \"((+ A B),C)\"
 
   (test-data-loop ''[(+ A B) C]
                         +grammar+
                         {})
   => \"(+ A B),C\"
   
   [:table]
   (test-data-loop '(tab :a (+ 1 2) :b 2)
                         +grammar+
                         {})
   => \"{\\\"a\\\":(+ 1 2),\\\"b\\\":2}\"
   
   (test-data-loop '(tab 1 (+ 1 2) 3 4 5)
                         +grammar+
                         {})
   => \"{1,(+ 1 2),3,4,5}\""
  {:added "4.0" :adopt true}
  [form grammar mopts]
  (common/emit-common-loop form
                           grammar
                           mopts
                           (assoc common/+emit-lookup+
                                  :data emit-data)
                           (fn [key form grammar mopts]
                             (common/emit-op key form grammar mopts
                                             {:quote emit-quote
                                              :table emit-table}))))

(defn test-data-emit
  [form grammar mopts]
  (binding [common/*emit-fn* test-data-loop]
    (test-data-loop form grammar mopts)))

(comment

  (comment
    :quote         (emit-quote args grammar mopts)
    :table         (emit-table form grammar mopts))
  
  )

(defn multiline? [value]
  (> (count (str/split-lines value)) 1))
(defn spaces [amount]
  (str/repeat " " amount))
(defn indent-lines [value amount]
  (let [padding (spaces amount)]
    (str/join "\n"
                 (map (fn [line] (str padding line))
                      (str/split-lines value)))))
(defn indent-rest [value amount]
  (let [lines (vec (str/split-lines value))
        padding (spaces amount)]
    (if (= 0 (count lines))
      value
      (str/join "\n"
                   (concat [(first lines)]
                           (map (fn [line] (str padding line))
                                (rest lines)))))))
(defn custom-emitter
  "Resolves a stored Hara Var only at the custom-emitter invocation boundary."
  [value]
  (if (= :std.native.Var (type value))
    (deref value)
    value))
(defn table-key? [value]
  (or (keyword? value)
      (and (list? value) (= :% (first value)))))
