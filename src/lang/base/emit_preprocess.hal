(ns lang.base.emit-preprocess
  (:config {:role :default})
  (:require [lang.base.preprocess-assign :as assign]
            [lang.base.preprocess-base :as base]
            [lang.base.preprocess-input :as input]
            [lang.base.preprocess-resolve :as resolve]
            [lang.base.preprocess-staging :as staging]
            [lang.base.preprocess-value :as value]))

(defn macro-opts [] base/*macro-opts*)

(defn macro-grammar [] base/*macro-grammar*)

(defmacro with:macro-opts [options grammar & body]
  `(binding [lang.base.preprocess-base/*macro-opts* ~options
             lang.base.preprocess-base/*macro-grammar* ~grammar]
     ~@body))

(intern-in
 [to-input-form input/to-input-form]
 [to-input input/to-input]
 [eval-template-forms input/eval-template-forms]
 [value-template-args value/value-template-args]
 [value-standalone value/value-standalone]
 [process-namespaced-resolve resolve/process-namespaced-resolve]
 [process-namespaced-symbol resolve/process-namespaced-symbol]
 [get-fragment resolve/get-fragment]
 [process-standard-symbol resolve/process-standard-symbol]
 [find-natives resolve/find-natives]
 [process-inline-assignment assign/process-inline-assignment]
 [protect-reserved-head assign/protect-reserved-head]
 [to-staging-form staging/to-staging-form]
 [to-staging staging/to-staging]
 [to-resolve staging/to-resolve])
