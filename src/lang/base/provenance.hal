(ns lang.base.provenance)

(def +field-keys+
 [:lang/phase
  :lang/subsystem
  :lang/lang
  :lang/module
  :lang/namespace
  :lang/entry
  :lang/symbol
  :lang/line
  :lang/form
  :lang/hook
  :lang/grammar-coordinate
  :lang/grammar-fingerprint
  :lang/actor
  :lang/source
  :lang/work])

(defn module-id
  [module]
  (cond (map? module)
        (:id module)

        :else
        module))

(defn namespace-id [namespace]
  (cond
    (and (symbol? namespace) (ns-find namespace)) (ns-name namespace)
    :else namespace))

(defn line-of
  [value]
  (cond (nil? value)
    nil
    (map? value)
    (or (:line value)
      (line-of (:entry value))
      (line-of (:form value))
      (some-> value meta :line))
    (satisfies? IObjType value)
    (-> value meta :line)
    :else
    nil))

(defn compact
  [m]
  (reduce-kv (fn [acc k v]
               (if (nil? v)
                 acc
                 (assoc acc k v)))
             {}
             m))

(defn frame [data]
  (let [inner (or (:lang/provenance data) {})
        base (merge
               (select-keys inner +field-keys+)
               (select-keys data +field-keys+))]
    (if (empty? base)
      {}
      (let [line (or
                   (:lang/line base)
                   (line-of (:lang/entry base))
                   (line-of (:lang/form base))
                   (line-of data))]
        (compact
          (assoc
            base
            :lang/module
            (module-id (:lang/module base))
            :lang/namespace
            (namespace-id (:lang/namespace base))
            :lang/line
            line))))))

(defn provenance
  [& inputs]
  (apply merge
    (concat [{}]
      (remove empty?
        (map (fn [migration-argument-0]
               (if (map? migration-argument-0) (frame migration-argument-0) {}))
          inputs)))))

(defn provenance-stack [data]
  (let [stack (:lang/provenance-stack data)]
    (cond
      (seq stack) (->> stack (mapv frame) (remove empty?) vec)
      (map? data) (let [single (frame data)]
                    (if (empty? single) [] [single]))
      :else [])))

(defn same-site? [left right]
  (=
    (select-keys
      left
      [:lang/phase
       :lang/subsystem
       :lang/module
       :lang/namespace
       :lang/line])
    (select-keys
      right
      [:lang/phase
       :lang/subsystem
       :lang/module
       :lang/namespace
       :lang/line])))

(defn append-frame [stack current]
  (cond
    (empty? current) stack
    (and (seq stack) (same-site? (IPeekLast/peek-last stack) current)) stack
    :else (conj stack current)))

(defn with-provenance
  [mopts & inputs]
  (let [merged (apply provenance (concat [(:lang/provenance mopts)] inputs))]
    (if (empty? merged) mopts (assoc mopts :lang/provenance merged))))

(defn error-with-provenance
  [message data t]
  (let [cause-data  (ex-data t)
        current     (frame data)
        inner-stack (provenance-stack cause-data)
        stack       (append-frame (vec inner-stack) current)
        merged      (if (seq stack) (reduce merge {} (reverse stack)) {})
        wrapped?    (:lang/wrapped cause-data)
        plain-data  (dissoc data :lang/provenance :lang/provenance-stack)
        payload     (cond->
                     (merge
                      (dissoc cause-data :ex/code :ex/class :ex/message :ex/cause) plain-data
                      merged)                                                                 (seq merged)
                     (assoc :lang/provenance merged)                                          (seq stack)
                     (assoc :lang/provenance-stack stack)                                     true
                     (assoc
                      :lang/wrapped       true
                      :lang/cause-class   (try (ex-class t) (catch error nil))
                      :lang/cause-message (ex-message t))                                     (and cause-data (not wrapped?))
                     (assoc :lang/cause-data cause-data))]
    (if (map? (ex-data t))
      ((fn [migration-message migration-data migration-cause]
         (ex :generic
           migration-data
           :ex/message
           migration-message
           :ex/cause
           migration-cause))                                  (if-let [cause-message (ex-message t)] (str message ": " cause-message) message)
        payload
        t)
      ((fn [migration-message migration-data]
         (ex :generic migration-data :ex/message migration-message))  (if-let [cause-message (ex-message t)] (str message ": " cause-message) message)
        payload))))

(defn throw-with-provenance [message data t]
  (throw (error-with-provenance message data t)))
