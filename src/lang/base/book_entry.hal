(ns lang.base.book-entry
  (:require [lang.base.util :as ut]))

(defn book-entry-string
  [{:as entry :keys [id lang module section display]}]
  (if (= display :symbol)
    (str "E:" (ut/sym-full module id))
    (str "#book.entry "
      [lang section (ut/sym-full module id)]
      (if (= display :brief)
        ""
        (str " "
          (reduce-kv (fn [output key value] (if value (assoc output key value) output))
            {}
            (dissoc entry
              :section
              :id
              :module
              :declared
              :form-input
              :template
              :standalone
              :line
              :time
              :priority
              :display)))))))

(defstruct
  ^{:open true} BookEntry
  [lang
   id
   module
   section
   declared
   form
   form-input
   deps
   deps-fragment
   deps-native
   xtalk-ops
   xtalk-profiles
   polyfill-modules
   namespace
   template
   standalone
   line
   time
   priority
   display])

(defn book-entry?
  "checks if object is a book entry"
  {:added "4.0"}
  [x]
  (instance? BookEntry x))

(defn ^{:public true} book-entry "creates a book entry" {:added "4.0"} [{:keys [lang id module section form form-input deps deps-native xtalk-ops xtalk-profiles polyfill-modules namespace template standalone declared], :as m}] (let [migration-entry-input m] (with-meta (map->BookEntry (merge {:display :default} migration-entry-input)) (meta migration-entry-input))))

(defn filter-values
  [value]
  (reduce-kv (fn [output key entry]
               (if entry
                 (assoc output key entry)
                 output))
             {}
             value))

(defn book-entry-data
  [value]
  (if (not (book-entry? value))
    (throw (ex :argument {:book-entry value}
               :ex/message "Expected a BookEntry value")))
  value)

(defn entry-coordinate
  [value]
  (let [value (book-entry-data value)]
    [(:lang value) (:module value) (:section value) (:id value)]))
