(ns lang.base.emit-assign
  (:require [lang.base.emit-block :as block]
            [lang.base.emit-common :as common]
            [lang.base.emit-data :as data]
            [lang.base.emit-fn :as fn]
            [lang.base.emit-helper :as helper]
            [lang.base.emit-template :as impl-template]
            [lang.base.util :as ut]))

(def +assign-types+
  #{:assign/inline
    :assign/template
    :assign/fn})

;;
;; All will compile to a function :assign/fn that will then get executed on the symbol
;;
;; :assign/inline will work with functions
;; - it will check if function is inlineable (one var declaration, one return statement, return statement is symbol)
;; - it will do template substitution for the form
;; - preprocessor will exclude the first element of the list from deps
;; - it will always link to a code entry so if a macro in needed, tough.
;;
;; :assign/template works with macros, which will compile to a single form and have :assign out
;; as the replacement
;;
;; :assign/fn works as well but it will bypass the dependency checker so be careful.
;;

(defn emit-def-assign-inline
  "assigns an inline form directly"
  {:added "4.0"}
  [sym [link & input] grammar {:keys [lang book snapshot], :as mopts}]
  (let [input (not-empty (apply list (vec input)))]
    (let [[link-module link-id] (ut/sym-pair link)
          book (or book (get-in snapshot [lang :book]))
          entry (or
                  (when-let [entry (get-in
                                     book
                                     [:modules
                                      link-module
                                      :code
                                      link-id])]
                    (impl-template/materialize-code-entry
                      book
                      entry
                      {:lang lang,
                       :module
                       (or
                         (:module mopts)
                         (get-in book [:modules link-module]))}))
                  (throw
                    (ex
                      :generic
                      {:lang lang, :input link}
                      :ex/message
                      "Cannot find entry")))
          _ (or
              (empty? (:deps entry))
              (throw
                (ex
                  :generic
                  {:lang lang, :input link}
                  :ex/message
                  "Inline cannot have additional dependencies.")))
          [_ _ args & body] (:form entry)
          body (not-empty (apply list (vec body)))
          return-ref (atom nil)
          body (postwalk
                 (fn [form]
                   (if (form? form)
                     (cond
                       (= 'return (first form)) (if
                                                  @return-ref
                                                  (throw
                                                    (ex
                                                      :generic
                                                      {:input
                                                       @return-ref}
                                                      :ex/message
                                                      "Inline cannot have multiple returns."))
                                                  (do
                                                    (reset!
                                                      return-ref
                                                      (second form))
                                                    '<RETURN>))
                       :else (remove (fn [x] (= x '<RETURN>)) form))
                     form))
                 body)
          _ (or
              (not (coll? @return-ref))
              (throw
                (ex
                  :generic
                  {:input @return-ref}
                  :ex/message
                  "Return should be a token.")))
          assign-ref (atom nil)
          - (postwalk
              (fn [form]
                (do
                  (when (and (form? form) (= 'var (first form)))
                    (let [asym (first (filter symbol? (rest form)))]
                      (or
                        (= @return-ref asym)
                        (throw
                          (ex
                            :generic
                            {:link link, :form body}
                            :ex/message
                            "Inlined with unaccounted for declarations")))
                      (reset! assign-ref asym)))
                  form))
              body)
          asym? @assign-ref
          rsym? (symbol? @return-ref)
          smap (cond->
                 (zipmap args input)
                 (and rsym? asym?)
                 (assoc @return-ref sym))
          body (prewalk-replace smap body)]
      (if (and rsym? asym?)
        (apply list 'do* body)
        (apply
          list
          'do*
          (concat
            body
            [(list
               'var
               sym
               :=
               (if rsym? (get smap @return-ref) @return-ref))]))))))

(defn assign-options
  "gets assignment options either from value metadata or from a reserved macro entry"
  {:added "4.1"}
  [value grammar]
  (let [meta-opts (select-keys (or (meta value) {}) +assign-types+)
        reserved-opts (when (and (form? value) (symbol? (first value)))
                        (let [reserved (get-in
                                         grammar
                                         [:reserved (first value)])]
                          (when (= :macro (:emit reserved))
                            (select-keys reserved +assign-types+))))]
    (merge reserved-opts meta-opts)))

(defn assign-value
  "prepares an assignment override payload for a value"
  {:added "4.1"}
  [symbol value grammar mopts]
  (let [{inline :assign/inline,
         template :assign/template,
         assign-fn :assign/fn} (assign-options value grammar)
        reserved (when (and (form? value) (symbol? (first value)))
                   (get-in grammar [:reserved (first value)]))
        expanded (if (and
                       (= :macro (:emit reserved))
                       (or assign-fn template inline))
                   (let [macro-fn (:macro reserved)]
                     ((if (= :std.native.Var (type macro-fn))
                        (deref macro-fn)
                        macro-fn)
                       value))
                   value)]
    (cond
      assign-fn [:raw
                 ((if (= :std.native.Var (type assign-fn))
                    (deref assign-fn)
                    assign-fn)
                   symbol)]
      template [:template (prewalk-replace {template symbol} expanded)]
      inline [:inline
              (emit-def-assign-inline symbol expanded grammar mopts)])))

(defn emit-def-assign
  "emits a declare expression"
  {:added "3.0"}
  ([_ {:keys [raw], :as props} [_ & args] grammar mopts]
    (let [args (not-empty (apply list (vec args)))]
      (let [{:keys [sep space assign]} (helper/get-options
                                         grammar
                                         [:default :define])
            args (helper/emit-typed-args
                   args
                   grammar
                   {:shorthand (get-in grammar [:define :shorthand])})
            argstrs (map
                      (fn [{:keys [value symbol], :as arg}]
                        (let [custom (assign-value
                                       symbol
                                       value
                                       grammar
                                       mopts)]
                          (if custom
                            (common/*emit-fn*
                              (second custom)
                              grammar
                              mopts)
                            (fn/emit-input-default
                              arg
                              assign
                              grammar
                              mopts))))
                      args)
            vstr (str/join (str sep space) argstrs)
            rawstr (if (not-empty raw) (str raw space))]
        (str rawstr vstr)))))

;;
;;
;;

(defn test-assign-loop
  "emit do"
  {:added "4.0" :adopt true}
  [form grammar mopts]
  (common/emit-common-loop form
                           grammar
                           mopts
                           (assoc common/+emit-lookup+
                                  :data data/emit-data
                                  :block block/emit-block)
                           (fn [key form grammar mopts]
                             (case key
                               :fn (fn/emit-fn :function form grammar mopts)
                               (common/emit-op key form grammar mopts
                                               {:def-assign emit-def-assign
                                                :quote data/emit-quote
                                                :table data/emit-table})))))

(defn test-assign-emit
  "emit assign forms

   (assign/test-assign-loop (list 'var 'a := (with-meta ()
                                               {:assign/fn (fn [sym]
                                                             (list sym :as [1 2 3]))}))
                            +grammar+
                            {})
   => \"(a :as [1 2 3])\"

   (assign/test-assign-loop (list 'var 'a := (with-meta '(sym :as [1 2 3])
                                               {:assign/template 'sym}))
                            +grammar+
                            {})
   => \"(a :as [1 2 3])\"

   (assign/test-assign-loop (list 'var 'a := (with-meta '(x.core/identity-fn 1)
                                               {:assign/inline 'x.core/identity-fn}))
                            +grammar+
                            {:lang :x
                             :snapshot +snap+})
   => \"(do* (var a := 1))\"

   (assign/test-assign-loop (list 'var 'a := (with-meta '(x.core/complex-fn 1)
                                               {:assign/inline 'x.core/complex-fn}))
                            +grammar+
                            {:lang :x
                             :snapshot +snap+})
   => \"(do* (var a := 1) (:= a (+ a 1)))\""
  {:added "4.0"}
  [form grammar mopts]
  (binding [common/*emit-fn* test-assign-loop]
    (test-assign-loop form grammar mopts)))

(defn replace-form
  [replacements form]
  (let [replacement (get replacements form)]
    (if replacement
      replacement
      (cond (list? form)
            (apply list (map (fn [value] (replace-form replacements value)) form))
            (vector? form)
            (vec (map (fn [value] (replace-form replacements value)) form))
            (map? form)
            (reduce-kv (fn [output key value]
                         (assoc output
                                (replace-form replacements key)
                                (replace-form replacements value)))
                       {} form)
            :else form))))
(defn return-value
  [body]
  (reduce (fn [found form]
            (if (and (list? form) (= 'return (first form)))
              (second form)
              found))
          nil body))
(defn remove-return
  [body]
  (reduce (fn [output form]
            (if (and (list? form) (= 'return (first form)))
              output
              (conj output form)))
          [] body))
(defn modifier-output [modifier grammar mopts]
  (cond (keyword? modifier) (name modifier)
        (vector? modifier) ""
        :else (common/emit-common-loop modifier grammar mopts)))
(defn emit-input-default
  [argument assign grammar mopts]
  (let [modifiers (:modifiers argument)
        type-values (or (:type argument) [])
        prefix (reduce (fn [output value]
                         (if (vector? value) output (conj output value)))
                       [] modifiers)
        prefix (reduce (fn [output value] (conj output value))
                       prefix type-values)
        prefix-output (reduce (fn [output value]
                                (let [emitted (modifier-output value grammar mopts)]
                                  (if (= "" emitted)
                                    output
                                    (conj output emitted))))
                              [] prefix)
        symbol-output (if (:symbol argument)
                        (common/emit-common-loop (:symbol argument) grammar mopts)
                        "")
        array-output (reduce (fn [output value]
                               (if (vector? value)
                                 (str output "["
                                      (if (= 0 (count value))
                                        ""
                                        (common/emit-common-loop (first value) grammar mopts))
                                      "]")
                                 output))
                             "" modifiers)
        declaration (str/join " " (conj prefix-output symbol-output))]
    (str declaration array-output
         (if (or (:force argument) (not (nil? (:value argument))))
           (str " " assign " "
                (common/emit-common-loop (:value argument) grammar mopts))
           ""))))
