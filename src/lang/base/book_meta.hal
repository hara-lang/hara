(ns lang.base.book-meta)

(defn book-meta-string
  [{:as m :keys [lang]}]
  (str "#book.meta "
    " "
    (vec (sort (keys (reduce-kv (fn [output key value] (if value (assoc output key value) output))
                       {}
                       m))))))

(defstruct
  ^{:open true} BookMeta
  [bootstrap
   module-import
   module-export
   module-link
   has-module
   setup-module
   teardows-module
   has-ptr
   setup-ptr
   teardown-ptr])

(defn book-meta?
  "checks if object is a book meta"
  {:added "4.0"}
  [x]
  (instance? BookMeta x))

(defn ^{:public true} book-meta "creates a book meta\n \n   (book-meta {:module-export  (fn [{:keys [as]} opts]\n                                 (h/$ (return ~as)))\n               :module-import  (fn [name {:keys [as]} opts]  \n                                 (h/$ (var ~as := (require ~(str name)))))\n               :has-ptr        (fn [ptr]\n                                 (list 'not= (ut/sym-full ptr) nil))\n               :teardown-ptr   (fn [ptr]\n                                 (list := (ut/sym-full ptr) nil))})\n  => book-meta?" {:added "4.0"} [{:keys [bootstrap module-import module-export module-link has-module setup-module teardows-module has-ptr setup-ptr teardown-ptr], :as m}] (let [migration-meta-input m] (with-meta (map->BookMeta migration-meta-input) (meta migration-meta-input))))



(defn filter-values
  [value]
  (reduce-kv (fn [output key entry]
               (if entry
                 (assoc output key entry)
                 output))
             {}
             value))

(defn book-meta-data
  [value]
  (if (not (book-meta? value))
    (throw (ex :argument {:book-meta value}
               :ex/message "Expected a BookMeta value")))
  value)
