(ns hara.command
  (:require [std.package.runtime :as package]
            [tool.metaspec :as metaspec]))

(def +version+ "hara 0.1.0")

(def +usage+ "Usage: hara [--version|help|headless|specs test TARGET]")

(def +specs-coordinate+ "hara:hara/foundation.specs")

(defn spec-content
  "Reads UTF-8 specification content from the mounted versioned package."
  [path]
  (let [descriptor (package/find +specs-coordinate+)]
    (cond
      descriptor (std.native.String/decode-utf8 (package/read descriptor path))
      :else
      (throw (ex :package/specs-unavailable
                 {:ex/message "specification package is not installed"
                  :package/coordinate +specs-coordinate+})))))

(defn version-response
  [_]
  {:stdout (str +version+ "\n")
   :stderr ""
   :exit 0})

(defn help-response
  [_]
  {:stdout (str +usage+ "\n")
   :stderr ""
   :exit 0})

(defn headless-response
  [_]
  {:stdout ""
   :stderr ""
   :exit 0})

(defn ^{:public true}
  specs-conformance-report
  "Runs one supplied metaspec conformance corpus without package I/O."
  [target root artifact cases]
  (cond
    (= target "hara/metaspec-metaspec")
    (let [outcomes
          (vec
           (map
            (fn [case]
              (let [case-type (:case/type case)
                    input (:case/input case)
                    expected (:case/expected case)
                    actual
                    (cond
                      (and (= case-type :verify)
                           (= input "../metaspec-metaspec.edn"))
                      (:report/status (metaspec/conforms root {:metaspec root}))
                      (and (= case-type :verify)
                           (= input "../../../../00-unsorted/artifact/metaspec/artifact-metaspec.edn"))
                      (:report/status (metaspec/conforms artifact {:metaspec root}))
                      (= case-type :lint)
                      (let [rule-ids (set (map :rule/id (metaspec/lint input)))]
                        (cond (has? rule-ids expected) expected :else :fail))
                      (= case-type :verify)
                      (let [rule-ids (set (map :rule/id (metaspec/verify input)))]
                        (cond (has? rule-ids expected) expected :else :fail))
                      (= case-type :report)
                      (:finding/repair (first (metaspec/lint {})))
                      :else :unsupported)]
                {:case/id (:case/id case)
                 :case/expected expected
                 :case/actual actual
                 :case/status (cond (= actual expected) :pass :else :fail)}))
            cases))
          failures (count (filter (fn [outcome] (= :fail (:case/status outcome))) outcomes))]
      {:report/type :hara/specs-test
       :target target
       :report/status (cond (zero? failures) :pass :else :fail)
       :summary {:pass (- (count outcomes) failures) :fail failures}
       :cases outcomes})
    :else
    (throw (ex :specs/unsupported-target
               {:ex/message (str "unsupported specification target: " target)
                :spec/target target}))))

(defn ^{:public true}
  specs-target-report
  "Loads and runs the declared metaspec conformance cases from the mounted specs HARP."
  [target]
  (let [root (read-string (spec-content
                           "content/01-lang/000-metaspec/draft/metaspec-metaspec.edn"))
        artifact (read-string (spec-content
                               "content/00-unsorted/artifact/metaspec/artifact-metaspec.edn"))
        cases (:conformance/cases
               (read-string (spec-content
                             "content/01-lang/000-metaspec/draft/conformance/metaspec.edn")))]
    (specs-conformance-report target root artifact cases)))

(defn ^{:public true}
  specs-test-response
  "Formats a package-backed specification report as a native command response."
  [request]
  (try
    (let [target (:target (:arguments request))
          report (specs-target-report target)]
      {:stdout (str report "\n")
       :stderr ""
       :exit (cond (= :pass (:report/status report)) 0 :else 1)})
    (catch error
      {:stdout ""
       :stderr (str error "\n")
       :exit 2})))

(defn application
  "Creates one ephemeral Hara command application for an argv invocation."
  []
  (let [app (std.native.Command/create {:id 'hara/command
                                         :desc "Hara command"})]
    (std.native.Command/install app
                                {:id :version
                                 :path ["--version"]
                                 :aliases [["version"]]
                                 :desc "Print the Hara version"
                                 :handler version-response})
    (std.native.Command/install app
                                {:id :help
                                 :path []
                                 :aliases [["help"] ["--help"]]
                                 :desc "Print command usage"
                                 :handler help-response})
    (std.native.Command/install app
                                {:id :headless
                                 :path ["headless"]
                                 :desc "Start the loopback RESP companion"
                                 :options [{:id :project :type :string}
                                           {:id :root :type :string}
                                           {:id :host :type :string}
                                           {:id :port :type :string}]
                                 :handler headless-response})
    (std.native.Command/install app
                                {:id :specs-test
                                 :path ["specs" "test"]
                                 :desc "Run a packaged specification conformance target"
                                 :arguments [{:id :target :type :string}]
                                 :handler specs-test-response})
    app))

(defn normalise-argv
  "Moves a legacy trailing headless command before its global options."
  [argv]
  (cond
    (= (last argv) "headless") (vec (concat ["headless"] (drop-last argv)))
    :else argv))

(defn ^{:public true}
  main
  "Runs argv through std.native.Command and declares the RESP host action."
  [argv]
  (let [argv (normalise-argv argv)
        response (std.native.Command/run (application) {:argv argv})]
    (cond
      (and (= (first argv) "headless")
           (= (:exit response) 0)) {:hara/host-action :resp}
      :else response)))
