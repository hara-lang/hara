(ns hara.command.core
  (:config {:role :internal})
  (:require [hara.command.version :as version :lazy true]
            [hara.command.help :as help :lazy true]
            [hara.command.headless :as headless :lazy true]
            [hara.command.run :as run :lazy true]
            [hara.command.test :as test :lazy true]
            [hara.command.specs :as specs :lazy true]
            [hara.command.deploy :as deploy :lazy true]
            [hara.command.manage :as manage :lazy true]
            [hara.command.seedgen :as seedgen :lazy true]))

(defn application
  "Creates one ephemeral Hara command application for an argv invocation."
  []
  (let [app (Command/create {:id 'hara/command
                             :desc "Hara command"})]
    (Command/install app
                                {:id :version
                                 :path ["--version"]
                                 :aliases [["version"]]
                                 :desc "Print the Hara version"
                                 :handler (fn [request] (version/response request))})
    (Command/install app
                                {:id :help
                                 :path []
                                 :aliases [["help"] ["--help"]]
                                 :desc "Print command usage"
                                 :handler (fn [request] (help/response request))})
    (Command/install app
                                {:id :headless
                                 :path ["headless"]
                                 :desc "Start the loopback RESP companion"
                                 :options [{:id :project :type :string}
                                           {:id :root :type :string}
                                           {:id :host :type :string}
                                           {:id :port :type :string}]
                                 :handler (fn [request] (headless/response request))})
    (Command/install app
                                {:id :run
                                 :path ["run"]
                                 :desc "Run namespace/main with trailing arguments"
                                 :passthrough? true
                                 :arguments [{:id :namespace :type :string}
                                             {:id :argv :type :string :required? false :many? true}]
                                 :handler (fn [request] (run/response request))})
    (Command/install app
                                {:id :test
                                 :path ["test"]
                                 :desc "Run registered code.test facts"
                                 :arguments [{:id :argv :type :string :required? false :many? true}]
                                 :handler (fn [request] (test/response request))})
    (Command/install app
                                {:id :deploy
                                 :path ["deploy"]
                                 :desc "Plan, stage, or build Foundation package projects"
                                 :options [{:id :root :type :string}]
                                 :arguments [{:id :action :type :string :required? false}]
                                 :handler (fn [request] (deploy/response request))})
    (Command/install app
                                {:id :manage
                                 :path ["manage"]
                                 :desc "Inspect and edit Hara source and tests"
                                 :passthrough? true
                                 :arguments [{:id :argv :type :string :required? false :many? true}]
                                 :handler (fn [request] (manage/response request))})
    (Command/install app
                                {:id :seedgen
                                 :path ["seedgen"]
                                 :desc "Generate and test cross-language seed benchmarks"
                                 :options [{:id :root :type :string}]
                                 :arguments [{:id :argv :type :string :required? false :many? true}]
                                 :handler (fn [request] (seedgen/response request))})
    (Command/install app
                                {:id :specs-test
                                 :path ["specs" "test"]
                                 :desc "Run a packaged specification conformance target"
                                 :arguments [{:id :target :type :string}]
                                 :handler (fn [request] (specs/test-response request))})
    app))

(defn normalise-argv
  "Moves a legacy trailing headless command before its global options."
  [argv]
  (cond
    (= (last argv) "headless") (vec (concat ["headless"] (drop-last argv)))
    :else argv))

(defn ^{:public true} main
  "Runs argv through lazy Command routes and declares the RESP host action."
  [argv]
  (let [argv (normalise-argv argv)
        response (Command/run (application) {:argv argv})]
    (cond
      (and (= (first argv) "headless")
           (= (:exit response) 0)) {:hara/host-action :resp}
      :else response)))
