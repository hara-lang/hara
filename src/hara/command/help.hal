(ns hara.command.help
  (:config {:role :internal}))

(def +usage+ "Usage: hara [--version|help|headless|run NAMESPACE [ARGS...]|test [SELECTOR...]|deploy [plan|stage|build] [--root PATH]|manage [OPERATION [SELECTOR...]]|seedgen [COMMAND [SELECTOR...]]|specs test TARGET]")

(defn response
  [_]
  {:stdout (str +usage+ "\n")
   :stderr ""
   :exit 0})
