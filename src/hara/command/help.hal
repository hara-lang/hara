(ns hara.command.help
  (:config {:role :internal}))

(def +usage+ "Usage: hara [--version|help|headless|run NAMESPACE [ARGS...]|test [SELECTOR...]|doc <check|publish|missing|template-init|template-deploy> [PAGE.hal]|package <check|sync|pull|add|remove|update|search|info>|lifecycle <phase>|goal PLUGIN ENTRY|deploy [plan|stage|build] [--root PATH]|specs test TARGET]")

(defn response
  [_]
  {:stdout (str +usage+ "\n")
   :stderr ""
   :exit 0})
