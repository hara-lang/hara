(ns work.agent.internal
  (:config {:role :internal})
  (:require [work.core :as work]
            [work.agent.protocol :as protocol]))

(defn require-capability
  [agent key protocol-name predicate agent-id]
  (let [value (get agent key)]
    (if (nil? value)
      (throw
       (ex :not-found
           {:agent/id agent-id
            :agent/capability key}
           :ex/message "Agent capability is not configured")))
    (if (not (predicate value))
      (throw
       (ex :state
           {:agent/id agent-id
            :agent/capability key
            :agent/protocol protocol-name}
           :ex/message "Agent capability does not satisfy its protocol")))
    value))

(defn assert-bundle
  [value boundary]
  (if (not (work/bundle? value))
    (throw
     (ex :state
         {:agent/boundary boundary
          :agent/value value}
         :ex/message "Agent capability must lower to a Work bundle")))
  value)

(defn target-id
  [prefix identity suffix]
  (str prefix "/" identity "/" suffix))

(defn protocol-driver?
  [value]
  (satisfies? protocol/IAgentDriver value))

(defn protocol-coordinator?
  [value]
  (satisfies? protocol/IAgentCoordinator value))

(defn protocol-authority?
  [value]
  (satisfies? protocol/IAgentAuthority value))
