(ns work.agent.driver.openai.internal
  (:config {:role :internal})
  (:require [work.agent.openai :as openai]
            [work.agent.tool :as tool]))

(defn configuration
  [options agent]
  (let [options (merge (or options {}) (or (:agent/openai agent) {}))
        client (:client options)
        tools (tool/normalize-all (:tools options))]
    (if (nil? client)
      (throw
       (ex :dependency {:agent/id (:agent/id agent)}
           :ex/message "OpenAI agent driver requires a client")))
    {:client client
     :instructions (:instructions options)
     :tools tools
     :tool-index (tool/index tools)
     :tool-targets (tool/declared-targets tools)
     :request (or (:request options) {})
     :max-turns (or (:max-turns options) 8)
     :max-tool-calls (or (:max-tool-calls options) 32)}))
