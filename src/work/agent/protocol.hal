(ns work.agent.protocol)

(defprotocol IAgent
  (agent-spec [agent]))

(defprotocol IAgentDriver
  (agent-drive [driver agent intent context]))

(defprotocol IAgentCoordinator
  (agent-coordinate [coordinator request]))

(defprotocol IAgentAuthority
  (agent-authorize [authority request])
  (agent-sign [authority request]))
