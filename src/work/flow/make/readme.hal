(ns work.flow.make.readme
  (:config {:role :internal})
  (:require [std.fs :as fs]
            [std.fs.path :as path]
            [tool.sh :as sh]))

(defn read-text [file]
  (str/decode-utf8 (fs/read-bytes file)))

(defn write-text [file body]
  (let [parent (path/parent file)
        _ (if parent (fs/create-directory parent {:parents? true :exists-ok? true}) nil)]
    (fs/write-bytes file (str/encode-utf8 body) {:mode :replace})))

(defn has-orgfile? [config]
  (string? (:orgfile (deref (:instance config)))))

(defn tangle-params
  [config]
  (let [value (deref (:instance config)) file (str (:root value) "/" (:orgfile value))]
    (reduce (fn [output line]
              (let [line (str/trim line)
                    separator (str/index-of line ":")]
                (if (and (str/starts-with? line "#+")
                         separator
                         (> separator 2))
                  (assoc output
                         (keyword (str/lower-case (str/slice line 2 separator)))
                         (str/trim (str/slice line (inc separator))))
                  output)))
      {}
      (str/split-lines (read-text file)))))

(defn tangle-output
  [header]
  (let [parts (str/split header #":tangle\s+")]
    (if (> (count parts) 1)
      (first (str/split (nth parts 1) #"\s+"))
      nil)))

(defn tangle-parse [config]
  (let [value (deref (:instance config))
        root (:root value)
        file (str root "/" (:orgfile value))]
    (if (not (fs/exists? file))
      [root []]
      (let [state
            (reduce
             (fn [state line]
               (cond
                 (str/starts-with? line "#+BEGIN_SRC")
                 (assoc state :current [{:header line}])

                 (str/starts-with? line "#+END_SRC")
                 (assoc (assoc state
                               :blocks (conj (:blocks state) (:current state)))
                        :current nil)

                 (:current state)
                 (assoc state :current (conj (:current state) line))

                 :else state))
             {:blocks [] :current nil}
             (str/split-lines (read-text file)))]
        [root
         (mapv (fn [block]
                 (let [header (first block)]
                   (assoc block 0
                          (assoc header :out (tangle-output (:header header))))))
               (:blocks state))]))))

(defn tangle [config]
  (let [parsed (tangle-parse config)
        root (nth parsed 0)
        blocks (filter (fn [block] (:out (first block))) (nth parsed 1))]
    (mapv (fn [block]
            (let [header (first block)
                  output (str root "/" (:out header))]
              (write-text output (str/join "\n" (rest block)))
              output))
          blocks)))

(defn make-readme-raw [content]
  (let [lines (str/split-lines content)
        state (reduce
               (fn [state line]
                 (if (str/starts-with? line "* ")
                   {:sections (conj (:sections state) (:current state))
                    :current [line]}
                   (update state :current conj line)))
                   {:sections [] :current [(first lines)]}
               (rest lines))
        sections (conj (:sections state) (:current state))]
    (str/join
     "\n"
     (mapcat identity
             (remove (fn [section]
                       (str/starts-with? (first section) "* Build"))
                     sections)))))

(defn make-readme [config]
  (let [value (deref (:instance config))
        source (str (:root value) "/" (:orgfile value))
        directory (str (:root value) "/" (:build value))
        output (str directory "/README.md")]
    (if (not (fs/exists? source))
      nil
      (let [_ (fs/create-directory directory {:parents? true :exists-ok? true})
            temporary (str directory "/.README.org")
            _ (write-text temporary (make-readme-raw (read-text source)))
            result (sh/run ["pandoc" "-f" "org" "-t" "gfm"
                            "-o" output temporary]
                           {:cwd directory})]
        result))))
