(ns work.flow.make
  (:config {:role :facade})
  (:require [work.flow.make.artifact :as artifact]
            [work.flow.make.common :as common]
            [work.flow.make.core :as core]
            [work.flow.make.bulk :as bulk]
            [work.flow.make.github :as github]
            [work.flow.make.makefile :as makefile]
            [work.flow.make.project :as project]
            [work.flow.make.readme :as readme]))

(intern-in
 [path core/path]
 [configure-profile core/configure-profile]
 [define core/define]
 [normalise core/normalise]
 [compile core/compile]
 [plan core/plan]
 [targets core/targets]
 [target-work core/target-work]
 [revision core/revision]
 [status core/status]
 [host? core/host?]
 [start core/start]
 [stop core/stop]
 [run core/run]
 [build core/build]
 [clean core/clean]
 [build-all project/build-all]
 [build-default project/build-default]
 [build-at project/build-at]
 [build-triggered project/build-triggered]
 [changed-files project/changed-files]
 [is-changed? project/is-changed?]
 [watch project/watch]
 [watch-project project/watch-project]
 [compile-single artifact/compile-single]
 [compile-section artifact/compile-section]
 [compile-directive artifact/compile-directive]
 [types-list artifact/types-list]
 [types-add artifact/types-add]
 [types-remove artifact/types-remove]
 [types-snapshot artifact/types-snapshot]
 [types-restore! artifact/types-restore!]
 [types-reset! artifact/types-reset!]
 [write makefile/write]
 [emit-headers makefile/emit-headers]
 [emit-target makefile/emit-target]
 [triggers-purge common/triggers-purge]
 [triggers-set common/triggers-set]
 [triggers-clear common/triggers-clear]
 [triggers-get common/triggers-get]
 [triggers-list common/triggers-list]
 [get-triggered common/get-triggered]
 [triggers-snapshot common/triggers-snapshot]
 [triggers-restore! common/triggers-restore!]
 [make-dir common/make-dir]
 [make-dir-setup common/make-dir-setup]
 [make-dir-teardown common/make-dir-teardown]
 [make-dir-exists? common/make-dir-exists?]
 [map-values bulk/map-values]
 [filter-values bulk/filter-values]
 [topological-order bulk/topological-order]
 [make-bulk-get-keys bulk/make-bulk-get-keys]
 [measure bulk/measure]
 [make-bulk bulk/make-bulk]
 [make-bulk-build bulk/make-bulk-build]
 [make-bulk-container-filter bulk/make-bulk-container-filter]
 [make-bulk-container-build bulk/make-bulk-container-build]
 [make-bulk-gh-init bulk/make-bulk-gh-init]
 [make-bulk-gh-push bulk/make-bulk-gh-push]
 [gh-sh-opts github/gh-sh-opts]
 [gh-run github/gh-run]
 [gh-commit github/gh-commit]
 [gh-push github/gh-push]
 [gh-save github/gh-save]
 [gh-user github/gh-user]
 [gh-token github/gh-token]
 [gh-exists? github/gh-exists?]
 [gh-setup-remote github/gh-setup-remote]
 [gh-setup-local-init github/gh-setup-local-init]
 [gh-setup-local-clone github/gh-setup-local-clone]
 [gh-clone github/gh-clone]
 [gh-setup github/gh-setup]
 [gh-local-purge github/gh-local-purge]
 [gh-refresh github/gh-refresh]
 [source-head-message github/source-head-message]
 [gh-dwim-init github/gh-dwim-init]
 [gh-dwim-push github/gh-dwim-push]
 [read-text readme/read-text]
 [write-text readme/write-text]
 [has-orgfile? readme/has-orgfile?]
 [tangle-params readme/tangle-params]
 [tangle-output readme/tangle-output]
 [tangle-parse readme/tangle-parse]
 [tangle readme/tangle]
 [make-readme-raw readme/make-readme-raw]
 [make-readme readme/make-readme])
