(ns std.package.project
  (:config {:role :internal}))

(defn ^{:public true} project-check
  [path]
  (std.native.Kernel/package-check path))

(defn ^{:public true} project-build
  ([path]
   (std.native.Kernel/package-build path))
  ([path output]
   (std.native.Kernel/package-build path output))
  ([path output package]
   (std.native.Kernel/package-build path output package))
  ([path output package profile]
   (std.native.Kernel/package-build path output package profile)))

(defn ^{:public true} project-inspect
  [path]
  (std.native.Kernel/package-inspect path))

(defn ^{:public true} project-install
  [path]
  (std.native.Kernel/package-install path))

(defn ^{:public true} project-publish
  [path tap dry-run]
  (std.native.Kernel/package-publish path tap dry-run))

(defn ^{:public true} project-verify-registry
  [request identity]
  (std.native.Kernel/package-registry-verify request identity))
