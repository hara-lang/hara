(ns std.package.project
  (:config {:role :internal})
  (:require [code.deploy.package :as package]))

(defn ^{:public true} project-check
  [path]
  (package/check path))

(defn ^{:public true} project-build
  ([path]
   (package/build path))
  ([path output]
   (package/build path output))
  ([path output package]
   (package/build path output package))
  ([path output package profile]
   (package/build path output package profile)))

(defn ^{:public true} project-inspect
  [path]
  (Kernel/package-inspect path))

(defn ^{:public true} project-install
  [path]
  (Kernel/package-install path))

(defn ^{:public true} project-publish
  [path tap dry-run]
  (Kernel/package-publish path tap dry-run))

(defn ^{:public true} project-verify-registry
  [request identity]
  (Kernel/package-registry-verify request identity))
