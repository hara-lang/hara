(ns std.package.runtime
  (:config {:role :internal :override [find load]}))

(defn ^{:public true} catalog
  []
  (Package/catalog))

(defn ^{:public true} find
  [target]
  (Package/find target))

(defn ^{:public true} ensure
  [target]
  (Package/ensure target))

(defn ^{:public true} ensure-all
  [targets]
  (Promise/all (map ensure targets)))

(defn ^{:public true} state
  [target]
  (Package/state target))

(defn ^{:public true} locked?
  [target]
  (not (nil? (find target))))

(defn ^{:public true} available?
  [target]
  (= :available (state target)))

(defn ^{:public true} ensuring?
  [target]
  (= :ensuring (state target)))

(defn ^{:public true} ready?
  [target]
  (= :ready (state target)))

(defn ^{:public true} unloading?
  [target]
  (= :unloading (state target)))

(defn ^{:public true} failed?
  [target]
  (= :failed (state target)))

(defn ^{:public true} read
  [descriptor path]
  (Package/read descriptor path))

(defn ^{:public true} load
  [namespace]
  (IPromise/then (ensure namespace)
                 (fn [_]
                   (Package/load namespace))))

(defn ^{:public true} unload
  ([target]
   (Package/unload target))
  ([target options]
   (Package/unload target options)))
