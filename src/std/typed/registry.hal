(ns std.typed.registry)

(def +registry-type+ :std.typed.registry/registry)

(def +option-keys+
  #{:namespace :aliases :refers :parents})

(defn registry-error
  "Raises a structured error for an invalid immutable schema registry."
  [message data]
  (throw
   (ex :argument
       (assoc data :type :std.typed.registry/invalid-registry)
       :ex/message message)))

(defn ^{:public true} registry?
  "Returns true when value is a canonical portable schema registry."
  [value]
  (and (map? value)
       (= +registry-type+ (:registry/type value))
       (map? (:registry/entries value))
       (vector? (:registry/parents value))))

(defn require-map
  "Returns value when it is a map, otherwise raises a registry error."
  [value label]
  (cond
    (map? value) value
    :else (registry-error (str label " must be a map")
                          {:label label :value value})))

(defn require-symbol-map
  "Validates a symbol-to-symbol registry option map."
  [value label]
  (let [value (require-map value label)]
    (reduce
     (fn [output entry]
       (let [entry-key (key entry)
             entry-value (val entry)]
         (cond
           (and (symbol? entry-key) (symbol? entry-value)) output
           :else
           (registry-error
            (str label " must map symbols to symbols")
            {:label label :key entry-key :value entry-value}))))
     value
     value)))

(defn require-parents
  "Returns parents as a vector after validating every parent registry."
  [parents]
  (let [parents (vec parents)]
    (cond
      (every? registry? parents) parents
      :else (registry-error "registry parents must be registries"
                            {:parents parents}))))

(defn qualify-in
  "Qualifies target using one registry's namespace, aliases, and refers."
  [current aliases refers target]
  (cond
    (not (symbol? target))
    (registry-error "schema registry names must be symbols" {:name target})

    :else
    (let [prefix (namespace target)]
      (cond
        prefix
        (let [prefix-symbol (symbol prefix)
              resolved-prefix (get aliases prefix-symbol)]
          (cond
            resolved-prefix (symbol (str resolved-prefix) (name target))
            :else target))

        (get refers target) (get refers target)
        current (symbol (str current) (name target))
        :else target))))

(defn ^{:public true} qualify
  "Qualifies a schema name through registry aliases, refers, and namespace."
  [registry-value target]
  (let [registry-value
        (cond
          (registry? registry-value) registry-value
          :else (registry-error "qualify expects a schema registry"
                                {:registry registry-value}))]
    (qualify-in (:registry/namespace registry-value)
                (:registry/aliases registry-value)
                (:registry/refers registry-value)
                target)))

(defn canonical-entries
  "Qualifies local entry names and rejects collisions after qualification."
  [entries current aliases refers]
  (reduce
   (fn [output entry]
     (let [raw-name (key entry)
           qualified (qualify-in current aliases refers raw-name)]
       (cond
         (has? output qualified)
         (registry-error "duplicate qualified schema registry name"
                         {:name qualified :raw-name raw-name})
         :else (assoc output qualified (val entry)))))
   {}
   entries))

(defn ^{:public true} registry
  "Creates an immutable portable schema registry.

   Options are :namespace, :aliases, :refers, and ordered :parents. Local
   entries take precedence over parents; earlier parents take precedence over
   later parents."
  ([entries]
   (registry entries {}))
  ([entries options]
   (let [entries (require-map entries "registry entries")
         options (require-map options "registry options")
         unknown-options (vec (filter (fn [option]
                                        (not (has? +option-keys+ option)))
                                      (keys options)))
         current (get options :namespace nil)
         aliases (require-symbol-map (get options :aliases {}) "registry aliases")
         refers (require-symbol-map (get options :refers {}) "registry refers")
         parents (require-parents (get options :parents []))]
     (cond
       (not (empty? unknown-options))
       (registry-error "unsupported schema registry options" {:options unknown-options})

       (and current (not (symbol? current)))
       (registry-error "registry namespace must be a symbol" {:namespace current})

       :else
       {:registry/type +registry-type+
        :registry/namespace current
        :registry/aliases aliases
        :registry/refers refers
        :registry/entries (canonical-entries entries current aliases refers)
        :registry/parents parents}))))

(def +empty+ (registry {}))

(defn ^{:public true} ensure
  "Returns a canonical registry, treating an ordinary map as registry entries."
  [value]
  (cond
    (registry? value) value
    (map? value) (registry value)
    :else (registry-error "expected a schema registry or entries map"
                          {:registry value})))

(defn ^{:public true} local
  "Creates a registry whose unqualified names belong to namespace."
  ([current entries]
   (registry entries {:namespace current}))
  ([current entries options]
   (registry entries (assoc options :namespace current))))

(defn ^{:public true} composite
  "Creates an ordered composite registry."
  ([registries]
   (registry {} {:parents registries}))
  ([entries registries]
   (registry entries {:parents registries})))

(defn ^{:public true} local-entries
  "Returns only the entries owned by this registry."
  [registry-value]
  (:registry/entries (ensure registry-value)))

(defn ^{:public true} parents
  "Returns the ordered parent registries."
  [registry-value]
  (:registry/parents (ensure registry-value)))

(declare find-schema names)

(defn find-in-parent
  "Finds the first target visible through one parent registry."
  [parent targets]
  (loop [remaining targets]
    (cond
      (empty? remaining) nil
      :else
      (let [found (find-schema parent (first remaining))]
        (cond
          found found
          :else (recur (rest remaining)))))))

(defn ^{:public true} find-schema
  "Returns {:registry r :name qualified :schema surface}, or nil."
  [registry-value target]
  (let [registry-value (ensure registry-value)
        qualified (qualify registry-value target)
        entries (:registry/entries registry-value)]
    (cond
      (has? entries qualified)
      {:registry registry-value :name qualified :schema (get entries qualified)}

      :else
      (let [targets (cond
                      (= target qualified) [target]
                      :else [qualified target])]
        (loop [remaining (:registry/parents registry-value)]
          (cond
            (empty? remaining) nil
            :else
            (let [found (find-in-parent (first remaining) targets)]
              (cond
                found found
                :else (recur (rest remaining))))))))))

(defn ^{:public true} lookup
  "Returns a registered schema surface, or nil when absent."
  [registry-value target]
  (let [found (find-schema registry-value target)]
    (cond
      found (:schema found)
      :else nil)))

(defn ^{:public true} has-schema?
  "Returns true when target resolves in registry."
  [registry-value target]
  (boolean (find-schema registry-value target)))

(defn ^{:public true} require-schema
  "Returns a registered schema surface or raises a structured error."
  [registry-value target]
  (let [found (find-schema registry-value target)]
    (cond
      found (:schema found)
      :else (registry-error "schema registry reference is unresolved"
                            {:name target :options (names registry-value)}))))

(defn append-unique
  "Adds value when it is not already present."
  [values value]
  (cond
    (any? (fn [candidate] (= candidate value)) values) values
    :else (conj values value)))

(defn append-names
  "Appends names while preserving first-visible precedence."
  [output values]
  (loop [remaining values output output]
    (cond
      (empty? remaining) output
      :else (recur (rest remaining)
                   (append-unique output (first remaining))))))

(defn ^{:public true} names
  "Returns visible qualified schema names in deterministic precedence order."
  [registry-value]
  (let [registry-value (ensure registry-value)]
    (loop [remaining (:registry/parents registry-value)
           output (vec (sort (keys (:registry/entries registry-value))))]
      (cond
        (empty? remaining) output
        :else (recur (rest remaining)
                     (append-names output (names (first remaining))))))))

(defn ^{:public true} definitions
  "Flattens visible definitions using registry lookup precedence."
  [registry-value]
  (let [registry-value (ensure registry-value)]
    (reduce
     (fn [output schema-name]
       (assoc output schema-name (:schema (find-schema registry-value schema-name))))
     {}
     (names registry-value))))

(defn ^{:public true} assoc-schema
  "Returns registry with a local schema entry associated immutably."
  [registry-value target schema]
  (let [registry-value (ensure registry-value)
        qualified (qualify registry-value target)]
    (assoc registry-value
           :registry/entries
           (assoc (:registry/entries registry-value) qualified schema))))

(defn ^{:public true} dissoc-schema
  "Returns registry without the qualified local schema entry."
  [registry-value target]
  (let [registry-value (ensure registry-value)
        qualified (qualify registry-value target)]
    (assoc registry-value
           :registry/entries
           (dissoc (:registry/entries registry-value) qualified))))
