(ns std.fs.path)

(defn ^{:public true} normalise
  "Returns an absolute path using the native filesystem boundary."
  [path]
  (File/resolve (str path) ""))

(defn ^{:public true} join
  "Joins one or more filesystem path components."
  ([path]
   (normalise path))
  ([path child]
   (File/join path child))
  ([path child & more]
   (reduce (fn [output part]
             (File/join output part))
           (File/join path child)
           more)))

(defn ^{:public true} parent
  [path]
  (File/parent (normalise path)))

(defn ^{:public true} file-name
  [path]
  (let [path (normalise path)
        parts (str/split path "/")]
    (if (= "/" path) nil (last parts))))

(defn ^{:public true} relativize
  [root path]
  (let [root (str root)
        path (str path)
        prefix (str root "/")]
    (if (str/starts-with? path prefix)
      (str/slice path (str/length prefix) (str/length path))
      path)))
