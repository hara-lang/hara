(ns std.config
  (:config {:role :facade :override [resolve load]})
  (:require [std.config.global :as config-global]
            [std.config.resolve :as config-resolve]))

(intern-in
 [load config-resolve/load]
 [resolve config-resolve/resolve]
 [global config-global/global]
 [get-session config-global/session]
 [swap-session config-global/swap-session!]
 [clear-session config-global/reset-session!]
 [register-directive config-resolve/register-directive]
 [register-type config-resolve/register-type])
