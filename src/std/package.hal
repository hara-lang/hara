(ns std.package
  (:config {:role :facade :override [find load read]})
  (:require [std.package.runtime :as runtime]
            [std.package.build :as build]
            [std.package.project :as project]
            [std.package.hbx :as hbx]))

(intern-in
 [catalog runtime/catalog]
 [find runtime/find]
 [ensure runtime/ensure]
 [ensure-all runtime/ensure-all]
 [state runtime/state]
 [locked? runtime/locked?]
 [available? runtime/available?]
 [ensuring? runtime/ensuring?]
 [ready? runtime/ready?]
 [unloading? runtime/unloading?]
 [failed? runtime/failed?]
 [read runtime/read]
 [load runtime/load]
 [unload runtime/unload]
 [build build/build]
 [inspect build/inspect]
 [seal build/seal]
 [inspect-seal build/inspect-seal]
 [verify-seal build/verify-seal]
 [distribute build/distribute]
 [build-specs build/build-specs]
 [read-spec-content build/read-spec-content]
 [build-distribution build/build-distribution]
 [seal-project build/seal-project]
 [project-check project/project-check]
 [project-build project/project-build]
 [project-inspect project/project-inspect]
 [project-install project/project-install]
 [project-publish project/project-publish]
 [project-verify-registry project/project-verify-registry]
 [hbx-formats hbx/formats]
 [hbx-spec hbx/spec]
 [hbx-provider hbx/current-provider]
 [hbx-capabilities hbx/capabilities]
 [hbx-detect hbx/detect]
 [hbx-validate hbx/validate]
 [hbx-inspect hbx/inspect]
 [hbx-pack hbx/pack]
 [hbx-unpack hbx/unpack]
 [hbx-conform hbx/conform]
 [hbx-extract hbx/extract])
