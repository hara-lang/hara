(ns std.lib.schema.ref
  (:require [std.lib.schema.find :as find]
            [std.lib.format.plural :as plural]))

(def ^:dynamic *ref-fn* nil)

(defmacro ^{:style/indent 1} with:ref-fn
  "passes a function for use in `reverse-ref-attr` method to add additional params to schema"
  {:added "4.0"}
  [[ref-fn] & body]
  (apply
    list
    (concat
      (list 'binding)
      (list
        (apply
          vector
          (seq
            (concat
              (list 'std.lib.schema.ref/*ref-fn*)
              (list ref-fn)))))
      body)))

(defn keyword-reverse
  "reverses the keyword by either adding or removing '_' in the value"
  {:added "3.0"}
  [k]
  (if-let [kval (let [migration-path-input k
                      migration-path-text (if
                                            (or
                                              (keyword?
                                                migration-path-input)
                                              (symbol?
                                                migration-path-input))
                                            (str/to-string
                                              migration-path-input)
                                            (str migration-path-input))
                      migration-path-parts (reverse
                                             (drop-while
                                               empty?
                                               (reverse
                                                 (str/split
                                                   migration-path-text
                                                   "/"))))
                      migration-path-result (when
                                              (not-empty
                                                (rest
                                                  migration-path-parts))
                                              (str/join
                                                "/"
                                                (rest
                                                  migration-path-parts)))]
                  (if (nil? migration-path-result)
                    nil
                    (if (or
                          (keyword? migration-path-input)
                          (symbol? migration-path-input))
                      (str/from-string
                        migration-path-input
                        migration-path-result)
                      migration-path-result)))]
    (let [sval (name kval)
          rsval (if (str/starts-with? sval "_")
                  (subs sval 1)
                  (str "_" sval))]
      (let [migration-path-input [(let
                                    [migration-path-input k
                                     migration-path-text
                                     (if
                                       (or
                                         (keyword?
                                           migration-path-input)
                                         (symbol?
                                           migration-path-input))
                                       (str/to-string
                                         migration-path-input)
                                       (str migration-path-input))
                                     migration-path-parts
                                     (reverse
                                       (drop-while
                                         empty?
                                         (reverse
                                           (str/split
                                             migration-path-text
                                             "/"))))
                                     migration-path-result
                                     (when
                                       (not-empty
                                         (butlast
                                           migration-path-parts))
                                       (str/join
                                         "/"
                                         (butlast
                                           migration-path-parts)))]
                                    (if
                                      (nil? migration-path-result)
                                      nil
                                      (if
                                        (or
                                          (keyword?
                                            migration-path-input)
                                          (symbol?
                                            migration-path-input))
                                        (str/from-string
                                          migration-path-input
                                          migration-path-result)
                                        migration-path-result)))
                                  rsval]
            migration-path-sample (first migration-path-input)
            migration-path-parts (if
                                   (string? migration-path-sample)
                                   (map
                                     str
                                     (seq
                                       (filter
                                         identity
                                         migration-path-input)))
                                   (map
                                     (fn
                                       [value]
                                       (if
                                         (or
                                           (keyword? value)
                                           (symbol? value))
                                         (str/to-string value)
                                         (str value)))
                                     (seq migration-path-input)))
            migration-path-result (when
                                    (not-empty migration-path-input)
                                    (str/join
                                      "/"
                                      migration-path-parts))]
        (cond
          (or
            (nil? migration-path-result)
            (nil? migration-path-sample)) nil
          (or
            (keyword? migration-path-sample)
            (symbol? migration-path-sample)) (str/from-string
                                               migration-path-sample
                                               migration-path-result)
          :else migration-path-result)))
    (throw
      (ex
        :schema/invalid-reference
        {}
        :ex/message
        (str "Keyword " k " is not reversible.")))))

(defn keyword-reversed?
  "checks whether the keyword is reversed (begins with '_')"
  {:added "3.0"}
  [k]
  (if-let [kval (let [migration-path-input k
                      migration-path-text (if
                                            (or
                                              (keyword?
                                                migration-path-input)
                                              (symbol?
                                                migration-path-input))
                                            (str/to-string
                                              migration-path-input)
                                            (str migration-path-input))
                      migration-path-parts (reverse
                                             (drop-while
                                               empty?
                                               (reverse
                                                 (str/split
                                                   migration-path-text
                                                   "/"))))
                      migration-path-result (when
                                              (not-empty
                                                (rest
                                                  migration-path-parts))
                                              (str/join
                                                "/"
                                                (rest
                                                  migration-path-parts)))]
                  (if (nil? migration-path-result)
                    nil
                    (if (or
                          (keyword? migration-path-input)
                          (symbol? migration-path-input))
                      (str/from-string
                        migration-path-input
                        migration-path-result)
                      migration-path-result)))]
    (-> kval name (str/starts-with? "_"))
    false))
		 
(defn is-reversible?
  "determines whether a ref attribute is reversible or not"
  {:added "3.0"}
  [attr]
  (if (and
        (= :ref (:type attr))
        (-> attr :ref :ns)
        (not (-> attr :ref :norev))
        (not (-> attr :ref :mutual))
        (let [migration-path-input (:ident attr)
              migration-path-text (if
                                    (or
                                      (keyword? migration-path-input)
                                      (symbol? migration-path-input))
                                    (str/to-string
                                      migration-path-input)
                                    (str migration-path-input))
              migration-path-parts (reverse
                                     (drop-while
                                       empty?
                                       (reverse
                                         (str/split
                                           migration-path-text
                                           "/"))))
              migration-path-result (when
                                      (not-empty
                                        (butlast migration-path-parts))
                                      (str/join
                                        "/"
                                        (butlast
                                          migration-path-parts)))]
          (if (nil? migration-path-result)
            nil
            (if (or
                  (keyword? migration-path-input)
                  (symbol? migration-path-input))
              (str/from-string
                migration-path-input
                migration-path-result)
              migration-path-result)))
        (-> attr :ident keyword-reversed? not))
    true
    false))

(defn determine-rval
  "outputs the :rval value of a :ref schema reference"
  {:added "3.0"}
  [migration-argument-0]
  (let [migration-argument-0-value migration-argument-0
        entry migration-argument-0-value
        [root ref-ns many?] (first (drop 0 migration-argument-0-value))
        [attr] (first (drop 1 migration-argument-0-value))]
    (if-let [rval (-> attr :ref :rval)]
      rval
      (let [ident (str/tag (:ident attr))
            ival (not-empty
                   (str/join "/" (rest (str/split ident "/"))))]
        (cond
          (= root ref-ns) (let [rvec
                                (concat
                                  (rest
                                    (reverse
                                      (drop-while
                                        empty?
                                        (reverse
                                          (str/split ident "/")))))
                                  '("of"))]
                            (keyword
                              (str/join
                                "-"
                                (map str/spear-case rvec))))
          many? (let [rvec (concat
                             (rest
                               (reverse
                                 (drop-while
                                   empty?
                                   (reverse (str/split ident "/")))))
                             (list (->> root name plural/plural)))]
                  (keyword (str/join "-" (map str/spear-case rvec))))
          :else (->>
                  root
                  name
                  str/spear-case
                  plural/plural
                  keyword))))))

(defn forward-ref-attr
  "creates the :ref schema attribute for the forward reference case"
  {:added "3.0"}
  [migration-argument-0]
  (let [migration-argument-0-value migration-argument-0
        attr (first (drop 0 migration-argument-0-value))]
    (let [{:keys [ident ref]} attr {:keys [ns rval]} ref]
      (if (and ident ref ns rval)
        [(update-in
           attr
           [:ref]
           merge
           {:type :forward,
            :key ident,
            :val
            (let [migration-path-input ident
                  migration-path-text (if
                                        (or
                                          (keyword?
                                            migration-path-input)
                                          (symbol?
                                            migration-path-input))
                                        (str/to-string
                                          migration-path-input)
                                        (str migration-path-input))
                  migration-path-parts (reverse
                                         (drop-while
                                           empty?
                                           (reverse
                                             (str/split
                                               migration-path-text
                                               "/"))))
                  migration-path-result (when
                                          (not-empty
                                            (rest
                                              migration-path-parts))
                                          (str/join
                                            "/"
                                            (rest
                                              migration-path-parts)))]
              (if (nil? migration-path-result)
                nil
                (if (or
                      (keyword? migration-path-input)
                      (symbol? migration-path-input))
                  (str/from-string
                    migration-path-input
                    migration-path-result)
                  migration-path-result))),
            :rkey (keyword-reverse ident),
            :rident
            (let [migration-path-input [ns rval]
                  migration-path-sample (first migration-path-input)
                  migration-path-parts (if
                                         (string?
                                           migration-path-sample)
                                         (map
                                           str
                                           (seq
                                             (filter
                                               identity
                                               migration-path-input)))
                                         (map
                                           (fn
                                             [value]
                                             (if
                                               (or
                                                 (keyword? value)
                                                 (symbol? value))
                                               (str/to-string value)
                                               (str value)))
                                           (seq migration-path-input)))
                  migration-path-result (when
                                          (not-empty
                                            migration-path-input)
                                          (str/join
                                            "/"
                                            migration-path-parts))]
              (cond
                (or
                  (nil? migration-path-result)
                  (nil? migration-path-sample)) nil
                (or
                  (keyword? migration-path-sample)
                  (symbol? migration-path-sample)) (str/from-string
                                                     migration-path-sample
                                                     migration-path-result)
                :else migration-path-result))})]
        (throw
          (ex
            :schema/invalid-reference
            {}
            :ex/message
            (str
              "PREPARE_FORWARD_ATTR: Required keys: [ident, ref [ns rval]] "
              attr)))))))

(defn reverse-ref-attr
  "creates the reverse :ref schema attribute for backward reference"
  {:added "3.0"}
  [migration-argument-0]
  (let [migration-argument-0-value migration-argument-0
        attr (first (drop 0 migration-argument-0-value))]
    (let [{:keys [ident ref]} attr
          {:keys [key val rkey rval rident]} ref]
      (if (and ident ref key val rkey rval rident)
        [{:ident rident,
          :cardinality :many,
          :type :ref,
          :ref
          (merge
            {:ns
             (let [migration-path-input ident
                   migration-path-text (if
                                         (or
                                           (keyword?
                                             migration-path-input)
                                           (symbol?
                                             migration-path-input))
                                         (str/to-string
                                           migration-path-input)
                                         (str migration-path-input))
                   migration-path-parts (reverse
                                          (drop-while
                                            empty?
                                            (reverse
                                              (str/split
                                                migration-path-text
                                                "/"))))
                   migration-path-result (first
                                           (butlast
                                             migration-path-parts))]
               (if (nil? migration-path-result)
                 nil
                 (if (or
                       (keyword? migration-path-input)
                       (symbol? migration-path-input))
                   (str/from-string
                     migration-path-input
                     migration-path-result)
                   migration-path-result))),
             :type :reverse,
             :val rval,
             :key rkey,
             :rval val,
             :rkey key,
             :rident ident}
            (if *ref-fn* (*ref-fn* attr)))}]
        (throw
          (ex
            :schema/invalid-reference
            {}
            :ex/message
            (str
              "PREPARE_REVERSE_ATTR: Required keys: [ident, ref [key val rkey rval rident]"
              attr)))))))

(defn forward-ref-attr-fn
  "helper for `forward-ref-attr`"
  {:added "3.0"}
  [migration-argument-0]
  (let [migration-argument-0-value migration-argument-0
        entry migration-argument-0-value
        _ (first (drop 0 migration-argument-0-value))
        [attr] (first (drop 1 migration-argument-0-value))]
    (forward-ref-attr
      [(assoc-in attr [:ref :rval] (determine-rval entry))])))

(defn attr-ns-pair
  "constructs a :ns and :ident root pair for comparison"
  {:added "3.0"}
  [migration-argument-0]
  (let [migration-argument-0-value migration-argument-0
        attr (first (drop 0 migration-argument-0-value))]
    (let [ident (:ident attr) ref-ns (-> attr :ref :ns)]
      [(let [migration-path-input ident
             migration-path-text (if
                                   (or
                                     (keyword? migration-path-input)
                                     (symbol? migration-path-input))
                                   (str/to-string migration-path-input)
                                   (str migration-path-input))
             migration-path-parts (reverse
                                    (drop-while
                                      empty?
                                      (reverse
                                        (str/split
                                          migration-path-text
                                          "/"))))
             migration-path-result (first
                                     (butlast migration-path-parts))]
         (if (nil? migration-path-result)
           nil
           (if (or
                 (keyword? migration-path-input)
                 (symbol? migration-path-input))
             (str/from-string
               migration-path-input
               migration-path-result)
             migration-path-result)))
       ref-ns])))

(defn mark-multiple
  "marks multiple ns/ident groups"
  {:added "3.0"}
  ([nsgroups] (mark-multiple nsgroups []))
  ([nsgroups output]
    (loop [remaining nsgroups output output]
      (let [nsgroup (first remaining) more (rest remaining)]
        (if-let [[nspair entries] nsgroup]
          (cond
            (< 1 (count entries)) (recur
                                    more
                                    (concat
                                      output
                                      (map
                                        (fn
                                          [m]
                                          [(conj nspair true) m])
                                        entries)))
            :else (recur
                    more
                    (if (or (seq? output) (form? output) (nil? output))
                      (cons
                        [(conj nspair false) (first entries)]
                        output)
                      (conj
                        output
                        [(conj nspair false) (first entries)]))))
          output)))))

(defn ref-attrs
  "creates forward and reverse attributes for a flattened schema"
  {:added "3.0"}
  [fschm]
  (let [refs (vals (find/all-attrs fschm is-reversible?))
        lus (group-by attr-ns-pair refs)
        fwds (->> (seq lus) (mark-multiple) (map forward-ref-attr-fn))
        revs (->>
               fwds
               (filter (fn [[attr]] (is-reversible? attr)))
               (map reverse-ref-attr))
        all (concat fwds revs)]
    (zipmap (map (fn [[attr]] (:ident attr)) all) all)))
