(ns std.lib.context.space
  (:config {:role :internal})
  (:require [std.lib.context.registry :as registry]
            [std.lib.component :as component]
            [std.lib.context.resource ]))

(def ^{:dynamic true} *namespace* nil)
(def ^{:dynamic true} *spaces* (atom {}))

(defstruct Space [namespace state])

(defn ^{:public true} reset-spaces!
  "Stops cached spaces and restores the cache to an empty baseline."
  []
  (doseq [entry (vals (deref *spaces*))] (space-stop entry))
  (reset! *spaces* {})
  nil)

(defn ^{:public true} space-merge-config [base override]
  (reduce
   (fn [output pair]
     (let [entry-key (key pair)
           entry-value (val pair)
           current (get output entry-key)]
       (assoc output
              entry-key
              (if (and (map? current) (map? entry-value))
                (space-merge-config current entry-value)
                entry-value))))
   base
   override))

(defn ^{:public true} space-context-set [space context key config]
  (let [runtime (registry/registry-rt context key)
        entry (assoc
                runtime
                :variant
                (or (:variant runtime) :default)
                :config
                (space-merge-config (:config runtime) config))]
    (swap! (:state space) assoc context entry)
    entry))

(defn ^{:public true} space-context-unset [space context]
  (let [entry (get (deref (:state space)) context)]
    (if (:instance entry) (space-rt-stop space context))
    (swap! (:state space) dissoc context)
    entry))

(defn ^{:public true} space-context-get [space context]
  (let [entry (get (deref (:state space)) context)]
    (if entry
      (assoc entry :variant (or (:variant entry) :default))
      (throw (ex :not-found {:input context :options (keys (deref (:state space)))} :ex/message "Context not found")))))

(defn ^{:public true} space-rt-create [space context]
  (let [{:keys [resource variant config create], :as entry} (space-context-get
                                                              space
                                                              context)]
    (if resource
      (let [spec (std.lib.context.resource/variant-get
                   resource
                   variant)
            constructor (get-in spec [:instance :create])
            full-config (space-merge-config (:config spec) config)]
        (constructor full-config))
      (if create
        (create config)
        (throw
          (ex
            :host
            {:context context, :runtime entry}
            :ex/message
            "Runtime has no create function"))))))

(defn ^{:public true} space-rt-start [space context]
  (or
    (:instance (get (deref (:state space)) context))
    (let [{:keys [resource variant config]} (space-context-get
                                              space
                                              context)
          runtime (if resource
                    (let [spec (std.lib.context.resource/variant-get
                                 resource
                                 variant)]
                      (std.lib.context.resource/resource-setup
                        resource
                        variant
                        (space-merge-config (:config spec) config)))
                    (component/start (space-rt-create space context)))]
      (swap! (:state space) assoc-in [context :instance] runtime)
      runtime)))

(defn ^{:public true} space-rt-stop [space context]
  (let [{:keys [resource variant], :as entry} (space-context-get
                                                space
                                                context)
        runtime (:instance entry)]
    (if runtime
      (do
        (if resource
          (std.lib.context.resource/resource-teardown
            resource
            variant
            runtime)
          (component/stop runtime))
        (swap! (:state space) update-in [context] dissoc :instance)
        nil))))

(defn ^{:public true} space-stop [space]
  (reduce
   (fn [output context]
     (if (:instance (get (deref (:state space)) context))
       (space-rt-stop space context))
     output)
   space
   (keys (deref (:state space)))))

(extend-type Space ISpace
  (context-set [space context key options]
    (space-context-set space context key options))
  (context-unset [space context]
    (space-context-unset space context))
  (context-list [space]
    (vec (keys (deref (:state space)))))
  (context-get [space context]
    (space-context-get space context))
  (rt-active [space]
    (vec
     (reduce
      (fn [output pair]
        (if (:instance (val pair))
          (conj output (key pair))
          output))
      []
      (deref (:state space)))))
  (rt-get [space context]
    (:instance (get (deref (:state space)) context)))
  (rt-start [space context]
    (space-rt-start space context))
  (rt-started? [space context]
    (not (nil? (:instance (get (deref (:state space)) context)))))
  (rt-stopped? [space context]
    (nil? (:instance (get (deref (:state space)) context))))
  (rt-stop [space context]
    (space-rt-stop space context)))

(extend-type Space IComponent
  (props [space] {})
  (status [space] :started)
  (started? [space] true)
  (stopped? [space] false)
  (start [space] space)
  (stop [space] (space-stop space))
  (kill [space] (space-stop space))
  (remote? [space] false))

(defn ^{:public true} space? [value]
  (instance? Space value))

(defn ^{:public true} space-create [options]
  (std.lib.context.space/Space
   (or (:namespace options) *namespace* :default)
   (atom {})))

(defn ^{:public true} space
  ([] (space *namespace*))
  ([namespace]
   (let [key (or namespace
                 std.lib.context.resource/*resource-namespace*
                 (ns-current))
         existing (get (deref *spaces*) key)]
     (or existing
         (let [created (space-create {:namespace key})]
           (swap! *spaces* assoc key created)
           created)))))

(defn ^{:public true} space-resolve [value]
  (if (or (nil? value) (symbol? value))
    (space value)
    value))

(defn ^{:public true} protocol-tmpl [options]
  (fn [signature]
    {:name (symbol (str (:prefix options) (:name signature)))
     :arglists (:arglists signature)
     :protocol (:protocol options)
     :instance (:instance options)
     :resolve (:resolve options)
     :default (:default options)}))

(defn ^{:public true} space:context-set
  ([context key options]
   (space:context-set *namespace* context key options))
  ([space-or-namespace context key options]
   (space-context-set (space-resolve space-or-namespace) context key options)))

(defn ^{:public true} space:context-unset
  ([context] (space:context-unset *namespace* context))
  ([space-or-namespace context]
   (space-context-unset (space-resolve space-or-namespace) context)))

(defn ^{:public true} space:context-list
  ([] (space:context-list *namespace*))
  ([space-or-namespace]
   (ISpace/context-list (space-resolve space-or-namespace))))

(defn ^{:public true} space:context-get
  ([context] (space:context-get *namespace* context))
  ([space-or-namespace context]
   (space-context-get (space-resolve space-or-namespace) context)))

(defn ^{:public true} space:rt-active
  ([] (space:rt-active *namespace*))
  ([space-or-namespace]
   (ISpace/rt-active (space-resolve space-or-namespace))))

(defn ^{:public true} space:rt-get
  ([context] (space:rt-get *namespace* context))
  ([space-or-namespace context]
   (ISpace/rt-get (space-resolve space-or-namespace) context)))

(defn ^{:public true} space:rt-start
  ([context] (space:rt-start *namespace* context))
  ([space-or-namespace context]
   (space-rt-start (space-resolve space-or-namespace) context)))

(defn ^{:public true} space:rt-started?
  ([context] (space:rt-started? *namespace* context))
  ([space-or-namespace context]
   (ISpace/rt-started? (space-resolve space-or-namespace) context)))

(defn ^{:public true} space:rt-stopped?
  ([context] (space:rt-stopped? *namespace* context))
  ([space-or-namespace context]
   (ISpace/rt-stopped? (space-resolve space-or-namespace) context)))

(defn ^{:public true} space:rt-stop
  ([context] (space:rt-stop *namespace* context))
  ([space-or-namespace context]
   (space-rt-stop (space-resolve space-or-namespace) context)))

(defn ^{:public true} space:rt-current
  ([context]
   (if (keyword? context)
     (space:rt-current (ns-name (Base/current-namespace)) context)
     context))
  ([namespace context]
   (or (space:rt-get namespace context)
       (registry/registry-scratch context)
       registry/+rt-null+)))
