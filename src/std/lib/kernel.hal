;; Kernel-native wrappers. This namespace owns the public standard-library
;; boundary directly and does not introduce a dependency on application
;; namespaces.
(ns std.lib.kernel)

(defn ^{:public true} sandbox-open
  [spec]
  (Sandbox/open spec))

(defn ^{:public true} sandbox-eval
  [id source]
  (Sandbox/eval id source))

(defn ^{:public true} sandbox-call
  [id callable arguments]
  (Sandbox/call id callable arguments))

(defn ^{:public true} sandbox-cancel
  [id]
  (Sandbox/cancel id))

(defn ^{:public true} sandbox-status
  [id]
  (Sandbox/status id))

(defn ^{:public true} sandbox-close
  [id]
  (Sandbox/close id))

(defn ^{:public true} session-create
  [name]
  (Kernel/session-create name))

(defn ^{:public true} session-close
  [name]
  (Kernel/session-close name))

(defn ^{:public true} session-list
  []
  (Kernel/session-list))

(defn ^{:public true} session-info
  [name]
  (Kernel/session-info name))

(defn ^{:public true} session-eval
  [name source]
  (Kernel/session-eval name source))


(defn ^{:public true} session-namespace
  [name]
  (Kernel/session-namespace name))

(defn ^{:public true} session-complete
  [name prefix]
  (Kernel/session-complete name prefix))

(defn ^{:public true} resource-register
  [name source]
  (Kernel/resource-register name source))

(defn ^{:public true} resource-remove
  [name]
  (Kernel/resource-remove name))

(defn ^{:public true} resource-list
  []
  (Kernel/resource-list))

(defn ^{:public true} filesystem-create
  [& arguments]
  (apply Kernel/filesystem-create arguments))

(defn ^{:public true} filesystem-attach
  [& arguments]
  (apply Kernel/filesystem-attach arguments))

(defn ^{:public true} filesystem-detach
  [& arguments]
  (apply Kernel/filesystem-detach arguments))

(defn ^{:public true} filesystem-info
  [& arguments]
  (apply Kernel/filesystem-info arguments))

(defn ^{:public true} filesystem-close
  [& arguments]
  (apply Kernel/filesystem-close arguments))

(defn ^{:public true} capabilities
  []
  (Kernel/capabilities))
