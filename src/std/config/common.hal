(ns std.config.common)

(def deferred-directives
  #{:properties :eval :resource})

(def deferred-types
  #{:key :gpg :gpg.public :yaml :toml
    :properties :eval :resource})

(defn ^{:public true} merge-all
  [values]
  (reduce merge-nested {} values))

(defn ^{:public true} unsupported-feature
  "Creates the structured error used for deliberately deferred Foundation
   features."
  [feature category]
  (ex :database {:error/type :std.config/unsupported-feature
    :feature feature
    :feature/category category
    :feature/status :host-adapted} :ex/message (str "Unsupported portable configuration feature: " feature)))

(defn ^{:public true} assert-portable-options
  [options]
  (if (:secured options)
    (throw
     (unsupported-feature :secured-content :security)))
  (let [type (:type options)]
    (if (has? deferred-types type)
      (throw
       (unsupported-feature type :type))))
  options)

(defn ^{:public true} read-text
  [path]
  (str/decode-utf8 (deref (File/read path))))

(defn ^{:public true} absolute-path?
  [path]
  (and (string? path)
       (or (str/starts-with? path "/")
           (and (> (str/length path) 2)
                (= \: (str/char-at path 1))))))

(defn ^{:public true} candidate-paths
  "Returns include candidates in contract order: including file directory,
   project root, then the path as supplied."
  [path context]
  (if (absolute-path? path)
    [path]
    (let [parent (:config/parent context)
          root (or (:root context)
                   (:project/root (:project context))
                   (:project/root (:config/project context)))]
      (vec
       (distinct
        (filter
         (fn [candidate]
           (and candidate (not (str/blank? (str candidate)))))
         [(if parent (File/join parent path) nil)
          (if root (File/join root path) nil)
          path]))))))

(defn ^{:public true} first-existing
  [paths]
  (first
   (filter
    (fn [path]
      (deref (File/exists? path)))
    paths)))

(defn ^{:public true} resolve-file
  [path context]
  (let [candidates (candidate-paths path context)
        found (first-existing candidates)]
    (if found
      found
      (throw
       (ex :not-found {:error/type :std.config/missing-file
         :path path
         :candidates candidates
         :include/stack (vec (or (:config/include-stack context) []))} :ex/message (str "Configuration file does not exist: " path))))))

(defn ^{:public true} extension-type
  [path default-type]
  (cond
    (str/ends-with? path ".json") :json
    (str/ends-with? path ".edn") :edn
    :else default-type))

(defn ^{:public true} path-parts
  [value]
  (cond
    (vector? value) value
    (list? value) (vec value)
    (keyword? value)
    (if (namespace value)
      [value]
      (vec
       (map keyword
            (str/split (name value) "."))))
    (symbol? value)
    (vec
     (map keyword
          (str/split (str value) ".")))
    (string? value)
    (vec
     (map keyword
          (str/split value ".")))
    :else [value]))

(defn ^{:public true} compatible-get
  [value key]
  (if (not (map? value))
    nil
    (if (has? value key)
      (get value key)
      (cond
        (keyword? key) (get value (name key))
        (string? key) (get value (keyword key))
        :else nil))))

(defn ^{:public true} compatible-get-in
  [value path]
  (reduce
   (fn [current key]
     (compatible-get current key))
   value
   (path-parts path)))

(defn ^{:public true} select-content
  [content selection]
  (let [content (if (:in selection)
                  (compatible-get-in content (:in selection))
                  content)
        content (if (:exclude selection)
                  (apply dissoc content (:exclude selection))
                  content)]
    (if (:keys selection)
      (select-keys content (:keys selection))
      content)))

(defn ^{:public true} contains-value?
  [values target]
  (reduce
   (fn [found value]
     (or found (= value target)))
   false
   values))

(defn ^{:public true} replace-first
  [source token replacement]
  (let [index (str/index-of source token)]
    (if (or (nil? index) (neg? index))
      source
      (str
       (str/slice source 0 index)
       replacement
       (str/slice source (+ index (str/length token)))))))

(defn ^{:public true} format-values
  "Portable subset of Foundation format used by configuration documents. Each
   %s placeholder consumes one value."
  [template values]
  (reduce
   (fn [output value]
     (replace-first output "%s" (str value)))
   (str template)
   values))
