(ns std.config.ext.json)

(defn ^{:public true} keyword-key
  [key]
  (if (string? key)
    (keyword key)
    key))

(declare keywordize)

(defn ^{:public true} keywordize-map
  [value]
  (reduce
   (fn [output entry]
     (assoc output
            (keyword-key (nth entry 0))
            (keywordize (nth entry 1))))
   {}
   value))

(defn ^{:public true} keywordize
  [value]
  (cond
    (map? value) (keywordize-map value)
    (vector? value) (vec (map keywordize value))
    (list? value) (apply list (map keywordize value))
    :else value))

(defn ^{:public true} read-json
  [content]
  (keywordize (Json/read content)))
