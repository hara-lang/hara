(ns code.framework.detail
  (:config {:role :internal})
  (:require [std.block :as block]))

(defn ^{:public true} detailed-analysis
  "Parses source with std.block only when source-preserving detail is requested."
  [source]
  (let [result (block/parse-source source)
        root (:block result)]
    {:block root
     :rendered (block/string root)
     :diagnostics (:diagnostics result)}))

(defn ^{:public true} enrich-reader-analysis
  "Adds detailed block data without changing reader-derived semantic facts."
  [analysis source]
  (assoc analysis :detail (detailed-analysis source)))

(defn ^{:public true} semantic-facts
  "Selects the facts whose ownership remains with the reader-first analysis."
  [analysis]
  (select-keys analysis [:namespace :routes :definitions :links :fingerprint]))
