(ns code.framework
  (:config {:role :facade})
  (:require [code.framework.detail :as detail]
            [code.framework.index :as index]
            [code.framework.link :as link]
            [code.framework.reader :as reader]
            [code.framework.source :as source]))

(intern-in
 [source-fingerprint reader/source-fingerprint]
 [transform-code source/transform-code]
 [analyse-forms reader/analyse-forms]
 [analyse-source reader/analyse-source]
 [analyse-linkage-forms reader/analyse-linkage-forms]
 [analyse-linkage-source reader/analyse-linkage-source]
 [detailed-analysis detail/detailed-analysis]
 [enrich-reader-analysis detail/enrich-reader-analysis]
 [semantic-facts detail/semantic-facts]
 [empty-index index/empty-index]
 [invalidate-source index/invalidate-source]
 [reset-index index/reset-index]
 [cached-analysis index/cached-analysis]
 [upsert-analysis index/upsert-analysis]
 [links-to index/links-to]
 [Linkage link/Linkage]
 [linkage? link/linkage?]
 [linkage link/linkage]
 [linkage-from-index link/linkage-from-index]
 [dependency-map link/dependency-map])
