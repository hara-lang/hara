(def ^{:public true} test-path-for unit-scaffold/test-path-for)

(defn ^{:public true} test-namespace-for
  ([code-unit options]
   (unit-scaffold/test-namespace-for
    code-unit options (:namespace (unit/analyse code-unit))))
  ([code-unit options source-namespace]
   (unit-scaffold/test-namespace-for code-unit options source-namespace)))
(def ^{:public true} definition-names unit/definition-names)
(def ^{:public true} public-definition-names unit/public-definition-names)
(def ^{:public true} reachable-definition-names unit/reachable-definition-names)
(def ^{:public true} orphaned-meta unit/orphaned-meta)
(def ^{:public true} includes-any? unit/includes-any?)
(def ^{:public true} remove-matching-lines unit/remove-matching-lines)
(def ^{:public true} replacements unit/replacements)
(def ^{:public true} replace-all unit/replace-all)
(def ^{:public true} refactor-swap unit/refactor-swap)
(def ^{:public true} incomplete-report automation/incomplete-report)

(def ^{:public true} task? template/task?)
(def ^{:public true} task-operation template/task-operation)
(def ^{:public true} tasklet-reference template/tasklet-reference)
(def ^{:public true} batch-records template/batch-records)
(def ^{:public true} run-task template/run-task)

(def ^{:public true} legacy-operations
  [:analyse :extract :vars :docstrings :transform-code :import :purge
   :missing :todos :incomplete :incomplete-report :orphaned :scaffold
   :create-tests :in-order :arrange :factcheck-remove :factcheck-generate
   :snapto :isolate :locate-code :locate-test :grep :grep-replace :unclean
   :unchecked :commented :pedantic :refactor-code :refactor-test :ns-format
   :ns-rename :find-usages :require-file :heal-code])

(def ^{:public true} editing-operations
  #{:transform-code :import :purge :scaffold :create-tests :arrange
    :factcheck-remove :factcheck-generate :snapto :isolate :grep-replace
    :refactor-code :refactor-test :ns-format :ns-rename :heal-code})

(def ^{:public true} parity-inventory
  (reduce
   (fn [output operation]
     (assoc output operation
            {:status :supported
             :boundary (if (has? editing-operations operation)
                         :pure-edit-plan
                         :portable-inspection)}))
   {}
   legacy-operations))

(def ^{:public true} +tasks+
  {:analyse analyse
   :extract extract
   :vars vars
   :docstrings docstrings
   :transform-code transform-code
   :import import
   :purge purge
   :missing missing
   :todos todos
   :incomplete incomplete
   :orphaned orphaned
   :scaffold scaffold
   :create-tests create-tests
   :in-order in-order?
   :arrange arrange
   :factcheck-remove factcheck-remove
   :factcheck-generate factcheck-generate
   :snapto snapto
   :isolate isolate
   :locate-code locate-code
   :locate-test locate-test
   :grep grep
   :grep-replace grep-replace
   :unclean unclean
   :unclean-findings unclean-findings
   :unchecked unchecked
   :commented commented
   :pedantic pedantic
   :refactor-code refactor-code
   :refactor-test refactor-test
   :ns-format ns-format
   :ns-rename ns-rename
   :find-usages find-usages
   :require-file require-file
   :heal-code heal-code})

(def ^{:public true} operation-tasks +tasks+)

(defn ^{:public true} command-task
  [operation]
  (or (get +tasks+ operation)
      (throw (ex :unsupported {:operation operation}
                 :ex/message "Unsupported code.manage workflow"))))

(defn ^{:public true} result-edit
  [value]
  (if (and (map? value) (has? value :after)) value nil))

(defn ^{:public true} result-findings
  [value]
  (cond
    (and (map? value) (:finding value))
    [(:finding value)]
    (vector? value)
    (vec (filter (fn [entry]
                   (and (map? entry) (:kind entry)))
                 value))
    :else
    []))

(defn ^{:public true} plan
  "Runs one code.manage operation and projects its stable plan envelope."
  [operation input]
  (let [batch (template/run-task (command-task operation) input)
        data (if (:data batch) (:data batch) batch)
        records (template/batch-records data)
        values (vec (map :data (map template/legacy-record records)))
        edits (vec (filter identity (map result-edit values)))
        findings (vec (mapcat result-findings values))]
    {:operation operation
     :records records
     :results (vec (map (fn [record]
                          {:item/id (:item/id record)
                           :item/value (:data (template/legacy-record record))})
                        records))
     :edits edits
     :findings findings
     :warnings (vec (filter (fn [record] (= :warn (:status record)))
                            records))
     :errors (vec (filter (fn [record]
                            (or (= :error (:status record))
                                (= :critical (:status record))))
                          records))
     :summary {:operation operation
               :count (count records)
               :changed (count (filter :changed edits))
               :findings (count findings)
               :warnings (count (filter (fn [record] (= :warn (:status record)))
                                        records))
               :errors (count (filter (fn [record]
                                       (or (= :error (:status record))
                                           (= :critical (:status record))))
                                     records))}}))

(def ^{:public true} maintenance-work
  command-task)

(defn ^{:public true} run
  [operation input]
  (if (= operation :incomplete-report)
    (incomplete-report (:units (context/task-input input)))
    (template/run-task (command-task operation) input)))
