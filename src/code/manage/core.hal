(ns code.manage.core
  (:config {:role :internal})
  (:require [code.manage.automation :as automation]
            [code.manage.context :as context]
            [code.manage.ns-format :as manage-format]
            [code.manage.ns-rename :as manage-rename]
            [code.manage.unit :as unit]
            [code.manage.unit.contract :as contract]
            [code.manage.unit.factcheck :as factcheck]
            [code.manage.unit.import :as unit-import]
            [code.manage.unit.isolate :as unit-isolate]
            [code.manage.unit.require :as unit-require]
            [code.manage.unit.scaffold :as unit-scaffold]
            [code.manage.unit.snapto :as unit-snapto]
            [code.manage.unit.template :as template]
            [code.manage.var :as var]))

(defn compose-task
  [operation tasklet tasklet-reference argcount]
  (template/task
   {:operation operation
    :main {:fn tasklet
           :symbol tasklet-reference
           :argcount argcount}}))

(def ^{:public true} analyse
  (compose-task :analyse unit/analyse 'code.manage.unit/analyse 1))

(def ^{:public true} extract
  (compose-task :extract unit/extract 'code.manage.unit/extract 1))

(def ^{:public true} vars
  (compose-task :vars unit/vars 'code.manage.unit/vars 1))

(def ^{:public true} docstrings
  (compose-task :docstrings unit/docstrings 'code.manage.unit/docstrings 1))

(def ^{:public true} transform-code
  (compose-task :transform-code unit/transform-code
                'code.manage.unit/transform-code 2))

(def ^{:public true} import
  (compose-task :import unit-import/import
                'code.manage.unit.import/import 2))

(def ^{:public true} purge
  (compose-task :purge unit/purge 'code.manage.unit/purge 2))

(def ^{:public true} missing
  (compose-task :missing unit/missing 'code.manage.unit/missing 2))

(def ^{:public true} todos
  (compose-task :todos unit/todos 'code.manage.unit/todos 1))

