(ns code.manage.unit.factcheck
  (:config {:role :internal})
  (:require [code.manage.unit :as unit]
            [code.manage.unit.import :as unit-import]))

(defn factcheck-remove
  [code-unit options]
  (unit/purge
   code-unit
   {:patterns
    [(or (:marker options) "#fact")]}))

(defn factcheck-generate
  [code-unit options]
  (unit-import/import
   code-unit
   {:form
    (or (:form options)
        "#fact {:type :core}")}))

