(ns code.manage.unit.require
  (:config {:role :internal})
  (:require [code.manage.unit :as unit]))

(defn require-file
  [code-unit]
  (vec
   (map
    (fn [entry]
      (if (symbol? (:name entry))
        (:name entry)
        (symbol (str (:name entry)))))
    (filter
     (fn [entry]
       (not=
        (:kind entry)
        :private-function))
     (unit/extract code-unit)))))
