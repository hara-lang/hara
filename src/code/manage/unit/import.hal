(ns code.manage.unit.import
  (:config {:role :internal :override [import]})
  (:require [code.manage.unit.structure :as structure]))

(defn import
  "Imports fact titles and :added metadata into matching source definitions."
  [code-unit options]
  (let [before (:source code-unit)
        analysis (structure/analyse-structure before)
        namespace (:namespace analysis)
        test-path (or (:test-path code-unit) (:path code-unit))
        facts (structure/facts-from-source
               (or (:test-source code-unit) "")
               test-path)
        references (structure/facts-by-reference facts)
        matched
        (vec
         (keep
          (fn [definition]
            (let [refer (structure/source-reference namespace definition)
                  fact (get references refer)]
              (if (and (:public definition) fact)
                {:definition definition :fact fact :refer refer}
                nil)))
          (:definitions analysis)))
        edits
        (reduce
         (fn [output entry]
           (into output
                 (structure/definition-import-edits
                  before
                  (:definition entry)
                  (:fact entry))))
         []
         matched)
        after (structure/apply-edits before edits)]
    {:path (:path code-unit)
     :before before
     :after after
     :changed (not= before after)
     :create false
     :write false
     :imported (vec (map (fn [entry] (:refer entry)) matched))
     :count (count matched)}))
