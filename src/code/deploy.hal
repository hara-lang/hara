(ns code.deploy
  (:config {:role :facade})
  (:require [code.deploy.catalog :as catalog]
            [code.deploy.dependency :as dependency]
            [code.deploy.lifecycle :as lifecycle]
            [code.deploy.registry :as registry]
            [code.deploy.stage :as stage]
            [code.deploy.task :as task]))

(intern-in
 [read-project catalog/read-project]
 [read-catalog catalog/read-catalog]
 [plan catalog/plan]
 [dependency-order catalog/dependency-order]
 [dependency dependency/dependency]
 [dependencies dependency/dependencies]
 [satisfies? dependency/satisfies?]
 [release-candidates dependency/release-candidates]
 [resolve dependency/resolve]
 [lock-document dependency/lock-document]
 [lock-valid? dependency/lock-valid?]
[sync registry/sync]
[pull registry/pull]
[check registry/check]
 [add registry/add]
 [remove registry/remove]
 [phases lifecycle/+phases+]
 [phase? lifecycle/phase?]
 [phase-key lifecycle/phase-key]
 [phases-through lifecycle/phases-through]
 [run-phase lifecycle/run-phase]
 [lifecycle lifecycle/run]
 [goal lifecycle/goal]
 [clean lifecycle/clean]
 [stage stage/stage-plan]
 [reset-stage stage/reset-stage]
 [delete-tree stage/delete-tree]
 [build task/build-staged]
 [run task/run])
