(ns code.deploy
  (:config {:role :facade})
  (:require [code.deploy.catalog :as catalog]
            [code.deploy.stage :as stage]
            [code.deploy.task :as task]))

(intern-in
 [read-project catalog/read-project]
 [read-catalog catalog/read-catalog]
 [plan catalog/plan]
 [dependency-order catalog/dependency-order]
 [stage stage/stage-plan]
 [reset-stage stage/reset-stage]
 [delete-tree stage/delete-tree]
 [build task/build-staged]
 [run task/run])
