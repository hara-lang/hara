(ns code.test.compile
  (:config {:role :internal})
  (:require [code.test.base.process :as process]
            [code.test.context :as context]
            [code.test.registry :as registry]))

(def ^{:public true} => '=>)

(defn ^{:public true} fact-pair
  "Validates and decomposes the supported v1 `actual => expected` fact body."
  [body]
  (if (and (= (count body) 3) (= (nth body 1) =>))
    {:actual (first body) :expected (nth body 2)}
    (throw (ex :argument {:body body}
               :ex/message "fact expects one actual => expected pair"))))

(defmacro ^{:public true} fact
  "Registers a native Test fact for the Foundation loose assertion form."
  [description & body]
  (let [entries
        (loop [remaining (vec body)
               output []]
          (if (empty? remaining)
            output
            (if (and (>= (count remaining) 3)
                     (= (nth remaining 1) =>))
              (recur (vec (rest (rest (rest remaining))))
                     (conj output {:type :check
                                   :actual (nth remaining 0)
                                   :expected (nth remaining 2)}))
              (recur (vec (rest remaining))
                     (conj output {:type :form
                                   :form (first remaining)})))))
        steps
        (vec
         (map (fn [entry]
                (if (= :check (:type entry))
                  `(swap! results conj
                          (code.test.base.process/check
                           (fn [] ~(:actual entry))
                           ~(:expected entry)))
                  (:form entry)))
              entries))
        namespace (:ns &env)
        metadata (or (meta &form) {})]
    `(let [fact#
           (code.test.registry/register
            '~namespace
            {:desc ~description
             :function (fn [_]
                         (let [results (atom [])]
                           (do ~@steps)
                           (deref results)))
             :meta ~metadata})]
       (if (code.test.context/eval-mode?)
         (Test/run-fact fact# {})
         fact#))))

(defmacro ^{:public true} fact:template
  [description & body]
  `(code.test.compile/fact ~description ~@body))

(defmacro ^{:public true} fact:all
  []
  `(code.test.registry/facts '~(:ns &env)))

(defmacro ^{:public true} fact:list
  []
  `(code.test.registry/list-facts '~(:ns &env)))

(defmacro ^{:public true} fact:get
  [description]
  `(code.test.registry/get-fact '~(:ns &env) ~description))

(defmacro ^{:public true} fact:exec
  [description & arguments]
  `(code.test.registry/execute '~(:ns &env) ~description ~(or (first arguments) {})))

(defmacro ^{:public true} fact:purge
  []
  `(code.test.registry/purge '~(:ns &env)))

(defmacro ^{:public true} fact:missing
  [descriptions]
  `(code.test.registry/missing '~(:ns &env) ~descriptions))

(defmacro ^{:public true} fact:setup
  [description]
  `(code.test.registry/setup '~(:ns &env) ~description))

(defmacro ^{:public true} fact:setup?
  [description]
  `(code.test.registry/setup? '~(:ns &env) ~description))

(defmacro ^{:public true} fact:teardown
  [description]
  `(code.test.registry/teardown '~(:ns &env) ~description))

(defmacro ^{:public true} fact:remove
  [description]
  `(code.test.registry/remove '~(:ns &env) ~description))

(defmacro ^{:public true} fact:symbol
  [description]
  `(get-in (code.test.registry/get-fact '~(:ns &env) ~description) [:meta :refer]))
