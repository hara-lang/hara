(ns code.test.manage
  (:config {:role :internal})
  (:require [code.test.context :as context]
            [code.test.registry :as registry]))

(defmacro ^{:public true} fact:global
  "Gets or installs the Foundation global test settings and lifecycle hooks."
  ([]
   `(:settings (code.test.context/state)))
  ([settings]
   (let [settings (or settings {})
         setup (vec (or (:setup settings) []))
         teardown (vec (or (:teardown settings) []))
         options (dissoc settings :setup :teardown)]
     `(do
        (code.test.registry/configure-lifecycle
         {:before-all (fn [] (do ~@setup))
          :after-all (fn [] (do ~@teardown))})
        (code.test.context/configure
         {:settings ~options
          :lifecycle {:before-all (fn [] (do ~@setup))
                      :after-all (fn [] (do ~@teardown))}})
        (:settings (code.test.context/state))))))

(defn ^{:public true} fact:ns
  "Returns requested namespace operations for the Hara CLI route to own.
  Source load/unload is host-owned in the native architecture."
  [& operations]
  (vec operations))

(defn ^{:public true} fact:ns-load
  "Returns code.test facts registered for a namespace after CLI loading."
  [namespace]
  (registry/facts namespace))
