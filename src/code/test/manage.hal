(ns code.test.manage
  (:config {:role :internal})
  (:require [code.test.context :as context]
            [code.test.registry :as registry]))

(defn ^{:public true} fact:global
  "Gets or replaces the code.test run-settings map. Global setup evaluation is
  deliberately owned by the native Test lifecycle hooks, not a second evaluator."
  ([] (:settings (context/state)))
  ([settings]
   (context/configure {:settings (or settings {})})
   (:settings (context/state))))

(defn ^{:public true} fact:ns
  "Returns requested namespace operations for the Hara CLI route to own.
  Source load/unload is host-owned in the native architecture."
  [& operations]
  (vec operations))

(defn ^{:public true} fact:ns-load
  "Returns code.test facts registered for a namespace after CLI loading."
  [namespace]
  (registry/facts namespace))
