(ns code.test.checker.schema
  (:config {:role :internal})
  (:require [code.test.checker :as checker]
            [std.typed.schema :as schema]))

(defn ^{:public true} conforms
  "Creates a portable matcher backed by the current typed-schema validator."
  [form]
  (checker/checker
   :typed/schema
   form
   (fn [actual]
     (schema/valid? form actual))))
