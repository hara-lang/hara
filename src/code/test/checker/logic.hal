(ns code.test.checker.logic
  (:config {:role :internal})
  (:require [code.test.checker :as checker]))

(defn ^{:public true} is-not
  "Creates a matcher that negates another expectation."
  [expected]
  (checker/checker :is-not expected
                   (fn [actual] (not (checker/matches? expected actual)))))

(defn ^{:public true} any
  "Creates a matcher that accepts an actual value matching any expectation."
  [& expected]
  (checker/checker :any (vec expected)
                   (fn [actual]
                     (reduce (fn [matched value]
                               (or matched (checker/matches? value actual)))
                             false expected))))

(defn ^{:public true} all
  "Creates a matcher that requires every expectation to match."
  [& expected]
  (checker/checker :all (vec expected)
                   (fn [actual]
                     (reduce (fn [matched value]
                               (and matched (checker/matches? value actual)))
                             true expected))))
