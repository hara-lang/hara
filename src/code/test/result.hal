(ns code.test.result
  (:config {:role :internal})
  (:require [code.test.checker :as checker]))

(defn ^{:public true} compare
  "Compares an actual value against an exact value or a code.test matcher."
  [actual expected]
  (try
    (Test/compare (checker/matches? expected actual) true)
    (catch error
      (Result/create
       :error
       error
       {:test {:actual actual :expected (checker/checker-view expected)}
        :failures []}))))

(defn ^{:public true} comparison-result
  "Creates a native Test result while retaining a portable expected matcher view."
  [desc actual expected comparison]
  (Test/result desc actual (checker/checker-view expected) comparison))

(defn ^{:public true} comparison-passed? [result] (Test/passed? result))
(defn ^{:public true} comparison-actual [result] (Test/actual result))
(defn ^{:public true} comparison-expected [result] (Test/expected result))
(defn ^{:public true} comparison-failure-count [result] (Test/failure-count result))
(defn ^{:public true} comparison-failure [result index] (Test/failure result index))
