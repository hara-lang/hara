(ns code.test.base.process
  (:config {:role :internal})
  (:require [code.test.checker :as checker]
            [code.test.result :as result]))

(defn ^{:public true} error-result
  "Converts evaluation failure into a native error Result with portable expectation data."
  [expected error]
  (Test/result
   "code.test/check"
   nil
   (checker/checker-view expected)
   (Result/create
    :error
    error
    {:test {:actual nil :expected (checker/checker-view expected)}
     :failures []})))

(defn ^{:public true} check
  "Evaluates a thunk once. Only error matchers accept thrown outcomes; they
  never accept a normal return, even when the returned value is an exception."
  [thunk expected]
  (let [expects-error (and (checker/checker? expected)
                           (has? #{:throws :throws-info} (:checker/type expected)))
        outcome (try
                  {:value (thunk) :thrown false}
                  (catch error {:value error :thrown true}))
        actual (:value outcome)]
    (if (:thrown outcome)
      (if expects-error
        (result/comparison-result "code.test/check" actual expected
                                  (result/compare actual expected))
        (error-result expected actual))
      (result/comparison-result "code.test/check" actual expected
                                (if expects-error
                                  (Test/compare false true)
                                  (result/compare actual expected))))))
