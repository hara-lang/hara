(ns code.doc.commonmark
  (:config {:role :internal})
  (:require [docs.markdown :as markdown]))

(defn ^{:public true} render
  "Renders CommonMark through the declared `docs.markdown` Component namespace.
   The Component is selected by ordinary extension configuration; code.doc does
   not maintain a second renderer registry or grant filesystem capability."
  [source]
  (if (string? source)
    (markdown/render source)
    (throw (ex :code.doc/markdown-required
               {:ex/message "CommonMark source must be text"
                :source source}))))
