(ns code.doc.render.util
  (:config {:role :internal})
  (:require [code.doc.commonmark :as commonmark]))

(defn ^{:public true} adjust-indent
  "Removes a fixed leading whitespace width from every applicable line."
  [text spaces]
  (str/join
   "\n"
   (map
    (fn [line]
      (if (and (< spaces (str/length line))
               (str/blank? (str/slice line 0 spaces)))
        (str/slice line spaces)
        line))
    (str/split-lines text))))

(defn ^{:public true} basic-html-escape
  "Escapes plain text for a static HTML context."
  [data]
  (reduce
   (fn [output pair]
     (str/replace output (nth pair 0) (nth pair 1)))
   (str data)
   [["&" "&amp;"]
    ["<" "&lt;"]
    [">" "&gt;"]
    ["\"" "&quot;"]
    ["\\" "&#92;"]]))

(defn ^{:public true} basic-html-unescape
  "Restores the nested entity forms produced by the static documentation path."
  [data]
  (reduce
   (fn [output pair]
     (str/replace output (nth pair 0) (nth pair 1)))
   data
   [["&amp;quot;" "&quot;"]
    ["&amp;lt;" "&lt;"]
    ["&amp;gt;" "&gt;"]
    ["&amp;amp;" "&amp;"]]))

(defn ^{:public true} join-string
  "Returns text directly or joins a vector of text fragments without coercion."
  [data]
  (cond
    (string? data) data
    (vector? data) (str/join "" data)))

(defn ^{:public true} markup
  "Renders CommonMark through the configured standard Component."
  [data]
  (commonmark/render data))
