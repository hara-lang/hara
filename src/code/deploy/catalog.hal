(ns code.deploy.catalog
  (:config {:role :internal})
  (:require [code.framework :as framework]
            [code.framework.cache :as cache]))

(def +default-catalog-path+
  "config/packages.edn")

(defn project-path
  "Returns the canonical project declaration location below a deploy root."
  [root]
  (File/join root "project.edn"))

(defn read-edn
  "Reads one UTF-8 EDN document through the capability-gated file boundary."
  [path]
  (Edn/read
   (String/decode-utf8
    (deref (File/read path)))))

(defn ^{:public true} read-project
  "Reads the source project's data-only project.edn declaration."
  [root]
  (read-edn (project-path root)))

(defn catalog-relative-path
  "Selects the Foundation-compatible catalogue path declared by a project."
  [project]
  (or (get-in project [:project/deploy :catalog])
      +default-catalog-path+))

(defn ^{:public true} catalog-path
  "Returns the configured package catalogue path for a deploy root."
  [root]
  (File/join root (catalog-relative-path (read-project root))))

(defn catalog-map
  "Normalises Foundation's direct package map and the optional :packages wrapper."
  [value]
  (let [packages (or (:packages value) value)]
    (cond
      (map? packages)
      packages

      :else
      (throw
       (ex :code.deploy/invalid-catalog
           {:catalog value}
           :ex/message "config/packages.edn must be a package map")))))

(defn ^{:public true} read-catalog
  "Reads a Foundation-compatible config/packages.edn document."
  [root]
  (catalog-map (read-edn (catalog-path root))))

(defn source-path
  "Returns one project-relative source path as an absolute deploy-root path."
  [root relative-path]
  (File/join root relative-path))

(defn merge-sorted-paths
  "Merges two already ordered path vectors in linear time."
  [left right]
  (loop [left left
         right right
         output []]
    (cond
      (empty? left) (into output right)
      (empty? right) (into output left)
      (<= (compare (first left) (first right)) 0)
      (recur (rest left) right (conj output (first left)))
      :else
      (recur left (rest right) (conj output (first right))))))

(defn ^{:public true} sort-paths
  "Orders source paths with a merge sort instead of Foundation's insertion sort."
  [paths]
  (let [paths (vec paths)
        size (count paths)]
    (if (<= size 1)
      paths
      (let [middle (quot size 2)]
        (merge-sorted-paths
         (sort-paths (subvec paths 0 middle))
         (sort-paths (subvec paths middle size)))))))

(defn source-analysis
  "Refreshes reader-first analysis using the timestamp-and-bytes framework cache."
  [root state relative-path]
  (let [path (source-path root relative-path)
        result (cache/refresh-path root state path)]
    (assoc result :source/path relative-path)))

(defn project-source-files
  "Returns the deterministic deploy source graph for a project.

  Explicit files remain supported for compatibility, but deploy planning also
  discovers Hara files below :project/source-paths. This keeps package
  profiles complete when a project grows without requiring a generated source
  list to be maintained by hand. :project/deploy :source-excludes removes
  intentionally non-release trees from the discovered graph."
  [root project]
  (let [root-path (File/resolve (str root) "")
        root-prefix (if (str/ends-with? root-path "/")
                      root-path
                      (str root-path "/"))
        explicit (or (:project/source-files project) [])
        source-roots (or (:project/source-paths project) ["src" "src-lang"])
        discovered
        (mapcat
        (fn [source-root]
           (let [path (File/join root-path source-root)]
             (if (deref (File/exists? path))
               (deref (File/walk path))
               [])))
         source-roots)
        candidates
        (concat
         explicit
         (map
          (fn [path]
            (let [path (str path)]
              (if (str/starts-with? path root-prefix)
                (str/slice path (str/length root-prefix) (str/length path))
                path)))
          discovered))
        excludes (or (get-in project [:project/deploy :source-excludes]) [])
        file-state
        (reduce
         (fn [state path]
           (let [path (str path)
                 output (:files state)
                 excluded?
                 (reduce
                  (fn [excluded? exclude]
                    (let [exclude (str exclude)]
                      (or excluded?
                          (= path exclude)
                          (str/starts-with? path (str exclude "/")))))
                  false
                  excludes)]
             (cond
               (not (str/ends-with? path ".hal")) state
               (str/includes? path "/.#") state
               excluded? state
               (has? (:seen state) path) state
               :else {:files (conj output path)
                      :seen (conj (:seen state) path)})))
         {:files [] :seen #{}}
         candidates)]
    (:files file-state)))

(defn ^{:public true} project-analyses
  "Returns reader-first analyses for the project's portable source graph.

  The deploy graph retains only the Linkage facts it needs during a release;
  durable source revisions are reused from code.framework.cache and the
  resulting index is persisted once per plan rather than once per source."
  [root project]
  (let [paths (project-source-files root project)
        initial (cache/load-index root)
        result
        (reduce
         (fn [state relative-path]
           (let [path (source-path root relative-path)
                 analysed (cache/analyse-path (:index state) path :linkage)
                 next-state
                 {:index (:index analysed)
                  :fresh? (or (:fresh? state) (not (:cached? analysed)))
                  :analyses (conj (:analyses state)
                                  (assoc (:analysis analysed)
                                         :source/path relative-path))
                  :analysed (inc (:analysed state))}]
             (if (and (not (:cached? analysed))
                      (= 0 (mod (:analysed next-state) 8)))
               (do
                 (cache/save-index root (:index next-state))
                 next-state)
               next-state)))
         {:index initial :fresh? false :analyses [] :analysed 0}
         paths)]
    (if (:fresh? result)
      (cache/save-index root (:index result))
      nil)
    (vec (:analyses result))))

(defn namespace-text
  "Returns the stable text form used by package selectors and coordinates."
  [namespace]
  (str namespace))

(defn within-namespace?
  "Returns true when a namespace is the selector root or one of its descendants."
  [root namespace]
  (let [root (namespace-text root)
        namespace (namespace-text namespace)]
    (or (= root namespace)
        (str/starts-with? namespace (str root ".")))))

(defn base-namespace?
  "Matches Foundation's :base selector root and .base implementation subtree."
  [root namespace]
  (let [root (namespace-text root)
        namespace (namespace-text namespace)]
    (or (= root namespace)
        (str/starts-with? namespace (str root ".base.")))))

(defn selector-matches?
  "Applies one Foundation selector `[namespace :base|:complete|:exclude]`."
  [selector namespace]
  (let [root (first selector)
        mode (second selector)]
    (cond
      (not (vector? selector))
      (throw
       (ex :code.deploy/invalid-selector
           {:selector selector}
           :ex/message "package selector must be a vector"))

      (not
       (or (and (= mode :base) (= 2 (count selector)))
           (and (= mode :complete) (= 2 (count selector)))
           (and (= mode :exclude) (= 3 (count selector)))))
      (throw
       (ex :code.deploy/invalid-selector
           {:selector selector}
           :ex/message "package selector has an unsupported Foundation shape"))

      (= mode :base)
      (base-namespace? root namespace)

      (= mode :complete)
      (within-namespace? root namespace)

      (= mode :exclude)
      (and (within-namespace? root namespace)
           (not
            (reduce
             (fn [excluded? excluded-root]
               (or excluded? (within-namespace? excluded-root namespace)))
             false
             (nth selector 2))))

      :else
      (throw
       (ex :code.deploy/invalid-selector
           {:selector selector}
           :ex/message "package selector has an unsupported Foundation shape")))))

(defn package-definition
  "Normalises one catalogue entry while retaining its original publication name."
  [name definition]
  (cond
    (not (map? definition))
    (throw
     (ex :code.deploy/invalid-package
         {:package/name name :package/definition definition}
         :ex/message "package definition must be a map"))

    (not (vector? (:include definition)))
    (throw
     (ex :code.deploy/invalid-package
         {:package/name name :package/definition definition}
         :ex/message "package definition requires an :include vector"))

    (and (:dependencies definition)
         (not (vector? (:dependencies definition))))
    (throw
     (ex :code.deploy/invalid-package
         {:package/name name :package/definition definition}
         :ex/message "package definition :dependencies must be a vector"))

    (and (:context-dependencies definition)
         (not (vector? (:context-dependencies definition))))
    (throw
     (ex :code.deploy/invalid-package
         {:package/name name :package/definition definition}
         :ex/message "package definition :context-dependencies must be a vector"))

    :else
    (assoc definition :package/name (str name))))

(defn ^{:public true} package-definitions
  "Returns package definitions in deterministic publication-name order."
  [catalog]
  (vec
   (map
    (fn [name]
      (package-definition name (get catalog name)))
    (sort-by str (keys (catalog-map catalog))))))

(defn selected-namespaces
  "Expands a package's selectors against reader-analysed source namespaces."
  [definition analyses]
  (let [selectors
        (vec
         (map
          (fn [selector]
            (selector-matches? selector (first selector))
            (let [root (namespace-text (first selector))
                  mode (second selector)]
              {:mode mode
               :root root
               :prefix (str root ".")
               :base-prefix (str root ".base.")
               :excluded
               (vec
                (map namespace-text
                     (if (= mode :exclude)
                       (nth selector 2)
                       [])))}))
          (:include definition)))]
    (vec
     (keep
      (fn [analysis]
        (let [namespace (:namespace analysis)
              namespace-text (if namespace (namespace-text namespace) nil)]
          (cond
            (and namespace-text
                 (reduce
                  (fn [selected? selector]
                    (or selected?
                        (let [root (:root selector)
                              mode (:mode selector)]
                          (cond
                            (= mode :base)
                            (or (= namespace-text root)
                                (str/starts-with? namespace-text
                                                   (:base-prefix selector)))

                            (= mode :complete)
                            (or (= namespace-text root)
                                (str/starts-with? namespace-text
                                                   (:prefix selector)))

                            (= mode :exclude)
                            (and (or (= namespace-text root)
                                     (str/starts-with? namespace-text
                                                        (:prefix selector)))
                                 (not
                                  (reduce
                                   (fn [excluded? excluded-root]
                                     (or excluded?
                                         (= namespace-text excluded-root)
                                         (str/starts-with?
                                          namespace-text
                                          (str excluded-root "."))))
                                   false
                                   (:excluded selector))))

                            :else false))))
                  false
                  selectors))
            namespace

            :else nil)))
      analyses))))

(defn ^{:public true} ownership
  "Assigns every selected namespace to exactly one package or raises overlap."
  ([definitions analyses]
   (ownership definitions analyses {}))
  ([definitions analyses selections]
   (reduce
    (fn [owners definition]
      (let [name (:package/name definition)
            namespaces (or (get selections name)
                           (selected-namespaces definition analyses))]
        (reduce
         (fn [current namespace]
           (let [previous (get current namespace)]
             (cond
               (nil? previous)
               (assoc current namespace name)

               :else
               (throw
                (ex :code.deploy/namespace-overlap
                    {:namespace namespace
                     :previous previous
                     :package name}
                    :ex/message "package selectors assign a namespace more than once")))))
         owners
         namespaces)))
    {}
    definitions)))

(defn ^{:public true} coordinate
  "Converts a semantic Foundation package name to the native Hara coordinate."
  [name]
  (let [name (str name)]
    (cond
      (str/includes? name ":") name
      (str/includes? name "/") (str "hara:" name)
      :else (str "hara:hara/" name))))

(defn dependency-package-name
  "Resolves a catalog dependency by semantic name or native coordinate."
  [definitions dependency]
  (let [dependency (str dependency)]
    (first
     (keep
      (fn [definition]
        (let [name (:package/name definition)]
          (cond
            (= dependency name) name
            (= dependency (coordinate name)) name
            :else nil)))
      definitions))))

(defn explicit-dependency-split
  "Separates catalog dependencies into profile-internal and external names."
  [definitions definition]
  (let [declared (or (:dependencies definition) [])
        internal
        (set
         (keep
          (fn [dependency]
            (dependency-package-name definitions dependency))
          declared))
        external
        (set
         (keep
          (fn [dependency]
            (let [dependency (str dependency)]
              (if (has? internal (dependency-package-name definitions dependency))
                nil
                dependency)))
          declared))]
    {:internal (vec (sort internal))
     :external (vec (sort external))}))

(defn explicit-context-dependency-split
  "Resolves compile-context-only package dependencies from a catalogue entry.

  Context dependencies make source available to the native compiler without
  becoming install-time package edges. This is required for lazy namespace
  links whose declarations are still resolved while a package is compiled."
  [definitions definition]
  (let [declared (or (:context-dependencies definition) [])
        internal
        (set
         (keep
          (fn [dependency]
            (dependency-package-name definitions dependency))
          declared))
        unresolved
        (vec
         (sort
          (keep
           (fn [dependency]
             (let [dependency (str dependency)]
               (if (has? internal (dependency-package-name definitions dependency))
                 nil
                 dependency)))
           declared)))]
    (cond
      (empty? unresolved)
      (vec (sort internal))

      :else
      (throw
       (ex :code.deploy/invalid-context-dependency
           {:package/name (:package/name definition)
            :dependencies unresolved}
           :ex/message "package context dependencies must name packages in the catalogue")))))

(defn package-dependencies
  "Infers direct internal dependencies through Linkage, excluding self ownership."
  ([linkage owners definition analyses]
   (package-dependencies linkage
                         owners
                         definition
                         analyses
                         (framework/dependency-map linkage)
                         (selected-namespaces definition analyses)))
  ([linkage owners definition analyses dependencies namespaces]
   (let [name (:package/name definition)
         namespaces (set namespaces)]
     (set
      (keep
       (fn [namespace]
         (let [owner (get owners namespace)]
           (cond
             (or (nil? owner) (= owner name)) nil
             :else owner)))
       (mapcat
        (fn [namespace]
          (get dependencies namespace #{}))
        namespaces))))))

(defn unresolved-namespaces
  "Reports selected source namespaces that no package catalogue entry owns."
  [owners analyses]
  (sort-paths
   (keep
    (fn [analysis]
      (let [namespace (:namespace analysis)]
        (cond
          (and namespace (nil? (get owners namespace))) namespace
          :else nil)))
    analyses)))

(defn ^{:public true} dependency-order
  "Returns a dependency-first order and rejects cycles before staging any output."
  [packages]
  (loop [pending
         (reduce
          (fn [output package]
            (assoc output (:package/name package)
                   (set (:package/internal-dependencies package))))
          {}
          packages)
         ordered []]
    (cond
      (empty? pending)
      ordered

      :else
      (let [ready
            (vec
             (sort
              (keep
               (fn [name]
                 (cond
                   (empty? (get pending name)) name
                   :else nil))
               (keys pending))))]
        (cond
          (empty? ready)
          (throw
           (ex :code.deploy/dependency-cycle
               {:packages (vec (sort (keys pending)))}
               :ex/message "inferred package dependencies contain a cycle"))

          :else
          (recur
           (reduce
            (fn [next name]
              (assoc next name
                     (reduce disj (get next name) ready)))
            (apply dissoc pending ready)
            (keys (apply dissoc pending ready)))
           (into ordered ready)))))))

(defn ^{:public true} plan
  "Builds the complete package graph from the source project and its catalogue."
  [root]
  (let [project (read-project root)
        catalog (read-catalog root)
        analyses (project-analyses root project)
        definitions (package-definitions catalog)
        selections
        (reduce
         (fn [output definition]
           (assoc output
                  (:package/name definition)
                  (selected-namespaces definition analyses)))
         {}
         definitions)
        owners (ownership definitions analyses selections)
        linkage (framework/linkage analyses)
        namespace-dependencies (framework/dependency-map linkage)
        source-by-namespace
        (reduce
         (fn [output analysis]
           (let [namespace (:namespace analysis)]
             (if namespace
               (assoc output namespace (:source/path analysis))
               output)))
         {}
         analyses)
        packages
        (vec
         (map
          (fn [definition]
            (let [name (:package/name definition)
                  namespaces (get selections name)
                  explicit (explicit-dependency-split definitions definition)
                  context (explicit-context-dependency-split definitions definition)
                  inferred (package-dependencies linkage
                                                  owners
                                                  definition
                                                  analyses
                                                  namespace-dependencies
                                                  namespaces)]
              {:package/name name
               :package/coordinate (coordinate name)
               :package/version (:project/version project)
               :package/definition definition
               :package/namespaces namespaces
               :package/source-files
               (vec
                (keep
                 (fn [namespace]
                   (get source-by-namespace namespace))
                 namespaces))
               :package/internal-dependencies
               (vec
                (sort-paths
                 (into (set inferred) (:internal explicit))))
               :package/context-dependencies context
               :package/external-dependencies
               (:external explicit)}))
          definitions))
        order (dependency-order packages)]
    {:deploy/root root
     :deploy/project project
     :deploy/catalog-path (catalog-path root)
     :deploy/analyses analyses
     :deploy/unowned-namespaces (unresolved-namespaces owners analyses)
     :deploy/packages packages
     :deploy/order order}))
