(ns code.doc
  (:config {:role :facade})
  (:require [code.doc.check :as check]
            [code.doc.commonmark :as commonmark]
            [code.doc.page :as page]))

(intern-in
 [check-page check/check-page]
 [render-commonmark commonmark/render]
 [render-page page/render-page]
 [render-static-page page/render-static-page]
 [read-page page/read-page]
 [page-output-path page/page-output-path]
 [page-document page/page-document])
