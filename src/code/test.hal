(ns code.test
  (:config {:role :facade})
  (:require [code.test.checker :as checker]
            [code.test.checker.collection :as collection]
            [code.test.checker.logic :as logic]
            [code.test.compile :as compile]
            [code.test.context :as context]
            [code.test.manage :as manage]
            [code.test.task :as task]))

(intern-in
 checker/throws
 checker/exactly
 checker/approx
 checker/satisfies
 checker/stores
 checker/anything
 checker/capture
 collection/contains
 collection/just
 collection/contains-in
 collection/just-in
 checker/throws-info
 logic/any
 logic/all
 logic/is-not
 context/with-new-context
 manage/fact:global
 manage/fact:ns
 manage/fact:ns-load
 task/run
 task/run:interrupt
 task/run:current
 task/run:load
 task/run:unload
 task/run:test
 task/run:report
 task/run-errored
 task/print-options
 compile/fact
 compile/fact:all
 compile/fact:purge
 compile/fact:list
 compile/fact:symbol
 compile/fact:get
 compile/fact:missing
 compile/fact:exec
 compile/fact:setup
 compile/fact:setup?
 compile/fact:teardown
 compile/fact:remove
 compile/fact:template
 compile/=>)
