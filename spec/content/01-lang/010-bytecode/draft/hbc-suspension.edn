{:document/id :hal/hbc-suspension
 :document/type :portable-machine-extension
 :document/version "0-alpha"
 :document/status :draft
 :document/title "Process-local HBC suspension and resumption"
 :extends :hal/hbc-machine

 :boundary
 {:portable "Await and Yield opcodes are portable HBC instructions."
  :process-local "A parked machine, Promise, continuation, scheduler token, provider callback, cancellation hook, or host identity is never serialized into HBC0 or HBX."
  :durability false}

 :outcomes
 {:completed "terminal ordinary Hara value"
  :failed "terminal structured execution error"
  :suspended "parked at await with one process-local Promise"
  :yielded "parked at yield with one observable yielded value"}

 :await
 {:fulfilled "push the settled value and continue without parking"
  :rejected "resume by raising the rejection through ordinary HBC exception unwinding"
  :pending "park the complete machine exactly once and retain the Promise through a process-local continuation"
  :settlement "one fulfillment or rejection schedules one resumption; later settlement attempts have no effect"}

 :yield
 {:initial "pop and expose the yielded value, park before the following instruction"
  :resume "push the caller-supplied resume value and continue"
  :terminal "resuming a completed, failed, or disposed machine is an explicit state error"}

 :async-functions
 {:call "return one stable result Promise immediately"
  :completion "fulfill the result Promise with the returned Hara value"
  :failure "reject it with the structured execution error"
  :nested-suspension "the same result Promise survives every internal park and resume"}

 :cancellation
 {:rule "terminal cancellation rejects the result Promise, invokes at most one pending host cancellation hook, and makes later settlement/resumption inert"
  :disposal "disposal is idempotent and terminal"
  :finally "language finally behavior runs when cancellation is represented as an execution unwind; host disposal itself does not fabricate guest instructions"}

 :conformance
 {:identity :hal/hbc-suspension-conformance
  :path "conformance/bytecode-vm-suspension.edn"
  :covers [:fulfilled-await :pending-await :rejected-await :nested-frames
           :finally :yield-resume :async-result-promise :cancellation
           :native-host-promise :browser-host-promise]}}
