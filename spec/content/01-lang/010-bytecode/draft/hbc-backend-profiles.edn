{:document/id :hal/hbc-backend-profiles
 :document/type :implementation-profile-registry
 :document/version "0-alpha"
 :document/status :draft
 :document/title "HBC backend execution profiles"

 :profiles
 {:rust-stack-vm
  {:profile/id :rust-stack-vm
   :provider :rust
   :engine :stack-vm
   :wire :hal/hbc0-wire
   :machine :hal/hbc-machine
   :suspension :hal/hbc-suspension
   :claim "Reference portable operand-stack execution with explicit frames; no optimizing-tier claim."}

  :rust-tracing
  {:profile/id :rust-tracing
   :provider :rust
   :engine :tracing
   :status :optional-derived-tier
   :input :validated-hbc
   :fallback :rust-stack-vm
   :claim "Guarded process-local trace specialization; traces are not portable artifacts."}

  :rust-whole-wasm
  {:profile/id :rust-whole-wasm
   :provider :rust
   :engine :whole-wasm
   :status :optional-derived-tier
   :input :validated-hbc
   :fallback :rust-stack-vm
   :claim "Deterministic derived Wasm execution with authenticated HBC fallback; HNW is not a public tool.vm format."}

  :java-reference-vm
  {:profile/id :java-reference-vm
   :provider :truffle
   :engine :reference-vm
   :wire :hal/hbc0-wire
   :machine :hal/hbc-machine
   :claim "Java reference HbcMachine execution. It does not claim opcode-level Truffle partial evaluation."}

  :truffle-bytecode-dsl
  {:profile/id :truffle-bytecode-dsl
   :provider :truffle
   :engine :truffle-bytecode
   :status :future
   :claim "Reserved for a backend where individual HBC operations participate in Truffle compilation; providers must not advertise it before implementation."}}

 :reporting
 {:rule "tool.vm capabilities report only implemented profiles for the selected runtime build"
  :engine-vs-profile "The engine is the execution mechanism for a format; the profile id is the stable conformance claim."
  :no-aspiration "A source file, class name, experiment, or planned optimizer is not an implemented capability."}

 :boundaries
 {:wire :hal/hbc0-wire
  :machine :hal/hbc-machine
  :suspension :hal/hbc-suspension
  :halc :hal/halc-format
  :packaging "HBC[] -> HBX is owned by the HBX package specification, not by a backend profile."}}
