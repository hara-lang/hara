{:document/id :hal/metaspec
 :document/type :hal/language-metaspec
 :document/version "alpha"
 :document/status :draft
 :document/title "HAL language specification meta-spec"
 :document/summary
 "Defines the machine-readable shape, authority rules, and validation contract for a HAL language specification."

 :spec/conforms-to
 {:spec/id :hara/metaspec-metaspec
  :spec/version "alpha"}
 :spec/artifact-kind :hal/language-spec

 :meta/document-schema
 {:schema/id :hal.metaspec/language-document
  :schema/type :map
  :schema/closed false
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to :spec/scope
   :spec/invariants :spec/section-order :spec/sections :spec/forms
   :spec/references :spec/conformance]
  :schema/properties
  {:document/id {:schema/ref :hal.metaspec/qualified-keyword}
   :document/type {:schema/value :language-spec}
   :document/version {:schema/ref :hal.metaspec/version-string}
   :document/status {:schema/ref :hal.metaspec/status}
   :document/title {:schema/ref :hal.metaspec/non-empty-string}
   :document/summary {:schema/ref :hal.metaspec/non-empty-string}
   :spec/conforms-to {:schema/ref :hal.metaspec/spec-reference}
   :spec/scope {:schema/type :map}
   :spec/invariants {:schema/type :vector
                     :schema/items :hal.metaspec/requirement}
   :spec/section-order {:schema/type :vector
                        :schema/items :hal.metaspec/qualified-keyword
                        :schema/unique true}
   :spec/sections {:schema/type :vector
                   :schema/items :hal.metaspec/section}
   :spec/forms {:schema/type :vector
                :schema/items :hal.metaspec/form}
   :spec/references {:schema/type :vector
                     :schema/items :hal.metaspec/reference}
   :spec/conformance {:schema/type :vector}
   :spec/coverage {:schema/type :map}
   :spec/provenance {:schema/type :vector}}}

 :meta/schemas
 [{:schema/id :hal.metaspec/qualified-keyword
   :schema/type :keyword
   :schema/constraint :qualified}
  {:schema/id :hal.metaspec/non-empty-string
   :schema/type :string
   :schema/min-length 1}
  {:schema/id :hal.metaspec/version-string
   :schema/type :string
   :schema/pattern "^alpha$"}
  {:schema/id :hal.metaspec/status
   :schema/type :enum
   :schema/values [:draft :candidate :stable :deprecated :retired]}
  {:schema/id :hal.metaspec/spec-reference
   :schema/type :map
   :schema/required [:spec/id :spec/version]
   :schema/properties
   {:spec/id {:schema/ref :hal.metaspec/qualified-keyword}
    :spec/version {:schema/ref :hal.metaspec/version-string}}}
  {:schema/id :hal.metaspec/requirement
   :schema/type :map
   :schema/closed false
   :schema/required
   [:requirement/id :requirement/level :requirement/text]
   :schema/properties
   {:requirement/id {:schema/ref :hal.metaspec/qualified-keyword}
    :requirement/level
    {:schema/type :enum
     :schema/values [:must :must-not :should :should-not :may]}
    :requirement/text {:schema/ref :hal.metaspec/non-empty-string}
    :requirement/rationale {:schema/type :string}
    :requirement/evidence {:schema/type :vector
                           :schema/items :hal.metaspec/conformance-reference}}}
  {:schema/id :hal.metaspec/section
   :schema/type :map
   :schema/closed false
   :schema/required
   [:section/id :section/title :section/summary :section/requirements]
   :schema/properties
   {:section/id {:schema/ref :hal.metaspec/qualified-keyword}
    :section/title {:schema/ref :hal.metaspec/non-empty-string}
    :section/summary {:schema/ref :hal.metaspec/non-empty-string}
    :section/requirements {:schema/type :vector
                           :schema/items :hal.metaspec/requirement}
    :section/forms {:schema/type :vector
                    :schema/items :hal.metaspec/qualified-keyword}
    :section/references {:schema/type :vector
                         :schema/items :hal.metaspec/qualified-keyword}}}
  {:schema/id :hal.metaspec/form
   :schema/type :map
   :schema/closed false
   :schema/required
   [:form/id :form/symbol :form/class :form/shape :form/semantics]
   :schema/properties
   {:form/id {:schema/ref :hal.metaspec/qualified-keyword}
    :form/symbol {:schema/type :symbol}
    :form/class
    {:schema/type :enum
     :schema/values [:special-form :macro :function :reader-form]}
    :form/shape {:schema/type :any}
    :form/semantics {:schema/ref :hal.metaspec/non-empty-string}}}
  {:schema/id :hal.metaspec/reference
   :schema/type :map
   :schema/closed false
   :schema/required [:reference/id :reference/kind :reference/path]
   :schema/properties
   {:reference/id {:schema/ref :hal.metaspec/qualified-keyword}
    :reference/kind
    {:schema/type :enum
     :schema/values
     [:conformance :parity :provenance :implementation-profile :generated]}
    :reference/path {:schema/type :string}
    :reference/authority
    {:schema/type :enum
     :schema/values [:normative :evidence :informative :historical]}
    :reference/description {:schema/type :string}}}
  {:schema/id :hal.metaspec/conformance-reference
   :schema/type :map
   :schema/closed true
   :schema/required [:conformance/suite :conformance/cases]
   :schema/properties
   {:conformance/suite {:schema/ref :hal.metaspec/qualified-keyword}
    :conformance/cases {:schema/type :vector
                        :schema/items {:schema/type :keyword}}}}]

 :meta/cross-references
 [{:reference/id :hal.metaspec/section-order-reference
   :reference/from :spec/section-order
   :reference/to :section/id}
  {:reference/id :hal.metaspec/section-form-reference
   :reference/from :section/forms
   :reference/to :form/id}
  {:reference/id :hal.metaspec/section-reference-reference
   :reference/from :section/references
   :reference/to :reference/id}
  {:reference/id :hal.metaspec/conformance-path-reference
   :reference/from :reference/path
   :reference/to :document-relative-path}]

 :meta/requirements
 [{:requirement/id :hal.metaspec/unique-identifiers
   :requirement/level :must
   :requirement/text "Language document declaration identifiers are unique within their domains."}
  {:requirement/id :hal.metaspec/qualified-keys
   :requirement/level :must
   :requirement/text "Unknown extension keys are qualified keywords."}
  {:requirement/id :hal.metaspec/reference-integrity
   :requirement/level :must
   :requirement/text "Section, form, and reference identifiers resolve."}
  {:requirement/id :hal.metaspec/no-host-values
   :requirement/level :must-not
   :requirement/text "Normative language specifications contain host or runtime values."}]

 :meta/checkers
 [{:checker/id :hal.metaspec.rule/qualified-key
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-map-keys
   :checker/requirement :hal.metaspec/qualified-keys}
  {:checker/id :hal.metaspec.rule/stable-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-field-values
   :checker/requirement :hal.metaspec/unique-identifiers
   :checker/fields
   [:document/id :section/id :requirement/id :form/id :reference/id]}
  {:checker/id :hal.metaspec.rule/duplicate-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/unique-field-values
   :checker/requirement :hal.metaspec/unique-identifiers
   :checker/fields
   [:document/id :section/id :requirement/id :form/id :reference/id]}
  {:checker/id :hal.metaspec.rule/no-host-values
   :checker/type :builtin
   :checker/op :hara.metaspec.check/no-host-values
   :checker/requirement :hal.metaspec/no-host-values}]

 :metaspec/generation
 {:generation/input
  {:input/type :hal.metaspec/language-request
   :input/required
   [:request/title :request/summary :request/scope :request/sections]}
  :generation/output
  {:output/type :hal/language-spec
   :output/format :edn
   :output/required
   [:document/id :document/type :document/version :document/status
    :document/title :document/summary :spec/conforms-to :spec/scope
    :spec/invariants :spec/section-order :spec/sections :spec/forms
    :spec/references :spec/conformance]}
  :generation/process
  [:generate-draft :conforms :repair-findings :emit-canonical-edn]
  :generation/acceptance
  {:acceptance/status :pass
   :acceptance/required-summary
   {:summary/fail 0 :summary/unknown 0 :summary/blocked 0}}}}
