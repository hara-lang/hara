{:spec/version "0.0.0-alpha"
 :spec/status :draft
 :syntax :edn
 :purpose :clojure-inspired-non-protocol-function-control
 :namespace-policy
 {:general std.foundation
  :sets {:namespace std.foundation}
  :strings {:namespace std.foundation.string :call-prefix str}
  :bytes {:namespace std.foundation.bytes :call-prefix bytes}
  :rule "Protocol methods are tracked in protocols.edn. Hara-specific
         functions are tracked in functions.edn."}

 :related-specs
 {:protocols "protocols.edn"
  :hara-functions "functions.edn"
  :foundation-surface "foundation.edn"}

 :workflow
 {:authority :edit-this-file-first
  :downstream [:hal-library :rust :truffle :parity-tests :documentation]
  :default-implementation :portable-hal
  :implementation-gate :accepted-or-explicitly-selected-proposal}

 :naming-policy
 {:predicate-suffix "?"
  :new-bang-functions false
  :compatibility-bang-exceptions [reset! swap! cas! close!]
  :iterator-implementation-names-public false
  :load-functions [load-string]}

 :numeric-surface
 {:reference
  {:clojure-version "1.12.4"
   :core "https://clojure.github.io/clojure/clojure.core-api.html"}
  :placement
  {:general std.foundation}
  :number-model
  {:integer [:signed-64-bit]
   :decimal [:ieee-754-double]
   :ratio false
   :integer-overflow :error}

  :existing
  {:operators [+ - * / mod = not= < <= > >= compare]
   :functions [inc dec min max pos? neg? zero? even? odd?]
   :predicates [number? integer? decimal?]
   :sequence-functions [range]}

  :basic-math
  {:namespace std.foundation
   :status :implemented-both
   :implementation
   {:constants :portable-hal
    :min-max :portable-hal
    :other-functions :host-primitives}
   :constants
   [{:name E :javascript "Math.E"}
    {:name PI :javascript "Math.PI"}]
   :functions
   [{:name sin :javascript "Math.sin"}
    {:name cos :javascript "Math.cos"}
    {:name tan :javascript "Math.tan"}
    {:name atan :javascript "Math.atan"}
    {:name atan2 :javascript "Math.atan2"}
    {:name floor :javascript "Math.floor"}
    {:name ceil :javascript "Math.ceil"}
    {:name max :javascript "Math.max" :status :existing}
    {:name min :javascript "Math.min" :status :existing}
    {:name pow :javascript "Math.pow"}
    {:name abs :javascript "Math.abs"}
    {:name acos :javascript "Math.acos"}
    {:name acosh :javascript "Math.acosh"}
    {:name asin :javascript "Math.asin"}
    {:name asinh :javascript "Math.asinh"}
    {:name atanh :javascript "Math.atanh"}
    {:name exp :javascript "Math.exp"}
    {:name sqrt :javascript "Math.sqrt"}
    {:name sinh :javascript "Math.sinh"}
    {:name cosh :javascript "Math.cosh"}
    {:name tanh :javascript "Math.tanh"}]
   :semantics
   {:numeric-input-only true
    :javascript-to-number-coercion false}}

  :recommended
  [{:namespace std.foundation
    :classification :portable-hal-over-numeric-primitives
    :functions
    [{:name abs :clojure clojure.core/abs}
     {:name quot :clojure clojure.core/quot}
     {:name rem :clojure clojure.core/rem}
     {:name min-key :clojure clojure.core/min-key}
     {:name max-key :clojure clojure.core/max-key}
     {:name parse-long :clojure clojure.core/parse-long}
     {:name parse-double :clojure clojure.core/parse-double}
     {:name nan? :clojure clojure.core/NaN? :relation :renamed}
     {:name infinite? :clojure clojure.core/infinite?}
     {:name bit-and :clojure clojure.core/bit-and}
     {:name bit-or :clojure clojure.core/bit-or}
     {:name bit-xor :clojure clojure.core/bit-xor}
     {:name bit-not :clojure clojure.core/bit-not}
     {:name bit-and-not :clojure clojure.core/bit-and-not}
     {:name bit-clear :clojure clojure.core/bit-clear}
     {:name bit-flip :clojure clojure.core/bit-flip}
     {:name bit-set :clojure clojure.core/bit-set}
     {:name bit-shift-left :clojure clojure.core/bit-shift-left}
     {:name bit-shift-right :clojure clojure.core/bit-shift-right}
     {:name bit-test :clojure clojure.core/bit-test}
     {:name rand :clojure clojure.core/rand
      :classification :host-random-primitive}
     {:name rand-int :clojure clojure.core/rand-int}
     {:name rand-nth :clojure clojure.core/rand-nth}
     {:name random-sample :clojure clojure.core/random-sample}
     {:name shuffle :clojure clojure.core/shuffle}]}]

  :requires-hara-semantics
  [{:names [long double]
    :reason :define-portable-conversion-width-rounding-and-overflow}
   {:names [float? double? int?]
    :reason :define-against-hara-numeric-categories-not-jvm-classes}]

  :excluded
  [{:names [bigint bigdec short int float num]
    :reason :outside-the-two-representation-hara-number-model}
   {:names [ratio? rational? rationalize numerator denominator]
    :reason :hara-number-model-is-ratio-free}
   {:names [==]
    :reason :ordinary-hara-equality-is-already-numeric-type-independent}
   {:names [+' -' *' inc' dec']
    :reason :ordinary-hara-arithmetic-already-promotes}
   {:pattern "unchecked-*"
    :reason :jvm-primitive-width-and-overflow-semantics}
   {:pattern "*-array"
    :reason :jvm-primitive-array-constructor}
   {:names [bytes chars shorts ints longs floats doubles]
    :reason :jvm-primitive-array-cast}]}

 :byte-surface
 {:namespace std.foundation.bytes
  :call-prefix bytes
  :classification :host-byte-primitives
  :existing
  [{:name count :call bytes/count}
   {:name get :call bytes/get}
   {:name set :call bytes/set}
   {:name copy :call bytes/copy}
   {:name slice :call bytes/slice}
   {:name u8 :call bytes/u8
    :semantics :reinterpret-as-unsigned-byte}
   {:name s8 :call bytes/s8
    :clojure clojure.core/byte
    :relation :portable-signed-byte-conversion}]}

 :exception-surface
 {:namespace std.foundation
  :status :implemented-both
  :functions
  [{:name ex-info
    :clojure clojure.core/ex-info
    :classification :host-primitive
    :status :deprecated-runtime-input
    :arities [[message data] [message data cause]]
    :semantics :legacy-unclassified-exception-construction
    :contract "exceptions.edn"}
   {:name ex-message
    :clojure clojure.core/ex-message
    :classification :host-primitive
    :contract "exceptions.edn"}
   {:name ex-data
    :clojure clojure.core/ex-data
    :classification :protocol-wrapper
    :protocol IExInfo
    :method data
    :contract "exceptions.edn"}
   {:name ex-cause
    :clojure clojure.core/ex-cause
    :classification :host-primitive
    :semantics :portable-cause-access
    :contract "exceptions.edn"}]}

 :dynamic-context-surface
 {:existing
  {:forms
   [{:name binding
     :clojure clojure.core/binding
     :semantics :scoped-dynamic-var-rebinding}
    {:name set!
     :clojure clojure.core/set!
     :kind :special-form
     :bang-policy :existing-form-not-function}]
   :functions
   [{:name alter-var-root
     :clojure clojure.core/alter-var-root}]}

  :recommended
  {:dynamic-vars
   [{:names [*ns*]
     :domain :evaluation-context}]
   :functions
   [{:name bound?
     :clojure clojure.core/bound?
     :input :var
     :semantics :var-has-root-binding}
    {:name unbound?
     :authority "functions.edn"
     :input :var
     :semantics :var-has-no-root-binding
     :relation :hara-complement}]}

  :excluded
  [{:names [thread-bound?
            get-thread-bindings
            with-bindings
            with-bindings*
            bound-fn
            bound-fn*
            push-thread-bindings
            pop-thread-bindings
            var-set]
    :reason :thread-local-api-not-part-of-hara-surface}]}

 ;; These are useful compatibility candidates that do not duplicate a protocol
 ;; method. Candidate status does not approve a name or claim implementation.
 :recommended
 [{:namespace std.foundation
   :classification :portable-hal
   :functions
   [{:name map-indexed :clojure clojure.core/map-indexed}
    {:name keep-indexed :clojure clojure.core/keep-indexed}
    {:name select-keys :clojure clojure.core/select-keys}
    {:name merge :clojure clojure.core/merge}
    {:name flatten :clojure clojure.core/flatten}
    {:name load-string :clojure clojure.core/load-string
     :classification :host-primitive}]}

  {:namespace std.foundation
   :classification :portable-hal
   :functions
   [{:name union :clojure clojure.set/union}
    {:name intersection :clojure clojure.set/intersection}
    {:name difference :clojure clojure.set/difference}
    {:name select :clojure clojure.set/select}
    {:name subset? :clojure clojure.set/subset?}
    {:name superset? :clojure clojure.set/superset?}]}

  {:namespace std.foundation.string
   :call-prefix str
   :classification :portable-hal-over-string-primitives
   :functions
   [{:name blank? :clojure clojure.string/blank?}
    {:name capitalize :clojure clojure.string/capitalize}
    {:name ends-with? :clojure clojure.string/ends-with?}
    {:name escape :clojure clojure.string/escape}
    {:name includes? :clojure clojure.string/includes?}
    {:name index-of :clojure clojure.string/index-of}
    {:name join :clojure clojure.string/join}
    {:name last-index-of :clojure clojure.string/last-index-of}
    {:name lower :clojure clojure.string/lower-case :relation :renamed}
    {:name replace :clojure clojure.string/replace}
    {:name replace-first :clojure clojure.string/replace-first}
    {:name reverse :clojure clojure.string/reverse}
    {:name split :clojure clojure.string/split}
    {:name split-lines :clojure clojure.string/split-lines}
    {:name starts-with? :clojure clojure.string/starts-with?}
    {:name trim :clojure clojure.string/trim}
    {:name trim-left :clojure clojure.string/triml :relation :renamed}
    {:name trim-newline :clojure clojure.string/trim-newline}
    {:name trim-right :clojure clojure.string/trimr :relation :renamed}
    {:name upper :clojure clojure.string/upper-case :relation :renamed}]}]

 :proposed
 [{:namespace std.foundation
   :functions
   [{:name trampoline :clojure clojure.core/trampoline}
    {:name memoize :clojure clojure.core/memoize}
    {:name dedupe :clojure clojure.core/dedupe}]}]

 :excluded
 [{:names [disj]
   :reason :hara-set-removal-uses-dissoc
   :migration {:target std.foundation/dissoc
               :relation :semantic
               :arity :variadic}}
  {:name load-file :reason :load-string-only}
  {:name requiring-resolve :reason :not-required}
  {:pattern "iter-*"
   :reason :implementation-detail-except-iter-next?-and-iter-next}
  {:names [partition-transform partition-all-transform map-transform]
   :reason :implementation-detail}
  {:names [module-dependencies module-revision]
   :reason :not-public-foundation-functions}
  {:pattern "*!"
   :except [reset! swap! cas! close!]
   :reason :no-new-public-bang-functions}]}
