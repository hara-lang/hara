{:spec/version "0.0.0-alpha"
 :spec/status :draft
 :syntax :edn
 :purpose :native-behavioral-conformance
 :manifest "01-lang/001-language/draft/conformance/native.edn"
 :fixture "01-lang/001-language/draft/conformance/fixtures/native_behavioral.hal"
 :authority :specs-owned
 :platforms
 [:jvm-interpreter :truffle :rust-evaluator :rust-bytecode :browser-wasm]

 :counting
 {:policy :derived
  :surface "Derive types and methods from native.edn :types."
  :classifications "Derive portable, capability-specific, and inventory-only from native-classification-summary."
  :results "Derive passed, failed, and skipped from native-profile-report."
  :sum-rule "passed + failed + skipped = portable + capability-specific + inventory-only"}

 :classification-contract
 {:portable
  {:requirement :executable-deterministic-fixture
   :entrypoint native-method-result}
  :capability-specific
  {:requirement :named-capability-and-reviewable-provider-reason
   :groups capability-method-groups}
  :inventory-only
  {:requirement :reviewable-reason-and-explicit-promotion-boundary
   :groups inventory-method-groups}
  :closure
  {:entrypoint native-closure-report
   :failure-on [:unclassified-addition :unclassified-removal :unclassified-rename]}}

 :coverage
 {:method-local [:canonical-invocation :valid-value :normalized-result]
  :cross-cutting
  [:arity-failure :type-failure :normalized-error :identity-fast-path
   :mutation :lifecycle :cleanup :evaluator-compiler-agreement :browser-wasm
   :result-dereference :reader-shorthand]
  :entrypoints
  {:method-results native-method-results
   :boundary-results native-boundary-results
   :profile-report native-profile-report
   :host-assertion-report native-host-assertion-report}}

 :host-assertion-migration
 {:policy :specs-own-cases-hosts-own-adapters
  :jvm
  [{:former-source hara.truffle.NativeBehavioralConformanceTest
    :moved
    [:closure-drift :classification-execution :boundary-results
     :identity-fast-path-calibration]}
   {:former-source hara.truffle.NativeMethodParityTest
    :moved
    [:direct-callability :exact-error-class :blank-namespace-alias
     :foundation-boundaries]}]
  :rust
  [{:former-source native_behavioral_conformance_tests.rs
    :moved
    [:classification-execution :boundary-results :evaluator-compiler-probe
     :identity-fast-path-calibration]}]
  :browser
  [{:former-source native-behavioral-conformance.spec.js
    :moved
    [:classification-execution :boundary-results :evaluator-compiler-probe]}]}

 :calibration-provenance
 {:source :original-host-tests-and-interactive-runtime-probes
  :policy
  "Keep executable snippets and normalized expectations in the fixture. Hosts may choose an execution adapter but may not restate a source form or expected value."
  :snippets native-calibration-snippets
  :implementation-only native-implementation-calibrations
  :observations
  [{:id :error-class
    :before :host-class-shaped
    :normalized :declared-ex-class-or-native-error
    :entrypoint normalized-error-class}
   {:id :iterator-close
    :observed-jvm-before-conformance true
    :normalized false
    :reason :close-must-make-iter-next-unavailable
    :entrypoint native-boundary-results}
   {:id :native-function-versus-hal-fn
    :observed [true true false true]
    :meaning
    [native-function-is-function hal-function-is-function
     keyword-is-not-function keyword-satisfies-ifn]
   :entrypoint native-boundary-results}
   {:id :base-instance
    :calibrated-receiver Promise
    :reason :descriptor-and-portable-type-name-agree
    :entrypoint native-method-result}
   {:id :result-dereference
    :success :return-data
    :error :throw-result-error
    :reader-shorthand "@result"
    :cases [:result-deref-success :result-deref-error]
    :entrypoint native-boundary-results}]}

 :maintenance-workflow
 {:on-native-add-change-remove
  [:update-native-edn-types
   :add-or-update-exactly-one-classification
   :add-portable-fixture-or-name-capability-or-record-reviewable-inventory-reason
   :save-new-host-probes-in-native-calibration-snippets
   :run-complete-native-hal-candidate
   :run-jvm-truffle-rust-evaluator-rust-bytecode-and-browser-wasm]
  :forbidden
  [:runtime-local-corpus-copy :host-local-source-snippet :hard-coded-count]}}
