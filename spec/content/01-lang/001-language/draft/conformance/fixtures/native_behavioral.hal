  })

(def inventory-method-groups
  {
   :inventory/unclassified-shape ['Crypto/hmac-sha256 'Crypto/hmac-sha512 'Algo/deque 'Algo/ordered-map 'Algo/ordered-set 'Algo/priority-map 'Algo/queue 'Algo/sorted-map 'Algo/sorted-set 'Algo/trie 'Algo/deque? 'Algo/ordered-map? 'Algo/ordered-set? 'Algo/priority-map? 'Algo/queue? 'Algo/sorted-map? 'Algo/sorted-set? 'Algo/trie?]
   :inventory/mutable-array ['Arr/push-first 'Arr/push-last 'Arr/pop-first 'Arr/pop-last 'Arr/insert 'Arr/remove 'Arr/slice 'Arr/map 'Arr/filter 'Arr/fold-left 'Arr/fold-right]
   :inventory/mutable-object ['Obj/assign 'Obj/keys 'Obj/vals 'Obj/pairs]
   :inventory/document-shape ['Document/element 'Document/text 'Document/fragment 'Document/annotate 'Document/pass 'Document/escaped 'Document/group 'Document/line 'Document/break 'Document/nest 'Document/align 'Document/normalize 'Document/valid? 'Document/render]
   :inventory/codec-format ['Edn/pretty 'Json/pretty]
   :inventory/schema-shape ['Schema/of 'Schema/kind 'Schema/form 'Schema/ast 'Schema/origin]
   :inventory/foundation-boundary ['Base/satisfies?]
   :inventory/namespace-introspection ['Runtime/ns-publics 'Runtime/ns-aliases 'Runtime/ns-find 'Runtime/ns-create 'Runtime/ns-name
                                       'Base/special-symbol?]
   :inventory/lazy-observation ['Iter/iter-take-while 'Iter/iter-drop-while 'Iter/iter-interpose 'Iter/iter-interleave 'Iter/iter-every? 'Iter/iter-any? 'Iter/iter-partition-all 'Iter/iter-partition 'Iter/iter-repeatedly]
  })

(defn add-portable-methods
  [out fixtures]
  (reduce
    (fn [out method]
      (let [fixture (get fixtures method)]
        (assoc out method
          {:classification :portable
           :reason :portable/deterministic
           :fixture fixture})))
    out
    (keys fixtures)))

(defn add-capability-methods
  [out groups]
  (reduce
    (fn [out capability]
      (let [methods (get groups capability)]
        (reduce
          (fn [out method]
            (assoc out method
              {:classification :capability-specific
               :reason :capability/provider
               :capability capability}))
          out
          methods)))
    out
    (keys groups)))

(defn add-inventory-methods
  [out groups]
  (reduce
    (fn [out reason]
      (let [methods (get groups reason)]
        (reduce
          (fn [out method]
            (assoc out method
              {:classification :inventory-only
               :reason reason}))
          out
          methods)))
    out
    (keys groups)))

(defn append-group-methods
  [out groups]
  (reduce
    (fn [out group]
      (reduce conj out (get groups group)))
    out
    (keys groups)))

(def declared-native-methods
  (append-group-methods
    (append-group-methods
      (vec (keys portable-fixtures))
      capability-method-groups)
    inventory-method-groups))

(def native-method-corpus
  (add-inventory-methods
    (add-capability-methods
      (add-portable-methods {} portable-fixtures)
      capability-method-groups)
    inventory-method-groups))

(defn native-corpus-valid?
  []
  (and
    (= (count declared-native-methods) (count (set declared-native-methods)))
    (= (count declared-native-methods) (count native-method-corpus))
    (every?
      (fn [method]
        (let [entry (get native-method-corpus method)
              classification (get entry :classification)
              reason (get native-classification-reasons (get entry :reason))]
          (and
            (or (= classification :portable)
                (= classification :capability-specific)
                (= classification :inventory-only))
            (string? reason)
            (not (String/blank? reason))
            (if (= classification :portable)
              (not (nil? (get entry :fixture)))
              true)
            (if (= classification :capability-specific)
              (keyword? (get entry :capability))
              (nil? (get entry :capability))))))
      (keys native-method-corpus))))

(defn native-method-keys
  []
  (vec (keys native-method-corpus)))

(defn native-method-results
  []
  (vec (map (fn [method] (native-method-result method nil))
        (native-method-keys))))

(defn native-classification-summary
  []
  (reduce
    (fn [summary method]
      (let [classification (get (get native-method-corpus method) :classification)]
        (assoc summary classification
          (inc (get summary classification 0)))))
    {:total (count native-method-corpus)
     :portable 0
     :capability-specific 0
     :inventory-only 0}
    (keys native-method-corpus)))

(defn normalized-error-class
  [error]
  (let [data (ex-data error)
        declared (get data :ex/class)
        native (Exception/class error)]
    (cond
      (keyword? declared) declared
      (keyword? native) native
      :else :native/error)))

(defn normalized-outcome
  [thunk]
  (try
    [:value (thunk)]
    (catch Throwable error
      [:error (normalized-error-class error)])))

(defn native-closure-report
  [live-methods]
  (let [live (set live-methods)
        classified (set (native-method-keys))
        missing (vec (filter (fn [method] (not (has? classified method))) live-methods))
        extra (vec (filter (fn [method] (not (has? live method))) (native-method-keys)))]
    {:pass (and (empty? missing) (empty? extra))
     :live (count live)
     :classified (count classified)
     :missing missing
     :extra extra}))

(defn native-method-result
  [method ignored]
  (let [entry (get native-method-corpus method)
        classification (get entry :classification)
        reason (get native-classification-reasons (get entry :reason))]
    (cond
      (nil? entry)
      {:method method :classification :unclassified :pass false :error :unclassified}

      (= classification :portable)
      (let [fixture (get entry :fixture)]
        (try
          (let [expected (first fixture)
                actual ((second fixture))]
            {:method method :classification classification :pass (= expected actual)
             :expected expected :actual actual})
          (catch Throwable error
            {:method method :classification classification :pass false
             :error-class (normalized-error-class error)
             :error-message (ex-message error)})))

      (= classification :capability-specific)
      {:method method :classification classification
       :capability (get entry :capability) :reason reason
       :pass (and (keyword? (get entry :capability)) (string? reason) (not (String/blank? reason)))}

      (= classification :inventory-only)
      {:method method :classification classification :reason reason
       :pass (and (string? reason) (not (String/blank? reason)))}

      :else
      {:method method :classification classification :pass false :error :invalid-classification})))

(defn native-boundary-report
  []
  [(= 2 (Maths/abs -2))
   (= [:error :native/error] (normalized-outcome (fn [] (Maths/abs))))
   (= [:error :native/error] (normalized-outcome (fn [] (Maths/abs "bad"))))
   (= :ex.class/demo (normalized-error-class (Exception/new "boom" {:ex/class :ex.class/demo})))
   (= [1 2] (Base/vec [1 2]))
   (= #{1 2} (Base/set [1 2 1]))
   (= 9 (let [value (Arr/new 1 2)] (Arr/set value 1 9) (Arr/get value 1)))
   (= 42 (let [value (Obj/new)] (Obj/set value "answer" 42) (Obj/get value "answer")))
   (= 99 (let [value (Bytes/new 1 2)] (Bytes/set value 1 99) (Bytes/get value 1)))
   (= false (let [value (Iter/iter [1 2])] (Iter/iter-close value) (Iter/iter-next? value)))
   (= [42 42]
      (let [result (Result/create :success 42)]
        [(deref result) @result]))
   (= [[:error :ex.class/result] [:error :ex.class/result]]
      (let [result (Result/create :error
                     (Exception/new "boom" {:ex/class :ex.class/result}))]
        [(normalized-outcome (fn [] (deref result)))
         (normalized-outcome (fn [] @result))]))
   (= true (has? {:a nil} :a))
   (= [true false true]
      [(function? Maths/abs)
       (function? (fn [value] value))
       (fn? (fn [value] value))])])

(defn native-boundary-cases
  []
  [{:id :canonical-invocation
    :points [:canonical-invocation :valid-value :normalized-result]
    :expected 2 :actual (Maths/abs -2)}
   {:id :arity-failure
    :points [:arity-failure :normalized-error]
    :expected [:error :native/error]
    :actual (normalized-outcome (fn [] (Maths/abs)))}
   {:id :type-failure
    :points [:type-failure :normalized-error]
    :expected [:error :native/error]
    :actual (normalized-outcome (fn [] (Maths/abs "bad")))}
   {:id :exact-error-class
    :points [:normalized-result :normalized-error]
    :expected :ex.class/demo
    :actual (normalized-error-class (Exception/new "boom" {:ex/class :ex.class/demo}))}
   {:id :concrete-native-type
    :points [:valid-value :normalized-result]
    :expected [:std.native.Vector :std.native.Vector :std.native.Exception]
    :actual [(Base/type [1]) (Base/type (Base/vector 1)) (Base/type (Exception/new "fixture" {}))]}
   {:id :persistent-vector-value
    :points [:valid-value :identity-fast-path]
    :expected [1 2] :actual (Base/vec [1 2])}
   {:id :persistent-set-value
    :points [:valid-value :identity-fast-path]
    :expected #{1 2} :actual (Base/set [1 2 1])}
   {:id :mutable-array
    :points [:mutation]
    :expected 9
    :actual (let [value (Arr/new 1 2)] (Arr/set value 1 9) (Arr/get value 1))}
   {:id :mutable-object
    :points [:mutation]
    :expected 42
    :actual (let [value (Obj/new)] (Obj/set value "answer" 42) (Obj/get value "answer"))}
   {:id :mutable-bytes
    :points [:mutation]
    :expected 99
    :actual (let [value (Bytes/new 1 2)] (Bytes/set value 1 99) (Bytes/get value 1))}
   {:id :iterator-cleanup
    :points [:lifecycle :cleanup]
    :expected false
    :actual (let [value (Iter/iter [1 2])] (Iter/iter-close value) (Iter/iter-next? value))}
   {:id :result-deref-success
    :points [:valid-value :normalized-result :result-dereference :reader-shorthand]
    :expected [42 42]
    :actual (let [result (Result/create :success 42)]
              [(deref result) @result])}
   {:id :result-deref-error
    :points [:normalized-error :result-dereference :reader-shorthand]
    :expected [[:error :ex.class/result] [:error :ex.class/result]]
    :actual (let [result (Result/create :error
                           (Exception/new "boom" {:ex/class :ex.class/result}))]
              [(normalized-outcome (fn [] (deref result)))
               (normalized-outcome (fn [] @result))])}
   {:id :foundation-has-boundary
    :points [:valid-value]
    :expected true :actual (has? {:a nil} :a)}
   {:id :removed-foundation-pathways
    :points [:valid-value :normalized-result]
    :expected [true true true]
    :actual [(nil? (resolve 'std.native.Builtins))
             (nil? (resolve 'decimal?))
             (nil? (resolve 'contains?))]}
   {:id :native-function-versus-hal-fn
    :points [:valid-value :normalized-result]
    :expected [true true false true]
    :actual [(function? Maths/abs)
             (function? (fn [value] value))
             (function? :keyword)
             (fn? :keyword)]}])

(defn native-boundary-results
  []
  (vec (map
    (fn [case]
      (assoc case :pass (= (get case :expected) (get case :actual))))
    (native-boundary-cases))))

(defn native-profile-report
  []
  (let [results (native-method-results)
        portable-results (filter (fn [result] (= :portable (get result :classification))) results)
        passed (count (filter (fn [result] (= true (get result :pass))) portable-results))
        failed (- (count portable-results) passed)
        summary (native-classification-summary)]
    {:portable (get summary :portable)
     :capability-specific (get summary :capability-specific)
     :inventory-only (get summary :inventory-only)
     :passed passed
     :failed failed
     :skipped (+ (get summary :capability-specific) (get summary :inventory-only))
     :capability-exclusions capability-method-groups
     :inventory-exclusions inventory-method-groups}))

(defn native-host-assertion-report
  []
  (let [boundaries (native-boundary-results)
        profile (native-profile-report)]
    {:corpus-valid (native-corpus-valid?)
     :boundary-results boundaries
     :boundary-passed (count (filter (fn [case] (= true (get case :pass))) boundaries))
     :boundary-failed (count (filter (fn [case] (= false (get case :pass))) boundaries))
     :profile profile
     :calibration-snippets native-calibration-snippets
     :implementation-calibrations native-implementation-calibrations}))
