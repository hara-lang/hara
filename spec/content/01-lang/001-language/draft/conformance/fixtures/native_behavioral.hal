(ns std.foundation.native-method-conformance)

;; This file is the executable authority for every behavioral and calibration
;; assertion made by native-runtime conformance hosts. Hosts may supply a live
;; inventory or compile a source snippet, but must not invent their own cases.
(def native-conformance-points
  {:method-local [:canonical-invocation :valid-value :normalized-result]
   :cross-cutting [:arity-failure :type-failure :normalized-error
                   :identity-fast-path :mutation :lifecycle :cleanup
                   :evaluator-compiler-agreement :browser-wasm
                   :result-dereference :reader-shorthand]
   :classification [:portable :capability-specific :inventory-only]})

(def native-calibration-snippets
  {:evaluator-compiler
   {:source "[(Maths/abs -2) (Bits/and 6 3) (Num/long 4.0)]"
    :expected [2 2 4]}
   :blank-namespace-alias
   {:source "(ns blank.native (:config {:blank true})) [(std.foundation/= Iter std.native.Iter) (Iter/iter-next (Iter/iter-map (fn [value] value) [1]))]"
    :expected [true 1]}
   :exact-error-class
   {:source "[(Exception/message (Exception/new \"native failure\" {})) (normalized-error-class (Exception/new \"native failure\" {:ex/class :ex.class/native-failure}))]"
    :expected ["native failure" :ex.class/native-failure]}
   :concrete-native-type
   {:source "[(Base/type [1]) (Base/type (Base/vector 1)) (Base/type (Exception/new \"fixture\" {}))]"
    :expected [:std.native.Vector :std.native.Vector :std.native.Exception]}
   :reduced-round-trip
   {:source "[(Base/unreduced (Base/reduced 42)) (Base/unreduced 42)]"
    :expected [42 42]
    :diagnostic-history
    [{:observed :unsupported-receiver
      :reason "Reduced values do not implement IDeref, so Foundation/unreduced requires the classified Base/unreduced boundary rather than a host-specific unwrap or a broken portable deref composition."}]}
   :base-identity-fast-paths
   {:source "(let [vector-value [1 2] set-value #{1 2}] [[vector-value (Base/vec vector-value)] [set-value (Base/set set-value)]])"
    :expected [[[1 2] [1 2]] [#{1 2} #{1 2}]]}})

(def native-implementation-calibrations
  {:base-vec-identity
   {:method 'Base/vec
    :classification :implementation-calibration
    :expectation :return-same-persistent-vector
    :portable-observation :not-observable
    :reason "Reference identity is intentionally not exposed as a portable Hara predicate; each host must preserve its native persistent-vector identity fast path."}
   :base-set-identity
   {:method 'Base/set
    :classification :implementation-calibration
    :expectation :return-same-persistent-set-family
    :portable-observation :not-observable
    :reason "Reference identity and concrete persistent-set families are host representations; each host must preserve its native identity fast path."}})

;; Source-owned behavioral classification for the live native surface.
;; Every method is declared exactly once across the three data sets below.
(def native-classification-reasons
  {
   :portable/deterministic "Deterministic cross-runtime case with canonical native invocation."
   :capability/provider "Requires the named capability and executes only when that provider is installed."
   :inventory/mutable-array "Representation-sensitive operation remains in the dedicated mutable-array suite until a normalized observation is promoted."
   :inventory/mutable-object "Representation-sensitive operation remains in the dedicated mutable-object suite until a normalized observation is promoted."
   :inventory/document-shape "Document node shape is intentionally opaque; the pretty-document suite remains authoritative."
   :inventory/codec-format "Text formatting is representation-sensitive; the codec suite remains authoritative until normalized."
   :inventory/no-constructor "The native surface exposes no portable constructor for a valid receiver."
   :inventory/schema-shape "Schema AST or origin values need a normalized public representation before promotion."
   :inventory/foundation-boundary "A stable value or identity assertion remains owned by the dedicated Foundation boundary suite."
   :inventory/namespace-introspection "Namespace and reader classification helpers remain owned by the Foundation boundary suite until their normalized observations are promoted."
   :inventory/lazy-observation "The lazy iterator operation needs a bounded deterministic observation before promotion."
   :inventory/unclassified-shape "A stable normalized cross-runtime observation is not yet specified; promotion requires review."
  })

