{:document/id :hara/metaspec-metaspec
 :document/type :hara/metaspec
 :document/version "alpha"
 :document/status :draft
 :document/title "HAL Meta-Specification Meta-Specification"
 :document/summary "A self-describing contract for authoring, linting and verifying machine-readable Hara meta-specifications."

 :spec/conforms-to {:spec/id :hara/metaspec-metaspec
                    :spec/version "alpha"}
 :spec/artifact-kind :hara/metaspec

 :metaspec/sections
 [{:section/id :hara.metaspec/document
   :section/cardinality :exactly-one
   :section/keys
   [:document/id :document/type :document/version :document/status
    :document/title :document/summary]}
  {:section/id :hara.metaspec/conformance
   :section/cardinality :exactly-one
   :section/keys [:spec/conforms-to :spec/artifact-kind]}
  {:section/id :hara.metaspec/schema
   :section/cardinality :one-or-more
   :section/keys [:meta/document-schema :meta/schemas]}
  {:section/id :hara.metaspec/references
   :section/cardinality :zero-or-more
   :section/keys [:meta/cross-references]}
  {:section/id :hara.metaspec/requirements
   :section/cardinality :one-or-more
   :section/keys [:meta/requirements :meta/checkers]}
  {:section/id :hara.metaspec/generation
   :section/cardinality :exactly-one
   :section/keys [:metaspec/generation]}]

 :meta/document-schema
 {:schema/id :hara.metaspec/metaspec-document
  :schema/type :map
  :schema/closed false
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to :spec/artifact-kind
   :meta/document-schema :meta/schemas :meta/cross-references
   :meta/requirements :meta/checkers :metaspec/generation]
  :schema/properties
  {:document/id {:schema/ref :hara.metaspec/qualified-keyword}
   :document/type {:schema/ref :hara.metaspec/qualified-keyword}
   :document/version {:schema/ref :hara.metaspec/version-string}
   :document/status {:schema/ref :hara.metaspec/document-status}
   :document/title {:schema/ref :hara.metaspec/non-empty-string}
   :document/summary {:schema/ref :hara.metaspec/non-empty-string}
   :spec/conforms-to {:schema/ref :hara.metaspec/spec-reference}
   :spec/artifact-kind {:schema/ref :hara.metaspec/qualified-keyword}
   :meta/document-schema {:schema/ref :hara.metaspec/schema-declaration}
   :meta/schemas {:schema/items :hara.metaspec/schema-declaration}
   :meta/cross-references {:schema/items :hara.metaspec/reference-declaration}
   :meta/requirements {:schema/items :hara.metaspec/requirement-declaration}
   :meta/checkers {:schema/items :hara.metaspec/checker-declaration}
   :metaspec/generation {:schema/ref :hara.metaspec/generation-contract}}}

 :meta/schemas
 [{:schema/id :hara.metaspec/qualified-keyword
   :schema/type :keyword
   :schema/constraint :qualified}
  {:schema/id :hara.metaspec/non-empty-string
   :schema/type :string
   :schema/min-length 1}
  {:schema/id :hara.metaspec/version-string
   :schema/type :string
  :schema/pattern "^(alpha|[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?)$"}
  {:schema/id :hara.metaspec/document-status
   :schema/type :enum
   :schema/values [:draft :candidate :stable :deprecated]}
  {:schema/id :hara.metaspec/spec-reference
   :schema/type :map
   :schema/required [:spec/id :spec/version]}
  {:schema/id :hara.metaspec/schema-declaration
   :schema/type :map
   :schema/required [:schema/id :schema/type]}
  {:schema/id :hara.metaspec/reference-declaration
   :schema/type :map
   :schema/required [:reference/id :reference/from :reference/to]}
  {:schema/id :hara.metaspec/requirement-declaration
   :schema/type :map
   :schema/required
   [:requirement/id :requirement/level :requirement/text]}
  {:schema/id :hara.metaspec/checker-declaration
   :schema/type :map
   :schema/required
   [:checker/id :checker/type :checker/requirement]}
  {:schema/id :hara.metaspec/generation-contract
   :schema/type :map
   :schema/required
   [:generation/input :generation/output :generation/process
    :generation/acceptance]}
  {:schema/id :hara.metaspec/lint-finding
   :schema/type :map
   :schema/required
   [:finding/id :requirement/id :finding/level :finding/path
    :finding/message :finding/repair]}
  {:schema/id :hara.metaspec/verification-report
   :schema/type :map
   :schema/required
   [:report/type :report/version :document/id :report/status
    :summary :findings :next-actions]}]

 :meta/cross-references
 [{:reference/id :hara.metaspec/schema-property-references
   :reference/from :schema/ref
   :reference/to :schema/id}
  {:reference/id :hara.metaspec/schema-item-references
   :reference/from :schema/items
   :reference/to :schema/id}
  {:reference/id :hara.metaspec/checker-requirement-reference
   :reference/from :checker/requirement
   :reference/to :requirement/id}
  {:reference/id :hara.metaspec/requirement-finding-reference
   :reference/from :requirement/id
   :reference/to :requirement/id}]

 :meta/requirements
 [{:requirement/id :hara.metaspec/required-sections
   :requirement/level :must
   :requirement/text "Every required top-level section is present."}
  {:requirement/id :hara.metaspec/qualified-keys
   :requirement/level :must
   :requirement/text "Every map key is a qualified keyword."}
  {:requirement/id :hara.metaspec/stable-identifiers
   :requirement/level :must
   :requirement/text "Every declaration has one stable qualified identifier."}
  {:requirement/id :hara.metaspec/unique-identifiers
   :requirement/level :must
   :requirement/text "Declaration identifiers are unique within their identifier domain."}
  {:requirement/id :hara.metaspec/resolved-schema-references
   :requirement/level :must
   :requirement/text "Every schema/ref and schema/items reference resolves to a declared schema."}
  {:requirement/id :hara.metaspec/resolved-cross-references
   :requirement/level :must
   :requirement/text "Every declared cross-reference names stable source and target fields."}
  {:requirement/id :hara.metaspec/generation-closure
   :requirement/level :must
   :requirement/text "The generation contract produces a document that can be linted and verified without prose interpretation."}
  {:requirement/id :hara.metaspec/generated-document-conformance
   :requirement/level :must
   :requirement/text "A generated specification validates against the declared document schema and cross-reference rules."}
  {:requirement/id :hara.metaspec/no-host-values
   :requirement/level :must-not
   :requirement/text "Normative documents contain runtime objects, Vars, handles or host-specific values."}]

 :meta/checkers
 [{:checker/id :hara.metaspec.rule/qualified-key
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-map-keys
   :checker/requirement :hara.metaspec/qualified-keys}
  {:checker/id :hara.metaspec.rule/stable-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-field-values
   :checker/requirement :hara.metaspec/stable-identifiers
   :checker/fields
   [:document/id :schema/id :reference/id :requirement/id :section/id
    :rule/id :linter/id :form/id :entity/id :relation/id :codec/id
    :checker/id :law/id :conformance/id]}
  {:checker/id :hara.metaspec.rule/duplicate-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/unique-field-values
   :checker/requirement :hara.metaspec/unique-identifiers
   :checker/fields
   [:document/id :schema/id :reference/id :requirement/id :section/id
    :rule/id :linter/id :form/id :entity/id :relation/id :codec/id
    :checker/id :law/id :conformance/id]}
  {:checker/id :hara.metaspec.rule/no-host-values
   :checker/type :builtin
   :checker/op :hara.metaspec.check/no-host-values
   :checker/requirement :hara.metaspec/no-host-values}]

 :metaspec/linter
 {:linter/id :hara.metaspec/linter
  :linter/version "0.1.0"
  :linter/rules
  [{:rule/id :hara.metaspec.rule/required-key
    :rule/requirement :hara.metaspec/required-sections}
   {:rule/id :hara.metaspec.rule/qualified-key
    :rule/requirement :hara.metaspec/qualified-keys}
   {:rule/id :hara.metaspec.rule/stable-id
    :rule/requirement :hara.metaspec/stable-identifiers}
   {:rule/id :hara.metaspec.rule/duplicate-id
    :rule/requirement :hara.metaspec/unique-identifiers}
   {:rule/id :hara.metaspec.rule/schema-reference
    :rule/requirement :hara.metaspec/resolved-schema-references}
   {:rule/id :hara.metaspec.rule/cross-reference
    :rule/requirement :hara.metaspec/resolved-cross-references}
   {:rule/id :hara.metaspec.rule/schema-validation
    :rule/requirement :hara.metaspec/generated-document-conformance}
   {:rule/id :hara.metaspec.rule/document-reference
    :rule/requirement :hara.metaspec/generated-document-conformance}]}

 :metaspec/generation
 {:generation/input
  {:input/type :hara.metaspec/generation-request
   :input/required
   [:request/artifact-kind :request/title :request/summary
    :request/forms :request/entities :request/relations
    :request/codecs :request/checkers :request/laws]}
  :generation/output
  {:output/type :hara/metaspec
   :output/format :edn
   :output/required
   [:document/id :document/type :document/version :document/status
    :document/title :document/summary :spec/conforms-to
    :spec/artifact-kind :meta/document-schema :meta/schemas
    :meta/cross-references :meta/requirements :meta/checkers
    :metaspec/generation]}
  :generation/process
  [:generate-draft :lint :repair-lint-findings :verify
   :repair-verification-findings :emit-canonical-edn]
  :generation/acceptance
  {:acceptance/status :pass
   :acceptance/required-summary
   {:summary/fail 0 :summary/unknown 0 :summary/blocked 0}
   :acceptance/no-unresolved-references true
   :acceptance/canonical-edn true}}

 :spec/conformance
 [{:conformance/id :hara.metaspec/metaspec-cases
   :conformance/path "conformance/metaspec.edn"}]}
