{:conformance/id :hara.metaspec/metaspec-cases
 :conformance/version "0.1.0"
 :conformance/cases
 [{:case/id :hara.metaspec/valid-self-description
   :case/type :verify
   :case/input "../metaspec-metaspec.edn"
   :case/expected :pass}
  {:case/id :hara.metaspec/valid-artifact-metaspec
   :case/type :verify
   :case/input "../../../../00-unsorted/artifact/metaspec/artifact-metaspec.edn"
   :case/expected :pass}
  {:case/id :hara.metaspec/missing-required-section
   :case/type :lint
   :case/input {:document/type :hara/metaspec}
   :case/expected :hara.metaspec.rule/required-key}
  {:case/id :hara.metaspec/unqualified-extension-key
   :case/type :lint
   :case/input {:extension true}
   :case/expected :hara.metaspec.rule/qualified-key}
  {:case/id :hara.metaspec/duplicate-schema-id
   :case/type :lint
   :case/input [{:schema/id :demo/value :schema/type :string}
                {:schema/id :demo/value :schema/type :keyword}]
   :case/expected :hara.metaspec.rule/duplicate-id}
  {:case/id :hara.metaspec/unresolved-schema-reference
   :case/type :verify
   :case/input {:schema/ref :missing/schema}
   :case/expected :hara.metaspec.rule/schema-reference}
  {:case/id :hara.metaspec/agent-repair-action
   :case/type :report
   :case/input :missing-required-key
   :case/expected
   {:action/type :add-key
    :action/path []
    :action/key :document/id}}]}
