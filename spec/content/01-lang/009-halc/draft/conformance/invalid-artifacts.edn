{:corpus/id :halc/invalid-artifacts
 :corpus/version "alpha"
 :base/artifact "golden/complete.halc"
 :cases
 [{:case/id :envelope/bad-magic :mutations [[:replace 0 "00000000"]] :expect/error :bad-magic}
  {:case/id :envelope/unsupported-version :mutations [[:u16 4 2]] :expect/error :unsupported-version}
  {:case/id :envelope/unknown-flag :mutations [[:u16 6 32768]] :expect/error :unsupported-flags}
  {:case/id :envelope/truncated-header :mutations [[:truncate 20]] :expect/error :truncated}
  {:case/id :envelope/truncated-payload :mutations [[:drop-last 1]] :expect/error :truncated}
  {:case/id :envelope/trailing-byte :mutations [[:append "00"]] :expect/error :trailing-bytes}
  {:case/id :checksum/corrupt-payload :mutations [[:xor-last 1]] :expect/error :checksum-mismatch}
  {:case/id :limit/payload :construction [:envelope {:payload-length 67108865}] :expect/error :size-limit}
  {:case/id :limit/string :construction [:payload-value {:opcode 7 :declared-length 16777217}] :expect/error :size-limit}
  {:case/id :limit/collection :construction [:payload-value {:opcode 12 :declared-count 1000001}] :expect/error :count-limit}
  {:case/id :limit/depth :construction [:nested-vector {:depth 257}] :expect/error :depth-limit}
  {:case/id :limit/total-values :construction [:value-sequence {:count 4000001}] :expect/error :value-limit}
  {:case/id :value/unknown-opcode :construction [:payload-value {:opcode 255}] :expect/error :unsupported-opcode}
  {:case/id :value/invalid-utf8 :construction [:payload-value {:opcode 7 :bytes "ff"}] :expect/error :invalid-utf8}
  {:case/id :value/invalid-character :construction [:payload-value {:opcode 8 :codepoint 55296}] :expect/error :invalid-character}
  {:case/id :value/noncanonical-big-integer :construction [:payload-value {:opcode 5 :text "01"}] :expect/error :invalid-number}
  {:case/id :value/non-map-metadata :construction [:metadata {:value true}] :expect/error :invalid-metadata}
  {:case/id :value/duplicate-map-key :construction [:map [[1 "a"] [1 "b"]]] :expect/error :duplicate-key}
  {:case/id :value/duplicate-set-element :construction [:set [1 1]] :expect/error :duplicate-element}
  {:case/id :legacy/unsupported-version :base/artifact "golden/legacy-v1.hir" :mutations [[:u16 4 2]] :expect/error :unsupported-version}]}
