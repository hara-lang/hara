 :host-kernel/conformance
 [{:conformance/id :host/type-identity
   :conformance/assert
   "(= Host std.native.Host std.foundation/Host)"}
  {:conformance/id :host/session-local-facade
   :conformance/assert
   "Each session receives a distinct Host facade identity while all three Host names within that session resolve to that one identity."}
  {:conformance/id :host/namespace-loaded
   :conformance/assert
   "std.native and std.native.Host report :loaded immediately and inspection does not force provider discovery or package activation."}
  {:conformance/id :host/no-special-form
   :conformance/assert
   "host/call resolves only through an explicitly required HAL namespace."}
  {:conformance/id :host/session-grants
   :conformance/assert
   "Two sessions may observe different host/capabilities results."}
  {:conformance/id :host/no-live-transfer
   :conformance/assert
   "Host facades, provider handles, promises, streams, and sockets are rejected by session transfer."}
  {:conformance/id :host/rejected-ex-info
   :conformance/assert
   "Rejected Host promises preserve ex-info identity and one of the normative :host/* error codes through catch, deref, and session evaluation."}
  {:conformance/id :host/atomic-resources
   :conformance/assert
   "A failed batch registers no resources."}
  {:conformance/id :sandbox/private-session
   :conformance/assert
   "Opening a sandbox creates a private Session that never appears in ordinary Session enumeration and is released on every terminal path."}
  {:conformance/id :sandbox/restricted-runtime
   :conformance/assert
   "Sandboxed code cannot resolve Kernel, Sandbox, privileged native descriptors, provider bindings, parent identity, mounts, development resources, or parent and application namespaces."}
  {:conformance/id :sandbox/cancellable-lifecycle
   :conformance/assert
   "Java and Rust agree for open, eval, value-call, explicit cancel, Promise cancel, status, and close, including cancellation races and terminal cleanup."}
  {:conformance/id :sandbox/secure-provider
   :conformance/assert
   "The Hoplite provider reports secure only on Linux after peer authentication, pre-opened capability confinement, resource limits, no-new-privileges, seccomp, and deterministic kill-and-reap are active; unsupported platforms fail closed."}]}
