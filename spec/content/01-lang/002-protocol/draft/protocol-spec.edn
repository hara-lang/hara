 :protocol/dispatch
 {:dispatch/receiver-position 0
  :dispatch/built-in
  "Built-in values dispatch through the runtime protocol registry using the canonical protocol and method names."
  :dispatch/guest
  "Guest structs dispatch to the most recent extension for their exact struct type in the active context."
  :dispatch/inheritance
  "An extension of a child protocol satisfies inherited parent method declarations only when the implementation provides the inherited methods."
  :dispatch/variadic-arity
  "A :variadic method accepts the method-specific minimum arity and any supported trailing arguments."
  :dispatch/no-host-fallback true}

 :protocol/extension
 {:extension/forms #{defprotocol extend-type}
  :extension/visibility :context-local
  :extension/replacement :latest-definition
  :extension/unsupported-receiver
  "Calling a declared method without an applicable implementation raises protocol/unsupported-receiver."
  :extension/struct-boundary
  "Struct construction and field semantics are defined by the core-language contract; this specification only owns protocol dispatch on the resulting value."}

