{:document/id :hara/protocol
 :document/type :protocol-spec
 :document/version "alpha"
 :document/status :draft
 :document/title "Hara built-in protocol specification"
 :document/summary
 "Portable contract for the built-in protocol descriptors, method namespaces, dispatch, and guest extension surface under std.protocol.*."

 :spec/conforms-to
 {:spec/id :hara/protocol-metaspec
  :spec/version "alpha"}

 :protocol/scope
 {:scope/namespace-family "std.protocol.*"
  :scope/includes
  #{:protocol-descriptors :method-vars :method-arities :inheritance
    :built-in-dispatch :guest-extension :context-local-identity}
  :scope/excludes
  #{:struct-construction :multimethods :foundation-wrappers
    :native-type-methods :host-implementation-types}}

 :protocol/invariants
 [{:requirement/id :protocol/canonical-identity
   :requirement/level :must
   :requirement/text
   "A built-in protocol is identified by its canonical qualified symbol under std.protocol.*, not by a host interface or implementation object."}
  {:requirement/id :protocol/context-local
   :requirement/level :must
   :requirement/text
   "Protocol declarations, guest extensions, and dispatch registries belong to one Hara runtime context."}
  {:requirement/id :protocol/portable-methods
   :requirement/level :must
   :requirement/text
   "Method names, arities, inheritance, successful results, and failure categories are portable across conforming runtimes."}
  {:requirement/id :protocol/no-helper-api
   :requirement/level :must-not
   :requirement/text
   "Implementation helper classes, Rust functions, Java interfaces, or registry objects become guest-visible protocol API."}]

 :protocol/naming
 {:naming/protocol-symbol "IName"
  :naming/namespace-rule
  "Lower-case the protocol symbol and append it to std.protocol as the base namespace."
  :naming/protocol-var-rule
  "The protocol descriptor is std.protocol.<lowercase>.IName/IName."
  :naming/method-var-rule
  "Every method is a public Var in std.protocol.<lowercase>.IName/<method>."
  :naming/root-alias
  "std.foundation and ordinary non-blank namespaces alias each protocol symbol to its canonical namespace."}

