{:format :hara.async/conformance
 :version 1
 :cases
 [{:id :async/direct-value
   :source "(do (defn ^:async f [] 42) (promise? (f)))"
   :expect true}
  {:id :async/no-implicit-await
   :source "(do (defn ^:async f [] 42) [(f)])"
   :expect-type :vector-containing-promise}
  {:id :await/fulfilled
   :source "(defn ^:async f [] (co/await (promise/from 42)))"
   :expect-promise-value 42}
  {:id :await/rejected
   :source "(defn ^:async f [] (co/await rejected-promise))"
   :expect :rejection-thrown}
  {:id :await/pending
   :source "(defn ^:async f [] (co/await pending-promise))"
   :expect :fiber-suspended}
  {:id :await/outside-async
   :source "(defn bad [] (co/await p))"
   :compile-error :await-outside-async}
  {:id :await/nested-function-resets
   :source "(defn ^:async outer [] (fn [] (co/await p)))"
   :compile-error :await-outside-async}
  {:id :await/direct-create-body
   :source "(co/create (fn [] (co/await p)))"
   :expect :valid}
  {:id :async/adopts-promise
   :source "(defn ^:async f [] (promise/from 42))"
   :expect-promise-value 42}
  {:id :async/cancellation
   :source "(defn ^:async f [] (co/await pending-promise))"
   :cancel true
   :expect-rejection-kind :cancelled}]}
