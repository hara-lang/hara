{:document/id :hara/foundation-annex-metaspec
 :document/type :hara/metaspec
 :document/version "alpha"
 :document/status :draft
 :document/title "Hara Foundation annex specification meta-spec"
 :document/summary
 "Defines the machine-readable contract for the current std.foundation surface, native capability objects, aliases, and migration records."

 :spec/conforms-to
 {:spec/id :hara/metaspec-metaspec
  :spec/version "alpha"}
 :spec/artifact-kind :hara/foundation-annex-spec

 :meta/document-schema
 {:schema/id :hara.foundation-annex.metaspec/document
  :schema/type :map
  :schema/closed false
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to
   :annex/scope :annex/invariants :annex/libraries :annex/aliases
   :annex/capabilities :annex/errors :annex/references :annex/conformance]
  :schema/properties
  {:document/id {:schema/ref :hara.foundation-annex.metaspec/qualified-keyword}
   :document/type {:schema/value :foundation-annex-spec}
   :document/version {:schema/ref :hara.foundation-annex.metaspec/version-string}
   :document/status {:schema/ref :hara.foundation-annex.metaspec/status}
   :document/title {:schema/ref :hara.foundation-annex.metaspec/non-empty-string}
   :document/summary {:schema/ref :hara.foundation-annex.metaspec/non-empty-string}
   :spec/conforms-to {:schema/ref :hara.foundation-annex.metaspec/spec-reference}
   :annex/source {:schema/ref :hara.foundation-annex.metaspec/source-provenance}
   :annex/scope {:schema/type :map}
   :annex/invariants {:schema/type :vector
                      :schema/items :hara.foundation-annex.metaspec/requirement}
   :annex/root {:schema/ref :hara.foundation-annex.metaspec/root-surface}
   :annex/libraries {:schema/type :vector
                     :schema/items :hara.foundation-annex.metaspec/library}
   :annex/aliases {:schema/type :vector
                   :schema/items :hara.foundation-annex.metaspec/alias}
   :annex/native-objects {:schema/type :vector
                          :schema/items :hara.foundation-annex.metaspec/native-object}
   :annex/migrations {:schema/type :vector
                      :schema/items :hara.foundation-annex.metaspec/migration}
   :annex/capabilities {:schema/type :map}
   :annex/errors {:schema/type :vector}
   :annex/references {:schema/type :vector
                      :schema/items :hara.foundation-annex.metaspec/reference}
   :annex/conformance {:schema/type :vector
                       :schema/items :hara.foundation-annex.metaspec/conformance}
   :annex/generation {:schema/ref :hara.foundation-annex.metaspec/generation}}}

 :meta/schemas
 [{:schema/id :hara.foundation-annex.metaspec/qualified-keyword
   :schema/type :keyword
   :schema/constraint :qualified}
  {:schema/id :hara.foundation-annex.metaspec/non-empty-string
   :schema/type :string
   :schema/min-length 1}
  {:schema/id :hara.foundation-annex.metaspec/version-string
   :schema/type :string
   :schema/pattern "^alpha$"}
  {:schema/id :hara.foundation-annex.metaspec/sha256
   :schema/type :string
   :schema/pattern "^sha256:[0-9a-f]{64}$"}
  {:schema/id :hara.foundation-annex.metaspec/git-sha
   :schema/type :string
   :schema/pattern "^[0-9a-f]{40}$"}
  {:schema/id :hara.foundation-annex.metaspec/status
   :schema/type :enum
   :schema/values [:draft :candidate :stable :deprecated :retired]}
  {:schema/id :hara.foundation-annex.metaspec/implementation-status
   :schema/type :enum
   :schema/values [:implemented :planned :moved :retired :compatibility-only]}
  {:schema/id :hara.foundation-annex.metaspec/runtime-profile
   :schema/type :enum
   :schema/values [:rust :jvm :wasm]}
  {:schema/id :hara.foundation-annex.metaspec/spec-reference
   :schema/type :map
   :schema/required [:spec/id :spec/version]}
  {:schema/id :hara.foundation-annex.metaspec/requirement
   :schema/type :map
   :schema/required
   [:requirement/id :requirement/level :requirement/text]}
  {:schema/id :hara.foundation-annex.metaspec/source-provenance
   :schema/type :map
   :schema/required
   [:source/repository :source/ref :source/commit
    :source/manifest-schema :source/surface-digest]
   :schema/properties
   {:source/repository {:schema/ref :hara.foundation-annex.metaspec/non-empty-string}
    :source/ref {:schema/ref :hara.foundation-annex.metaspec/non-empty-string}
    :source/commit {:schema/ref :hara.foundation-annex.metaspec/git-sha}
    :source/manifest-schema {:schema/type :integer :schema/min 2}
    :source/surface-digest {:schema/ref :hara.foundation-annex.metaspec/sha256}
    :source/migration-digest {:schema/ref :hara.foundation-annex.metaspec/sha256}}}
  {:schema/id :hara.foundation-annex.metaspec/binding
   :schema/type :map
   :schema/required [:binding/name :binding/kind]
   :schema/properties
   {:binding/name {:schema/type :symbol}
    :binding/kind {:schema/type :keyword}
    :binding/signature {:schema/type :string}
    :binding/doc {:schema/type :string}
    :binding/source-path {:schema/type :string}
    :binding/source-line {:schema/type :integer}}}
  {:schema/id :hara.foundation-annex.metaspec/root-surface
   :schema/type :map
   :schema/required
   [:root/namespace :root/status :root/source-path :root/public-bindings
    :root/profiles]
   :schema/properties
   {:root/namespace {:schema/value std.foundation}
    :root/status {:schema/ref :hara.foundation-annex.metaspec/implementation-status}
    :root/source-path {:schema/type :string}
    :root/public-bindings {:schema/type :vector
                           :schema/items :hara.foundation-annex.metaspec/binding}
    :root/profiles {:schema/type :vector
                    :schema/items :hara.foundation-annex.metaspec/runtime-profile}}}
  {:schema/id :hara.foundation-annex.metaspec/library
   :schema/type :map
   :schema/required
   [:library/id :library/namespace :library/alias :library/classification
    :library/public-vars]
   :schema/properties
   {:library/status {:schema/ref :hara.foundation-annex.metaspec/implementation-status}
    :library/source-path {:schema/type :string}
    :library/profiles {:schema/type :vector
                       :schema/items :hara.foundation-annex.metaspec/runtime-profile}
    :library/profile-differences {:schema/type :map}
    :library/public-bindings {:schema/type :vector
                              :schema/items :hara.foundation-annex.metaspec/binding}}}
  {:schema/id :hara.foundation-annex.metaspec/alias
   :schema/type :map
   :schema/required [:alias/name :alias/target :alias/kind :alias/automatic]
   :schema/properties
   {:alias/name {:schema/type :symbol}
    :alias/target {:schema/type :symbol}
    :alias/kind {:schema/type :enum
                 :schema/values [:namespace-alias :native-object-alias]}
    :alias/automatic {:schema/type :boolean}
    :alias/profiles {:schema/type :vector
                     :schema/items :hara.foundation-annex.metaspec/runtime-profile}}}
  {:schema/id :hara.foundation-annex.metaspec/native-object
   :schema/type :map
   :schema/required
   [:native/name :native/internal-namespace :native/status :native/profiles]
   :schema/properties
   {:native/name {:schema/type :symbol}
    :native/internal-namespace {:schema/type :symbol}
    :native/status {:schema/ref :hara.foundation-annex.metaspec/implementation-status}
    :native/profiles {:schema/type :vector
                      :schema/items :hara.foundation-annex.metaspec/runtime-profile}
    :native/profile-differences {:schema/type :map}}}
  {:schema/id :hara.foundation-annex.metaspec/replacement
   :schema/type :map
   :schema/required [:replacement/kind :replacement/name]
   :schema/properties
   {:replacement/kind {:schema/type :enum
                       :schema/values
                       [:namespace :namespace-root :native-static-object
                        :native-capability :planned-namespace]}
    :replacement/name {:schema/type :symbol}
    :replacement/status {:schema/ref :hara.foundation-annex.metaspec/implementation-status}}}
  {:schema/id :hara.foundation-annex.metaspec/migration
   :schema/type :map
   :schema/required
   [:migration/id :migration/former-name :migration/status
    :migration/require-rewrite :migration/call-rewrite :migration/evidence]
   :schema/properties
   {:migration/id {:schema/ref :hara.foundation-annex.metaspec/qualified-keyword}
    :migration/former-name {:schema/type :symbol}
    :migration/status {:schema/ref :hara.foundation-annex.metaspec/implementation-status}
    :migration/replacement {:schema/ref :hara.foundation-annex.metaspec/replacement}
    :migration/disposition {:schema/type :string}
    :migration/require-rewrite {:schema/type :string}
    :migration/call-rewrite {:schema/type :string}
    :migration/compatibility {:schema/type :string}
    :migration/evidence {:schema/type :vector}
    :migration/profiles {:schema/type :vector
                         :schema/items :hara.foundation-annex.metaspec/runtime-profile}}}
  {:schema/id :hara.foundation-annex.metaspec/generation
   :schema/type :map
   :schema/required
   [:generation/tool :generation/tool-version :generation/manifest-schema
    :generation/surface-digest]
   :schema/properties
   {:generation/tool {:schema/type :string}
    :generation/tool-version {:schema/type :string}
    :generation/manifest-schema {:schema/type :integer :schema/min 2}
    :generation/surface-digest {:schema/ref :hara.foundation-annex.metaspec/sha256}
    :generation/migration-digest {:schema/ref :hara.foundation-annex.metaspec/sha256}
    :generation/generated-at {:schema/type :string
                              :schema/semantic false}}}
  {:schema/id :hara.foundation-annex.metaspec/reference
   :schema/type :map
   :schema/required
   [:reference/id :reference/path :reference/authority]}
  {:schema/id :hara.foundation-annex.metaspec/conformance
   :schema/type :map
   :schema/required
   [:conformance/id :conformance/path :conformance/authority]}]

 :meta/cross-references
 [{:reference/id :hara.foundation-annex.metaspec/native-reference
   :reference/from :native/internal-namespace
   :reference/to :hara/native}
  {:reference/id :hara.foundation-annex.metaspec/capability-reference
   :reference/from :library/capability
   :reference/to :capability/id}
  {:reference/id :hara.foundation-annex.metaspec/current-source
   :reference/from :annex/source
   :reference/to :hara/api-manifest}
  {:reference/id :hara.foundation-annex.metaspec/migration-source
   :reference/from :annex/migrations
   :reference/to :hara/foundation-migration-ledger}
  {:reference/id :hara.foundation-annex.metaspec/conformance-path
   :reference/from :conformance/path
   :reference/to :document-relative-path}]

 :meta/requirements
 [{:requirement/id :hara.foundation-annex.metaspec/public-libraries
   :requirement/level :must
   :requirement/text
   "Every current public std.foundation child namespace is marked implemented and declares exact bindings, source provenance, aliases, and runtime profiles."}
  {:requirement/id :hara.foundation-annex.metaspec/root-separate
   :requirement/level :must
   :requirement/text
   "The root std.foundation binding surface is represented independently from the child namespace count."}
  {:requirement/id :hara.foundation-annex.metaspec/implementation-private
   :requirement/level :must-not
   :requirement/text
   "An implementation helper, source file, test namespace, alias, or native object becomes a current public namespace without an implemented namespace record."}
  {:requirement/id :hara.foundation-annex.metaspec/current-count
   :requirement/level :must
   :requirement/text
   "Only implemented namespace records contribute to the current Foundation namespace count; moved, retired, planned, and compatibility-only records do not."}
  {:requirement/id :hara.foundation-annex.metaspec/pinned-source
   :requirement/level :must
   :requirement/text
   "Generated current API data records the exact Hara repository, ref, commit, manifest schema, and semantic surface digest."}
  {:requirement/id :hara.foundation-annex.metaspec/migration-separation
   :requirement/level :must
   :requirement/text
   "Moved and retired names remain queryable as migration records without being presented as current API."}
  {:requirement/id :hara.foundation-annex.metaspec/semantic-generation
   :requirement/level :must
   :requirement/text
   "Generation timestamps and other volatile metadata do not participate in semantic surface comparison."}
  {:requirement/id :hara.foundation-annex.metaspec/capability-boundary
   :requirement/level :must
   :requirement/text
   "Host-backed native objects declare authority requirements and profile availability separately from portable namespaces."}
  {:requirement/id :hara.foundation-annex.metaspec/qualified-keys
   :requirement/level :must
   :requirement/text "Unknown extension keys are qualified keywords."}]

 :meta/checkers
 [{:checker/id :hara.foundation-annex.metaspec.rule/qualified-key
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-map-keys
   :checker/requirement :hara.foundation-annex.metaspec/qualified-keys}
  {:checker/id :hara.foundation-annex.metaspec.rule/duplicate-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/unique-field-values
   :checker/requirement :hara.foundation-annex.metaspec/public-libraries
   :checker/fields
   [:document/id :library/id :migration/id :migration/former-name
    :native/name :alias/name :requirement/id :reference/id :conformance/id]}]

 :metaspec/generation
 {:generation/input
  {:input/type :hara.foundation-annex.metaspec/request
   :input/required
   [:request/title :request/api-manifest :request/migration-ledger
    :request/aliases :request/capabilities]}
  :generation/output
  {:output/type :hara/foundation-annex-spec
   :output/format :edn
   :output/required
   [:document/id :document/type :document/version :document/status
    :document/title :document/summary :spec/conforms-to
    :annex/source :annex/scope :annex/invariants :annex/root
    :annex/libraries :annex/aliases :annex/native-objects
    :annex/migrations :annex/capabilities :annex/errors
    :annex/references :annex/conformance :annex/generation]}
  :generation/process
  [:read-pinned-api-manifest :verify-source-commit
   :verify-surface-digest :read-migration-ledger
   :separate-root-and-child-namespaces
   :separate-aliases-and-native-objects
   :classify-current-and-historical-records
   :generate-draft :generate-readme :lint
   :repair-findings :emit-canonical-edn]
  :generation/semantic-exclusions
  [:generation/generated-at]
  :generation/acceptance
  {:acceptance/status :pass
   :acceptance/required-summary
   {:summary/fail 0 :summary/unknown 0 :summary/blocked 0}}}}
