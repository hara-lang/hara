{:document/id :hara/foundation-metaspec
 :document/type :hara/metaspec
 :document/version "alpha"
 :document/status :draft
 :document/title "Hara Foundation specification meta-spec"
 :document/summary
 "Defines the machine-readable contract for the root std.foundation bootstrap namespace."

 :spec/conforms-to
 {:spec/id :hara/metaspec-metaspec
  :spec/version "alpha"}
 :spec/artifact-kind :hara/foundation-spec

 :meta/document-schema
 {:schema/id :hara.foundation.metaspec/document
  :schema/type :map
  :schema/closed false
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to
   :foundation/scope :foundation/invariants :foundation/bootstrap
   :foundation/surface :foundation/classification :foundation/errors
   :foundation/references :foundation/conformance]
  :schema/properties
  {:document/id {:schema/ref :hara.foundation.metaspec/qualified-keyword}
   :document/type {:schema/value :foundation-spec}
   :document/version {:schema/ref :hara.foundation.metaspec/version-string}
   :document/status {:schema/ref :hara.foundation.metaspec/status}
   :document/title {:schema/ref :hara.foundation.metaspec/non-empty-string}
   :document/summary {:schema/ref :hara.foundation.metaspec/non-empty-string}
   :spec/conforms-to {:schema/ref :hara.foundation.metaspec/spec-reference}
   :foundation/scope {:schema/type :map}
   :foundation/invariants {:schema/type :vector
                           :schema/items :hara.foundation.metaspec/requirement}
   :foundation/bootstrap {:schema/type :map}
   :foundation/surface {:schema/type :vector
                        :schema/items :hara.foundation.metaspec/surface-group}
   :foundation/classification {:schema/type :map}
   :foundation/errors {:schema/type :vector}
   :foundation/references {:schema/type :vector
                           :schema/items :hara.foundation.metaspec/reference}
   :foundation/conformance {:schema/type :vector
                            :schema/items :hara.foundation.metaspec/conformance}}}

 :meta/schemas
 [{:schema/id :hara.foundation.metaspec/qualified-keyword
   :schema/type :keyword
   :schema/constraint :qualified}
  {:schema/id :hara.foundation.metaspec/non-empty-string
   :schema/type :string
   :schema/min-length 1}
  {:schema/id :hara.foundation.metaspec/version-string
   :schema/type :string
   :schema/pattern "^alpha$"}
  {:schema/id :hara.foundation.metaspec/status
   :schema/type :enum
   :schema/values [:draft :candidate :stable :deprecated :retired]}
  {:schema/id :hara.foundation.metaspec/spec-reference
   :schema/type :map
   :schema/required [:spec/id :spec/version]}
  {:schema/id :hara.foundation.metaspec/requirement
   :schema/type :map
   :schema/required
   [:requirement/id :requirement/level :requirement/text]}
  {:schema/id :hara.foundation.metaspec/surface-group
   :schema/type :map
   :schema/required
   [:surface/id :surface/domain :surface/symbols
    :surface/classification]}
  {:schema/id :hara.foundation.metaspec/reference
   :schema/type :map
   :schema/required
   [:reference/id :reference/path :reference/authority]}
  {:schema/id :hara.foundation.metaspec/conformance
   :schema/type :map
   :schema/required
   [:conformance/id :conformance/path :conformance/authority]}]

 :meta/cross-references
 [{:reference/id :hara.foundation.metaspec/protocol-reference
   :reference/from :surface/protocol-spec
   :reference/to :hara/protocol}
  {:reference/id :hara.foundation.metaspec/native-reference
   :reference/from :surface/native-spec
   :reference/to :hara/native}
  {:reference/id :hara.foundation.metaspec/conformance-path
   :reference/from :conformance/path
   :reference/to :document-relative-path}]

 :meta/requirements
 [{:requirement/id :hara.foundation.metaspec/public-surface
   :requirement/level :must
   :requirement/text
   "Every public root Var belongs to exactly one surface group with an implementation classification and metadata contract."}
  {:requirement/id :hara.foundation.metaspec/bootstrap
   :requirement/level :must
   :requirement/text
   "Foundation referral, blank namespaces, built-in activation, and intrinsic aliasing are specified."}
  {:requirement/id :hara.foundation.metaspec/portable-values
   :requirement/level :must
   :requirement/text
   "Public functions return portable Hara values except for explicitly declared runtime value types."}
  {:requirement/id :hara.foundation.metaspec/qualified-keys
   :requirement/level :must
   :requirement/text "Unknown extension keys are qualified keywords."}]

 :meta/checkers
 [{:checker/id :hara.foundation.metaspec.rule/qualified-key
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-map-keys
   :checker/requirement :hara.foundation.metaspec/qualified-keys}
  {:checker/id :hara.foundation.metaspec.rule/duplicate-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/unique-field-values
   :checker/requirement :hara.foundation.metaspec/public-surface
   :checker/fields
   [:document/id :surface/id :requirement/id :reference/id :conformance/id]}]

 :metaspec/generation
 {:generation/input
  {:input/type :hara.foundation.metaspec/request
   :input/required
   [:request/title :request/bootstrap :request/surface
    :request/classification]}
  :generation/output
  {:output/type :hara/foundation-spec
   :output/format :edn
   :output/required
   [:document/id :document/type :document/version :document/status
    :document/title :document/summary :spec/conforms-to
    :foundation/scope :foundation/invariants :foundation/bootstrap
    :foundation/surface :foundation/classification :foundation/errors
    :foundation/references :foundation/conformance]}
  :generation/process
  [:load-fresh-context :inventory-public-vars :classify-ownership
   :generate-draft :lint :repair-findings :emit-canonical-edn]
  :generation/acceptance
  {:acceptance/status :pass
   :acceptance/required-summary
   {:summary/fail 0 :summary/unknown 0 :summary/blocked 0}}}}
