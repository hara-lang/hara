{:document/id :hara/foundation
 :document/type :foundation-spec
 :document/version "alpha"
 :document/status :draft
 :document/title "Hara Foundation bootstrap namespace"
 :document/summary
 "Portable contract for std.foundation, its automatically referred public surface, and the boundary between HAL definitions, protocols, and native primitives."

 :spec/conforms-to
 {:spec/id :hara/foundation-metaspec
  :spec/version "alpha"}

 :foundation/scope
 {:scope/namespace std.foundation
  :scope/includes
  #{:bootstrap-referral :namespace-configuration :root-public-vars
    :root-macros :protocol-aliases :native-type-aliases
    :portable-function-wrappers :public-metadata :portable-library-contracts
    :qualified-foundation-libraries}
  :scope/excludes
  #{:core-form-semantics :protocol-dispatch-semantics :native-method-semantics
    :general-host-interop}}

 :foundation/invariants
 [{:requirement/id :foundation/bootstrap-portable
   :requirement/level :must
   :requirement/text
   "The same root public names, kinds, arglists, metadata, and observable results are available in each conforming runtime profile."}
  {:requirement/id :foundation/ownership
   :requirement/level :must
   :requirement/text
   "Every public root name is classified as portable HAL, protocol alias, native alias, narrow runtime primitive, macro, or constant."}
  {:requirement/id :foundation/no-host-values
   :requirement/level :must-not
   :requirement/text
   "A public function leaks mutable Java, Rust, JavaScript, or implementation collection values unless the return type is an explicitly declared Hara runtime value."}
  {:requirement/id :foundation/metadata
   :requirement/level :must
   :requirement/text
   "Public functions preserve their documented name, namespace, docstring, arglists, and schema metadata."}
  {:requirement/id :foundation/no-clojure-assumption
   :requirement/level :must
   :requirement/text
   "A similarly named Clojure function does not define Foundation semantics unless this specification says so."}
  {:requirement/id :foundation/lookup-does-not-load
   :requirement/level :must
   :requirement/text
   "Symbol resolution only inspects loaded namespaces. Deferred or runtime-selected code may load only through an exact entry in a declared registry."}]

 :foundation/bootstrap
 {:bootstrap/automatic-referral
  "An ordinary namespace refers the public std.foundation surface unless its single :config map sets :blank true."
  :bootstrap/blank
  {:blank/foundation-referral false
   :blank/special-forms true
   :blank/native-and-protocol-aliases true}
  :bootstrap/config
  {:config/cardinality :zero-or-one
   :config/keys #{:blank :override :only :rename :set-global-alias :set-global :role}
   :config/unknown-key :error}
  :bootstrap/builtins
  {:builtins/status :internal-runtime-accounting
   :builtins/configurable false
   :builtins/native-type false
   :builtins/namespace false
   :builtins/contract :hal/language}
  :bootstrap/foundation-selection
  {:foundation/default :all
   :foundation/override "Names omitted from startup referral so the namespace may define them."
   :foundation/only "Exact Foundation names retained from startup referral."
   :foundation/conflicts
   #{[:blank :override] [:blank :only] [:override :only]}}
  :bootstrap/rename
  {:rename/default :all
   :rename/options #{:exclude :alias}
   :rename/annex :hara/foundation-annex}
  :bootstrap/global-imports
  {:set-global-alias :unqualified-symbol
   :set-global :vector-of-qualified-vars
   :set-global/import-name :terminal-symbol
   :set-global/protocol-shorthand true}
  :bootstrap/intrinsics
  {:intrinsics/reserved-for [:native-types :runtime-symbols]
   :intrinsics/namespace-config false}
  :bootstrap/protocol-aliases
  {:aliases/spec :hara/protocol
   :aliases/selection :all}
  :bootstrap/native-aliases
  {:aliases/spec :hara/native
   :aliases/selection :all}
  :bootstrap/qualified-library-aliases
  {str std.foundation.string
   co std.foundation.coroutine
   promise std.foundation.promise
   bytes std.foundation.bytes
  pretty std.foundation.pretty}
  :bootstrap/alias-validation
  {:accepted-alias-states #{:loaded :unloaded}
   :qualified-member-resolution :required
   :namespace-object-equality :not-required}}

 :foundation/namespaces
 {:namespaces/status :accepted
  :namespaces/closed true
  :namespaces/extra-namespaces :forbidden
  :namespaces/production
  {std.foundation :foundation-root
   std.foundation.bytes :foundation-library
   std.foundation.coroutine :foundation-library
   std.foundation.pretty :foundation-library
   std.foundation.promise :foundation-library
   std.foundation.string :foundation-library}
  :namespaces/development-only [std.foundation.bootstrap]
  :namespaces/former-children
  [{:namespace std.foundation.set :target std.foundation :target/kind :foundation-root}
   {:namespace std.foundation.component :target std.lib.component :target/kind :portable-library}
   {:namespace std.foundation.pretty.engine :target std.foundation.pretty :target/kind :foundation-library}
   {:namespace std.foundation.crypto :target Crypto :target/kind :native-static-object}
   {:namespace std.foundation.edn :target Edn :target/kind :native-static-object}
   {:namespace std.foundation.file :target File :target/kind :native-static-object}
   {:namespace std.foundation.host :target Host :target/kind :native-static-object}
   {:namespace std.foundation.json :target Json :target/kind :native-static-object}
   {:namespace std.foundation.kernel :target Kernel :target/kind :native-static-object}
   {:namespace std.foundation.os :target OS :target/kind :native-static-object}
   {:namespace std.foundation.socket :target Socket :target/kind :native-static-object}]
  :namespaces/evidence
  {:runtime/bootstrap "core/rust/bootstrap.namespaces"
   :runtime/migrations "core/spec/std/foundation-migrations.json"}}

 :foundation/surface
 [{:surface/id :foundation/protocol-aliases
   :surface/domain :protocol
   :surface/symbols
   {:symbols/spec :hara/protocol
    :symbols/selection :all-protocol-symbols}
   :surface/classification :protocol-alias
   :surface/protocol-spec :hara/protocol}
  {:surface/id :foundation/native-aliases
   :surface/domain :native-type
   :surface/symbols
   {:symbols/spec :hara/native
    :symbols/selection :all-native-type-symbols}
   :surface/classification :native-alias
   :surface/native-spec :hara/native}
  {:surface/id :foundation/composition
   :surface/domain :function
   :surface/symbols
   [identity call inc dec constantly comp complement partial juxt]
   :surface/classification :portable-hal}
  {:surface/id :foundation/predicates
   :surface/domain :function
   :surface/symbols
   [zero? pos? neg? even? odd? nil? false? true? has? empty?
    distinct?]
   :surface/classification :portable-hal}
  {:surface/id :foundation/protocol-predicates
   :surface/domain :function
   :surface/symbols
   [iterable? iterator? counted? reducible? indexed? associative?
    findable? lookupable? derefable? resettable? casable? watchable?
    applicable? mutable? persistent?]
   :surface/classification :portable-hal
   :surface/requirements
   [{:requirement/id :foundation/protocol-predicate-ownership
     :requirement/level :must
     :requirement/text
     "Protocol capability predicates are Foundation wrappers over satisfies? and are not duplicate Base or Iter native methods."}]}
  {:surface/id :foundation/value-classification
   :surface/domain :function
   :surface/symbols [type vector? pair? map-entry? coll?]
   :surface/classification :narrow-runtime-primitive
   :surface/requirements
   [{:requirement/id :foundation/vector-type
     :requirement/level :must
     :requirement/text
     "type returns :std.native.Vector for both compact tuple-backed vectors and persistent vectors, and :std.native.MapEntry for dedicated map entries."}
    {:requirement/id :foundation/vector-predicates
     :requirement/level :must
     :requirement/text
     "vector? accepts both vector backends; pair? and map-entry? accept only dedicated MapEntry values; compact vectors, persistent vectors, and lists are false even when their count is two."}
    {:requirement/id :foundation/collection-predicate
     :requirement/level :must
     :requirement/text
     "coll? is a source-owned Foundation binding over the runtime collection capability; it accepts persistent collection implementations and rejects scalars and nil."}]}
  {:surface/id :foundation/references
   :surface/domain :function
   :surface/symbols
   [reset! cas! swap! watch-add watch-remove watch-list]
   :surface/classification :protocol-wrapper}
  {:surface/id :foundation/metadata
   :surface/domain :function
   :surface/symbols [meta with-meta]
   :surface/classification :protocol-wrapper
   :surface/protocol-spec :hara/protocol}
  {:surface/id :foundation/collections
   :surface/domain :function
   :surface/symbols
   [reduce reduce-in concat first second rest not-empty last reverse get-in
    assoc-in update update-in key val keys vals min max sort sort-by drop-last
    butlast take-last split-at split-with partition-by take-nth into distinct
    zipmap map-keys map-vals merge-with group-by frequencies]
   :surface/classification :portable-hal}
  {:surface/id :foundation/iteration
   :surface/domain :function
   :surface/symbols
   [seq? iter? range repeat repeatedly iterate take-while drop-while partition-all
    partition interpose interleave map filter take drop mapcat keep cycle zip
    partition-pair every? any? some mapv]
   :surface/classification :native-wrapper
   :surface/native-spec :hara/native}
  {:surface/id :foundation/numeric-native
   :surface/domain :function
   :surface/symbols
   [long double bit-and bit-or bit-xor bit-not bit-shift-left bit-shift-right
    abs acos acosh asin asinh atan atan2 atanh ceil cos cosh exp floor pow sin
    sinh sqrt tan tanh]
   :surface/classification :native-wrapper
   :surface/native-spec :hara/native}
  {:surface/id :foundation/runtime-introspection
   :surface/domain :function
   :surface/symbols
   [read-forms load-string macroexpand macroexpand-all apply-in apply-as
    invoke-as ns-current current-symbols ns-state ns-loaded?
    ns-list ns-info ns-vars ns-name ns-publics ns-aliases ns-find ns-create
    resolve var-sym]
   :surface/classification :narrow-runtime-primitive}
  {:surface/id :foundation/environment-native
   :surface/domain :function
   :surface/symbols
   [env-snapshot env-module ns-alias-state intern-var eval-in-ns eval]
   :surface/classification :native-wrapper
   :surface/native-spec :hara/native}
  {:surface/id :foundation/macros
   :surface/domain :macro
   :surface/symbols
   [defonce doto if-not when if-let when-let cond-> cond->> with-ns intern-in intern-all
    with-template-meta template-vars template-entries code-line code-column test-check]
   :surface/classification :portable-hal
   :surface/requirements
   [{:requirement/id :foundation/with-macro-spelling
     :requirement/level :must
     :requirement/text
     "Foundation context macros use with-* public names: with-out-string, with-close, and with-template-meta. The former with:* spellings do not resolve."}]}
  {:surface/id :foundation/templates
   :surface/domain :function
   :surface/symbols [template-meta template-ensure intern-var]
   :surface/classification :mixed}
  {:surface/id :foundation/constants
   :surface/domain :constant
   :surface/symbols [E PI *template-meta*]
   :surface/classification :portable-value}]

 :foundation/defonce
 {:requirement/id :foundation/defonce-preserves-root
  :requirement/level :must
  :requirement/text "defonce checks for the qualified Var at runtime, evaluates and defines its initializer only when the Var is absent, and otherwise returns the existing Var without evaluating the initializer."}

 :foundation/collection-results
 {:collection/architecture
  {:collection/reduce-in
   {:collection/status :public-portable-hal
    :collection/protocols
    [IReduce
     IToMutable
     IToPersistent]
    :collection/native-base-method :forbidden}
   :collection/mapv
   {:collection/status :public-portable-hal
    :collection/result :persistent-vector
    :collection/multi-source :stop-at-shortest
    :collection/source-mutation :forbidden}}

  :collection/first-source
  {:collection/rule
   "Every source-sensitive transform and every multi-source transform derives result family, eager/lazy mode, and metadata from the first source only."
   :collection/eager-first-sources
   [:persistent-collection :array :object]
   :collection/lazy-first-sources
   [:explicit-seq :iterator :string :bytes :unsupported-iterable]
   :collection/multi-source [concat interleave map zip]
   :collection/zero-source-concat :empty-lazy-sequence
   :collection/source-mutation :forbidden}

  :collection/eager-rebuild
  {:collection/list-order :source-traversal-order
   :collection/tuple-overflow {:collection/maximum-width 8
                               :collection/result :vector}
   :collection/map-result-members :entry-shaped
   :collection/set-result-members :deduplicated
   :collection/metadata :preserve-first-source}

  :collection/result-exceptions
  {:collection/partition-outer
   {:collection/eager-source :vector
    :collection/lazy-source :lazy-sequence}
   :collection/split :vector-pair
   :collection/sort :vector}

  :collection/reduction
  {:collection/reduced :stop-immediately
   :collection/iterator-close :always-close-owned-remaining-iterators
   :collection/unreduced :exactly-once
   :collection/metadata :preserve-accumulator-metadata
   :collection/mutable-accumulator :finalize-to-persistent}

  :collection/requirements
  [{:requirement/id :foundation/reduce-in-portable
    :requirement/level :must
    :requirement/text
    "reduce-in remains a public portable HAL function composed from IReduce, IToMutable, and IToPersistent; no Base/reduce-in or std.native.Base/reduce-in method exists."}
   {:requirement/id :foundation/mapv-portable
    :requirement/level :must
    :requirement/text
    "mapv is portable HAL, accepts one or more sources, stops at the shortest source, and always returns a persistent vector while preserving map's iterator cleanup behavior."}
   {:requirement/id :foundation/test-native-boundary
    :requirement/level :must
    :requirement/text
    "Test configuration and inspection use Test/* directly. Foundation exposes only result and result? for native Result construction and recognition; Result/* owns all inspection. Foundation retains only the test-check macro needed to delay evaluation and normalize thrown test forms; test-config, test-result, test-passed?, result-status, and every res-* compatibility name do not resolve."}
   {:requirement/id :foundation/first-source-results
    :requirement/level :must
    :requirement/text
    "Persistent collections, arrays, and objects rebuild eagerly without source mutation; explicit seqs and iterators, strings, bytes, and otherwise unsupported iterables remain lazy. Multi-source operations and concat use the first source, while zero-source concat returns an empty lazy sequence."}
   {:requirement/id :foundation/indexed-sequence-access
    :requirement/level :must
    :requirement/text
    "first and last are implemented in std.foundation. When a value satisfies INth and ICount, first reads index 0 and last reads count minus one before consulting peek protocols or iterating; empty indexed values return nil."}
   {:requirement/id :foundation/result-family-details
    :requirement/level :must
    :requirement/text
    "Lists retain traversal order, tuple results wider than eight become vectors, map transforms accept only entry-shaped members, sets deduplicate, partition outer containers are vectors for eager sources and lazy sequences for lazy sources, split returns a vector pair, and sort returns a vector."}
   {:requirement/id :foundation/reduction-lifecycle
    :requirement/level :must
    :requirement/text
    "Every reduction path stops on reduced, closes owned remaining iterators on completion or failure, unwraps a reduced value exactly once, preserves accumulator metadata, and finalizes mutable accumulators."}]}


 :foundation/classification
 {:classification/portable-hal
  "Defined in lib/src/std/foundation.hal and executable without host interop."
  :classification/protocol-wrapper
  "Delegates to a method owned by :hara/protocol."
  :classification/native-wrapper
  "Delegates to a method owned by :hara/native while preserving portable Hara values."
  :classification/narrow-runtime-primitive
  "Implemented by the runtime because it operates on evaluator or namespace state."
  :classification/protocol-alias
  "Names a canonical std.protocol.* namespace."
  :classification/native-alias
  "Names a canonical std.native.* namespace."
  :classification/candidate-gate
  "Before candidate status, a fresh-context ns-publics inventory must exactly match the union of declared surface groups; draft omissions are specification findings."}


 :foundation/portable-filesystem
 {:filesystem/status :draft
  :filesystem/not-root-referred true
  :filesystem/native-spec :hara/native
  :filesystem/native-type :std.native/file
  :filesystem/path-model :canonical-logical-path
  :filesystem/effect-model :promise
  :filesystem/namespaces
  [{:namespace std.fs.path
    :classification :portable-hal
    :functions
    [normalise join resolve parent root file-name segments relativize subpath
     suffix remove-suffix add-suffix replace-suffix]}
   {:namespace std.fs.walk
    :classification :portable-hal-over-native-entries
    :functions [walk]}
   {:namespace std.fs
    :classification :portable-hal-over-native-file
    :functions
    [stat exists? entries list read-bytes write-bytes file? directory? symlink?
     select create-directory mkdir temp-file temp-directory copy-single copy
     copy-into move delete]}]
  :filesystem/requirements
  [{:requirement/id :filesystem/path-purity
    :requirement/level :must
    :requirement/text
    "std.fs.path is synchronous portable HAL and exposes no host path semantics."}
   {:requirement/id :filesystem/effect-promises
    :requirement/level :must
    :requirement/text
    "Every std.fs operation that touches the mounted filesystem returns a promise."}
   {:requirement/id :filesystem/deterministic-traversal
    :requirement/level :must
    :requirement/text
    "Traversal is lexical, sorted, depth-controlled, and never follows symbolic links."}
   {:requirement/id :filesystem/portable-recursion
    :requirement/level :must
    :requirement/text
    "Recursive copy creates directories before children; recursive delete removes directories in post-order."}
   {:requirement/id :filesystem/fail-fast
    :requirement/level :must
    :requirement/text
    "Recursive failures reject immediately; completed mutations are neither rolled back nor returned as partial success."}
   {:requirement/id :filesystem/safe-existing-targets
    :requirement/level :must
    :requirement/text
    "Write, copy, and move fail when the target exists unless replacement is explicitly requested."}]
  :filesystem/results
  {:simple-mutations :canonical-logical-path
   :recursive-copy :source-to-target-map
   :recursive-delete :deleted-path-vector}
  :filesystem/source
  ["../../../../lib/src/std/fs.hal"
   "../../../../lib/src/std/fs/path.hal"
   "../../../../lib/src/std/fs/walk.hal"]}

 :foundation/portable-sandbox
