(ns user)

;; Executable authority for ordinary callable values required before canonical
;; Foundation source has completed loading. These bindings must be installed by
;; the host's closed direct-callable catalog; they must not be reconstructed as
;; forms and redispatched through structural evaluation.
(def direct-callable-bootstrap-symbols
  '[boolean? promise/new promise/delay])

(def direct-callable-bootstrap-expected
  [true false :std.native.Promise :std.native.Promise])

(defn direct-callable-bootstrap-report
  "Exercises the bootstrap predicate and Promise constructors without relying
   on source-owned Foundation wrappers."
  []
  (let [created (promise/new
                 (fn [resolve reject]
                   (resolve 7)))
        delayed (promise/delay 0 (fn [] 9))]
    [(boolean? true)
     (boolean? 1)
     (type created)
     (type delayed)]))

(defn direct-callable-bootstrap-valid?
  "Returns true when the complete bootstrap callable boundary is available."
  []
  (= direct-callable-bootstrap-expected
     (direct-callable-bootstrap-report)))
