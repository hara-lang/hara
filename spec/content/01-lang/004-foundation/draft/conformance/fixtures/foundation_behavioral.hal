(def foundation-source-namespaces
  (vec (sort-by str (set (map (fn [variable] (symbol (namespace variable)))
                              foundation-source-vars)))))

(def foundation-profile-dispositions
  {:generated-runtime-vars
   '[std.foundation.pretty/->CanonicalVisitor
     std.foundation.pretty/map->CanonicalVisitor
     std.foundation.pretty/->PrettyVisitor
     std.foundation.pretty/map->PrettyVisitor]
   :bootstrap-bindings [:protocol-alias :native-alias :intrinsic]})

(def foundation-calibration-snippets
  {:protocol-and-mutation
   {:source "(let [mutable (to-mutable (vec [1])) persistent (to-persistent mutable)] [(vector? persistent) (= [1] persistent) (satisfies? IToMutable (vec [1])) (satisfies? IToPersistent mutable)])"
    :expected [true true true true]}
   :compact-tuple-mutation-boundary
   {:source "[(satisfies? IToMutable [1 2]) (satisfies? IToMutable (vec [1 2]))]"
    :expected [false true]}
   :collection-capability-predicate
   {:source "[(coll? (vec [1])) (coll? {:a 1}) (coll? 1) (coll? nil)]"
    :expected [true true false false]
    :diagnostic-history
    [{:observed :runtime-only-source-omission
      :reason "coll? was callable through a bootstrap seed but missing from the source-owned Foundation surface and corpus."}
     {:observed :bytecode-compiler-stack-overflow
      :reason "A source declaration that self-referenced the bootstrap coll? binding evaluated in the interpreter but recursively resolved while generating the native Foundation bundle; coll? now delegates directly to (satisfies? IColl value)."}
     {:observed :invalid-inline-composite
      :reason "The bytecode compiler correctly rejected :inline metadata on a composite approximation; the Foundation coll? wrapper now expands to the protocol query (satisfies? IColl value)."}]}
   :with-macro-spelling
   {:source "[(with-out-string (println \"x\")) (with-template-meta {:a 1} (template-meta)) (with-close [] :closed) (nil? (resolve 'std.foundation/with:out-string)) (nil? (resolve 'std.foundation/with:close)) (nil? (resolve 'std.foundation/with:template-meta))]"
    :expected ["x\n" {:a 1} :closed true true true]
    :diagnostic-history
    [{:observed :colon-qualified-public-names
      :reason "Foundation public bindings now use the ordinary with-* spelling; the former with:* names must not resolve."}]}
   :compact-vector-type-boundary
   {:source "[(type [1]) (type (vec [1]))]"
    :expected [:std.native.Vector :std.native.Vector]
    :diagnostic-history
    [{:observed [:hara/Vector :hara/Vector]
      :reason "Compact tuple storage is internal; both vector backends expose the same std.native vector descriptor."}]}
   :map-entry-boundary
   {:source "(let [entry (first {:key 42})] [(type entry) (map-entry? entry) (pair? entry) (vector? entry) (count entry) (key entry) (val entry) (nth entry 0) (nth entry 1) (vec entry) (pair? [:key 42]) (into {} [[:key 42]])])"
    :expected [:std.native.MapEntry true true false 2 :key 42 :key 42 [:key 42] false {:key 42}]}
   :protocol-aliases
   {:source "[(not (nil? IWork)) (not (nil? IStringLike)) (satisfies? IHash [1]) (satisfies? IHashCached [1])]"
    :expected [true true true true]}
   :iterator-promise-object
   {:source "(let [it (iter [1]) p (promise/from 1) object (with-meta [1] {:a 1})] [(satisfies? IIterator it) (satisfies? IIter it) (satisfies? IPromise p) (satisfies? IDeref p) (satisfies? IDerefTimeout p) (satisfies? IObjType object) (satisfies? IHash object)])"
    :expected [true true true true true true true]}
   :unsupported-hash-cache
   {:source "[(satisfies? IHashCached nil) (satisfies? IHashCached [1]) (satisfies? IHashCached {:a 1}) (satisfies? IHashCached #{1}) (satisfies? IHashCached (atom 1))]"
    :expected [false true true true false]}
   :iofn-inheritance-boundary
   {:source "[(satisfies? IOFn :a) (satisfies? IFn :a)]"
    :expected [true true]
    :diagnostic-history
    [{:observed [false true]
      :reason "Pre-conformance calibration captured before IOFn inherited IFn and keyword received the explicit IOFn marker."}]}
   :defonce-preserves-root
   {:source "(do (def foundation-once 10) (defonce foundation-once (throw \"must-not-run\")) foundation-once)"
    :expected 10}
   :reference-protocols
   {:source "(let [cell (atom 1)] [(reset! cell 2) (cas! cell 2 3) (swap! cell inc) (deref cell)])"
    :expected [2 true 4 4]}
   :portable-map-and-set
   {:source "[(map-keys inc {1 :a 2 :b}) (map-vals inc {:a 1 :b 2}) (union #{1 2} #{2 3}) (intersection #{1 2 3} #{2 3 4})]"
    :expected [{2 :a 3 :b} {:a 2 :b 3} #{1 2 3} #{2 3}]}
   :numeric-boundary
   {:source "[(sin 0) (cos 0) (pow 2 3) (sqrt 9) (long 9.9) (double 9)]"
    :expected [(double 0) (double 1) (double 8) (double 3) 9 (double 9)]}
   :string-unicode
   {:source "[(str/length \"hé\") (str/upper-case \"hara\") (str/reverse \"hara\") (str/decode-utf8 (str/encode-utf8 \"λ\"))]"
    :expected [2 "HARA" "arah" "λ"]}
   :bytes-copy
   {:source "(let [source (bytes 1 2) copy (bytes/copy source)] (bytes/set copy 0 9) [(bytes/get source 0) (bytes/get copy 0)])"
    :expected [1 9]}
   :pretty-width
   {:source "[(pretty/render \"abc\") (pretty/pprint-str {:a 1})]"
    :expected ["abc" "{:a 1}"]}
   :promise-value
   {:source "(let [value (promise/from 42)] [(promise/state value) (promise/value value)])"
    :expected [:fulfilled 42]}
   :coroutine-lifecycle
   {:source "(let [value (co/create (fn [] 1))] [(co/status value) (co/resume value) (co/status value)])"
    :expected [:suspended 1 :dead]}
   :string-wrap-sequential
   {:source "((str/wrap identity) [:a :b])"
    :expected [:a :b]}
   :mapv-and-some
   {:source "[(mapv inc (list 1 2)) (mapv + [1 2 3] [10]) (some (fn [value] (if (> value 2) (* value 10) nil)) [1 3 4]) (some odd? [2 4])]"
    :expected [[2 3] [11] 30 nil]
    :diagnostic-history
    [{:observed :unbound
      :reason "A transient Foundation draft removed mapv and omitted some; the accepted surface restores both as portable HAL."}]}
   :builtin-alias-resolution
   {:source "(let [members [(fn? str/length) (fn? co/create) (fn? promise/from) (fn? bytes/copy) (fn? pretty/render) (fn? Test/run)] states (map ns-alias-state '[str co promise bytes pretty Test])] [(map (fn [state] (str (:target state))) states) (every? (fn [state] (or (= :loaded (:state state)) (= :unloaded (:state state)))) states) members])"
    :expected [["std.foundation.string" "std.foundation.coroutine" "std.foundation.promise" "std.foundation.bytes" "std.foundation.pretty" "std.native.Test"] true [true true true true true true]]
    :diagnostic-history
    [{:observed {:jvm :loaded :rust :unloaded}
      :reason "Alias load state is runtime lifecycle metadata. Both states are valid when the target and representative qualified members resolve."}]}
   :direct-native-test-api
   {:source "(let [comparison (Test/compare 1 1) result (Test/result \"direct Test API\" 1 1 comparison) config (Test/config)] [(map? config) (Test/passed? result) (= 1 (Test/actual result)) (= 1 (Test/expected result)) (fn? Test/run) (empty? (Test/run []))])"
    :expected [true true true true true true]}
   :removed-test-forwarders
   {:source "[(nil? (resolve 'std.foundation/test-config)) (nil? (resolve 'std.foundation/test-result)) (nil? (resolve 'std.foundation/test-passed?))]"
    :expected [true true true]}})

(def foundation-implementation-calibrations
  {:persistent-vector-identity
   {:classification :implementation-calibration
    :expectation :return-same-persistent-vector
    :portable-observation :not-observable
    :reason "Reference identity is not a portable Hara predicate; hosts preserve the vec identity fast path."}
   :persistent-set-identity
   {:classification :implementation-calibration
    :expectation :return-same-persistent-set-family
    :portable-observation :not-observable
    :reason "Concrete persistent-set identity is host representation state."}
   :hal-source-origin
   {:classification :implementation-calibration
    :expectation :all-foundation-public-vars-originate-in-hal-halc-or-hbx
    :portable-observation :host-metadata
    :reason "Adapters compare profile origin metadata with the specs-owned surface."}
   :no-export-reflection
   {:classification :implementation-calibration
    :expectation :no-hara-export-annotation-or-reflective-foundation-provider
    :portable-observation :host-structure
    :reason "Reflection and host annotations are implementation structure, not guest values."}})

(def portable-fixtures
  {'std.foundation/list ['(1 2) (fn [] (list 1 2))]
   'std.foundation/vector [[1 2] (fn [] (vector 1 2))]
   'std.foundation/vec [[1 2] (fn [] (vec '(1 2)))]
   'std.foundation/set [#{1 2} (fn [] (set [1 2 1]))]
   'std.foundation/pair [[:a 1] (fn [] (vec (pair :a 1)))]
   'std.foundation/pair? [true (fn [] (pair? (first {:a 1})))]
   'std.foundation/hash-map [{:a 1} (fn [] (hash-map :a 1))]
   'std.foundation/hash-set [#{1 2} (fn [] (hash-set 1 2 1))]
   'std.foundation/atom [1 (fn [] (deref (atom 1)))]
   'std.foundation/pointer [:fixture (fn [] (IPointer/ptr-context (pointer {:context :fixture})))]
   'std.foundation/symbol ['fixture/value (fn [] (symbol "fixture" "value"))]
   'std.foundation/keyword [:fixture/value (fn [] (keyword "fixture" "value"))]
   'std.foundation/reduced [true (fn [] (reduced? (reduced 1)))]
   'std.foundation/apply [42 (fn [] (apply + 19 [23]))]
   'std.foundation/not [true (fn [] (not nil))]
   'std.foundation/boolean [true (fn [] (boolean 0))]
   'std.foundation/compare [-1 (fn [] (compare 1 2))]
   'std.foundation/reduced? [false (fn [] (reduced? 1))]
   'std.foundation/unreduced [1 (fn [] (unreduced (reduced 1)))]
