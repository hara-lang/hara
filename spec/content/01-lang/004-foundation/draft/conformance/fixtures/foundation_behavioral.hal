(ns user)

;; Executable authority for the six production Foundation namespaces. Hosts
;; consume this file and the adjacent surface ledger; they do not own cases.
(def foundation-conformance-points
  {:var-local [:canonical-invocation :valid-value :normalized-result]
   :cross-cutting [:arity-failure :type-failure :normalized-error
                   :identity-fast-path :mutation :lifecycle :cleanup
                   :source-ownership :reload :collision
                   :evaluator-compiler-agreement :browser-wasm]
   :classification [:portable :capability-specific :inventory-only]})

