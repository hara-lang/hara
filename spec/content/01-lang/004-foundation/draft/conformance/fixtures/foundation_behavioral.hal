   'std.foundation.string/wrap ["<a>" (fn [] ((std.foundation.string/wrap (fn [value left right] (str left value right))) "a" "<" ">"))]
   'std.foundation.string/wrap-compare [true (fn [] ((std.foundation.string/wrap-compare =) :a :a))]
   'std.foundation/Z [120 (fn [] ((Z (fn [recursive] (fn [value] (if (zero? value) 1 (* value (recursive (dec value))))))) 5))]
   'std.foundation/dep-get [1 (fn [] (dep-get {:a {:entry 1 :deps [:b]}} :a))]
   'std.foundation/dep-entries [#{:b} (fn [] (dep-entries {:a {:entry 1 :deps [:b]}} :a))]
   'std.foundation/dep-keys [#{:a :b} (fn [] (set (dep-keys {:a {:deps [:b]} :b {:deps []}})))]
   'std.foundation/deps-map [{:a #{:b} :b #{}} (fn [] (deps-map {:a {:deps [:b]} :b {:deps []}} [:a :b]))]
   'std.foundation/deps-resolve [{:all #{:a :b} :graph {:a #{:b} :b #{}}}
                                (fn [] (deps-resolve {:a {:deps [:b]} :b {:deps []}} [:a]))]
   'std.foundation/deps-ordered [[:b :a] (fn [] (deps-ordered {:a {:deps [:b]} :b {:deps []}} [:a]))]
   'std.foundation/dependents-direct [#{:a} (fn [] (dependents-direct {:a {:deps [:b]} :b {:deps []}} :b))]
   'std.foundation/dependents-topological [{:b #{:a}} (fn [] (dependents-topological {:a {:deps [:b]} :b {:deps []}} [:b] [:a :b]))]
   'std.foundation/dependents-all [{:b #{:a} :a #{}} (fn [] (dependents-all {:a {:deps [:b]} :b {:deps []}} :b))]
   'std.foundation/dependents-ordered [[:a :b] (fn [] (dependents-ordered {:a {:deps [:b]} :b {:deps []}} :b))]
   'std.foundation/hierarchical-sort [true (fn [] (map? (hierarchical-sort {:root #{:a :b} :a #{:c} :b #{} :c #{}})))]
   'std.foundation/macroexpand [true (fn [] (not= '(std.foundation/when true 1) (macroexpand '(std.foundation/when true 1))))]
   'std.foundation/macroexpand-all [true (fn [] (not= '(std.foundation/when true (std.foundation/when true 1))
                                                       (macroexpand-all '(std.foundation/when true (std.foundation/when true 1)))))]
   'std.foundation/schema [true (fn [] (boolean (schema [:fn [:int] :int])))]
   'std.foundation/schema-of [true (fn [] (boolean (schema-of (var inc))))]
   'std.foundation/watch-add [true (fn [] (let [cell (atom 1)]
                                            (watch-add cell :corpus (fn [key reference old new] nil))
                                            (= :corpus (ffirst (watch-list cell)))))]
   'std.foundation/watch-list [#{:corpus} (fn [] (let [cell (atom 1)]
                                                  (watch-add cell :corpus (fn [key reference old new] nil))
                                                  (set (map first (watch-list cell)))))]
   'std.foundation/watch-remove [false (fn [] (let [cell (atom 1)]
                                               (watch-add cell :corpus (fn [key reference old new] nil))
                                               (watch-remove cell :corpus)
                                               (has? (set (watch-list cell)) :corpus)))]
   'std.foundation.pretty/CanonicalVisitor [true (fn [] (instance? pretty/CanonicalVisitor (pretty/CanonicalVisitor {})))]
   'std.foundation.pretty/PrettyVisitor [true (fn [] (instance? pretty/PrettyVisitor (pretty/PrettyVisitor {})))]
   'std.foundation.pretty/format-doc ["{:a 1}" (fn [] (pretty/render (pretty/format-doc {:a 1})))]
   'std.foundation.pretty/format-doc-edn ["{:a 1}" (fn [] (pretty/render (pretty/format-doc-edn (pretty/canonical-printer) {:a 1})))]
})

(def capability-var-groups
  {:compiler/source-location
   '[std.foundation/code-line std.foundation/code-column]
   :host/clock
   '[std.foundation/time-ms std.foundation/time-ns]
   :async/stream
   '[std.foundation/stream]
   :runtime/environment
   '[std.foundation/*template-meta* std.foundation/ns-current
     std.foundation/env-snapshot std.foundation/ns-vars
     std.foundation/ns-list std.foundation/ns-info
     std.foundation/env-module std.foundation/ns-aliases
     std.foundation/ns-find std.foundation/ns-create
     std.foundation/ns-name std.foundation/ns-publics
     std.foundation/resolve std.foundation/ns-alias-state
     std.foundation/intern-var
     std.foundation/eval-in-ns std.foundation/eval
     std.foundation/apply-in std.foundation/apply-as
     std.foundation/invoke-as std.foundation/with-ns
     std.foundation/intern-in std.foundation/intern-all
     std.foundation/with-template-meta std.foundation/template-meta
     std.foundation/template-vars std.foundation/template-entries
     std.foundation/template-ensure]
   :host/filesystem '[std.foundation/read-forms]
   :printer/output
   '[std.foundation/with-out-string std.foundation.pretty/write
     std.foundation.pretty/pprint]
   :resource/lifecycle '[std.foundation/with-close]
   :test/runtime '[std.foundation/test-check]
   :async/promise
   '[std.foundation.promise/run std.foundation.promise/new
     std.foundation.promise/all std.foundation.promise/delay
     std.foundation.promise/then std.foundation.promise/catch
     std.foundation.promise/finally std.foundation.promise/cancel]
   :async/coroutine
   '[std.foundation.coroutine/create
     std.foundation.coroutine/coroutine?
     std.foundation.coroutine/status std.foundation.coroutine/resume
     std.foundation.coroutine/close std.foundation.coroutine/yield
     std.foundation.coroutine/await]})

(def foundation-classification-reasons
  {:portable/deterministic
   "Deterministic source-owned HAL behavior with a canonical invocation."
   :capability/provider
   "Execution requires the named capability; adapters report it explicitly."
   :inventory/requires-normalization
   "The Var remains on the closed surface, but a stable cross-runtime observation must be specified before promotion."})

(def portable-vars (vec (keys portable-fixtures)))

(def capability-vars
  (reduce
   (fn [result capability]
     (reduce conj result (get capability-var-groups capability)))
   []
   (keys capability-var-groups)))

(def explicitly-classified-vars
  (set (concat portable-vars capability-vars)))

(def inventory-vars
  (vec
   (filter
    (fn [variable] (not (has? explicitly-classified-vars variable)))
    foundation-source-vars)))

(def inventory-reasons
  {'std.foundation/Y
   {:classification :inventory-only
    :reason :nonterminating-under-eager-evaluation
    :review "The classical Y combinator intentionally diverges under the ordinary eager evaluator. Its declaration, metadata, and arity are closure-checked; Z owns the executable fixed-point behavior."}})

(defn normalized-error-class
  [error]
  (let [data (ex-data error)
        declared (get data :ex/class)
        native (Exception/class error)]
    (cond
      (keyword? declared) declared
      (keyword? native) native
      :else :foundation/error)))

(defn normalized-outcome
  [thunk]
  (try
    [:value (thunk)]
    (catch Throwable error
      [:error (normalized-error-class error) (ex-message error)])))

(defn foundation-calibration-results
  []
  (reduce-kv
   (fn [results id calibration]
     (let [outcome (normalized-outcome
                    (fn [] (eval (read-string (:source calibration)))))
           status (first outcome)
           actual (second outcome)
           error-message (get outcome 2)]
       (conj results
             {:id id
              :source (:source calibration)
              :expected (:expected calibration)
              :actual actual
              :status status
              :error-message error-message
              :pass (and (= :value status)
                         (= (:expected calibration) actual))})))
   []
   foundation-calibration-snippets))

(defn portable-var-result
  [variable]
  (let [fixture (get portable-fixtures variable)]
    (try
      (let [expected (first fixture)
            actual ((second fixture))]
        {:var variable :classification :portable
         :pass (= expected actual) :expected expected :actual actual})
      (catch Throwable error
        {:var variable :classification :portable :pass false
         :error-class (normalized-error-class error)
         :error-message (ex-message error)}))))

(defn foundation-corpus-valid?
  []
  (let [surface-set (set foundation-source-vars)
        classified (concat portable-vars capability-vars inventory-vars)]
    (and
     (= (count foundation-source-vars) (count surface-set))
     (= (count classified) (count (set classified)))
     (= surface-set (set classified))
     (every? (fn [variable] (not (nil? (get portable-fixtures variable))))
             portable-vars)
     (every? keyword? (keys capability-var-groups))
     (every? (fn [variable] (not (nil? (get inventory-reasons variable))))
             inventory-vars)
     (= (set inventory-vars) (set (keys inventory-reasons))))))

(defn foundation-namespace-closure-report
  [registered-namespaces]
  (let [registered (set registered-namespaces)
        specified (set foundation-source-namespaces)
        missing (vec (filter (fn [namespace-symbol] (not (has? registered namespace-symbol))) foundation-source-namespaces))
        extra (vec (filter (fn [namespace-symbol] (not (has? specified namespace-symbol))) registered-namespaces))]
    {:pass (and (empty? missing) (empty? extra))
     :registered (count registered) :specified (count specified)
     :missing missing :extra extra}))

(defn foundation-closure-report
  [live-vars]
  (let [live (set live-vars)
        specified (set foundation-source-vars)
        missing (vec (filter (fn [variable] (not (has? live variable))) foundation-source-vars))
        extra (vec (filter (fn [variable] (not (has? specified variable))) live-vars))]
    {:pass (and (empty? missing) (empty? extra))
     :live (count live) :specified (count specified)
     :missing missing :extra extra}))

(defn foundation-boundary-cases
  []
  [{:id :arity-failure
    :points [:arity-failure :normalized-error]
    :expected :error
    :actual (first (normalized-outcome (fn [] (inc))))}
   {:id :type-failure
    :points [:type-failure :normalized-error]
    :expected :error
    :actual (first (normalized-outcome (fn [] (inc "bad"))))}
   {:id :immutable-source
    :points [:identity-fast-path :mutation]
    :expected [[1] [1 2]]
    :actual (let [source [1]] [source (conj source 2)])}
   {:id :mutable-round-trip
    :points [:mutation :valid-value]
    :expected [1 2]
    :actual (to-persistent (to-mutable (vec [1 2])))}
   {:id :promise-lifecycle
    :points [:lifecycle :cleanup]
    :expected [:fulfilled 1]
    :actual (let [value (promise/from 1)]
              [(promise/state value) (promise/value value)])}])

(defn foundation-boundary-results
  []
  (vec
   (map
    (fn [case]
      (assoc case :pass (= (:expected case) (:actual case))))
    (foundation-boundary-cases))))

(defn foundation-profile-report
  []
  (let [results (vec (map portable-var-result portable-vars))
        passed (count (filter :pass results))
        failed (- (count results) passed)]
    {:portable (count portable-vars)
     :capability-specific (count capability-vars)
     :inventory-only (count inventory-vars)
     :passed passed
     :failed failed
     :skipped (+ (count capability-vars) (count inventory-vars))
     :capability-exclusions capability-var-groups
     :inventory-exclusions inventory-reasons
     :results results}))

(defn foundation-host-assertion-report
  []
  (let [boundaries (foundation-boundary-results)
        calibrations (foundation-calibration-results)
        profile (foundation-profile-report)]
    {:corpus-valid (foundation-corpus-valid?)
     :calibration-results calibrations
     :calibration-passed (count (filter :pass calibrations))
     :calibration-failed (count (filter (fn [case] (not (:pass case))) calibrations))
     :boundary-results boundaries
     :boundary-passed (count (filter :pass boundaries))
     :boundary-failed (count (filter (fn [case] (not (:pass case))) boundaries))
     :profile profile
     :calibration-snippets foundation-calibration-snippets
     :implementation-calibrations foundation-implementation-calibrations}))

(defn foundation-summary-report
  []
  (let [report (foundation-host-assertion-report)
        profile (:profile report)]
    {:surface (count foundation-source-vars)
     :classified (+ (:portable profile)
                    (:capability-specific profile)
                    (:inventory-only profile))
     :corpus-valid (:corpus-valid report)
     :calibration-failed (:calibration-failed report)
     :boundary-failed (:boundary-failed report)
     :portable (:portable profile)
     :capability-specific (:capability-specific profile)
     :inventory-only (:inventory-only profile)
     :passed (:passed profile)
     :failed (:failed profile)
     :skipped (:skipped profile)}))

(foundation-summary-report)
