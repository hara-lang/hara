{:document/id :hara/source-gates
 :document/type :hara/conformance
 :document/status :alpha

 :source/extensions [".hal"]

 :source/rules
 [{:rule/id :hara.source/no-requiring-resolve
   :rule/severity :error
   :rule/pattern "requiring-resolve"
   :rule/message "Dynamic loading must use an explicit namespace alias or a registered loader."}

  {:rule/id :hara.source/no-clojure-namespace
   :rule/severity :error
   :rule/pattern "clojure\\."
   :rule/message "Hara source must use Foundation APIs rather than Clojure namespaces."}

  {:rule/id :hara.source/foundation-builtin-alias
   :rule/severity :error
   :rule/pattern "\\[std\\.foundation\\.(string|promise|bytes|socket|file|coroutine|edn|json|set|pretty|host|kernel|os|crypto)\\s"
   :rule/message "Use builtin aliases such as str/*, co/*, json/*, bytes/*, and host/*; do not require Foundation builtin libraries."}

  {:rule/id :hara.source/no-native-reduce-in
   :rule/severity :error
   :rule/path-pattern "^core/.*"
   :rule/pattern "(std\\.native\\.)?Base/reduce-in"
   :rule/message "reduce-in is portable HAL over collection protocols and must not become a Base native method."}

  {:rule/id :hara.source/lang-canonical-root
   :rule/severity :error
   :rule/path-pattern "/core/lib/src-lang/lang/"
   :rule/message "lang.* libraries belong under core/lib/src/lang/."}]

 :source/evaluation
 {:evaluation/runtime :hara
  :evaluation/pre-write true
  :evaluation/post-write true
  :evaluation/registry-only-loading true}}
