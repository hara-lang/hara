{:document/id :hara/source-gates
 :document/type :hara/conformance
 :document/status :alpha

 :source/extensions [".hal"]

 :source/rules
 [{:rule/id :hara.source/no-requiring-resolve
   :rule/severity :error
   :rule/pattern "requiring-resolve"
   :rule/message "Dynamic loading must use an explicit namespace alias or a registered loader."}

  {:rule/id :hara.source/no-clojure-namespace
   :rule/severity :error
   :rule/pattern "clojure\\."
   :rule/message "Hara source must use Foundation APIs rather than Clojure namespaces."}

  {:rule/id :hara.source/no-ex-info
   :rule/severity :error
   :rule/pattern "\\bex-info\\b"
   :rule/message "Construct exceptions with (ex code data & key-value-pairs); ex-info is not a Foundation API."}

  {:rule/id :hara.source/foundation-builtin-alias
   :rule/severity :error
   :rule/pattern "\\[std\\.foundation\\.(string|promise|bytes|socket|file|coroutine|edn|json|set|pretty|host|kernel|os|crypto)(?:\\s|\\])"
   :rule/message "Foundation builtin aliases are preloaded; use str/*, co/*, json/*, bytes/*, and host/* rather than requiring their namespaces."}

  {:rule/id :hara.source/foundation-root-prelude
   :rule/severity :error
   :rule/pattern "\\[std\\.foundation(?:\\s|\\])"
   :rule/message "std.foundation is preloaded in every namespace; remove its explicit require and use the default prelude."}

  {:rule/id :hara.source/blank-primitive-only
   :rule/severity :error
   :rule/pattern "(?ms)\\A(?!.*^\\s*\\(ns\\s+std\\.foundation\\.(?:bytes|coroutine|promise)\\b).*^\\s*\\(:config\\s+\\{[^}]*:blank\\s+true"
   :rule/message ":config {:blank true} is reserved for primitive Foundation boundary namespaces; ordinary namespaces use the default prelude."}

  {:rule/id :hara.source/native-method-short-form
   :rule/severity :error
   :rule/pattern "std\\.native\\.[A-Za-z_][A-Za-z0-9_.-]*/[A-Za-z_][A-Za-z0-9_?!*+<>=:-]*"
   :rule/message "Native types are preloaded; use File/read, Promise/all, and other short forms rather than std.native.*/<>."}

  {:rule/id :hara.source/protocol-method-short-form
   :rule/severity :error
   :rule/pattern "std\\.protocol\\.[A-Za-z_][A-Za-z0-9_.-]*/[A-Za-z_][A-Za-z0-9_?!*+<>=:-]*"
   :rule/message "Protocols are preloaded; use IReset/reset, IAssoc/assoc, and other short forms rather than std.protocol.*.*/<>."}

  {:rule/id :hara.source/no-native-reduce-in
   :rule/severity :error
   :rule/path-pattern "^core/.*"
   :rule/pattern "(std\\.native\\.)?Base/reduce-in"
   :rule/message "reduce-in is portable HAL over collection protocols and must not become a Base native method."}

  {:rule/id :hara.source/lang-canonical-root
   :rule/severity :error
   :rule/path-pattern "/core/lib/src-lang/lang/"
   :rule/message "lang.* libraries belong under core/lib/src/lang/."}]

 :source/evaluation
 {:evaluation/runtime :hara
  :evaluation/pre-write true
  :evaluation/post-write true
  :evaluation/registry-only-loading true}}
