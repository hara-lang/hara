{:document/id :xt/substrate-request
 :document/type :xt-substrate-spec
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "XTalk substrate request contract"
 :document/summary
 "Defines the actual handler entries, promise normalization, pending map, local and transport request paths, and response settlement."

 :spec/conforms-to
 {:spec/id :xt/substrate-metaspec :spec/version "0.0.0-alpha"}
 :spec/family :xt/substrate
 :spec/depends-on
 [:xt/substrate-base :xt/substrate-frame :xt/substrate-node]

 :source/modules
 [{:module/id :xt.substrate.request/base-request
   :module/namespace "xt.substrate.base-request"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate/base_request.clj"}
  {:module/id :xt.substrate.request/base-util
   :module/namespace "xt.substrate.base-util"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate/base_util.clj"}
  {:module/id :xt.substrate.request/root
   :module/namespace "xt.substrate"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate.clj"}]

 :request/records
 [{:record/name "NodeHandlerEntry"
   :record/fields ["id" "fn" "meta"]}
  {:record/name "PendingEntry"
   :record/fields ["resolve" "reject" "request" "meta"]}]

 :request/handler-signature
 ["NodeSpace" "args-or-nil" "NodeFrame" "EventNode"]

 :request/symbols
 ["RequestResolve" "RequestReject" "RequestHandler"
  "ensure-promise" "add-pending" "remove-pending" "settle-pending"
  "invoke-handler" "response-body" "pending-await"
  "transport-request-target" "request-context-merge"
  "response-ok" "response-error" "register-handler"
  "unregister-handler" "get-handler" "list-handlers"
  "request" "receive-request" "receive-response"]

 :spec/behavior
 [{:behavior/id :xt.substrate.request/promise-normalization
   :behavior/text "ensure-promise returns native promises and thenables unchanged and wraps other values with promise-run."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.request/pending
   :behavior/text "add-pending stores resolve, reject, request, and metadata under request.id; remove-pending deletes and returns the entry; settle-pending removes by response.reply_to and resolves data for ok or rejects with the response."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.request/local-selection
   :behavior/text "A request is local when metadata local is truthy or no transport exists; otherwise an explicit transport_id or the first sorted transport id is selected."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.request/local-invoke
   :behavior/text "invoke-handler looks up the action, errors when missing, ensures the request space, calls the handler with space, args, frame, and node, and promise-normalizes its result."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.request/remote
   :behavior/text "The transport path creates a promise, stores a pending entry, sends the request frame, and removes and rejects the pending entry when sending throws or rejects."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.request/inbound
   :behavior/text "receive-request merges transport_id into request metadata, invokes the handler, and returns or sends an ok/error response; receive-response settles pending state and resolves to the response frame."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.request/no-timeout-cancel
   :behavior/text "The pinned implementation defines neither request timeouts nor cancellation frames."
   :behavior/evidence :evidence/source-only}]

