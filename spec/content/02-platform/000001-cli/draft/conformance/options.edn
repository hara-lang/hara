{:conformance/id :hara.cli/options
 :conformance/version "0.1.0"
 :conformance/cases
 [{:case/id :hara.cli.option/separate-value
   :case/argv ["--project" "demo" "project" "check"]
   :case/expected {:option/project "demo"}}
  {:case/id :hara.cli.option/equals-value
   :case/argv ["--project=demo" "project" "check"]
   :case/expected {:option/project "demo"}}
  {:case/id :hara.cli.option/terminator
   :case/argv ["eval" "--" "(- 2 1)"]
   :case/expected {:route/arguments ["(- 2 1)"]}}
  {:case/id :hara.cli.option/unknown
   :case/argv ["--ambient-authority" "repl"]
   :case/expected {:outcome/id :hara.cli.outcome/usage-error}}
  {:case/id :hara.cli.option/offline-server
   :case/argv ["--offline" "server"]
   :case/expected {:outcome/id :hara.cli.outcome/usage-error}}]}
