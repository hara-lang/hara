{:document/id :hara/harp
 :document/type :hara/tap-protocol
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara archive package format"
 :document/summary
 "Normative deterministic .harp archive, generated package.edn index, integrity, extraction and read-only mounting contract."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.0.0-alpha"}

 :platform/roles
 [{:role/id :hara.harp.role/builder
   :role/summary "Builds an archive from one project.edn declaration and resolved inputs."}
  {:role/id :hara.harp.role/verifier
   :role/summary "Validates structure, generated metadata, paths, hashes and compatibility."}
  {:role/id :hara.harp.role/installer
   :role/summary "Extracts verified bytes into content-addressed storage."}
  {:role/id :hara.harp.role/runtime
   :role/summary "Mounts installed package roots without mutating archive contents."}]

 :platform/entities
 [{:entity/id :hara.harp/archive
   :entity/summary "Deterministic ZIP-compatible file with the .harp extension."
   :entity/fields [:harp/format :package.edn :project.edn :project.lock.edn
                   :files :integrity]}
  {:entity/id :hara.harp/package-index
   :entity/path "package.edn"
   :entity/generated true
   :entity/summary "Generated immutable index of the exact archive bytes."
   :entity/fields [:harp/format :package :compatibility :files :resources
                   :extensions :remote-artifacts :integrity]}
  {:entity/id :hara.harp/content-root
   :entity/summary "Read-only extracted tree addressed by the archive digest."
   :entity/fields [:archive-sha256 :root :verified-at]}]

 :platform/operations
 [{:operation/id :hara.harp.operation/build
   :operation/role :hara.harp.role/builder
   :operation/input :hara.package/project
   :operation/output :hara.harp/archive
   :operation/failures [:invalid-project :unresolved-lock :missing-input
                        :unsafe-path :duplicate-path :nondeterministic-output]}
  {:operation/id :hara.harp.operation/verify
   :operation/role :hara.harp.role/verifier
   :operation/input :hara.harp/archive
   :operation/output :hara.harp/verified-archive
   :operation/failures [:invalid-zip :missing-package-index :hash-mismatch
                        :unsafe-path :duplicate-namespace :unsupported-format]}
  {:operation/id :hara.harp.operation/install
   :operation/role :hara.harp.role/installer
   :operation/input :hara.harp/verified-archive
   :operation/output :hara.harp/content-root
   :operation/failures [:storage-error :archive-conflict :extraction-error]}]

 :platform/invariants
 [{:requirement/id :hara.harp/generated-index
   :requirement/level :must
   :requirement/text "package.edn is generated by the package builder from project.edn, the resolved lock and the exact archive entries; contributors do not author it."}
  {:requirement/id :hara.harp/project-authority
   :requirement/level :must
   :requirement/text "The archive carries the exact project.edn used to build it, and no other authored package, build or extension manifest is permitted."}
  {:requirement/id :hara.harp/deterministic
   :requirement/level :must
   :requirement/text "Identical declared inputs produce byte-identical archives using sorted UTF-8 paths, normalized timestamps, fixed permissions and fixed compression settings."}
  {:requirement/id :hara.harp/path-safety
   :requirement/level :must
   :requirement/text "Archive paths are normalized relative UTF-8 paths; absolute paths, parent traversal, symbolic links and duplicate entries are rejected."}
  {:requirement/id :hara.harp/file-integrity
   :requirement/level :must
   :requirement/text "package.edn records the SHA-256 digest and byte size of every payload entry and a deterministic tree digest over path and bytes."}
  {:requirement/id :hara.harp/embedded-extensions
   :requirement/level :must
   :requirement/text "Normalized extension declarations are embedded in package.edn under :extensions and resolve only package-relative modules and assets."}
  {:requirement/id :hara.harp/offline
   :requirement/level :must
   :requirement/text "A mirrored release archive contains every runtime byte required by its declared targets and can be verified and mounted without network access."}
  {:requirement/id :hara.harp/read-only
   :requirement/level :must
   :requirement/text "Installed package roots are immutable; updates install a different content-addressed root rather than modifying an existing root."}]

 :platform/conformance
 [{:conformance/id :hara.harp/archives
   :conformance/path "conformance/archives.edn"}]}
