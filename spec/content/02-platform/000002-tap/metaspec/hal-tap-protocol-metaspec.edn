{:document/id :hara/tap-protocol-metaspec
 :document/type :hara/artifact-specification
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara tap protocol meta-specification"
 :document/summary
 "Normative document model for Git-authoritative Hara platform protocols."

 :spec/conforms-to {:spec/id :hara/artifact-metaspec
                    :spec/version "0.0.0-alpha"}
 :spec/artifact-kind :hara/tap-protocol-specification

 :spec/forms
 [{:form/id :hara.tap.protocol/document
   :form/head :platform/roles
   :form/cardinality :one
   :form/grammar [:platform/roles :platform/entities :platform/operations
                  :platform/invariants :platform/conformance]}]

 :spec/entities
 [{:entity/id :hara.tap.protocol/role
   :entity/schema :hara.tap.protocol.schema/role}
  {:entity/id :hara.tap.protocol/entity
   :entity/schema :hara.tap.protocol.schema/entity}
  {:entity/id :hara.tap.protocol/operation
   :entity/schema :hara.tap.protocol.schema/operation}
  {:entity/id :hara.tap.protocol/invariant
   :entity/schema :hara.tap.protocol.schema/invariant}]

 :spec/relations
 [{:relation/id :hara.tap.protocol/operation-role
   :relation/from :hara.tap.protocol/operation
   :relation/to :hara.tap.protocol/role
   :relation/cardinality :many-to-one}
  {:relation/id :hara.tap.protocol/operation-entity
   :relation/from :hara.tap.protocol/operation
   :relation/to :hara.tap.protocol/entity
   :relation/cardinality :many-to-many}]

 :spec/codecs
 [{:codec/id :hara.tap.protocol/canonical-edn
   :codec/from :hara/tap-protocol-specification
   :codec/to :edn/data
   :codec/laws [:hara.tap.protocol.law/data-only
                :hara.tap.protocol.law/deterministic-bytes]}]

 :spec/checkers
 [{:checker/id :hara.tap.protocol/structure
   :checker/input :hara/tap-protocol-specification
   :checker/output :hara/verification-report}
  {:checker/id :hara.tap.protocol/references
   :checker/input :hara/tap-protocol-specification
   :checker/output :hara/verification-report}]

 :spec/laws
 [{:law/id :hara.tap.protocol.law/data-only
   :law/expression
   "Normative documents and protocol values contain ordinary EDN data only."}
  {:law/id :hara.tap.protocol.law/deterministic-bytes
   :law/expression
   "Canonical protocol EDN is UTF-8, LF-terminated and byte-deterministic."}
  {:law/id :hara.tap.protocol.law/git-authority
   :law/expression
   "An accepted official record exists exactly when it is reachable from the protected authoritative Git branch."}]

 :spec/conformance
 [{:conformance/id :hara.tap.protocol/document-cases
   :conformance/path "conformance/documents.edn"}
  {:conformance/id :hara.tap.protocol/canonical-edn-cases
   :conformance/path "conformance/canonical-edn.edn"}]

 :meta/document-schema
 {:schema/id :hara.tap.protocol.schema/document
  :schema/type :map
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to
   :platform/roles :platform/entities :platform/operations
   :platform/invariants :platform/conformance]
  :schema/properties
  {:document/id {:schema/ref :hara.tap.protocol.schema/qualified-keyword}
   :document/type {:schema/value :hara/tap-protocol}
   :document/version {:schema/ref :hara.tap.protocol.schema/version}
   :document/status {:schema/ref :hara.tap.protocol.schema/status}
   :document/title {:schema/ref :hara.tap.protocol.schema/string}
   :document/summary {:schema/ref :hara.tap.protocol.schema/string}
   :spec/conforms-to {:schema/ref :hara.tap.protocol.schema/spec-reference}
   :platform/roles {:schema/items :hara.tap.protocol.schema/role}
   :platform/entities {:schema/items :hara.tap.protocol.schema/entity}
   :platform/operations {:schema/items :hara.tap.protocol.schema/operation}
   :platform/invariants {:schema/items :hara.tap.protocol.schema/invariant}
   :platform/conformance {:schema/items :hara.tap.protocol.schema/conformance}}}

 :meta/schemas
 [{:schema/id :hara.tap.protocol.schema/qualified-keyword
   :schema/type :keyword
   :schema/constraint :qualified}
  {:schema/id :hara.tap.protocol.schema/string
   :schema/type :string
   :schema/min-length 1}
  {:schema/id :hara.tap.protocol.schema/version
   :schema/type :string
   :schema/pattern "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
  {:schema/id :hara.tap.protocol.schema/status
   :schema/type :enum
   :schema/values [:draft :candidate :stable :deprecated]}
  {:schema/id :hara.tap.protocol.schema/spec-reference
   :schema/type :map
   :schema/required [:spec/id :spec/version]}
  {:schema/id :hara.tap.protocol.schema/role
   :schema/type :map
   :schema/required [:role/id :role/summary]}
  {:schema/id :hara.tap.protocol.schema/entity
   :schema/type :map
   :schema/required [:entity/id :entity/summary :entity/fields]}
  {:schema/id :hara.tap.protocol.schema/operation
   :schema/type :map
   :schema/required [:operation/id :operation/role :operation/input
                     :operation/output :operation/failures]}
  {:schema/id :hara.tap.protocol.schema/invariant
   :schema/type :map
   :schema/required [:requirement/id :requirement/level :requirement/text]}
  {:schema/id :hara.tap.protocol.schema/conformance
   :schema/type :map
   :schema/required [:conformance/id :conformance/path]}]

 :meta/cross-references
 [{:reference/id :hara.tap.protocol.reference/operation-role
   :reference/from :operation/role
   :reference/to :role/id}]

 :meta/requirements
 [{:requirement/id :hara.tap.protocol/qualified-identifiers
   :requirement/level :must
   :requirement/text "Roles, entities, operations, invariants and conformance suites use stable qualified identifiers."}
  {:requirement/id :hara.tap.protocol/data-only
   :requirement/level :must
   :requirement/text "Normative protocol values are ordinary data and are never evaluated as HAL."}
  {:requirement/id :hara.tap.protocol/git-authoritative
   :requirement/level :must
   :requirement/text "Service databases, indexes and object stores must not supersede accepted authoritative Git records."}]

 :metaspec/generation
 {:generation/input
  {:input/type :hara.tap.protocol/generation-request
   :input/required [:request/roles :request/entities :request/operations
                    :request/invariants :request/conformance]}
  :generation/output
  {:output/type :hara/tap-protocol
   :output/format :edn
   :output/required [:platform/roles :platform/entities
                     :platform/operations :platform/invariants
                     :platform/conformance]}
  :generation/process
  [:generate-draft :lint :repair-lint-findings :verify
   :repair-verification-findings :emit-canonical-edn]
  :generation/acceptance
  {:acceptance/status :pass
   :acceptance/required-summary
   {:summary/fail 0 :summary/unknown 0 :summary/blocked 0}
   :acceptance/no-unresolved-references true
   :acceptance/canonical-edn true}}}
