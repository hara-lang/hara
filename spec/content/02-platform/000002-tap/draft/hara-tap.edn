{:document/id :hara/tap
 :document/type :hara/tap-protocol
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara federated tap protocol"
 :document/summary
 "Normative trust, authority, discovery and role contract for independently operated Hara taps."

 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.0.0-alpha"}

 :platform/roles
 [{:role/id :hara.tap.role/identity
   :role/summary "Publishes signed public authorization policy."}
  {:role/id :hara.tap.role/registry
   :role/summary "Publishes accepted package and asset release records."}
  {:role/id :hara.tap.role/object-store
   :role/summary "Serves immutable digest-addressed bytes."}
  {:role/id :hara.tap.role/mirror
   :role/summary "Replicates exact registry revisions and objects."}]

 :platform/entities
 [{:entity/id :hara.tap/tap
   :entity/summary "A named identity, registry and object-distribution trust domain."
   :entity/fields [:tap/id :tap/identity :tap/registry :tap/objects
                   :tap/root-key-sha256]}
  {:entity/id :hara.tap/discovery
   :entity/summary "Canonical endpoints and trust material for a tap."
   :entity/fields [:discovery/tap :discovery/identity :discovery/registry
                   :discovery/root-key-sha256 :discovery/mirrors]}]

 :platform/operations
 [{:operation/id :hara.tap.operation/bootstrap
   :operation/role :hara.tap.role/identity
   :operation/input :hara.tap/tap
   :operation/output :hara.tap/discovery
   :operation/failures [:unknown-tap :invalid-fingerprint]}
  {:operation/id :hara.tap.operation/verify
   :operation/role :hara.tap.role/registry
   :operation/input :hara.tap/discovery
   :operation/output :hara/verification-report
   :operation/failures [:untrusted-root :invalid-policy :divergent-registry]}]

 :platform/invariants
 [{:requirement/id :hara.tap/git-authority
   :requirement/level :must
   :requirement/text "Accepted identity and release records are authoritative only when reachable from the protected configured Git branch."}
  {:requirement/id :hara.tap/federated
   :requirement/level :must
   :requirement/text "A client may trust independently operated taps and must not require the Hara tap for unrelated coordinates."}
  {:requirement/id :hara.tap/pinned-root
   :requirement/level :must
   :requirement/text "A tap is trusted through an out-of-band SHA-256 fingerprint of its identity root public key."}
  {:requirement/id :hara.tap/no-ledger
   :requirement/level :must-not
   :requirement/text "Tap authority depends on a blockchain, consensus system, append-only ledger or executable state chain."}
  {:requirement/id :hara.tap/derived-services
   :requirement/level :must
   :requirement/text "Service databases, search indexes, object stores and websites are replaceable projections of verified Git records."}
  {:requirement/id :hara.tap/official-domains
   :requirement/level :must
   :requirement/text "The official deployment uses id.hara-lang.org and packages.hara-lang.org for trust and code, plus assets.hara-lang.org as an isolated content delivery origin."}]

 :platform/conformance
 [{:conformance/id :hara.tap/discovery
   :conformance/path "conformance/discovery.edn"}
  {:conformance/id :hara.tap/trust
   :conformance/path "conformance/trust.edn"}]}
