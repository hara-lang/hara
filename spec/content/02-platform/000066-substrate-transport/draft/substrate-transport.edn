 :spec/behavior
 [{:behavior/id :xt.substrate.transport/send
   :behavior/text "transport-send errors when the id is absent or send_fn is nil and otherwise promise-normalizes send_fn(frame)."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.transport/attach
   :behavior/text "attach-transport wraps non-NodeTransport values, stores the transport, registers a router connection, optionally starts it with a receive listener, and stores the start result as listener."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.transport/detach
   :behavior/text "detach-transport removes the transport, unregisters the router connection and subscriptions, optionally invokes stop_fn with listener, and resolves to the transport or nil."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.transport/memory
   :behavior/text "The memory module supplies raw object endpoints, JSON text endpoints, pairs, directed networks, and link-pair mutation."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.transport/browser
   :behavior/text "The browser module adapts MessagePort, Worker, SharedWorker, and self endpoints and supplies generated worker source and connection helpers."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.transport/websocket
   :behavior/text "The WebSocket module normalizes URLs and events, tracks open/error/close state, waits for readiness, and provides source and endpoint constructors."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.transport/no-generalized-profile
   :behavior/text "The pinned source does not define lifecycle states, capability descriptors, codec negotiation, HTA, structured-clone, transferable, or generic profile records."
   :behavior/evidence :evidence/source-only}]

