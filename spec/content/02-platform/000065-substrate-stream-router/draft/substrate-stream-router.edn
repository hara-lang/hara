{:document/id :xt/substrate-stream-router
 :document/type :xt-substrate-spec
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "XTalk substrate pub/sub and router contract"
 :document/summary
 "Defines the actual trigger, connection, subscription, publish, routing, and control-frame behavior."

 :spec/conforms-to
 {:spec/id :xt/substrate-metaspec :spec/version "0.0.0-alpha"}
 :spec/family :xt/substrate
 :spec/depends-on
 [:xt/substrate-base :xt/substrate-frame :xt/substrate-node
  :xt/substrate-request]

 :source/modules
 [{:module/id :xt.substrate.stream/pubsub
   :module/namespace "xt.substrate.base-pubsub"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate/base_pubsub.clj"}
  {:module/id :xt.substrate.stream/router
   :module/namespace "xt.substrate.base-router"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate/base_router.clj"}
  {:module/id :xt.substrate.stream/util
   :module/namespace "xt.substrate.base-util"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate/base_util.clj"}]

 :router/records
 [{:record/name "RouterConnectionEntry" :record/fields ["id" "meta"]}
  {:record/name "RouterSubscriptionEntry" :record/fields ["id" "meta"]}
  {:record/name "RouterState"
   :record/fields ["connections" "subscriptions"]
   :record/subscription-shape
   ["space-id" "signal" "transport-id" "RouterSubscriptionEntry"]}]

 :router/symbols
 ["RouterSignalSubscriptions" "RouterSpaceSubscriptions"
  "RouterSubscriptions" "subscribe-frame" "unsubscribe-frame" "ensure-router"
  "get-connections" "get-subscriptions" "register-connection"
  "prune-subscription-signal-loop" "prune-subscription-space-loop"
  "unregister-connection" "ensure-space-subscriptions"
  "ensure-signal-subscriptions" "add-subscription"
  "remove-subscription" "list-subscriptions" "target-ids"
  "receive-subscribe" "receive-unsubscribe"]
 :stream/symbols
 ["subscribe" "unsubscribe" "invoke-trigger" "receive-publish"
  "register-trigger" "get-trigger" "unregister-trigger"
  "publish" "stream-route-loop" "route-stream" "broadcast-transport"
  "receive-frame"]

 :spec/behavior
 [{:behavior/id :xt.substrate.router/connection-cleanup
   :behavior/text "unregister-connection deletes the connection and recursively removes that transport id from all subscription maps, pruning empty signal and space maps."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.router/subscription
   :behavior/text "One subscription entry is stored per space, signal, and transport id; adding replaces that transport entry and removing prunes empty maps."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.router/list
   :behavior/text "list-subscriptions returns the whole map when space is nil, the space map when signal is nil, or sorted transport ids for a signal."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.stream/trigger
   :behavior/text "invoke-trigger returns a resolved nil promise when absent; otherwise it ensures the space, invokes fn with space, stream, and node, and wraps non-native-promise output."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.stream/publish-order
   :behavior/text "publish creates a stream frame, awaits local receive-publish, then sequentially routes to sorted subscribed transport ids while excluding metadata transport_id."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.stream/no-delivery-policy
   :behavior/text "The pinned router has no ordered/latest/best-effort modes, capacity, overflow, or durable delivery contract."
   :behavior/evidence :evidence/source-only}]

