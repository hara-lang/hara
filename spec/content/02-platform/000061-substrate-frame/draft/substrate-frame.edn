  ["kind" "id" "space" "meta" "action" "args" "reply_to"
   "status" "data" "error" "signal" "cause"]
  :record/required-by-spec ["kind" "id" "space"]
  :record/no-version-field true
  :record/no-source-target-fields true}

 :frame/constants
 {:constant/kinds
  [["KIND_REQUEST" "request"] ["KIND_RESPONSE" "response"]
   ["KIND_STREAM" "stream"] ["KIND_SUBSCRIBE" "subscribe"]
   ["KIND_UNSUBSCRIBE" "unsubscribe"]]
  :constant/statuses
  [["STATUS_OK" "ok"] ["STATUS_ERROR" "error"]]
  :constant/node-space ["SPACE_NODE" "__NODE__"]}

 :frame/symbols
 ["rand-id" "frame" "request-frame" "response-frame"
  "response-ok-frame" "response-error-frame" "stream-frame"
  "request-frame?" "response-frame?" "stream-frame?"
  "frame-kind?" "valid-frame?" "normalize-error" "normalize-frame"
  "encode-frame" "decode-frame"]

 :spec/behavior
 [{:behavior/id :xt.substrate.frame/defaults
   :behavior/text "frame defaults a nil space to __NODE__ and nil metadata to an empty object; constructors permit metadata id overrides."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.frame/json-kinds
   :behavior/text "JSON validation recognizes request, response, stream, subscribe, and unsubscribe only."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.frame/json-shape
   :behavior/text "Validation requires string kind, id, and space; optional metadata must be an object; request requires action and optional array args; response requires reply_to and status; other supported kinds require signal."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.frame/error-normalization
   :behavior/text "Only error responses normalize error values before JSON encoding; strings and other values become objects containing message, while objects are cloned and given message when absent."
   :behavior/evidence :evidence/source-and-test}]

