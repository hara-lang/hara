{:document/id :hara/extension
 :document/type :hara/tap-protocol
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara extension declaration contract"
 :document/summary
 "Normative project.edn declarations for WebAssembly Components, WIT worlds, Hara value mappings, capabilities and remote artifact delivery."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.0.0-alpha"}

 :platform/roles
 [{:role/id :hara.extension.role/author
   :role/summary "Declares extension intent under :project/extensions in project.edn."}
  {:role/id :hara.extension.role/builder
   :role/summary "Builds, validates and normalizes extension bytes into package.edn."}
  {:role/id :hara.extension.role/host
   :role/summary "Selects a compatible target and enforces declared capabilities."}
  {:role/id :hara.extension.role/provider
   :role/summary "Implements a declared component.v1 callable namespace."}]

 :platform/entities
 [{:entity/id :hara.extension/project-declaration
   :entity/location [:project/extensions :namespace]
   :entity/summary "Authored extension declaration within project.edn."
   :entity/fields [:root :provider :abi :module :world :wit :imports :assets
                   :exports :capabilities :host-calls :handles]}
  {:entity/id :hara.extension/package-declaration
   :entity/location [:package.edn :extensions :namespace]
   :entity/generated true
   :entity/summary "Archive-relative normalized extension declaration."
   :entity/fields [:root :provider :abi :module :world :wit :imports :assets
                   :exports :capabilities :host-calls :handles :files]}
  {:entity/id :hara.extension/remote-artifact
   :entity/location [:project/remote-artifacts :install-path]
   :entity/summary "Digest-pinned HTTPS input mirrored or resolved before packaging."
   :entity/fields [:url :sha256 :size :media-type :policy]}
  {:entity/id :hara.extension/target
   :entity/summary "Host-selected module entry point."
   :entity/fields [:module :runtime]}
  {:entity/id :hara.extension/export
   :entity/summary "Generated Hara Var signature for a provider operation."
   :entity/fields [:args :returns :async]}
  {:entity/id :hara.extension/wit-world
   :entity/summary "Integrity-pinned WIT package and selected world that determine an extension callable surface."
   :entity/fields [:world :wit]}
  {:entity/id :hara.extension/import
   :entity/summary "An exact Component import vector admitted only through approved Hara capabilities."
   :entity/fields [:imports :capabilities]}]

 :extension/providers
 {:wasm {:abis [:component.v1]
         :summary "A standard WebAssembly Component with a resolved WIT world. Core and HTA are Hara value-mapping profiles, not artifact providers or alternate ABIs."}}

 :extension/wit
 {:component/abi :component.v1
  :wasi/profile "wasi@0.2.0"
  :manifest/required-fields [:world :wit :imports]
  :world/type :lower-case-wit-identifier
  :wit/required-fields [:package :source :sha256 :dependencies]
  :wit/dependency-required-fields [:package :source :sha256]
  :wit/package-format "namespace:name@major.minor.patch"
  :wit/source-format :safe-relative-wit-file
  :wit/sha256-format :lower-case-hex
  :imports/type :vector-of-qualified-wit-interface
  :imports/semantics "The selected Component's import set must exactly equal this vector. A wasi:filesystem/* or wasi:io/* import requires the :file capability."
  :exports/semantics "Every declared Hara export maps to a synchronous direct WIT world function or interface::function with matching arity, result, and supported wire type."
  :hara-values/package "hara:values@0.1.0"
  :hara-values/summary
  "hara:values@0.1.0 owns exact WIT representations for Hara-specific values and persistent collection categories. Standard WIT primitives, strings, bytes, records, variants, lists, options, results and resources use their Component canonical ABI representation. Hara mappings preserve value category, equality, hashing, iteration-order guarantees and map-entry identity; they must not substitute JSON, opaque bytes or a different collection kind. Its value is a checked indexed post-order graph because recursive WIT aliases are not standard-valid: every child index precedes its owner, root is the final node, and all nodes are reachable."}

 :platform/operations
 [{:operation/id :hara.extension.operation/normalize
   :operation/role :hara.extension.role/builder
   :operation/input :hara.extension/project-declaration
   :operation/output :hara.extension/package-declaration
   :operation/failures [:invalid-provider :invalid-abi :unsafe-path
                        :missing-module :missing-asset :duplicate-namespace]}
  {:operation/id :hara.extension.operation/select-target
   :operation/role :hara.extension.role/host
   :operation/input [:hara.extension/package-declaration :hara.extension/host]
   :operation/output :hara.extension/target
   :operation/failures [:unsupported-host :missing-target :asset-unavailable]}
  {:operation/id :hara.extension.operation/start
   :operation/role :hara.extension.role/host
   :operation/input :hara.extension/target
   :operation/output :hara.extension/context
   :operation/failures [:capability-denied :abi-mismatch :wit-mismatch :startup-failed]}
  {:operation/id :hara.extension.operation/invoke
   :operation/role :hara.extension.role/provider
   :operation/input :hara.extension/request
   :operation/output :hara.extension/result
   :operation/failures [:unknown-export :invalid-arguments :remote-error
                        :timeout :cancelled]}]

 :platform/invariants
 [{:requirement/id :hara.extension/project-only
   :requirement/level :must
   :requirement/text "Extension authoring occurs only under :project/extensions in project.edn; no separate extension descriptor is read or published."}
  {:requirement/id :hara.extension/generated-package-map
   :requirement/level :must
   :requirement/text "The package builder embeds normalized archive-relative extension maps in package.edn and rejects declarations whose files escape the package root."}
  {:requirement/id :hara.extension/ordinary-require
   :requirement/level :must
   :requirement/text "An extension exports an ordinary Hara namespace selected through require without exposing provider construction or transport operations at the call site."}
  {:requirement/id :hara.extension/no-authority-on-load
   :requirement/level :must
   :requirement/text "Resolving or loading an extension declaration grants no authority; the host independently approves every requested WIT import, capability and host call."}
  {:requirement/id :hara.extension/component-only
   :requirement/level :must
   :requirement/text "Authored WASM extensions declare :provider :wasm and :abi :component.v1. Legacy :core.v1, :memory.v1 and :hta.v1 declarations are invalid public extension ABIs."}
  {:requirement/id :hara.extension/wit-integrity
   :requirement/level :must
   :requirement/text "The package records the selected WIT package, world, source digest, dependency source digests and exact Component import vector. The host rejects a component whose WIT package, world, imports, exports, arity, result, dependency digest, or supported wire types differ from that declaration."}
  {:requirement/id :hara.extension/value-round-trip
   :requirement/level :must
   :requirement/text "Hara core and HTA profiles lower and lift the declared WIT values losslessly. Hara-specific persistent values use hara:values@0.1.0 and preserve their public category, equality, hashing, iteration order and map-entry semantics across a component round trip. The Hara values graph is canonical post-order, validates every index and reachability, and rejects mutable, lazy, callable, resource, provider, process or session-owned values rather than silently serializing them."}
  {:requirement/id :hara.extension/wasi-filesystem-projection
   :requirement/level :must
   :requirement/text "A wasi:filesystem or wasi:io import is linked only after capability approval to a directory/resource rooted at the active Hara FileProvider logical filesystem. It exposes neither provider identity nor credentials, cannot escape that root, and rejects provider operations whose semantics cannot be represented faithfully."}
  {:requirement/id :hara.extension/target-neutral-source
   :requirement/level :must
   :requirement/text "Hara source does not branch on the host target; the host selects a declared compatible target while preserving values, errors, promises and export signatures."}
  {:requirement/id :hara.extension/remote-integrity
   :requirement/level :must
   :requirement/text "A remote artifact is accepted only over HTTPS with an exact SHA-256 digest and byte size, and official releases mirror the verified bytes into the .harp by default."}
  {:requirement/id :hara.extension/offline-cache
   :requirement/level :must
   :requirement/text "When an external artifact policy is explicitly allowed, reconciliation stores the verified bytes by digest and runtime loading uses only the local content-addressed object."}
  {:requirement/id :hara.extension/native-first
   :requirement/level :must
   :requirement/text "The first conforming host is Hara-native. Browser and process hosts are unsupported until they pass the same WIT world and capability conformance corpus; source does not select an alternate transport for them."}]

 :platform/conformance
 [{:conformance/id :hara.extension/declarations
   :conformance/path "conformance/extensions.edn"}]}
