 :spec/behavior
 [{:behavior/id :xt.substrate.view/validation
   :behavior/text "validate requires version 1, a string id, valid binding shapes, known catalog or fg/ components, JSON-safe props, and recursively valid children; validate-portable additionally rejects fg/ components."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.view/state
   :behavior/text "state-set writes the path, increments the per-view revision, emits a keyed listener event, and returns the assigned value."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.view/snapshot
   :behavior/text "snapshot reads each declared binding from local initial data, view state, model output, or model input."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.view/subscription
   :behavior/text "subscribe validates the spec, deduplicates dependency listener keys, stores the initial snapshot, and increments subscription revision on notification; unsubscribe removes every key and empties keys."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.view/dispatch
   :behavior/text "dispatch requires a string action id, projects event payloads when payload has $=event, and calls base-util/request with a one-element argument vector."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.proxy/install
   :behavior/text "install registers nine page actions and the two model input/output triggers."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.proxy/synchronization
   :behavior/text "Opening a proxy group requests a server snapshot, builds proxy models, subscribes to model signals, and uses proxy_dispatch for remote group/model operations; closing removes subscriptions and the local proxy group."
   :behavior/evidence :evidence/source-and-test}]

