{:document/id :hara/mirroring
 :document/type :hara/tap-protocol
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara tap mirroring protocol"
 :document/summary
 "Normative registry revision and immutable object replication, divergence and failover contract."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.0.0-alpha"}

 :platform/roles
 [{:role/id :hara.mirroring.role/source
   :role/summary "Exposes exact Git revisions and immutable objects."}
  {:role/id :hara.mirroring.role/mirror
   :role/summary "Replicates and advertises verified revisions and objects."}
  {:role/id :hara.mirroring.role/client
   :role/summary "Selects mirrors without weakening pinned trust."}]

 :platform/entities
 [{:entity/id :hara.mirroring/descriptor
   :entity/summary "Mirror endpoints, supported roles and observed revisions."
   :entity/fields [:mirror/id :mirror/tap :mirror/identity
                   :mirror/registry :mirror/packages :mirror/assets]}
  {:entity/id :hara.mirroring/snapshot
   :entity/summary "Exact registry revision and required artifact set."
   :entity/fields [:snapshot/registry-revision :snapshot/identity-revision
                   :snapshot/artifacts :snapshot/generated-at]}]

 :platform/operations
 [{:operation/id :hara.mirroring.operation/sync
   :operation/role :hara.mirroring.role/mirror
   :operation/input :hara.mirroring/snapshot
   :operation/output :hara.mirroring/snapshot
   :operation/failures [:source-unavailable :revision-missing
                        :digest-mismatch :divergent-history]}
  {:operation/id :hara.mirroring.operation/select
   :operation/role :hara.mirroring.role/client
   :operation/input :hara.mirroring/requirements
   :operation/output :hara.mirroring/descriptor
   :operation/failures [:no-exact-revision :no-exact-object]}]

 :platform/invariants
 [{:requirement/id :hara.mirroring/exact-revision
   :requirement/level :must
   :requirement/text "A registry or identity mirror is usable only when it yields the exact required verified Git revision."}
  {:requirement/id :hara.mirroring/exact-object
   :requirement/level :must
   :requirement/text "An object mirror is interchangeable only for bytes matching the required digest and size."}
  {:requirement/id :hara.mirroring/no-authority
   :requirement/level :must-not
   :requirement/text "Mirror ordering, freshness or availability changes the authoritative identity or registry content."}
  {:requirement/id :hara.mirroring/divergence
   :requirement/level :must
   :requirement/text "Divergent content for a requested revision or digest is rejected and reported, never silently preferred."}]

 :platform/conformance
 [{:conformance/id :hara.mirroring/mirror-cases
   :conformance/path "conformance/mirrors.edn"}]}
