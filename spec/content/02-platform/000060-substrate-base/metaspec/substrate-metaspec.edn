{:document/id :xt/substrate-metaspec
 :document/type :xt-substrate-metaspec
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "XTalk substrate source-fidelity metaspec"
 :document/summary
 "Defines a source-backed document model for the existing xt.substrate implementation."

 :metaspec/source-authority
 {:source/repository "../foundation-base"
  :source/revision "efa09d39ce44c28dfaf6ff064752d17ccd444e92"
  :source/root "src-lang/xt"
  :source/tests "test-lang/xt"
  :source/rule
  "Normative behavior must be observable in the pinned source or its tests. Desired behavior is outside this specification."}

 :metaspec/document
 {:schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to :spec/family
   :spec/depends-on :source/modules :spec/behavior :spec/references
   :spec/conformance]
  :schema/document-type :xt-substrate-spec
  :schema/family :xt/substrate}

 :metaspec/evidence
 {:evidence/levels
  [:evidence/source-and-test :evidence/source-only]
  :evidence/required
  [:evidence/id :evidence/source :evidence/symbols :evidence/level]
  :evidence/no-inference
  "Silence in the implementation does not establish ordering, lifecycle, retry, timeout, capability, cleanup, or portability guarantees."}

 :metaspec/requirements
 [{:requirement/id :xt.substrate.meta/qualified-map-keys
   :requirement/level :must
   :requirement/text "Specification EDN maps use qualified keyword keys."}
  {:requirement/id :xt.substrate.meta/source-traceability
   :requirement/level :must
   :requirement/text "Every normative behavior names its source module and symbols."}
  {:requirement/id :xt.substrate.meta/no-invented-api
   :requirement/level :must-not
   :requirement/text "A document introduces records, fields, operations, states, errors, or guarantees absent from the source baseline."}
  {:requirement/id :xt.substrate.meta/tests-are-observations
   :requirement/level :must
   :requirement/text "Conformance cases preserve the inputs and observable results asserted by existing XTalk tests."}]

 :metaspec/validation
 [:validation/edn-parse :validation/qualified-map-keys
  :validation/unique-document-ids :validation/resolved-dependencies
  :validation/source-paths-exist :validation/test-paths-exist
  :validation/no-untraced-behavior]

 :spec/conformance []}
