{:document/id :xt/substrate-service
 :document/type :xt-substrate-spec
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "XTalk substrate service registry"
 :document/summary
 "Defines the EventNode arbitrary-value service map and the built-in @/ utility handlers."

 :spec/conforms-to
 {:spec/id :xt/substrate-metaspec :spec/version "0.0.0-alpha"}
 :spec/family :xt/substrate
 :spec/depends-on [:xt/substrate-base :xt/substrate-node]

 :source/modules
 [{:module/id :xt.substrate.service/root
   :module/namespace "xt.substrate"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate.clj"}
  {:module/id :xt.substrate.service/util-handlers
   :module/namespace "xt.substrate.base-util-handlers"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate/base_util_handlers.clj"}]

 :service/registry
 {:registry/field "services"
  :registry/key :string
  :registry/value :xt/any
  :registry/symbols ["get-services" "get-service" "set-service" "remove-service"]
  :registry/no-descriptor true
  :registry/no-lifecycle true
  :registry/no-dependency-model true
  :registry/no-capability-model true}

 :service/utility-handlers
 [{:handler/action "@/ping" :handler/symbol "ping"}
  {:handler/action "@/echo" :handler/symbol "echo"}
  {:handler/action "@/list-handlers" :handler/symbol "list-handlers"}
  {:handler/action "@/list-triggers" :handler/symbol "list-triggers"}
  {:handler/action "@/list-spaces" :handler/symbol "list-spaces"}
  {:handler/action "@/list-transports" :handler/symbol "list-transports"}
  {:handler/action "@/get-service" :handler/symbol "handle-get-service"}
  {:handler/action "@/node-info" :handler/symbol "node-info"}]

 :spec/behavior
 [{:behavior/id :xt.substrate.service/get-services
   :behavior/text "get-services returns the node services object, or a new empty object when the field is nil."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.service/set
   :behavior/text "set-service stores any value under the supplied string id and returns that value."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.service/remove
   :behavior/text "remove-service reads the previous value, deletes the key, and returns the previous value."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.service/install-utils
   :behavior/text "node-configure calls install-util-handlers; installation registers all eight @/ handlers with substrate/fn metadata."
   :behavior/evidence :evidence/source-and-test}]

