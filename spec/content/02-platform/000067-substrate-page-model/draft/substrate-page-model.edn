 :spec/behavior
 [{:behavior/id :xt.substrate.page/storage
   :behavior/text "space-ensure-page ensures object space state and replaces a missing or wrongly tagged page slot with runtime-page."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.page/group-model
   :behavior/text "group-add-attach creates or reuses a group, creates event models from specifications, computes dependency lookup maps, and does not perform initial refresh; group-add also stores its group-refresh promise as init."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.page/removal
   :behavior/text "Group and model removal throw when dependency lookup reports dependents; otherwise they delete and return the previous value."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.page/update
   :behavior/text "Local group and model updates run through the group throttle and event-model pipelines; proxy groups delegate operations to proxy_dispatch."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.page/dependency-refresh
   :behavior/text "Successful pipeline runs may refresh model dependents; dependency paths may be local model ids or [group-id model-id] pairs."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.page/triggers
   :behavior/text "Trigger predicates may be nil, boolean, function, object keyed by signal, or a signal value; matching models are scheduled through the group throttle."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.page/raw-callback
   :behavior/text "Raw page callbacks use the stable @/raw/page/<space-id> trigger id and forward substrate frames to all page groups in that space."
   :behavior/evidence :evidence/source-and-test}]

