{:document/id :hara/distribution
 :document/type :hara/tap-protocol
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara verified distribution protocol"
 :document/summary
 "Normative exact release resolution, immutable download, cache and offline activation contract."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.0.0-alpha"}

 :platform/roles
 [{:role/id :hara.distribution.role/index
   :role/summary "Projects accepted Git records into queryable metadata."}
  {:role/id :hara.distribution.role/object-origin
   :role/summary "Serves immutable package or asset bytes."}
  {:role/id :hara.distribution.role/client
   :role/summary "Verifies and caches exact releases before use."}]

 :platform/entities
 [{:entity/id :hara.distribution/resolution
   :entity/summary "Exact release and immutable artifact selection."
   :entity/fields [:resolution/kind :resolution/coordinate
                   :resolution/version :resolution/registry-revision
                   :resolution/artifacts]}
  {:entity/id :hara.distribution/cache-entry
   :entity/summary "Locally verified object addressed by digest."
   :entity/fields [:cache/sha256 :cache/size :cache/verified-against]}]

 :platform/operations
 [{:operation/id :hara.distribution.operation/resolve
   :operation/role :hara.distribution.role/index
   :operation/input :hara.distribution/query
   :operation/output :hara.distribution/resolution
   :operation/failures [:unknown-coordinate :unknown-version
                        :unsupported-target :yanked]}
  {:operation/id :hara.distribution.operation/fetch
   :operation/role :hara.distribution.role/client
   :operation/input :hara.distribution/resolution
   :operation/output :hara.distribution/cache-entry
   :operation/failures [:offline-miss :unavailable :size-mismatch
                        :digest-mismatch :unverified-record]}]

 :platform/invariants
 [{:requirement/id :hara.distribution/exact-result
   :requirement/level :must
   :requirement/text "A distribution response identifies an exact accepted release, registry revision and immutable artifact digest."}
  {:requirement/id :hara.distribution/verify-client-side
   :requirement/level :must
   :requirement/text "Clients verify authoritative records, authorization, signatures, size, digest and format before cache insertion."}
  {:requirement/id :hara.distribution/cache-by-digest
   :requirement/level :must
   :requirement/text "Cached bytes are keyed by digest rather than mutable download URL."}
  {:requirement/id :hara.distribution/offline
   :requirement/level :must
   :requirement/text "Offline mode uses verified local records and objects only and fails explicitly on a cache miss."}]

 :platform/conformance
 [{:conformance/id :hara.distribution/resolution-cases
   :conformance/path "conformance/resolution.edn"}]}
