{:document/id :hara/platform-artifact
 :document/type :hara/tap-protocol
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara immutable artifact protocol"
 :document/summary
 "Normative content-addressed object, manifest and build-attestation contract."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.0.0-alpha"}

 :platform/roles
 [{:role/id :hara.artifact.role/builder
   :role/summary "Produces bytes without publication authority."}
  {:role/id :hara.artifact.role/finalizer
   :role/summary "Verifies bytes and records accepted provenance."}
  {:role/id :hara.artifact.role/store
   :role/summary "Serves immutable bytes by digest."}]

 :platform/entities
 [{:entity/id :hara.artifact/object
   :entity/summary "Immutable byte string addressed by SHA-256."
   :entity/fields [:artifact/sha256 :artifact/size :artifact/media-type]}
  {:entity/id :hara.artifact/manifest
   :entity/summary "Canonical description of an object and its origin."
   :entity/fields [:artifact/format :artifact/kind :artifact/object
                   :artifact/source :artifact/recipe]}
  {:entity/id :hara.artifact/attestation
   :entity/summary "Registry CI statement binding verified inputs and outputs."
   :entity/fields [:attestation/format :attestation/subject
                   :attestation/builder :attestation/inputs
                   :attestation/outputs]}]

 :platform/operations
 [{:operation/id :hara.artifact.operation/put
   :operation/role :hara.artifact.role/finalizer
   :operation/input :hara.artifact/object
   :operation/output :hara.artifact/object
   :operation/failures [:digest-mismatch :size-mismatch :object-conflict]}
  {:operation/id :hara.artifact.operation/get
   :operation/role :hara.artifact.role/store
   :operation/input :hara.artifact/digest
   :operation/output :hara.artifact/object
   :operation/failures [:not-found :stored-digest-mismatch]}
  {:operation/id :hara.artifact.operation/attest
   :operation/role :hara.artifact.role/finalizer
   :operation/input :hara.artifact/manifest
   :operation/output :hara.artifact/attestation
   :operation/failures [:unverified-input :unverified-output]}]

 :platform/invariants
 [{:requirement/id :hara.artifact/sha256
   :requirement/level :must
   :requirement/text "Version one object identities use lowercase 64-character SHA-256 hex with a sha256: algorithm prefix in records."}
  {:requirement/id :hara.artifact/immutable
   :requirement/level :must
   :requirement/text "A digest URL returns the same bytes forever or fails; it must never be overwritten with different bytes."}
  {:requirement/id :hara.artifact/git-manifest
   :requirement/level :must
   :requirement/text "Object storage alone confers no trust; accepted Git manifests bind objects to releases."}
  {:requirement/id :hara.artifact/unprivileged-build
   :requirement/level :must
   :requirement/text "Untrusted build jobs cannot write accepted Git records, object storage or registry signatures."}]

 :platform/conformance
 [{:conformance/id :hara.artifact/objects
   :conformance/path "conformance/objects.edn"}]}
