{:document/id :hara/asset
 :document/type :hara/tap-protocol
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara versioned asset collection protocol"
 :document/summary
 "Normative file, image, video and 3D collection, derivative and isolated delivery contract."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.0.0-alpha"}

 :platform/roles
 [{:role/id :hara.asset.role/author
   :role/summary "Declares original files and deterministic derivative recipes."}
  {:role/id :hara.asset.role/builder
   :role/summary "Produces declared derivative objects in isolated CI."}
  {:role/id :hara.asset.role/delivery
   :role/summary "Serves immutable content without identity credentials."}]

 :platform/entities
 [{:entity/id :hara.asset/collection
   :entity/summary "Tap-qualified, versioned set of named media resources."
   :entity/fields [:asset/coordinate :asset/version :asset/entries
                   :asset/license :asset/dependencies]}
  {:entity/id :hara.asset/entry
   :entity/summary "Logical path, original object and declared derivatives."
   :entity/fields [:entry/path :entry/original :entry/derivatives
                   :entry/media-type :entry/metadata]}
  {:entity/id :hara.asset/derivative
   :entity/summary "Deterministically built output for a named profile."
   :entity/fields [:derivative/profile :derivative/recipe
                   :derivative/artifact :derivative/media-type]}]

 :platform/operations
 [{:operation/id :hara.asset.operation/build
   :operation/role :hara.asset.role/builder
   :operation/input :hara.asset/collection
   :operation/output :hara.asset/built-collection
   :operation/failures [:unsafe-path :unknown-recipe :toolchain-unlocked
                        :nondeterministic-output]}
  {:operation/id :hara.asset.operation/pull
   :operation/role :hara.asset.role/delivery
   :operation/input :hara.asset/selection
   :operation/output :hara.asset/local-collection
   :operation/failures [:unknown-version :unknown-profile
                        :digest-mismatch]}]

 :platform/invariants
 [{:requirement/id :hara.asset/versioned-collection
   :requirement/level :must
   :requirement/text "Asset collections have a tap-qualified owner/name, immutable semantic version and accepted Git release record."}
  {:requirement/id :hara.asset/deterministic-derivatives
   :requirement/level :must
   :requirement/text "Declared derivatives are built in CI by a digest-pinned toolchain and every output digest is recorded."}
  {:requirement/id :hara.asset/no-on-demand-transform
   :requirement/level :must-not
   :requirement/text "The version-one delivery service performs arbitrary unrecorded transformations on request."}
  {:requirement/id :hara.asset/isolated-origin
   :requirement/level :must
   :requirement/text "assets.hara-lang.org carries no identity cookies or administrative authority and serves explicit immutable content with nosniff."}
  {:requirement/id :hara.asset/content-safety
   :requirement/level :must
   :requirement/text "Active or unknown content is isolated by origin, restrictive policy and safe disposition."}]

 :platform/conformance
 [{:conformance/id :hara.asset/collections
   :conformance/path "conformance/collections.edn"}
  {:conformance/id :hara.asset/delivery
   :conformance/path "conformance/delivery.edn"}]}
