{:document/id :xt/substrate-node
 :document/type :xt-substrate-spec
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "XTalk substrate node and space contract"
 :document/summary
 "Defines the mutable EventNode and NodeSpace records and their current construction, configuration, and state operations."

 :spec/conforms-to
 {:spec/id :xt/substrate-metaspec :spec/version "0.0.0-alpha"}
 :spec/family :xt/substrate
 :spec/depends-on [:xt/substrate-base :xt/substrate-frame]

 :source/modules
 [{:module/id :xt.substrate.node/root
   :module/namespace "xt.substrate"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate.clj"}
  {:module/id :xt.substrate.node/space
   :module/namespace "xt.substrate.base-space"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate/base_space.clj"}
  {:module/id :xt.substrate.node/util
   :module/namespace "xt.substrate.base-util"
   :module/path "../../../../../foundation-base/src-lang/xt/substrate/base_util.clj"}]

 :node/record
 {:record/name "EventNode"
  :record/tag-field ["::" "substrate"]
  :record/fields
  ["id" "listeners" "spaces" "services" "handlers" "triggers"
   "pending" "router" "transports" "meta"]
  :record/default-id-prefix "node-"
  :record/router-default
  [["connections" :object/empty] ["subscriptions" :object/empty]]}

 :space/record
 {:record/name "NodeSpace"
  :record/fields ["id" "state" "meta"]
  :record/default-id "__NODE__"
  :record/default-state :object/empty
  :record/default-meta :object/empty}

 :node/symbols
 ["NodeTriggerHandler" "NodeTriggerEntry" "node?" "node-create"
  "node-configure" "node-base-opts"
  "config-normalize-space" "config-normalize-handler"
  "config-normalize-trigger"]
 :space/symbols
 ["NodeSpaceUpdater" "space" "get-space" "create-space"
  "ensure-space" "remove-space"
  "list-spaces" "get-space-state" "set-space-state"
  "update-space-state"]

 :spec/behavior
 [{:behavior/id :xt.substrate.node/create
   :behavior/text "node-create builds a blank event container, applies defaults, preserves non-declarative options, installs utility handlers, then configures declared spaces, handlers, and triggers."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.node/config-validation
   :behavior/text "Declarative space, handler, and trigger entries accept only the shapes implemented by their config-normalize functions and throw on id mismatches or invalid entries."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.space/create-replaces
   :behavior/text "create-space creates or replaces an entry; ensure-space returns an existing entry or creates it; remove-space returns the previous entry."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.space/state
   :behavior/text "State get, set, and update ensure the space first; the updater receives current state, the space, and the node."
   :behavior/evidence :evidence/source-and-test}
  {:behavior/id :xt.substrate.space/list
   :behavior/text "list-spaces returns space ids sorted with the XTalk string comparator."
   :behavior/evidence :evidence/source-and-test}]

