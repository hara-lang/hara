{:document/id :hara/artifact-metaspec
 :document/type :hara/artifact-metaspec
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "HAL Artifact DSL Meta-Specification"
 :document/summary "Normative schema for specifications that describe local, deterministic artifact DSLs."

 :spec/conforms-to {:spec/id :hara/metaspec-metaspec
                    :spec/version "0.0.0-alpha"}
 :spec/artifact-kind :hara/artifact-specification

 :meta/extension-key-rule
 {:requirement/id :hara.artifact/qualified-extension-keys
  :requirement/level :must
  :requirement/text "Keys not declared by this meta-spec must be qualified keywords."}

 :meta/requirement-levels
 [{:requirement-level/id :must
   :requirement-level/meaning "Required for conformance."}
  {:requirement-level/id :must-not
   :requirement-level/meaning "Forbidden for conformance."}
  {:requirement-level/id :should
   :requirement-level/meaning "Recommended unless a documented reason applies."}
  {:requirement-level/id :should-not
   :requirement-level/meaning "Discouraged unless a documented reason applies."}
  {:requirement-level/id :may
   :requirement-level/meaning "Optional."}]

 :meta/obligation-statuses
 [{:obligation-status/id :pass}
  {:obligation-status/id :fail}
  {:obligation-status/id :unknown}
  {:obligation-status/id :blocked}
  {:obligation-status/id :waived}
  {:obligation-status/id :not-applicable}]

 :meta/document-schema
 {:schema/id :hara.artifact/artifact-specification
  :schema/type :map
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to :spec/artifact-kind
   :spec/forms :spec/entities :spec/relations :spec/codecs :spec/checkers
   :spec/laws :spec/conformance]
  :schema/properties
  {:document/id {:schema/ref :hara.artifact/qualified-keyword}
   :document/type {:schema/ref :hara.artifact/qualified-keyword}
   :document/version {:schema/ref :hara.artifact/version-string}
   :document/status {:schema/ref :hara.artifact/status-keyword}
   :document/title {:schema/ref :hara.artifact/non-empty-string}
   :document/summary {:schema/ref :hara.artifact/non-empty-string}
   :spec/conforms-to {:schema/ref :hara.artifact/spec-reference}
   :spec/artifact-kind {:schema/ref :hara.artifact/qualified-keyword}
   :spec/forms {:schema/items :hara.artifact/dsl-form}
   :spec/entities {:schema/items :hara.artifact/canonical-entity}
   :spec/relations {:schema/items :hara.artifact/relation}
   :spec/codecs {:schema/items :hara.artifact/codec}
   :spec/checkers {:schema/items :hara.artifact/checker-declaration}
   :spec/laws {:schema/items :hara.artifact/law}
   :spec/conformance {:schema/items :hara.artifact/conformance-reference}}}

 :meta/schemas
 [{:schema/id :hara.artifact/qualified-keyword
   :schema/type :keyword
   :schema/constraint :qualified}
  {:schema/id :hara.artifact/qualified-symbol
   :schema/type :symbol
   :schema/constraint :qualified}
  {:schema/id :hara.artifact/non-empty-string
   :schema/type :string
   :schema/min-length 1}
  {:schema/id :hara.artifact/version-string
   :schema/type :string
   :schema/pattern "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
  {:schema/id :hara.artifact/status-keyword
   :schema/type :enum
   :schema/values [:draft :candidate :stable :deprecated]}
  {:schema/id :hara.artifact/spec-reference
   :schema/type :map
   :schema/required [:spec/id :spec/version]}
  {:schema/id :hara.artifact/dsl-form
   :schema/type :map
   :schema/required [:form/id :form/head :form/cardinality :form/grammar]}
  {:schema/id :hara.artifact/canonical-entity
   :schema/type :map
   :schema/required [:entity/id :entity/schema]}
  {:schema/id :hara.artifact/relation
   :schema/type :map
   :schema/required [:relation/id :relation/from :relation/to
                     :relation/cardinality]}
  {:schema/id :hara.artifact/codec
   :schema/type :map
   :schema/required [:codec/id :codec/from :codec/to :codec/laws]}
  {:schema/id :hara.artifact/checker-source
   :schema/type :map
   :schema/required [:source/provider :source/repository :source/commit
                     :source/path]}
  {:schema/id :hara.artifact/checker-declaration
   :schema/type :map
   :schema/required [:checker/id :checker/input :checker/output]}
  {:schema/id :hara.artifact/checker-variation
   :schema/type :map
   :schema/required [:variation/id :variation/checker :variation/config
                     :variation/digest]}
  {:schema/id :hara.artifact/obligation
   :schema/type :map
   :schema/required [:obligation/id :requirement/id :obligation/status]}
  {:schema/id :hara.artifact/finding
   :schema/type :map
   :schema/required [:finding/id :requirement/id :finding/level
                     :finding/message]}
  {:schema/id :hara.artifact/evidence-reference
   :schema/type :map
   :schema/required [:evidence/id :evidence/type :evidence/digest]}
  {:schema/id :hara.artifact/law
   :schema/type :map
   :schema/required [:law/id :law/expression]}
  {:schema/id :hara.artifact/conformance-reference
   :schema/type :map
   :schema/required [:conformance/id :conformance/path]}
  {:schema/id :hara.artifact/conformance-case
   :schema/type :map
   :schema/required [:case/id :case/type :case/input :case/expected]}]

 :meta/cross-references
 [{:reference/id :hara.artifact/entity-references
   :reference/from [:relation/from :relation/to]
   :reference/to :entity/id}
  {:reference/id :hara.artifact/codec-law-references
   :reference/from :codec/laws
   :reference/to :law/id}
  {:reference/id :hara.artifact/variation-checker-references
   :reference/from :variation/checker
   :reference/to :checker/id}
  {:reference/id :hara.artifact/obligation-requirement-references
   :reference/from :requirement/id
   :reference/to :requirement/id}
  {:reference/id :hara.artifact/conformance-path-references
   :reference/from :conformance/path
   :reference/to :document-relative-path}]

 :meta/requirements
 [{:requirement/id :hara.artifact/normative-edn
   :requirement/level :must
   :requirement/text "The EDN artifact specification is normative."}
  {:requirement/id :hara.artifact/informative-rendering
   :requirement/level :must
   :requirement/text "Any Markdown rendering is informative."}
  {:requirement/id :hara.artifact/stable-identifiers
   :requirement/level :must
   :requirement/text "Schemas, requirements, laws and conformance cases use stable qualified identifiers."}
  {:requirement/id :hara.artifact/cross-reference-integrity
   :requirement/level :must
   :requirement/text "All declared cross-references resolve."}
  {:requirement/id :hara.artifact/no-host-values
   :requirement/level :must-not
   :requirement/text "Canonical values contain runtime objects, Vars, handles or host-specific values."}]

 :meta/checkers
 [{:checker/id :hara.artifact.rule/qualified-key
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-map-keys
   :checker/requirement :hara.artifact/qualified-extension-keys}
  {:checker/id :hara.artifact.rule/stable-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-field-values
   :checker/requirement :hara.artifact/stable-identifiers
   :checker/fields
   [:document/id :schema/id :requirement/id :form/id :entity/id
    :relation/id :codec/id :checker/id :law/id :conformance/id]}
  {:checker/id :hara.artifact.rule/duplicate-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/unique-field-values
   :checker/requirement :hara.artifact/stable-identifiers
   :checker/fields
   [:document/id :schema/id :requirement/id :form/id :entity/id
    :relation/id :codec/id :checker/id :law/id :conformance/id]}
  {:checker/id :hara.artifact.rule/no-host-values
   :checker/type :builtin
   :checker/op :hara.metaspec.check/no-host-values
   :checker/requirement :hara.artifact/no-host-values}]

 :metaspec/generation
 {:generation/input
  {:input/type :hara.artifact/generation-request
   :input/required
   [:request/artifact-kind :request/forms :request/entities
    :request/relations :request/codecs :request/checkers
    :request/laws :request/conformance]}
  :generation/output
  {:output/type :hara/artifact-specification
   :output/format :edn
   :output/required
   [:document/id :document/type :document/version :document/status
    :document/title :document/summary :spec/conforms-to
    :spec/artifact-kind :spec/forms :spec/entities :spec/relations
    :spec/codecs :spec/checkers :spec/laws :spec/conformance]}
  :generation/process
  [:generate-draft :lint :repair-lint-findings :verify
   :repair-verification-findings :emit-canonical-edn]
  :generation/acceptance
  {:acceptance/status :pass
   :acceptance/required-summary
   {:summary/fail 0 :summary/unknown 0 :summary/blocked 0}
   :acceptance/no-unresolved-references true
   :acceptance/canonical-edn true}}}
