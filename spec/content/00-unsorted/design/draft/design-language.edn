{:document/id :hara/design-language
 :document/type :design-contract
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara Studio design language"
 :document/summary "A Max/MSP-inspired, lossless code and patch interaction contract for Hara and domain DSLs."

 :design/principles
 [:live :inspectable :composable :dense-but-legible
  {:max-msp "Interaction reference only; Hara does not visually clone Max/MSP."}]

 :design/theme-primitives
 #{:workspace :activity-rail :dock :popout :patch-canvas :menu-bar :toolbar :tabs :section :panel :strip :status-bar
   :node :port :cable :inspector :console :code-block :code-visual-actions}

 :design/workspace
 {:areas [:patch-canvas :code-editor :inspector :console-log :file-session-browser :timeline :status-strip]
  :docks {:left [:activity-rail :files :search :node-palette]
          :right [:inspector :provenance :diagnostics :runtime]
          :mode :resizable-collapsible}
  :popouts {:kinds [:node-palette :context-menu :command-palette :tooltip :status]
            :mode :anchored-temporary}
  :layout {:model :recursive-split-tree :presets [:code :visual :patch :performance]}
  :tabs {:role "Documents and reusable subpatch/module boundaries." :must [:select :close :reorder :pin]}
  :sections {:role "Collapsible inspector and console groups." :must [:label :status :keyboard-toggle]}
  :modules {:nested-patch :named-reusable-hara-definition}}

 :design/program-model
 {:source-of-truth :structured-program-document
  :projections [:hara-source :dsl-source :patch-graph]
  :stable-identities [:node-id :port-id :connection-id :declaration-id :source-location]
  :non-semantic-metadata [:layout :zoom :grouping :presentation]
  :losslessness "Unsupported visual edits are rejected or represented explicitly; source semantics are never silently discarded."
  :projection-sync
  {:source-authority true
   :parameter-edit {:visual-to-source :patch-literal
                    :runtime :incremental-live-update}
   :topology-edit :source-only
   :invalid-source :retain-last-current-projection
   :source-provenance {:range :complete-node-form
                       :render [:type-coloured-gutter :subtle-line-background]
                       :selection :bidirectional}}}

 :design/node-grammar
 {:node [:id :kind :parameters :diagnostics :selection :focus :execution-feedback :provenance]
  :port {:direction [:input :output] :type :typed}
  :connection-kinds [:signal :control :event :state :capability]
  :cable {:source-port :target-port :kind :connection-kind :rendering :svg}}

 :design/editing
 {:selection {:code-to-graph :highlight :graph-to-code :highlight}
  :structural-edits {:create-node :create-declaration :delete-node :delete-structure :wire-ports :edit-connection}
  :wiring {:gesture :drag-output-to-input :preview :provisional-svg-cable :rejection :explicit-visible}
  :evaluation {:states [:pending :current :stale :error] :feedback [:node :cable :console :inspector]}}

 :design/repl
 {:mobile :large-multiline-editor
  :recipes {:selectable true :execute-on-select false :editable true}
  :completion {:sources [:language-symbol :namespace-alias :graph-id :node-id :parameter :choice :recipe]
               :interaction [:touch-listbox :arrow-navigation :tab-or-enter :escape :ctrl-space]
               :execute-on-select false}}

 :design/code-visual-actions
 [{:id :link-create :icon "⛓" :effect :bind-source-and-visual-selection}
  {:id :reveal-visual :icon "◉" :effect :frame-visual-peer}
  {:id :reveal-code :icon "</>" :effect :select-source-peer}
  {:id :evaluate-link :icon "▶" :effect :evaluate-structured-program}
  {:id :inspect-link :icon "ⓘ" :effect :open-provenance-inspector}
  {:id :trace-flow :icon "⌁" :effect :show-dataflow-provenance}]

 :design/dsl-profiles
 [{:id :music :focus "signals, events, devices, and reusable signal patches"}
  {:id :usd-scene :focus "scene skeletons, transforms, materials, and composition arcs"}
  {:id :puppeteering :focus "controls, rigs, poses, constraints, and live cues"}
  {:id :llm-workflows :focus "prompts, tools, state, evaluation, and provenance"}]

 :design/adoption
 {:acceptance "Use this draft with theme.edn to accept later Studio and surface-adapter implementation."
  :non-goal "The four DSL profiles are reference profiles, not complete domain schemas."}}
