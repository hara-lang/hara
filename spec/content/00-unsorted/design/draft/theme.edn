{:document/id :hara/theme
 :document/type :design-contract
 :document/version "0.0.0-alpha"
 :document/status :draft
 :document/title "Hara theme design contract"
 :document/summary "One dark-only Hara visual system for public, documentation, specification, API, and Studio surfaces."

 :theme/foundation
 {:mode :dark-only
  :palette {:abyss "#020408" :panel "#04080f" :raised "#0e1522"
            :cyan "#41f5e4" :cyan-bright "#bafff8" :magenta "#ff2e88"
            :green "#3dff9e" :violet "#9c7bff" :amber "#f5d742"
            :text "#dce9f5" :muted "#8195a8" :faint "#4c6174"}
  :typography {:mono "SFMono-Regular, Cascadia Code, Roboto Mono, Consolas, monospace"
               :display "Arial Narrow, Helvetica Neue, Arial, sans-serif"}
  :spacing {:unit "0.25rem" :scale [1 2 3 4 6 8 12 16]}
  :borders {:line "rgba(65, 245, 228, .17)" :strong "rgba(65, 245, 228, .42)" :radius [2 4 7]}
  :elevation {:panel "0 12px 40px rgba(0,0,0,.45)" :focus "0 0 12px rgba(65,245,228,.22)"}
  :motion {:fast "150ms" :standard "250ms" :reduced-motion :disable-nonessential}
  :states {:focus :cyan :disabled :faint :error :magenta :warning :amber :success :green}}

 :theme/primitives
 #{:system-bar :frame :panel :strip :tabs :section :code-block :data-table
   :form-control :node :port :cable :inspector :console :documentation-callout
   :workspace :activity-rail :dock :popout :patch-canvas :menu-bar :toolbar :status-bar :code-visual-actions}

 :theme/chrome
 {:wordmark {:text "HARA" :mark :hara-favicon}
  :navigation {:global true :runtime-affordance true :status-affordance true}
  :responsive {:desktop :persistent-chrome :narrow :overlay-drawers}
  :fallback {:when-live-evaluation-unavailable :render-static-source-and-last-known-output}}

 :theme/adapters
 {:main-website {:role :public-interactive-entry :must #{:system-bar :frame :panel :tabs}}
  :mkdocs {:role :narrative-documentation-and-studio-host :must #{:system-bar :section :code-block :documentation-callout}}
  :specs {:role :lightweight-static-normative-index :must #{:panel :tabs :code-block :data-table}}
  :javadocs {:role :generated-api-satellite :must #{:system-bar :section :code-block :data-table}}
  :rustdocs {:role :generated-api-satellite :must #{:system-bar :section :code-block :data-table}}}

 :theme/documentation-roles
 {:mkdocs :explanatory-documentation
  :specs :normative-authority
  :javadocs :generated-implementation-api
  :rustdocs :generated-implementation-api
  :rule "Generated API references link back to narrative docs and normative specs; they do not define language semantics."}

 :theme/review
 {:baseline :docs-studio-noir
  :reviewed [:website :studio :specs :mkdocs :javadocs :rustdocs]
  :intentional-deviations
   [{:surface :studio :deviation "Existing Studio token values are close but not yet byte-identical to this contract."}
    {:surface :website :deviation "The public editor has local chrome rules pending adapter consolidation."}
    {:surface :specs :deviation "Specs currently consume a pinned static UI build rather than generated theme output."}
    {:surface :mkdocs :deviation "Documentation theme adoption is deferred to the implementation phase."}
    {:surface :javadocs :deviation "Generated API styling is not yet adapter-backed."}
    {:surface :rustdocs :deviation "Generated API styling is not yet adapter-backed."}]}

 :theme/adoption
 {:acceptance "This draft is the acceptance contract for a later token consolidation and surface-adapter implementation."
  :non-goal "This document does not itself generate CSS or publish a package pipeline."}}
