(ns lua.core-test
  (:require [lang.core :as l])
  (:use code.test))

(l/script- :lua
  {:runtime :basic
   :require [[lua.core :as lua]]})

(fact:global
 {:setup [(l/rt:restart)]
  :teardown [(l/rt:stop)]})

^{:refer lua.core/lua-type :added "4.0"}
(fact "exposes Lua scalar conversions and type inspection"
  (!.lua [(lua/lua-type 1)
           (lua/lua-type "text")
           (lua/tonumber "17")
           (lua/tostring 17)])
  => ["number" "string" 17 "17"])

^{:refer lua.core/table-insert :added "4.0"}
(fact "appends a value through the Lua table library"
  (!.lua
   (var values [3 1])
   (lua/table-insert values 2)
   (return values))
  => [3 1 2])

^{:refer lua.core/table-sort :added "4.0"}
(fact "sorts a Lua table in place"
  (!.lua
   (var values [3 1 2])
   (lua/table-sort values)
   (return values))
  => [1 2 3])

^{:refer lua.core/table-remove :added "4.0"}
(fact "removes the final Lua table value in place"
  (!.lua
   (var values [1 2 3])
   (lua/table-remove values)
   (return values))
  => [1 2])

^{:refer lua.core/string-sub :added "4.0"}
(fact "exposes Lua string transformations with one-based substring bounds"
  (!.lua [(lua/string-sub "abcdef" 2 4)
           (lua/string-lower "MiXeD")
           (lua/string-upper "MiXeD")
           (lua/string-format "%04d" 17)])
  => ["bcd" "mixed" "MIXED" "0017"])

^{:refer lua.core/math-abs :added "4.0"}
(fact "exposes Lua numeric helpers and constants"
  (!.lua [(lua/math-abs -4)
           (lua/math-floor 3.8)
           (lua/math-max 2 9 3)
           (lua/math-min 2 9 3)
           (> lua/math-pi 3)])
  => [4 3 9 2 true])
