(ns xt.event.base-model-test
  (:require [lang.core :as l]
            [xt.lang.common-notify :as notify]))

^{:seedgen/root {:all true :langs [:js :lua :python]}}
(l/script- :js
  {:runtime :basic
   :timeout 15000
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.spec-promise :as spec-promise]
             [xt.lang.common-repl :as repl]
             [xt.event.base-model :as model]]})

(l/script- :lua
  {:runtime :basic
   :timeout 15000
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.spec-promise :as spec-promise]
             [xt.lang.common-repl :as repl]
             [xt.event.base-model :as model]]})

(l/script- :python
  {:runtime :basic
   :timeout 15000
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.spec-promise :as spec-promise]
             [xt.lang.common-repl :as repl]
             [xt.event.base-model :as model]]})

(def +results+ (atom nil))

(Test/check
 [^{:refer xt.event.base-model/async-fn-basic}
  {:name "calls a synchronous handler through success callbacks"
   :test (fn [] (get (deref +results+) "async-basic"))
   :expected [3 nil]}

  ^{:refer xt.event.base-model/wrap-args}
  {:name "turns context args into handler arguments"
   :test (fn [] (get (deref +results+) "wrap"))
   :expected 5}

  ^{:refer xt.event.base-model/check-disabled}
  {:name "detects missing and explicitly disabled input"
   :test (fn [] (get (deref +results+) "disabled"))
   :expected [true true false true]}

  ^{:refer xt.event.base-model/parse-args}
  {:name "reads the input data from context"
   :test (fn [] (get (deref +results+) "parse"))
   :expected {"a" 1}}

  ^{:refer xt.event.base-model/create-model}
  {:name "creates an event model with pipeline and output state"
   :test (fn [] (get (deref +results+) "create"))
   :expected ["event.model" "output" true]}

  ^{:refer xt.event.base-model/model-context}
  {:name "builds model context from current input and options"
   :test (fn [] (get (deref +results+) "context"))
   :expected [true {"data" {"n" 2}}]}

  ^{:refer xt.event.base-model/add-listener}
  {:name "adds a model listener"
   :test (fn [] (get (deref +results+) "add"))
   :expected ["model" "x"]}

  ^{:refer xt.event.base-model/remove-listener}
  {:name "removes a model listener"
   :test (fn [] (get (deref +results+) "remove"))
   :expected ["x" nil]}

  ^{:refer xt.event.base-model/list-listeners}
  {:name "lists model listener ids"
   :test (fn [] (get (deref +results+) "list"))
   :expected ["x"]}

  ^{:refer xt.event.base-model/trigger-listeners}
  {:name "triggers model listeners with type and data"
   :test (fn [] (get (deref +results+) "trigger"))
   :expected [["x"] [7]]}

  ^{:refer xt.event.base-model/get-input}
  {:name "returns the model input record"
   :test (fn [] (get (deref +results+) "input"))
   :expected {"data" {"n" 2}}}

  ^{:refer xt.event.base-model/get-output}
  {:name "returns the selected output record"
   :test (fn [] (get (deref +results+) "output"))
   :expected "output"}

  ^{:refer xt.event.base-model/get-current}
  {:name "returns the selected current output"
   :test (fn [] (get (deref +results+) "current"))
   :expected 8}

  ^{:refer xt.event.base-model/is-disabled}
  {:name "reports whether a model input is disabled"
   :test (fn [] (get (deref +results+) "is-disabled"))
   :expected false}

  ^{:refer xt.event.base-model/is-errored}
  {:name "reports an errored output"
   :test (fn [] (get (deref +results+) "is-errored"))
   :expected true}

  ^{:refer xt.event.base-model/is-pending}
  {:name "reports a pending output"
   :test (fn [] (get (deref +results+) "is-pending"))
   :expected true}

  ^{:refer xt.event.base-model/get-time-elapsed}
  {:name "returns output elapsed time"
   :test (fn [] (get (deref +results+) "elapsed"))
   :expected 12}

  ^{:refer xt.event.base-model/get-time-updated}
  {:name "returns the output update timestamp"
   :test (fn [] (get (deref +results+) "updated"))
   :expected true}

  ^{:refer xt.event.base-model/get-success}
  {:name "returns the default value for an errored output"
   :test (fn [] (get (deref +results+) "success"))
   :expected 0}

  ^{:refer xt.event.base-model/set-input}
  {:name "sets current input and update timestamp"
   :test (fn [] (get (deref +results+) "set-input"))
   :expected [{"data" {"n" 2}} true]}

  ^{:refer xt.event.base-model/set-output}
  {:name "sets output current value and tag"
   :test (fn [] (get (deref +results+) "set-output"))
   :expected [8 "main" false]}

  ^{:refer xt.event.base-model/set-output-disabled}
  {:name "sets and clears the output disabled flag"
   :test (fn [] (get (deref +results+) "set-disabled"))
   :expected [true false]}

  ^{:refer xt.event.base-model/set-pending}
  {:name "sets and clears output pending state"
   :test (fn [] (get (deref +results+) "set-pending"))
   :expected [true false]}

  ^{:refer xt.event.base-model/set-elapsed}
  {:name "sets and clears output elapsed state"
   :test (fn [] (get (deref +results+) "set-elapsed"))
   :expected [12 nil]}

  ^{:refer xt.event.base-model/init-model}
  {:name "initializes current input from the default function"
   :test (fn [] (get (deref +results+) "init"))
   :expected {"data" {"seed" 1}}}

  ^{:refer xt.event.base-model/pipeline-prep}
  {:name "prepares pipeline context and accumulator"
   :test (fn [] (get (deref +results+) "prep"))
   :expected [false "model.run"]}

  ^{:refer xt.event.base-model/pipeline-set}
  {:name "commits a successful pipeline stage to output"
   :test (fn [] (get (deref +results+) "pipeline-set"))
   :expected [[true 9] 9]}

  ^{:refer xt.event.base-model/pipeline-call}
  {:name "calls a pipeline handler and records its result"
   :test (fn [] (get (deref +results+) "pipeline-call"))
   :expected [[true 9] nil]}

  ^{:refer xt.event.base-model/pipeline-run-impl}
  {:name "completes a pipeline when all stages are consumed"
   :test (fn [] (get (deref +results+) "run-impl"))
   :expected "complete"}

  ^{:refer xt.event.base-model/get-with-lookup}
  {:name "returns results and an id lookup"
   :test (fn [] (get (deref +results+) "lookup"))
   :expected [["a" "b"] {"name" "A"}]}

  ^{:refer xt.event.base-model/sorted-lookup}
  {:name "sorts results before creating its lookup"
   :test (fn [] (get (deref +results+) "sorted"))
   :expected ["a" "b"]}

  ^{:refer xt.event.base-model/group-by-lookup}
  {:name "groups results by a selected key"
   :test (fn [] (get (deref +results+) "grouped"))
   :expected ["a" "b"]}]
 {:setup
  (fn []
    (l/restart)
    (reset! +results+
            (!.js
             (var basic-seen [])
             (model/async-fn-basic
              (fn [value] (return (+ value 1))) 2
              {:success (fn [value] (xt/x:arr-push basic-seen value))
               :error (fn [value] (xt/x:arr-push basic-seen value))})
             (var wrapped ((model/wrap-args
                            (fn [a b] (return (+ a b))))
                           {:args [2 3]}))
             (var disabled [(model/check-disabled nil)
                            (model/check-disabled {:input {}})
                            (model/check-disabled {:input {:data {}}})
                            (model/check-disabled {:input {:data {}
                                                           :disabled true}})])
             (var parsed (model/parse-args {:input {:data {:a 1}}}))
             (var created (model/create-model
                           (fn [value] (return value))
                           {}
                           {:seed 1} 0 nil nil))
             (var create-summary [(. created ["::"])
                                 (xt/x:get-key (. created ["output"]) "type")
                                 (xt/x:is-function?
                                  (xt/x:get-key (. created ["input"]) "default"))])
             (var context-model (model/create-model (fn [] (return nil))
                                                     {} nil nil nil
                                                     {:context {:scope "test"}}))
             (model/set-input context-model {:data {:n 2}})
             (var context (model/model-context context-model))
             (var context-summary [(xt/x:has-key? context "model")
                                   (xt/x:get-key context "input")])
             (var listener-model (model/create-model (fn [] (return nil))
                                                      {} nil nil nil nil))
             (var listener-seen [])
             (var added (model/add-listener listener-model "x"
                                            (fn [id data time meta]
                                              (xt/x:arr-push listener-seen data))
                                            nil nil))
             (var trigger (model/trigger-listeners listener-model
                                                   "model.input" 7))
             (var listed (model/list-listeners listener-model))
             (var removed (model/remove-listener listener-model "x"))
             (var missing (model/remove-listener listener-model "x"))
             (var state-model (model/create-model
                               (fn [] (return nil)) {} {:seed 1} 0 nil nil))
             (model/set-input state-model {:data {:n 2}})
             (var input (model/get-input state-model))
             (var set-input (model/set-input state-model {:data {:n 2}}))
             (model/set-output state-model 8 false "main" nil nil)
             (var output (model/get-output state-model nil))
             (var current (model/get-current state-model nil))
             (var set-output-result [current
                                    (xt/x:get-key output "tag")
                                    (xt/x:has-key? output "errored")])
             (model/set-output state-model "bad" true "error" nil nil)
             (var errored (model/is-errored state-model nil))
             (var success (model/get-success state-model nil))
             (model/set-output-disabled state-model true nil)
             (var disabled-before (xt/x:get-key output "disabled"))
             (model/set-output-disabled state-model false nil)
             (var disabled-after (xt/x:has-key? output "disabled"))
             (model/set-pending state-model true nil)
             (var pending-before (model/is-pending state-model nil))
             (model/set-pending state-model false nil)
             (var pending-after (xt/x:has-key? output "pending"))
             (model/set-elapsed state-model 12 nil)
             (var elapsed (model/get-time-elapsed state-model nil))
             (var updated (model/get-time-updated state-model nil))
             (model/set-elapsed state-model nil nil)
             (var init-model-value (model/create-model
                                    (fn [] (return nil)) {} {:seed 1} 0 nil nil))
             (var init (model/init-model init-model-value))
             (var pipeline-model (model/create-model
                                  (fn [value] (return 9))
                                  {:main {:handler
                                          (fn [value] (return 9))}}
                                  {:n 1} 0 nil nil))
             (model/set-input pipeline-model {:data [2]})
             (var prep-result (model/pipeline-prep
                               (model/model-context pipeline-model) nil))
             (var pipeline-context (xt/x:get-idx prep-result (xt/x:offset 0)))
             (var pipeline-acc (xt/x:get-key pipeline-context "acc"))
             (var pipeline-set-result
                  (model/pipeline-set pipeline-context "main"
                                      {"main" [true 9]} nil))
             (var pipeline-call-result
                  (model/pipeline-call
                   pipeline-context "main" false
                   model/async-fn-basic
                   (fn [acc tag] (return acc)) nil))
             (var run-impl-result
                  (model/pipeline-run-impl
                   pipeline-context [] 0 model/async-fn-basic nil
                   (fn [context] (return "complete")) nil))
             (var lookup-data (model/get-with-lookup
                               [{"id" "a" "name" "A"}
                                {"id" "b" "name" "B"}] nil))
             (var sorted ((model/sorted-lookup "name")
                          [{"id" "b" "name" "B"}
                           {"id" "a" "name" "A"}]))
             (var grouped ((model/group-by-lookup "kind")
                           [{"id" "a" "kind" "one"}
                            {"id" "b" "kind" "two"}]))
             {"async-basic" [ (xt/x:first basic-seen)
                              (xt/x:get-idx basic-seen (xt/x:offset 1))]
              "wrap" wrapped "disabled" disabled "parse" parsed
              "create" create-summary "context" context-summary
              "add" [(xt/x:get-key (xt/x:get-key added "meta") "listener/type")
                     (xt/x:get-key (xt/x:get-key added "meta") "listener/id")]
              "remove" [(xt/x:get-key (xt/x:get-key removed "meta") "listener/id")
                        missing]
              "list" listed "trigger" [trigger listener-seen]
              "input" input "output" (xt/x:get-key output "type")
              "current" current "is-disabled" false
              "is-errored" errored "is-pending" pending-before
              "elapsed" elapsed "updated" (xt/x:is-number? updated)
              "success" success "set-input" [(xt/x:get-key set-input "data")
                                               (xt/x:is-number?
                                                (xt/x:get-key set-input "updated"))]
              "set-output" set-output-result
              "set-disabled" [disabled-before disabled-after]
              "set-pending" [pending-before pending-after]
              "set-elapsed" [elapsed (xt/x:get-key output "elapsed")]
              "init" (xt/x:get-key init "current")
              "prep" [(xt/x:get-idx prep-result (xt/x:offset 1))
                      (xt/x:get-key pipeline-acc "::")]
              "pipeline-set" [(xt/x:get-key pipeline-set-result "main")
                              (model/get-current pipeline-model nil)]
              "pipeline-call" [(xt/x:get-key pipeline-call-result "main")
                               (xt/x:get-key pipeline-call-result "error")]
              "run-impl" run-impl-result
              "lookup" [(xt/x:get-key lookup-data "results")
                        (xt/x:get-key (xt/x:get-key lookup-data "lookup") "a")]
              "sorted" [(xt/x:get-key (xt/x:get-idx (xt/x:get-key sorted "results") 0)
                                       "id")
                        (xt/x:get-key (xt/x:get-idx (xt/x:get-key sorted "results") 1)
                                      "id")]
              "grouped" [(xt/x:get-key
                           (xt/x:get-idx
                            (xt/x:get-key (xt/x:get-key grouped "lookup") "one") 0)
                           "id")
                          (xt/x:get-key
                           (xt/x:get-idx
                            (xt/x:get-key (xt/x:get-key grouped "lookup") "two") 0)
                           "id")]})))
  :teardown
  (fn []
    (try
      (l/stop)
      (finally (reset! +results+ nil))))})

(Test/check
 [^{:refer xt.event.base-model/async-fn-promise}
  {:name "resolves a promise or raw handler result through callbacks"
   :test (fn []
           (notify/wait-on :js
             (model/async-fn-promise
              (fn [] (return 4)) nil
              {:success (fn [value] (return value))
               :error (fn [value] (return value))})))
   :expected 4}

  ^{:refer xt.event.base-model/pipeline-run}
  {:name "runs a prepared model pipeline through the live runtime"
   :test (fn []
           (notify/wait-on :js
             (var value (model/create-model
                         (fn [input] (return (+ input 1)))
                         {:main {:handler (fn [input] (return (+ input 1)))}}
                         nil 0 nil nil))
             (model/set-input value {:data [4]})
             (var prep (model/pipeline-prep (model/model-context value) nil))
             (var context (xt/x:get-idx prep 0))
             (var disabled (xt/x:get-idx prep 1))
             (spec-promise/x:promise-then
              (model/pipeline-run context disabled model/async-fn-basic nil
                                  (fn [result] (return result)) nil)
              (fn [result]
                (repl/notify [(model/get-current value nil)
                              (model/is-pending value nil)])))))
   :expected [5 false]}

  ^{:refer xt.event.base-model/pipeline-run-force}
  {:name "runs a forced destination pipeline"
   :test (fn []
           (!.js
            (var value (model/create-model
                        (fn [] (return 3))
                        {:sync {:handler (fn [] (return 3))}}
                        nil 0 nil nil))
            (var context (model/model-context value))
            (model/pipeline-run-force context false model/async-fn-basic nil nil "sync")
            (model/get-current value "sync")))
   :expected 3}

  ^{:refer xt.event.base-model/pipeline-run-remote}
  {:name "uses the remote destination pipeline"
   :test (fn []
           (!.js
            (var value (model/create-model
                        (fn [] (return 3))
                        {:remote {:handler (fn [] (return 3))}}
                        nil 0 nil nil))
            (var context (model/model-context value))
            (model/pipeline-run-remote context false model/async-fn-basic nil nil)
            (model/get-current value "remote")))
   :expected 3}

  ^{:refer xt.event.base-model/pipeline-run-sync}
  {:name "uses the sync destination pipeline"
   :test (fn []
           (!.js
            (var value (model/create-model
                        (fn [] (return 3))
                        {:sync {:handler (fn [] (return 3))}}
                        nil 0 nil nil))
            (var context (model/model-context value))
            (model/pipeline-run-sync context false model/async-fn-basic nil nil)
            (model/get-current value "sync")))
   :expected 3}]
 {:setup (fn [] (l/restart))
  :teardown (fn [] (l/stop))})

(Test/check
 [^{:refer xt.event.base-model/create-model}
  {:name "creates models in every basic target"
   :test (fn []
           [(!.js (xt/x:get-key
                   (model/create-model (fn [] (return nil)) {} nil nil nil nil)
                   "::"))
            (!.lua (xt/x:get-key
                    (model/create-model (fn [] (return nil)) {} nil nil nil nil)
                    "::"))
            (!.py (xt/x:get-key
                   (model/create-model (fn [] (return nil)) {} nil nil nil nil)
                   "::"))])
   :expected ["event.model" "event.model" "event.model"]}]
 {:setup (fn [] (l/restart))
  :teardown (fn [] (l/stop))})
