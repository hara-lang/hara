(ns xt.lang.common-lib-test
  (:require [lang.core.script :as script]
            [xt.lang.common-lib :as common-lib]))

^{:refer xt.lang.common-lib/return-encode}
(Test/check
 [{:name "keeps return encoding as an XTalk target operation"
   :test (fn [] (let [source (script/compile-form
                              :js
                              'xt.lang.common-lib-test
                              '(x:return-encode value id key))]
                  [(string? source)
                   (str/includes? source "JSON.stringify")]))
   :expected [true true]}])

^{:refer xt.lang.common-lib/return-wrap}
(Test/check
 [{:name "keeps return wrapping as an XTalk target operation"
   :test (fn [] (let [source (script/compile-form
                              :python
                              'xt.lang.common-lib-test
                              '(x:return-wrap callback encode))]
                  [(string? source)
                   (str/includes? source "return encode")]))
   :expected [true true]}])

^{:refer xt.lang.common-lib/return-eval}
(Test/check
 [{:name "keeps return evaluation target-specific"
   :test (fn [] (let [source (script/compile-form
                              :lua
                              'xt.lang.common-lib-test
                              '(x:return-eval source wrap))]
                  [(string? source)
                   (str/includes? source "return wrap")]))
   :expected [true true]}])

^{:refer xt.lang.common-lib/identity}
(Test/check
 [{:name "retains the targeted identity function registration"
   :test (fn [] (let [module (get (deref script/+modules+)
                                  'xt.lang.common-lib)]
                  [(not (nil? module))
                   (not (nil? (get-in module [:code 'identity])))]))
   :expected [true true]}])
