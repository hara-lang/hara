(ns xt.lang.common-repl-test
  (:require [lang.core.script :as script]
            [xt.lang.common-repl :as repl]))

^{:refer xt.lang.common-repl/<!}
(Test/check
 [{:name "expands the callback map with success and error branches"
   :test (fn [] (let [value (first (second (macroexpand-1 '(repl/<!))))]
                  [(map? value)
                   (not (nil? (:success value)))
                   (not (nil? (:error value)))]))
   :expected [true true true]}])

^{:refer xt.lang.common-repl/>notify}
(Test/check
 [{:name "expands a callback notification into a target function"
   :test (fn [] (let [value (second (macroexpand-1 '(repl/>notify))) ]
                  [(sequential? value)
                   (= 'fn (first value))]))
   :expected [true true]}])

^{:refer xt.lang.common-repl/notify-socket-handler}
(Test/check
 [{:name "keeps socket handling source-owned"
   :test (fn [] (let [module (get (deref script/+modules+)
                                  'xt.lang.common-repl)]
                  (not (nil? module))))
   :expected true}])
