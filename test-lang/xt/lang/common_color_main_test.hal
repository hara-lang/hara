(ns xt.lang.common-color-main-test
  (:use code.test)
  (:require [lang.core :as l]
            [xt.lang.common-notify :as notify]))

^{:seedgen/root {:all true, :langs [:js :lua :python]}}
(l/script- :js
  {:runtime :basic
   :require [[xt.lang.common-lib :as k]
            [xt.lang.common-repl :as repl]
            [xt.lang.common-color :as color]]})

(fact:global
 {:setup    [(l/rt:restart)]
  :teardown [(l/rt:stop)]})

(fact "get it working"
      (!.js
       (+ 1 2 4))
      => 7)

^{:refer xt.lang.common-color/hex->rgb :added "4.0"}
(fact "evaluates the required color module through the basic JavaScript runtime"
  (!.js (color/hex->rgb "#45f981"))
  => [69 249 129])
