(ns postgres.typed.export-test
  (:require [postgres.typed :as typed]
            [postgres.typed.typed-common :as types]))

^{:refer postgres.typed/export-openapi}
(Test/check [{:name "exports an OpenAPI document from an empty typed context"
              :test (fn [] (let [baseline (deref types/*type-registry*)]
                             (try
                               (types/clear-registry)
                               (:openapi (typed/export-openapi (typed/load-registry {})))
                               (finally (reset! types/*type-registry* baseline)))))
              :expected "3.0.3"}])
