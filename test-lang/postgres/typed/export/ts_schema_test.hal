(ns postgres.typed.export.ts-schema-test
  (:require [postgres.typed.export.ts-schema :as ts-schema]
            [postgres.typed.typed-common :as types]))

^{:refer postgres.typed.export.ts-schema/name-string}
(Test/check
 [{:name "normalizes structured names for TypeScript output"
   :test (fn [] [(ts-schema/name-string "User")
                 (ts-schema/name-string :User)
                 (ts-schema/name-string 'User)])
   :expected ["User" "User" "User"]}])

^{:refer postgres.typed.export.ts-schema/field->ts}
(Test/check
 [{:name "renders required and optional TypeScript properties"
   :test (fn [] [(ts-schema/field->ts [:id {:type :uuid}])
                 (ts-schema/field->ts [:name {:type :text :nullable? true}])
                 (ts-schema/field->ts [:count {:type :integer}])])
   :expected ["  id: string;"
              "  name?: string;"
              "  count: number;"]}])

^{:refer postgres.typed.export.ts-schema/type->ts}
(Test/check
 [{:name "renders primitive reference array and shaped descriptors"
   :test (fn [] [(ts-schema/type->ts {:type :uuid})
                 (ts-schema/type->ts {:type :jsonb})
                 (ts-schema/type->ts {:is-ref? true})
                 (ts-schema/type->ts {:type :array :items {:type :text}})
                 (ts-schema/type->ts
                  {:type :jsonb
                   :shape (types/make-jsonb-shape {:id {:type :uuid}})})])
   :expected ["string"
              "Record<string, any>"
              "string"
              "string[]"
              "{ id: string; }"]}])

^{:refer postgres.typed.export.ts-schema/shape->ts-interface}
(Test/check
 [{:name "retains literal keys and emits named interfaces"
   :test (fn []
           (ts-schema/shape->ts-interface
            (types/make-jsonb-shape
             {"db/sync" {:type :jsonb
                           :shape (types/make-jsonb-shape
                                   {"UserProfile" {:type :array
                                                    :items {:type :jsonb}}})}})
            "IUserEvent"))
   :expected "export interface IUserEvent {\n  \"db/sync\": { UserProfile: Record<string, any>[]; };\n}"}])

^{:refer postgres.typed.export.ts-schema/quote-enum-value}
(Test/check
 [{:name "quotes enum alternatives"
   :test (fn [] [(ts-schema/quote-enum-value :open)
                 (ts-schema/quote-enum-value "closed")])
   :expected ["\"open\"" "\"closed\""]}])

^{:refer postgres.typed.export.ts-schema/generate-ts-schema}
(Test/check
 [{:name "emits interfaces and enum unions from the registry"
   :test (fn []
           (let [baseline (deref types/*type-registry*)]
             (try
               (types/clear-registry)
               (types/register-type
                'demo/User
                (types/make-table-def
                 "demo" "User"
                 [(types/make-column-def
                   :id
                   (types/make-type-ref :primitive nil :uuid))]
                 :id))
               (types/register-type
                'demo/Status
                (types/make-enum-def "demo" "Status" [:open :closed] nil))
               (ts-schema/generate-ts-schema)
               (finally (reset! types/*type-registry* baseline)))))
   :expected "export interface User {\n  id: string;\n}\n\nexport type Status = \"open\" | \"closed\";"}])
