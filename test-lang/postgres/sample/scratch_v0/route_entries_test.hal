(ns postgres.sample.scratch-v0.route-entries-test
  (:require [lang.core.impl :as impl]
            [lang.core.library :as library]
            [postgres.sample.scratch-v0.route-entries]))

^{:refer postgres.sample.scratch-v0.route-entries/ping}
(Test/check [{:name "registers the generated ping route descriptor"
              :test (fn [] (not (nil? (get-in (library/get-module
                                               (impl/runtime-library)
                                               :xtalk
                                               'postgres.sample.scratch-v0.route-entries)
                                              [:code 'ping]))))
              :expected true}])

^{:refer postgres.sample.scratch-v0.route-entries/log-append}
(Test/check [{:name "registers the generated append route descriptor"
              :test (fn [] (not (nil? (get-in (library/get-module
                                               (impl/runtime-library)
                                               :xtalk
                                               'postgres.sample.scratch-v0.route-entries)
                                              [:code 'log-append]))))
              :expected true}])
