(ns postgres.sample.scratch-v0.view-log-test
  (:require [postgres.sample.scratch-v0.view-log :as views]))

^{:refer postgres.sample.scratch-v0.view-log/view-list}
(Test/check [{:name "exposes the generated view collector"
              :test (fn [] (fn? views/view-list))
              :expected true}])

^{:refer postgres.sample.scratch-v0.view-log/make-views}
(Test/check [{:name "exposes the XTalk view materializer"
              :test (fn [] (fn? views/make-views))
              :expected true}])
