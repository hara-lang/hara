(ns postgres.sample.scratch-v0.route-scratch-test
  (:require [postgres.sample.scratch-v0.route-scratch :as routes]))

^{:refer postgres.sample.scratch-v0.route-scratch/route-list}
(Test/check [{:name "exposes the generated route collector"
              :test (fn [] (fn? routes/route-list))
              :expected true}])

^{:refer postgres.sample.scratch-v0.route-scratch/make-routes}
(Test/check [{:name "exposes the XTalk route materializer"
              :test (fn [] (fn? routes/make-routes))
              :expected true}])
