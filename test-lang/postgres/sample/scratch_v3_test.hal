(ns postgres.sample.scratch-v3-test
  (:require [postgres.sample.scratch-v3 :as scratch]))


^{:refer postgres.sample.scratch-v3/Currency}
(Test/check [{:name "registers Currency in the scratch-v3 application"
              :test (fn [] [(pointer? scratch/Currency)
                             (IPointer/ptr-context scratch/Currency)
                             (not (nil? (get-in scratch/+app+ [:tables 'Currency])))])
              :expected [true :lang/postgres true]}])

^{:refer postgres.sample.scratch-v3/User}
(Test/check [{:name "registers User in the scratch-v3 application"
              :test (fn [] (pointer? scratch/User))
              :expected true}])

^{:refer postgres.sample.scratch-v3/UserProfile}
(Test/check [{:name "registers UserProfile in the scratch-v3 application"
              :test (fn [] (pointer? scratch/UserProfile))
              :expected true}])

^{:refer postgres.sample.scratch-v3/Wallet}
(Test/check [{:name "registers Wallet in the scratch-v3 application"
              :test (fn [] (pointer? scratch/Wallet))
              :expected true}])

^{:refer postgres.sample.scratch-v3/Asset}
(Test/check [{:name "registers Asset in the scratch-v3 application"
              :test (fn [] (pointer? scratch/Asset))
              :expected true}])

^{:refer postgres.sample.scratch-v3/insert-currency}
(Test/check [{:name "registers the currency insert routine"
              :test (fn [] (pointer? scratch/insert-currency))
              :expected true}])

^{:refer postgres.sample.scratch-v3/update-currency}
(Test/check [{:name "registers the currency update routine"
              :test (fn [] (pointer? scratch/update-currency))
              :expected true}])

^{:refer postgres.sample.scratch-v3/delete-currency}
(Test/check [{:name "registers the currency delete routine"
              :test (fn [] (pointer? scratch/delete-currency))
              :expected true}])

^{:refer postgres.sample.scratch-v3/insert-user}
(Test/check [{:name "registers the user insert routine"
              :test (fn [] (pointer? scratch/insert-user))
              :expected true}])

^{:refer postgres.sample.scratch-v3/update-user}
(Test/check [{:name "registers the user update routine"
              :test (fn [] (pointer? scratch/update-user))
              :expected true}])

^{:refer postgres.sample.scratch-v3/delete-user}
(Test/check [{:name "registers the user delete routine"
              :test (fn [] (pointer? scratch/delete-user))
              :expected true}])

^{:refer postgres.sample.scratch-v3/create-user}
(Test/check [{:name "registers the generated-id user creation routine"
              :test (fn [] (pointer? scratch/create-user))
              :expected true}])

^{:refer postgres.sample.scratch-v3/insert-user-profile}
(Test/check [{:name "registers the profile insert routine"
              :test (fn [] (pointer? scratch/insert-user-profile))
              :expected true}])

^{:refer postgres.sample.scratch-v3/update-user-profile}
(Test/check [{:name "registers the profile update routine"
              :test (fn [] (pointer? scratch/update-user-profile))
              :expected true}])

^{:refer postgres.sample.scratch-v3/insert-wallet}
(Test/check [{:name "registers the wallet insert routine"
              :test (fn [] (pointer? scratch/insert-wallet))
              :expected true}])

^{:refer postgres.sample.scratch-v3/ensure-wallet}
(Test/check [{:name "registers the wallet ensure routine"
              :test (fn [] (pointer? scratch/ensure-wallet))
              :expected true}])

^{:refer postgres.sample.scratch-v3/insert-asset}
(Test/check [{:name "registers the asset insert routine"
              :test (fn [] (pointer? scratch/insert-asset))
              :expected true}])

^{:refer postgres.sample.scratch-v3/ensure-asset}
(Test/check [{:name "registers the asset ensure routine"
              :test (fn [] (pointer? scratch/ensure-asset))
              :expected true}])

^{:refer postgres.sample.scratch-v3/asset-credit}
(Test/check [{:name "registers asset crediting"
              :test (fn [] (pointer? scratch/asset-credit))
              :expected true}])

^{:refer postgres.sample.scratch-v3/asset-deduct}
(Test/check [{:name "registers asset deduction"
              :test (fn [] (pointer? scratch/asset-deduct))
              :expected true}])

^{:refer postgres.sample.scratch-v3/get-schema}
(Test/check [{:name "registers the schema accessor"
              :test (fn [] (fn? scratch/get-schema))
              :expected true}])

^{:refer postgres.sample.scratch-v3/get-schema-lookup}
(Test/check [{:name "registers the schema lookup accessor"
              :test (fn [] (fn? scratch/get-schema-lookup))
              :expected true}])

^{:refer postgres.sample.scratch-v3/+app+}
(Test/check [{:name "builds a non-empty scratch-v3 application graph"
              :test (fn [] (count (:tables scratch/+app+)))
              :expected 5}])
