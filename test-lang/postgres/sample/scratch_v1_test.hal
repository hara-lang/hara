(ns postgres.sample.scratch-v1-test
  (:require [lang.core.script :as script]
            [postgres.sample.scratch-v1 :as scratch]))

^{:refer postgres.sample.scratch-v1/as-array}
(Test/check [{:name "registers the jsonb array helper"
              :test (fn [] [(pointer? scratch/as-array)
                             (IPointer/ptr-context scratch/as-array)
                             (get-in (deref script/+modules+) ['postgres.sample.scratch-v1 :code 'as-array :op])])
              :expected [true :lang/postgres 'defn]}])

^{:refer postgres.sample.scratch-v1/TaskCache}
(Test/check [{:name "registers TaskCache as a public PostgreSQL table"
              :test (fn [] [(pointer? scratch/TaskCache)
                             (IPointer/ptr-context scratch/TaskCache)])
              :expected [true :lang/postgres]}])

^{:refer postgres.sample.scratch-v1/Task}
(Test/check [{:name "registers Task with its PostgreSQL pointer context"
              :test (fn [] [(pointer? scratch/Task)
                             (IPointer/ptr-context scratch/Task)])
              :expected [true :lang/postgres]}])

^{:refer postgres.sample.scratch-v1/Entry}
(Test/check [{:name "registers Entry with its PostgreSQL pointer context"
              :test (fn [] [(pointer? scratch/Entry)
                             (IPointer/ptr-context scratch/Entry)])
              :expected [true :lang/postgres]}])

^{:refer postgres.sample.scratch-v1/as-upper}
(Test/check [{:name "registers the SQL upper-case helper"
              :test (fn [] (pointer? scratch/as-upper))
              :expected true}])

^{:refer postgres.sample.scratch-v1/ping}
(Test/check [{:name "registers the ping routine"
              :test (fn [] (pointer? scratch/ping))
              :expected true}])

^{:refer postgres.sample.scratch-v1/ping-ok}
(Test/check [{:name "registers the JSON ping routine"
              :test (fn [] (pointer? scratch/ping-ok))
              :expected true}])

^{:refer postgres.sample.scratch-v1/echo}
(Test/check [{:name "registers the JSON echo routine"
              :test (fn [] (pointer? scratch/echo))
              :expected true}])

^{:refer postgres.sample.scratch-v1/addf}
(Test/check [{:name "registers numeric addition"
              :test (fn [] (pointer? scratch/addf))
              :expected true}])

^{:refer postgres.sample.scratch-v1/subf}
(Test/check [{:name "registers numeric subtraction"
              :test (fn [] (pointer? scratch/subf))
              :expected true}])

^{:refer postgres.sample.scratch-v1/mulf}
(Test/check [{:name "registers numeric multiplication"
              :test (fn [] (pointer? scratch/mulf))
              :expected true}])

^{:refer postgres.sample.scratch-v1/divf}
(Test/check [{:name "registers numeric division"
              :test (fn [] (pointer? scratch/divf))
              :expected true}])

^{:refer postgres.sample.scratch-v1/insert-task}
(Test/check [{:name "registers the Task graph insert routine"
              :test (fn [] (pointer? scratch/insert-task))
              :expected true}])

^{:refer postgres.sample.scratch-v1/insert-entry}
(Test/check [{:name "registers the Entry graph insert routine"
              :test (fn [] (pointer? scratch/insert-entry))
              :expected true}])
