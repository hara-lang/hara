(ns postgres.sample.scratch-v2-test
  (:require [postgres.typed.typed-parse :as parse]
            [postgres.sample.scratch-v2 :as scratch]))

(def analysis (parse/analyze-namespace 'postgres.sample.scratch-v2))

^{:refer postgres.sample.scratch-v2/as-array}
(Test/check [{:name "parses the jsonb helper function"
              :test (fn [] (let [entry (first (filter (fn [value] (= "as-array" (:name value)))
                                                      (:functions analysis)))]
                             [(:name entry) (:output entry)]))
              :expected ["as-array" [:jsonb]]}])

^{:refer postgres.sample.scratch-v2/TaskCache}
(Test/check [{:name "parses TaskCache with an id primary key"
              :test (fn [] (let [entry (first (filter (fn [value] (= "TaskCache" (:name value)))
                                                      (:tables analysis)))]
                             [(:name entry) (:primary-key entry)]))
              :expected ["TaskCache" :id]}])

^{:refer postgres.sample.scratch-v2/Task}
(Test/check [{:name "parses Task's ordered columns"
              :test (fn [] (let [entry (first (filter (fn [value] (= "Task" (:name value)))
                                                      (:tables analysis)))]
                             (vec (map :name (:columns entry)))))
              :expected [:status :name :cache :detail]}])

^{:refer postgres.sample.scratch-v2/Entry}
(Test/check [{:name "parses Entry's columns"
              :test (fn [] (let [entry (first (filter (fn [value] (= "Entry" (:name value)))
                                                      (:tables analysis)))]
                             (vec (map :name (:columns entry)))))
              :expected [:name :tags]}])

^{:refer postgres.sample.scratch-v2/insert-entry}
(Test/check [{:name "keeps insert-entry's JSON output declaration"
              :test (fn [] (let [entry (first (filter (fn [value] (= "insert-entry" (:name value)))
                                                      (:functions analysis)))]
                             [(:name entry) (:output entry)]))
              :expected ["insert-entry" [:jsonb]]}])

^{:refer postgres.sample.scratch-v2/update-entry-tags}
(Test/check [{:name "includes update-entry-tags in the parsed function list"
              :test (fn [] (not (nil? (first (filter (fn [value] (= "update-entry-tags" (:name value)))
                                                    (:functions analysis))))))
              :expected true}])

^{:refer postgres.sample.scratch-v2/insert-task-fields}
(Test/check [{:name "includes insert-task-fields in the parsed function list"
              :test (fn [] (not (nil? (first (filter (fn [value] (= "insert-task-fields" (:name value)))
                                                    (:functions analysis))))))
              :expected true}])

^{:refer postgres.sample.scratch-v2/insert-task-raw}
(Test/check [{:name "includes insert-task-raw in the parsed function list"
              :test (fn [] (not (nil? (first (filter (fn [value] (= "insert-task-raw" (:name value)))
                                                    (:functions analysis))))))
              :expected true}])

^{:refer postgres.sample.scratch-v2/insert-task-wrapped}
(Test/check [{:name "includes the wrapped insert routine in the parsed function list"
              :test (fn [] (not (nil? (first (filter (fn [value] (= "insert-task-wrapped" (:name value)))
                                                    (:functions analysis))))))
              :expected true}])
