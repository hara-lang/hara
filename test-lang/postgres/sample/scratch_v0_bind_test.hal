(ns postgres.sample.scratch-v0-bind-test
  (:require [postgres.sample.scratch-v0.route-scratch :as routes]
            [postgres.sample.scratch-v0.view-log :as views]))

^{:refer postgres.sample.scratch-v0.route-scratch/make-routes}
(Test/check [{:name "retains the route generation surface for bindings"
              :test (fn [] [(fn? routes/route-list) (fn? routes/make-routes)])
              :expected [true true]}])

^{:refer postgres.sample.scratch-v0.view-log/make-views}
(Test/check [{:name "retains the view generation surface for bindings"
              :test (fn [] [(fn? views/view-list) (fn? views/make-views)])
              :expected [true true]}])
