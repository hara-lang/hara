(ns postgres.sample.scratch-v3.realtime-test
  (:require [postgres.sample.scratch-v3.realtime :as realtime]))

^{:refer postgres.sample.scratch-v3.realtime/sync-tables}
(Test/check [{:name "registers the table predicate constructor"
              :test (fn [] (fn? realtime/sync-tables))
              :expected true}])

^{:refer postgres.sample.scratch-v3.realtime/db-sync}
(Test/check [{:name "registers the database event descriptor constructor"
              :test (fn [] (fn? realtime/db-sync))
              :expected true}])

^{:refer postgres.sample.scratch-v3.realtime/payload-id}
(Test/check [{:name "registers realtime payload id extraction"
              :test (fn [] (fn? realtime/payload-id))
              :expected true}])

^{:refer postgres.sample.scratch-v3.realtime/postgres-change->sync-request}
(Test/check [{:name "registers realtime change normalization"
              :test (fn [] (fn? realtime/postgres-change->sync-request))
              :expected true}])

^{:refer postgres.sample.scratch-v3.realtime/postgres-change->update}
(Test/check [{:name "registers realtime patch wrapping"
              :test (fn [] (fn? realtime/postgres-change->update))
              :expected true}])
