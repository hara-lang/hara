(ns postgres.sample.scratch-v3.route-currency-test
  (:require [postgres.sample.scratch-v3.route-currency :as routes]))

^{:refer postgres.sample.scratch-v3.route-currency/route-list}
(Test/check [{:name "registers currency route discovery"
              :test (fn [] (fn? routes/route-list))
              :expected true}])

^{:refer postgres.sample.scratch-v3.route-currency/make-routes}
(Test/check [{:name "registers currency route materialization"
              :test (fn [] (fn? routes/make-routes))
              :expected true}])
