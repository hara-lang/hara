(ns postgres.sample.scratch-v3.route-currency-test
  (:require [postgres.sample.scratch-v3.route-currency :as routes]))

^{:refer postgres.sample.scratch-v3.route-currency/route-list}
(Test/check [{:name "discovers all bound Currency mutation routes"
              :test (fn [] (count (routes/route-list)))
              :expected 4}
             {:name "binds each route with a schema-qualified url and return type"
              :test (fn []
                      (vec (map (fn [route] [(:url route) (:type route) (:schema route)])
                                (routes/route-list))))
              :expected [["api/currency/update-currency" "route" "scratch_v3"]
                         ["api/currency/insert-currency" "route" "scratch_v3"]
                         ["api/currency/delete-currency" "route" "scratch_v3"]
                         ["api/currency/update-user-profile" "route" "scratch_v3"]]}
             {:name "resolves the compiled return type for each function"
              :test (fn [] (set (map :return (routes/route-list))))
              :expected #{"jsonb"}}])

^{:refer postgres.sample.scratch-v3.route-currency/make-routes}
(Test/check [{:name "registers currency route materialization"
              :test (fn [] (fn? routes/make-routes))
              :expected true}])
