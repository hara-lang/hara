(ns postgres.sample.scratch-v3.view-currency-test
  (:require [postgres.sample.scratch-v3.view-currency :as views]))

^{:refer postgres.sample.scratch-v3.view-currency/view-list}
(Test/check [{:name "registers currency view discovery"
              :test (fn [] (fn? views/view-list))
              :expected true}])

^{:refer postgres.sample.scratch-v3.view-currency/make-views}
(Test/check [{:name "registers currency view materialization"
              :test (fn [] (fn? views/make-views))
              :expected true}])
