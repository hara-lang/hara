(ns postgres.core.impl-insert-test
  (:require [postgres.core.impl-insert :as insert]))

(def table-schema
  {:id [{:type :uuid :primary true :required true :order 0}]
   :status [{:type :enum :order 1 :enum {:ns 'demo/Status}}]})

^{:refer postgres.core.impl-insert/t-insert-form}
(Test/check
 [{:name "constructs the archive insert column and values form"
   :test (fn [] (insert/t-insert-form table-schema [:id :status] '("a" "open")))
   :expected '[(>-< [#{"id"} #{"status"}]) :values (>-< ["a" "open"])]}])
