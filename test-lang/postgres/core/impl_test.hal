(ns postgres.core.impl-test
  (:require [lang.core.script :as script]
            [postgres.core.impl :as impl]))

^{:refer postgres.core.impl/t:insert}
(Test/check [{:name "registers the archived pg/t:insert source macro"
              :test (fn [] (let [entry (get-in (deref script/+modules+)
                                                ['postgres.core :fragment 't:insert])]
                             [(fn? (:template entry))
                              (:op entry)
                              (first (:form entry))]))
              :expected [true 'defmacro 'defmacro]}])
