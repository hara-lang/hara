(ns postgres.core.impl-test
  (:require [lang.core.impl :as core-impl]
            [lang.core.library :as library]
            [postgres.core.impl :as impl]))

^{:refer postgres.core.impl/t:insert}
(Test/check [{:name "registers the archived pg/t:insert source macro"
              :test (fn [] (let [entry (get-in (library/get-module
                                                (core-impl/runtime-library)
                                                :postgres
                                                'postgres.core)
                                               [:fragment 't:insert])]
                             [(fn? (:template entry))
                              (:op entry)
                              (first (:form entry))]))
              :expected [true 'defmacro 'fn]}])
