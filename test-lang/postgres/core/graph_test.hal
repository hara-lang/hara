(ns postgres.core.graph-test
  (:require [postgres.core :as pg]))

^{:refer postgres.core.graph/g:where}
(Test/check [{:name "publishes the graph where macro"
              :test (fn [] (fn? pg/g:where))
              :expected true}])

^{:refer postgres.core.graph/g:id}
(Test/check [{:name "publishes the graph id macro"
              :test (fn [] (fn? pg/g:id))
              :expected true}])

^{:refer postgres.core.graph/g:count}
(Test/check [{:name "constructs a count lookup"
              :test (fn [] (fn? pg/g:count))
              :expected true}])

^{:refer postgres.core.graph/g:exists}
(Test/check [{:name "constructs an existence lookup"
              :test (fn [] (fn? pg/g:exists))
              :expected true}])

^{:refer postgres.core.graph/g:select}
(Test/check [{:name "constructs a graph select"
              :test (fn [] (fn? pg/g:select))
              :expected true}])

^{:refer postgres.core.graph/g:get}
(Test/check [{:name "constructs a single-row graph select"
              :test (fn [] (fn? pg/g:get))
              :expected true}])

^{:refer postgres.core.graph/g:update}
(Test/check [{:name "constructs a graph update"
              :test (fn [] (fn? pg/g:update))
              :expected true}])

^{:refer postgres.core.graph/g:modify}
(Test/check [{:name "constructs a graph modify"
              :test (fn [] (fn? pg/g:modify))
              :expected true}])

^{:refer postgres.core.graph/g:delete}
(Test/check [{:name "constructs a graph delete"
              :test (fn [] (fn? pg/g:delete))
              :expected true}])

^{:refer postgres.core.graph/g:insert}
(Test/check [{:name "constructs a graph insert"
              :test (fn [] (fn? pg/g:insert))
              :expected true}])

^{:refer postgres.core.graph/q}
(Test/check [{:name "constructs a graph query"
              :test (fn [] (fn? pg/q))
              :expected true}])

^{:refer postgres.core.graph/q:get}
(Test/check [{:name "constructs a single-row graph query"
              :test (fn [] (fn? pg/q:get))
              :expected true}])

^{:refer postgres.core.graph/view}
(Test/check [{:name "publishes the graph view composition macro"
              :test (fn [] (fn? pg/view))
              :expected true}])
