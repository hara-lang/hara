(ns postgres.core.builtin-test
  (:require [lang.core.script :as script]
            [postgres.core.builtin :as builtin]))

^{:refer postgres.core.builtin/uuid-generate-v4}
(Test/check [{:name "registers uuid-generate-v4 as a PostgreSQL builtin fragment"
              :test (fn [] (let [entry (get-in (deref script/+modules+)
                                                ['postgres.core :fragment 'uuid-generate-v4])]
                             [(pointer? builtin/uuid-generate-v4)
                              (IPointer/ptr-context builtin/uuid-generate-v4)
                              (:op entry)
                              (:form entry)]))
              :expected [true :lang/postgres 'def$ 'uuid-generate-v4]}])
