(ns postgres.core.impl-main-test
  (:require [postgres.core.impl-main :as main]))

(def table-schema
  {:id [{:type :uuid :primary true :required true :order 0}]
   :status [{:type :text :order 1}]
   :name [{:type :text :order 2}]})

(def prepared [{:id 'Entry :module 'demo} table-schema {}])

^{:refer postgres.core.impl-main/t-select-raw}
(Test/check
 [{:name "constructs archive select forms for raw and JSON output"
   :test (fn [] [(main/t-select-raw prepared {:as :raw})
                 (main/t-select-raw prepared {:returning #{:id :name}})])
   :expected ['[:select * :from demo/Entry]
              '[:with j-ret :as [:select (--- [#{"id"} #{"name"}]) :from demo/Entry]
                \\ :select (jsonb-agg j-ret) :from j-ret]]}])

^{:refer postgres.core.impl-main/t-delete-raw}
(Test/check
 [{:name "keeps raw DELETE output unwrapped when no RETURNING form is requested"
   :test (fn [] (main/t-delete-raw prepared {:as :raw :where {:id "entry-1"}}))
   :expected '[:delete :from demo/Entry :where {"id" [:eq "entry-1"]}]}])
