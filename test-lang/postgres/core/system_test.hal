(ns postgres.core.system-test
  (:require [lang.core.script :as script]
            [postgres.core.system :as sys]))

^{:refer postgres.core.system/pg-tmpl}
(Test/check [{:name "creates the canonical PostgreSQL template form"
              :test (fn [] (sys/pg-tmpl 'hello))
              :expected '(def$.pg hello pg-hello)}])

^{:refer postgres.core.system/jit-available}
(Test/check [{:name "registers the archived jit-available system builtin"
              :test (fn [] (let [entry (get-in (deref script/+modules+)
                                                ['postgres.core :fragment 'jit-available])]
                             [(pointer? sys/jit-available)
                              (IPointer/ptr-context sys/jit-available)
                              (:op entry)
                              (count sys/+system+)]))
              :expected [true :lang/postgres 'def$ 332]}])
