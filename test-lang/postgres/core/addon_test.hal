(ns postgres.core.addon-test
  (:require [postgres.core.addon :as addon]))

^{:refer postgres.core.addon/resolved-entry}
(Test/check [{:name "keeps portable maps"
              :test (fn [] (addon/resolved-entry {:id 'Task}))
              :expected {:id 'Task}}])
^{:refer postgres.core.addon/exec}
(Test/check [{:name "returns SQL input"
              :test (fn [] (addon/exec [:select 1])) :expected [:select 1]}])
^{:refer postgres.core.addon/ARRAY}
(Test/check [{:name "creates an array operation"
              :test (fn [] (first (addon/ARRAY 1 2))) :expected 'pg:array}])
^{:refer postgres.core.addon/id}
(Test/check [{:name "creates id extraction"
              :test (fn [] (first (addon/id 'row))) :expected :uuid}])
^{:refer postgres.core.addon/name}
(Test/check [{:name "reads entry id"
              :test (fn [] (addon/name {:id 'Task})) :expected '(quote Task)}])
^{:refer postgres.core.addon/full}
(Test/check [{:name "creates full coordinate"
              :test (fn [] (first (addon/full {:id 'Task :static/schema "scratch"})))
              :expected 'jsonb-build-array}])
^{:refer postgres.core.addon/full-str}
(Test/check [{:name "stringifies full coordinate"
              :test (fn [] (string? (addon/full-str {:id 'Task :static/schema "scratch"})))
              :expected true}])
^{:refer postgres.core.addon/coord}
(Test/check [{:name "creates row coordinate"
              :test (fn [] (first (addon/coord {:id 'Task :static/schema "scratch"} "id")))
              :expected 'jsonb-build-array}])
^{:refer postgres.core.addon/rand-hex}
(Test/check [{:name "creates random hex expression"
              :test (fn [] (first (addon/rand-hex 10))) :expected 'encode}])
^{:refer postgres.core.addon/sha1}
(Test/check [{:name "creates SHA1 expression"
              :test (fn [] (first (addon/sha1 'value))) :expected 'encode}])
^{:refer postgres.core.addon/client-list}
(Test/check [{:name "selects client activity"
              :test (fn [] (first (addon/client-list))) :expected :select}])
^{:refer postgres.core.addon/time-ms}
(Test/check [{:name "creates millisecond expression"
              :test (fn [] (first (addon/time-ms))) :expected :bigint}])
^{:refer postgres.core.addon/time-us}
(Test/check [{:name "creates microsecond expression"
              :test (fn [] (first (addon/time-us))) :expected :bigint}])
^{:refer postgres.core.addon/throw}
(Test/check [{:name "creates exception form"
              :test (fn [] (first (addon/throw {:a 1}))) :expected 'pg:throw}])
^{:refer postgres.core.addon/error}
(Test/check [{:name "creates error form"
              :test (fn [] (first (addon/error [1 2]))) :expected 'pg:throw}])
^{:refer postgres.core.addon/assert}
(Test/check [{:name "creates assertion form"
              :test (fn [] (first (addon/assert '(exists 1) [:wrong {}]))) :expected 'pg:assert}])
^{:refer postgres.core.addon/case}
(Test/check [{:name "creates case grammar"
              :test (fn [] (addon/case 1 2 3 4 :else 5))
              :expected [:case :when 1 :then 2 :when 3 :then 4 :else 5 :end]}])
^{:refer postgres.core.addon/get-stack-diagnostics}
(Test/check [{:name "creates diagnostics form"
              :test (fn [] (first (addon/get-stack-diagnostics)))
              :expected :pg-stack-diagnostics}])
^{:refer postgres.core.addon/field-id}
(Test/check [{:name "creates field id extraction"
              :test (fn [] (first (addon/field-id 'm :field))) :expected 'coalesce}])
^{:refer postgres.core.addon/map:rel}
(Test/check [{:name "creates relation aggregate"
              :test (fn [] (first (addon/map:rel 'f 'rel))) :expected '%}])
^{:refer postgres.core.addon/map:js-text}
(Test/check [{:name "creates text JSON aggregate"
              :test (fn [] (first (addon/map:js-text 'f 'arr))) :expected '%}])
^{:refer postgres.core.addon/map:js}
(Test/check [{:name "creates JSON aggregate"
              :test (fn [] (first (addon/map:js 'f 'arr))) :expected '%}])
^{:refer postgres.core.addon/do:reduce}
(Test/check [{:name "creates reduce operation"
              :test (fn [] (first (addon/do:reduce 'out 'f :jsonb 'arr)))
              :expected 'pg:reduce}])
^{:refer postgres.core.addon/b:select}
(Test/check [{:name "creates select body"
              :test (fn [] (first (addon/b:select 1))) :expected :select}])
^{:refer postgres.core.addon/ret}
(Test/check [{:name "creates return body"
              :test (fn [] (first (addon/ret 1))) :expected :select}])
^{:refer postgres.core.addon/b:update}
(Test/check [{:name "creates update body"
              :test (fn [] (first (addon/b:update 'table {}))) :expected :update}])
^{:refer postgres.core.addon/b:insert}
(Test/check [{:name "creates insert body"
              :test (fn [] (first (addon/b:insert 'table {}))) :expected :insert}])
^{:refer postgres.core.addon/b:delete}
(Test/check [{:name "creates delete body"
              :test (fn [] (first (addon/b:delete 'table))) :expected :delete}])
^{:refer postgres.core.addon/perform}
(Test/check [{:name "creates perform body"
              :test (fn [] (first (addon/perform 1))) :expected :perform}])
^{:refer postgres.core.addon/random-enum}
(Test/check [{:name "creates random enum selection"
              :test (fn [] (first (addon/random-enum 'Status))) :expected :select}])
^{:refer postgres.core.addon/do:plpgsql}
(Test/check [{:name "creates PLpgSQL body"
              :test (fn [] (first (addon/do:plpgsql '(return 1))))
              :expected :pg-do-plpgsql}])
