(ns postgres.core-test
  (:require [postgres.core :as pg]
            [postgres.core.graph-view :as view]))

^{:refer postgres.core/defsel.pg}
(Test/check [{:name "publishes select-view definitions from the canonical facade"
              :test (fn [] (fn? pg/defsel.pg))
              :expected true}])

^{:refer postgres.core/defret.pg}
(Test/check [{:name "publishes return-view definitions from the canonical facade"
              :test (fn [] (fn? pg/defret.pg))
              :expected true}])

^{:refer postgres.core/view}
(Test/check [{:name "publishes the graph view macro"
              :test (fn [] (fn? pg/view))
              :expected true}])

^{:refer postgres.core/registry-snapshot}
(Test/check [{:name "publishes reversible graph registry state"
              :test (fn [] (let [snapshot (view/registry-snapshot)]
                           (try
                             (pg/reset-registry!)
                             (pg/registry-snapshot)
                             (finally
                               (pg/restore-registry! snapshot)))))
              :expected {:views {} :tables {}}}])

^{:refer postgres.core/t-select}
(Test/check [{:name "publishes typed select construction"
              :test (fn [] (fn? pg/t-select))
              :expected true}])

^{:refer postgres.core/t-insert}
(Test/check [{:name "publishes typed insert construction"
              :test (fn [] (fn? pg/t-insert))
              :expected true}])

^{:refer postgres.core/t-update}
(Test/check [{:name "publishes typed update construction"
              :test (fn [] (fn? pg/t-update))
              :expected true}])

^{:refer postgres.core/query-fn}
(Test/check [{:name "publishes graph query composition"
              :test (fn [] (fn? pg/query-fn))
              :expected true}])

^{:refer postgres.core/app-create}
(Test/check [{:name "publishes PostgreSQL application assembly"
              :test (fn [] (fn? pg/app-create))
              :expected true}])
