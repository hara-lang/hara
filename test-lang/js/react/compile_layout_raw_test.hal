(ns js.react.compile-layout-raw-test
  (:require [js.react.compile :as compile]))

^{:refer js.react.compile/compile-layout-raw}
(Test/check
 [{:name "expands a simple namespaced component layout"
   :test (fn []
           (compile/compile-layout-raw
            [:ui/text "hello"]
            {:ui/text {:tag :span :props {} :children [:props/children]
                       :deps #{}}}))
   :expected [:span {} "hello"]}])
