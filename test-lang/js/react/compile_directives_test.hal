(ns js.react.compile-directives-test
  (:require [js.react.compile-directives :as directives]))

^{:refer js.react.compile-directives/compile-directives}
(Test/check
 [{:name "compiles a vertical directive through the Tailwind helper"
   :test (fn []
           (directives/compile-directives
            '[:*/v {:class ["gap-2"]} "body"]
            {}))
   :expected [:div {:class ["flex" "flex-col" "gap-2"]} "body"]}])
