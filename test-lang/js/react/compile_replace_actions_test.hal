(ns js.react.compile-replace-actions-test
  (:require [js.react.compile :as compile]))

^{:refer js.react.compile/compile-replace-actions}
(Test/check
 [{:name "replaces namespaced action references"
   :test (fn []
           (compile/compile-replace-actions
            [:button :action/save]
            {:action/save '(save)}))
   :expected [:button '(save)]}])
