(ns js.react.compile-triggers-test
  (:require [js.react.compile :as compile]))

^{:refer js.react.compile/compile-triggers}
(Test/check
 [{:name "emits watched React effects"
   :test (fn []
           (compile/compile-triggers
            {:trigger/watch {:%/action '(do (:var/count 1))
                             :%/watch [:var/count]}}))
   :expected ['(React.useEffect (do (setCount 1)) [count])]}])
