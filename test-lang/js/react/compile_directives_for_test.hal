(ns js.react.compile-directives-for-test
  (:require [js.react.compile-directives :as directives]))

(Test/check
 [{:name "compiles loop directives into keyed map expressions"
   :test (fn []
           (directives/compile-directives
            '[:*/for [[index item] items] item]
            {}))
   :expected '(. items
                (map (fn [item index]
                       (return [:<> {:key index} item]))))}])
