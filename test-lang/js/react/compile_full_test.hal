(ns js.react.compile-full-test
  (:require [js.react.compile :as compile]))

^{:refer js.react.compile/compile-full}
(Test/check
 [{:name "emits a complete React UI do form"
   :test (fn []
           (compile/compile-full
            {:states {:var/count 0}
             :triggers {}
             :actions {}
             :layout [:ui/text :var/count]
             :components {:ui/text [:span]}}))
   :expected '(do
               (var [count setCount] (React.useState 0))
               (return [:span {} count]))}])
