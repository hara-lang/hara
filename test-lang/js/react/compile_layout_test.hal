(ns js.react.compile-layout-test
  (:require [js.react.compile :as compile]))

^{:refer js.react.compile/compile-layout}
(Test/check
 [{:name "resolves components before compiling a layout"
   :test (fn []
           (compile/compile-layout
            [:ui/text "hello"]
            {:ui/text [:span]}))
   :expected [:span {} "hello"]}])
