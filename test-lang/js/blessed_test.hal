(ns js.blessed-test
  (:require [lang.core.script :as script]
            [js.blessed :as blessed]))

^{:refer js.blessed/canvas}
(Test/check
 [{:name "registers the final drawille canvas macro"
   :test (fn []
           (let [module (get (deref script/+modules+) 'js.blessed)]
             [(:lang module)
              (has? (:fragment module) 'canvas)
              (has? (:code module) 'createScreen)
              (has? (:code module) 'run)]))
   :expected [:js true true true]}])

^{:refer js.blessed/createScreen}
(Test/check
 [{:name "registers createScreen in the JavaScript module"
   :test (fn []
           (let [entry (get-in (deref script/+modules+)
                               ['js.blessed :code 'createScreen])]
             [(:id entry) (:lang entry) (:section entry)]))
   :expected ['createScreen :js :code]}])

^{:refer js.blessed/run}
(Test/check
 [{:name "registers run in the JavaScript module"
   :test (fn []
           (let [entry (get-in (deref script/+modules+)
                               ['js.blessed :code 'run])]
             [(:id entry) (:lang entry) (:section entry)]))
   :expected ['run :js :code]}])
