(ns js.core.util-test
  (:require [lang.core :as l])
  (:use code.test))

(l/script- :js
  {:runtime :basic
   :require [[js.core.util :as util]
             [xt.lang.spec-base :as xt]]})

(fact:global
 {:setup [(l/rt:restart)]
  :teardown [(l/rt:stop)]})

^{:refer js.core.util/pass-callback :added "4.0"}
(fact "node style callback"
  (!.js
   [(util/pass-callback nil "ok")
    (do:>
     (try
      (util/pass-callback "broken" nil)
      (catch err
       (return err))))])
  => ["ok" "broken"])

^{:refer js.core.util/wrap-callback :added "4.0"}
(fact "wraps promise with node style callback"
  (!.js
   (var seen nil)
   (util/wrap-callback
    {:then (fn [resolve _] (resolve "done"))}
    (fn [err res]
      (:= seen [err res])))
   seen)
  => [nil "done"]

  (!.js
   (var failed nil)
   (util/wrap-callback
    {:then (fn [_ reject] (reject "broken"))}
    (fn [err res]
      (:= failed [err res])))
   failed)
  => ["broken" nil])
