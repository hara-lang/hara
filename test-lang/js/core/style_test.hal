(ns js.core.style-test
  (:require [lang.core :as l]
            [lang.core.library :as library])
  (:use code.test))

(l/script- :js
  {:runtime :basic
   :require [[js.core.style :as style]]})

(fact:global
 {:setup [(l/rt:restart)]
 :teardown [(l/rt:stop)]})

(fact "registers the configured target module and self link"
  (let [module (library/library-get-source-module (library/runtime-library)
                                                   :js
                                                   'js.core.style)]
    [(:id module) (get-in module [:link '-])])
  => ['js.core.style 'js.core.style])

^{:refer js.core.style/rect :added "4.0"}
(fact "creates square and rectangular styles"
  (!.js [(style/rect 4)
         (style/rect 4 10)])
  => [{"width" 4 "height" 4}
      {"width" 4 "height" 10}])

^{:refer js.core.style/padding :added "4.0"}
(fact "expands CSS padding shorthand"
  (!.js [(style/padding 4)
         (style/padding 4 10 6 2)])
  => [{"paddingTop" 4 "paddingRight" 4 "paddingBottom" 4 "paddingLeft" 4}
      {"paddingTop" 4 "paddingRight" 10 "paddingBottom" 6 "paddingLeft" 2}])

^{:refer js.core.style/margin :added "4.0"}
(fact "expands CSS margin shorthand"
  (!.js [(style/margin 0 10)
         (style/margin 4 10 6 2)])
  => [{"marginTop" 0 "marginRight" 10 "marginBottom" 0 "marginLeft" 10}
      {"marginTop" 4 "marginRight" 10 "marginBottom" 6 "marginLeft" 2}])

^{:refer js.core.style/align :added "4.0"}
(fact "creates default and explicit flex alignment"
  (!.js [(style/align "center")
         (style/align "center" "flex-end" "space-between")])
  => [{"flex" 1 "justifyContent" "center" "alignItems" "center"}
      {"flex" 1 "justifyContent" "center" "alignItems" "flex-end"
       "alignContent" "space-between"}])

^{:refer js.core.style/pos :added "4.0"}
(fact "creates position styles with optional offsets"
  (!.js [(style/pos "absolute")
         (style/pos "fixed" {:top 3 :left 2})])
  => [{"position" "absolute"}
      {"position" "fixed" "top" 3 "left" 2}])

^{:refer js.core.style/fillAbsolute :added "4.0"}
(fact "fills an absolute parent"
  (!.js (var output (style/fillAbsolute))
         output)
  => {"position" "absolute" "top" 0 "bottom" 0 "left" 0 "right" 0})

^{:refer js.core.style/centered :added "4.0"}
(fact "creates centered flex alignment"
  (!.js (var centered-output (style/centered))
         centered-output)
  => {"justifyContent" "center" "alignContent" "center" "alignItems" "center"})

^{:refer js.core.style/hue->rgb :added "4.0"}
(fact "interpolates hue segments and normalizes a wrapped hue"
  (!.js [(style/hue->rgb 0.24 0.56 0.97)
         (style/hue->rgb 0.24 0.56 -0.03)])
  => [0.24 0.24])

^{:refer js.core.style/hsl->rgb-fn :added "4.0"}
(fact "converts chromatic and grayscale HSL values to RGB"
  (!.js [(style/hsl->rgb-fn {:h 230 :s 40 :l 40})
         (style/hsl->rgb-fn {:h 0 :s 0 :l 40})])
  => [[61 75 143] [102 102 102]])

^{:refer js.core.style/hsl->rgb-string :added "4.0"}
(fact "formats a lowercase CSS colour string"
  (!.js (style/hsl->rgb-string {:h 230 :s 40 :l 40}))
  => "#3d4b8f")

^{:refer js.core.style/hsl->rgb :added "4.0"}
(fact "expands HSL style shorthand to the CSS colour result"
  (!.js (style/hsl->rgb {:h 230 :s 40 :l 40}))
  => "#3d4b8f")
