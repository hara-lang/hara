(ns work.flow.make.github-test
  (:require [work.flow.make.common :as common]
            [work.flow.make.github :as github]))

(defn config []
  (common/make-config-fn {:root "test-temp/github" :build "build" :default []}))

^{:refer work.flow.make.github/with-verbose}
(Test/check
 [{:name "binds the verbose command boundary"
   :test (fn [] (github/with-verbose false github/*verbose*))
   :expected false}])

^{:refer work.flow.make.github/gh-sh-opts}
(Test/check
 [{:name "uses the configured build directory as command cwd"
   :test (fn [] (github/gh-sh-opts (config)))
   :expected {:cwd "test-temp/github/build"}}])

^{:refer work.flow.make.github/gh-run}
(Test/check
 [{:name "reports the unavailable process capability in the native test host"
   :test (fn []
           (try
             (github/gh-run ["printf" "ok"] {})
             false
             (catch error
               (= :process-unavailable
                  (:tool.sh/error (ex-data error))))))
   :expected true}])

^{:refer work.flow.make.github/gh-commit}
(Test/check
 [{:name "exposes git commit execution"
   :test (fn [] (function? github/gh-commit))
   :expected true}])

^{:refer work.flow.make.github/gh-push}
(Test/check
 [{:name "exposes git push execution"
   :test (fn [] (function? github/gh-push))
   :expected true}])

^{:refer work.flow.make.github/gh-save}
(Test/check
 [{:name "exposes commit and push composition"
   :test (fn [] (function? github/gh-save))
   :expected true}])

^{:refer work.flow.make.github/gh-user}
(Test/check
 [{:name "reads the GitHub user environment boundary"
   :test (fn [] (or (nil? (github/gh-user)) (string? (github/gh-user))))
   :expected true}])

^{:refer work.flow.make.github/gh-token}
(Test/check
 [{:name "reads the GitHub token environment boundary"
   :test (fn [] (or (nil? (github/gh-token)) (string? (github/gh-token))))
   :expected true}])

^{:refer work.flow.make.github/gh-exists?}
(Test/check
 [{:name "exposes remote repository lookup"
   :test (fn [] (function? github/gh-exists?))
   :expected true}])

^{:refer work.flow.make.github/gh-setup-remote}
(Test/check
 [{:name "exposes remote repository setup"
   :test (fn [] (function? github/gh-setup-remote))
   :expected true}])

^{:refer work.flow.make.github/gh-setup-local-init}
(Test/check
 [{:name "exposes local repository initialization"
   :test (fn [] (function? github/gh-setup-local-init))
   :expected true}])

^{:refer work.flow.make.github/gh-setup-local-clone}
(Test/check
 [{:name "exposes local repository cloning"
   :test (fn [] (function? github/gh-setup-local-clone))
   :expected true}])

^{:refer work.flow.make.github/gh-clone}
(Test/check
 [{:name "exposes guarded cloning"
   :test (fn [] (function? github/gh-clone))
   :expected true}])

^{:refer work.flow.make.github/gh-setup}
(Test/check
 [{:name "exposes complete repository setup"
   :test (fn [] (function? github/gh-setup))
   :expected true}])

^{:refer work.flow.make.github/gh-local-purge}
(Test/check
 [{:name "exposes local source purge"
   :test (fn [] (function? github/gh-local-purge))
   :expected true}])

^{:refer work.flow.make.github/gh-refresh}
(Test/check
 [{:name "reports the deferred refresh operation"
   :test (fn [] (try (github/gh-refresh {}) false (catch error true)))
   :expected true}])

^{:refer work.flow.make.github/source-head-message}
(Test/check
 [{:name "reports the unavailable process capability in the native test host"
   :test (fn []
           (try
             (github/source-head-message)
             false
             (catch error
               (= :process-unavailable
                  (:tool.sh/error (ex-data error))))))
   :expected true}])

^{:refer work.flow.make.github/gh-dwim-init}
(Test/check
 [{:name "exposes combined initialization"
   :test (fn [] (function? github/gh-dwim-init))
   :expected true}])

^{:refer work.flow.make.github/gh-dwim-push}
(Test/check
 [{:name "exposes combined push"
   :test (fn [] (function? github/gh-dwim-push))
   :expected true}])
