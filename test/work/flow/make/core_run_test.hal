(ns work.flow.make.core-run-test
  (:require [work.flow.make.core :as core]
            [work.flow.make.host :as host]))

(defn definition-fixture []
  {:make/id :fixture
   :trigger-policy :manual
   :default []
   :targets {:build [{:id :build
                      :compile (fn [_ _ input _] (+ input 1))}]}})

^{:refer work.flow.make.core/run}
(Test/check
 [{:name "evaluates a selected target through native Work"
   :test (fn [] (let [value (host/create (core/compile (definition-fixture)))
                      result (deref (core/run value :build 4))]
                  [(:make/target result)
                   (:make/input result)
                   (:make/value (first (:make/results result)))
                   (:make/count result)]))
   :expected [:build 4 5 1]}])
