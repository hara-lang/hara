(ns work.flow.task-test
  (:require [work.flow :as flow]
            [work.flow.task]
            [work.flow.task.command-task]))

(defn fixture-profile
  []
  {:workflow/path [:task]
   :workflow/flow work.flow.task/flow
   :workflow/options {:defaults {:on-error :fail}
                      :on-error :record}})

(defn fixture-definition
  []
  {:run (fn [value context] value)})

^{:refer work.flow.task/profile-definition-options}
(Test/check
 [{:name "merges task profile defaults with direct options"
   :test (fn [] (work.flow.task/profile-definition-options (fixture-profile)))
   :expected {:on-error :record}}])

^{:refer work.flow.task/normalise}
(Test/check
 [{:name "adds the qualified name when task definitions omit an id"
   :test (fn [] (select-keys (work.flow.task/normalise (fixture-profile) :fixture/task
                                                      (fixture-definition))
                              [:id :on-error]))
   :expected {:id :fixture/task :on-error :record}}])

^{:refer work.flow.task/compile}
(Test/check
 [{:name "compiles task definitions to native Work bundles"
   :test (fn [] (let [bundle (work.flow.task/compile (assoc (fixture-definition) :id :fixture/task))]
                 [(Work/plan? (:work/plan bundle))
                  (work.flow.task.command-task/task-work? bundle)]))
   :expected [true true]}])

^{:refer work.flow.task/invoke}
(Test/check
 [{:name "evaluates compiled task bundles"
   :test (fn [] (let [bundle (work.flow.task/compile {:id :fixture
                                                        :run (fn [value context] (* value 2))})]
                 (:data (deref (work.flow.task/invoke bundle 3)))))
   :expected 6}])

^{:refer work.flow.task/command-route}
(Test/check
 [{:name "adapts compiled tasks to native Command routes"
   :test (fn [] (let [route (work.flow.task/command-route
                             {:id :fixture :path ["fixture"] :desc "Fixture"}
                             (work.flow.task/compile {:id :fixture
                                                      :run (fn [value context] value)}))]
                 [(:id route) (:path route) (fn? (:handler route))]))
   :expected [:fixture ["fixture"] true]}])

^{:refer work.flow.task/reconcile}
(Test/check
 [{:name "uses the latest compiled candidate"
   :test (fn [] (work.flow.task/reconcile (fixture-profile) :previous :candidate :definition))
   :expected :candidate}])

^{:refer work.flow.task/matches?}
(Test/check
 [{:name "publishes the shared selector matcher at the task root"
   :test (fn [] [(work.flow.task/matches? 'demo 'demo.core)
                 (work.flow.task/matches? 'other 'demo.core)])
   :expected [true false]}])

^{:refer work.flow.task/select}
(Test/check
 [{:name "publishes shared selector selection at the task root"
   :test (fn [] (work.flow.task/select 'demo ['demo.core 'other.core]))
   :expected ['demo.core]}])

^{:refer work.flow.task/matches-options?}
(Test/check
 [{:name "publishes shared metadata matching at the task root"
   :test (fn [] [(work.flow.task/matches-options? {:unit #{:web}} {})
                 (work.flow.task/matches-options? {:unit #{:web}} {:include [{:unit #{:db}}]})])
   :expected [false false]}])

^{:refer work.flow.task/collection-match?}
(Test/check
 [{:name "publishes collection matching at the task root"
   :test (fn [] [(work.flow.task/collection-match? #{:web} #{:web :slow})
                 (work.flow.task/collection-match? #{:db} #{:web :slow})])
   :expected [true false]}])

^{:refer work.flow.task/filter-match?}
(Test/check
 [{:name "publishes metadata filter matching at the task root"
   :test (fn [] (work.flow.task/filter-match?
                 {:namespace 'demo.core}
                 {:namespaces ['demo]}
                 false))
   :expected [false false true]}])

^{:refer work.flow.task/include-match?}
(Test/check
 [{:name "publishes include matching at the task root"
   :test (fn [] (work.flow.task/include-match?
                 {:unit #{:web}}
                 {:unit #{:web}}))
   :expected true}])

^{:refer work.flow.task/exclude-match?}
(Test/check
 [{:name "publishes exclude matching at the task root"
   :test (fn [] [(work.flow.task/exclude-match?
                  {:unit #{:web}}
                  {:unit #{:web}})
                 (work.flow.task/exclude-match?
                  {:unit #{:web}}
                  {:unit #{:db}})])
   :expected [true false]}])

^{:refer work.flow.task/within-namespace?}
(Test/check
 [{:name "publishes namespace subtree matching at the task root"
   :test (fn [] [(work.flow.task/within-namespace? 'demo 'demo.core)
                 (work.flow.task/within-namespace? 'demo 'demography)])
   :expected [true false]}])

^{:refer work.flow.task/base-namespace?}
(Test/check
 [{:name "publishes Foundation base matching at the task root"
   :test (fn [] [(work.flow.task/base-namespace? 'demo 'demo.base.io)
                 (work.flow.task/base-namespace? 'demo 'demo.app)])
   :expected [true false]}])

^{:refer work.flow.task/foundation-match?}
(Test/check
 [{:name "publishes Foundation tagged matching at the task root"
   :test (fn [] [(work.flow.task/foundation-match? '[demo :complete] 'demo.app)
                 (work.flow.task/foundation-match? '[demo :base] 'demo.base.io)])
   :expected [true true]}])
