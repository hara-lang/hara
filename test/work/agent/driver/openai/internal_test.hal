(ns work.agent.driver.openai.internal-test
  (:require [work.agent :as agent]
            [work.agent.driver.openai.internal :as internal]))

(def client
  (agent/openai-client
   {:model "gpt-5"
    :transport (fn [request] {:id "response" :status "completed" :output []})}))

^{:refer work.agent.driver.openai.internal/configuration}
(Test/check
 [{:name "normalizes driver options into an execution configuration"
   :test (fn []
           (let [value (internal/configuration
                        {:client client :max-turns 3 :max-tool-calls 4}
                        {:agent/id :one})]
             [(:client value)
              (:max-turns value)
              (:max-tool-calls value)
              (:tools value)
              (:tool-index value)]))
   :expected [client 3 4 [] {}]}])
