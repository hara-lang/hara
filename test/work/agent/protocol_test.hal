(ns work.agent.protocol-test
  (:require [work.agent.protocol :as protocol]
            [work.agent.ephemeral :as ephemeral]))

(def agent (ephemeral/agent {:agent/id :one}))
(def driver (ephemeral/driver (fn [a i c] :driven)))
(def coordinator (ephemeral/coordinator))
(def authority (ephemeral/authority :authority))

^{:refer work.agent.protocol/IAgent}
(Test/check
 [{:name "declares the agent specification protocol"
   :test (fn []
           [(satisfies? protocol/IAgent agent)
            (protocol/agent-spec agent)])
   :expected [true {:agent/id :one}]}])

^{:refer work.agent.protocol/IAgentDriver}
(Test/check
 [{:name "declares the driver lowering protocol"
   :test (fn []
           [(satisfies? protocol/IAgentDriver driver)
            (protocol/agent-drive driver {} :intent {})])
   :expected [true :driven]}])

^{:refer work.agent.protocol/IAgentCoordinator}
(Test/check
 [{:name "declares the coordinator protocol"
   :test (fn []
           [(satisfies? protocol/IAgentCoordinator coordinator)
            (protocol/agent-coordinate coordinator {:request true})])
   :expected [true {:request true}]}])

^{:refer work.agent.protocol/IAgentAuthority}
(Test/check
 [{:name "declares authorization and signing methods"
   :test (fn []
           [(satisfies? protocol/IAgentAuthority authority)
            (:authorized? (protocol/agent-authorize authority {:action :read}))
            (first (:signature (protocol/agent-sign authority {:action :read})))])
   :expected [true true :authority]}])
