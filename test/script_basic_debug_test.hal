(ns lang.core.script-basic-debug-test
  (:require [lang.core :as l]))

(l/script- :js
  {:runtime :basic
   :timeout 15000})

(Test/check
 [{:name "diagnostic"
   :test (fn []
           (try
             (l/restart)
             (let [value (!.js (+ 1 2))]
               (println "RESULT" value)
               true)
             (catch error
               (println "ERROR" (str error))
               (println "DATA" (ex-data error))
               false)
             (finally
               (l/stop))))
   :expected true}])
