(ns hara.script-math-probe-test
  (:require [lang.core :as l])
  (:use code.test))

(l/script- :js
  {:runtime :basic
   :require [[xt.lang.common-math :as xtm]
             [xt.lang.spec-base :as xt]]})

(fact:global
 {:setup [(l/rt:restart)]
  :teardown [(l/rt:stop)]})

(fact "starts the common math JavaScript graph"
  (!.js (xtm/abs -5))
  => 5)
