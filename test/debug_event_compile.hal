(ns debug-event-compile
  (:require [lang.core :as l]
            [lang.core.script :as script]))

(l/script- :js
  {:runtime :basic
   :require [[xt.event.base-animate-mock :as mock]]})

(Test/check
 [{:name "shows compiled event module prefix"
   :test (fn []
           (let [compiled (script/compile-form
                           :js
                           'debug-event-compile
                           '(mock/new-observed 1))
                 output (:output compiled)]
             (if (< 1000 (str/length output))
               (str/slice output 0 1000)
               output)))
   :expected ""}])
