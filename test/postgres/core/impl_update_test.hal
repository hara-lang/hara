(ns postgres.core.impl-update-test
  (:require [postgres.core.impl-update :as update]))

(def schema
  {:id [{:type :uuid :primary true :order 0}]
   :status [{:type :enum :order 1 :enum {:ns 'demo/Status}}]
   :name [{:type :text :order 2}]})

^{:refer postgres.core.impl-update/t-update-map}
(Test/check
 [{:name "constructs map updates in archive schema order"
   :test (fn [] (update/t-update-map schema {:name "n" :status "open"} {} {}))
   :expected '(== (>-< [#{"status"} #{"name"}])
                  (row (++ "open" demo/Status) (:text "n")))}])
