(ns play.ngx-001-eval.build-test
  (:require [work.flow.make :as make]
            [play.ngx-001-eval.build :as subject]))

^{:refer play.ngx-001-eval.build/PROJECT}
(Test/check [{:name "defines the OpenResty eval build through the generic make flow"
              :test (fn [] [(make/host? subject/PROJECT)
                            (:make/id (make/plan subject/PROJECT))])
              :expected [true 'play.ngx-001-eval.build/PROJECT]}])

^{:refer play.ngx-001-eval.build/-main}
(Test/check [{:name "retains the OpenResty eval build entrypoint"
              :test (fn [] (function? subject/-main))
              :expected true}])
