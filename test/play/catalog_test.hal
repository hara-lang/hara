(ns play.catalog-test
  (:require [play.catalog :as catalog]))

^{:refer play.catalog/sample-ids}
(Test/check
 [{:name "contains every original foundation sample in order"
   :test (fn [] [(count (catalog/sample-ids))
                 (first (catalog/sample-ids))
                 (last (catalog/sample-ids))])
   :expected [12 "c_000_pthreads_hello" "view_001_kitchen_sink"]}])

^{:refer play.catalog/sample}
(Test/check
 [{:name "looks up a sample by stable id"
   :test (fn [] (:namespace (catalog/sample "go_001_xtalk_user_directory")))
   :expected 'play.go-001-xtalk-user-directory}])

^{:refer play.catalog/complete?}
(Test/check
 [{:name "requires deterministic sample metadata"
   :test (fn [] [(catalog/complete? (catalog/sample "c_000_pthreads_hello"))
                 (catalog/complete? {:id "broken"})])
   :expected [true false]}])

^{:refer play.catalog/deferred-targets}
(Test/check
 [{:name "retains only explicit deferred targets"
   :test (fn [] (catalog/deferred-targets
                 (catalog/sample "view_001_kitchen_sink")))
   :expected #{:dart :flutter}}])

^{:refer play.catalog/all-complete?}
(Test/check
 [{:name "marks the complete deterministic catalog"
   :test (fn [] (catalog/all-complete?))
   :expected true}])
