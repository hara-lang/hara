(ns play.view-001-kitchen-sink.build-test
  (:require [work.flow.make :as make]
            [play.view-001-kitchen-sink.build :as subject]))

^{:refer play.view-001-kitchen-sink.build/VIEW-KITCHEN-SINK-JS}
(Test/check [{:name "defines the browser kitchen-sink build through the generic make flow"
              :test (fn [] [(make/host? subject/VIEW-KITCHEN-SINK-JS)
                            (:make/id (make/plan subject/VIEW-KITCHEN-SINK-JS))])
              :expected [true 'play.view-001-kitchen-sink.build/VIEW-KITCHEN-SINK-JS]}])

^{:refer play.view-001-kitchen-sink.build/-main}
(Test/check [{:name "retains the browser kitchen-sink build entrypoint"
              :test (fn [] (function? subject/-main))
              :expected true}])
