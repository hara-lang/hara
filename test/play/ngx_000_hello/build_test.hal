(ns play.ngx-000-hello.build-test
  (:require [work.flow.make :as make]
            [play.ngx-000-hello.build :as subject]))

^{:refer play.ngx-000-hello.build/PROJECT}
(Test/check [{:name "defines the OpenResty hello build through the generic make flow"
              :test (fn [] [(make/host? subject/PROJECT)
                            (:make/id (make/plan subject/PROJECT))])
              :expected [true 'play.ngx-000-hello.build/PROJECT]}])

^{:refer play.ngx-000-hello.build/-main}
(Test/check [{:name "retains the OpenResty hello build entrypoint"
              :test (fn [] (function? subject/-main))
              :expected true}])
