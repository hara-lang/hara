(ns play.tui-002-game-of-life.build-test
  (:require [work.flow.make :as make]
            [play.tui-002-game-of-life.build :as subject]))

^{:refer play.tui-002-game-of-life.build/PROJECT}
(Test/check [{:name "defines the game-of-life build through the generic make flow"
              :test (fn [] [(make/host? subject/PROJECT)
                            (:make/id (make/plan subject/PROJECT))])
              :expected [true 'play.tui-002-game-of-life.build/PROJECT]}])

^{:refer play.tui-002-game-of-life.build/-main}
(Test/check [{:name "retains the game-of-life build entrypoint"
              :test (fn [] (function? subject/-main))
              :expected true}])
