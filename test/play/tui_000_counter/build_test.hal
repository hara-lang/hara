(ns play.tui-000-counter.build-test
  (:require [work.flow.make :as make]
            [play.tui-000-counter.build :as subject]))

^{:refer play.tui-000-counter.build/PROJECT}
(Test/check [{:name "defines the counter build through the generic make flow"
              :test (fn [] [(make/host? subject/PROJECT)
                            (:make/id (make/plan subject/PROJECT))])
              :expected [true 'play.tui-000-counter.build/PROJECT]}])

^{:refer play.tui-000-counter.build/-main}
(Test/check [{:name "retains the counter build entrypoint"
              :test (fn [] (function? subject/-main))
              :expected true}])
