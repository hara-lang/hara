(ns play.js-002-substrate-scratch-v3.build-test
  (:require [work.flow.make :as make]
            [play.js-002-substrate-scratch-v3.build :as subject]))

^{:refer play.js-002-substrate-scratch-v3.build/PROJECT}
(Test/check [{:name "defines the browser scratch build through the generic make flow"
              :test (fn [] [(make/host? subject/PROJECT)
                            (:make/id (make/plan subject/PROJECT))])
              :expected [true 'play.js-002-substrate-scratch-v3.build/PROJECT]}])

^{:refer play.js-002-substrate-scratch-v3.build/-main}
(Test/check [{:name "retains the browser scratch build entrypoint"
              :test (fn [] (function? subject/-main))
              :expected true}])
