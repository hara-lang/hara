(ns play.samples-test
  (:require [work.flow.make.core :as core]
            [play.c-000-pthreads-hello.build :as c-build]
            [play.go-000-user-directory.build :as go-build]
            [play.go-001-xtalk-user-directory.build :as go-xtalk-build]
            [play.js-002-substrate-scratch-v3.build :as js-build]
            [play.ngx-000-hello.build :as ngx-build]
            [play.ngx-001-eval.build :as ngx-eval-build]
            [play.ts-000-user-directory.build :as ts-build]
            [play.ts-001-single-source-user-directory.build :as ts-single-build]
            [play.tui-000-counter.build :as counter-build]
            [play.tui-001-fetch.build :as fetch-build]
            [play.tui-002-game-of-life.build :as life-build]
            [play.view-001-kitchen-sink.build :as view-build]))

(def +projects+
  [c-build/PROJECT go-build/PROJECT go-xtalk-build/PROJECT js-build/PROJECT
   ngx-build/PROJECT ngx-eval-build/PROJECT ts-build/PROJECT ts-single-build/PROJECT
   counter-build/PROJECT fetch-build/PROJECT life-build/PROJECT
   view-build/VIEW-KITCHEN-SINK-JS])

(def +tags+
  ["play-c-000-pthreads-hello" "play-go-000-user-directory"
   "play-go-001-xtalk-user-directory" "play-js-002-substrate-scratch-v3"
   "play-ngx-000-hello" "play-ngx-001-eval" "play-ts-000-user-directory"
   "play-ts-001-single-source-user-directory" "play-tui-000-counter"
   "play-tui-001-fetch" "play-tui-002-game-of-life" "view-kitchen-sink-js"])

^{:refer work.flow.make.core/host?}
(Test/check
 [{:name "loads every ported sample build namespace"
   :test (fn [] [(count +projects+)
                 (vec (map core/host? +projects+))
                 (vec (map (fn [project]
                             (get-in (core/plan project)
                                     [:make/definition :tag]))
                           +projects+))])
   :expected [12
              [true true true true true true true true true true true true]
              ["play-c-000-pthreads-hello" "play-go-000-user-directory"
               "play-go-001-xtalk-user-directory" "play-js-002-substrate-scratch-v3"
               "play-ngx-000-hello" "play-ngx-001-eval" "play-ts-000-user-directory"
               "play-ts-001-single-source-user-directory" "play-tui-000-counter"
               "play-tui-001-fetch" "play-tui-002-game-of-life" "view-kitchen-sink-js"]]}])
