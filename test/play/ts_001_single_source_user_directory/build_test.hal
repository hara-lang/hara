(ns play.ts-001-single-source-user-directory.build-test
  (:require [work.flow.make :as make]
            [play.ts-001-single-source-user-directory.build :as subject]))

^{:refer play.ts-001-single-source-user-directory.build/PROJECT}
(Test/check [{:name "defines the single-source build through the generic make flow"
              :test (fn [] [(make/host? subject/PROJECT)
                            (:make/id (make/plan subject/PROJECT))])
              :expected [true 'play.ts-001-single-source-user-directory.build/PROJECT]}])

^{:refer play.ts-001-single-source-user-directory.build/typescript-artifact}
(Test/check [{:name "retains the single-source declaration hook"
              :test (fn [] (function? subject/typescript-artifact))
              :expected true}])

^{:refer play.ts-001-single-source-user-directory.build/-main}
(Test/check [{:name "retains the single-source build entrypoint"
              :test (fn [] (function? subject/-main))
              :expected true}])
