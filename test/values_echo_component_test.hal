(ns values.echo-component-test
  (:require [values.echo :as echo]))

^{:refer values.echo/echo}
(Test/check
 [{:name "round trips a nested persistent Hara value through the Component"
   :test (fn []
           (echo/echo {:title "Component"
                       :items [1 {:nested true} :done]}))
   :expected {:title "Component"
              :items [1 {:nested true} :done]}}])
