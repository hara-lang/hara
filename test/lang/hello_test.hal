(ns lang.hello-test
  (:require [lang.core :as l]
            [lang.core.script :as script]))

(l/script- :js
  {:runtime :basic
   :test-mode true
   :timeout 15000})

^{:refer lang.core/script-}
(Test/check
 [{:name "evaluates a JavaScript expression after deferred bootstrap"
   :test (fn []
           (try
             (let [started (time-ms)
                   _ (l/restart)
                   restart-elapsed (- (time-ms) started)
                   value (!.js (+ 1 2 3))
                   eval-elapsed (- (time-ms) started)]
               [(< restart-elapsed 1000)
                (< eval-elapsed 1500)
                value
                (get-in (deref script/+scripts+)
                        [['lang.hello-test :js] :runtime :lang])])
             (finally
               (l/stop))))
   :expected [true true 6 :js]}])
