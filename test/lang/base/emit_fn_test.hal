(ns lang.base.emit-fn-test
  (:require [lang.base.emit-fn :as subject]))

^{:refer lang.base.emit-fn/emit-input-default}
(Test/check
 [{:name "keeps ordinary typed inputs type-first and supports name-first targets"
   :test (fn [] [(subject/emit-input-default
                  {:modifiers [:int] :symbol 'value}
                  "="
                  {:default {:common {}
                             :function {:args {}}}}
                  {})
                 (subject/emit-input-default
                  {:modifiers [:int] :symbol 'value}
                  "="
                  {:default {:common {}
                             :function {:args {:reversed true}}}}
                  {})])
   :expected ["int value" "value int"]}])
