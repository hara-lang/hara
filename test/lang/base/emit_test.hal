(ns lang.base.emit-test
  (:require [lang.base.emit :as emit]
            [lang.base.grammar-api :as grammar]
            [lang.base.registry :as registry]
            [lang.model.v1.spec-js :as js]
            [lang.protocol.compiler :as compiler]))

(def template
  (grammar/emit-template
   {:template/id :js-default :template/version 1
    :template/value {:token {:nil "null"}}}))

(defn grammar-definition [version raw]
  (grammar/definition
   {:grammar/id :js :grammar/version version :grammar/release (str "v" version)
    :grammar/emit-template {:template/id :js-default :template/version 1}
    :operators {:define {:add {:op :add :symbol #{'+}
                              :type :operator :emit :infix :raw raw}}}}))

(def catalog
  (registry/install
   (registry/install
    (registry/install (registry/registry) template)
    (grammar-definition 1 "+"))
   (grammar-definition 2 "plus")))

(def selected-v1 (registry/resolve catalog {:grammar/id :js :grammar/version 1}))
(def selected-v2 (registry/resolve catalog {:grammar/id :js :grammar/version 2}))

^{:refer lang.base.emit/default-grammar}
(Test/check
 [{:name "returns the archive default grammar with canonical rewrite support"
   :test (fn [] [(get-in (emit/default-grammar) [:token :nil])
                 (count (get-in (emit/default-grammar) [:rewrite :canonical]))])
   :expected [nil 1]}])

^{:refer lang.base.emit/emit-main-loop}
(Test/check
 [{:name "emits one nested form through the common and top-level pipeline"
   :test (fn [] (emit/emit-main-loop '(+ 1 (+ 2 3))
                                      (emit/default-grammar (:grammar selected-v1)) {}))
   :expected "1 + (2 + 3)"}])

^{:refer lang.base.emit/emit-main}
(Test/check
 [{:name "installs recursive top-level emission"
   :test (fn [] (emit/emit-main '(+ 1 (+ 2 3))
                                 (emit/default-grammar (:grammar selected-v1)) {}))
   :expected "1 + (2 + 3)"}])

^{:refer lang.base.emit/emit-token}
(Test/check
 [{:name "emits numeric literals as target literals rather than host constructor forms"
   :test (fn [] (emit/emit-token 0.06 {} {}))
   :expected "0.06"}])

^{:refer lang.base.emit/emit-node}
(Test/check
 [{:name "emits Hara double literal forms as target numeric literals"
   :test (fn [] (emit/emit-node (list 'double 0.06) {} {}))
   :expected "0.06"}])

^{:refer lang.base.emit/emit}
(Test/check
[{:name "selects grammar versions and rejects legacy option aliases by ignoring them"
   :test (fn [] [(emit/emit '(+ 1 2) selected-v1)
                 (emit/emit '(+ 1 2) selected-v2)
                 (emit/emit nil selected-v1)
                 (emit/emit 'value {:emit (fn [form mopts] (keys mopts))} nil
                            {:lang :js :tahto/module :legacy})])
   :expected ["1 + 2" "1 plus 2" "null" [:lang]]}])

^{:refer lang.base.emit/emit}
(Test/check
 [{:name "emits a return containing a target vector through the complete JavaScript grammar"
   :test (fn [] (emit/emit '(return [r]) (:grammar js/+selection+) {:layout :flat}))
   :expected "return [r]"}])

^{:refer lang.base.emit/with:emit}
(Test/check
 [{:name "binds the top-level recursive emitter"
   :test (fn [] (emit/with:emit
                 (emit/*emit-fn* '(+ 1 (+ 2 3))
                                (emit/default-grammar (:grammar selected-v1)) {})))
   :expected "1 + (2 + 3)"}])

^{:refer lang.base.emit/prep-options}
(Test/check
 [{:name "prepares canonical pipeline options and resolves explicitly loaded values"
   :test (fn [] (let [[step grammar book namespace mopts]
                      (emit/prep-options {})]
                  [step (map? grammar) book namespace mopts]))
   :expected [:input true nil 'lang.base.emit {}]}])

^{:refer lang.base.emit/prep-form}
(Test/check
 [{:name "prepares raw and input pipeline forms"
   :test (fn [] [(emit/prep-form :raw '(+ 1 2 3) nil nil {})
                 (emit/prep-form :input '(+ (deref 1) 2 3) nil nil {})])
   :expected ['[(+ 1 2 3)] '[(+ (!:eval 1) 2 3)]]}])

^{:refer lang.base.emit/Emitter}
(Test/check
 [{:name "creates the protocol-backed archive emitter value"
   :test (fn [] (compiler/emit-form (emit/emitter) '(+ 1 (+ 2 3)) selected-v1 {}))
   :expected "1 + (2 + 3)"}])

^{:refer lang.base.emit/emitter}
(Test/check
 [{:name "constructs an Emitter for every invocation"
   :test (fn [] (and (not (nil? (emit/emitter)))
                      (not (nil? (emit/emitter)))))
   :expected true}])
