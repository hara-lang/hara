(ns lang.base.emit-test (:require [lang.base.emit :as emit] [lang.base.emit-common :as common] [lang.base.emit-helper :as helper] [lang.base.emit-preprocess :as preprocess] [lang.base.emit-rewrite :as rewrite] [lang.base.grammar :as grammar]) (:use code.test))

(def +reserved+
  (-> (grammar/build)
      (grammar/to-reserved)))

(def +grammar+
  (grammar/grammar :test +reserved+ helper/+default+))

^{:refer lang.base.emit/default-grammar, :added "4.0"}
(fact
  "returns the default grammar"
  (emit/default-grammar)
  =>
  (satisfies map?))

^{:refer lang.base.emit/emit-main-loop :added "4.0"}
(fact "creates the raw emit"

  (emit/emit-main-loop '(not (+ 1 2 3))
                      +grammar+
                      {})
  => "!((+ 1 2 3))")

^{:refer lang.base.emit/emit-main :added "4.0"}
(fact "creates the raw emit with loop"

  (emit/emit-main '(not (+ 1 2 3))
                  +grammar+
                  {})
  => "!(1 + 2 + 3)")

^{:refer lang.base.emit/emit, :added "4.0"}
(fact
  "emits form to output string"
  (emit/emit '(+ 1 2 3) @emit/+test-grammar+ nil {})
  =>
  "1 + 2 + 3")

^{:refer lang.base.emit/with:emit :added "4.0"}
(fact "binds the top-level emit function to common/*emit-fn*"

  (emit/with:emit
   (common/*emit-fn* '(not (+ 1 2 3))
                     +grammar+
                     {}))
  => "!(1 + 2 + 3)")

^{:refer lang.base.emit/prep-options, :added "4.0"}
(fact
  "prepares the options for processing"
  (emit/prep-options {})
  =>
  (satisfies vector?))

^{:refer lang.base.emit/prep-form, :added "4.0"}
(fact
  "prepares the form"
  (emit/prep-form :raw '(+ 1 2 3) nil nil {})
  =>
  '[(+ 1 2 3)]
  (emit/prep-form :input '(+ @1 2 3) nil nil {})
  =>
  '[(+ (!:eval 1) 2 3)]
  (emit/prep-form :staging '(+ @1 2 3) nil nil {})
  =>
  '[(+ (!:eval 1) 2 3) #{} #{} {}])

^{:refer lang.base.emit/prep-form, :added "4.1", :id test-prep-form-staging-rewrites}
(do
 (intern-var
  'lang.base.emit-test
  'migration-original-input
  #'preprocess/to-input)
 (intern-var
  'lang.base.emit-test
  'migration-original-staging
  #'preprocess/to-staging)
 (intern-var
  'lang.base.emit-test
  'migration-original-rewrite
  #'rewrite/rewrite-stage)
 (def migration-mock-input (fn [_] 'input-form))
 (def
  migration-mock-staging
  (fn
   [form _ _ _]
   (if
    (= form 'input-form)
    ['staged-form #{:dep} #{:fragment} {:native :dep}]
    (throw
     (ex
      :generic
      {:form form}
      :ex/message
      "Unexpected pre-staging form")))))
 (def
  migration-mock-rewrite
  (fn
   [stage form _ _]
   (if
    (and (= :staging stage) (= form 'staged-form))
    'rewritten-form
    (throw
     (ex
      :generic
      {:stage stage, :form form}
      :ex/message
      "Rewrite saw wrong form")))))
 ^{:refer lang.base.emit/prep-form,
   :added "4.1",
   :id test-prep-form-staging-rewrites}
 (fact
  "runs staging rewrites after to-staging"
  (try
   (intern-var
    'lang.base.emit-preprocess
    'to-input
    #'migration-mock-input)
   (intern-var
    'lang.base.emit-preprocess
    'to-staging
    #'migration-mock-staging)
   (intern-var
    'lang.base.emit-rewrite
    'rewrite-stage
    #'migration-mock-rewrite)
   (emit/prep-form :staging '(ignored) nil {:modules {}} {})
   (finally
    (intern-var
     'lang.base.emit-preprocess
     'to-input
     #'migration-original-input)
    (intern-var
     'lang.base.emit-preprocess
     'to-staging
     #'migration-original-staging)
    (intern-var
     'lang.base.emit-rewrite
     'rewrite-stage
     #'migration-original-rewrite)))
  =>
  '[rewritten-form #{:dep} #{:fragment} {:native :dep}]))

^{:refer lang.base.emit/prep-form :id staging-mocks-restored}
(fact "historical staging mocks restore original Var values and metadata"
 [(= (deref #'preprocess/to-input) (deref #'migration-original-input))
  (= (meta #'preprocess/to-input) (meta #'migration-original-input))
  (= (deref #'preprocess/to-staging) (deref #'migration-original-staging))
  (= (meta #'preprocess/to-staging) (meta #'migration-original-staging))
  (= (deref #'rewrite/rewrite-stage) (deref #'migration-original-rewrite))
  (= (meta #'rewrite/rewrite-stage) (meta #'migration-original-rewrite))]
 => [true true true true true true])

(def migration-test-grammar-initially-realized? (IRealize/realized? emit/+test-grammar+))
^{:refer lang.base.emit/+test-grammar+}
(fact "the default test grammar is deferred before any test requests it" migration-test-grammar-initially-realized? => false)
^{:refer lang.base.emit/default-grammar}
(fact
  "default grammar retains canonical stage ownership and caller overrides"
  (let [base (emit/default-grammar)
        changed (emit/default-grammar {:token {:nil {:as "NONE"}}})]
    [(= helper/+default+ (dissoc base :rewrite))
     (mapv var-sym (get-in base [:rewrite :canonical]))
     (get-in changed [:token :nil :as])
     (=
       (get-in base [:default :common])
       (get-in changed [:default :common]))])
  =>
  [true '[lang.base.emit-rewrite/canonical-stage] "NONE" true])
^{:refer lang.base.emit/+option-keys+}
(fact
  "only the original option categories are retained"
  emit/+option-keys+
  =>
  [:lang
   :entry
   :module
   :book
   :snapshot
   :layout
   :emit
   :lang/xtalk-context
   :lang/provenance])
^{:refer lang.base.emit/emit-main}
(fact
  "main emission uses original common recursion without stripping wrappers"
  (emit/emit-main '(not (+ 1 2 3)) (deref emit/+test-grammar+) {})
  =>
  "!(1 + 2 + 3)")
^{:refer lang.base.emit/with:emit}
(fact
  "emitter binding is restored on both normal and exceptional exits"
  (let [outer (fn [form grammar options] "outer")]
    (binding [common/*emit-fn* outer]
      [(emit/with:emit
         (common/*emit-fn*
           '(not (+ 1 2 3))
           (deref emit/+test-grammar+)
           {}))
       (common/*emit-fn* nil nil nil)
       (try
         (emit/with:emit (throw (ex :argument {})))
         (catch error :caught))
       (common/*emit-fn* nil nil nil)]))
  =>
  ["!(1 + 2 + 3)" "outer" :caught "outer"])
^{:refer lang.base.emit/prep-options}
(fact
  "preparation uses original test grammar and strips unrelated options"
  (let [[step grammar book namespace options] (emit/prep-options
                                                {:namespace 'chosen,
                                                 :noise true})]
    [step (:tag grammar) book namespace options])
  =>
  [:input :test nil 'chosen {}])
^{:refer lang.base.emit/prep-form}
(fact
  "raw and input preparation preserve the original historical assertions"
  [(emit/prep-form :raw '(+ 1 2 3) nil nil {})
   (emit/prep-form :input '(+ (deref 1) 2 3) nil nil {})]
  =>
  ['[(+ 1 2 3)] '[(+ (!:eval 1) 2 3)]])
^{:refer lang.base.emit/+steps+}
(fact
  "pipeline stages retain original order"
  emit/+steps+
  =>
  [[:raw] [:input] [:staging]])
^{:refer lang.base.emit/emit-main-loop}
(fact
  "raw emission preserves the original unexpanded nested operand"
  (emit/emit-main-loop '(not (+ 1 2 3)) (deref emit/+test-grammar+) {})
  =>
  "!((+ 1 2 3))")
^{:refer lang.base.emit/emit, :id scoped-emission}
(fact
  "emission retains captured values while selecting and restoring namespace scope"
  (let [captured (atom 42)
        before (ns-current)
        custom {:emit
                (fn [form options] [form
                                    (deref captured)
                                    (ns-current)
                                    options])}
        result (emit/emit
                 '(+ 1 2)
                 custom
                 'lang.base.emit-common
                 {:lang :lua, :noise true})]
    [result
     (= before (ns-current))
     (eval-in-ns
       'lang.base.grammar
       (fn [] (emit/emit :nested custom nil {})))
     (= before (ns-current))])
  =>
  [['(+ 1 2) 42 'lang.base.emit-common {:lang :lua}]
   true
   [:nested 42 'lang.base.grammar {}]
   true])
^{:refer lang.base.emit/emit, :id scoped-emission-failure}
(fact
  "emission restores namespace after a captured emitter throws"
  (let [before (ns-current)
        result (try
                 (emit/emit
                   :bad
                   {:emit
                    (fn [form options]
                      (throw (ex :argument {:form form})))}
                   'lang.base.grammar
                   {})
                 (catch error :caught))]
    [result (= before (ns-current))])
  =>
  [:caught true])
^{:refer lang.base.emit/emit, :id scoped-emission-default}
(fact
  "the original default emitter renders recursively inside namespace scope"
  (emit/emit
    '(not (+ 1 2 3))
    (deref emit/+test-grammar+)
    'lang.base.grammar
    {})
  =>
  "!(1 + 2 + 3)")
