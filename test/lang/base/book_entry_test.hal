(ns lang.base.book-entry-test
  (:require [lang.base.book-entry :as entry]))

(def fixture-config
  {:lang :fixture :module 'fixture.core :section :code :id 'run})

^{:refer lang.base.book-entry/filter-values}
(Test/check
 [{:name "retains only truthy entry values for display"
   :test (fn []
           (entry/filter-values {:form '(identity x) :declared false :deps #{}}))
   :expected {:form '(identity x) :deps #{}}}])

^{:refer lang.base.book-entry/book-entry-string}
(Test/check
 [{:name "renders symbolic and brief entry forms"
   :test (fn []
           [(entry/book-entry-string (assoc fixture-config :display :symbol))
            (entry/book-entry-string (assoc fixture-config :display :brief))])
   :expected ["E:fixture.core/run" "#book.entry [:fixture :code fixture.core/run]"]}])

^{:refer lang.base.book-entry/book-entry?}
(Test/check
 [{:name "recognizes only native Hara BookEntry structures"
   :test (fn []
           [(entry/book-entry? (entry/book-entry fixture-config))
            (entry/book-entry? fixture-config)])
   :expected [true false]}])

^{:refer lang.base.book-entry/book-entry}
(Test/check
 [{:name "creates an immutable typed entry with an explicit display default"
   :test (fn []
           (let [value (entry/book-entry (assoc fixture-config :deps #{'fixture.helper}))]
             [(entry/book-entry? value)
              (select-keys (entry/book-entry-data value) [:lang :module :section :id :deps :display])]))
   :expected [true {:lang :fixture :module 'fixture.core :section :code :id 'run
                    :deps #{'fixture.helper} :display :default}]}])

^{:refer lang.base.book-entry/book-entry-data}
(Test/check
 [{:name "projects entry data and rejects a non-entry value"
   :test (fn []
           [(entry/book-entry-data (entry/book-entry fixture-config))
            (try (entry/book-entry-data fixture-config) false (catch _ true))])
   :expected [(entry/book-entry fixture-config) true]}])

^{:refer lang.base.book-entry/entry-coordinate}
(Test/check
 [{:name "derives the complete ordered entry coordinate"
   :test (fn [] (entry/entry-coordinate (entry/book-entry fixture-config)))
   :expected [:fixture 'fixture.core :code 'run]}])
