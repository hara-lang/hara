(ns lang.base.grammar-macro-test
  (:require [lang.base.grammar-macro :as macro]))

^{:refer lang.base.grammar-macro/form}
(Test/check
 [{:name "builds generated list forms in archive order"
   :test (fn [] (macro/form '[a b]))
   :expected '(a b)}])

^{:refer lang.base.grammar-macro/all-but-last}
(Test/check
 [{:name "retains all values except the final value"
   :test (fn [] [(macro/all-but-last '[a b c]) (macro/all-but-last [])])
   :expected '[[a b] []]}])

^{:refer lang.base.grammar-macro/tf-macroexpand}
(Test/check
 [{:name "expands archive first and last threading forms once"
   :test (fn [] [(macro/tf-macroexpand '(-> 1 (inc)))
                 (macro/tf-macroexpand '(->> 1 (add 2)))])
   :expected '[(inc 1) (add 2 1)]}])

^{:refer lang.base.grammar-macro/tf-when}
(Test/check
 [{:name "transforms when to an archive branch form"
   :test (fn [] (macro/tf-when '(when true :A :B :C)))
   :expected '(br* (if true :A :B :C))}])

^{:refer lang.base.grammar-macro/tf-if}
(Test/check
 [{:name "transforms if with explicit and absent else branches"
   :test (fn [] [(macro/tf-if '(if true :A :B))
                 (macro/tf-if '(if true :A))])
   :expected '[(br* (if true :A) (else :B))
               (br* (if true :A))]}])

^{:refer lang.base.grammar-macro/tf-cond}
(Test/check
 [{:name "transforms cond pairs to archive branch controls"
   :test (fn [] (macro/tf-cond '(cond true :A false :B :else :C)))
   :expected '(br* (if true :A) (elseif false :B) (else :C))}])

^{:refer lang.base.grammar-macro/tf-let-bind}
(Test/check
 [{:name "converts bindings to portable declaration statements"
   :test (fn [] [(macro/tf-let-bind '(let [x 1 b 2] (return (+ x b))))
                 (macro/tf-let-bind '(let [_ (touch)] :done))])
   :expected '[(do* (var x := 1) (var b := 2) (return (+ x b)))
               (do* (touch) :done)]}])

^{:refer lang.base.grammar-macro/tf-case}
(Test/check
 [{:name "transforms cases and the final default to switch controls"
   :test (fn [] (macro/tf-case '(case (type obj)
                                   :A (return A)
                                   :B (return B)
                                   (return X))))
   :expected '(switch [(type obj)]
                      (case [:A] (return A))
                      (case [:B] (return B))
                      (default (return X)))}])

^{:refer lang.base.grammar-macro/tf-lambda-arrow}
(Test/check
 [{:name "normalizes arrow lambdas and preserves explicit return forms"
   :test (fn [] [(macro/tf-lambda-arrow '(fn:> [e] e))
                 (macro/tf-lambda-arrow '(fn:> [e] (trace e) (return e)))])
   :expected '[(fn [e] (return e))
               (fn [e] (trace e) (return e))]}])

^{:refer lang.base.grammar-macro/tf-tcond}
(Test/check
 [{:name "transforms ternary condition pairs and rejects a missing default"
   :test (fn [] [(macro/tf-tcond '(:?> :a a :b b :else c))
                 (try (macro/tf-tcond '(:?> :a a :b b)) false (catch _ true))])
   :expected '[(:? :a [a (:? :b [b c])]) true]}])

^{:refer lang.base.grammar-macro/tf-xor}
(Test/check
 [{:name "normalizes both xor operands to booleans"
   :test (fn [] (macro/tf-xor '(xor a b)))
   :expected '(== (not (not a)) (not (not b)))}])

^{:refer lang.base.grammar-macro/tf-doto}
(Test/check
 [{:name "threads doto targets through archive call forms"
   :test (fn [] (macro/tf-doto '(doto sym (. a) (b) (. c))))
   :expected '(do (. sym a) (b sym) (. sym c))}])

^{:refer lang.base.grammar-macro/tf-do-arrow}
(Test/check
 [{:name "wraps do-arrow bodies in one immediately invoked function"
   :test (fn [] (macro/tf-do-arrow '(do:> 1 2 (return 3))))
   :expected '((fn [] 1 2 (return 3)))}])

^{:refer lang.base.grammar-macro/tf-forange}
(Test/check
 [{:name "creates portable positive and negative range-loop forms"
   :test (fn [] [(macro/tf-forange '(forange [i 10] (print i)))
                 (macro/tf-forange '(forange [i [10 3 -2]] (print i)))])
   :expected '[(for [(var i 0) (< i 10) [(:= i (+ i 1))]] (print i))
               (for [(var i 10) (< i 3) [(:= i (- i 2))]] (print i))]}])

^{:refer lang.base.grammar-macro/+op-macro+}
(Test/check
 [{:name "retains archive macro category data with callable transform Vars"
   :test (fn []
           [(set (map :op macro/+op-macro+))
            (:macro (first macro/+op-macro+))
            (set (map :op macro/+op-macro-forange+))])
   :expected [#{:tfirst :tlast :doto :if :cond :when}
              #'macro/tf-macroexpand
              #{:forange}]}])
