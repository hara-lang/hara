(ns lang.base.book-meta-test (:require [lang.base.book-meta :refer :all] [lang.base.util :as ut]) (:use code.test))

^{:refer lang.base.book-meta/book-meta? :added "4.0"}
(fact "checks if object is a book meta"
  (book-meta? (book-meta {})) => true)

^{:refer lang.base.book-meta/book-meta, :added "4.0"}
(fact
  "creates a book meta"
  (book-meta?
    (book-meta
      {:module-export
       (fn [{:keys [as]} opts]
         (let [migration-template-value (syntax-quote
                                          ((unquote 'return)
                                            (unquote as)))]
           (with-meta
             migration-template-value
             (merge
               (or (meta migration-template-value) {})
               (select-keys
                 (or (template-meta) {})
                 [:line :column]))))),
       :module-import
       (fn [name {:keys [as]} opts]
         (let [migration-template-value (syntax-quote
                                          ((unquote 'var)
                                            (unquote as)
                                            :=
                                            ((unquote 'require)
                                              (unquote (str name)))))]
           (with-meta
             migration-template-value
             (merge
               (or (meta migration-template-value) {})
               (select-keys
                 (or (template-meta) {})
                 [:line :column]))))),
       :has-ptr (fn [ptr] (list 'not= (ut/sym-full ptr) nil)),
       :teardown-ptr (fn [ptr] (list := (ut/sym-full ptr) nil))}))
  =>
  true)


^{:refer lang.base.book-meta/filter-values} (fact "retains only truthy lifecycle bindings for display" ((fn [] (lang.base.book-meta/filter-values {:bootstrap :boot, :has-ptr nil, :setup-ptr false}))) => {:bootstrap :boot})

^{:refer lang.base.book-meta/book-meta-string} (fact "renders the configured lifecycle keys" ((fn [] (lang.base.book-meta/book-meta-string {:bootstrap :boot, :has-ptr nil}))) => "#book.meta  [:bootstrap]")

^{:refer lang.base.book-meta/book-meta?} (fact "recognizes only native Hara BookMeta structures" ((fn [] [(lang.base.book-meta/book-meta? (lang.base.book-meta/book-meta {})) (lang.base.book-meta/book-meta? {})])) => [true false])

^{:refer lang.base.book-meta/book-meta} (fact "retains configured lifecycle callbacks" ((fn [] (let [value (lang.base.book-meta/book-meta {:bootstrap :boot})] [(lang.base.book-meta/book-meta? value) (select-keys (lang.base.book-meta/book-meta-data value) [:bootstrap :teardown-ptr])]))) => [true {:bootstrap :boot, :teardown-ptr nil}])

^{:refer lang.base.book-meta/book-meta} (fact "retains compiler entry transforms supplied by a language BookMeta" ((fn [] (:transforms (lang.base.book-meta/book-meta {:transforms {:entry [(quote fixture/append)]}})))) => {:entry [(quote fixture/append)]})

^{:refer lang.base.book-meta/book-meta-data} (fact "returns BookMeta structures and fails closed for ordinary maps" ((fn [] [(lang.base.book-meta/book-meta-data (lang.base.book-meta/book-meta {:has-ptr :pointer})) (try (lang.base.book-meta/book-meta-data {}) false (catch _ true))])) => [(lang.base.book-meta/book-meta {:has-ptr :pointer}) true])

^{:refer lang.base.book-meta/book-meta} (fact "preserves extension fields, both teardown spellings, metadata and callable lifecycle contracts" ((fn [] (let [input (with-meta {:extension {:target :js}, :teardows-module :historical, :teardown-module :native, :false-value false, :nil-value nil, :module-export (fn [module opts] (list (quote return) (:as module) (:suffix opts)))} {:origin :fixture}) value (lang.base.book-meta/book-meta input) again (lang.base.book-meta/book-meta value)] [(lang.base.book-meta/book-meta? value) (select-keys value [:extension :teardows-module :teardown-module :false-value :nil-value]) ((:module-export value) {:as (quote module)} {:suffix :done}) (:origin (meta value)) (= value again) (= (meta value) (meta again)) (lang.base.book-meta/book-meta? (assoc value :extension :changed)) (lang.base.book-meta/book-meta? (lang.base.book-meta/map->BookMeta {})) (lang.base.book-meta/book-meta? {}) (count (keys (lang.base.book-meta/book-meta {})))]))) => [true {:extension {:target :js}, :teardows-module :historical, :teardown-module :native, :false-value false, :nil-value nil} (quote (return module :done)) :fixture true true true true false 12])

^{:refer lang.base.book-meta/book-meta-string} (fact "sorts configured keys and excludes false and nil display fields" ((fn [] (lang.base.book-meta/book-meta-string {:z :last, :a :first, :none nil, :off false}))) => "#book.meta  [:a :z]")

^{:refer lang.base.book-meta/BookMeta}
(fact "preserves the legacy constructor with pinned and native field defaults"
 (let [value (lang.base.book-meta/map->BookMeta {:bootstrap :legacy})]
 [(lang.base.book-meta/book-meta? value) (select-keys value [:bootstrap :teardows-module :teardown-module :transforms])])
 => [true {:bootstrap :legacy :teardows-module nil :teardown-module nil :transforms nil}])
