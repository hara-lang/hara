(ns lang.base.emit-assign-test
  (:require [lang.base.book :as b]
            [lang.base.emit-assign :as assign :refer :all]
            [lang.base.emit-common :as common]
            [lang.base.emit-helper :as helper]
            [lang.base.grammar :as grammar]
            [lang.core.library-snapshot :as snap]
            [lang.core.library-snapshot-prep-test :as prep])
  (:use code.test))

(def +reserved+
  (-> (grammar/build)
      (grammar/to-reserved)))

(def +grammar+
  (grammar/grammar :test +reserved+ helper/+default+))

(def +x-code-complex-fn+
  (b/book-entry {:lang :x
                 :id 'complex-fn
                 :module 'x.core
                 :section :code
                 :form '(defn complex-fn [x]
                          (var a := 1)
                          (:= a (+ a x))
                          (return a))
                 :deps #{}
                 :namespace 'x.core
                 :declared false}))

(def +book-x+
  (-> (b/set-entry prep/+book-x+ +x-code-complex-fn+)
      second))

(def +snap+
  (snap/add-book prep/+snap+ +book-x+))

^{:refer lang.base.emit-assign/emit-def-assign-inline :added "4.0"}
(fact "assigns an inline form directly"

  (emit-def-assign-inline
   'j '[x.core/complex-fn (1)] +grammar+ {:lang :x
                                          :book +book-x+})
  => '(do* (var j := 1)
           (:= j (+ j (1)))))

^{:refer lang.base.emit-assign/assign-options :added "4.1"}
(fact "gets assignment options from reserved entries and metadata"
  (assign-options
   (with-meta '(hello 1)
     {:assign/template 'meta-sym})
   {:reserved {'hello {:emit :macro
                       :assign/template 'reserved-sym
                       :assign/inline 'x.core/identity-fn}}})
  => '{:assign/template meta-sym
       :assign/inline x.core/identity-fn}

  (assign-options
   '(identity 1)
   +grammar+)
  => {})

^{:refer lang.base.emit-assign/assign-value :added "4.1"}
(fact "prepares assignment override payloads"
  (assign-value 'a
                (with-meta '(sym :as [1 2 3])
                  {:assign/fn (fn [sym]
                                (list sym :as [1 2 3]))})
                +grammar+
                {})
  => [:raw '(a :as [1 2 3])]

  (assign-value 'a
                (with-meta '(sym :as [1 2 3])
                  {:assign/template 'sym})
                +grammar+
                {})
  => [:template '(a :as [1 2 3])]

  (assign-value 'a
                '(hello 1 2)
                (assoc-in +grammar+
                          [:reserved 'hello]
                          {:emit :macro
                           :macro (fn [_]
                                    '(sym :as [1 2 3]))
                           :assign/template 'sym})
                {})
  => [:template '(a :as [1 2 3])])

^{:refer lang.base.emit-assign/emit-def-assign :added "3.0"}
(fact "emits a declare expression"

  (emit-def-assign :def-assign
                   {:raw "var"}
                   '(var :int i := 9, :const :int j := 10)
                   +grammar+
                   {})
  => "var int i = 9, const int j = 10"

  (emit-def-assign :def-assign
                   {:raw "var"}
                   '(var (:int i) 9)
                   +grammar+
                   {})
  => "var int i = 9"

  (emit-def-assign :def-assign
                   {:raw "var"}
                   '(var a b)
                   (assoc-in +grammar+ [:define :shorthand] true)
                   {})
  => "var a = b"

  (emit-def-assign :def-assign
                   {:raw "var"}
                   '(var out [])
                   (assoc-in +grammar+ [:define :shorthand] true)
                   {})
  => "var out = []")

^{:refer lang.base.emit-assign/test-assign-loop :adopt true :added "4.0"}
(fact "emit do"

  (assign/test-assign-loop '(var a 1)
                           +grammar+
                           {})
  => "a = 1"

  (assign/test-assign-loop '(var :int [] a)
                           +grammar+
                           {})
  => "int a[]"

  (assign/test-assign-loop '(var :int :* a)
                           +grammar+
                           {})
  => "int * a"

  (assign/test-assign-loop '(var (:int a) 9)
                           +grammar+
                           {})
  => "int a = 9"


  (assign/test-assign-loop '(var :const a (+ b1 2))
                           +grammar+
                           {})
  => "const a = (+ b1 2)"


  (assign/test-assign-emit '(var a (+ 1 2))
                           +grammar+
                           {})
  => "a = 1 + 2"

  (assign/test-assign-emit '(var :const a (+ b1 2))
                           +grammar+
                           {})
  => "const a = b1 + 2")

^{:refer lang.base.emit-assign/test-assign-emit :added "4.0"}
(fact "emit assign forms"

  (assign/test-assign-loop (list 'var 'a := (with-meta ()
                                              {:assign/fn (fn [sym]
                                                            (list sym :as [1 2 3]))}))
                           +grammar+
                           {})
  => "(a :as [1 2 3])"

  (assign/test-assign-loop (list 'var 'a := (with-meta '(sym :as [1 2 3])
                                              {:assign/template 'sym}))
                           +grammar+
                           {})
  => "(a :as [1 2 3])"

  (assign/test-assign-loop (list 'var 'a := (with-meta '(x.core/identity-fn 1)
                                              {:assign/inline 'x.core/identity-fn}))
                           +grammar+
                           {:lang :x
                            :snapshot +snap+})
  => "(do* (var a := 1))"

  (assign/test-assign-loop (list 'var 'a := (with-meta '(x.core/complex-fn 1)
                                              {:assign/inline 'x.core/complex-fn}))
                           +grammar+
                           {:lang :x
                            :snapshot +snap+})
  => "(do* (var a := 1) (:= a (+ a 1)))"

  (assign/test-assign-loop '(var a := (hello 1 2))
                           (assoc-in +grammar+
                                     [:reserved 'hello]
                                     {:emit :macro
                                      :macro (fn [[_ x y]]
                                               '(thread :as [1 2 3]))
                                      :assign/template 'thread})
                           {})
  => "(a :as [1 2 3])")
(do)

^{:refer lang.base.emit-assign/assign-options, :added "4.1", :id :native-assign-options}
(fact
  "gets assignment options from metadata and macros"
  (assign/assign-options
    (with-meta '(hello 1) {:assign/template 'meta-sym})
    {:reserved
     {'hello
      {:emit :macro,
       :assign/template 'reserved-sym,
       :assign/inline 'x.core/identity-fn}}})
  =>
  '{:assign/template meta-sym, :assign/inline x.core/identity-fn}
  (assign/assign-options '(identity 1) helper/+default+)
  =>
  {})

^{:refer lang.base.emit-assign/emit-def-assign-inline, :added "4.0", :id :native-emit-def-assign-inline}
(fact
  "inlines a dependency-free code entry"
  (let [book {:modules
              {'x.core
               {:id 'x.core,
                :code
                {'complex-fn
                 {:id 'complex-fn,
                  :lang :x,
                  :module 'x.core,
                  :form
                  '(defn complex-fn [x]
                     (var a := 1)
                     (:= a (+ a x))
                     (return a)),
                  :deps #{}}}}}}]
    (assign/emit-def-assign-inline
      'j
      '(x.core/complex-fn (1))
      helper/+default+
      {:lang :x, :book book}))
  =>
  '(do* (var j := 1) (:= j (+ j (1)))))

^{:refer lang.base.emit-assign/assign-value, :added "4.1", :id :native-assign-value}
(fact
  "prepares function and template assignment overrides"
  (assign/assign-value
    'a
    '(assignable 1)
    {:reserved
     {'assignable
      {:emit :macro,
       :macro (fn [form] form),
       :assign/fn (fn [symbol] (list symbol :as [1 2 3]))}}}
    {})
  =>
  [:raw '(a :as [1 2 3])]
  (assign/assign-value
    'a
    (with-meta '(sym :as [1 2 3]) {:assign/template 'sym})
    helper/+default+
    {})
  =>
  [:template '(a :as [1 2 3])])

^{:refer lang.base.emit-assign/emit-def-assign, :added "3.0", :id :native-emit-def-assign}
(fact
  "emits typed declaration expressions"
  (binding [common/*emit-fn* assign/test-assign-loop]
    [(assign/emit-def-assign
       :def-assign
       {:raw "var"}
       '(var :int i := 9 :const :int j := 10)
       helper/+default+
       {})
     (assign/emit-def-assign
       :def-assign
       {:raw "var"}
       '(var out [])
       (assoc-in helper/+default+ [:define :shorthand] true)
       {})])
  =>
  ["var int i = 9, const int j = 10" "var out = []"])

^{:refer lang.base.emit-assign/test-assign-loop, :adopt true, :added "4.0", :id :native-test-assign-loop}
(fact
  "the Foundation assignment loop retains direct dispatch"
  (assign/test-assign-loop
    '(var a 1)
    (assoc-in
      (assoc
        helper/+default+
        :reserved
        {'var {:op :def-assign, :emit :def-assign, :raw ""}})
      [:define :shorthand]
      true)
    {})
  =>
  "a = 1")

^{:refer lang.base.emit-assign/test-assign-emit, :added "4.0", :id :native-test-assign-emit}
(fact
  "the Foundation assignment test emitter installs recursive dispatch"
  (assign/test-assign-emit
    '(var out [])
    (assoc-in
      (assoc
        helper/+default+
        :reserved
        {'var {:op :def-assign, :emit :def-assign, :raw "var"}})
      [:define :shorthand]
      true)
    {})
  =>
  "var out = []")

^{:refer lang.base.emit-assign/+assign-types+, :id :native-+assign-types+}
(fact
  "inventories exactly the original assignment overrides"
  assign/+assign-types+
  =>
  #{:assign/inline :assign/fn :assign/template})
^{:refer lang.base.emit-assign/replace-form, :id :native-replace-form}
(fact
  "retains native recursive replacement of lists vectors and map keys"
  (assign/replace-form {'x 2, :a 1} '(x [x] {:a x}))
  =>
  '(2 [2] {1 2}))
^{:refer lang.base.emit-assign/return-value, :id :native-return-value}
(fact
  "retains the last direct return value and absence behavior"
  [(assign/return-value '[(return 1) (noop) (return 2)])
   (assign/return-value '[(noop)])]
  =>
  [2 nil])
^{:refer lang.base.emit-assign/remove-return, :id :native-remove-return}
(fact
  "removes direct returns while preserving other forms and order"
  (assign/remove-return
    '[(return 1) (first-call) (return 2) (second-call)])
  =>
  '[(first-call) (second-call)])
^{:refer lang.base.emit-assign/modifier-output, :id :native-modifier-output}
(fact
  "emits native keyword vector and symbol modifiers"
  [(assign/modifier-output :int helper/+default+ {})
   (assign/modifier-output [] helper/+default+ {})
   (assign/modifier-output 'hello helper/+default+ {})]
  =>
  ["int" "" "hello"])
^{:refer lang.base.emit-assign/emit-input-default, :id :native-emit-input-default}
(fact
  "retains native typed array declarations and explicit nil assignment"
  [(assign/emit-input-default
     {:symbol 'a, :modifiers [:const []], :type [:int], :value 9}
     "="
     helper/+default+
     {})
   (assign/emit-input-default
     {:symbol 'a, :modifiers [], :type [], :value false}
     "="
     helper/+default+
     {})
   (assign/emit-input-default
     {:symbol 'a, :modifiers [], :type [], :value nil}
     "="
     helper/+default+
     {})
   (assign/emit-input-default
     {:symbol 'a, :modifiers [], :type [], :value nil, :force true}
     "="
     helper/+default+
     {})]
  =>
  ["const int a[] = 9" "a = false" "a" "a = nil"])

^{:refer lang.base.emit-assign/emit-def-assign-inline, :id :native-nil-false-bindings}
(fact
  "substitutes nil and false inline arguments without retaining parameter symbols"
  (let [book {:modules
              {'x.core
               {:id 'x.core,
                :code
                {'value-fn
                 {:id 'value-fn,
                  :lang :x,
                  :module 'x.core,
                  :deps #{},
                  :form
                  '(defn value-fn [x] (var a := x) (return a))}}}}}]
    [(assign/emit-def-assign-inline
       'result
       '(x.core/value-fn nil)
       helper/+default+
       {:lang :x, :book book})
     (assign/emit-def-assign-inline
       'result
       '(x.core/value-fn false)
       helper/+default+
       {:lang :x, :book book})])
  =>
  '[(do* (var result := nil)) (do* (var result := false))])
