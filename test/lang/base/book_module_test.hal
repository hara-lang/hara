(ns lang.base.book-module-test (:require [lang.base.book-module :as module] [lang.base.emit-template :as template]) (:use code.test))

(def fixture-module
  (module/book-module {:lang :js :id 'demo.core
                       :link {'util 'demo.util}
                       :code {'one {:id 'one :op-key :defn
                                    :deps #{'demo.data/value}
                                    :deps-native {"react" #{'React}}
                                    :deps-fragment #{'demo.frag/value}}}}))

^{:refer lang.base.book-module/book-module?, :id book-module-native-2-0} (fact "recognizes immutable native Hara BookModule structures" ((fn [] [(module/book-module? fixture-module) (module/book-module? {})])) => [true false])

^{:refer lang.base.book-module/book-module, :id book-module-native-3-0} (fact "constructs archive BookModules with stable collection defaults" ((fn [] (select-keys (module/book-module {:lang :lua, :id (quote L.core)}) [:lang :id :link :code :includes :display]))) => {:lang :lua, :id (quote L.core), :link {}, :code {}, :includes #{}, :display :default})

^{:refer lang.base.book-module/module-entry-dependencies, :id book-module-native-4-0} (fact "reads modern and legacy code dependency fields" ((fn [] [(module/module-entry-dependencies {:deps #{(quote demo/value)}}) (module/module-entry-dependencies {:dependencies {:code #{(quote legacy/value)}}})])) => [#{(quote demo/value)} #{(quote legacy/value)}])

^{:refer lang.base.book-module/polyfill-default-alias, :id book-module-native-5-0} (fact "derives stable aliases for derived polyfill modules" ((fn [] [(module/polyfill-default-alias (quote common-net)) (module/polyfill-default-alias (quote polyfill-net)) (module/polyfill-default-alias (quote net))])) => [(quote polyfill-net) (quote polyfill-net) (quote polyfill-net)])

^{:refer lang.base.book-module/materialized-code, :id book-module-native-6-0} (fact "leaves raw code intact when no grammar is selected" ((fn [] (module/materialized-code nil fixture-module))) => {(quote one) {:id (quote one), :op-key :defn, :deps #{(quote demo.data/value)}, :deps-native {"react" #{(quote React)}}, :deps-fragment #{(quote demo.frag/value)}}})

^{:refer lang.base.book-module/materialized-code, :id book-module-native-7-0} (fact "stages inherited source entries with the pinned module language" ((fn [] (let [seen (atom []) entry {:lang :xtalk, :module (quote demo.inherited), :id (quote run), :op :plain, :form-input (quote (outer 1)), :static/code.cache (atom {})} source (module/book-module {:lang :xtalk, :id (quote demo.inherited), :code {(quote run) entry}}) book {:lang :lua, :grammar {:reserved {:plain {:hydrate (fn [form _ context] (swap! seen conj (:lang context)) [nil form])}}}, :modules {(quote demo.inherited) source}}] (module/materialized-code book source) (deref seen)))) => [:xtalk])

^{:refer lang.base.book-module/add-polyfill-link, :id book-module-native-8-0} (fact "adds derived internal, alias, and link entries and rejects conflicts" ((fn [] (let [value (module/add-polyfill-link (module/book-module {:lang :js, :id (quote demo.core)}) (quote demo.poly))] [(select-keys value [:link :internal :alias]) (try (module/add-polyfill-link (module/book-module {:lang :js, :id (quote demo.core), :link {(quote polyfill-demo.poly) (quote other)}}) (quote demo.poly)) false (catch error true))]))) => [{:link {(quote polyfill-demo.poly) (quote demo.poly)}, :internal {(quote demo.poly) (quote polyfill-demo.poly)}, :alias {(quote polyfill-demo.poly) (quote demo.poly)}} true])

^{:refer lang.base.book-module/module-derived-view, :id book-module-native-9-0} (fact "derives polyfill links in a compilation view without mutating the module" ((fn [] (let [book {:modules {(quote demo.poly) (module/book-module {:lang :js, :id (quote demo.poly)})}} value (module/book-module {:lang :js, :id (quote demo.core), :code {(quote identity) {:polyfill-modules #{(quote demo.poly)}}}}) view (module/module-derived-view book value)] [(select-keys view [:link :internal :alias]) (:link value)]))) => [{:link {(quote polyfill-demo.poly) (quote demo.poly)}, :internal {(quote demo.poly) (quote polyfill-demo.poly)}, :alias {(quote polyfill-demo.poly) (quote demo.poly)}} {}])

^{:refer lang.base.book-module/resolve-module-view, :id book-module-native-10-0} (fact "resolves a module id, a module value, and nil independently" ((fn [] (let [book {:modules {(quote demo.core) fixture-module}}] [(module/resolve-module-view nil nil) (:id (module/resolve-module-view book (quote demo.core))) (:id (module/resolve-module-view nil fixture-module))]))) => [nil (quote demo.core) (quote demo.core)])

^{:refer lang.base.book-module/module-deps-code-base, :id book-module-native-11-0} (fact "derives only external module dependencies from code symbols" ((fn [] (module/module-deps-code-base fixture-module))) => #{(quote demo.data)})

^{:refer lang.base.book-module/module-deps-code, :id book-module-native-12-0} (fact "adds derived polyfills and grammar hard-link modules to code dependencies" ((fn [] (let [value (module/book-module {:lang :js, :id (quote demo.promise), :code {(quote wrap) {:deps #{(quote demo.data/value)}, :polyfill-modules #{(quote demo.poly)}, :xtalk-ops #{:x-promise}}}}) book {:modules {(quote demo.promise) value, (quote demo.poly) {}}, :grammar {:reserved {(quote x:promise) {:op :x-promise, :emit :hard-link, :raw (quote demo.promise/promise)}}}}] [(module/module-deps-code value) (module/module-deps-code book value)]))) => [#{(quote demo.data) (quote demo.poly)} #{(quote demo.data) (quote demo.poly)}])

^{:refer lang.base.book-module/module-deps-all, :id book-module-native-13-0} (fact "combines derived and explicit module dependencies" ((fn [] (module/module-deps-all fixture-module))) => #{(quote demo.data) (quote demo.util)})

^{:refer lang.base.book-module/module-deps-native-base, :id book-module-native-14-0} (fact "collects native dependency maps from unmaterialized code" ((fn [] (module/module-deps-native-base fixture-module))) => {"react" #{(quote React)}})

^{:refer lang.base.book-module/module-deps-native, :id book-module-native-15-0} (fact "collects native dependencies from a derived module view" ((fn [] (module/module-deps-native fixture-module))) => {"react" #{(quote React)}})

^{:refer lang.base.book-module/module-deps-fragment, :id book-module-native-16-0} (fact "collects fragment dependencies from base and derived views" ((fn [] [(module/module-deps-fragment fixture-module) (module/module-deps-fragment {:modules {(quote demo.core) fixture-module}} fixture-module)])) => [#{(quote demo.frag/value)} #{(quote demo.frag/value)}])

^{:refer lang.base.book-module/module-entries, :id book-module-native-17-0} (fact "orders filtered entries and exposes stable section keys" ((fn [] (let [value (module/book-module {:lang :js, :id (quote demo), :code {(quote later) {:id (quote later), :op-key :defn, :priority 2}, (quote first) {:id (quote first), :op-key :defn, :priority 1}, (quote hidden) {:id (quote hidden), :op-key :def, :priority 0}}})] [(module/module-entries value #{:defn}) (vec (module/module-entry-keys value :code))]))) => [[[(list :% (first (pr-str "")) (quote first) (first (pr-str ""))) (quote demo/first)] [(list :% (first (pr-str "")) (quote later) (first (pr-str ""))) (quote demo/later)]] [(quote first) (quote hidden) (quote later)]])

^{:refer lang.base.book-module/book-module-string :id book-module-display-contract}
(fact "renders brief identity and filters empty or false display metadata"
  [(module/book-module-string {:lang :js :id 'demo :display :brief})
   (module/book-module-string
     {:lang :js :id 'demo :code {'b {} 'a {}} :fragment {'f {}}
      :static {} :flag false :note "keep"})]
  => ["#book.module [:js demo]"
      (str "#book.module " [:js 'demo] " "
           {:meta {:note "keep"} :entries {:code '(a b) :fragment '(f)}})])

^{:refer lang.base.book-module/BookModule :id book-module-open-record-contract}
(fact "retains pinned defaults and extensions as an open record"
  (let [value (module/book-module (with-meta {:lang :js :id 'demo :custom/value 7} {:origin :input}))
        extended (assoc value :custom/extra false)
        restored (dissoc extended :custom/extra)]
    [(instance? module/BookModule value)
     (select-keys value [:internal :native-lu :require-impl :display :custom/value])
     (meta value)
     (instance? module/BookModule extended)
     (instance? module/BookModule restored)
     (= value restored)
     (= value (module/book-module value))
     (module/book-module? (with-meta {} {:lang.base.book-module/book-module true}))])
  => [true {:internal nil :native-lu nil :require-impl [] :display :default :custom/value 7}
      nil true true true true false])

^{:refer lang.base.book-module/module-materialized-code :id book-module-materialization-guard}
(fact "retains raw code and skips active entries while restoring the caller guard"
  (let [entry {:lang :js :module 'demo :id 'run :op :plain :form-input '(plain 1)}
        source (module/book-module {:lang :js :id 'demo :code {'run entry}})
        baseline template/*computing-entries*
        result (binding [template/*computing-entries* #{[:js 'demo 'run]}]
                 (module/module-materialized-code {:lang :lua :modules {'demo source} :grammar {:reserved {:plain {:op :plain}}}} source))]
    [(module/module-materialized-code nil source)
     result
     (= baseline template/*computing-entries*)])
  => [{'run {:lang :js :module 'demo :id 'run :op :plain :form-input '(plain 1)}}
      {'run {:lang :js :module 'demo :id 'run :op :plain :form-input '(plain 1)}} true])

^{:refer lang.base.book-module/module-add-polyfill-link :id book-module-polyfill-link-contract}
(fact "adds all link directions once and preserves alias-conflict details"
  (let [value (module/book-module {:lang :js :id 'demo})
        linked (module/module-add-polyfill-link value 'demo.poly)]
    [(select-keys linked [:link :internal :alias])
     (= linked (module/module-add-polyfill-link linked 'demo.poly))
     (select-keys value [:link :internal :alias])
     (try
       (module/module-add-polyfill-link
         (module/book-module {:lang :js :id 'demo :alias {'polyfill-demo.poly 'other}})
         'demo.poly)
       :missing-error
       (catch error (select-keys (ex-data error) [:module :alias :current :polyfill])))])
  => [{:link {'polyfill-demo.poly 'demo.poly}
       :internal {'demo.poly 'polyfill-demo.poly}
       :alias {'polyfill-demo.poly 'demo.poly}}
      true {:link {} :internal nil :alias {}}
      {:module 'demo :alias 'polyfill-demo.poly :current 'other :polyfill 'demo.poly}])

^{:refer lang.base.book-module/module-entry-keys :id book-module-entry-key-contract}
(fact "returns only the requested section keys and handles missing sections"
  [(set (module/module-entry-keys {:code {'a 1 'b 2} :fragment {'f 3}} :code))
   (set (module/module-entry-keys {:code {'a 1} :fragment {'f 3}} :fragment))
   (vec (module/module-entry-keys {} :code))]
  => [#{'a 'b} #{'f} []])

^{:refer lang.base.book-module/module-entries}
(fact "a nominal module symbol has no exports without a materialized module"
 (vec (module/module-entries 'kmi.common #{:def :defn})) => [])
