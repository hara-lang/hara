(ns lang.base.grammar-spec-test
  (:require [lang.base.grammar-spec :as spec]))

(defn mixin-add-symbol
  [value]
  {:symbol spec/*symbol* :base (:base value)})

^{:refer lang.base.grammar-spec/as-list}
(Test/check
 [{:name "builds persistent generated list forms in archive order"
   :test (fn [] (spec/as-list '[a b]))
   :expected '(a b)}])

^{:refer lang.base.grammar-spec/get-comment}
(Test/check
 [{:name "gets the comment prefix from a target grammar"
   :test (fn [] (spec/get-comment {:default {:comment {:prefix "//"}}} {}))
   :expected "//"}])

^{:refer lang.base.grammar-spec/format-fargs}
(Test/check
 [{:name "preserves archive function documentation attributes and multiple arities"
   :test (fn [] [(spec/format-fargs '[[a b]])
                 (spec/format-fargs '["docstring" [a b]])
                 (spec/format-fargs '(([a] a) ([a b] (+ a b))))])
   :expected '(["" {} ([a b])]
               ["docstring" {} ([a b])]
               ["" {} (([a] a) ([a b] (+ a b)))])}])

^{:refer lang.base.grammar-spec/mixin-value}
(Test/check
 [{:name "substitutes only the archive dynamic symbol marker"
   :test (fn []
           (binding [spec/*symbol* 'hello]
             [(spec/mixin-value '*symbol*) (spec/mixin-value :literal)]))
   :expected '[hello :literal]}])

^{:refer lang.base.grammar-spec/mixin-map}
(Test/check
 [{:name "substitutes dynamic-symbol values in literal mixin maps"
   :test (fn []
           (binding [spec/*symbol* 'hello]
             (spec/mixin-map {:from-map '*symbol* :literal true})))
   :expected {:from-map 'hello :literal true}}])

^{:refer lang.base.grammar-spec/mixin-pairs}
(Test/check
 [{:name "builds mixin maps from alternating evaluated form values"
   :test (fn []
           (binding [spec/*symbol* 'hello]
             (spec/mixin-pairs [:from-form '*symbol*])))
   :expected {:from-form 'hello}}])

^{:refer lang.base.grammar-spec/evaluate-mixin-form}
(Test/check
 [{:name "evaluates portable hash-map mixin forms with dynamic substitution"
   :test (fn []
           (binding [spec/*symbol* 'hello]
             (spec/evaluate-mixin-form '(hash-map :from-form *symbol*))))
   :expected {:from-form 'hello}}])

^{:refer lang.base.grammar-spec/format-defn-mixins}
(Test/check
 [{:name "applies archive symbol form and map mixins in declared order"
   :test (fn []
           (binding [spec/*symbol* 'hello]
             [(spec/format-defn-mixins {:base true}
                                        ['lang.base.grammar-spec-test/mixin-add-symbol])
              (spec/format-defn-mixins {:base true}
                                        ['(hash-map :from-form *symbol*)])
              (spec/format-defn-mixins {:base true}
                                        [{:from-map true}])]))
   :expected '[{:symbol hello :base true}
               {:from-form hello}
               {:base true :from-map true}]}])

^{:refer lang.base.grammar-spec/format-defn}
(Test/check
 [{:name "standardizes definition metadata while preserving the portable form"
   :test (fn [] (spec/format-defn '(defn hello "hello" {:list 1} [])))
   :expected '[{:list 1 :doc "hello"} (defn hello [])]}])

^{:refer lang.base.grammar-spec/tf-for-index}
(Test/check
 [{:name "lowers indexed loops to archive-compatible for declarations"
   :test (fn [] (spec/tf-for-index '(for:index [i [0 2 3]])))
   :expected '(for [(var i := 0) (< i 2) (:= i (+ i 3))])}])

^{:refer lang.base.grammar-spec/+op-top-base+}
(Test/check
 [{:name "retains top-level grammar entries with callable archive formatters"
   :test (fn []
           (let [entry (first spec/+op-top-base+)]
             [(set (:symbol entry))
              (:format entry)
              (set (map :op spec/+op-for+))]))
   :expected [#{'defn 'defn- 'defabstract}
              #'spec/format-defn
              #{:for-index :for-object :for-array :for-iter}]}])
