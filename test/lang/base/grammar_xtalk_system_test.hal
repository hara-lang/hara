(ns lang.base.grammar-xtalk-system-test
  (:use code.test)
  (:require [lang.base.grammar-xtalk-system :refer :all]))

^{:refer lang.base.grammar-xtalk-system/xtalk-entry? :added "4.1"}
(fact "detects xtalk grammar entries"
  (xtalk-entry? {:op :x-add})
  => true

  (xtalk-entry? [:x-add])
  => false)

^{:refer lang.base.grammar-xtalk-system/xtalk-profiles :added "4.1"}
(fact "returns xtalk profiles in grammar order"
  (xtalk-profiles)
  => [:xtalk-common
      :xtalk-functional
      :xtalk-language-specific
      :xtalk-tahto.core-link-specific
      :xtalk-runtime-specific])

^{:refer lang.base.grammar-xtalk-system/xtalk-areas :added "4.1"}
(fact "returns xtalk implementation areas in order"
  (xtalk-areas)
  => [:common
      :functional
      :language-specific
      :tahto.core-link-specific
      :runtime-specific])

^{:refer lang.base.grammar-xtalk-system/xtalk-area-profiles :added "4.1"}
(fact "returns profiles for an xtalk area"
  (xtalk-area-profiles :common)
  => [:xtalk-common]

  (xtalk-area-profiles :unknown)
  => [])

^{:refer lang.base.grammar-xtalk-system/xtalk-profile-ops :added "4.1"}
(fact "returns ops for a profile"
  (let [ops (xtalk-profile-ops :xtalk-common)]
    [(has? ops :x-add)
     (has? ops :x-obj-keys)])
  => [true true])

^{:refer lang.base.grammar-xtalk-system/xtalk-op-profiles :added "4.1"}
(fact "returns profiles for an op"
  (xtalk-op-profiles :x-add)
  => #{:xtalk-common})

^{:refer lang.base.grammar-xtalk-system/xtalk-op-profiles :added "4.1"
  :id test-xtalk-op-profiles-promise}
(fact "includes promise ops in the runtime-specific profile"
  (xtalk-op-profiles :x-promise)
  => #{:xtalk-runtime-specific}

  (xtalk-op-profiles :x-promise-native?)
  => #{:xtalk-runtime-specific})

^{:refer lang.base.grammar-xtalk-system/xtalk-op-entry :added "4.1"}
(fact "returns the full xtalk entry for an op"
  (select-keys (xtalk-op-entry :x-add) [:op :symbol :emit])
  => '{:op :x-add
       :symbol #{x:add}
       :emit :macro})

^{:refer lang.base.grammar-xtalk-system/xtalk-symbol-op :added "4.1"}
(fact "maps symbols back to xtalk ops"
  (xtalk-symbol-op 'x:add)
  => :x-add)

^{:refer lang.base.grammar-xtalk-system/xtalk-symbol-entry :added "4.1"}
(fact "maps symbols back to xtalk entries"
  (-> (xtalk-symbol-entry 'x:add)
      (select-keys [:op :emit]))
  => '{:op :x-add
        :emit :macro})

^{:refer lang.base.grammar-xtalk-system/xtalk-symbol-entry :added "4.1"
  :id test-xtalk-symbol-entry-promise}
(fact "maps promise symbols back to xtalk entries"
  (-> (xtalk-symbol-entry 'x:promise)
      (select-keys [:op :emit :raw]))
  => '{:op :x-promise
       :emit :hard-link
       :raw xt.lang.common-promise/promise})

^{:refer lang.base.grammar-xtalk-system/xtalk-op-requires :added "4.1"}
(fact "returns direct required xtalk ops"
  (xtalk-op-requires :x-arr-map)
  => #{})

^{:refer lang.base.grammar-xtalk-system/xtalk-op-closure :added "4.1"}
(fact "returns transitive op requirements including the op"
  (xtalk-op-closure :x-arr-map)
  => #{:x-arr-map})

^{:refer lang.base.grammar-xtalk-system/xtalk-ops-profiles :added "4.1"}
(fact "returns the combined profile set for ops"
  (xtalk-ops-profiles #{:x-add :x-arr-map})
  => #{:xtalk-common
       :xtalk-functional})

^{:refer lang.base.grammar-xtalk-system/scan-xtalk :added "4.1"}
(fact "scans xtalk usage and linked polyfill modules"
  (scan-xtalk '(do (x:obj-keys data)
                   (x:arr-map items f)
                   (x:str-ends-with s suffix)))
  => '{:ops #{:x-obj-keys
              :x-arr-map
              :x-str-ends-with}
       :symbols #{x:obj-keys
                  x:arr-map
                  x:str-ends-with}
       :profiles #{:xtalk-common
                   :xtalk-functional}
       :polyfill-modules #{xt.lang.common-data
                           xt.lang.common-string}}

  (scan-xtalk '(do (tmpl:call v))
              {'tmpl:call {:emit :hard-link}})
  => '{:ops #{}
       :symbols #{}
       :profiles #{}
       :polyfill-modules #{}
        :template? true}

  (scan-xtalk '(do (x:promise fn)
                   (x:promise-then p f)
                   (x:promise-catch p f))
              {:reserved {'x:promise       {:emit :macro}
                          'x:promise-then  {:emit :macro}
                          'x:promise-catch {:emit :macro}}})
  => '{:ops #{:x-promise :x-promise-then :x-promise-catch}
       :symbols #{x:promise x:promise-then x:promise-catch}
       :profiles #{:xtalk-runtime-specific}
       :polyfill-modules #{}})

^{:refer lang.base.grammar-xtalk-system/xtalk-ops-polyfill-symbols :added "4.1"}
(fact "returns hard-link helper symbols for xtalk ops"
  (xtalk-ops-polyfill-symbols #{:x-obj-keys
                                :x-promise})
  => '#{xt.lang.common-data/obj-keys
        xt.lang.common-promise/promise})

^{:refer lang.base.grammar-xtalk-system/xtalk-ops-polyfill-symbols, :added "4.1", :id test-xtalk-ops-polyfill-symbols-overrides}
(fact
  "respects grammar overrides when finding polyfill symbols"
  (let [js-grammar {:reserved
                    {'x:promise {:emit :macro},
                     'x:promise-then {:emit :macro},
                     'x:promise-catch {:emit :macro}}}]
    (xtalk-ops-polyfill-symbols
      #{:x-promise-then :x-promise :x-promise-catch}
      js-grammar))
  =>
  '#{}
  (let [js-grammar {:reserved
                    {'x:promise {:emit :macro},
                     'x:promise-then {:emit :macro},
                     'x:promise-catch {:emit :macro}}}]
    (xtalk-ops-polyfill-symbols #{:x-promise :x-obj-keys} js-grammar))
  =>
  '#{xt.lang.common-data/obj-keys})

^{:refer lang.base.grammar-xtalk-system/xtalk-grammar-supported-ops :added "4.1"}
(fact "returns supported ops from reserved grammar entries"
  (xtalk-grammar-supported-ops
   {:reserved {'x:add {:op :x-add}
               'x:arr-map {:op :x-arr-map}
               'foo {:op :foo}}})
  => #{:x-add
       :x-arr-map})

^{:refer lang.base.grammar-xtalk-system/xtalk-grammar-supported-profiles :added "4.1"}
(fact "returns fully supported profiles for a grammar"
  (let [reserved (into {}
                       (map (fn [op]
                              [(symbol "xtest" (name op))
                               {:op op}])
                            (xtalk-profile-ops :xtalk-common)))]
    (xtalk-grammar-supported-profiles {:reserved reserved}))
  => [:xtalk-common])

^{:refer lang.base.grammar-xtalk-system/xtalk-grammar-missing-profiles :added "4.1"}
(fact "returns required profiles not fully supported by a grammar"
  (let [reserved (into {}
                       (map (fn [op]
                              [(symbol "xtest" (name op))
                               {:op op}])
                            (xtalk-profile-ops :xtalk-common)))]
    (xtalk-grammar-missing-profiles {:reserved reserved}
                                    [:xtalk-common :xtalk-functional]))
  => #{:xtalk-functional})

^{:refer lang.base.grammar-xtalk-system/xtalk-library-profiles :added "4.1"}
(fact "returns required profiles for new xtalk library namespaces"
  (xtalk-library-profiles 'xtalk.lib.db.sql)
  => #{:xtalk-common
       :xtalk-runtime-specific})

^{:refer lang.base.grammar-xtalk-system/xtalk-unclassified-ops :added "4.1"}
(fact "returns xtalk ops not assigned to any profile"
  (xtalk-unclassified-ops)
  => [])


^{:refer lang.base.grammar-xtalk-system/xtalk-op-polyfill-symbol :added "4.1"}
(fact "returns the hard-link helper symbol for an xtalk op"
  (xtalk-op-polyfill-symbol :x-obj-keys)
  => 'xt.lang.common-data/obj-keys

  (xtalk-op-polyfill-symbol :x-promise)
  => 'xt.lang.common-promise/promise

  (xtalk-op-polyfill-symbol :x-add)
  => nil

  (xtalk-op-polyfill-symbol :x-obj-keys
                            {:reserved {'x:obj-keys {:emit :macro}}})
  => nil)

^{:refer lang.base.grammar-xtalk-system/xtalk-ops-polyfill-modules :added "4.1"}
(fact "returns helper module namespaces for a collection of xtalk ops"
  (xtalk-ops-polyfill-modules #{:x-obj-keys
                                :x-promise})
  => '#{xt.lang.common-data
        xt.lang.common-promise}

  (xtalk-ops-polyfill-modules #{:x-add})
  => '#{}

  (xtalk-ops-polyfill-modules #{:x-obj-keys :x-promise}
                              {:reserved {'x:promise {:emit :macro}}})
  => '#{xt.lang.common-data})


^{:refer lang.base.grammar-xtalk-system/+xtalk-area-order+ :id system-area-order-contract}
(fact "retains the five declaration areas in their original order"
  +xtalk-area-order+
  => [:xtalk-common :xtalk-fn :xtalk-impl :xtalk-link :xtalk-runtime])

^{:refer lang.base.grammar-xtalk-system/+xtalk-area->entries+ :id system-area-entries-contract}
(fact "retains every original grammar group in its owning area"
  +xtalk-area->entries+
  => {:xtalk-common [lang.base.grammar-xtalk/+xt-common-basic+
                      lang.base.grammar-xtalk/+xt-common-index+
                      lang.base.grammar-xtalk/+xt-common-number+
                      lang.base.grammar-xtalk/+xt-common-nil+
                      lang.base.grammar-xtalk/+xt-common-primitives+
                      lang.base.grammar-xtalk/+xt-common-lu+
                      lang.base.grammar-xtalk/+xt-common-object+
                      lang.base.grammar-xtalk/+xt-common-array+
                      lang.base.grammar-xtalk/+xt-common-print+
                      lang.base.grammar-xtalk/+xt-common-string+
                      lang.base.grammar-xtalk/+xt-common-bytes+
                      lang.base.grammar-xtalk/+xt-common-math+]
      :xtalk-fn [lang.base.grammar-xtalk/+xt-functional-base+
                 lang.base.grammar-xtalk/+xt-functional-invoke+
                 lang.base.grammar-xtalk/+xt-functional-return+
                 lang.base.grammar-xtalk/+xt-functional-array+
                 lang.base.grammar-xtalk/+xt-functional-iter+]
      :xtalk-impl [lang.base.grammar-xtalk/+xt-lang-global+
                   lang.base.grammar-xtalk/+xt-lang-bit+
                   lang.base.grammar-xtalk/+xt-lang-throw+
                   lang.base.grammar-xtalk/+xt-lang-unpack+
                   lang.base.grammar-xtalk/+xt-lang-random+
                   lang.base.grammar-xtalk/+xt-lang-time+
                   lang.base.grammar-xtalk/+xt-lang-json+]
      :xtalk-link [lang.base.grammar-xtalk/+xt-socket+
                   lang.base.grammar-xtalk/+xt-notify-http+]
      :xtalk-runtime [lang.base.grammar-xtalk/+xt-runtime-promise+
                      lang.base.grammar-xtalk/+xt-runtime-shell+
                      lang.base.grammar-xtalk/+xt-runtime-file+]})

^{:refer lang.base.grammar-xtalk-system/+xtalk-area->surface+ :id system-area-surface-contract}
(fact "preserves original surface names without renaming link profiles"
  +xtalk-area->surface+
  => {:xtalk-common {:area :common :profile :xtalk-common}
      :xtalk-fn {:area :functional :profile :xtalk-functional}
      :xtalk-impl {:area :language-specific :profile :xtalk-language-specific}
      :xtalk-link {:area :tahto.core-link-specific :profile :xtalk-tahto.core-link-specific}
      :xtalk-runtime {:area :runtime-specific :profile :xtalk-runtime-specific}})

^{:refer lang.base.grammar-xtalk-system/+xtalk-profile-order+ :id system-profile-order-contract}
(fact "retains the public profile order"
  +xtalk-profile-order+
  => [:xtalk-common :xtalk-functional :xtalk-language-specific
      :xtalk-tahto.core-link-specific :xtalk-runtime-specific])

^{:refer lang.base.grammar-xtalk-system/+xtalk-areas+ :id system-areas-contract}
(fact "retains the public implementation areas"
  +xtalk-areas+
  => [:common :functional :language-specific :tahto.core-link-specific :runtime-specific])

^{:refer lang.base.grammar-xtalk-system/+xtalk-profiles+ :id system-profiles-contract}
(fact "flattens groups inside each profile without changing entry order"
  +xtalk-profiles+
  => (mapv (fn [[profile area]]
             [profile (vec (mapcat identity (get +xtalk-area->entries+ area)))])
           [[:xtalk-common :xtalk-common]
            [:xtalk-functional :xtalk-fn]
            [:xtalk-language-specific :xtalk-impl]
            [:xtalk-tahto.core-link-specific :xtalk-link]
            [:xtalk-runtime-specific :xtalk-runtime]]))

^{:refer lang.base.grammar-xtalk-system/+xtalk-area->profiles+ :id system-area-profiles-contract}
(fact "maps all surface areas to their declared profiles"
  +xtalk-area->profiles+
  => {:common [:xtalk-common] :functional [:xtalk-functional]
      :language-specific [:xtalk-language-specific]
      :tahto.core-link-specific [:xtalk-tahto.core-link-specific]
      :runtime-specific [:xtalk-runtime-specific]})

^{:refer lang.base.grammar-xtalk-system/+xtalk-profile->ops+ :id system-profile-ops-contract}
(fact "indexes exactly the keyword operations declared in each profile"
  +xtalk-profile->ops+
  => (into {} (map (fn [[profile entries]]
                    [profile (set (keep (fn [entry]
                                         (if (and (map? entry) (keyword? (:op entry)))
                                           (:op entry))) entries))])
                  +xtalk-profiles+)))

^{:refer lang.base.grammar-xtalk-system/+xtalk-op->entry+ :id system-op-entry-contract}
(fact "indexes full entries in declaration order with later declarations winning"
  +xtalk-op->entry+
  => (reduce (fn [out entry]
               (if (and (map? entry) (keyword? (:op entry)))
                 (assoc out (:op entry) entry)
                 out))
             {} (mapcat second +xtalk-profiles+)))

^{:refer lang.base.grammar-xtalk-system/+xtalk-op-entry+ :id system-op-entry-alias-contract}
(fact "preserves the complete operation-entry alias and representative macro fields"
  [+xtalk-op-entry+ (select-keys (:x-add +xtalk-op-entry+) [:op :emit])]
  => [+xtalk-op->entry+ {:op :x-add :emit :macro}])

^{:refer lang.base.grammar-xtalk-system/+xtalk-symbol->op+ :id system-symbol-op-contract}
(fact "indexes every symbol alias of every operation"
  +xtalk-symbol->op+
  => (reduce (fn [out entry]
               (reduce (fn [out sym] (assoc out sym (:op entry)))
                       out (:symbol entry)))
             {} (vals +xtalk-op->entry+)))

^{:refer lang.base.grammar-xtalk-system/+xtalk-op->profiles+ :id system-op-profiles-contract}
(fact "operation and profile indexes are exact inverse relations"
  (set (mapcat (fn [[op profiles]] (map (fn [profile] [profile op]) profiles))
               (seq +xtalk-op->profiles+)))
  => (set (mapcat (fn [[profile ops]] (map (fn [op] [profile op]) ops))
                  (seq +xtalk-profile->ops+)))
  (set (keys +xtalk-op->profiles+))
  => (set (keys +xtalk-op->entry+)))

^{:refer lang.base.grammar-xtalk-system/+xtalk-op-profiles+ :id system-op-profiles-alias-contract}
(fact "preserves the reverse-index alias including runtime promise ownership"
  [+xtalk-op-profiles+ (:x-promise +xtalk-op-profiles+)]
  => [+xtalk-op->profiles+ #{:xtalk-runtime-specific}])

^{:refer lang.base.grammar-xtalk-system/+xtalk-ops+ :id system-ops-contract}
(fact "lists every indexed operation once in sorted order"
  +xtalk-ops+
  => (vec (sort (keys +xtalk-op->entry+))))

^{:refer lang.base.grammar-xtalk-system/+xtalk-library->profiles+ :id system-library-profiles-contract}
(fact "retains all original library profile requirements"
  +xtalk-library->profiles+
  => {'xtalk.lib.db.check #{:xtalk-common}
      'xtalk.lib.db.sql #{:xtalk-common :xtalk-runtime-specific}
      'xtalk.lib.db.call #{:xtalk-common :xtalk-functional :xtalk-runtime-specific}})
