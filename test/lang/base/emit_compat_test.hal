(ns lang.base.emit-compat-test
  (:use code.test)
  (:require [lang.base.emit :as emit]
    [lang.base.emit-common :as common]
    [lang.base.emit-helper :as helper]))

(def operator-grammar
  (assoc helper/+default+
         :reserved
         {'+ {:op :add :emit :infix :raw "+"}
          '- {:op :sub :emit :infix- :raw "-"}
          'not {:op :not :emit :pre :raw "!"}
          := {:op :assign :emit :assign :raw "="}
          '. {:op :index :emit :index}
          'return {:op :return :emit :return :raw "return"}}))

^{:refer lang.base.emit-common/emit-infix, :id retained-native-common} (fact "common helpers retain Foundation behavior" (common/emit-infix "|" (quote [x y z]) helper/+default+ {}) => "x | y | z" (emit/emit (quote (- x)) operator-grammar nil {}) => "-x" (emit/emit (quote (+ 1 (+ 2 3))) operator-grammar nil {}) => "1 + (2 + 3)" (emit/emit (quote (:= x 1)) operator-grammar nil {}) => "x = 1")

^{:refer lang.base.emit/emit, :id retained-native-composite} (fact "calls, indexing, data, and returns retain compatibility" (emit/emit (quote (print (+ 19 23))) operator-grammar nil {}) => "print(19 + 23)" (emit/emit (quote (. user ["name"])) operator-grammar nil {}) => "user[\"name\"]" [(emit/emit [1 2 3] helper/+default+ nil {}) (emit/emit {:answer 42} helper/+default+ nil {})] => ["[1,2,3]" "{\"answer\":42}"] (emit/emit (quote (return (+ 20 22))) operator-grammar nil {}) => "return 20 + 22")
