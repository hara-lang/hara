(ns lang.base.emit-prep-js-test
  (:require [lang.base.book :as b]
            [lang.base.emit-helper :as helper]
            [lang.base.grammar :as grammar]
            [lang.model.v1.spec-js.meta :as js-meta]))

(def +book-empty+
  (b/book {:lang :js
           :meta js-meta/+meta+
           :grammar (grammar/grammar :js
                      (grammar/to-reserved (grammar/build))
                      helper/+default+)}))

(def +core-module+
  (b/book-module
   {:id       'JS.core
    :lang     :js
    :link     '{- JS.core}}))

(def +core-fragment-add+
 (b/book-entry
   {:lang :js,
    :id 'add,
    :module 'JS.core,
    :section :fragment,
    :form '(fn [x y] (list '+ x y)),
    :template (fn [x y] (list '+ x y)),
    :standalone true,
    :namespace (ns-current)}))

(def +core-code-identity-fn+
 (b/book-entry
   {:form-input '(defn identity-fn [x] (return x)),
    :section :code,
    :module 'JS.core,
    :lang :js,
    :id 'identity-fn,
    :declared false,
    :form '(defn identity-fn [x] (return x)),
    :namespace (ns-current),
    :deps #{}}))

(def +book-min+
  (-> +book-empty+
      (b/set-module +core-module+)
      second
      (b/set-entry +core-fragment-add+)
      second
      (b/set-entry +core-code-identity-fn+)
      second))



^{:refer lang.base.emit-prep-js-test/+book-min+}
(Test/check
 [{:name "JS fixture construction leaves the empty Book and module unchanged"
   :test (fn [] [(:lang +book-empty+) (:modules +book-empty+)
                 (:id +core-module+) (:link +core-module+) (:code +core-module+)])
   :expected [:js {} 'JS.core '{- JS.core} {}]}
  {:name "JS fixture fragment expands the supplied operands exactly"
   :test (fn [] [((:template +core-fragment-add+) 'left 'right)
                 (:standalone +core-fragment-add+)])
   :expected ['(+ left right) true]}
  {:name "JS fixture Book contains the original fragment and identity entry"
   :test (fn []
           (let [module (b/get-module +book-min+ 'JS.core)
                 identity-entry (b/get-entry +book-min+ 'JS.core/identity-fn)]
             [(set (keys (:fragment module))) (set (keys (:code module)))
              (:form identity-entry) (:form-input identity-entry) (:deps identity-entry)
              ((:template (b/get-fragment-entry +book-min+ 'JS.core/add)) 3 4)]))
   :expected [#{'add} #{'identity-fn} '(defn identity-fn [x] (return x))
              '(defn identity-fn [x] (return x)) #{} '(+ 3 4)]}])

