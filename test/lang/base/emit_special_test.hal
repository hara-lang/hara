(ns lang.base.emit-special-test
  (:use code.test)
  (:require [lang.base.emit-common :as common]
            [lang.base.emit-helper :as helper]
            [lang.base.emit-special :as special]
            [lang.core.script :as script]))

(def snapshot
  {:js {:book {:modules {'app.core
                         {:code {'visible {:id 'visible :op :def}
                                 'hidden {:id 'hidden :op :test}}}}}}})

^{:refer lang.base.emit-special/emit-with-module-all-ids :added "4.0"}
(fact "selects allowed module ids"
  (special/emit-with-module-all-ids snapshot :js 'app.core #{:def})
  => ['visible])

(fact "orders module ids by Foundation source priority"
  (special/emit-with-module-all-ids
   {:js {:book
         {:modules
          {'app.core
           {:code
            {'late {:id 'late :op :def :priority 2 :time 1 :line 1}
             'last {:id 'last :op :def :priority 2 :time 2 :line 1}
             'first {:id 'first :op :def :priority 1 :time 9 :line 4}}}}}}}
   :js 'app.core #{:def})
  => ['first 'late 'last])

^{:refer lang.base.emit-special/emit-with-module :added "4.0"}
(fact "emits an allowed module as a table"
  (binding [common/*emit-fn* special/test-special-loop]
    (special/emit-with-module
     nil nil '(module :js app.core)
     (assoc-in helper/+default+ [:default :module :allow] #{:def})
     {:snapshot snapshot}))
  => "{\"visible\":app.core.visible}")

^{:refer lang.base.emit-special/emit-with-preprocess :added "4.0"}
(fact "preprocesses before recursively emitting"
  (binding [common/*emit-fn* special/test-special-loop]
    (special/emit-with-preprocess '(print 1) helper/+default+ {}))
  => "print(1)")

^{:refer lang.base.emit-special/emit-with-eval :added "4.0"}
(fact "evaluates host forms and emits their values"
  (special/emit-with-eval nil nil '(!:eval (+ 1 2 3)) helper/+default+ {})
  => "6"

  (special/emit-with-eval nil nil '(!:eval '(+ 1 2 3)) helper/+default+ {})
  => "(+ 1 2 3)"

  (special/emit-with-eval nil nil '(!:eval (+ host-value 2)) helper/+default+
                          {:namespace 'lang.base.emit-special-test})
  => "3"

  (try
    (special/emit-with-eval
     nil nil '(!:eval (throw (ex :argument {} :ex/message "host failure")))
     helper/+default+ {})
    :no-error
    (catch error [(:ex/code (ex-data error)) (:ex/message (ex-data error))]))
  => [:hara/argument "host failure"])

^{:refer lang.base.emit-special/emit-with-deref :added "4.0"}
(fact "dereferences host Vars and rejects non-Var forms"
  (special/emit-with-deref nil nil
                           '(!:deref (var lang.base.emit-special-test/host-value))
                           helper/+default+ {})
  => "1"

  (special/emit-with-deref nil nil '(!:deref (var host-value)) helper/+default+
                           {:namespace 'lang.base.emit-special-test})
  => "1"

  (try
    (special/emit-with-deref nil nil '(!:deref (+ 1 2)) helper/+default+ {})
    :no-error
    (catch error [(:ex/code (ex-data error)) (:form (ex-data error))]))
  => [:hara/argument '(+ 1 2)])

^{:refer lang.base.emit-special/emit-with-lang :added "4.0"}
(fact "selects a snapshot language before emitting"
  (binding [common/*emit-fn* special/test-special-loop]
    (special/emit-with-lang
     nil nil '(!:lang {:lang :js} (print 1)) helper/+default+
     {:snapshot {:js {:book {:grammar helper/+default+ :modules {}}}}}))
  => "print(1)")

^{:refer lang.base.emit-special/test-special-loop :added "4.0"}
(fact "the Foundation special loop retains direct dispatch"
  (special/test-special-loop '(print 1) helper/+default+ {})
  => "print(1)")

^{:refer lang.base.emit-special/test-special-emit :added "4.0"}
(fact "the Foundation special test emitter installs recursive dispatch"
  (special/test-special-emit
   ''(1 2 3)
   (assoc helper/+default+
          :reserved {'quote {:op :quote :emit :quote}})
   {})
  => "(1,2,3)")

^{:refer lang.base.emit-special/allowed-op? :added "0.1"}
(fact "allows every operation without a filter and only members with a filter"
  [(special/allowed-op? nil :def)
   (special/allowed-op? #{:def :defn} :def)
   (special/allowed-op? #{:def :defn} :test)
   (special/allowed-op? #{} :def)]
  => [true true false false])

(def host-value 1)

^{:refer lang.base.emit-special/emit-with-preprocess :added "4.0"}
(fact "emits evaluated target forms without native staging markers and retains metadata"
  (let [baseline (script/script-snapshot)
        result
        (try
          (script/script-reset!)
          (script/setup :lua 'demo.bootstrap {} true 'lang.base.emit-special-test)
          (let [book (script/selected-book :lua)
                options {:lang :lua :book book}]
            [(binding [common/*emit-fn* special/test-special-loop]
               (special/emit-with-eval nil nil '(!:eval '(+ 1 2 3))
                                       (:grammar book) options))
             (binding [common/*emit-fn* (fn [form grammar mopts]
                                         [(first form) (:line (meta form))])]
               (special/emit-with-preprocess
                (with-meta '(+ 1 2 3) {:line 23}) (:grammar book) options))])
          (finally (script/script-restore! baseline)))]
    [result (= baseline (script/script-snapshot))])
  => [["1 + 2 + 3" ['+ 23]] true])
