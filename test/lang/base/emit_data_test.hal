(ns lang.base.emit-data-test
  (:require [lang.base.emit-common :as common]
            [lang.base.emit-data :as data :refer :all]
            [lang.base.emit-helper :as helper]
            [lang.base.grammar :as grammar])
  (:use code.test))

(def +reserved+
  (-> (grammar/build)
      (grammar/to-reserved)))

(def +grammar+
  (grammar/grammar :test +reserved+ helper/+default+))

^{:refer lang.base.emit-data/default-map-key :added "4.0"}
(fact "emits a default map key"

  (default-map-key 'hello
                   helper/+default+
                   {})
  => "hello")

^{:refer lang.base.emit-data/emit-map-key :added "4.0"}
(fact "emits the map key"

  (emit-map-key 'hello
                helper/+default+
                {})
  => "hello"

  (emit-map-key "hello"
                helper/+default+
                {})
  => "\"hello\""

  (emit-map-key :hello
                (merge helper/+default+
                       {:data {:map-entry  {:start ""  :end ""  :assign ":" :space "" :keyword :keyword}}})
                {})
  => ":hello")

^{:refer lang.base.emit-data/emit-map-entry, :added "3.0"}
(fact
  "emits the map entry"
  (emit-map-entry [:hello "world"] helper/+default+ {})
  =>
  "\"hello\":\"world\""
  (identity "=>")
  "'hello':'world'"
  (emit-map-entry
    [:hello "world"]
    (assoc-in helper/+default+ [:data :map-entry :assign] " = ")
    {})
  =>
  "\"hello\" = \"world\"")

^{:refer lang.base.emit-data/emit-singleline-array? :added "4.0"}
(fact "checks that array is all single lines"

  (emit-singleline-array? ["1" "2" "3"])
  => true

  (emit-singleline-array? ["1" "\n2" "3"])
  => false)

^{:refer lang.base.emit-data/emit-maybe-multibody :added "4.0"}
(fact "checks multiline body prefixes"

  (emit-maybe-multibody ["1" "2"] "hello")
  => "2hello"

  (emit-maybe-multibody ["1" "2"] "\nhello")
  => "1  \n  hello")

^{:refer lang.base.emit-data/emit-coll-layout :added "4.0"}
(fact "constructs the collection"

  (emit-coll-layout :vector 2 ["1" "2" "3"] helper/+default+ {})
  => "[1,2,3]"

  (emit-coll-layout :vector 2 ["1" "\n2" "3"] helper/+default+ {})

  => "[\n    1,\n    \n  2,\n    3\n  ]"

  (emit-coll-layout :tuple 2 ["1" "\n2" "3"] helper/+default+ {})
  => "  (1,\n    \n  2,\n    3)")

^{:refer lang.base.emit-data/emit-coll :added "3.0"}
(fact "emits a collection"

  (emit-coll :vector [1 2 3] helper/+default+ {})
  => "[1,2,3]"

  (emit-coll :set [1 2 3] helper/+default+ {})
  => "(1,2,3)"

  (emit-coll :custom [1 2 3] (assoc-in helper/+default+
                                       [:data :custom]
                                       {:start "<" :end ">" :space ""}) {})
  => "<1,2,3>")

^{:refer lang.base.emit-data/emit-data-standard :added "4.0"}
(fact "emits either a custom string or default coll"
  (emit-data-standard :vector [1 2 3] helper/+default+ {})
  => "[1,2,3]")

^{:refer lang.base.emit-data/emit-data :added "3.0"}
(fact "main function for data forms"

  (emit-data :map {:a 1 :b 2} helper/+default+ {:map {}})
  => "{[:a 1],[:b 2]}"

  (emit-data :vector {:a 1 :b 2} helper/+default+ {:map {}})
  => "[[:a 1],[:b 2]]")

^{:refer lang.base.emit-data/emit-quote :added "4.0"}
(fact "emit quote structures"

  (emit-quote nil nil ''(1 2 3) +grammar+ {})
  => "(1,2,3)")

^{:refer lang.base.emit-data/emit-table-group :added "4.0"}
(fact "gets table group"
  (emit-table-group [:a 1 :b 2 :c :d])
  => [[:a 1] [:b 2] 'c 'd])

^{:refer lang.base.emit-data/emit-table :added "4.0"}
(fact "emits table structures"

  (emit-table nil nil '(tab :a 1 :b 2) +grammar+ {})
  => "{\"a\":1,\"b\":2}")

^{:refer lang.base.emit-data/test-data-loop, :adopt true, :added "4.0"}
(fact
  "emit for data structures"
  (test-data-loop '[(+ 1 2)] +grammar+ {})
  =>
  "[(+ 1 2)]"
  (test-data-loop '{:a (+ 1 2)} +grammar+ {})
  =>
  "{[:a (+ 1 2)]}"
  (test-data-loop '#{(+ 1 2)} +grammar+ {})
  =>
  (throws)
  [:quote]
  (test-data-loop ''((+ A B) C) +grammar+ {})
  =>
  "((+ A B),C)"
  (test-data-loop
    (list 'quote (vector (list '+ 'A 'B) 'C))
    +grammar+
    {})
  =>
  "(+ A B),C"
  [:table]
  (test-data-loop '(tab :a (+ 1 2) :b 2) +grammar+ {})
  =>
  "{\"a\":(+ 1 2),\"b\":2}"
  (test-data-loop '(tab 1 (+ 1 2) 3 4 5) +grammar+ {})
  =>
  "{1,(+ 1 2),3,4,5}")

^{:refer lang.base.emit-data/test-data-emit, :adopt true, :added "4.0"}
(fact
  "emits recursive data structures"
  (test-data-emit '[(+ 1 2)] +grammar+ {})
  =>
  "[1 + 2]"
  (test-data-emit '[(+ 1 2) (+ 3 4)] +grammar+ {})
  =>
  "[1 + 2,3 + 4]"
  (test-data-emit '[(+ 1 2) \0] +grammar+ {})
  =>
  "[1 + 2,]"
  (test-data-emit '{:a (+ 1 2)} +grammar+ {})
  =>
  "{\"a\":1 + 2}"
  (test-data-emit '{:a (not (+ 1 2))} +grammar+ {})
  =>
  "{\"a\":!(1 + 2)}"
  (test-data-emit '{(not (+ 1 2)) A} +grammar+ {})
  =>
  "{!(1 + 2):A}"
  [:quote]
  (test-data-emit ''((+ A B) C) +grammar+ {})
  =>
  "(A + B,C)"
  (test-data-emit
    (list 'quote (vector (list '+ 'A 'B) 'C))
    +grammar+
    {})
  =>
  "A + B,C"
  [:table]
  (test-data-emit '(tab :a (+ 1 2) :b 2) +grammar+ {})
  =>
  "{\"a\":1 + 2,\"b\":2}"
  (test-data-emit '(tab 1 (+ 1 2) 3 4 5) +grammar+ {})
  =>
  "{1,1 + 2,3,4,5}")

^{:refer lang.base.emit-data/default-map-key, :added "4.0", :id :preserved-native-0}
(fact
  "native: emits a default map key"
  (binding [common/*emit-fn* common/emit-common-loop]
    (data/default-map-key 'hello helper/+default+ {}))
  =>
  "hello")
^{:refer lang.base.emit-data/emit-map-key, :added "4.0", :id :preserved-native-1}
(fact
  "native: emits configured map keys"
  (binding [common/*emit-fn* common/emit-common-loop]
    [(data/emit-map-key 'hello helper/+default+ {})
     (data/emit-map-key "hello" helper/+default+ {})
     (data/emit-map-key
       :hello
       (-> helper/+default+
        (assoc :banned #{:set})
        (assoc-in [:data :map-entry :keyword] :keyword))
       {})])
  =>
  ["hello" "\"hello\"" ":hello"])
^{:refer lang.base.emit-data/emit-map-entry, :added "3.0", :id :preserved-native-2}
(fact
  "native: emits configured map entries"
  (binding [common/*emit-fn* common/emit-common-loop]
    [(data/emit-map-entry [:hello "world"] helper/+default+ {})
     (data/emit-map-entry
       [:hello "world"]
       (assoc-in helper/+default+ [:data :map-entry :assign] " = ")
       {})])
  =>
  ["\"hello\":\"world\"" "\"hello\" = \"world\""])
^{:refer lang.base.emit-data/emit-singleline-array?, :added "4.0", :id :preserved-native-3}
(fact
  "native: checks whether emitted arrays remain on one line"
  [(data/emit-singleline-array? ["1" "2" "3"])
   (data/emit-singleline-array? ["1" "\n2" "3"])]
  =>
  [true false])
^{:refer lang.base.emit-data/emit-maybe-multibody, :added "4.0", :id :preserved-native-4}
(fact
  "native: selects and indents multiline prefixes"
  [(data/emit-maybe-multibody ["1" "2"] "hello")
   (data/emit-maybe-multibody ["1" "2"] "\nhello")]
  =>
  ["2hello" "1  \n  hello"])
^{:refer lang.base.emit-data/emit-coll-layout, :added "4.0", :id :preserved-native-5}
(fact
  "native: constructs single and multiline collection layouts"
  [(data/emit-coll-layout :vector 2 ["1" "2" "3"] helper/+default+ {})
   (data/emit-coll-layout
     :vector
     2
     ["1" "\n2" "3"]
     helper/+default+
     {})
   (data/emit-coll-layout
     :tuple
     2
     ["1" "\n2" "3"]
     helper/+default+
     {})]
  =>
  ["[1,2,3]"
   "[\n    1,\n    \n  2,\n    3\n  ]"
   "  (1,\n    \n  2,\n    3)"])
^{:refer lang.base.emit-data/emit-coll, :added "3.0", :id :preserved-native-6}
(fact
  "native: emits configured collections"
  (binding [common/*emit-fn* common/emit-common-loop]
    [(data/emit-coll :vector [1 2 3] helper/+default+ {})
     (data/emit-coll :set [1 2 3] helper/+default+ {})
     (data/emit-coll
       :custom
       [1 2 3]
       (assoc-in
         helper/+default+
         [:data :custom]
         {:start "<", :end ">", :space ""})
       {})])
  =>
  ["[1,2,3]" "(1,2,3)" "<1,2,3>"])
^{:refer lang.base.emit-data/emit-data-standard, :added "4.0", :id :preserved-native-7}
(fact
  "native: emits standard data collections"
  (binding [common/*emit-fn* common/emit-common-loop]
    (data/emit-data-standard :vector [1 2 3] helper/+default+ {}))
  =>
  "[1,2,3]")
^{:refer lang.base.emit-data/custom-emitter, :id :preserved-native-8}
(fact
  "native: dereferences custom Hara Vars only at the emitter call boundary"
  [(fn? (data/custom-emitter #'data/emit-coll))
   (= data/emit-coll (data/custom-emitter data/emit-coll))]
  =>
  [true true])
^{:refer lang.base.emit-data/emit-data, :added "3.0", :id :preserved-native-9}
(fact
  "native: dispatches standard data forms"
  (binding [common/*emit-fn* data/test-data-loop]
    [(data/emit-data :map {:a 1, :b 2} helper/+default+ {})
     (data/emit-data :vector [1 2 3] helper/+default+ {})])
  =>
  ["{\"a\":1,\"b\":2}" "[1,2,3]"])
^{:refer lang.base.emit-data/emit-quote, :added "4.0", :id :preserved-native-10}
(fact
  "native: emits quoted structures"
  (binding [common/*emit-fn* data/test-data-loop]
    [(data/emit-quote nil nil ''(1 2 3) +grammar+ {})
     (data/emit-quote
       nil
       nil
       (list 'quote (vector (list :- :* :as 'dependency)))
       {:reserved
        {:- {:emit :free, :sep " "}, :* {:emit :pre, :raw "*"}},
        :data {:free {:sep ","}}}
       {})])
  =>
  ["(1,2,3)" "* as dependency"])
^{:refer lang.base.emit-data/emit-table-group, :added "4.0", :id :preserved-native-11}
(fact
  "native: groups table keys and values"
  (data/emit-table-group [:a 1 :b 2 :c :d])
  =>
  [[:a 1] [:b 2] 'c 'd])
^{:refer lang.base.emit-data/emit-table, :added "4.0", :id :preserved-native-12}
(fact
  "native: emits table structures"
  (binding [common/*emit-fn* data/test-data-loop]
    (data/emit-table nil nil '(tab :a 1 :b 2) +grammar+ {}))
  =>
  "{\"a\":1,\"b\":2}")
^{:refer lang.base.emit-data/test-data-loop, :adopt true, :added "4.0", :id :preserved-native-13}
(fact
  "native: emits Foundation data forms without installing recursion"
  [(data/test-data-loop '[(+ 1 2)] +grammar+ {})
   (data/test-data-loop '{:a (+ 1 2)} +grammar+ {})
   (data/test-data-loop ''((+ A B) C) +grammar+ {})
   (data/test-data-loop
     (list 'quote (vector (list '+ 'A 'B) 'C))
     +grammar+
     {})
   (data/test-data-loop '(tab :a (+ 1 2) :b 2) +grammar+ {})]
  =>
  ["[(+ 1 2)]"
   "{[:a (+ 1 2)]}"
   "((+ A B),C)"
   "(+ A B),C"
   "{\"a\":(+ 1 2),\"b\":2}"])
^{:refer lang.base.emit-data/test-data-emit, :adopt true, :added "4.0", :id :preserved-native-14}
(fact
  "native: emits Foundation data forms with recursive dispatch"
  [(data/test-data-emit '[(+ 1 2)] +grammar+ {})
   (data/test-data-emit '[(+ 1 2) (+ 3 4) (+ 5 6)] +grammar+ {})
   (data/test-data-emit '{:a (not (+ 1 2))} +grammar+ {})
   (data/test-data-emit ''((+ A B) C) +grammar+ {})
   (data/test-data-emit '(tab :a (+ 1 2) :b 2) +grammar+ {})]
  =>
  ["[1 + 2]"
   "[1 + 2,3 + 4,5 + 6]"
   "{\"a\":!(1 + 2)}"
   "(A + B,C)"
   "{\"a\":1 + 2,\"b\":2}"])
^{:id :preserved-native-15}
(fact
  "native: emits Foundation map keys and entries"
  (binding [common/*emit-fn* common/emit-common-loop]
    [(data/default-map-key 'hello helper/+default+ {})
     (data/emit-map-key :hello helper/+default+ {})
     (data/emit-map-entry [:hello "world"] helper/+default+ {})])
  =>
  ["hello" "\"hello\"" "\"hello\":\"world\""])
^{:id :preserved-native-16}
(fact
  "native: classifies single and multiline arrays"
  (data/emit-singleline-array? ["1" "2" "3"])
  =>
  true
  (data/emit-singleline-array? ["1" "\n2" "3"])
  =>
  false
  (data/emit-maybe-multibody ["1" "2"] "hello")
  =>
  "2hello"
  (data/emit-maybe-multibody ["1" "2"] "\nhello")
  =>
  "1  \n  hello")
^{:id :preserved-native-17}
(fact
  "native: lays out and emits collections"
  (binding [common/*emit-fn* common/emit-common-loop]
    [(data/emit-coll-layout
       :vector
       2
       ["1" "2" "3"]
       helper/+default+
       {})
     (data/emit-coll :vector [1 2 3] helper/+default+ {})
     (data/emit-coll
       :custom
       [1 2 3]
       (assoc-in
         helper/+default+
         [:data :custom]
         {:start "<", :end ">", :space ""})
       {})])
  =>
  ["[1,2,3]" "[1,2,3]" "<1,2,3>"])
^{:id :preserved-native-18}
(fact
  "native: emits quoted and table data"
  (binding [common/*emit-fn* common/emit-common-loop]
    [(data/emit-quote nil nil ''(1 2 3) helper/+default+ {})
     (data/emit-table nil nil '(tab :a 1 :b 2) helper/+default+ {})])
  =>
  ["(1,2,3)" "{\"a\":1,\"b\":2}"])
^{:id :preserved-native-19}
(fact
  "native: groups table entries"
  (data/emit-table-group [:a 1 :b 2 :c :d])
  =>
  [[:a 1] [:b 2] 'c 'd])
^{:id :preserved-native-20}
(fact
  "native: orders Foundation spread map entries at the collection edges"
  (binding [common/*emit-fn* data/test-data-loop]
    (data/emit-coll :map {:.. 3, :a 2, :# 1} helper/+default+ {}))
  =>
  "{\"#\":1,\"a\":2,\"..\":3}")
^{:id :preserved-native-21}
(fact
  "native: the Foundation data test emitter installs recursive dispatch"
  (data/test-data-emit [1 '(identity 2) 3] helper/+default+ {})
  =>
  "[1,identity(2),3]")
^{:refer lang.base.emit-data/multiline?}
(fact "native: detects multiple lines without changing the string"
 [(data/multiline? "one") (data/multiline? "one\ntwo") (data/multiline? "")]
 => [false true false])
^{:refer lang.base.emit-data/spaces}
(fact "native: constructs exact space padding"
 [(data/spaces 0) (data/spaces 3)] => ["" "   "])
^{:refer lang.base.emit-data/indent-lines}
(fact "native: indents every line by the requested amount"
 [(data/indent-lines "a\nb" 2) (data/indent-lines "a\nb" 0)]
 => ["  a\n  b" "a\nb"])
^{:refer lang.base.emit-data/indent-rest}
(fact "native: leaves the first line unchanged while indenting the rest"
 [(data/indent-rest "a" 2) (data/indent-rest "a\nb\nc" 2)]
 => ["a" "a\n  b\n  c"])
^{:refer lang.base.emit-data/table-key?}
(fact "native: recognizes keyword and explicit table key forms"
 [(data/table-key? :a) (data/table-key? '(:% a))
  (data/table-key? 'a) (data/table-key? '(other a))]
 => [true true false false])
^{:refer lang.base.emit-data/emit-singleline-array? :id empty-array-boundaries}
(fact "empty collections preserve zero width and strict layout limits"
  [(binding [common/*multiline* false common/*max-len* 1] (data/emit-singleline-array? []))
   (binding [common/*multiline* false common/*max-len* 0] (data/emit-singleline-array? []))
   (binding [common/*multiline* true common/*max-len* 1] (data/emit-singleline-array? []))
   (data/test-data-emit [] helper/+default+ {})]
  => [true false false "[]"])
