(ns lang.base.emit-preprocess-test (:use code.test) (:require [lang.base.emit-preprocess :as preprocess] [lang.base.preprocess-assign :as assign]))
^{:refer lang.base.emit-preprocess/macro-opts}
(fact
  "exposes the dynamically bound macro options"
  ((fn []
     (binding [lang.base.preprocess-base/*macro-grammar* {:id
                                                          :fixture}]
       (preprocess/with:macro-opts
         [{:mode :test}]
         (preprocess/macro-opts)))))
  =>
  {:mode :test})
^{:refer lang.base.emit-preprocess/macro-grammar}
(fact
  "exposes the dynamically bound macro grammar"
  ((fn []
     (binding [lang.base.preprocess-base/*macro-grammar* {:id
                                                          :fixture}]
       (preprocess/with:macro-opts
         [{:mode :test}]
         (preprocess/macro-grammar)))))
  =>
  {:id :fixture})
^{:refer lang.base.emit-preprocess/with:macro-opts}
(fact
  "binds macro options and grammar only for its body"
  ((fn [] [(preprocess/macro-opts)
           (binding [lang.base.preprocess-base/*macro-grammar* {:id
                                                                :bound}]
             (preprocess/with:macro-opts
               [{:mode :bound}]
               [(preprocess/macro-opts) (preprocess/macro-grammar)]))
           (preprocess/macro-opts)]))
  =>
  [nil [{:mode :bound} {:id :bound}] nil])
^{:refer lang.base.emit-preprocess/to-input-form}
(fact
  "re-exports deref input lowering"
  ((fn [] (preprocess/to-input-form '(deref value))))
  =>
  '(!:eval value))
^{:refer lang.base.emit-preprocess/to-input}
(fact
  "re-exports recursive input lowering"
  ((fn [] (preprocess/to-input '(outer (deref value)))))
  =>
  '(outer (!:eval value)))
^{:refer lang.base.emit-preprocess/eval-template-forms}
(fact
  "re-exports eager persisted template evaluation"
  ((fn [] (preprocess/eval-template-forms '(!:template (+ 1 2)))))
  =>
  3)
^{:refer lang.base.emit-preprocess/value-template-args}
(fact
  "re-exports value template argument extraction"
  ((fn []
     (preprocess/value-template-args '([left right]) (fn [] nil))))
  =>
  ['left 'right])
^{:refer lang.base.emit-preprocess/value-standalone}
(fact
  "re-exports standalone value lookup"
  ((fn []
     (preprocess/value-standalone
       'block
       {:reserved
        {'block
         {:emit :macro,
          :value/standalone 'library/value,
          :op-spec {:allow-blocks true}}}})))
  =>
  'library/value)
^{:refer lang.base.emit-preprocess/process-namespaced-resolve}
(fact
  "re-exports linked symbol resolution"
  ((fn []
     (preprocess/process-namespaced-resolve
       'alias/item
       {'library {}}
       {:module {:id 'current, :link {'alias 'library}}})))
  =>
  ['library 'item 'library/item])
^{:refer lang.base.emit-preprocess/process-namespaced-symbol}
(fact
  "re-exports namespaced dependency processing"
  ((fn []
     (let [deps (atom #{})]
       [(preprocess/process-namespaced-symbol
          'alias/item
          {'library {:code {'item {:op :defn, :id 'item}}}}
          {:module {:id 'current, :link {'alias 'library}},
           :entry {:id 'caller}}
          deps
          (atom #{})
          identity)
        (deref deps)])))
  =>
  ['library/item #{'library/item}])
^{:refer lang.base.emit-preprocess/get-fragment}
(fact
  "re-exports linked fragment lookup"
  ((fn []
     (preprocess/get-fragment
       'alias/item
       {'library {:fragment {'item :fragment}}}
       {:module {:id 'current, :link {'alias 'library}}})))
  =>
  :fragment)
^{:refer lang.base.emit-preprocess/process-standard-symbol}
(fact
  "re-exports native root dependency tracking"
  ((fn []
     (let [natives (atom {})]
       [(preprocess/process-standard-symbol
          'console.log
          {:module {:native-lu {'console :node}}}
          natives)
        (deref natives)])))
  =>
  ['console.log {:node #{'console}}])
^{:refer lang.base.emit-preprocess/find-natives}
(fact
  "re-exports quoted native import discovery"
  ((fn []
     (preprocess/find-natives
       {:form ''(console.log untouched)}
       {:module {:native-lu {'console :node}}})))
  =>
  {:node #{'console}})
^{:refer lang.base.emit-preprocess/process-inline-assignment}
(fact
  "re-exports inline assignment resolution"
  ((fn []
     (let [output (preprocess/process-inline-assignment
                    '(def local (alias/item input) :inline)
                    {'library {:code {'item {:id 'item}}}}
                    {:module {:id 'current, :link {'alias 'library}}})]
       [(assign/unwrap-protected-head (first (nth output 2)))
        (second (nth output 2))])))
  =>
  ['library/item 'input])
^{:refer lang.base.emit-preprocess/protect-reserved-head}
(fact
  "re-exports reserved-head protection"
  ((fn []
     (assign/unwrap-protected-head
       (first
         (preprocess/protect-reserved-head '(if condition body))))))
  =>
  'if)
^{:refer lang.base.emit-preprocess/to-staging-form}
(fact
  "re-exports a single hard-link staging transformation"
  ((fn []
     (preprocess/to-staging-form
       '(link input)
       {:reserved {'link {:emit :hard-link, :raw 'raw}}}
       {}
       {}
       nil
       identity)))
  =>
  '(raw input))
^{:refer lang.base.emit-preprocess/to-staging}
(fact
  "re-exports staged dependency collection"
  ((fn []
     (preprocess/to-staging
       '(outer alias/item)
       {}
       {'library {:code {'item {:id 'item, :op :defn}}}}
       {:module {:id 'current, :link {'alias 'library}}})))
  =>
  ['(outer library/item) #{'library/item} #{} {}])
^{:refer lang.base.emit-preprocess/to-resolve}
(fact
  "re-exports resolution without macro expansion"
  ((fn []
     (let [output (preprocess/to-resolve
                    '(if alias/item)
                    {:reserved {'if {:emit :if}}}
                    {'library {:code {'item {:id 'item, :op :defn}}}}
                    {:module {:id 'current, :link {'alias 'library}}})]
       [(assign/unwrap-protected-head (first output))
        (second output)])))
  =>
  ['if 'library/item])
