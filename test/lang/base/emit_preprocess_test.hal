(ns lang.base.emit-preprocess-test
  (:require [lang.base.emit-preprocess :as preprocess]
            [lang.base.preprocess-assign :as assign]))

^{:refer lang.base.emit-preprocess/macro-opts}
(Test/check [{:name "exposes the dynamically bound macro options"
              :test (fn [] (preprocess/with:macro-opts {:mode :test} {:id :fixture}
                             (preprocess/macro-opts)))
              :expected {:mode :test}}])

^{:refer lang.base.emit-preprocess/macro-grammar}
(Test/check [{:name "exposes the dynamically bound macro grammar"
              :test (fn [] (preprocess/with:macro-opts {:mode :test} {:id :fixture}
                             (preprocess/macro-grammar)))
              :expected {:id :fixture}}])

^{:refer lang.base.emit-preprocess/with:macro-opts}
(Test/check [{:name "binds macro options and grammar only for its body"
              :test (fn [] [(preprocess/macro-opts)
                            (preprocess/with:macro-opts {:mode :bound} {:id :bound}
                              [(preprocess/macro-opts) (preprocess/macro-grammar)])
                            (preprocess/macro-opts)])
              :expected [nil [{:mode :bound} {:id :bound}] nil]}])

^{:refer lang.base.emit-preprocess/to-input-form}
(Test/check [{:name "re-exports deref input lowering"
              :test (fn [] (preprocess/to-input-form '(deref value)))
              :expected '(!:eval value)}])

^{:refer lang.base.emit-preprocess/to-input}
(Test/check [{:name "re-exports recursive input lowering"
              :test (fn [] (preprocess/to-input '(outer (deref value))))
              :expected '(outer (!:eval value))}])

^{:refer lang.base.emit-preprocess/eval-template-forms}
(Test/check [{:name "re-exports eager persisted template evaluation"
              :test (fn [] (preprocess/eval-template-forms '(!:template (+ 1 2))))
              :expected 3}])

^{:refer lang.base.emit-preprocess/value-template-args}
(Test/check [{:name "re-exports value template argument extraction"
              :test (fn [] (preprocess/value-template-args '([left right]) (fn [] nil)))
              :expected ['left 'right]}])

^{:refer lang.base.emit-preprocess/value-standalone}
(Test/check [{:name "re-exports standalone value lookup"
              :test (fn [] (preprocess/value-standalone 'block
                                                    {:reserved {'block {:emit :macro
                                                                        :value/standalone 'library/value
                                                                        :op-spec {:allow-blocks true}}}}))
              :expected 'library/value}])

^{:refer lang.base.emit-preprocess/process-namespaced-resolve}
(Test/check [{:name "re-exports linked symbol resolution"
              :test (fn [] (preprocess/process-namespaced-resolve
                            'alias/item {'library {}}
                            {:module {:id 'current :link {'alias 'library}}}))
              :expected ['library 'item 'library/item]}])

^{:refer lang.base.emit-preprocess/process-namespaced-symbol}
(Test/check [{:name "re-exports namespaced dependency processing"
              :test (fn [] (let [deps (atom #{})]
                            [(preprocess/process-namespaced-symbol
                              'alias/item
                              {'library {:code {'item {:op :defn :id 'item}}}}
                              {:module {:id 'current :link {'alias 'library}}
                               :entry {:id 'caller}}
                              deps (atom #{}) identity)
                             (deref deps)]))
              :expected ['library/item #{'library/item}]}])

^{:refer lang.base.emit-preprocess/get-fragment}
(Test/check [{:name "re-exports linked fragment lookup"
              :test (fn [] (preprocess/get-fragment
                            'alias/item {'library {:fragment {'item :fragment}}}
                            {:module {:id 'current :link {'alias 'library}}}))
              :expected :fragment}])

^{:refer lang.base.emit-preprocess/process-standard-symbol}
(Test/check [{:name "re-exports native root dependency tracking"
              :test (fn [] (let [natives (atom {})]
                            [(preprocess/process-standard-symbol
                              'console.log {:module {:native-lu {'console :node}}} natives)
                             (deref natives)]))
              :expected ['console.log {:node #{'console}}]}])

^{:refer lang.base.emit-preprocess/find-natives}
(Test/check [{:name "re-exports quoted native import discovery"
              :test (fn [] (preprocess/find-natives
                            {:form '(quote (console.log untouched))}
                            {:module {:native-lu {'console :node}}}))
              :expected {:node #{'console}}}])

^{:refer lang.base.emit-preprocess/process-inline-assignment}
(Test/check [{:name "re-exports inline assignment resolution"
              :test (fn [] (let [output (preprocess/process-inline-assignment
                                        '(def local (alias/item input) :inline)
                                        {'library {:code {'item {:id 'item}}}}
                                        {:module {:id 'current :link {'alias 'library}}})]
                            [(assign/unwrap-protected-head (first (nth output 2)))
                             (second (nth output 2))]))
              :expected ['library/item 'input]}])

^{:refer lang.base.emit-preprocess/protect-reserved-head}
(Test/check [{:name "re-exports reserved-head protection"
              :test (fn [] (assign/unwrap-protected-head
                            (first (preprocess/protect-reserved-head '(if condition body)))))
              :expected 'if}])

^{:refer lang.base.emit-preprocess/to-staging-form}
(Test/check [{:name "re-exports a single hard-link staging transformation"
              :test (fn [] (preprocess/to-staging-form
                            '(link input)
                            {:reserved {'link {:emit :hard-link :raw 'raw}}}
                            {} {} nil identity))
              :expected '(raw input)}])

^{:refer lang.base.emit-preprocess/to-staging}
(Test/check [{:name "re-exports staged dependency collection"
              :test (fn [] (preprocess/to-staging
                            '(outer alias/item)
                            {}
                            {'library {:code {'item {:id 'item :op :defn}}}}
                            {:module {:id 'current :link {'alias 'library}}}))
              :expected ['(outer library/item) #{'library/item} #{} {}]}])

^{:refer lang.base.emit-preprocess/to-resolve}
(Test/check [{:name "re-exports resolution without macro expansion"
              :test (fn [] (let [output (preprocess/to-resolve
                                        '(if alias/item)
                                        {:reserved {'if {:emit :if}}}
                                        {'library {:code {'item {:id 'item :op :defn}}}}
                                        {:module {:id 'current :link {'alias 'library}}})]
                            [(assign/unwrap-protected-head (first output)) (second output)]))
              :expected ['if 'library/item]}])
