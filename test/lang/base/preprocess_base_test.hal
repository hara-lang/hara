(ns lang.base.preprocess-base-test
  (:require [lang.base.preprocess-base :as base]))

^{:refer lang.base.preprocess-base/macro-form}
(Test/check
 [{:name "projects the dynamic macro form only inside its archive binding"
   :test (fn []
           [(base/macro-form)
            (binding [base/*macro-form* '(fixture value)]
              (base/macro-form))])
   :expected [nil '(fixture value)]}])

^{:refer lang.base.preprocess-base/macro-opts}
(Test/check
 [{:name "projects macro options from the dynamic preprocessing context"
   :test (fn []
           (binding [base/*macro-opts* {:profile :fixture}]
             (base/macro-opts)))
   :expected {:profile :fixture}}])

^{:refer lang.base.preprocess-base/macro-grammar}
(Test/check
 [{:name "projects grammar data from the dynamic preprocessing context"
   :test (fn []
           (binding [base/*macro-grammar* {:default {:index {:offset 1}}}]
             (base/macro-grammar)))
   :expected {:default {:index {:offset 1}}}}])

^{:refer lang.base.preprocess-base/with:macro-opts}
(Test/check
 [{:name "binds macro options for the lexical archive transform body"
   :test (fn []
           (base/with:macro-opts [{:target :fixture}]
             (base/macro-opts)))
   :expected {:target :fixture}}])
