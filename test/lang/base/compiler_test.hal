^{:refer lang.base.compiler/compile-staged}
(Test/check
 [{:name "runs the post-normalization compiler phases exactly once"
   :test (fn []
           (let [result (compiler/compile-staged
                         (compiler/compiler)
                         selected
                         {}
                         {:raw '(+ 1 2) :normalized '(+ 1 2)}
                         [(compiler/worklog-event 0 :normalize '(+ 1 2) {})]
                         '(+ 1 2))]
             [(:output result)
              (map (fn [event] (:phase event))
                   (get-in result [:provenance :events]))]))
   :expected ["3 + 3"
              [:normalize :stage :rewrite/canonical :infer :lint
               :rewrite/target :rewrite/staging :emit]]}])

^{:refer lang.base.compiler/identity-entry-publisher}
(Test/check
 [{:name "constructs an explicit no-op publisher"
   :test (fn [] (instance? lang.base.compiler/IdentityEntryPublisher
                           (compiler/identity-entry-publisher)))
   :expected true}])

^{:refer lang.base.compiler/grammar-entry-publisher}
(Test/check
 [{:name "constructs a publisher pinned to its selected grammar"
   :test (fn [] (let [value (compiler/grammar-entry-publisher selected-entry)]
                  [(instance? lang.base.compiler/GrammarEntryPublisher value)
                   (= selected-entry (:selected value))]))
   :expected [true true]}])
