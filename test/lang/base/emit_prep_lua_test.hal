(ns lang.base.emit-prep-lua-test
  (:require [lang.base.book :as b]
            [lang.base.emit-helper :as helper]
            [lang.base.grammar :as grammar]
            [lang.model.v1.spec-lua :as lua]))

(def +book-empty+
  (b/book {:lang :lua
           :meta lua/+meta+
           :grammar (grammar/grammar :lua
                      (grammar/to-reserved (grammar/build))
                      helper/+default+)}))

(def +core-module+
  (b/book-module
   {:id       'L.core
    :lang     :lua
    :link     '{- L.core}}))

(def +core-fragment-add+
 (b/book-entry
   {:lang :lua,
    :id 'add,
    :module 'L.core,
    :section :fragment,
    :form '(fn [x y] (list '+ x y)),
    :template (fn [x y] (list '+ x y)),
    :standalone true,
    :namespace (ns-current)}))

(def +core-fragment-sub+
 (b/book-entry
   {:lang :lua,
    :id 'sub,
    :module 'L.core,
    :section :fragment,
    :template (fn [x y] (list '- x y)),
    :standalone '(fn [x y] (return (- x y))),
    :namespace (ns-current)}))

(def +core-code-identity-fn+
 (b/book-entry
   {:form-input '(defn identity-fn [x] (return x)),
    :section :code,
    :module 'L.core,
    :lang :lua,
    :id 'identity-fn,
    :declared false,
    :form '(defn identity-fn [x] (return x)),
    :namespace (ns-current),
    :deps #{}}))

(def +book-min+
  (-> +book-empty+
      (b/set-module +core-module+)
      second
      (b/set-entry +core-fragment-add+)
      second
      (b/set-entry +core-fragment-sub+)
      second
      (b/set-entry +core-code-identity-fn+)
      second))



;;
;;
;;
;;


^{:refer lang.base.emit-prep-lua-test/+book-min+}
(Test/check
 [{:name "Lua fixture construction leaves the empty Book and module unchanged"
   :test (fn [] [(:lang +book-empty+) (:modules +book-empty+)
                 (:id +core-module+) (:link +core-module+) (:code +core-module+)])
   :expected [:lua {} 'L.core '{- L.core} {}]}
  {:name "Lua fixture fragments preserve addition and subtraction behavior"
   :test (fn [] [((:template +core-fragment-add+) 'left 'right)
                 ((:template +core-fragment-sub+) 'left 'right)
                 (:standalone +core-fragment-sub+)])
   :expected ['(+ left right) '(- left right) '(fn [x y] (return (- x y)))]}
  {:name "Lua fixture Book contains both fragments and the original identity entry"
   :test (fn []
           (let [module (b/get-module +book-min+ 'L.core)
                 identity-entry (b/get-entry +book-min+ 'L.core/identity-fn)]
             [(set (keys (:fragment module))) (set (keys (:code module)))
              (:form identity-entry) (:form-input identity-entry) (:deps identity-entry)
              ((:template (b/get-fragment-entry +book-min+ 'L.core/sub)) 9 4)]))
   :expected [#{'add 'sub} #{'identity-fn} '(defn identity-fn [x] (return x))
              '(defn identity-fn [x] (return x)) #{} '(- 9 4)]}])
