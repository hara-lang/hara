(ns lang.base.grammar-xtalk-test
  (:require [std.foundation.string :as str]
            [lang.base.grammar-xtalk :as xtalk :refer :all])
  (:use code.test))

(fact "all xtalk grammar map entries expose op-spec contracts"
  (vec
   (for [[sym v] (sort-by key (ns-publics 'lang.base.grammar-xtalk))
         :when (str/starts-with? (name sym) "+xt-")
         entry @v
         :when (and (map? entry)
                    (not (:op-spec entry)))]
     (:op entry)))
  => [])

^{:refer lang.base.grammar-xtalk/tf-str-lt, :added "4.1"}
(fact
  "checks literal string ordering ascending"
  (tf-str-lt '(x:str-lt "a" "b"))
  =>
  '(x:str-comp "a" "b"))

^{:refer lang.base.grammar-xtalk/tf-str-gt, :added "4.1"}
(fact
  "checks literal string ordering descending"
  (tf-str-gt '(x:str-gt "a" "b"))
  =>
  '(x:str-comp "b" "a"))

^{:refer lang.base.grammar-xtalk/tf-throw :added "4.0"}
(fact "wrapper for throw transform"
  (tf-throw '(x:throw "error"))
  => '(throw "error"))

^{:refer lang.base.grammar-xtalk/tf-add :added "4.1"}
(fact "wrapper for add transform"
  (tf-add '(x:add a b))
  => '(+ a b))

^{:refer lang.base.grammar-xtalk/tf-sub :added "4.1"}
(fact "wrapper for sub transform"
  (tf-sub '(x:sub a b))
  => '(- a b))

^{:refer lang.base.grammar-xtalk/tf-mul :added "4.1"}
(fact "wrapper for mul transform"
  (tf-mul '(x:mul a b))
  => '(* a b))

^{:refer lang.base.grammar-xtalk/tf-div :added "4.1"}
(fact "wrapper for div transform"
  (tf-div '(x:div a b))
  => '(/ a b))

^{:refer lang.base.grammar-xtalk/tf-neg :added "4.1"}
(fact "wrapper for neg transform"
  (tf-neg '(x:neg a))
  => '(- a))

^{:refer lang.base.grammar-xtalk/tf-inc :added "4.1"}
(fact "wrapper for inc transform"
  (tf-inc '(x:inc a))
  => '(+ a 1))

^{:refer lang.base.grammar-xtalk/tf-dec :added "4.1"}
(fact "wrapper for dec transform"
  (tf-dec '(x:dec a))
  => '(- a 1))

^{:refer lang.base.grammar-xtalk/tf-eq :added "4.1"}
(fact "wrapper for eq transform"
  (tf-eq '(x:eq a b))
  => '(== a b))

^{:refer lang.base.grammar-xtalk/tf-neq :added "4.1"}
(fact "wrapper for neq transform"
  (tf-neq '(x:neq a b))
  => '(not= a b))

^{:refer lang.base.grammar-xtalk/tf-lt :added "4.1"}
(fact "wrapper for lt transform"
  (tf-lt '(x:lt a b))
  => '(< a b))

^{:refer lang.base.grammar-xtalk/tf-lte :added "4.1"}
(fact "wrapper for lte transform"
  (tf-lte '(x:lte a b))
  => '(<= a b))

^{:refer lang.base.grammar-xtalk/tf-gt :added "4.1"}
(fact "wrapper for gt transform"
  (tf-gt '(x:gt a b))
  => '(> a b))

^{:refer lang.base.grammar-xtalk/tf-gte :added "4.1"}
(fact "wrapper for gte transform"
  (tf-gte '(x:gte a b))
  => '(>= a b))

^{:refer lang.base.grammar-xtalk/tf-zero? :added "4.1"}
(fact "wrapper for zero? transform"
  (tf-zero? '(x:zero? a))
  => '(== a 0))

^{:refer lang.base.grammar-xtalk/tf-pos? :added "4.1"}
(fact "wrapper for pos? transform"
  (tf-pos? '(x:pos? a))
  => '(> a 0))

^{:refer lang.base.grammar-xtalk/tf-neg? :added "4.1"}
(fact "wrapper for neg? transform"
  (tf-neg? '(x:neg? a))
  => '(< a 0))

^{:refer lang.base.grammar-xtalk/tf-even? :added "4.1"}
(fact "wrapper for even? transform"
  (tf-even? '(x:even? a))
  => '(== 0 (mod a 2)))

^{:refer lang.base.grammar-xtalk/tf-odd? :added "4.1"}
(fact "wrapper for odd? transform"
  (tf-odd? '(x:odd? a))
  => '(not (== 0 (mod a 2))))

^{:refer lang.base.grammar-xtalk/tf-eq-nil? :added "4.0"}
(fact "equals nil transform"
  (tf-eq-nil? '(x:nil? a))
  => '(== nil a))

^{:refer lang.base.grammar-xtalk/tf-not-nil? :added "4.0"}
(fact "not nil transform"
  (tf-not-nil? '(x:not-nil? a))
  => '(not= nil a))

^{:refer lang.base.grammar-xtalk/tf-has-key? :added "4.0"}
(fact "has key default transform"
  (tf-has-key? '(x:has-key? obj "a"))
  => '(not= (x:get-key obj "a") nil))

^{:refer lang.base.grammar-xtalk/tf-get-path :added "4.0"}
(fact "lowers direct path access to chained indexing"

  (tf-get-path '(x:get-path obj ["a" "b" "c"]))
  => '(. obj ["a"] ["b"] ["c"]))

^{:refer lang.base.grammar-xtalk/tf-get-key :added "4.0"}
(fact "get-key transform"

  (tf-get-key '(x:get-key obj "a"))
  => '(. obj ["a"])

  (tf-get-key '(x:get-key obj "a" "DEFAULT"))
  => '(:? (x:nil? (. obj ["a"])) "DEFAULT" (. obj ["a"])))

^{:refer lang.base.grammar-xtalk/tf-set-key :added "4.0"}
(fact "set-key transform"

  (tf-set-key '(x:set-key obj "a" 1))
  => '(:= (. obj ["a"]) 1))

^{:refer lang.base.grammar-xtalk/tf-del-key :added "4.0"}
(fact "del-key transform"

  (tf-del-key '(x:del-key obj "a"))
  => '(x:del (. obj ["a"])))

^{:refer lang.base.grammar-xtalk/tf-copy-key :added "4.0"}
(fact "copy-key transform"

  (tf-copy-key '(x:copy-key obj src "a"))
  => '(:= (. obj ["a"]) (. src ["a"]))

  (tf-copy-key '(x:copy-key obj src ["a" "b"]))
  => '(:= (. obj ["a"]) (. src ["b"])))

^{:refer lang.base.grammar-xtalk/tf-grammar-offset, :added "4.0"}
(fact "gets the grammar index offset" (tf-grammar-offset) => 0)

^{:refer lang.base.grammar-xtalk/tf-grammar-end-inclusive :added "4.0"}
(fact "gets the end inclusive flag"

  (tf-grammar-end-inclusive)
  => nil)

^{:refer lang.base.grammar-xtalk/tf-offset-base :added "4.0"}
(fact "calculates the offset"

  (tf-offset-base 1 'hello)
  => '(+ hello 1)

  (tf-offset-base 0 'hello)
  => 'hello

  (tf-offset-base 1 1)
  => 2)

^{:refer lang.base.grammar-xtalk/tf-offset :added "4.0"}
(fact "gets the offset"
  (tf-offset '(x:offset 10))
  => 10)

^{:refer lang.base.grammar-xtalk/tf-offset-rev :added "4.0"}
(fact "gets the reverse offset"
  (tf-offset-rev '(x:offset-rev 10))
  => 9)

^{:refer lang.base.grammar-xtalk/tf-offset-len :added "4.0"}
(fact "gets the length offset"
  (tf-offset-len '(x:offset-len 10))
  => 9)

^{:refer lang.base.grammar-xtalk/tf-offset-rlen :added "4.0"}
(fact "gets the reverse length offset"
  (tf-offset-rlen '(x:offset-rlen 10))
  => 10)

^{:refer lang.base.grammar-xtalk/tf-first :added "4.1"}
(fact "wrapper for first transform"
  (tf-first '(x:first arr))
  => '(x:get-idx arr (x:offset 0)))

^{:refer lang.base.grammar-xtalk/tf-second :added "4.1"}
(fact "gets the second element"
  (tf-second '(x:second arr))
  => '(x:get-idx arr (x:offset 1)))

^{:refer lang.base.grammar-xtalk/tf-last :added "4.1"}
(fact "gets the last element"
  (tf-last '(x:last arr))
  => '(x:get-idx arr (x:offset-len (x:len arr))))

^{:refer lang.base.grammar-xtalk/tf-second-last :added "4.1"}
(fact "gets the second last element"
  (tf-second-last '(x:second-last arr))
  => '(x:get-idx arr (x:offset-len (- (x:len arr) 1))))

^{:refer lang.base.grammar-xtalk/tf-str-lt :added "4.1"}
(fact "checks string ordering ascending"
  (tf-str-lt '(x:str-lt a b))
  => '(x:str-comp a b))

^{:refer lang.base.grammar-xtalk/tf-str-gt :added "4.1"}
(fact "checks string ordering descending"
  (tf-str-gt '(x:str-gt a b))
  => '(x:str-comp b a))

^{:refer lang.base.grammar-xtalk/tf-global-set :added "4.0"}
(fact "default global set transform"

  (tf-global-set '(x:global-set SYM 1))
  => '(x:set-key !:G "SYM" 1))

^{:refer lang.base.grammar-xtalk/tf-global-has? :added "4.0"}
(fact  "default global has transform"

  (tf-global-has? '(x:global-has SYM))
  => '(not (x:nil? (x:get-key !:G "SYM"))))

^{:refer lang.base.grammar-xtalk/tf-global-del :added "4.0"}
(fact "default global del transform"

  (tf-global-del '(x:global-del SYM))
  => '(x:set-key !:G "SYM" nil))

^{:refer lang.base.grammar-xtalk/tf-lu-eq :added "4.0"}
(fact "lookup equals transform"

  (tf-lu-eq '(x:lu-eq o1 o2))
  => '(== o1 o2))

^{:refer lang.base.grammar-xtalk/tf-bit-and :added "4.0"}
(fact "bit and transform"

  (tf-bit-and '(x:bit-and x y))
  => '(b:& x y))

^{:refer lang.base.grammar-xtalk/tf-bit-or :added "4.0"}
(fact "bit or transform"

  (tf-bit-or '(x:bit-or x y))
  => '(b:| x y))

^{:refer lang.base.grammar-xtalk/tf-bit-lshift :added "4.0"}
(fact "bit left shift transform"

  (tf-bit-lshift '(x:bit-lshift x y))
  => '(b:<< x y))

^{:refer lang.base.grammar-xtalk/tf-bit-rshift :added "4.0"}
(fact "bit right shift transform"

  (tf-bit-rshift '(x:bit-rshift x y))
  => '(b:>> x y))

^{:refer lang.base.grammar-xtalk/tf-bit-xor :added "4.0"}
(fact "bit xor transform"

  (tf-bit-xor '(x:bit-xor x y))
  => '(b:xor x y))


^{:refer lang.base.grammar-xtalk/+xt-common-basic+}
(fact "basic operations preserve exception aliases and variadic concatenation"
  (mapv :op +xt-common-basic+)
  => [:x-del :x-cat :x-len :x-err :x-ex-native? :x-ex-new :x-ex-message :x-ex-data :x-type-native]
  (select-keys (nth +xt-common-basic+ 5) [:symbol :emit :op-spec])
  => {:symbol '#{x:ex x:ex-new} :emit :abstract
      :op-spec {:macro-only true :type [:fn [:xt/str :xt/any] :xt/any] :arglists '([message] [message data])}}
  (get-in +xt-common-basic+ [1 :op-spec :variadic]) => true)

^{:refer lang.base.grammar-xtalk/+xt-common-index+}
(fact "index operations retain all offset macros and optional arguments"
  (mapv :op +xt-common-index+) => [:x-offset :x-offset-rev :x-offset-len :x-offset-rlen]
  (mapv (fn [entry] (var-sym (:macro entry))) +xt-common-index+)
  => '[lang.base.grammar-xtalk/tf-offset lang.base.grammar-xtalk/tf-offset-rev
       lang.base.grammar-xtalk/tf-offset-len lang.base.grammar-xtalk/tf-offset-rlen]
  (mapv (fn [entry] (get-in entry [:op-spec :arglists])) +xt-common-index+)
  => '[([] [n]) ([] [n]) ([] [n]) ([] [n])])

^{:refer lang.base.grammar-xtalk/+xt-common-number+}
(fact "numeric grammar retains arithmetic comparison and predicate contracts"
  (mapv :op +xt-common-number+)
  => [:x-add :x-sub :x-mul :x-div :x-neg :x-inc :x-dec :x-zero? :x-pos? :x-neg?
      :x-even? :x-odd? :x-eq :x-neq :x-lt :x-lte :x-gt :x-gte]
  (mapv (fn [entry] (get-in entry [:op-spec :variadic])) (take 5 +xt-common-number+))
  => [true true true true nil]
  (get-in +xt-common-number+ [12 :op-spec])
  => {:arglists '([x y]) :type [:fn [:xt/any :xt/any] :xt/bool]})

^{:refer lang.base.grammar-xtalk/+xt-common-nil+}
(fact "nil predicates bind distinct positive and negative macros"
  (mapv :op +xt-common-nil+) => [:x-not-nil? :x-nil?]
  (mapv (fn [entry] (var-sym (:macro entry))) +xt-common-nil+)
  => '[lang.base.grammar-xtalk/tf-not-nil? lang.base.grammar-xtalk/tf-eq-nil?])

^{:refer lang.base.grammar-xtalk/+xt-common-primitives+}
(fact "primitive conversions and predicates retain their result types"
  (mapv :op +xt-common-primitives+)
  => [:x-to-string :x-to-number :x-is-string? :x-is-number? :x-is-integer?
      :x-is-boolean? :x-is-object? :x-is-array?]
  (mapv (fn [entry] (last (get-in entry [:op-spec :type]))) +xt-common-primitives+)
  => [:xt/str :xt/num :xt/bool :xt/bool :xt/bool :xt/bool :xt/bool :xt/bool])

^{:refer lang.base.grammar-xtalk/+xt-common-lu+}
(fact "lookup grammar keeps constructor equality and keyed operations"
  (mapv :op +xt-common-lu+) => [:x-lu-create :x-lu-eq :x-lu-get :x-lu-set :x-lu-del]
  (get-in +xt-common-lu+ [0 :op-spec]) => {:arglists '([]) :type [:fn [] :xt/any]}
  (var-sym (:macro (nth +xt-common-lu+ 1))) => 'lang.base.grammar-xtalk/tf-lu-eq
  (get-in +xt-common-lu+ [3 :op-spec :arglists]) => '([lookup key value]))

^{:refer lang.base.grammar-xtalk/+xt-common-object+}
(fact "object grammar preserves defaulted lookup and hard linked enumeration"
  (mapv :op +xt-common-object+)
  => [:x-has-key? :x-del-key :x-get-key :x-get-path :x-set-key :x-copy-key
      :x-obj-keys :x-obj-vals :x-obj-pairs :x-obj-clone :x-obj-assign]
  (get-in +xt-common-object+ [3 :op-spec])
  => {:type [:fn [:xt/obj [:xt/array :xt/str] :xt/any] :xt/any]
      :arglists '([obj path] [obj path default])}
  (mapv :raw (drop 6 +xt-common-object+))
  => '[xt.lang.common-data/obj-keys xt.lang.common-data/obj-vals
       xt.lang.common-data/obj-pairs xt.lang.common-data/obj-clone xt.lang.common-data/obj-assign])

^{:refer lang.base.grammar-xtalk/+xt-common-array+}
(fact "array grammar preserves indexed access mutation and slicing arities"
  (mapv :op +xt-common-array+)
  => [:x-get-idx :x-set-idx :x-arr-clone :x-arr-first :x-arr-second :x-arr-last
      :x-arr-second-last :x-arr-remove :x-arr-push :x-arr-pop :x-arr-push-first
      :x-arr-pop-first :x-arr-insert :x-arr-slice :x-arr-reverse :x-arr-assign :x-arr-concat]
  (get-in +xt-common-array+ [0 :op-spec :arglists]) => '([arr idx] [arr idx default])
  (get-in +xt-common-array+ [13 :op-spec :arglists]) => '([arr start] [arr start end])
  (:raw (nth +xt-common-array+ 13)) => 'xt.lang.common-data/arr-slice)

^{:refer lang.base.grammar-xtalk/+xt-common-print+}
(fact "print remains a single abstract value operation"
  +xt-common-print+
  => [{:op :x-print :symbol '#{x:print} :emit :abstract
       :op-spec {:arglists '([value]) :type [:fn [:xt/any] :xt/any]}}])

^{:refer lang.base.grammar-xtalk/+xt-common-string+}
(fact "string grammar preserves aliases ordering macros and substring overloads"
  (mapv :op +xt-common-string+)
  => [:x-str-len :x-str-comp :x-str-lt :x-str-gt :x-str-pad-left :x-str-pad-right
      :x-str-starts-with :x-str-ends-with :x-str-char :x-str-split :x-str-join
      :x-str-index-of :x-str-substring :x-str-to-upper :x-str-to-lower :x-str-to-fixed
      :x-str-replace :x-str-trim :x-str-trim-left :x-str-trim-right]
  (select-keys (first +xt-common-string+) [:emit :raw]) => {:emit :alias :raw 'x:len}
  (get-in +xt-common-string+ [12 :op-spec])
  => {:type [:fn [:xt/str :xt/num [:xt/maybe :xt/num]] :xt/str]
      :arglists '([value start] [value start len])})

^{:refer lang.base.grammar-xtalk/+xt-common-bytes+}
(fact "byte grammar retains length and indexing aliases and signed conversion types"
  (mapv :op +xt-common-bytes+)
  => [:x-bytes-new :x-bytes-count :x-bytes-get :x-bytes-set :x-bytes-copy
      :x-bytes-slice :x-bytes-u8 :x-bytes-s8 :x-str-encode :x-str-decode]
  (mapv :raw (take 2 (drop 1 +xt-common-bytes+))) => '[x:len x:get-idx]
  (get-in +xt-common-bytes+ [5 :op-spec :arglists]) => '([value start] [value start end])
  (get-in +xt-common-bytes+ [7 :op-spec :type]) => [:fn [:xt/int] :xt/int])

^{:refer lang.base.grammar-xtalk/+xt-common-math+}
(fact "math grammar retains its ordered operators and variadic extrema"
  (mapv :op +xt-common-math+)
  => [:x-m-abs :x-m-acos :x-m-asin :x-m-atan :x-m-ceil :x-m-cos :x-m-cosh :x-m-exp
      :x-m-floor :x-m-loge :x-m-log10 :x-m-max :x-m-mod :x-m-min :x-m-pow
      :x-m-quot :x-m-sin :x-m-sinh :x-m-sqrt :x-m-tan :x-m-tanh]
  (mapv (fn [entry] (get-in entry [:op-spec :variadic])) (take 4 (drop 11 +xt-common-math+)))
  => [true nil true nil])

^{:refer lang.base.grammar-xtalk/+xt-functional-base+}
(fact "function classification remains an abstract boolean predicate"
  +xt-functional-base+
  => [{:op :x-is-function? :symbol '#{x:is-function?} :emit :abstract
       :op-spec {:arglists '([value]) :type [:fn [:xt/any] :xt/bool]}}])

^{:refer lang.base.grammar-xtalk/+xt-functional-invoke+}
(fact "invocation grammar distinguishes evaluation application and construction"
  (mapv :op +xt-functional-invoke+) => [:x-eval :x-apply :x-construct]
  (mapv (fn [entry] (get-in entry [:op-spec :arglists])) +xt-functional-invoke+)
  => '[([value]) ([f args]) ([ctor args])]
  (get-in +xt-functional-invoke+ [0 :op-spec :type]) => [:fn [:xt/str] :xt/any])

^{:refer lang.base.grammar-xtalk/+xt-functional-return+}
(fact "return encoding grammar preserves block allowances and original argument names"
  (mapv :op +xt-functional-return+) => [:x-return-encode :x-return-wrap :x-return-eval]
  (mapv (fn [entry] (get-in entry [:op-spec :allow-blocks])) +xt-functional-return+) => [true true true]
  (mapv (fn [entry] (get-in entry [:op-spec :arglists])) +xt-functional-return+)
  => '[([out id key]) ([callbock encode-fn]) ([expr wrap-fn])])

^{:refer lang.base.grammar-xtalk/+xt-functional-array+}
(fact "array functional operations retain hard links and fold argument order"
  (mapv :op +xt-functional-array+)
  => [:x-arr-sort :x-arr-each :x-arr-every :x-arr-some :x-arr-map :x-arr-filter
      :x-arr-foldl :x-arr-foldr :x-arr-find]
  (mapv :raw +xt-functional-array+)
  => '[xt.lang.common-data/arr-sort xt.lang.common-data/arr-each xt.lang.common-data/arr-every
       xt.lang.common-data/arr-some xt.lang.common-data/arr-map xt.lang.common-data/arr-filter
       xt.lang.common-data/arr-foldl xt.lang.common-data/arr-foldr xt.lang.common-data/arr-find]
  (get-in +xt-functional-array+ [7 :op-spec :arglists]) => '([arr f init]))

^{:refer lang.base.grammar-xtalk/+xt-functional-iter+}
(fact "iterator grammar preserves creation traversal and comparison contracts"
  (mapv :op +xt-functional-iter+)
  => [:x-iter-from-obj :x-iter-from-arr :x-iter-from :x-iter-eq :x-iter-null
      :x-iter-next :x-iter-has? :x-iter-native?]
  (get-in +xt-functional-iter+ [3 :op-spec])
  => {:arglists '([iter0 iter1 eq-fn]) :type [:fn [:xt/any :xt/any :xt/fn] :xt/bool]}
  (get-in +xt-functional-iter+ [4 :op-spec :arglists]) => '([]))

^{:refer lang.base.grammar-xtalk/+xt-lang-global+}
(fact "global grammar retains distinct mutation deletion and membership hooks"
  (mapv :op +xt-lang-global+) => [:x-global-set :x-global-del :x-global-has?]
  (mapv (fn [entry] (var-sym (:macro entry))) +xt-lang-global+)
  => '[lang.base.grammar-xtalk/tf-global-set lang.base.grammar-xtalk/tf-global-del lang.base.grammar-xtalk/tf-global-has?]
  (get-in +xt-lang-global+ [0 :op-spec :arglists]) => '([sym value]))

^{:refer lang.base.grammar-xtalk/+xt-lang-bit+}
(fact "bit grammar keeps five macro operations and abstract complement"
  (mapv :op +xt-lang-bit+) => [:x-bit-and :x-bit-or :x-bit-lshift :x-bit-rshift :x-bit-xor :x-bit-not]
  (mapv :emit +xt-lang-bit+) => [:macro :macro :macro :macro :macro :abstract]
  (get-in +xt-lang-bit+ [5 :op-spec]) => {:arglists '([x]) :type [:fn [:xt/int] :xt/int]})

^{:refer lang.base.grammar-xtalk/+xt-lang-throw+}
(fact "throw is explicitly macro only and keeps its transform"
  (select-keys (first +xt-lang-throw+) [:op :symbol :emit :op-spec])
  => {:op :x-throw :symbol '#{x:throw} :emit :macro
      :op-spec {:macro-only true :type [:fn [:xt/any] :xt/any] :arglists '([value])}}
  (var-sym (:macro (first +xt-lang-throw+))) => 'lang.base.grammar-xtalk/tf-throw)

^{:refer lang.base.grammar-xtalk/+xt-lang-unpack+}
(fact "unpack converts array values to tuple values only in macro contexts"
  +xt-lang-unpack+
  => [{:op :x-unpack :symbol '#{x:unpack} :emit :abstract
       :op-spec {:macro-only true :type [:fn [[:xt/array :xt/any]] [:xt/tuple :xt/any]]
                 :arglists '([value])}}])

^{:refer lang.base.grammar-xtalk/+xt-lang-random+}
(fact "random retains its zero argument numeric contract"
  +xt-lang-random+ => [{:op :x-random :symbol '#{x:random} :emit :abstract
                       :op-spec {:type [:fn [] :xt/num] :arglists '([])}}])

^{:refer lang.base.grammar-xtalk/+xt-lang-time+}
(fact "clock retains millisecond integer contract"
  +xt-lang-time+ => [{:op :x-now-ms :symbol '#{x:now-ms} :emit :abstract
                     :op-spec {:arglists '([]) :type [:fn [] :xt/int]}}])

^{:refer lang.base.grammar-xtalk/+xt-lang-json+}
(fact "json encode and decode preserve opposite string boundaries"
  (mapv :op +xt-lang-json+) => [:x-json-encode :x-json-decode]
  (mapv :op-spec +xt-lang-json+)
  => [{:type [:fn [:xt/any] :xt/str] :arglists '([value])}
      {:type [:fn [:xt/str] :xt/any] :arglists '([expr])}])

^{:refer lang.base.grammar-xtalk/+xt-socket+}
(fact "socket grammar retains connection callback and send encoding dependency"
  (mapv :op +xt-socket+) => [:x-socket-connect :x-socket-send :x-socket-close]
  (get-in +xt-socket+ [0 :op-spec :arglists]) => '([host port opts cb])
  (:requires (nth +xt-socket+ 1)) => #{:x-str-decode}
  (get-in +xt-socket+ [1 :op-spec :type]) => [:fn [:xt/any :xt/any] :xt/int])

^{:refer lang.base.grammar-xtalk/+xt-notify-http+}
(fact "http notification remains linked to the repl implementation"
  +xt-notify-http+
  => [{:op :x-notify-http :symbol '#{x:notify-http} :emit :hard-link
       :raw 'xt.lang.common-repl/notify-socket-http
       :op-spec {:type [:fn [:xt/str :xt/num :xt/any :xt/str :xt/str :xt/any] :xt/any]
                 :arglists '([host port value id key opts])}}])

^{:refer lang.base.grammar-xtalk/+xt-runtime-promise+}
(fact "promise grammar preserves lifecycle links and delay argument order"
  (mapv :op +xt-runtime-promise+)
  => [:x-async-run :x-promise :x-promise-new :x-promise-all :x-promise-then
      :x-promise-catch :x-promise-finally :x-promise-native? :x-with-delay]
  (mapv :raw (take 7 (drop 1 +xt-runtime-promise+)))
  => '[xt.lang.common-promise/promise xt.lang.common-promise/promise-new
       xt.lang.common-promise/promise-all xt.lang.common-promise/promise-then
       xt.lang.common-promise/promise-catch xt.lang.common-promise/promise-finally
       xt.lang.common-promise/promise-native?]
  (get-in +xt-runtime-promise+ [8 :op-spec :arglists]) => '([ms thunk]))

^{:refer lang.base.grammar-xtalk/+xt-runtime-shell+}
(fact "shell grammar preserves working directory and command callback contracts"
  (mapv :op +xt-runtime-shell+) => [:x-pwd :x-shell]
  (get-in +xt-runtime-shell+ [0 :op-spec]) => {:type [:fn [] :xt/str] :arglists '([])}
  (get-in +xt-runtime-shell+ [1 :op-spec :arglists]) => '([command root cb]))

^{:refer lang.base.grammar-xtalk/+xt-runtime-file+}
(fact "file grammar preserves path resolution and asynchronous read write dependencies"
  (mapv :op +xt-runtime-file+) => [:x-file-resolve :x-file-read :x-file-write]
  (mapv :requires +xt-runtime-file+) => [nil #{:x-promise} #{:x-promise}]
  (mapv (fn [entry] (get-in entry [:op-spec :arglists])) +xt-runtime-file+)
  => '[([root path]) ([path]) ([path bytes])])
