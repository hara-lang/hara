(ns lang.core.compile-links-test (:require [lang.core.compile-links :refer :all]) (:use code.test) (:config {:role :internal}))

^{:refer lang.core.compile-links/get-link-lookup :added "4.0"}
(fact "gets a lookup value"

  (get-link-lookup 'indigo
                   {'indigo "hello"})
  => "hello"

  (get-link-lookup 'indigo
                   {"code" "hello"})
  => nil

  (get-link-lookup 'indigo
                   {'code "hello"})
  => nil

  (get-link-lookup 'indigo
                   {#"code$" "hello"})
  => nil)

^{:refer lang.core.compile-links/get-link-match, :added "4.1"}
(fact
  "gets the matching lookup entry"
  (get-link-match 'indigo {'indigo "hello"})
  =>
  '[indigo "hello"]
  (let [[pattern value] (get-link-match
                          'indigo.server
                          {#"server$" "hello"})]
    [(re-pattern pattern) value])
  =>
  '["server$" "hello"]
  (get-link-match 'indigo {'code "hello"})
  =>
  nil)

^{:refer lang.core.compile-links/link-attributes :added "4.0"}
(fact "gets link attributes"

  (link-attributes 'code
                   'indigo.server
                   {:path-suffix ".js"})
  => {:is-lib? true, :rel "libs/indigo", :suffix ".js", :label "server", :path "libs/indigo/server.js"}


  (link-attributes 'util
                   'indigo.server
                   {:root-libs "tools"
                    :path-suffix ".js"})
  => {:is-lib? true, :rel "tools/indigo", :suffix ".js", :label "server", :path "tools/indigo/server.js"})
^{:refer lang.core.compile-links/link-filter-match?, :added "4.0", :id compile-links-preserved-0}
(fact
  "matches Foundation namespace filter shapes"
  [(lang.core.compile-links/link-filter-match? "indigo" 'indigo.server)
   (lang.core.compile-links/link-filter-match? 'indigo 'indigo.server)
   (lang.core.compile-links/link-filter-match?
     (regexp "server$")
     'indigo.server)
   (lang.core.compile-links/link-filter-match?
     #{'indigo.server}
     'indigo.server)
   (lang.core.compile-links/link-filter-match?
     (list "indigo" (regexp "server$"))
     'indigo.server)
   (lang.core.compile-links/link-filter-match?
     [(regexp "missing$") "indigo"]
     'indigo.server)
   (lang.core.compile-links/link-filter-match? "code" 'indigo.server)]
  =>
  [true true true true true true false])
^{:refer lang.core.compile-links/link-replace, :added "4.0", :id compile-links-preserved-1}
(fact
  "applies literal and regular-expression substitutions"
  [(lang.core.compile-links/link-replace "my-module" "-" "_")
   (lang.core.compile-links/link-replace
     "server-test"
     (regexp "-.*$")
     "")]
  =>
  ["my_module" "server"])
^{:refer lang.core.compile-links/get-link-lookup, :added "4.0", :id compile-links-preserved-2}
(fact
  "gets an exact or filtered lookup value"
  [(lang.core.compile-links/get-link-lookup 'indigo {'indigo "hello"})
   (lang.core.compile-links/get-link-lookup 'indigo {"code" "hello"})
   (lang.core.compile-links/get-link-lookup 'indigo {'code "hello"})
   (lang.core.compile-links/get-link-lookup
     'indigo
     {(regexp "code$") "hello"})
   (lang.core.compile-links/get-link-lookup
     'indigo.server
     {"indigo" "hello"})]
  =>
  ["hello" nil nil nil "hello"])
^{:refer lang.core.compile-links/get-link-match, :added "4.1", :id compile-links-preserved-3}
(fact
  "gets the matching lookup key and value"
  [(lang.core.compile-links/get-link-match 'indigo {'indigo "hello"})
   (let [[pattern value] (lang.core.compile-links/get-link-match
                           'indigo.server
                           {(regexp "server$") "hello"})]
     [(re-pattern pattern) value])
   (lang.core.compile-links/get-link-match 'indigo {'code "hello"})]
  =>
  ['[indigo "hello"] ["server$" "hello"] nil])
^{:refer lang.core.compile-links/link-attributes, :added "4.0", :id compile-links-preserved-4}
(fact
  "derives Foundation-compatible link attributes"
  [(lang.core.compile-links/link-attributes
     'code
     'indigo.server
     {:path-suffix ".js"})
   (lang.core.compile-links/link-attributes
     'util
     'indigo.server
     {:root-libs "tools", :path-suffix ".js"})]
  =>
  [{:is-lib? true,
    :rel "libs/indigo",
    :suffix ".js",
    :label "server",
    :path "libs/indigo/server.js"}
   {:is-lib? true,
    :rel "tools/indigo",
    :suffix ".js",
    :label "server",
    :path "tools/indigo/server.js"}])

^{:refer lang.core.compile-links/link-filter-match? :id compile-links-filter-boundaries}
(fact "accepts callable Vars and suppresses callback failure while preserving filter boundaries"
  [(lang.core.compile-links/link-filter-match? (var identity) 'demo)
   (lang.core.compile-links/link-filter-match? (fn [value] :truthy) 'demo)
   (lang.core.compile-links/link-filter-match? (fn [value] (throw (ex :argument {}))) 'demo)
   (lang.core.compile-links/link-filter-match? (var lang.core.compile-links/link-replace) 'demo)
   (lang.core.compile-links/link-filter-match? '() 'demo)
   (lang.core.compile-links/link-filter-match? [] 'demo)
   (try (lang.core.compile-links/link-filter-match? 42 'demo)
        :unexpected
        (catch error (select-keys (ex-data error) [:filter :identifier])))]
  => [true true false false true false {:filter 42 :identifier 'demo}])

^{:refer lang.core.compile-links/get-link-lookup :id compile-links-lookup-precedence}
(fact "preserves exact-key precedence, callable-Var lookup, false values and callback order"
  (let [calls (atom [])
        filter-fn (fn [value] (swap! calls conj value) :truthy)]
    (try
      (let [exact (lang.core.compile-links/get-link-lookup 'demo {'demo :exact filter-fn :fallback})
            exact-calls (deref calls)
            filtered (lang.core.compile-links/get-link-lookup 'other {filter-fn :fallback})
            matched (lang.core.compile-links/get-link-match 'demo {(var identity) :matched})]
        [[exact exact-calls filtered (deref calls)]
         (lang.core.compile-links/get-link-lookup 'demo {(var identity) :matched})
         [(= (first matched) (var identity)) (second matched)]
         (lang.core.compile-links/get-link-lookup 'demo {'demo false})
         (lang.core.compile-links/get-link-match 'demo {'demo false})])
      (finally (reset! calls []))))
  => [[:exact [] :fallback ['other]] :matched [true :matched] false ['demo false]])

^{:refer lang.core.compile-links/link-attributes :id compile-links-path-options}
(fact "preserves exact local and library paths, prefix trimming and suffix and label precedence"
  [(lang.core.compile-links/link-attributes 'app 'app.core {:path-suffix ".js"})
   (lang.core.compile-links/link-attributes nil 'vendor.my-module
     {:path-suffix ".lua" :path-replace {"-" "_"}})
   (lang.core.compile-links/link-attributes 'app 'vendor.pkg.module
     {:root-prefix {'vendor.pkg "/unused" :default "."} :path-suffix {:default ".py"}})
   (lang.core.compile-links/link-attributes 'app 'app.module
     {:ns-suffix {'app ".custom"} :path-suffix ".js" :ns-label {'app "renamed"}})]
  => [{:is-lib? false :rel "" :suffix ".js" :label "core" :path "/core.js"}
      {:is-lib? true :rel "libs/vendor" :suffix ".lua" :label "my_module" :path "libs/vendor/my_module.lua"}
      {:is-lib? true :rel "" :suffix ".py" :label "module" :path "/module.py"}
      {:is-lib? false :rel "" :suffix ".custom" :label "renamed" :path "/renamed.custom"}])

^{:refer lang.core.compile-links/*link-defaults* :id compile-links-defaults}
(fact "keeps exact defaults and restores scoped overrides after return or failure"
  (let [baseline lang.core.compile-links/*link-defaults*]
    [baseline
     (binding [lang.core.compile-links/*link-defaults* (assoc baseline :root-libs "alternate")]
       (:path (lang.core.compile-links/link-attributes nil 'vendor.mod {})))
     (= baseline lang.core.compile-links/*link-defaults*)
     (try
       (binding [lang.core.compile-links/*link-defaults* (assoc baseline :root-libs "failing")]
         (throw (ex :argument {:probe :failed})))
       :unexpected
       (catch error (:probe (ex-data error))))
     (= baseline lang.core.compile-links/*link-defaults*)])
  => [{:root-libs "libs" :root-prefix "." :path-suffix "" :path-separator "/"
       :path-replace {} :file-replace {}}
      "alternate/vendor/mod" true :failed true])
