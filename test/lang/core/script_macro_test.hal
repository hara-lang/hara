^{:refer lang.core.script-macro/intern-defmacro-rt-fn :added "4.0"}
(fact "defines both a library entry as well as a runtime macro"
 (let [library (lib/library:create {:snapshot snapshot-prep/+snap+})]
  (try
   (impl/with:library [library]
    (macro/intern-defmacro-rt-fn :lua
     (with-meta '(defmacro.lua make-array-0 [& args] (vec args)) '{:module L.core}) {}))
   (finally
    (intern (ns-current) (with-meta 'make-array-0 {:macro false}) nil)
    (intern (ns-current) (with-meta 'make-array-0:ptr {:macro false}) nil)
    (lib/reset-all! library) (reset! (:settings library) {}))))
 => (satisfies vector?))

