^{:refer lang.core.script-macro/intern-defmacro-fn :id historical-callable-clauses}
(fact "function to intern a macro"
(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
 (let [library (lib/library:create {:snapshot (snap/snapshot {:lua {:id :lua :book prep/+book-min+}})})]
  (try
   (registry/registry-install :lang/lua {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
   (impl/with:library [library]
(let [v (macro/intern-defmacro-fn :lua
           (with-meta '(defmacro.lua make-array-0 [& args] (vec args)) '{:module L.core}) {})]
v))
   (finally
    (intern (ns-current) (with-meta 'hello {:macro false}) nil)
    (intern (ns-current) (with-meta 'make-array-0 {:macro false}) nil)
    (space/reset-spaces!) (registry/reset-registry!)
    (lib/reset-all! library) (reset! (:settings library) {})))))
 => #'lang.core.script-macro-test/make-array-0

(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
 (let [library (lib/library:create {:snapshot (snap/snapshot {:lua {:id :lua :book prep/+book-min+}})})]
  (try
   (registry/registry-install :lang/lua {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
   (impl/with:library [library]
(let [v (macro/intern-defmacro-fn :lua
           (with-meta '(defmacro.lua make-array-0 [& args] (vec args)) '{:module L.core}) {})]
(ptr/ptr-deref (deref (var make-array-0)))))
   (finally
    (intern (ns-current) (with-meta 'hello {:macro false}) nil)
    (intern (ns-current) (with-meta 'make-array-0 {:macro false}) nil)
    (space/reset-spaces!) (registry/reset-registry!)
    (lib/reset-all! library) (reset! (:settings library) {})))))
 => (satisfies book/book-entry?)

(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
 (let [library (lib/library:create {:snapshot (snap/snapshot {:lua {:id :lua :book prep/+book-min+}})})]
  (try
   (registry/registry-install :lang/lua {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
   (impl/with:library [library]
(let [v (macro/intern-defmacro-fn :lua
           (with-meta '(defmacro.lua make-array-0 [& args] (vec args)) '{:module L.core}) {})]
(ptr/ptr-invoke-string (deref (var make-array-0)) [1 2 3] {})))
   (finally
    (intern (ns-current) (with-meta 'hello {:macro false}) nil)
    (intern (ns-current) (with-meta 'make-array-0 {:macro false}) nil)
    (space/reset-spaces!) (registry/reset-registry!)
    (lib/reset-all! library) (reset! (:settings library) {})))))
 => "[1,2,3]"

)

^{:refer lang.core.script-macro/intern-defmacro-fn :id historical-multi-arity}
(fact "function to intern a macro supports multi-arity clauses"
  (binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
   (let [xlib (lib/library {})
        slot (resolve 'get-idx)
        before [(deref slot) (meta slot)]]
    (try
      (rt/install-lang! :xtalk)
      (lib/add-book! xlib (assoc lang.model.v1.spec-xtalk/+book+ :modules {}))
      (lib/add-module! xlib (lang.base.book-module/book-module
                             {:lang :xtalk :id 'xt.lang.common-lib}))
      (impl/with:library [xlib]
        (let [macro-var (macro/intern-defmacro-fn
                         :xtalk
                         (with-meta
                           '(defmacro.xt get-idx
                              "gets array indices"
                              {:standalone true}
                              ([arr idx] (list 'x:get-idx arr idx))
                              ([arr idx default] (list 'x:get-idx arr idx default)))
                           '{:module xt.lang.common-lib})
                         {})
              entry (deref (deref macro-var))]
          [(-> macro-var meta :arglists)
           ((:template entry) 'arr 'idx)
           ((:template entry) 'arr 'idx 'fallback)]))
      (finally
        (intern (ns-current) (with-meta 'get-idx (second before)) (first before))
        (IComponent/stop xlib)
        (lib/reset-all! xlib)
        (reset! (:settings xlib) {})
        (space/reset-spaces!)
        (registry/reset-registry!)))))
  => '[([arr idx] [arr idx default])
       (x:get-idx arr idx)
       (x:get-idx arr idx fallback)])


