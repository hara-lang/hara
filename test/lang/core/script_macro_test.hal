(ns lang.core.script-macro-test
  (:require [lang.core.script-macro :as macro]
            [code.test :refer :all]
            [lang.core.pointer :as ptr]))

(def ^{:macro false} toy.hello nil)

(def ^{:macro false} quoted.probe nil)

(require [std.lib.context.space :as space] [std.lib.context.registry :as registry])

(def ^{:macro false} highlight.one nil)

(def ^{:macro false} highlight.two nil)

(def ^{:macro false} hello nil)

(def ^{:macro false} defptr.hello nil)

(def published nil)

(require [lang.core.impl :as impl] [lang.core.library :as lib]
 [lang.core.library-snapshot :as snap] [lang.base.emit-prep-lua-test :as prep])

(def ^{:macro false} def$.hello nil)

(def ^{:macro false} defmacro.hello nil)

(require [lang.core.runtime :as rt])

(def ^{:macro false} !.hello nil)

(defstruct ScriptEvalProbe [module calls]
 IContextEval
 (invoke-ptr [self pointer args]
  (swap! (:calls self) conj
   [(IPointer/ptr-context pointer) (:module pointer)
    ptr/*print* ptr/*output* ptr/*input* ptr/*clip*])
  [(select-keys pointer [:lang :form]) args]))

(require [lang.base.book :as book])

(def ^{:macro false} add-more nil)

(def ^{:macro false} abc nil)

(def ^{:macro false} def.hello nil)

(defstruct ScriptTopSetup [module library calls result]
 IContextLifeCycle
 (setup-ptr [self entry]
  (swap! (:calls self) conj
   [(:id entry)
    (:id (lib/get-entry (:library self)
           (select-keys entry [:lang :module :id :section])))])
  (:result self)))

(doseq [sym '[def$.lua defmacro.lua !.lua defptr.lua defrun.lua defn.lua
             defglobal.lua defgen.lua defn-.lua deftemp.lua defclass.lua defabstract.lua def.lua return break set= br]]
 (intern (ns-current) (with-meta sym {:macro false}) nil))

(ns lang.core.script-macro-test
 (:require [lang.core.script-macro :as macro]
           [lang.core.impl :as impl]
           [lang.core.library :as lib]
           [lang.core.library-snapshot-prep-test :as snapshot-prep])
 (:use code.test))

(def ^{:macro false} make-array-0 nil)

(def ^{:macro false} make-array-0:ptr nil)

(def get-idx nil)









^{:refer lang.core.script-macro/body-arglists :added "4.0"}
(fact "makes arglists from body"
  (macro/body-arglists '([a b c])) => '([a b c])
  (macro/body-arglists '(([a b c := 5]))) => '([a b c]))

^{:refer lang.core.script-macro/intern-in :added "4.0"}
(fact "interns a macro"
  (try
    (do (macro/intern-in 'toy '.hello 1)
        (eval '@(var toy.hello)))
    (finally (intern (ns-current) (with-meta 'toy.hello {:macro false}) nil)))
  => 1)

^{:refer lang.core.script-macro/intern-prep :added "4.0"}
(fact "outputs the module and form meta"
 (macro/intern-prep :lua (with-meta '(def$.lua hello hello) {:module 'L.core :line 1}))
 => '[L.core {:module L.core :line 1}])

^{:refer lang.core.script-macro/intern-def$-fn :id historical-fragment-clauses}
(fact "interns a fragment macro"
(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
 (let [library (lib/library:create {:snapshot (snap/snapshot {:lua {:id :lua :book prep/+book-min+}})})]
  (try
   (registry/registry-install :lang/lua {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
   (impl/with:library [library]
(let [v (macro/intern-def$-fn :lua
           (with-meta '(def$.lua hello hello) {:module 'L.core})
           {:time 1 :line 1})]
v))
   (finally
    (intern (ns-current) (with-meta 'hello {:macro false}) nil)
    (intern (ns-current) (with-meta 'make-array-0 {:macro false}) nil)
    (space/reset-spaces!) (registry/reset-registry!)
    (lib/reset-all! library) (reset! (:settings library) {})))))
 => #'lang.core.script-macro-test/hello

(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
 (let [library (lib/library:create {:snapshot (snap/snapshot {:lua {:id :lua :book prep/+book-min+}})})]
  (try
   (registry/registry-install :lang/lua {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
   (impl/with:library [library]
(let [v (macro/intern-def$-fn :lua
           (with-meta '(def$.lua hello hello) {:module 'L.core})
           {:time 1 :line 1})]
(reduce-kv (fn [out key value] (if value (assoc out key value) out)) {} (ptr/ptr-deref (deref (var hello))))))
   (finally
    (intern (ns-current) (with-meta 'hello {:macro false}) nil)
    (intern (ns-current) (with-meta 'make-array-0 {:macro false}) nil)
    (space/reset-spaces!) (registry/reset-registry!)
    (lib/reset-all! library) (reset! (:settings library) {})))))
 => (contains {:section :fragment :time 1 :op 'def$ :module 'L.core :lang :lua :line 1 :id 'hello :display :default :form 'hello :namespace 'lang.core.script-macro-test})

(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
 (let [library (lib/library:create {:snapshot (snap/snapshot {:lua {:id :lua :book prep/+book-min+}})})]
  (try
   (registry/registry-install :lang/lua {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
   (impl/with:library [library]
(let [v (macro/intern-def$-fn :lua
           (with-meta '(def$.lua hello hello) {:module 'L.core})
           {:time 1 :line 1})]
(ptr/ptr-display (deref (var hello)) {})))
   (finally
    (intern (ns-current) (with-meta 'hello {:macro false}) nil)
    (intern (ns-current) (with-meta 'make-array-0 {:macro false}) nil)
    (space/reset-spaces!) (registry/reset-registry!)
    (lib/reset-all! library) (reset! (:settings library) {})))))
 => "hello"

(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
 (let [library (lib/library:create {:snapshot (snap/snapshot {:lua {:id :lua :book prep/+book-min+}})})]
  (try
   (registry/registry-install :lang/lua {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
   (impl/with:library [library]
(let [v (macro/intern-def$-fn :lua
           (with-meta '(def$.lua hello hello) {:module 'L.core})
           {:time 1 :line 1})]
(ptr/ptr-invoke-string (let [original (deref (var hello))] (with-meta (pointer (assoc (assoc (into {} original) :context (IPointer/ptr-context original)) :library library)) (meta original))) [1 2 3] {})))
   (finally
    (intern (ns-current) (with-meta 'hello {:macro false}) nil)
    (intern (ns-current) (with-meta 'make-array-0 {:macro false}) nil)
    (space/reset-spaces!) (registry/reset-registry!)
    (lib/reset-all! library) (reset! (:settings library) {})))))
 => "hello(1,2,3)"

)

