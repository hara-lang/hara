^{:refer lang.core.script-macro/call-thunk :added "4.0"}
(fact "calls the thunk given meta to control pointer output" (macro/call-thunk {:debug true} (fn [] ptr/*print*)) => #{:input})

^{:refer lang.core.script-macro/intern-!-fn :id historical-free-pointer-clauses}
(fact "interns a free pointer macro"
  (binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
    (let [library (lib/library {:snapshot (snap/snapshot
                      {:lua {:id :lua :book prep/+book-min+}})})]
      (try
        (registry/registry-install :lang/lua
          {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
        (str/replace (macro/intern-!-fn :lua [1 2 3] {}) ";" "")
        (finally
          (space/reset-spaces!) (registry/reset-registry!)
          (IComponent/stop library) (lib/reset-all! library) (reset! (:settings library) {})))))
  => "1\n2\n3"

  (binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
    (let [library (lib/library {:snapshot (snap/snapshot
                      {:xtalk {:id :xtalk :book lang.model.v1.spec-xtalk/+book+}
                       :js {:id :js :book lang.model.v1.spec-js/+book+}})})]
      (try
        (registry/registry-install :lang/js
          {:scratch (rt/rt-default {:lang :js :module 'J.core :library library})})
        (macro/intern-!-fn :js [1 2 3] {})
        (finally
          (space/reset-spaces!) (registry/reset-registry!)
          (IComponent/stop library) (lib/reset-all! library) (reset! (:settings library) {})))))
  => "1;\n2;\n3;"

  (binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
    (let [calls (atom [])]
      (try
        (registry/registry-install :lang/lua {:scratch (ScriptEvalProbe 'L.core calls)})
        (macro/intern-!-fn :lua [1 2 3] {})
        (finally (reset! calls []) (space/reset-spaces!) (registry/reset-registry!)))))
  => [{:lang :lua :form '(do 1 2 3)} []]

  (binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
    (let [calls (atom [])]
      (try
        (registry/registry-install :lang/lua {:scratch (ScriptEvalProbe 'L.core calls)})
        (macro/intern-!-fn :lua ['(+ 1 2)] {})
        (finally (reset! calls []) (space/reset-spaces!) (registry/reset-registry!)))))
  => [{:lang :lua :form '(+ 1 2)} []])


^{:refer lang.core.script-macro/intern-! :id historical-free-macro-clauses}
(fact "interns a macro for free evalutation"
  (let [v (resolve '!.hello) before [(deref v) (meta v)]]
    (try
      (macro/intern-! :lua "hello")
      (finally (intern (ns-current) (with-meta '!.hello (second before)) (first before)))))
  => #'lang.core.script-macro-test/!.hello

  (binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
    (let [library (lib/library {:snapshot (snap/snapshot
                      {:lua {:id :lua :book prep/+book-min+}})})
          v (resolve '!.hello) before [(deref v) (meta v)]]
      (try
        (registry/registry-install :lang/lua
          {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
        (macro/intern-! :lua "hello")
        (str/replace (eval '(!.hello 1 2 3 4 5)) ";" "")
        (finally
          (intern (ns-current) (with-meta '!.hello (second before)) (first before))
          (space/reset-spaces!) (registry/reset-registry!)
          (IComponent/stop library) (lib/reset-all! library) (reset! (:settings library) {})))))
  => "1\n2\n3\n4\n5")


^{:refer lang.core.script-macro/intern-free-fn :added "4.0"}
(fact "interns a free pointer in the namespace"
 (binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
  (try
   (registry/registry-install :lang/lua {:scratch {:module 'runtime.core}})
   (macro/intern-free-fn :lua '(defptr.lua hello 1) {})
   (finally
    (intern (ns-current) (with-meta 'hello {:macro false}) nil)
    (space/reset-spaces!) (registry/reset-registry!))))
 => #'lang.core.script-macro-test/hello)

^{:refer lang.core.script-macro/intern-free :added "4.0"}
(fact "creates a defptr macro"
 (try (macro/intern-free :lua "hello")
  (finally (intern (ns-current) (with-meta 'defptr.hello {:macro false}) nil)))
 => #'lang.core.script-macro-test/defptr.hello)

^{:refer lang.core.script-macro/intern-top-level-fn :id historical-top-level-clauses}
(fact "interns a top level function"
(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
  (let [library (lib/library:create {:snapshot (snap/snapshot
                  {:lua {:id :lua :book prep/+book-min+}})})]
   (try
    (registry/registry-install :lang/lua
     {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
    (impl/with:library [library]
     (let [v (macro/intern-top-level-fn :lua
               ['defn (get-in (lib/get-book library :lua) [:grammar :reserved 'defn])]
               (with-meta '(defn.lua ^{:b 2} add-more
                             "hello" {:a 1} [x y z] (return (+ x y z)))
                          {:module 'L.core}) {})]
v))
    (finally
     (intern (ns-current) (with-meta 'add-more {:macro false}) nil)
     (space/reset-spaces!) (registry/reset-registry!)
     (lib/reset-all! library) (reset! (:settings library) {})))))
 => #'lang.core.script-macro-test/add-more

(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
  (let [library (lib/library:create {:snapshot (snap/snapshot
                  {:lua {:id :lua :book prep/+book-min+}})})]
   (try
    (registry/registry-install :lang/lua
     {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
    (impl/with:library [library]
     (let [v (macro/intern-top-level-fn :lua
               ['defn (get-in (lib/get-book library :lua) [:grammar :reserved 'defn])]
               (with-meta '(defn.lua ^{:b 2} add-more
                             "hello" {:a 1} [x y z] (return (+ x y z)))
                          {:module 'L.core}) {})]
(lib/get-entry library '{:lang :lua :module L.core :id add-more})))
    (finally
     (intern (ns-current) (with-meta 'add-more {:macro false}) nil)
     (space/reset-spaces!) (registry/reset-registry!)
     (lib/reset-all! library) (reset! (:settings library) {})))))
 => (satisfies book/book-entry?)

(binding [space/*spaces* (atom {}) registry/*registry* (atom {})]
  (let [library (lib/library:create {:snapshot (snap/snapshot
                  {:lua {:id :lua :book prep/+book-min+}})})]
   (try
    (registry/registry-install :lang/lua
     {:scratch (rt/rt-default {:lang :lua :module 'L.core :library library})})
