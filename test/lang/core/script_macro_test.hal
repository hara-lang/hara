^{:refer lang.core.script-macro/intern-macros :id historical-intern-macros}
(fact "interns the top-level macros in the grammar"
  (let [library (lib/library {:snapshot snapshot-prep/+snap+})
        before (mapv (fn [sym] (let [v (resolve sym)] [sym (deref v) (meta v)]))
                     '[def$.lua defmacro.lua !.lua defptr.lua defrun.lua defn.lua defglobal.lua defgen.lua defn-.lua deftemp.lua defclass.lua defabstract.lua def.lua return break set= br])]
    (try
      (impl/with:library [library]
        (macro/intern-macros :lua (:grammar (lib/get-book library :lua))))
      (finally
        (doseq [[sym value metadata] before]
          (intern (ns-current) (with-meta sym metadata) value))
        (IComponent/stop library)
        (lib/reset-all! library)
        (reset! (:settings library) {}))))
  => (satisfies vector?))


