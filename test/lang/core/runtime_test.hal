(ns lang.core.runtime-test (:require [lang.core.runtime :as rt] [lang.core.pointer :as ptr] [std.lib.context.registry :as reg] [std.lib.context.space :as space] [lang.base.book :as book] [lang.base.emit-prep-lua-test :as prep] [lang.core.impl-entry :as entry] [lang.core.library :as lib] [lang.core.library-snapshot :as snap] [lang.base.util :as ut] [code.test :refer :all]))
(def +library-ext+
  (doto (lib/library:create
         {:snapshot (snap/snapshot {:lua {:id :lua
                                          :book prep/+book-min+}})})
    (lib/install-module! :lua 'L.util
                         {:require '[[L.core :as u]]
                          :import '[["cjson" :as cjson]]})
    (lib/add-entry-single!
     (entry/create-code-base
      '(defn sub-fn
         [a b]
         (return ((u/identity-fn u/sub) a b)))
      {:lang :lua
       :namespace (ns-current)
       :module 'L.util}
      {}))
    (lib/add-entry-single!
     (entry/create-code-base
      '(defn add-fn
         [a b]
         (return ((u/identity-fn u/add) a (-/sub-fn b 0))))
      {:lang :lua
       :namespace (ns-current)
       :module 'L.util}
      {}))))

(def +ptr+
  (ut/lang-pointer :lua
                   {:module 'L.core
                    :id 'add
                    :section :fragment
                    :library +library-ext+}))
(ns lang.core.runtime-test (:require [std.lib.context.resource :as resource]))

(def +runtime-baseline+
 {:registry (deref reg/*registry*) :spaces (deref space/*spaces*)
  :resource-registry (deref resource/*resource-registry*)
  :resource-aliases (deref resource/*resource-aliases*)
  :resource-active (deref resource/*resource-active*)})
(fact:global
 {:setup [(reg/registry-install :lang/lua
           {:scratch (rt/rt-default {:lang :lua :library +library-ext+})})]
  :teardown [(lib/reset-all! +library-ext+) (reset! (:settings +library-ext+) {})
             (reset! reg/*registry* (:registry +runtime-baseline+))
             (reset! space/*spaces* (:spaces +runtime-baseline+))
             (reset! resource/*resource-registry* (:resource-registry +runtime-baseline+))
             (reset! resource/*resource-aliases* (:resource-aliases +runtime-baseline+))
             (reset! resource/*resource-active* (:resource-active +runtime-baseline+))
             (if (not (and (= (deref reg/*registry*) (:registry +runtime-baseline+))
                           (= (deref space/*spaces*) (:spaces +runtime-baseline+))
                           (= (deref resource/*resource-registry*) (:resource-registry +runtime-baseline+))
                           (= (deref resource/*resource-aliases*) (:resource-aliases +runtime-baseline+))
                           (= (deref resource/*resource-active*) (:resource-active +runtime-baseline+))
                           (= (snap/snapshot {}) (lib/get-snapshot +library-ext+))
                           (= {} (deref (:settings +library-ext+)))))
                 (throw (ex :test/cleanup-failed {})))
             (println :runtime-test-cleanup-verified)]})

(ns lang.core.runtime-test (:require [lang.core.runtime :as rt] [lang.core.pointer :as ptr] [lang.base.util :as ut] [lang.base.book :as book] [lang.core.impl-deps :as deps] [std.lib.context.resource :as resource] [code.test :refer :all]))
^{:refer lang.core.runtime/default-tags-ptr :added "4.0"}
(fact "runtime default args"

  (rt/default-tags-ptr {:runtime :hello}
                       +ptr+)
  => '[:hello L.core/add :fragment])

^{:refer lang.core.runtime/default-deref-ptr, :added "4.0"}
(fact
  "runtime default deref"
  (rt/default-deref-ptr
    {:runtime :hello, :library +library-ext+}
    +ptr+)
  =>
  (satisfies book/book-entry?)
  (rt/default-deref-ptr {:runtime :hello} +ptr+)
  =>
  nil)

^{:refer lang.core.runtime/default-invoke-ptr :added "4.0"}
(fact "runtime default invoke"

  (rt/default-invoke-ptr {:runtime :hello
                          :library +library-ext+}
                         +ptr+
                         [1 2])
  => "1 + 2")

^{:refer lang.core.runtime/default-init-ptr :added "4.0"}
(fact "will init pointer if there is a :rt/init key"
  (rt/default-init-ptr {:lang :lua} {}) => nil)

^{:refer lang.core.runtime/default-display-ptr, :added "4.0"}
(fact
  "runtime default display"
  (rt/default-display-ptr
    {:runtime :hello, :library +library-ext+}
    +ptr+)
  =>
  "(fn:> [x y] (+ x y))"
  (rt/default-display-ptr
    {:runtime :hello}
    (ut/lang-pointer (:lang +ptr+) (dissoc (into {} +ptr+) :library)))
  =>
  "[:not-found L.core/add :fragment]")

^{:refer lang.core.runtime/rt-default, :added "4.0"}
(fact
  "creates a lang runtime"
  (rt/rt-default {:lang :lua})
  =>
  (satisfies rt/rt-default?))

^{:refer lang.core.runtime/rt-default? :added "4.0"}
(fact "checks if object is default runtime"
  (rt/rt-default? (rt/rt-default {:lang :lua})) => true)

^{:refer lang.core.runtime/rt-null :added "4.1"}
(fact "creates a default null runtime"
  (select-keys (rt/rt-null {}) [:lang])
  => {:lang :null})

^{:refer lang.core.runtime/install-lang!, :added "4.0"}
(fact
  "installs a language within `std.lib.context`"
  (rt/install-lang! :lua)
  =>
  (any (satisfies map?) (satisfies vector?)))

^{:refer lang.core.runtime/install-type!, :added "4.0"}
(fact
  "installs a specific runtime type given `:lang`"
  (let [create (get-in
                 (resource/spec-get :tahto/lang.rt)
                 [:instance :create])]
    (=
      create
      (do
        (rt/install-type!
          :lua
          :test-runtime
          {:type :tahto/lang.rt, :config {:bootstrap false}})
        (get-in
          (resource/spec-get :tahto/lang.rt)
          [:instance :create]))))
  =>
  true)

^{:refer lang.core.runtime/return-format-simple :added "4.0"}
(fact "format forms for return"

  (rt/return-format-simple [1 2 3])
  => '(1 2 (return 3)))

^{:refer lang.core.runtime/return-format :added "4.0"}
(fact "standard format for return"

  (rt/return-format '[1 2 (:= x 3)])
  => '(1 2 (:= x 3)))

^{:refer lang.core.runtime/return-wrap-invoke :added "4.0"}
(fact "wraps forms to be invoked"

  (rt/return-wrap-invoke '[1 2 (:= x 3)])
  => '((quote ((fn [] 1 2 (:= x 3))))))

^{:refer lang.core.runtime/normalize-body-forms :added "4.1"}
(fact "normalizes runtime eval input into body forms"
  (rt/normalize-body-forms '(do 1 2 (:= x 3)) {})
  => '(1 2 (:= x 3))

  (rt/normalize-body-forms '(+ 1 2) {})
  => '((+ 1 2))

  (rt/normalize-body-forms '[1 2 (:= x 3)] {:bulk true})
  => '[1 2 (:= x 3)])

^{:refer lang.core.runtime/return-transform :added "4.0"}
(fact "standard return transform"

  (rt/return-transform '[1 2 (:= x 3)] {})
  => '((quote ((fn [] (return [1 2 (:= x 3)])))))

  (rt/return-transform '(do 1 2 (:= x 3)) {})
  => '((quote ((fn [] 1 2 (:= x 3)))))

  (rt/return-transform '[1 2 (:= x 3)] {:bulk true})
  => '((quote ((fn [] 1 2 (:= x 3))))))

^{:refer lang.core.runtime/default-invoke-script :added "4.0"}
(fact "default invoke script call used by most runtimes"

  (rt/default-invoke-script {:runtime :hello
                             :library +library-ext+}
                            +ptr+
                            [10 20]
                            rt/default-raw-eval
                            {:json false})
  => "10 + 20")

^{:refer lang.core.runtime/default-lifecycle-prep, :added "4.0"}
(fact
  "prepares mopts for lifecycle"
  (rt/default-lifecycle-prep
    {:library +library-ext+, :lang :lua, :module 'L.core})
  =>
  (satisfies map?))

^{:refer lang.core.runtime/default-scaffold-setup-for :added "4.0"}
(fact "setup native modules, defglobals and defruns in the runtime"
  (vector :code.migrate/returned (rt/default-scaffold-setup-for
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.core))
  => (satisfies (fn [result] (and (vector? result) (= 2 (count result)) (= :code.migrate/returned (first result)) (string? (second result))))))

^{:refer lang.core.runtime/default-scaffold-setup-to :added "4.0"}
(fact "setup scaffold up to but not including the current module in the runtime"
  (vector :code.migrate/returned (rt/default-scaffold-setup-to
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util))
  => (satisfies (fn [result] (and (vector? result) (= 2 (count result)) (= :code.migrate/returned (first result)) (string? (second result))))))

^{:refer lang.core.runtime/default-scaffold-imports :added "4.0"}
(fact "embed native imports to be globally accessible"
  (vector :code.migrate/returned (rt/default-scaffold-imports
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util))
  => (satisfies (fn [result] (and (vector? result) (= 2 (count result)) (= :code.migrate/returned (first result)) (string? (second result))))))

^{:refer lang.core.runtime/default-lifecycle-fn :added "4.0"}
(fact "constructs a lifecycle fn"

  ((rt/default-lifecycle-fn deps/has-module-form)
   {:library +library-ext+
    :lang :lua
    :module 'L.core}
   'L.core)
  => nil

  ((rt/default-lifecycle-fn deps/has-ptr-form)
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   (ut/lang-pointer :lua
                    {:module 'L.util
                     :id 'add-fn
                     :section :code
                     :library +library-ext+}))
  => "L_util____add_fn != nil")

^{:refer lang.core.runtime/default-setup-module-emit, :added "4.0"}
(fact
  "emits the string for the module"
  (vector :code.migrate/returned (rt/default-setup-module-emit
    (rt/map->RuntimeDefault
      {:library +library-ext+,
       :lang :lua,
       :namespace (ns-current),
       :module 'L.core,
       :layout :full})
    'L.util))
  =>
  (satisfies (fn [result] (and (vector? result) (= 2 (count result)) (= :code.migrate/returned (first result)) (string? (second result))))))

^{:refer lang.core.runtime/default-setup-module-basic :added "4.0"}
(fact "basic setup module action"

  (vector :code.migrate/returned (rt/default-setup-module-basic
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util))
  => (satisfies (fn [result] (and (vector? result) (= 2 (count result)) (= :code.migrate/returned (first result)) (string? (second result))))))

^{:refer lang.core.runtime/default-teardown-module-basic :added "4.0"}
(fact "basic teardown module action"

  (rt/default-teardown-module-basic
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util)
  => "L_util____add_fn = nil\n\nL_util____sub_fn = nil")

^{:refer lang.core.runtime/default-setup-module :added "4.0"}
(fact "default setup module (with error isolation)"
  (vector :code.migrate/returned (rt/default-setup-module
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util))
  => (satisfies (fn [result] (and (vector? result) (= 2 (count result)) (= :code.migrate/returned (first result)) (string? (second result))))))

^{:refer lang.core.runtime/default-teardown-module :added "4.0"}
(fact "default teardown module (with error isolation)"
  (vector :code.migrate/returned (rt/default-teardown-module
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util))
  => (satisfies (fn [result] (and (vector? result) (= 2 (count result)) (= :code.migrate/returned (first result)) (string? (second result))))))

^{:refer lang.core.runtime/multistage-invoke, :added "4.0"}
(fact
  "invokes a multistage pipeline given deps function"
  (rt/multistage-invoke
    (rt/map->RuntimeDefault
      {:library +library-ext+,
       :lang :lua,
       :module 'L.core,
       :layout :full})
    'L.util
    (fn [_ _ _] nil)
    (fn [book module-id] (deps-ordered book [module-id])))
  =>
  '[[L.core nil] [L.util nil]])

^{:refer lang.core.runtime/multistage-setup-for :added "4.0"}
(fact "setup for a given namespace"

  (rt/multistage-setup-for
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util)
  => (contains-in [['L.core string?] ['L.util string?]]))

^{:refer lang.core.runtime/multistage-setup-to :added "4.0"}
(fact "setup to a given namespcase"

  (rt/multistage-setup-to
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util)
  => (contains-in [['L.core string?]]))

^{:refer lang.core.runtime/multistage-teardown-for :added "4.0"}
(fact "teardown for a given namespace"

  (rt/multistage-teardown-for
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util)
  => (contains-in [['L.util string?] ['L.core string?]]))

^{:refer lang.core.runtime/multistage-teardown-at :added "4.0"}
(fact "teardown all dependents including this"

  (rt/multistage-teardown-at
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util)
  => '[[L.util "L_util____add_fn = nil\n\nL_util____sub_fn = nil"]])

^{:refer lang.core.runtime/multistage-teardown-to :added "4.0"}
(fact "teardown all dependents upto this"

  (rt/multistage-teardown-to
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.util)
  => []

  (rt/multistage-teardown-to
   (rt/map->RuntimeDefault
    {:library +library-ext+
     :lang :lua
     :module 'L.core
     :layout :full})
   'L.core)
  => '[[L.util "L_util____add_fn = nil\n\nL_util____sub_fn = nil"]])

(ns lang.core.runtime-test
 (:require [lang.core.runtime :as rt] [std.lib.context.space :as space] [code.test :refer :all]))

(defstruct RuntimeProtocolTarget [label]
 IContextEval
 (evaluate-raw [self body options] (promise/from [(:label self) body options]))
 (tags-ptr [self ptr] [:tags (:label self) ptr])
 (deref-ptr [self ptr] [:deref (:label self) ptr])
 (display-ptr [self ptr] (str "target:" (:label self) ":" (:id ptr)))
 (invoke-ptr [self ptr args] [:invoke (:label self) ptr args])
 (transform-in-ptr [self ptr args] [:in (:label self) ptr args])
 (transform-out-ptr [self ptr value] [:out (:label self) ptr value])
 IContextLifeCycle
 (setup-ptr [self entry] [:init (:label self) entry])
 IComponent
 (started? [self] true)
 (stopped? [self] false)
 (remote? [self] true)
 (info [self level] {:label (:label self) :level level})
 (health [self] false))

^{:refer lang.core.runtime/RuntimeDefault :id original-default-component}
(fact "default component keeps the original flags, query values and lifecycle identity"
 (let [runtime (rt/rt-default {:lang :lua})]
  [(IComponent/started? runtime) (IComponent/stopped? runtime) (IComponent/remote? runtime)
   (IComponent/info runtime :detail) (IComponent/health runtime)
   (Base/identical? runtime (IComponent/start runtime))
   (Base/identical? runtime (IComponent/stop runtime))
   (Base/identical? runtime (IComponent/kill runtime))
   (str runtime) (IDisplay/display runtime)])
 => [true true false {} true true true true "#rt:lang[:lua]" "#rt:lang[:lua]"])

^{:refer lang.core.runtime/RuntimeDefault :id original-redirect-component}
(fact "redirected component queries forward the level and retain false health"
 (binding [space/*spaces*
            (atom {'target (space/Space 'target (atom {:lang/lua {:instance (->RuntimeProtocolTarget :lua)}}))})]
  (let [runtime (rt/rt-default {:lang :lua :redirect 'target})]
   [(IComponent/started? runtime) (IComponent/stopped? runtime) (IComponent/remote? runtime)
    (IComponent/info runtime [:detail 2]) (IComponent/health runtime)
    (Base/identical? runtime (IComponent/start runtime))
    (Base/identical? runtime (IComponent/stop runtime))
    (Base/identical? runtime (IComponent/kill runtime))]))
 => [true false true {:label :lua :level [:detail 2]} false true true true])

^{:refer lang.core.runtime/RuntimeDefault :id original-redirect-context}
(fact "every original context method forwards to the same selected runtime"
 (binding [space/*spaces*
            (atom {'target (space/Space 'target (atom {:lang/lua {:instance (->RuntimeProtocolTarget :lua)}}))})]
  (let [runtime (rt/rt-default {:lang :lua :redirect 'target}) ptr {:id 'x}]
   [(IContextEval/evaluate-raw runtime "body" {:ignored true})
    (IContextEval/tags-ptr runtime ptr)
    (IContextEval/deref-ptr runtime ptr)
    (IContextEval/display-ptr runtime ptr)
    (IContextEval/invoke-ptr runtime ptr [1 false])
    (IContextEval/transform-in-ptr runtime ptr [2])
    (IContextEval/transform-out-ptr runtime ptr false)
    (IContextLifeCycle/setup-ptr runtime {:id 'init})]))
 => [[:lua "body" {}] [:tags :lua {:id 'x}] [:deref :lua {:id 'x}] "target::lua:x"
     [:invoke :lua {:id 'x} [1 false]] [:in :lua {:id 'x} [2]]
     [:out :lua {:id 'x} false] [:init :lua {:id 'init}]])

^{:refer lang.core.runtime/RuntimeDefault :id original-default-context}
(fact "non-redirected display and invocation use the original pointer functions"
 (binding [reg/*registry* (atom {:lang/lua {:scratch (rt/rt-default {:lang :lua :library +library-ext+})}})
           space/*spaces* (atom {})]
  (let [runtime (rt/rt-default {:lang :lua :library +library-ext+})]
   [(IContextEval/evaluate-raw runtime "raw" {}) (IContextEval/tags-ptr runtime +ptr+)
    (IContextEval/display-ptr runtime +ptr+) (IContextEval/invoke-ptr runtime +ptr+ [1 2])
    (IContextEval/transform-in-ptr runtime +ptr+ [nil false])
    (IContextEval/transform-out-ptr runtime +ptr+ false)
    (IContextLifeCycle/setup-ptr runtime {})]))
 => ["raw" [:default 'L.core/add :fragment] "(fn:> [x y] (+ x y))" "1 + 2" [nil false] false nil])


^{:refer lang.core.runtime/default-invoke-script :id invocation-order-and-options}
(fact "runtime emit overrides parameters while callbacks retain original order"
 (binding [reg/*registry* (atom {:lang/lua {:scratch (rt/rt-default {:lang :lua :library +library-ext+})}})
           space/*spaces* (atom {})]
  (let [events (atom [])
        runtime {:runtime :hello :library +library-ext+ :layout :full
                 :emit {:test-options {:runtime 2 :winner :runtime}
                        :transform (fn [form opts]
                                     (swap! events conj
                                      [:emit (get-in opts [:emit :test-options])
                                       (get-in opts [:emit :input :args])
                                       (:layout opts)
                                       (get-in opts [:emit :runtime :type])
                                       (= (ns-current) (get-in opts [:emit :runtime :namespace]))])
                                     form)}}
        result (rt/default-invoke-script runtime +ptr+ [10 20]
                 (fn [actual body]
                  (swap! events conj [:eval (Base/identical? actual runtime) body])
                  "7")
                 {:layout :flat
                  :emit {:test-options {:parameter 1 :winner :parameter}
                         :transform (fn [_ _] (throw (ex :wrong/transform {})))}
                  :main {:in (fn [body] (swap! events conj [:in body]) (str "[" body "]"))
                         :out (fn [raw] (swap! events conj [:out raw]) raw)}
                  :json (fn [raw] (swap! events conj [:decode raw]) (inc (Json/read raw)))})]
   (try [result (deref events)] (finally (reset! events [])))))
 => [8 [[:emit {:parameter 1 :runtime 2 :winner :runtime} [10 20] :flat :hello true]
        [:in "10 + 20"] [:eval true "[10 + 20]"] [:out "7"] [:decode "7"]]])

^{:refer lang.core.runtime/default-invoke-script :id invocation-input-shortcut}
(fact "input shortcut still emits but never calls raw evaluation"
 (binding [reg/*registry* (atom {:lang/lua {:scratch (rt/rt-default {:lang :lua :library +library-ext+})}})
           space/*spaces* (atom {})]
  [(ptr/with:input
    (rt/default-invoke-script {:runtime :hello :library +library-ext+}
     +ptr+ [10 20] (fn [_ _] (throw (ex :wrong/evaluation {}))) {:json false}))
   ptr/*input*])
 => ["10 + 20" #{}])

^{:refer lang.core.runtime/default-invoke-script :id invocation-json-and-failure}
(fact "default JSON decoding preserves false and explicit nil disables decoding"
 (binding [reg/*registry* (atom {:lang/lua {:scratch (rt/rt-default {:lang :lua :library +library-ext+})}})
           space/*spaces* (atom {})]
  (mapv (fn [options]
          (rt/default-invoke-script {:runtime :hello :library +library-ext+}
           +ptr+ [10 20]
           (fn [_ _] "{\"type\":\"data\",\"value\":false}") options))
        [{} {:json nil} {:json false}]))
 => [false "{\"type\":\"data\",\"value\":false}" "{\"type\":\"data\",\"value\":false}"]
 (binding [reg/*registry* (atom {:lang/lua {:scratch (rt/rt-default {:lang :lua :library +library-ext+})}})
           space/*spaces* (atom {})]
  (rt/default-invoke-script {:runtime :hello :library +library-ext+}
   +ptr+ [10 20] (fn [_ _] (throw (ex :runtime/expected {:detail 9}))) {:json false}))
 => (throws-info {:ex/code :runtime/expected :detail 9}))

^{:refer lang.core.runtime/default-display-ptr :id display-xtalk-form}
(fact "xtalk display uses the original form instead of target emission"
 (binding [reg/*registry* (atom {:lang/lua {:scratch (rt/rt-default {:lang :lua :library +library-ext+})}})
           space/*spaces* (atom {})]
  (rt/default-display-ptr {:lang :xtalk :library +library-ext+} +ptr+))
 => "(fn [x y] (list (quote +) x y))")


^{:refer lang.core.runtime/default-has-module?}
(fact "module availability invokes the Book callback and emits its result"
 (let [calls (atom [])
       target (assoc prep/+book-min+ :meta
                     (book/book-meta {:has-module (fn [module] (swap! calls conj module) 11)}))
       rt (rt/map->RuntimeDefault {:lang :lua :library +library-ext+ :module 'L.core
                                    :lifecycle {:book target}})]
  (try [(rt/default-has-module? rt 'L.util) (deref calls)]
       (finally (reset! calls []))))
 => ["11" ['L.util]]
 (rt/default-has-module? (rt/map->RuntimeDefault {:lang :lua :library +library-ext+ :module 'L.core}) 'L.util)
 => nil)

^{:refer lang.core.runtime/default-has-ptr?}
(fact "pointer availability invokes the matching Book callback with the original pointer"
 (let [calls (atom [])
       target (assoc prep/+book-min+ :meta
                     (book/book-meta {:has-ptr (fn [p] (swap! calls conj [(= p +ptr+) (= (meta p) (meta +ptr+)) (= (IPointer/ptr-context p) (IPointer/ptr-context +ptr+))]) 12)}))
       rt (rt/map->RuntimeDefault {:lang :lua :library +library-ext+ :module 'L.core
                                    :lifecycle {:book target}})]
  (try [(rt/default-has-ptr? rt +ptr+) (deref calls)]
       (finally (reset! calls []))))
 => ["12" [[true true true]]])

^{:refer lang.core.runtime/default-setup-ptr}
(fact "pointer setup uses the Book setup callback without substituting init semantics"
 (let [calls (atom [])
       target (assoc prep/+book-min+ :meta
                     (book/book-meta {:setup-ptr (fn [p] (swap! calls conj [(= p +ptr+) (= (meta p) (meta +ptr+)) (= (IPointer/ptr-context p) (IPointer/ptr-context +ptr+))]) 13)}))
       rt (rt/map->RuntimeDefault {:lang :lua :library +library-ext+ :module 'L.core
                                    :lifecycle {:book target}})]
  (try [(rt/default-setup-ptr rt +ptr+) (deref calls)]
       (finally (reset! calls []))))
 => ["13" [[true true true]]])

^{:refer lang.core.runtime/default-teardown-ptr}
(fact "pointer teardown uses its own Book callback and preserves the native pointer value, metadata and context"
 (let [calls (atom [])
       target (assoc prep/+book-min+ :meta
                     (book/book-meta {:teardown-ptr (fn [p] (swap! calls conj [(= p +ptr+) (= (meta p) (meta +ptr+)) (= (IPointer/ptr-context p) (IPointer/ptr-context +ptr+))]) 14)}))
       rt (rt/map->RuntimeDefault {:lang :lua :library +library-ext+ :module 'L.core
                                    :lifecycle {:book target}})]
  (try [(rt/default-teardown-ptr rt +ptr+) (deref calls)]
       (finally (reset! calls []))))
 => ["14" [[true true true]]])

^{:refer lang.core.runtime/default-lifecycle-fn :id lifecycle-arguments-and-errors}
(fact "lifecycle closures retain the Book and all arguments and propagate callback failures"
 (let [calls (atom [])
       target prep/+book-min+
       runtime (rt/map->RuntimeDefault {:lang :lua :library +library-ext+ :module 'L.core
                                         :lifecycle {:book target}})
       invoke (rt/default-lifecycle-fn
                (fn [book a b]
                 (swap! calls conj [(Base/identical? book target) a b])
                 42))]
  (try [(invoke runtime :first false) (deref calls)]
       (finally (reset! calls []))))
 => ["42" [[true :first false]]]
 ((rt/default-lifecycle-fn (fn [_] (throw (ex :lifecycle/expected {:detail 7}))))
  (rt/map->RuntimeDefault {:lang :lua :library +library-ext+ :module 'L.core}))
 => (throws-info {:ex/code :lifecycle/expected :detail 7}))


(ns lang.core.runtime-test
 (:require [lang.core.impl-lifecycle :as lifecycle]))

(defstruct ^{:open true} IsolationRuntime [calls mode]
 IContextEval
 (evaluate-raw [self body options]
  (let [n (count (swap! (:calls self) conj body))]
   (if (or (= :all (:mode self))
           (and (= :whole (:mode self)) (= 1 n))
           (and (= :second (:mode self)) (= 2 n)))
    (throw (ex :test/outer {:ex/cause (ex :test/root {} :ex/message "root")} :ex/message "outer"))
    body))))

^{:refer lang.core.runtime/default-scaffold-array}
(fact "scaffold preserves ordered outputs and stops at the first failure"
 (let [calls (atom []) runtime (->IsolationRuntime calls :second)]
  (try [(rt/default-scaffold-array runtime [[:a "one"] [:b "two"] [:c "three"]])
        (deref calls)]
       (finally (reset! calls []))))
 => [[[:a "one"] [:b "two" "outer"]] ["one" "two"]]
 (let [calls (atom []) runtime (->IsolationRuntime calls nil)]
  (try [(rt/default-scaffold-array runtime []) (deref calls)
        (rt/default-scaffold-array runtime [[:raw "{broken"]]) (deref calls)]
       (finally (reset! calls []))))
 => [[] [] [[:raw "{broken"]] ["{broken"]])

^{:refer lang.core.runtime/default-teardown-module :id isolated-teardown-order}
(fact "failed combined teardown retries each exact part in order"
 (let [calls (atom [])
       runtime (assoc (->IsolationRuntime calls :whole)
                 :lang :lua :module 'L.core :library +library-ext+ :layout :full)]
  (try [(rt/default-teardown-module runtime 'L.util) (deref calls)]
       (finally (reset! calls []))))
 => [["L_util____add_fn = nil" "L_util____sub_fn = nil"]
     ["L_util____add_fn = nil\n\nL_util____sub_fn = nil"
      "L_util____add_fn = nil" "L_util____sub_fn = nil"]])

^{:refer lang.core.runtime/default-setup-module :id isolated-setup-order}
(fact "failed combined setup retries the real emitter parts and returns each result"
 (let [calls (atom [])
       runtime (assoc (->IsolationRuntime calls :whole)
                 :lang :lua :module 'L.core :library +library-ext+ :layout :full)
       options (rt/default-lifecycle-prep runtime)
       raw (lifecycle/emit-module-setup-raw 'L.util options)
       parts (lifecycle/emit-module-setup-concat raw)
       whole (lifecycle/emit-module-setup-join raw)]
  (try [(= parts (rt/default-setup-module runtime 'L.util))
        (= (vec (cons whole parts)) (deref calls))
        (> (count parts) 1)]
       (finally (reset! calls []))))
 => [true true true])

^{:refer lang.core.runtime/default-teardown-module :id teardown-root-cause}
(fact "isolated failure keeps the failing source lines and deepest cause message"
 (let [calls (atom [])
       runtime (assoc (->IsolationRuntime calls :all)
                 :lang :lua :module 'L.core :library +library-ext+ :layout :full)
       error (try (rt/default-teardown-module runtime 'L.util) nil (catch e e))]
  (try [(ex-message error)
        (select-keys (ex-data error) [:ex/code :part :message])
        (deref calls)]
       (finally (reset! calls []))))
 => ["Error at:"
     {:ex/code :hara/generic :part ["L_util____add_fn = nil"] :message "root"}
     ["L_util____add_fn = nil\n\nL_util____sub_fn = nil" "L_util____add_fn = nil"]])

^{:refer lang.core.runtime/default-setup-module :id setup-root-cause}
(fact "setup failure reports the first failing part and stops retrying"
 (let [calls (atom [])
       runtime (assoc (->IsolationRuntime calls :all)
                 :lang :lua :module 'L.core :library +library-ext+ :layout :full)
       raw (lifecycle/emit-module-setup-raw 'L.util (rt/default-lifecycle-prep runtime))
       part (first (lifecycle/emit-module-setup-concat raw))
       error (try (rt/default-setup-module runtime 'L.util) nil (catch e e))]
  (try [(ex-message error)
        (= (vec (str/split-lines part)) (:part (ex-data error)))
        (:message (ex-data error))
        (= [(lifecycle/emit-module-setup-join raw) part] (deref calls))]
       (finally (reset! calls []))))
 => ["Error at:" true "root" true])

^{:refer lang.core.runtime/default-setup-module :id empty-explicit-options}
(fact "explicit lifecycle options bypass runtime preparation and empty setup does not evaluate"
 (let [library (lib/library:create {:snapshot (lib/get-snapshot +library-ext+)})
       calls (atom []) runtime (->IsolationRuntime calls :all)]
  (try
   (lib/install-module! library :lua 'L.empty {})
   (let [options (rt/default-lifecycle-prep {:lang :lua :library library :module 'L.empty :layout :full})]
    [(rt/default-setup-module runtime 'L.empty options) (deref calls)])
   (finally (reset! calls []) (lib/reset-all! library) (reset! (:settings library) {}))))
 => [nil []])

^{:refer lang.core.runtime/default-teardown-module :id empty-explicit-options}
(fact "explicit lifecycle options bypass runtime preparation and empty teardown does not evaluate"
 (let [library (lib/library:create {:snapshot (lib/get-snapshot +library-ext+)})
       calls (atom []) runtime (->IsolationRuntime calls :all)]
  (try
   (lib/install-module! library :lua 'L.empty {})
   (let [options (rt/default-lifecycle-prep {:lang :lua :library library :module 'L.empty :layout :full})]
    [(rt/default-teardown-module runtime 'L.empty options) (deref calls)])
   (finally (reset! calls []) (lib/reset-all! library) (reset! (:settings library) {}))))
 => [nil []])

^{:refer lang.core.runtime/default-raw-eval}
 (fact "raw default and RuntimeDefault preserve input unchanged"
  (let [runtime (rt/rt-default {:lang :lua})]
   [(rt/default-raw-eval runtime "return 1")
    (IContextEval/evaluate-raw runtime "return 1" {:ignored true})])
  => ["return 1" "return 1"])

^{:refer lang.core.runtime/default-transform-in-ptr}
(fact
  "input transformation preserves exact argument values"
  (let [runtime (rt/rt-default {:lang :lua}) args [nil false {:x 1}]]
    [(rt/default-transform-in-ptr runtime nil args)
     (= args (IContextEval/transform-in-ptr runtime nil args))])
  =>
  [[nil false {:x 1}] true])

^{:refer lang.core.runtime/default-transform-out-ptr}
 (fact "output transformation preserves false nil and identity"
  (let [runtime (rt/rt-default {:lang :lua}) value {:result 1}]
   [(rt/default-transform-out-ptr runtime nil false)
    (IContextEval/transform-out-ptr runtime nil nil)
    (Base/identical? value (IContextEval/transform-out-ptr runtime nil value))])
  => [false nil true])

^{:refer lang.core.runtime/rt-default-string :id runtime-native-label}
 (fact "native str and display use the original runtime label"
  (mapv (fn [language]
    (let [runtime (rt/rt-default {:lang language})]
     [(str runtime) (IDisplay/display runtime)])) [:lua :python nil])
  => [["#rt:lang[:lua]" "#rt:lang[:lua]"]
      ["#rt:lang[:python]" "#rt:lang[:python]"]
      ["#rt:lang[nil]" "#rt:lang[nil]"]])

(comment :previous-native-runtime-architecture
(ns lang.core.runtime-test
  (:use code.test)
  (:require [lang.core.library :as library]
            [lang.core.registry :as registry]
            [lang.core.runtime :as runtime]))

(defn isolated
  [function]
  (let [snapshot (runtime/runtime-snapshot)
        library-snapshot (library/library-raw-snapshot (library/default-library))]
    (try
      (runtime/runtime-reset!)
      (function)
      (finally
        (runtime/runtime-restore! snapshot)
        (library/library-restore! (library/default-library) library-snapshot)))))

^{:refer lang.core.runtime/atom-value}
(Test/check [{:name "dereferences runtime state atoms"
              :test (fn [] (runtime/atom-value (atom :value)))
              :expected :value}])

^{:refer lang.core.runtime/runtime-snapshot}
(Test/check [{:name "captures both runtime registries"
              :test (fn [] (isolated runtime/runtime-snapshot))
              :expected {:types {}}}])

^{:refer lang.core.runtime/runtime-restore!}
(Test/check [{:name "restores exact runtime state"
              :test (fn [] (isolated (fn []
                                       (runtime/runtime-restore!
                                        {:types {[:demo :test] {:create identity}}}))))
              :expected {:types {[:demo :test] {:create identity}}}}])

^{:refer lang.core.runtime/runtime-reset!}
(Test/check [{:name "clears runtime state idempotently"
              :test (fn [] (isolated (fn [] [(runtime/runtime-reset!)
                                              (runtime/runtime-reset!)])))
              :expected [{:types {}} {:types {}}]}])

^{:refer lang.core.runtime/rt-default:create}
(Test/check [{:name "creates an unstarted default context"
              :test (fn [] (let [value (runtime/rt-default:create {:lang :postgres})]
                           [(:id value) (:lang value) (:runtime value)
                            (deref (:state value))]))
              :expected [:postgres.default :postgres :default {:status :created}]}])

^{:refer lang.core.runtime/default-state}
(Test/check [{:name "reads default context state"
              :test (fn [] (runtime/default-state (runtime/rt-default:create {:lang :xtalk})))
              :expected {:status :created}}])

^{:refer lang.core.runtime/start-default}
(Test/check [{:name "starts a default context"
              :test (fn [] (let [value (runtime/rt-default:create {:lang :xtalk})]
                           (deref (:state (runtime/start-default value)))))
              :expected {:status :started}}])

^{:refer lang.core.runtime/stop-default}
(Test/check [{:name "stops a default context"
              :test (fn [] (let [value (runtime/rt-default {:lang :xtalk})]
                           (deref (:state (runtime/stop-default value)))))
              :expected {:status :stopped}}])

^{:refer lang.core.runtime/rt-default}
(Test/check [{:name "creates and starts a default context"
              :test (fn [] (deref (:state (runtime/rt-default {:lang :xtalk}))))
              :expected {:status :started}}])

^{:refer lang.core.runtime/default-runtime-spec}
(Test/check [{:name "defines the compile-only coordinate"
              :test (fn [] (select-keys (runtime/default-runtime-spec :xtalk)
                                        [:lang :runtime :component]))
              :expected {:lang :xtalk :runtime :default :component true}}])

^{:refer lang.core.runtime/RuntimeDefault}
(Test/check [{:name "implements current context evaluation and lifecycle seams"
              :test (fn [] (let [value (runtime/rt-default {:lang :xtalk})]
                           [(IContext/call value :a :b)
                            (deref (IContextEval/evaluate value :request {}))
                            (IContextEval/eval-await-ptr value :pointer [] {})
                            (IContextEval/tags-ptr value :pointer)
                            (IContextEval/deref-ptr value :pointer)
                            (IContextEval/transform-in-ptr value :pointer [1])
                            (IContextEval/transform-out-ptr value :pointer :value)
                            (IContextLifeCycle/has-module? value :module)
                            (do (IContextLifeCycle/setup-module value :module)
                                (IContextLifeCycle/has-module? value :module))
                            (do (IContextLifeCycle/setup-ptr value :pointer)
                                (IContextLifeCycle/has-setup-ptr? value :pointer))]))
              :expected [[:a :b] :request :pointer [] :pointer [1] :value false true true]}])

^{:refer lang.core.runtime/install-lang}
(Test/check [{:name "installs explicit immutable books"
              :test (fn [] (isolated (fn []
                                       (let [entry (runtime/install-lang
                                                    :demo
                                                    {:book {:lang :demo :version 3}})]
                                         [entry
                                          (:book (library/library-raw-book-record
                                                  (library/default-library) :demo))]))))
              :expected [{:lang :demo :book-key :default :version 3
                          :book {:lang :demo :version 3}}
                         {:lang :demo :version 3}]}])

^{:refer lang.core.runtime/select-lang-version}
(Test/check [{:name "selects a real registered book version"
              :test (fn [] (isolated (fn []
                                       (select-keys (runtime/select-lang-version :postgres 1)
                                                    [:lang :version :book-key]))))
              :expected {:lang :postgres :version 1 :book-key :default}}])

^{:refer lang.core.runtime/install-type}
(Test/check [{:name "installs explicit runtime specifications"
              :test (fn [] (isolated (fn []
                                       (runtime/install-type :demo :test {:create identity}))))
              :expected {:lang :demo :runtime :test :create identity}}])

^{:refer lang.core.runtime/language-info}
(Test/check [{:name "returns selected language data"
              :test (fn [] (isolated (fn []
                                       (runtime/install-lang :demo {:book {:lang :demo :version 1}})
                                       (select-keys (runtime/language-info :demo) [:lang :version]))))
              :expected {:lang :demo :version 1}}])

^{:refer lang.core.runtime/runtime-installed?}
(Test/check [{:name "recognizes default and explicit coordinates"
              :test (fn [] (isolated (fn []
                                       (runtime/install-type :demo :test {:create identity})
                                       [(runtime/runtime-installed? :demo :default)
                                        (runtime/runtime-installed? :demo :test)
                                        (runtime/runtime-installed? :demo :missing)])))
              :expected [true true false]}])

^{:refer lang.core.runtime/available-runtimes}
(Test/check [{:name "lists deterministic canonical coordinates"
              :test (fn [] (isolated (fn []
                                       (runtime/install-type :demo :test {:create identity})
                                       (runtime/available-runtimes :demo))))
              :expected [:default :test]}])

^{:refer lang.core.runtime/available-runtimes}
^{:refer lang.core.runtime/runtime-installed?}
^{:refer lang.core.runtime/runtime-snapshot}
(fact "declared JavaScript basic availability does not instantiate a runtime"
  (isolated
   (fn []
     [(runtime/available-runtimes :js)
      (runtime/runtime-installed? :js :basic)
      (runtime/runtime-snapshot)]))
  => [[:basic :default :oneshot :verify]
      true
      {:types {}}])

^{:refer lang.core.runtime/require-runtime}
(Test/check [{:name "rejects unknown coordinates"
              :test (fn [] (try (runtime/require-runtime :demo :missing)
                                (catch error (:ex/code (ex-data error)))))
              :expected :hara/dependency}])

^{:refer lang.core.runtime/registered-runtime-spec}
(Test/check [{:name "loads the sole PostgreSQL client coordinate"
              :test (fn [] (select-keys (runtime/registered-runtime-spec :postgres :client)
                                        [:language :runtime :key]))
              :expected {:language :postgres :runtime :client :key :client}}])

^{:refer lang.core.runtime/runtime-spec}
(Test/check [{:name "prefers default and installed specifications"
              :test (fn [] (isolated (fn []
                                       (runtime/install-type :demo :test {:create identity})
                                       [(select-keys (runtime/runtime-spec :demo :default) [:runtime])
                                        (runtime/runtime-spec :demo :test)])))
              :expected [{:runtime :default} {:lang :demo :runtime :test :create identity}]}])

^{:refer lang.core.runtime/rt-create}
(Test/check [{:name "constructs from a canonical runtime spec"
              :test (fn [] (isolated (fn []
                                       (runtime/install-type :demo :test
                                                             {:create (fn [value] value)
                                                              :config {:base true}})
                                       (runtime/rt-create :demo :test {:override true}))))
              :expected {:base true :override true :lang :demo :runtime :test}}])

^{:refer lang.core.runtime/rt-start}
(Test/check [{:name "starts component contexts"
              :test (fn [] (deref (:state (runtime/rt-start
                                            (runtime/rt-default:create {:lang :demo})))))
              :expected {:status :started}}])

^{:refer lang.core.runtime/rt-stop}
(Test/check [{:name "stops component contexts"
              :test (fn [] (let [value (runtime/rt-default {:lang :demo})]
                           (deref (:state (runtime/rt-stop value)))))
              :expected {:status :stopped}}])

^{:refer lang.core.runtime/rt-eval}
(Test/check [{:name "uses semantic context evaluation"
              :test (fn [] (deref (runtime/rt-eval (runtime/rt-default {:lang :demo}) :value)))
              :expected :value}])

^{:refer lang.core.runtime/rt-eval-raw}
(Test/check [{:name "uses raw context evaluation"
              :test (fn [] (deref (runtime/rt-eval-raw (runtime/rt-default {:lang :demo}) :value)))
              :expected :value}])

^{:refer lang.core.runtime/rt-eval-trace}
(Test/check [{:name "records default evaluation in an EvalTrace"
              :test (fn [] (select-keys
                            (deref (runtime/rt-eval-trace (runtime/rt-default {:lang :demo}) :value))
                            [:status :result]))
              :expected {:status :ok :result :value}}])

^{:refer lang.core.runtime/rt-raw-eval}
(Test/check [{:name "uses direct context invocation for emitted source"
              :test (fn [] (runtime/rt-raw-eval (runtime/rt-default {:lang :demo}) "select 1"))
              :expected "select 1"}])

^{:refer lang.core.runtime/requested-version}
(Test/check [{:name "prefers per-language and global version selection"
              :test (fn [] [(runtime/requested-version :postgres 1 {:postgres 1})
                            (runtime/requested-version :postgres 1 {})
                            (runtime/requested-version :postgres nil {})])
              :expected [1 1 1]}])

^{:refer lang.core.runtime/bootstrap}
(Test/check [{:name "selects configured books without loading providers"
              :test (fn [] (isolated (fn []
                                       (let [result (runtime/bootstrap
                                                     {:languages [:postgres]
                                                      :runtimes [:default]})]
                                         [(:versions result)
                                          (get-in result [:books :postgres :lang])
                                          (get-in result [:library :selected :postgres])
                                          (:runtimes result)]))))
              :expected [{:postgres 1} :postgres [:postgres :default 1] {}]}])

)


(ns lang.core.runtime-test (:require [lang.core.runtime :as rt] [code.test :refer [fact]]))
^{:refer lang.core.runtime/default-has-module? :id has-module-arglists}
(fact "module presence alias exposes evaluated Foundation arglists"
 (:arglists (meta #'rt/default-has-module?)) => '([rt module-id]))
^{:refer lang.core.runtime/default-has-ptr? :id has-pointer-arglists}
(fact "pointer presence alias exposes evaluated Foundation arglists"
 (:arglists (meta #'rt/default-has-ptr?)) => '([rt ptr]))
^{:refer lang.core.runtime/default-setup-ptr :id setup-pointer-arglists}
(fact "pointer setup alias exposes evaluated Foundation arglists"
 (:arglists (meta #'rt/default-setup-ptr)) => '([rt ptr]))
^{:refer lang.core.runtime/default-teardown-ptr :id teardown-pointer-arglists}
(fact "pointer teardown alias exposes evaluated Foundation arglists"
 (:arglists (meta #'rt/default-teardown-ptr)) => '([rt ptr]))


(ns lang.core.runtime-test
 (:require [lang.core.runtime :as rt])
 (:use code.test))

(def +return-wrap-fixture+ nil)

^{:refer lang.core.runtime/return-transform :id :live-wrapper-var}
(fact "wrapper Vars resolve after formatting and test mutations restore their baseline"
 (let [baseline +return-wrap-fixture+]
  (try
   (Runtime/intern 'lang.core.runtime-test '+return-wrap-fixture+
     (fn [forms] [:old forms]))
   (rt/return-transform [1 false] {:bulk true}
    {:wrap-fn (var +return-wrap-fixture+)
     :format-fn (fn [forms]
                  (Runtime/intern 'lang.core.runtime-test '+return-wrap-fixture+
                    (fn [value] [:new value]))
                  forms)})
   (finally
    (Runtime/intern 'lang.core.runtime-test '+return-wrap-fixture+ baseline))))
 => [:new [1 false]]
 +return-wrap-fixture+ => nil)

^{:refer lang.core.runtime/return-transform :id :ifn-values-and-failures}
(fact "IFn callbacks preserve nil and false and propagate formatting failures"
 [(rt/return-transform [1 2] {:bulk true}
    {:format-fn {[1 2] false} :wrap-fn {false nil}})
  (rt/return-transform [1 2] {:bulk true}
    {:format-fn {[1 2] nil} :wrap-fn {nil false}})]
 => [nil false]
 (rt/return-transform [1] {:bulk true}
   {:format-fn (fn [_] (throw (ex :test/format-failure {:detail 7})))
    :wrap-fn (fn [_] (throw (ex :test/wrong-wrapper {})))})
 => (throws-info {:ex/code :test/format-failure :detail 7}))
