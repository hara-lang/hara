(ns lang.core.impl-test
  (:require [lang.base.book :as book]
            [lang.base.emit-prep-lua-test :as prep]
            [lang.core.impl :as impl :refer :all]
            [lang.core.impl-deps :as deps]
            [lang.core.impl-entry :as entry]
            [lang.core.impl-lifecycle :as lifecycle]
            [lang.core.library :as lib]
            [lang.core.library-snapshot :as snap]
            [lang.model.v1.spec-xtalk :as xtalk]
            [lang.model.v1.spec-js :as js]
            [lang.model.v1.spec-js.meta :as js-meta])
  (:use code.test))

(def migration-libraries (atom []))
(def migration-default-library (lib/library:create {}))
(swap! migration-libraries conj migration-default-library)
(lib/install-book! migration-default-library xtalk/+book+)
(lib/install-book! migration-default-library prep/+book-min+)
(lib/install-book! migration-default-library (book/book {:lang :js :parent :xtalk :meta js-meta/+meta+ :grammar js/+grammar+}))
(fact:global {:teardown [(doseq [library @migration-libraries]
                          (lib/reset-all! library)
                          (reset! (:settings library) {}))]})


(def +library+
 (let [created (lib/library
                 {:snapshot
                  (snap/snapshot
                    {:lua {:id :lua, :book prep/+book-min+}})})]
   (swap! migration-libraries conj created)
   created))

(def +library-ext+
 (doto
   (let [created (lib/library:create
                   {:snapshot
                    (snap/snapshot
                      {:lua {:id :lua, :book prep/+book-min+}})})]
     (swap! migration-libraries conj created)
     created)
   (lib/install-module!
     :lua
     'L.util
     {:require '[[L.core :as u]], :import '[["cjson" :as cjson]]})
   (lib/add-entry-single!
     (entry/create-code-base
       '(defn sub-fn [a b] (return ((u/identity-fn u/sub) a b)))
       {:lang :lua, :module 'L.util}
       {}))
   (lib/add-entry-single!
     (entry/create-code-base
       '(defn add-fn [a b]
          (return ((u/identity-fn u/add) a (-/sub-fn b 0))))
       {:lang :lua, :module 'L.util}
       {}))))

^{:refer lang.core.impl-lifecycle/emit-module-prep, :adopt true, :added "4.0"}
(fact
  "prepare data for emit of module"
  (binding [impl/*library* migration-default-library]
    (-> (lifecycle/emit-module-prep
          'L.util
          {:lang :lua, :library +library-ext+})
     second
     (dissoc :code)))
  =>
  '{:setup nil, :teardown nil, :native {}, :direct #{L.core}})

^{:refer lang.core.impl-lifecycle/emit-module, :adopt true, :added "4.0"}
(fact
  "emits the module string"
  (binding [impl/*library* migration-default-library]
    (lifecycle/emit-module-setup
      'L.util
      {:lang :lua,
       :library +library-ext+,
       :layout :module,
       :emit {:export {:suppress true}, :link {:suppress true}}}))
  =>
  (satisfies string?))

^{:refer lang.core.impl/with:library, :added "4.0"}
(fact
  "injects a library as the default"
  (binding [impl/*library* migration-default-library]
    (with:library [+library+] *library*))
  =>
  +library+)

^{:refer lang.core.impl/default-library, :added "4.0"}
(fact
  "gets the default library"
  (binding [impl/*library* migration-default-library]
    (default-library))
  =>
  (satisfies lib/library?))

^{:refer lang.core.impl/default-library:reset, :added "4.0"}
(fact
  "clears the default library, including all grammars"
  (binding [impl/*library* migration-default-library]
    (with:library
      [(let [created (lib/library {})]
         (swap! migration-libraries conj created)
         created)]
      (default-library:reset)))
  =>
  (satisfies (fn [value] true)))

^{:refer lang.core.impl/clone-default-library, :added "4.1"}
(fact
  "clones the default library"
  (binding [impl/*library* migration-default-library]
    (let [created (clone-default-library)]
      (swap! migration-libraries conj created)
      created))
  =>
  (satisfies lib/library?))

^{:refer lang.core.impl/runtime-library, :added "4.0"}
(fact
  "gets the current runtime (annex or default)"
  (binding [impl/*library* migration-default-library]
    (runtime-library))
  =>
  (satisfies lib/library?))

^{:refer lang.core.impl/grammar, :added "4.0"}
(fact
  "gets the grammar"
  (binding [impl/*library* migration-default-library]
    (with:library [+library+] (grammar :lua)))
  =>
  (satisfies map?))

^{:refer lang.core.impl/emit-options, :added "4.0"}
(fact
  "create emit options"
  (binding [impl/*library* migration-default-library]
    (emit-options {:lang :lua}))
  =>
  (satisfies vector?))

^{:refer lang.core.impl/to-form, :added "4.0"}
(fact
  "input to form"
  (binding [impl/*library* migration-default-library]
    (to-form '(+ (deref 1) 2 3) {:- :raw, :lang :xtalk}))
  =>
  '(+ (deref 1) 2 3)
  (binding [impl/*library* migration-default-library]
    (to-form '(+ (deref 1) 2 3) {:lang :lua}))
  =>
  '(+ (!:eval 1) 2 3))

^{:refer lang.core.impl/%.form, :added "4.0"}
(fact
 "converts to a form"
 (binding
  [impl/*library* migration-default-library]
  ^{:- :raw}
  (%.form (+ (deref 1) 2 3)))
 =>
 '(+ (deref 1) 2 3)
 (binding
  [impl/*library* migration-default-library]
  (%.form (+ (deref 1) 2 3)))
 =>
 '(+ (!:eval 1) 2 3))

^{:refer lang.core.impl/emit-direct, :added "4.0"}
(fact
  "adds additional controls to transform form"
  (binding [impl/*library* migration-default-library]
    (emit-direct
      (:grammar prep/+book-min+)
      '(:% (:- "   ") (+ 1 2 3) (:- "   "))
      (ns-current)
      {:emit {:trim str/trim}, :lang :lua}))
  =>
  "1 + 2 + 3")

(fact
  "direct emit failures include tahto.core context"
  (binding [impl/*library* migration-default-library]
    (let [grammar (assoc-in
                    (:grammar prep/+book-min+)
                    [:reserved 'boom-op]
                    {:op :boom-op,
                     :emit
                     (fn [_ _ _]
                       (throw
                         (ex
                           :generic
                           {:probe true}
                           :ex/message
                           "boom")))})
          form (with-meta '(boom-op 1 2 3) {:line 19})]
      (try
        (emit-direct
          grammar
          form
          (ns-current)
          {:emit {}, :lang :lua, :module {:id 'L.core}})
        nil
        (catch
          t
          (select-keys
            (ex-data t)
            [:probe
             :lang/phase
             :lang/subsystem
             :lang/lang
             :lang/module
             :lang/form
             :lang/provenance-stack])))))
  =>
  '{:probe true,
    :lang/phase :emit/form,
    :lang/subsystem :lang.base.emit-top-level/emit-form,
    :lang/lang :lua,
    :lang/module L.core,
    :lang/form (boom-op 1 2 3),
    :lang/provenance-stack
    [{:lang/phase :emit/form,
      :lang/subsystem :lang.base.emit-top-level/emit-form,
      :lang/lang :lua,
      :lang/module L.core,
      :lang/namespace lang.core.impl-test,
      :lang/line 19,
      :lang/form (boom-op 1 2 3),
      :lang/symbol boom-op}
     {:lang/phase :emit/direct,
      :lang/subsystem :lang.core.impl/emit-direct,
      :lang/lang :lua,
      :lang/module L.core,
      :lang/namespace lang.core.impl-test,
      :lang/line 19,
      :lang/form (boom-op 1 2 3)}]})

^{:refer lang.core.impl/emit-str, :added "4.0"}
(fact
  "converts to an output string"
  (binding [impl/*library* migration-default-library]
    (emit-str '(+ 1 2 3) {:- :raw, :lang :lua}))
  =>
  "1 + 2 + 3"
  (binding [impl/*library* migration-default-library]
    (emit-str '(+ (deref 1) 2 3) {:lang :lua}))
  =>
  "1 + 2 + 3")

^{:refer lang.core.impl/%.str, :added "4.0"}
(fact "converts a macro form to an output string" (binding [impl/*library* migration-default-library] ^{:- :raw} (%.str (+ (clojure.core/deref 1) 2 3))) => "clojure.core.deref(1) + 2 + 3" (binding [impl/*library* migration-default-library] (%.str (+ (deref 1) 2 3))) => "1 + 2 + 3" (binding [impl/*library* migration-default-library] (%.str (+ ((deref !) 1) 2 3))) => "1 + 2 + 3" (binding [impl/*library* migration-default-library] ^{:lang :js} (%.str (defn hello [:int x :int y := 0] (\\ \\ (if (not= i y) (if (not= 1 2) (return 1)))) (+ 6 x y) (return (or (not (+ 1 2)) (not (+ 1 2))))))) => (str/join "\n" ["function hello(int x,int y = 0){" "  " "  if(i != y){" "    if(1 != 2){" "      return 1;" "    }" "  }" "  6 + x + y;" "  return !(1 + 2) || !(1 + 2);" "}"]) (binding [impl/*library* migration-default-library] ^{:lang :js} (%.str ^{:indent 5, :full-body true} (\\ (do (+ 1 2 3) (+ 1 2 3))))) => (str/join "\n" ["     1 + 2 + 3;" "     1 + 2 + 3;"]) (binding [impl/*library* migration-default-library] ^{:lang :js} (%.str ^{:indent 5} (\\ \\ (do (+ 1 2 3) (+ 1 2 3))))) => (str/join "\n" ["" "     1 + 2 + 3;" "     1 + 2 + 3;"]) (binding [impl/*library* migration-default-library] ^{:lang :js} (%.str (:# (do (+ 1 2 3) (+ 1 2 3))))) => (str/join "\n" ["// 1 + 2 + 3;" "// 1 + 2 + 3;"]) (binding [impl/*library* migration-default-library] ^{:lang :js} (%.str ^{:prefix "|   "} (:# (do (+ 1 2 3) (+ 1 2 3))))) => (str/join "\n" ["|    1 + 2 + 3;" "|    1 + 2 + 3;"]))

^{:refer lang.core.impl/emit-as, :added "4.0"}
(fact
  "helper function for emitting multiple forms"
  (binding [impl/*library* migration-default-library]
    (emit-as :lua '[(+ 1 2 3) (+ 4 5 6)] {:library +library+}))
  =>
  "1 + 2 + 3\n\n4 + 5 + 6")

^{:refer lang.core.impl/emit-symbol, :added "4.0"}
(fact
  "emits string given symbol and grammar"
  (binding [impl/*library* migration-default-library]
    (with:library
      [+library+]
      (emit-symbol
        :lua
        'L.core/identity-fn
        {:module (lib/get-module +library+ :lua 'L.core)})))
  =>
  "identity_fn"
  (binding [impl/*library* migration-default-library]
    (with:library
      [+library+]
      (emit-symbol
        :lua
        'L.core/identity-fn
        {:layout :full,
         :module (lib/get-module +library+ :lua 'L.core)})))
  =>
  "L_core____identity_fn"
  (binding [impl/*library* migration-default-library]
    (with:library
      [+library+]
      (emit-symbol :lua 'L.core/WRONG {:library +library+})))
  =>
  "WRONG")

^{:refer lang.core.impl/get-entry, :added "4.0"}
(fact
  "gets an entry"
  (binding [impl/*library* migration-default-library]
    (get-entry +library+ :lua 'L.core 'identity-fn))
  =>
  (satisfies book/book-entry?))

^{:refer lang.core.impl/emit-entry, :added "4.0"}
(fact
  "emits an entry given parameters and options"
  (binding [impl/*library* migration-default-library]
    (emit-entry
      '{:lang :lua, :module L.core, :id identity-fn}
      {:lang :lua, :library +library+}))
  =>
  "function identity_fn(x){\n  return x;\n}"
  (binding [impl/*library* migration-default-library]
    (emit-entry
      '{:lang :lua, :module L.core, :id identity-fn}
      {:lang :lua, :library +library+, :layout :full}))
  =>
  "function L_core____identity_fn(x){\n  return x;\n}")

^{:refer lang.core.impl/emit-entry-deps-collect, :added "4.0"}
(fact
  "only collects the dependencies"
  (binding [impl/*library* migration-default-library]
    (emit-entry-deps-collect
      '{:lang :lua, :module L.core, :id identity-fn}
      {:lang :lua, :library +library+}))
  =>
  (satisfies (fn [x] (and (seq x) (book/book-entry? (first x))))))

^{:refer lang.core.impl/emit-entry-deps, :added "4.0"}
(fact
  "emits only the entry deps"
  (binding [impl/*library* migration-default-library]
    (emit-entry-deps
      '{:lang :lua, :module L.util, :id add-fn}
      {:lang :lua, :library +library-ext+, :layout :full}))
  =>
  (str/join
    "\n"
    ["function L_core____identity_fn(x){"
     "  return x;"
     "}"
     ""
     "function L_util____add_fn(a,b){"
     "  return L_core____identity_fn(function (x,y){"
     "    return x + y;"
     "  })(a,L_util____sub_fn(b,0));"
     "}"
     ""
     "function L_util____sub_fn(a,b){"
     "  return L_core____identity_fn(function (x,y){"
     "    return x - y;"
     "  })(a,b);"
     "}"]))

^{:refer lang.core.impl/emit-script-imports, :added "4.0"}
(fact
  "emit imports"
  (binding [impl/*library* migration-default-library]
    (emit-script-imports
      '{"cjson" {:as cjson}}
      nil
      (emit-options
        {:lang :lua,
         :library +library-ext+,
         :module (lib/get-module +library-ext+ :lua 'L.util),
         :layout :flat})))
  =>
  '("var__(local=cjson,==require(\"cjson\"));")
  (binding [impl/*library* migration-default-library]
    (emit-script-imports
      '{"cjson" {:as cjson}}
      {:override {"cjson" "https://cdn.example.com/cjson"}}
      (emit-options
        {:lang :lua,
         :library +library-ext+,
         :module (lib/get-module +library-ext+ :lua 'L.util),
         :layout :flat})))
  =>
  '("var__(local=cjson,==require(\"https://cdn.example.com/cjson\"));"))

^{:refer lang.core.impl/emit-script-deps, :added "4.0"}
(fact
  "emits the script deps"
  (binding [impl/*library* migration-default-library]
    (let [[stage grammar book namespace mopts] (emit-options
                                                 {:lang :lua,
                                                  :library
                                                  +library-ext+,
                                                  :module
                                                  (lib/get-module
                                                    +library-ext+
                                                    :lua
                                                    'L.util),
                                                  :layout :flat})
          [deps _] (deps/collect-script-entries
                     book
                     (std.foundation/apply
                       std.foundation/vector
                       (std.foundation/seq
                         (std.foundation/concat
                           (std.foundation/list 'L.util/add-fn)))))]
      (emit-script-deps
        deps
        nil
        [stage grammar book namespace mopts])))
  =>
  (satisfies coll?))

^{:refer lang.core.impl/emit-script-join, :added "4.0"}
(fact
  "joins the necessary parts of the script"
  (binding [impl/*library* migration-default-library]
    (emit-script-join ["import"] ["deps"] "body"))
  =>
  "import\n\ndeps\n\nbody")

^{:refer lang.core.impl/emit-script, :added "4.0"}
(fact
  "emits a script with all dependencies"
  (binding [impl/*library* migration-default-library]
    (emit-script
      '(-/add-fn 1 2)
      {:lang :lua,
       :library +library-ext+,
       :module (lib/get-module +library-ext+ :lua 'L.util),
       :layout :flat}))
  =>
  (str/join
    "\n"
    ["function identity_fn(x){"
     "  return x;"
     "}"
     ""
     "function add_fn(a,b){"
     "  return identity_fn(function (x,y){"
     "    return x + y;"
     "  })(a,sub_fn(b,0));"
     "}"
     ""
     "function sub_fn(a,b){"
     "  return identity_fn(function (x,y){"
     "    return x - y;"
     "  })(a,b);"
     "}"
     ""
     "add_fn(1,2)"])
  (binding [impl/*library* migration-default-library]
    (emit-script
      '(-/add-fn 1 2)
      {:lang :lua,
       :library +library-ext+,
       :module (lib/get-module +library-ext+ :lua 'L.util),
       :layout :full}))
  =>
  (str/join
    "\n"
    ["function L_core____identity_fn(x){"
     "  return x;"
     "}"
     ""
     "function L_util____add_fn(a,b){"
     "  return L_core____identity_fn(function (x,y){"
     "    return x + y;"
     "  })(a,L_util____sub_fn(b,0));"
     "}"
     ""
     "function L_util____sub_fn(a,b){"
     "  return L_core____identity_fn(function (x,y){"
     "    return x - y;"
     "  })(a,b);"
     "}"
     ""
     "L_util____add_fn(1,2)"]))

