^{:refer lang.core.impl/*library* :id native-impl-library-binding}
(fact "library binding controls lookup and restores across nested failure"
  (let [baseline impl/*library*
        selected (binding [impl/*library* +library+]
                   [(= +library+ (impl/default-library))
                    (= +library+ (impl/runtime-library))
                    (= +library-ext+ (impl/default-library +library-ext+))
                    (try
                      (binding [impl/*library* +library-ext+]
                        (throw (ex :argument {} :ex/message "binding probe")))
                      (catch error (= +library+ impl/*library*)))])]
    [baseline selected (= baseline impl/*library*)])
  => [nil [true true true true] true])

^{:refer lang.core.impl/*print-form* :id native-impl-print-form}
(fact "print control captures the original form without changing emitted output"
  (let [baseline impl/*print-form*
        output (atom nil)]
    (try
      (let [quiet (binding [impl/*print-form* false]
                    (with-out-string
                      (reset! output (impl/emit-direct (:grammar prep/+book-min+)
                                      '(+ 1 2 3) (ns-current) {:lang :lua}))))
            quiet-result @output
            verbose (binding [impl/*print-form* true]
                      (with-out-string
                        (reset! output (impl/emit-direct (:grammar prep/+book-min+)
                                        '(+ 1 2 3) (ns-current) {:lang :lua}))))]
        [baseline quiet quiet-result verbose @output (= baseline impl/*print-form*)])
      (finally (reset! output nil))))
  => [nil "" "1 + 2 + 3" ":FORM (+ 1 2 3)\n" "1 + 2 + 3" true])

^{:refer lang.core.impl/emit-options-raw :id native-impl-options-raw}
(fact "snapshot takes precedence then explicit Library then bound runtime Library"
  (let [snapshot (lib/get-snapshot +library+)
        [provided provided-book] (impl/emit-options-raw +library-ext+ snapshot :lua)
        [explicit explicit-book] (binding [impl/*library* +library-ext+]
                                   (impl/emit-options-raw +library+ nil :lua))
        [runtime runtime-book] (binding [impl/*library* +library-ext+]
                                 (impl/emit-options-raw nil nil :lua))]
    [(= snapshot provided) (vec (sort (keys (:modules provided-book))))
     (= snapshot explicit) (vec (sort (keys (:modules explicit-book))))
     (= (lib/get-snapshot +library-ext+) runtime) (vec (sort (keys (:modules runtime-book))))
     (= [snapshot nil] (impl/emit-options-raw nil snapshot :missing))])
  => [true ['L.core] true ['L.core] true ['L.core 'L.util] true])

^{:refer lang.core.impl/emit-bulk? :id native-impl-bulk-shape}
(fact "bulk requires a vector with truthy bulk metadata"
  (mapv impl/emit-bulk?
        [nil [] [1] (with-meta [1] {:bulk true}) (with-meta [] {:bulk true})
         (with-meta [1] {:bulk false}) (with-meta [1] {:bulk nil})
         (with-meta [1] {:bulk :enabled}) (with-meta '(1) {:bulk true})
         (with-meta {:a 1} {:bulk true})])
  => [false false false true true false false true false false])

(require [std.lib.context.resource :as resource]
         [std.lib.context.space :as space])

^{:refer lang.core.impl/emit-options :id native-original-emission-context}
(fact "retains the selected module and emission options without mutating the caller input"
  (let [input {:lang :lua :library +library+ :module 'L.core
               :layout :flat :emit {:code {:label true}}}
        [stage grammar selected namespace options] (impl/emit-options input)]
    [stage (:lang selected) (:id (:module options))
     (Base/identical? grammar (:grammar selected))
     (:layout options) (:emit options) (:module input)])
  => [:staging :lua 'L.core true :flat {:code {:label true}} 'L.core])

^{:refer lang.core.impl/emit-script-imports :id native-empty-script-imports}
(fact "emits no import source for an empty native dependency selection"
  (vec (impl/emit-script-imports
         {} {} (impl/emit-options {:lang :lua :library +library+ :module 'L.core})))
  => [])

^{:refer lang.core.impl/emit-script-join :id native-blank-line-boundaries}
(fact "retains the native script join contract including empty sections"
  [(impl/emit-script-join ["IMPORT"] ["DEPENDENCY"] "BODY")
   (impl/emit-script-join [] [] "BODY")
   (impl/emit-script-join [] [] "")]
  => ["IMPORT\n\nDEPENDENCY\n\nBODY" "BODY" ""])

^{:refer lang.core.impl/clone-default-library :id native-effective-snapshot-clone}
(fact "clones inherited source without retaining a parent or sharing later mutations"
  (let [parent (lib/library:create {:snapshot (snap/snapshot {:lua {:id :lua :book prep/+book-min+}})})
        child (lib/library:create {:parent parent})
        created (atom [parent child])]
    (try
      (lib/install-module! parent :lua 'parent.only {})
      (let [clone (impl/with:library [child] (impl/clone-default-library))]
        (swap! created conj clone)
        (lib/install-module! parent :lua 'parent.later {})
        (lib/install-module! clone :lua 'clone.only {})
        [(:parent clone)
         (set (lib/list-modules clone :lua))
         (lib/get-module clone :lua 'parent.later)
         (lib/get-module parent :lua 'clone.only)])
      (finally
        (doseq [library @created]
          (lib/reset-all! library)
          (reset! (:settings library) {}))
        (reset! created []))))
  => [nil #{'L.core 'parent.only 'clone.only} nil nil])

^{:refer lang.core.impl/default-library :id native-process-default-library}
(fact "returns one resource-owned default and gives an explicit override priority"
  (binding [resource/*resource-active* (atom {:global {} :namespace {} :shared {}})
            impl/*library* nil]
    (let [override (lib/library:create {})]
      (try
        (let [first (impl/default-library)
              second (impl/default-library)]
          [(Base/identical? first second)
           (into {} (lib/get-snapshot first))
           (Base/identical? override (impl/default-library override))])
        (finally
          (impl/default-library:reset)
          (lib/reset-all! override)
          (reset! (:settings override) {})
          (reset! resource/*resource-active* {:global {} :namespace {} :shared {}})))))
  => [true {} true])

^{:refer lang.core.impl/default-library:reset :id native-default-reset-boundary}
(fact "resets the resource idempotently and recreates a blank default without mutating an existing reference"
  (binding [resource/*resource-active* (atom {:global {} :namespace {} :shared {}})
            impl/*library* nil]
    (let [original (impl/default-library)]
      (try
        (lib/install-book! original prep/+book-min+)
        (let [stopped (impl/default-library:reset)
              absent (impl/default-library:reset)
              replacement (impl/default-library)]
          [(Base/identical? original stopped) absent
           (not (Base/identical? original replacement))
           (into {} (lib/get-snapshot replacement))
           (set (keys (lib/get-snapshot original)))])
        (finally
          (impl/default-library:reset)
          (lib/reset-all! original)
          (reset! (:settings original) {})
          (reset! resource/*resource-active* {:global {} :namespace {} :shared {}})))))
  => [true nil true {} #{:lua}])

^{:refer lang.core.impl/runtime-library :id native-default-annex-library-precedence}
(fact "uses the process default unless an annex Library or explicit binding takes precedence"
  (binding [resource/*resource-active* (atom {:global {} :namespace {} :shared {}})
            space/*spaces* (atom {})
            impl/*library* nil]
    (let [annex (lib/library:create {})
          bound (lib/library:create {})
          current (space/space)]
      (try
        (let [default (impl/default-library)
              fallback (Base/identical? default (impl/runtime-library))]
          (swap! (:state current) assoc :lang.annex {:instance {:library annex}})
          [fallback
           (Base/identical? annex (impl/runtime-library))
           (impl/with:library [bound] (Base/identical? bound (impl/runtime-library)))])
        (finally
          (reset! (:state current) {})
          (space/reset-spaces!)
          (impl/default-library:reset)
          (doseq [library [annex bound]]
            (lib/reset-all! library)
            (reset! (:settings library) {}))
          (reset! resource/*resource-active* {:global {} :namespace {} :shared {}})))))
  => [true true true])

^{:refer lang.core.impl/with:library :id native-library-binding-restoration}
(fact "restores the outer Library after a normal return and an exceptional exit"
  (let [outer (lib/library:create {})
        inner (lib/library:create {})]
    (try
      (binding [impl/*library* outer]
        [(impl/with:library [inner] (Base/identical? inner (impl/runtime-library)))
         (Base/identical? outer (impl/runtime-library))
         (try
           (impl/with:library [inner] (throw (ex :test {})))
           :missed-error
           (catch error :caught))
         (Base/identical? outer (impl/runtime-library))])
      (finally
        (doseq [library [outer inner]]
          (lib/reset-all! library)
          (reset! (:settings library) {})))))
  => [true true :caught true])
