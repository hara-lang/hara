(ns lang.core.rewrite.walk-test
  (:use code.test)
  (:require [lang.core.rewrite.walk :as walk]))

^{:refer lang.core.rewrite.walk/rewrite-coll :added "4.0"}
(fact "applies the item rewrite to every collection member"
  (walk/rewrite-coll [1 2 3] inc)
  => '(2 3 4))

^{:refer lang.core.rewrite.walk/rewrite-map-entry :added "4.0"}
(fact "rewrites both a map entry key and value"
  (walk/rewrite-map-entry
   [:a 1]
   (fn [value]
     (cond (keyword? value) (name value)
           (number? value) (inc value)
           :else value)))
  => ["a" 2])

^{:refer lang.core.rewrite.walk/rewrite-map :added "4.0"}
(fact "rewrites map keys and values while preserving the map representation"
  (let [source (hash-map :a 1 :b 2)
        output (walk/rewrite-map
                source
                (fn [value]
                  (cond (keyword? value) (name value)
                        (number? value) (inc value)
                        :else value)))]
    [output (= (type source) (type (walk/rewrite-map source identity)))])
  => [{"a" 2 "b" 3} true])

^{:refer lang.core.rewrite.walk/rewrite-vector :added "4.0"}
(fact "rewrites vector elements and preserves metadata"
  (let [source (with-meta [1 2 3] {:line 5})]
    [(walk/rewrite-vector source inc)
     (meta (walk/rewrite-vector source inc))])
  => [[2 3 4] {:line 5}])

^{:refer lang.core.rewrite.walk/rewrite-set :added "4.0"}
(fact "rewrites set elements and preserves metadata"
  (let [source (with-meta #{1 2 3} {:line 5})]
    [(walk/rewrite-set source inc)
     (meta (walk/rewrite-set source inc))])
  => [#{2 3 4} {:line 5}])

^{:refer lang.core.rewrite.walk/rewrite-map-form :added "4.0"}
(fact "rewrites map entries and preserves metadata"
  (let [source (with-meta {:a 1} {:line 5})]
    [(walk/rewrite-map-form
      source
      (fn [value]
        (cond (keyword? value) (name value)
              (number? value) (inc value)
              :else value)))
     (meta (walk/rewrite-map-form source identity))])
  => [{"a" 2} {:line 5}])

^{:refer lang.core.rewrite.walk/rewrite-form :added "4.1"}
(fact "rewrites vectors, sets, and maps while preserving their metadata"
  (let [vector-form (with-meta ['a 1] {:line 10})
        set-form    (with-meta '#{a 1} {:line 11})
        map-form    (with-meta '{a 1} {:line 12})
        rewrite-item (fn [value]
                       (if (symbol? value) 'b value))
        vector-out (walk/rewrite-form vector-form identity rewrite-item)
        set-out    (walk/rewrite-form set-form identity rewrite-item)
        map-out    (walk/rewrite-form map-form identity rewrite-item)]
    [(= vector-out '[b 1])
     (= set-out '#{b 1})
     (= map-out '{b 1})
     (= (meta vector-out) {:line 10})
     (= (meta set-out) {:line 11})
     (= (meta map-out) {:line 12})])
  => [true true true true true true])

^{:refer lang.core.rewrite.walk/rewrite-binding-vector :added "4.1"}
(fact "rewrites only the rhs of a binding vector"
  (walk/rewrite-binding-vector
   '[a (+ 1 2) :meta]
   (fn [form]
     (if (list? form)
       '(+ 2 3)
       form)))
  => '[a (+ 2 3) :meta])
