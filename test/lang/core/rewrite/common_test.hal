(ns lang.core.rewrite.common-test
  (:use code.test)
  (:require [lang.core.rewrite.common :refer :all]))

^{:refer lang.core.rewrite.common/with-form-meta :added "4.1"}
(fact "copies metadata from source to out when out is an IObj"
  (with-form-meta (with-meta [1 2 3] {:hello true}) [4 5 6])
  => [4 5 6]

  (meta (with-form-meta (with-meta [1 2 3] {:hello true}) [4 5 6]))
  => {:hello true})

^{:refer lang.core.rewrite.common/with-form-meta :added "4.1"
  :id test-with-form-meta-non-iobj}
(fact "returns out unchanged when out is not an IObj"
  (with-form-meta (with-meta [] {:hello true}) "world")
  => "world"

  (with-form-meta (with-meta [] {:hello true}) 42)
  => 42

  (with-form-meta (with-meta [] {:hello true}) :keyword)
  => :keyword)



^{:refer lang.core.rewrite.common/with-form-meta :added "4.1" :id native-with-form-meta}
(fact "copies metadata from source to supported metadata-bearing output"
  (lang.core.rewrite.common/with-form-meta (with-meta [1 2 3] {:hello true}) [4 5 6])
  => [4 5 6]

  (meta (lang.core.rewrite.common/with-form-meta (with-meta [1 2 3] {:hello true}) [4 5 6]))
  => {:hello true})

^{:refer lang.core.rewrite.common/with-form-meta :added "4.1"
  :id native-with-form-meta-non-iobj}
(fact "returns scalar output unchanged"
  (lang.core.rewrite.common/with-form-meta (with-meta [] {:hello true}) "world")
  => "world"

  (lang.core.rewrite.common/with-form-meta (with-meta [] {:hello true}) 42)
  => 42

  (lang.core.rewrite.common/with-form-meta (with-meta [] {:hello true}) :keyword)
  => :keyword)

^{:refer lang.core.rewrite.common/stable-symbol :added "4.1"}
(fact "derives a deterministic symbol from the source form and its location"
  (let [source (with-meta 'entry {:file "fixture.hal" :line 7 :column 3})
        same   (with-meta 'entry {:file "fixture.hal" :line 7 :column 3})
        moved  (with-meta 'entry {:file "fixture.hal" :line 8 :column 3})]
    [(= (lang.core.rewrite.common/stable-symbol "tmp-" source)
        (lang.core.rewrite.common/stable-symbol "tmp-" same))
     (not= (lang.core.rewrite.common/stable-symbol "tmp-" source)
           (lang.core.rewrite.common/stable-symbol "tmp-" moved))])
  => [true true])

^{:refer lang.core.rewrite.common/with-form-meta :id symbol-metadata-fidelity}
(fact "copies symbol metadata and replaces rather than merges destination metadata"
  (let [source (with-meta [] {:line 7 :column 3})
        out (with-meta 'item {:stale true})
        result (with-form-meta source out)]
    [result (meta result) (meta out)])
  => ['item {:line 7 :column 3} {:stale true}]

  (meta (with-form-meta [] (with-meta 'item {:stale true})))
  => nil

  (with-form-meta (with-meta [] {:line 7}) nil)
  => nil)

^{:refer lang.core.rewrite.common/stable-symbol :id stable-symbol-boundaries}
(fact "names metadata-free forms deterministically and ignores unrelated metadata"
  [(stable-symbol "tmp-" 'entry)
   (stable-symbol "tmp-" (with-meta 'entry {}))
   (stable-symbol "tmp-" (with-meta 'entry {:ignored true}))
   (stable-symbol "alt-" 'entry)
   (stable-symbol "tmp-" (with-meta 'entry {:file "fixture.hal" :line 7 :column 3}))]
  => ['tmp-1039927559 'tmp-1039927559 'tmp-1039927559
      'alt-1039927559 'tmp-1688918605])
