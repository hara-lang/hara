(ns lang.core.rewrite.hoist-test
  (:require [lang.core.rewrite.hoist :as subject]))

^{:refer lang.core.rewrite.hoist/create-rewriter}
(Test/check
 [{:name "preserves a direct return operand from a rest-destructured form"
   :test (fn []
           (let [rewriter (subject/create-rewriter {})]
             ((:rewrite-statement rewriter)
              '(return (x:str-char s i))
              {})))
   :expected '(return (x:str-char s i))}
  {:name "preserves an assignment right-hand side from a rest-destructured form"
   :test (fn []
           (let [rewriter (subject/create-rewriter {})]
             ((:rewrite-statement rewriter)
              '(:= clean-name (x:str-replace source token replacement))
              {})))
   :expected '(:= clean-name (x:str-replace source token replacement))}])
