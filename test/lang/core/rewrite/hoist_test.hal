(ns lang.core.rewrite.hoist-test (:require [lang.base.emit-helper :as helper] [lang.base.grammar :as grammar] [lang.core.rewrite.hoist :as hoist]) (:use code.test) (:config {:role :internal}))

(def +grammar+
 (grammar/grammar
   :test
   (grammar/to-reserved (grammar/build))
   helper/+default+))

(def +rewriter+
 (hoist/create-rewriter
   {:fn-tags #{'fn.inner 'fn}, :symbol-prefix "test_callback__"}))

^{:refer lang.core.rewrite.hoist/create-rewriter, :added "4.1"}
(fact
  "shares the prefix-hoisting rewrite logic"
  ((:rewrite-stage +rewriter+)
    '(var
       f
       (xtd/memoize-key
         (fn f-raw [x]
           (xtd/set-pair-step
             state
             "n"
             (+ 1 (xt/x:get-key state "n" 0)))
           (return (* x 10)))))
    nil)
  =>
  '(do*
     (var
       f-raw
       (fn [x]
         (do
           (xtd/set-pair-step
             state
             "n"
             (+ 1 (xt/x:get-key state "n" 0)))
           (return (* x 10)))))
     (var f (xtd/memoize-key f-raw)))
  ((:rewrite-stage +rewriter+)
    (with-meta
      '[(var state {"n" 0})
        (var
          f
          (xtd/memoize-key
            (fn f-raw [x]
              (xtd/set-pair-step
                state
                "n"
                (+ 1 (xt/x:get-key state "n" 0)))
              (return (* x 10)))))
        [(f 2) (f 2) (f 3) (xt/x:get-key state "n")]]
      {:bulk true})
    {:mopts {:emit {}}})
  =>
  '(do*
     (var state {"n" 0})
     (var
       f-raw
       (fn [x]
         (do
           (xtd/set-pair-step
             state
             "n"
             (+ 1 (xt/x:get-key state "n" 0)))
           (return (* x 10)))))
     (var f (xtd/memoize-key f-raw))
     [(f 2) (f 2) (f 3) (xt/x:get-key state "n")])
  (let [out ((:rewrite-stage +rewriter+)
              '(var
                 f
                 (xtd/arr-keep
                   [1 2 3 4]
                   (fn [x]
                     (if (== 0 (mod x 2))
                       (return (* x 10))
                       (return nil)))))
              {:grammar +grammar+})
        [_ binding assign] out
        callback (second binding)]
    [(= 'do* (first out))
     (= 'var (first binding))
     (symbol? callback)
     (=
       '(fn [x] (if (== 0 (mod x 2)) (return (* x 10)) (return nil)))
       (nth binding 2))
     (=
       '(var f (xtd/arr-keep [1 2 3 4] CALLBACK))
       (prewalk-replace {callback 'CALLBACK} assign))])
  =>
  [true true true true true])


^{:refer lang.core.rewrite.hoist/create-rewriter :id hoist-quote-skip-boundaries}
(fact "preserves quoted and skipped forms without allocating callback symbols"
  (let [calls (atom [])
        rewriter (hoist/create-rewriter
                   {:symbol-fn (fn [form] (swap! calls conj form) 'generated)
                    :skip-form? (fn [form] (= 'opaque (first form)))})
        rewrite (:rewrite-expression rewriter)
        quoted '(quote (fn named [x] x))
        skipped '(opaque (fn named [x] x))]
    [(rewrite quoted {}) (rewrite skipped {}) (rewrite 42 {}) (deref calls)])
  => [[[] '(quote (fn named [x] x))] [[] '(opaque (fn named [x] x))] [[] 42] []])

^{:refer lang.core.rewrite.hoist/create-rewriter :id hoist-map-prefix-order}
(fact "hoists map keys before values and preserves the output map metadata"
  (let [rewriter (hoist/create-rewriter {})
        input (with-meta (hash-map '(fn key-fn [x] x) '(fn value-fn [y] y)) {:line 21})
        [prefix output] ((:rewrite-expression rewriter) input {})]
    [prefix output (meta output)])
  => ['[(var key-fn (fn [x] x)) (var value-fn (fn [y] y))]
      '{key-fn value-fn} {:line 21}])

^{:refer lang.core.rewrite.hoist/create-rewriter :id hoist-bulk-transform-boundary}
(fact "flattens bulk prefixes only when no body transform is configured"
  (let [rewriter (hoist/create-rewriter {})
        input (with-meta '[(call (fn named [x] x))] {:bulk true})
        flat ((:rewrite-stage rewriter) input {:mopts {:emit {}}})
        retained ((:rewrite-stage rewriter) input {:mopts {:emit {:body {:transform identity}}}})]
    [flat (meta flat) retained (meta retained)])
  => ['(do* (var named (fn [x] x)) (call named)) {:bulk true}
      '[(do* (var named (fn [x] x)) (call named))] {:bulk true}])

^{:refer lang.core.rewrite.hoist/create-rewriter :id hoist-retained-native-operands}
(fact "preserves existing direct return and assignment operand regressions"
  ((:rewrite-statement (hoist/create-rewriter {}))
   '(return (x:str-char s i)) {})
  => '(return (x:str-char s i))
  ((:rewrite-statement (hoist/create-rewriter {}))
   '(:= clean-name (x:str-replace source token replacement)) {})
  => '(:= clean-name (x:str-replace source token replacement)))

^{:refer lang.core.rewrite.hoist/create-rewriter :id hoist-sequence-function}
(fact "hoists a sequence-backed named function with its arguments and body intact"
  (let [rewriter (hoist/create-rewriter {})]
    ((:rewrite-expression rewriter) (seq '[fn named [x] x]) {}))
  => ['[(var named (fn [x] x))] 'named])
