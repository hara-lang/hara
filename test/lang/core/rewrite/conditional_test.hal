(ns lang.core.rewrite.conditional-test
  (:use code.test)
  (:require [lang.core.rewrite.conditional :as subject]))

^{:refer lang.core.rewrite.conditional/rewrite-conditional-expression-list}
(fact "rewrites shared conditional-expression skeletons"
  [(subject/rewrite-conditional-expression-list
    '(or a b) identity #(list 'test %) #(list 'expr %))
   (subject/rewrite-conditional-expression-list
    '(:? a b c) identity #(list 'test %) #(list 'expr %))
   (subject/rewrite-conditional-expression-list
    '((f x) a) identity #(list 'test %) #(list 'expr %))]
  => ['(or (test a) (test b))
      '(:? (test a) (expr b) (expr c))
      '((expr (f x)) (expr a))])

^{:refer lang.core.rewrite.conditional/rewrite-conditional-expression}
(fact "rewrites a form and wraps it for truthiness checks"
  (letfn [(rewrite-conditional [form]
            (subject/rewrite-conditional-expression
             form
             #(subject/rewrite-conditional-expression-list
               % identity rewrite-conditional (fn [value] (list 'expr value)))
             #(list 'expr %)
             (fn [source value] (list 'truthy source value))))]
    [(rewrite-conditional 'a)
     (rewrite-conditional '(or a b))
     (rewrite-conditional '(not a))
     (rewrite-conditional '(:? a b c))
     (rewrite-conditional '(f a))])
  => ['(truthy a a)
      '(truthy (or a b) (or (truthy a a) (truthy b b)))
      '(truthy (not a) (not (truthy a a)))
      '(truthy (:? a b c) (:? (truthy a a) (expr b) (expr c)))
      '(truthy (f a) (f (expr a)))])
