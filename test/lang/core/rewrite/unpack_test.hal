(ns lang.core.rewrite.unpack-test (:use code.test) (:require [lang.core.rewrite.unpack :as unpack]) (:config {:role :internal}))

^{:refer lang.core.rewrite.unpack/unpack-form?, :added "4.0"}
(fact
  "checks whether a form is an unpacking expression"
  [(unpack/unpack-form? '(x:unpack xs))
   (unpack/unpack-form? '(x:unpack))
   (unpack/unpack-form? '(x:unpack xs ys))
   (unpack/unpack-form? '(call xs))
   (unpack/unpack-form? 'x:unpack)
   (unpack/unpack-form? nil)
   (unpack/unpack-form? (vector 'x:unpack 'xs))]
  =>
  [true false false false false false false])

^{:refer lang.core.rewrite.unpack/any-unpack? :added "4.0"}
(fact "checks whether any argument is an unpacking expression"
  [(unpack/any-unpack? '((x:unpack xs) y))
   (unpack/any-unpack? '((x:unpack a) (x:unpack b)))
   (unpack/any-unpack? '(x y))
   (unpack/any-unpack? '())]
  => [true true false false])

^{:refer lang.core.rewrite.unpack/rewrite-arg :added "4.0"}
(fact "rewrites a single argument, dispatching on unpacking forms"
  [(unpack/rewrite-arg '(x:unpack xs)
                       (fn [migration-argument-0] (list (quote expr) migration-argument-0))
                       identity
                       (fn [migration-argument-0] (list (quote spread) migration-argument-0)))
   (unpack/rewrite-arg 'y
                       (fn [migration-argument-0] (list (quote expr) migration-argument-0))
                       identity
                       (fn [migration-argument-0] (list (quote spread) migration-argument-0)))
   (unpack/rewrite-arg 'y
                       (fn [migration-argument-0] (list (quote expr) migration-argument-0))
                       (fn [migration-argument-0] (list (quote scalar) migration-argument-0))
                       (fn [migration-argument-0] (list (quote spread) migration-argument-0)))]
  => '[(spread (expr xs))
       (expr y)
       (scalar (expr y))])

^{:refer lang.core.rewrite.unpack/rewrite-args :added "4.1"}
(fact "detects and rewrites unpack args with injected wrappers"
  [(unpack/unpack-form? '(x:unpack xs))
   (unpack/unpack-form? '(call xs))
   (unpack/any-unpack? '((x:unpack xs) y))
   (unpack/any-unpack? '(x y))
   (vec (unpack/rewrite-args '((x:unpack xs) y)
                             (fn [migration-argument-0] (list (quote expr) migration-argument-0))
                             identity
                             (fn [migration-argument-0] (list (quote spread) migration-argument-0))))
   (vec (unpack/rewrite-args '((x:unpack xs) y)
                             (fn [migration-argument-0] (list (quote expr) migration-argument-0))
                             (fn [migration-argument-0] (list (quote scalar) migration-argument-0))
                             (fn [migration-argument-0] (list (quote seq) migration-argument-0))))]
  => [true
      false
      true
      false
      '[(spread (expr xs))
        (expr y)]
      '[(seq (expr xs))
        (scalar (expr y))]])

^{:refer lang.core.rewrite.unpack/unpack-form? :id unpack-native-shapes}
(fact "preserves native exact-arity checks and distinguishes vectors from sequence calls"
  [(unpack/unpack-form? '(x:unpack xs))
   (unpack/unpack-form? '(x:unpack))
   (unpack/unpack-form? '(x:unpack xs ys))
   (unpack/unpack-form? '(call xs))
   (unpack/unpack-form? (vector 'x:unpack 'xs))
   (unpack/unpack-form? (seq (vector 'x:unpack 'xs)))
   (unpack/unpack-form? '(x:unpack nil))]
  => [true false false false false true true])

^{:refer lang.core.rewrite.unpack/any-unpack? :id unpack-native-any}
(fact "preserves native argument detection including nil and sequence-backed inputs"
  [(unpack/any-unpack? '((x:unpack xs) value))
   (unpack/any-unpack? '(value other))
   (unpack/any-unpack? '())
   (unpack/any-unpack? nil)
   (unpack/any-unpack? (seq (vector 'value (list 'x:unpack 'xs))))]
  => [true false false false true])

^{:refer lang.core.rewrite.unpack/rewrite-arg :id unpack-native-dispatch}
(fact "preserves native wrappers and propagates expression failures before wrapping"
  [(unpack/rewrite-arg '(x:unpack xs) (fn [x] (list 'expr x)) identity
                       (fn [x] (list 'spread x)))
   (unpack/rewrite-arg 'value (fn [x] (list 'expr x))
                       (fn [x] (list 'scalar x)) (fn [x] (list 'spread x)))
   (let [calls (atom [])
         result (try
                  (unpack/rewrite-arg '(x:unpack xs)
                    (fn [x] (swap! calls conj [:expr x])
                      (throw (ex :argument {:probe :expression-failed})))
                    (fn [x] (swap! calls conj [:scalar x]))
                    (fn [x] (swap! calls conj [:spread x])))
                  :unexpected
                  (catch error (:probe (ex-data error))))]
     [result (deref calls)])]
  => ['(spread (expr xs)) '(scalar (expr value))
      [:expression-failed '[[:expr xs]]]])

^{:refer lang.core.rewrite.unpack/rewrite-args :id unpack-native-order}
(fact "preserves native outputs and callback order across reusable results and empty input"
  (let [calls (atom [])
        result (unpack/rewrite-args '((x:unpack xs) value)
                 (fn [x] (swap! calls conj [:expr x]) (list 'expr x))
                 (fn [x] (swap! calls conj [:scalar x]) (list 'scalar x))
                 (fn [x] (swap! calls conj [:spread x]) (list 'spread x)))]
    [(vec result) (vec result) (deref calls)
     (vec (unpack/rewrite-args nil identity identity identity))])
  => ['[(spread (expr xs)) (scalar (expr value))]
      '[(spread (expr xs)) (scalar (expr value))]
      '[[:expr xs] [:spread (expr xs)] [:expr value] [:scalar (expr value)]]
      []])
