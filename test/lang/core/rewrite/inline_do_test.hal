(ns lang.core.rewrite.inline-do-test (:use code.test) (:require [lang.core.rewrite.inline-do :as inline]) (:config {:role :internal}))

^{:refer lang.core.rewrite.inline-do/do-expression? :added "4.0"}
(fact "returns true for do and do* list forms"
  (inline/do-expression? '(do 1 2))
  => true)

^{:refer lang.core.rewrite.inline-do/do-expression? :added "4.0"
  :id test-do-expression-star}
(fact "returns true for do* forms"
  (inline/do-expression? '(do* 1 2))
  => true)

^{:refer lang.core.rewrite.inline-do/do-expression? :added "4.0"
  :id test-do-expression-non-do}
(fact "returns false for non-do forms"
  (inline/do-expression? '(if 1 2 3))
  => false)

^{:refer lang.core.rewrite.inline-do/do-expression? :added "4.0"
  :id test-do-expression-non-list}
(fact "returns false for vectors and symbols"
  (inline/do-expression? '[do 1 2])
  => false

  (inline/do-expression? 'do)
  => false)

^{:refer lang.core.rewrite.inline-do/rewrite-inline-do-list :added "4.0"}
(fact "rewrites a return wrapping a do expression"
  (inline/rewrite-inline-do-list '(return (do (step 1) 2)))
  => '(do* (step 1) (return 2)))

^{:refer lang.core.rewrite.inline-do/rewrite-inline-do-list :added "4.0"
  :id test-rewrite-inline-do-list-star}
(fact "rewrites a return wrapping a do* expression"
  (inline/rewrite-inline-do-list '(return (do* (step 1) 2)))
  => '(do* (step 1) (return 2)))

^{:refer lang.core.rewrite.inline-do/rewrite-inline-do-list :added "4.0"
  :id test-rewrite-inline-do-list-unchanged}
(fact "leaves plain do and non-return forms unchanged"
  (inline/rewrite-inline-do-list '(do (step 1) 2))
  => '(do (step 1) 2)

  (inline/rewrite-inline-do-list '(foo 1 2))
  => '(foo 1 2))

^{:refer lang.core.rewrite.inline-do/rewrite-inline-do-list :added "4.0"
  :id test-rewrite-inline-do-list-nested}
(fact "recursively rewrites nested return-do forms"
  (inline/rewrite-inline-do-list '(foo (return (do a b))))
  => '(foo (do* a (return b))))

^{:refer lang.core.rewrite.inline-do/rewrite-inline-do :added "4.1"}
(fact "rewrites inline do-return forms while preserving quoted forms"
  (inline/rewrite-inline-do
   '[(return (do (step 1) 2))
     (quote (return (do (step 3) 4)))])
  => '[(do* (step 1) (return 2))
       (quote (return (do (step 3) 4)))])

^{:refer lang.core.rewrite.inline-do/rewrite-inline-do :added "4.0"
  :id test-rewrite-inline-do-nested-collections}
(fact "recursively rewrites forms inside nested collections"
  (inline/rewrite-inline-do
   '{:body (return (do (step 1) 2))})
  => '{:body (do* (step 1) (return 2))})


^{:refer lang.core.rewrite.inline-do/with-form-meta :id inline-meta-alias}
(fact "copies source metadata to collection results and leaves scalars unchanged"
  (let [source (with-meta '(source) {:line 7})
        output (inline/with-form-meta source '[a b])]
    [output (meta output) (inline/with-form-meta source 42)
     (inline/with-form-meta source nil)])
  => ['[a b] {:line 7} 42 nil])

^{:refer lang.core.rewrite.inline-do/do-expression? :id inline-form-boundaries}
(fact "recognizes sequence-backed do forms without treating data collections as calls"
  (mapv inline/do-expression?
        [nil '() (seq '[do 1]) (seq '[do* 1]) '[do 1] #{'do} 'do])
  => [false false true true false false false])

^{:refer lang.core.rewrite.inline-do/rewrite-inline-do-list :id inline-return-boundaries}
(fact "preserves return arity and metadata while handling empty and single-value bodies"
  [(inline/rewrite-inline-do-list '(return (do)))
   (inline/rewrite-inline-do-list '(return (do false)))
   (inline/rewrite-inline-do-list '(return (do a b) extra))
   (inline/rewrite-inline-do-list '(return))
   (let [output (inline/rewrite-inline-do-list
                  (with-meta '(return (do a b)) {:line 8}))]
     [output (meta output) (meta (last output))])]
  => ['(do* (return nil)) '(do* (return false))
      '(return (do a b) extra) '(return)
      ['(do* a (return b)) {:line 8} {:line 8}]])

^{:refer lang.core.rewrite.inline-do/rewrite-inline-do :id inline-nested-idempotence}
(fact "rewrites map keys and set values, retains metadata and quotes, and is idempotent"
  (let [input (with-meta
                (hash-map '(return (do a b))
                          #{'(return (do c d)) '(quote (return (do e f)))})
                {:line 9})
        output (inline/rewrite-inline-do input)]
    [output (meta output)
     (= output (inline/rewrite-inline-do output))
     (inline/rewrite-inline-do nil)])
  => ['{(do* a (return b)) #{(do* c (return d)) (quote (return (do e f)))}}
      {:line 9} true nil])
