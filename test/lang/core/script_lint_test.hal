(ns lang.core.script-lint-test (:require [code.test :refer [fact]] [lang.core.script-lint :as lint]))
^{:refer lang.core.script-lint/collect-sym-vars :id lint-symbol-0}
(fact "pinned symbol analysis case 0" (let [previous lint/get-reserved previous-meta (meta (var lint/get-reserved)) cache-before (deref lint/+collect-module-globals)] (try (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) (constantly (quote #{do return +}))) (lint/collect-sym-vars (quote {:form (defn foo [x] x), :lang :lua, :op-key :defn}) {:native {}, :static {}}) (finally (reset! lint/+collect-module-globals cache-before) (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) previous)))) => (quote {:vars #{x}, :syms #{x}}))
^{:refer lang.core.script-lint/collect-sym-vars :id lint-symbol-1}
(fact "pinned symbol analysis case 1" (let [previous lint/get-reserved previous-meta (meta (var lint/get-reserved)) cache-before (deref lint/+collect-module-globals)] (try (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) (constantly (quote #{do return +}))) (lint/collect-sym-vars (quote {:form (defn f [x unused] (var y x) (+ y missing)), :lang :lua, :op-key :defn}) {:native {}, :static {}}) (finally (reset! lint/+collect-module-globals cache-before) (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) previous)))) => (quote {:vars #{x y unused}, :syms #{missing x y}}))
^{:refer lang.core.script-lint/collect-sym-vars :id lint-symbol-2}
(fact "pinned symbol analysis case 2" (let [previous lint/get-reserved previous-meta (meta (var lint/get-reserved)) cache-before (deref lint/+collect-module-globals)] (try (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) (constantly (quote #{do return +}))) (lint/collect-sym-vars (quote {:form (defglobal v (+ alpha.beta foreign/value x:thing ...rest)), :lang :lua, :op-key :defglobal}) {:native {}, :static {}}) (finally (reset! lint/+collect-module-globals cache-before) (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) previous)))) => (quote {:vars #{}, :syms #{alpha}}))
^{:refer lang.core.script-lint/collect-sym-vars :id lint-symbol-3}
(fact "pinned symbol analysis case 3" (let [previous lint/get-reserved previous-meta (meta (var lint/get-reserved)) cache-before (deref lint/+collect-module-globals)] (try (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) (constantly (quote #{do return +}))) (lint/collect-sym-vars (quote {:form (defn f [] (let [a input b a] (+ b outside))), :lang :lua, :op-key :defn}) {:native {}, :static {}}) (finally (reset! lint/+collect-module-globals cache-before) (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) previous)))) => (quote {:vars #{a b}, :syms #{input outside a b}}))
^{:refer lang.core.script-lint/collect-sym-vars :id lint-symbol-4}
(fact "pinned symbol analysis case 4" (let [previous lint/get-reserved previous-meta (meta (var lint/get-reserved)) cache-before (deref lint/+collect-module-globals)] (try (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) (constantly (quote #{do return +}))) (lint/collect-sym-vars (quote {:form (defn f [] (. object (method arg) field)), :lang :lua, :op-key :defn}) {:native {}, :static {}}) (finally (reset! lint/+collect-module-globals cache-before) (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) previous)))) => (quote {:vars #{}, :syms #{object arg}}))
^{:refer lang.core.script-lint/collect-sym-vars :id lint-symbol-5}
(fact "pinned symbol analysis case 5" (let [previous lint/get-reserved previous-meta (meta (var lint/get-reserved)) cache-before (deref lint/+collect-module-globals)] (try (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) (constantly (quote #{do return +}))) (lint/collect-sym-vars (quote {:form (defn f [] (for:array [x xs] (+ x z))), :lang :lua, :op-key :defn}) {:native {}, :static {}}) (finally (reset! lint/+collect-module-globals cache-before) (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) previous)))) => (quote {:vars #{x}, :syms #{x xs z}}))
^{:refer lang.core.script-lint/collect-sym-vars :id lint-symbol-6}
(fact "pinned symbol analysis case 6" (let [previous lint/get-reserved previous-meta (meta (var lint/get-reserved)) cache-before (deref lint/+collect-module-globals)] (try (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) (constantly (quote #{do return +}))) (lint/collect-sym-vars (quote {:form (defn f [] (var cb (fn recur-name [p] (+ p recur-name outer)))), :lang :lua, :op-key :defn}) {:native {}, :static {}}) (finally (reset! lint/+collect-module-globals cache-before) (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) previous)))) => (quote {:vars #{p cb recur-name}, :syms #{outer p recur-name}}))
^{:refer lang.core.script-lint/collect-sym-vars :id lint-symbol-7}
(fact "pinned symbol analysis case 7" (let [previous lint/get-reserved previous-meta (meta (var lint/get-reserved)) cache-before (deref lint/+collect-module-globals)] (try (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) (constantly (quote #{do return +}))) (lint/collect-sym-vars (quote {:form (defn f [] (new Klass arg)), :lang :lua, :op-key :defn}) {:native {}, :static {}}) (finally (reset! lint/+collect-module-globals cache-before) (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) previous)))) => (quote {:vars #{Klass}, :syms #{}}))
^{:refer lang.core.script-lint/collect-sym-vars :id lint-symbol-8}
(fact "pinned symbol analysis case 8" (let [previous lint/get-reserved previous-meta (meta (var lint/get-reserved)) cache-before (deref lint/+collect-module-globals)] (try (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) (constantly (quote #{do return +}))) (lint/collect-sym-vars (quote {:form (defn f [] (catch [Error err] (return err))), :lang :lua, :op-key :defn}) {:native {}, :static {}}) (finally (reset! lint/+collect-module-globals cache-before) (intern (quote lang.core.script-lint) (with-meta (quote get-reserved) previous-meta) previous)))) => (quote {:vars #{Error err}, :syms #{err}}))


(ns lang.core.script-lint-test (:require [code.test :refer [fact]] [lang.core.script-lint :as lint] [lang.core.impl :as impl]))
^{:refer lang.core.script-lint/collect-vars}
(fact "collects nested symbols, not strings, numbers or keywords"
 (lint/collect-vars '#{[hello #{world}] {:key (other hello)} "text" 42}) => '#{hello world other})
^{:refer lang.core.script-lint/get-reserved-raw}
(fact "extracts reserved keys from the requested grammar"
 (let [previous impl/grammar previous-meta (meta #'impl/grammar)]
  (try
   (intern 'lang.core.impl (with-meta 'grammar previous-meta)
    (fn [language] (if (= language :fixture) {:reserved {'var {} 'return {}}} {:reserved {}})))
   [(lint/get-reserved-raw :fixture) (lint/get-reserved-raw :empty)]
   (finally (intern 'lang.core.impl (with-meta 'grammar previous-meta) previous))))
 => ['#{var return} #{}])
^{:refer lang.core.script-lint/collect-module-globals-raw}
(fact "flattens native declarations and static globals while excluding wildcard"
 [(lint/collect-module-globals-raw
   {:native {:one {:default 'One :refer ['Two '*]} :two {:default 'Three}}
    :static {:lang/lint-globals '#{Extra *}}})
  (lint/collect-module-globals-raw {:native {} :static {}})]
 => ['#{One Two Three Extra} #{}])
^{:refer lang.core.script-lint/collect-module-globals}
(fact "recent cache reuses matching module hashes, updates changed content and ignores extra arguments"
 (let [before (deref lint/+collect-module-globals)
       previous lint/collect-module-globals-raw previous-meta (meta #'lint/collect-module-globals-raw)
       calls (atom [])]
  (try
   (reset! lint/+collect-module-globals {})
   (intern 'lang.core.script-lint (with-meta 'collect-module-globals-raw previous-meta)
    (fn [module] (swap! calls conj (:value module)) #{(:value module)}))
   [(lint/collect-module-globals {:id 'm :value :a})
    (lint/collect-module-globals {:id 'm :value :a} :ignored)
    (lint/collect-module-globals {:id 'm :value :b})
    (deref calls) (get-in (deref lint/+collect-module-globals) ['m :return])]
   (finally
    (reset! calls [])
    (reset! lint/+collect-module-globals before)
    (intern 'lang.core.script-lint (with-meta 'collect-module-globals-raw previous-meta) previous))))
 => [#{:a} #{:a} #{:b} [:a :b] #{:b}])
^{:refer lang.core.script-lint/+collect-module-globals}
(fact "generated recent-cache storage supports idempotent reset"
 (let [before (deref lint/+collect-module-globals)]
  (try
   (reset! lint/+collect-module-globals {'m {:tag 1 :return #{:a}}})
   [(reset! lint/+collect-module-globals {}) (reset! lint/+collect-module-globals {})]
   (finally (reset! lint/+collect-module-globals before))))
 => [{} {}])
^{:refer lang.core.script-lint/lint-set}
(fact "enables and removes namespace membership with truthy option semantics"
 (let [before (deref lint/+registry+)]
  (try
   (lint/lint-clear)
   [(lint/lint-set 'a) (lint/lint-set 'b :enabled) (lint/lint-set 'a false) (lint/lint-set 'b nil)]
   (finally (reset! lint/+registry+ before))))
 => ['{a true} '{a true b true} '{b true} {}])
^{:refer lang.core.script-lint/lint-clear}
(fact "clear is idempotent and does not change settings"
 (let [before (deref lint/+registry+) settings-before (deref lint/+settings+)]
  (try
   (lint/lint-set 'a)
   [(lint/lint-clear) (lint/lint-clear) (= settings-before (deref lint/+settings+))]
   (finally (reset! lint/+registry+ before))))
 => [{} {} true])
^{:refer lang.core.script-lint/lint-needed?}
(fact "missing membership is nil, enabled membership is true"
 (let [before (deref lint/+registry+)]
  (try
   (lint/lint-clear)
   [(lint/lint-needed? 'a) (do (lint/lint-set 'a) (lint/lint-needed? 'a))
    (do (lint/lint-set 'a false) (lint/lint-needed? 'a))]
   (finally (reset! lint/+registry+ before))))
 => [nil true nil])
^{:refer lang.core.script-lint/lint-entry}
(fact "dispatches configured linters with strict options, skips no-lint, and propagates failures"
 (let [before (deref lint/+settings+) calls (atom [])
       entry {:lang :fixture :id 'f} module {:id 'm}]
  (try
   (reset! lint/+settings+
    {:fixture {:globals '#{G} :linters [(fn [entry module globals options]
      (swap! calls conj [entry module globals options]))]}})
   (let [first-result (lint/lint-entry entry module)
         suppressed (lint/lint-entry entry {:static {:lang/no-lint true}})
         absent (lint/lint-entry {:lang :missing} module)
         observed (deref calls)]
    (reset! lint/+settings+ {:fixture {:linters [(fn [& args] (throw (ex :lint/failed {:id 'f})))]}})
    [first-result suppressed absent observed
     (try (lint/lint-entry entry module) :unexpected
      (catch error (select-keys (ex-data error) [:ex/code :id])))])
   (finally (reset! lint/+settings+ before) (reset! calls []))))
 => [nil nil nil
     [[{:lang :fixture :id 'f} {:id 'm} '#{G} {:unknown :error :unused :silent}]]
     {:ex/code :lint/failed :id 'f}])
^{:refer lang.core.script-lint/sym-check-linter}
(fact "strict unknowns carry original form data; unused and non-definition forms preserve return behavior"
 (let [previous lint/get-reserved previous-meta (meta #'lint/get-reserved)
       cache-before (deref lint/+collect-module-globals)]
  (try
   (intern 'lang.core.script-lint (with-meta 'get-reserved previous-meta) (constantly '#{+ return do}))
   [(lint/sym-check-linter {:op 'other} {} #{} {:unknown :error})
    (lint/sym-check-linter {:op 'defn :op-key :defn :lang :fixture :form '(defn f [unused] 1)} {} #{} {:unknown :error :unused :silent})
    (lint/sym-check-linter {:op 'defn :op-key :defn :lang :fixture :form '(defn f [] internal)}
     {:internal {'alias 'internal}} #{} {:unknown :error})
    (try (lint/sym-check-linter {:id 'f :module 'M :op 'defn :op-key :defn :lang :fixture :form '(defn f [] missing)}
          {} #{} {:unknown :error}) :unexpected
     (catch error (select-keys (ex-data error) [:unknown :form])))]
   (finally
    (reset! lint/+collect-module-globals cache-before)
    (intern 'lang.core.script-lint (with-meta 'get-reserved previous-meta) previous))))
 => [nil :pass :pass {:unknown '#{missing} :form '(defn f [] missing)}])


(ns lang.core.script-lint-test (:require [code.test :refer [fact]] [lang.core.script-lint :as lint] [lang.core.impl :as impl]))
^{:refer lang.core.script-lint/get-reserved}
(fact "memoization caches by language, including empty sets; re-evaluating its owner resets the closure"
 (let [previous lint/get-reserved previous-meta (meta #'lint/get-reserved)
       grammar-before impl/grammar grammar-meta (meta #'impl/grammar)
       calls (atom []) revision (atom 'old)
       source (String/decode-utf8 (deref (File/read "src/lang/core/script_lint.hal")))
       initializer (first (filter
         (fn [form] (and (list? form) (= 'def (first form)) (= 'get-reserved (second form))))
         (read-string (str "(" source "\n)"))))]
  (try
   (intern 'lang.core.impl (with-meta 'grammar grammar-meta)
    (fn [language] (swap! calls conj language)
     {:reserved (if (= :empty language) {} {(deref revision) {}})}))
   (eval-in-ns 'lang.core.script-lint [initializer])
   (let [first-result (lint/get-reserved :fixture)
         _ (reset! revision 'new)
         cached (lint/get-reserved :fixture)
         other (lint/get-reserved :other)
         empty-result (lint/get-reserved :empty)
         empty-cached (lint/get-reserved :empty)
         before-reset (deref calls)]
    (eval-in-ns 'lang.core.script-lint [initializer])
    [first-result cached other empty-result empty-cached before-reset
     (lint/get-reserved :fixture) (deref calls)])
   (finally
    (intern 'lang.core.script-lint (with-meta 'get-reserved previous-meta) previous)
    (intern 'lang.core.impl (with-meta 'grammar grammar-meta) grammar-before)
    (reset! calls []) (reset! revision 'old))))
 => ['#{old} '#{old} '#{new} #{} #{} [:fixture :other :empty]
     '#{new} [:fixture :other :empty :fixture]])
^{:refer lang.core.script-lint/+registry+}
(fact "registry starts as a map of explicitly enabled namespace symbols"
 (let [before (deref lint/+registry+)]
  (try
   (reset! lint/+registry+ {})
   (lint/lint-set 'fixture.namespace)
   (deref lint/+registry+)
   (finally (reset! lint/+registry+ before))))
 => '{fixture.namespace true})
^{:refer lang.core.script-lint/+settings+}
(fact "default language settings retain original global symbol catalog"
 [(set (keys (deref lint/+settings+)))
  (get-in (deref lint/+settings+) [:lua :globals])
  (get-in (deref lint/+settings+) [:xtalk :globals])
  (get-in (deref lint/+settings+) [:solidity :globals])]
 => [#{:lua :xtalk :solidity :js}
     '#{tonumber unpack error next type pcall table math cjson os io string getmetatable ngx require GLOBAL CONFIG}
     '#{XT} '#{msg require}])

(ns lang.core.script-lint-test (:require [code.test :refer [fact]] [lang.model.v1.spec-lua] [lang.core.script-lint :as lint :refer [get-reserved-raw collect-vars collect-sym-vars lint-set lint-clear lint-needed? lint-entry]]))
^{:refer lang.core.script-lint/get-reserved-raw, :added "4.0", :id historical-get-reserved-raw}
(fact
  "gets all reserved symbols in the grammar"
  (let [previous lint/get-reserved
        previous-meta (meta #'lint/get-reserved)
        registry-before (deref lint/+registry+)
        cache-before (deref lint/+collect-module-globals)
        initializer (first
                      (filter
                        (fn [form]
                          (and
                            (list? form)
                            (= 'def (first form))
                            (= 'get-reserved (second form))))
                        (read-string
                          (str
                            "("
                            (String/decode-utf8
                              (deref
                                (File/read
                                  "src/lang/core/script_lint.hal")))
                            "\n)"))))]
    (try
      (reset! lint/+registry+ {})
      (reset! lint/+collect-module-globals {})
      (eval-in-ns 'lang.core.script-lint [initializer])
      (do (get-reserved-raw :lua))
      (finally
        (reset! lint/+registry+ registry-before)
        (reset! lint/+collect-module-globals cache-before)
        (intern
          'lang.core.script-lint
          (with-meta 'get-reserved previous-meta)
          previous))))
  =>
  (code.test/satisfies set?))

^{:refer lang.core.script-lint/collect-vars, :added "4.0", :id historical-collect-vars}
(fact
  "collects all vars"
  (let [previous lint/get-reserved
        previous-meta (meta #'lint/get-reserved)
        registry-before (deref lint/+registry+)
        cache-before (deref lint/+collect-module-globals)
        initializer (first
                      (filter
                        (fn [form]
                          (and
                            (list? form)
                            (= 'def (first form))
                            (= 'get-reserved (second form))))
                        (read-string
                          (str
                            "("
                            (String/decode-utf8
                              (deref
                                (File/read
                                  "src/lang/core/script_lint.hal")))
                            "\n)"))))]
    (try
      (reset! lint/+registry+ {})
      (reset! lint/+collect-module-globals {})
      (eval-in-ns 'lang.core.script-lint [initializer])
      (do (collect-vars '#{[hello #{world}]}))
      (finally
        (reset! lint/+registry+ registry-before)
        (reset! lint/+collect-module-globals cache-before)
        (intern
          'lang.core.script-lint
          (with-meta 'get-reserved previous-meta)
          previous))))
  =>
  '#{hello world})

^{:refer lang.core.script-lint/collect-sym-vars, :added "4.0", :id historical-collect-sym-vars}
(fact
  "collect symbols and vars"
  (let [previous lint/get-reserved
        previous-meta (meta #'lint/get-reserved)
        registry-before (deref lint/+registry+)
        cache-before (deref lint/+collect-module-globals)
        initializer (first
                      (filter
                        (fn [form]
                          (and
                            (list? form)
                            (= 'def (first form))
                            (= 'get-reserved (second form))))
                        (read-string
                          (str
                            "("
                            (String/decode-utf8
                              (deref
                                (File/read
                                  "src/lang/core/script_lint.hal")))
                            "\n)"))))]
    (try
      (reset! lint/+registry+ {})
      (reset! lint/+collect-module-globals {})
      (eval-in-ns 'lang.core.script-lint [initializer])
      (do
        (collect-sym-vars
          {:form '(defn foo [x] x), :lang :lua, :op-key :defn}
          {:native {}, :static {}}))
      (finally
        (reset! lint/+registry+ registry-before)
        (reset! lint/+collect-module-globals cache-before)
        (intern
          'lang.core.script-lint
          (with-meta 'get-reserved previous-meta)
          previous))))
  =>
  {:vars #{'x}, :syms #{'x}})

^{:refer lang.core.script-lint/lint-set, :added "4.0", :id historical-lint-set}
(fact
  "sets the linter for a namespace"
  (let [previous lint/get-reserved
        previous-meta (meta #'lint/get-reserved)
        registry-before (deref lint/+registry+)
        cache-before (deref lint/+collect-module-globals)
        initializer (first
                      (filter
                        (fn [form]
                          (and
                            (list? form)
                            (= 'def (first form))
                            (= 'get-reserved (second form))))
                        (read-string
                          (str
                            "("
                            (String/decode-utf8
                              (deref
                                (File/read
                                  "src/lang/core/script_lint.hal")))
                            "\n)"))))]
    (try
      (reset! lint/+registry+ {})
      (reset! lint/+collect-module-globals {})
      (eval-in-ns 'lang.core.script-lint [initializer])
      (do (lint-set 'lang.core.script-lint-test))
      (finally
        (reset! lint/+registry+ registry-before)
        (reset! lint/+collect-module-globals cache-before)
        (intern
          'lang.core.script-lint
          (with-meta 'get-reserved previous-meta)
          previous))))
  =>
  (code.test/satisfies map?))

^{:refer lang.core.script-lint/lint-clear, :added "4.0", :id historical-lint-clear}
(fact
  "clears all linted namespaces"
  (let [previous lint/get-reserved
        previous-meta (meta #'lint/get-reserved)
        registry-before (deref lint/+registry+)
        cache-before (deref lint/+collect-module-globals)
        initializer (first
                      (filter
                        (fn [form]
                          (and
                            (list? form)
                            (= 'def (first form))
                            (= 'get-reserved (second form))))
                        (read-string
                          (str
                            "("
                            (String/decode-utf8
                              (deref
                                (File/read
                                  "src/lang/core/script_lint.hal")))
                            "\n)"))))]
    (try
      (reset! lint/+registry+ {})
      (reset! lint/+collect-module-globals {})
      (eval-in-ns 'lang.core.script-lint [initializer])
      (do (lint-clear))
      (finally
        (reset! lint/+registry+ registry-before)
        (reset! lint/+collect-module-globals cache-before)
        (intern
          'lang.core.script-lint
          (with-meta 'get-reserved previous-meta)
          previous))))
  =>
  {})

^{:refer lang.core.script-lint/lint-needed?, :added "4.0", :id historical-lint-needed?}
(fact
  "checks if lint is needed"
  (let [previous lint/get-reserved
        previous-meta (meta #'lint/get-reserved)
        registry-before (deref lint/+registry+)
        cache-before (deref lint/+collect-module-globals)
        initializer (first
                      (filter
                        (fn [form]
                          (and
                            (list? form)
                            (= 'def (first form))
                            (= 'get-reserved (second form))))
                        (read-string
                          (str
                            "("
                            (String/decode-utf8
                              (deref
                                (File/read
                                  "src/lang/core/script_lint.hal")))
                            "\n)"))))]
    (try
      (reset! lint/+registry+ {})
      (reset! lint/+collect-module-globals {})
      (eval-in-ns 'lang.core.script-lint [initializer])
      (do (lint-needed? 'lang.core.script-lint-test))
      (finally
        (reset! lint/+registry+ registry-before)
        (reset! lint/+collect-module-globals cache-before)
        (intern
          'lang.core.script-lint
          (with-meta 'get-reserved previous-meta)
          previous))))
  =>
  nil)

^{:refer lang.core.script-lint/lint-entry, :added "4.0", :id historical-lint-entry}
(fact
  "lints a single entry"
  (let [previous lint/get-reserved
        previous-meta (meta #'lint/get-reserved)
        registry-before (deref lint/+registry+)
        cache-before (deref lint/+collect-module-globals)
        initializer (first
                      (filter
                        (fn [form]
                          (and
                            (list? form)
                            (= 'def (first form))
                            (= 'get-reserved (second form))))
                        (read-string
                          (str
                            "("
                            (String/decode-utf8
                              (deref
                                (File/read
                                  "src/lang/core/script_lint.hal")))
                            "\n)"))))]
    (try
      (reset! lint/+registry+ {})
      (reset! lint/+collect-module-globals {})
      (eval-in-ns 'lang.core.script-lint [initializer])
      (do
        (lint-entry
          {:form '(defn foo [x] x), :lang :lua, :op-key :defn}
          {:native {}, :static {}}))
      (finally
        (reset! lint/+registry+ registry-before)
        (reset! lint/+collect-module-globals cache-before)
        (intern
          'lang.core.script-lint
          (with-meta 'get-reserved previous-meta)
          previous))))
  =>
  nil)

(ns lang.core.script-lint-test (:require [code.test :refer [fact]] [lang.core.script-lint :as lint]))
^{:refer lang.core.script-lint/collect-module-globals :id cache-metadata}
(fact "generated recent function retains original metadata without compiler quote or reader locations"
 [(select-keys (meta #'lint/collect-module-globals) [:doc :added :arglists])
  (meta (:arglists (meta #'lint/collect-module-globals)))]
 => [{:added "4.0" :doc "collects global symbols from module" :arglists '([module])} nil])
