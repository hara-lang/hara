(ns lang.core.workspace-test
 (:require [lang.core.workspace :as w] [lang.base.util :as ut] [lang.core.runtime :as rt] [code.test :refer [fact]]))

(defstruct ^{:open true} WorkspaceLifecycle [module])
(extend-type WorkspaceLifecycle IContextLifeCycle
 (setup-module [rt module] [:setup (:module rt) module])
 (teardown-module [rt module] [:teardown (:module rt) module]))

^{:refer lang.core.workspace/rt-resolve}
(fact
  "only language keywords resolve through the runtime lookup"
  (let [previous-value-0 ut/lang-rt
        previous-meta-0 (meta #'ut/lang-rt)]
    (try
      (intern
        'lang.base.util
        (with-meta 'lang-rt previous-meta-0)
        (fn [language] {:lang language, :module 'M}))
      [(w/rt-resolve :lua)
       (w/rt-resolve {:lang :python})
       (w/rt-resolve nil)]
      (finally
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          previous-value-0))))
  =>
  [{:lang :lua, :module 'M} {:lang :python} nil])

^{:refer lang.core.workspace/sym-pointer}
(fact "pointer map keeps original namespace and code section"
 (w/sym-pointer :xtalk 'xt.lang.common-lib/noop)
 => '{:lang :xtalk :module xt.lang.common-lib :section :code :id noop})

^{:refer lang.core.workspace/multistage-tmpl}
(fact "template preserves both arities and late module selection"
 (w/multistage-tmpl '[demo rt/multistage-setup-for])
 => '(defn demo
       ([lang] (let [rt (ut/lang-rt lang)] (demo rt (:module rt))))
       ([rt module-id] (rt/multistage-setup-for rt module-id))))

^{:refer lang.core.workspace/rt:setup-single}
(fact
  "single setup uses runtime module by default and explicit override"
  (let [runtime (->WorkspaceLifecycle 'M)]
    (let [previous-value-0 ut/lang-rt
          previous-meta-0 (meta #'ut/lang-rt)]
      (try
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          (fn [lang] runtime))
        [(w/rt:setup-single :lua) (w/rt:setup-single runtime 'N)]
        (finally
          (intern
            'lang.base.util
            (with-meta 'lang-rt previous-meta-0)
            previous-value-0)))))
  =>
  [[:setup 'M 'M] [:setup 'M 'N]])

^{:refer lang.core.workspace/rt:teardown-single}
(fact
  "single teardown uses native lifecycle with selected module"
  (let [runtime (->WorkspaceLifecycle 'M)]
    (let [previous-value-0 ut/lang-rt
          previous-meta-0 (meta #'ut/lang-rt)]
      (try
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          (fn [lang] runtime))
        [(w/rt:teardown-single :lua) (w/rt:teardown-single runtime 'N)]
        (finally
          (intern
            'lang.base.util
            (with-meta 'lang-rt previous-meta-0)
            previous-value-0)))))
  =>
  [[:teardown 'M 'M] [:teardown 'M 'N]])

^{:refer lang.core.workspace/rt:setup-to}
(fact
  "setup-to forwards both arities to the original setup-to operation"
  (let [previous-value-0 ut/lang-rt
        previous-meta-0 (meta #'ut/lang-rt)
        previous-value-1 rt/multistage-setup-to
        previous-meta-1 (meta #'rt/multistage-setup-to)]
    (try
      (intern
        'lang.base.util
        (with-meta 'lang-rt previous-meta-0)
        (fn [lang] {:module 'M}))
      (intern
        'lang.core.runtime
        (with-meta 'multistage-setup-to previous-meta-1)
        (fn [runtime module] [:setup-to (:module runtime) module]))
      [(w/rt:setup-to :lua) (w/rt:setup-to {:module 'M} 'N)]
      (finally
        (intern
          'lang.core.runtime
          (with-meta 'multistage-setup-to previous-meta-1)
          previous-value-1)
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          previous-value-0))))
  =>
  [[:setup-to 'M 'M] [:setup-to 'M 'N]])

^{:refer lang.core.workspace/rt:setup}
(fact
  "setup forwards both arities to setup-for"
  (let [previous-value-0 ut/lang-rt
        previous-meta-0 (meta #'ut/lang-rt)
        previous-value-1 rt/multistage-setup-for
        previous-meta-1 (meta #'rt/multistage-setup-for)]
    (try
      (intern
        'lang.base.util
        (with-meta 'lang-rt previous-meta-0)
        (fn [lang] {:module 'M}))
      (intern
        'lang.core.runtime
        (with-meta 'multistage-setup-for previous-meta-1)
        (fn [runtime module] [:setup-for (:module runtime) module]))
      [(w/rt:setup :lua) (w/rt:setup {:module 'M} 'N)]
      (finally
        (intern
          'lang.core.runtime
          (with-meta 'multistage-setup-for previous-meta-1)
          previous-value-1)
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          previous-value-0))))
  =>
  [[:setup-for 'M 'M] [:setup-for 'M 'N]])

^{:refer lang.core.workspace/rt:teardown}
(fact
  "teardown forwards both arities to teardown-for"
  (let [previous-value-0 ut/lang-rt
        previous-meta-0 (meta #'ut/lang-rt)
        previous-value-1 rt/multistage-teardown-for
        previous-meta-1 (meta #'rt/multistage-teardown-for)]
    (try
      (intern
        'lang.base.util
        (with-meta 'lang-rt previous-meta-0)
        (fn [lang] {:module 'M}))
      (intern
        'lang.core.runtime
        (with-meta 'multistage-teardown-for previous-meta-1)
        (fn [runtime module] [:teardown-for (:module runtime) module]))
      [(w/rt:teardown :lua) (w/rt:teardown {:module 'M} 'N)]
      (finally
        (intern
          'lang.core.runtime
          (with-meta 'multistage-teardown-for previous-meta-1)
          previous-value-1)
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          previous-value-0))))
  =>
  [[:teardown-for 'M 'M] [:teardown-for 'M 'N]])

^{:refer lang.core.workspace/rt:teardown-to}
(fact
  "teardown-to retains its distinct dependent traversal"
  (let [previous-value-0 ut/lang-rt
        previous-meta-0 (meta #'ut/lang-rt)
        previous-value-1 rt/multistage-teardown-to
        previous-meta-1 (meta #'rt/multistage-teardown-to)]
    (try
      (intern
        'lang.base.util
        (with-meta 'lang-rt previous-meta-0)
        (fn [lang] {:module 'M}))
      (intern
        'lang.core.runtime
        (with-meta 'multistage-teardown-to previous-meta-1)
        (fn [runtime module] [:teardown-to (:module runtime) module]))
      [(w/rt:teardown-to :lua) (w/rt:teardown-to {:module 'M} 'N)]
      (finally
        (intern
          'lang.core.runtime
          (with-meta 'multistage-teardown-to previous-meta-1)
          previous-value-1)
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          previous-value-0))))
  =>
  [[:teardown-to 'M 'M] [:teardown-to 'M 'N]])

^{:refer lang.core.workspace/rt:teardown-at}
(fact
  "teardown-at retains its distinct dependent traversal"
  (let [previous-value-0 ut/lang-rt
        previous-meta-0 (meta #'ut/lang-rt)
        previous-value-1 rt/multistage-teardown-at
        previous-meta-1 (meta #'rt/multistage-teardown-at)]
    (try
      (intern
        'lang.base.util
        (with-meta 'lang-rt previous-meta-0)
        (fn [lang] {:module 'M}))
      (intern
        'lang.core.runtime
        (with-meta 'multistage-teardown-at previous-meta-1)
        (fn [runtime module] [:teardown-at (:module runtime) module]))
      [(w/rt:teardown-at :lua) (w/rt:teardown-at {:module 'M} 'N)]
      (finally
        (intern
          'lang.core.runtime
          (with-meta 'multistage-teardown-at previous-meta-1)
          previous-value-1)
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          previous-value-0))))
  =>
  [[:teardown-at 'M 'M] [:teardown-at 'M 'N]])

^{:refer lang.core.workspace/rt:scaffold-to}
(fact
  "scaffold-to delegates to scaffold setup-to"
  (let [previous-value-0 ut/lang-rt
        previous-meta-0 (meta #'ut/lang-rt)
        previous-value-1 rt/default-scaffold-setup-to
        previous-meta-1 (meta #'rt/default-scaffold-setup-to)]
    (try
      (intern
        'lang.base.util
