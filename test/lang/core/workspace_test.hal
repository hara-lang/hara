        (fn [lang] {:module 'M}))
      (intern
        'lang.core.runtime
        (with-meta 'default-scaffold-setup-to previous-meta-1)
        (fn [runtime module] [:scaffold-to (:module runtime) module]))
      [(w/rt:scaffold-to :lua) (w/rt:scaffold-to {:module 'M} 'N)]
      (finally
        (intern
          'lang.core.runtime
          (with-meta 'default-scaffold-setup-to previous-meta-1)
          previous-value-1)
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          previous-value-0))))
  =>
  [[:scaffold-to 'M 'M] [:scaffold-to 'M 'N]])

^{:refer lang.core.workspace/rt:scaffold}
(fact
  "scaffold delegates to scaffold setup-for"
  (let [previous-value-0 ut/lang-rt
        previous-meta-0 (meta #'ut/lang-rt)
        previous-value-1 rt/default-scaffold-setup-for
        previous-meta-1 (meta #'rt/default-scaffold-setup-for)]
    (try
      (intern
        'lang.base.util
        (with-meta 'lang-rt previous-meta-0)
        (fn [lang] {:module 'M}))
      (intern
        'lang.core.runtime
        (with-meta 'default-scaffold-setup-for previous-meta-1)
        (fn [runtime module] [:scaffold-for (:module runtime) module]))
      [(w/rt:scaffold :lua) (w/rt:scaffold {:module 'M} 'N)]
      (finally
        (intern
          'lang.core.runtime
          (with-meta 'default-scaffold-setup-for previous-meta-1)
          previous-value-1)
        (intern
          'lang.base.util
          (with-meta 'lang-rt previous-meta-0)
          previous-value-0))))
  =>
  [[:scaffold-for 'M 'M] [:scaffold-for 'M 'N]])

^{:refer lang.core.workspace/rt:scaffold-imports}
(fact
  "scaffold-imports delegates to import scaffolding"
  (let [previous-value-0 ut/lang-rt
        previous-meta-0 (meta #'ut/lang-rt)
        previous-value-1 rt/default-scaffold-imports
        previous-meta-1 (meta #'rt/default-scaffold-imports)]
    (try
      (intern
        'lang.base.util
        (with-meta 'lang-rt previous-meta-0)
        (fn [lang] {:module 'M}))
      (intern
        'lang.core.runtime
        (with-meta 'default-scaffold-imports previous-meta-1)
        (fn [runtime module] [:imports (:module runtime) module]))
      [(w/rt:scaffold-imports :lua)
       (w/rt:scaffold-imports {:module 'M} 'N)]
      (finally
        (intern
          'lang.core.runtime
          (with-meta 'default-scaffold-imports previous-meta-1)
          previous-value-1)
        (intern
          'lang.base.util
