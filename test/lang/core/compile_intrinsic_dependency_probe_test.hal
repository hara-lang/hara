(ns lang.core.compile-intrinsic-dependency-probe-test
  (:require [lang.core.compile :as compile])
  (:use code.test))

(Test/check
 [{:name "ignores target and intrinsic namespaces in code dependencies"
   :test (fn []
           (compile/module-dependency-ids
            {:id 'demo.main
             :code {'entry {:dependencies {:code #{'demo.dep/value
                                                    '-/gcd
                                                    'x:m-mod}}}}}))
   :expected ['demo.dep]}])
