(ns lang.core.script-annex-test
  (:require [code.test :refer :all]
            [lang.core.script-annex :as annex]
            [lang.core.impl :as impl]
            [lang.core.library :as lib]
            [lang.core.registry :as sreg]
            [lang.base.emit-prep-lua-test :as prep]
            [std.lib.context.space :as space]
            [std.lib.context.registry :as reg]
            [std.lib.context.resource :as resource]))

(def +baseline+
  {:spaces (deref space/*spaces*)
   :registry (deref reg/*registry*)
   :resources (deref resource/*resource-registry*)
   :active (deref resource/*resource-active*)})
(fact:global
 {:setup [(reset! space/*spaces* {})
          (reset! resource/*resource-active* {:global {} :namespace {} :shared {}})]
  :teardown [(doseq [namespace (keys (deref space/*spaces*))]
               (annex/clear-annex namespace)
               (annex/annex-reset namespace))
             (reset! space/*spaces* (:spaces +baseline+))
             (reset! reg/*registry* (:registry +baseline+))
             (reset! resource/*resource-registry* (:resources +baseline+))
             (reset! resource/*resource-active* (:active +baseline+))]})

^{:refer lang.core.script-annex/rt-annex-string}
(fact "sorts tag and language display pairs"
  (annex/rt-annex-string {:runtimes (atom {:b {:lang :python} :a {:lang :lua}})})
  => "#lang.annex [[:a :lua] [:b :python]]")

^{:refer lang.core.script-annex/rt-annex?}
(fact "distinguishes actual annex records from ordinary maps and nil"
  [(annex/rt-annex? (annex/rt-annex:create {}))
   (annex/rt-annex? {}) (annex/rt-annex? nil)]
  => [true false false])

^{:refer lang.core.script-annex/rt-annex:create}
(fact "preserves open fields and allocates independent registration and runtime atoms"
  (let [a (annex/rt-annex:create {:id :a :extra 9})
        b (annex/rt-annex:create {:id :b})]
    (reset! (:registry a) {:tag :only-a})
    [(:id a) (:extra a) (deref (:registry a)) (deref (:registry b))
     (deref (:runtimes a)) (= (var impl/default-library) (:parent (:library a)))])
  => [:a 9 {:tag :only-a} {} {} true])

^{:refer lang.core.script-annex/+init-annex+}
(fact "registers the original annex resource and context without a replacement registry"
  [(get-in (reg/registry-get :lang.annex) [:rt :default :resource])
   (:config (reg/registry-get :lang.annex))
   (:type (resource/spec-get :tahto/lang.rt.annex))]
  => [:tahto/lang.rt.annex {} :tahto/lang.rt.annex])

^{:refer lang.core.script-annex/annex-current}
(fact "observes absence without constructing an annex"
  (let [before (annex/annex-current 'annex.current)
        created (annex/get-annex 'annex.current)]
    [before (= created (annex/annex-current 'annex.current))])
  => [nil true])

^{:refer lang.core.script-annex/annex-reset}
(fact
  "returns the removed annex identity and resets idempotently"
  (let [original (annex/get-annex 'annex.reset)
        removed (annex/annex-reset 'annex.reset)]
    [(if (nil? removed) false (Base/identical? original removed))
     (annex/annex-current 'annex.reset)
     (annex/annex-reset 'annex.reset)])
  =>
  [true nil nil])

^{:refer lang.core.script-annex/get-annex}
(fact "reuses one namespace instance and isolates different namespaces"
  (let [a (annex/get-annex 'annex.reuse-a)
        b (annex/get-annex 'annex.reuse-b)]
    (reset! (:registry a) {:local true})
    [(= a (annex/get-annex 'annex.reuse-a)) (deref (:registry b))])
  => [true {}])

^{:refer lang.core.script-annex/clear-annex}
(fact "returns removed runtimes and leaves registrations intact"
  (let [a (annex/get-annex 'annex.clear)]
    (reset! (:registry a) {:keep {:lang :lua}})
    (reset! (:runtimes a) {:one :one.rt})
    [(annex/clear-annex 'annex.clear)
     (deref (:runtimes a)) (deref (:registry a))
     (annex/clear-annex 'annex.clear)])
  => [{:one :one.rt} {} {:keep {:lang :lua}} {}])

^{:refer lang.core.script-annex/get-annex-library}
(fact "returns the namespace annex's actual child library"
  (let [a (annex/get-annex 'annex.library)]
    [(= (:library a) (annex/get-annex-library 'annex.library))
     (= (var impl/default-library) (:parent (:library a)))])
  => [true true])

^{:refer lang.core.script-annex/get-annex-book}
(fact "copies a default book into annex ownership without parent modules and reuses it"
  (do
    (lib/add-book! (impl/default-library) prep/+book-min+)
    (let [first-book (annex/get-annex-book 'annex.book :lua)
          second-book (annex/get-annex-book 'annex.book :lua)]
      [(:lang first-book) (:modules first-book) (= first-book second-book)
       (not (empty? (:modules (lib/get-book (impl/default-library) :lua))))]))
  => [:lua {} true true])

^{:refer lang.core.script-annex/add-annex-runtime}
(fact "returns prior and replacement runtime values"
  [(annex/add-annex-runtime 'annex.add :tag :old.rt)
   (annex/add-annex-runtime 'annex.add :tag :new.rt)
   (annex/get-annex-runtime 'annex.add :tag)]
  => [[nil :old.rt] [:old.rt :new.rt] :new.rt])

^{:refer lang.core.script-annex/get-annex-runtime}
(fact "looks up a tag only in the requested namespace"
  (do (annex/add-annex-runtime 'annex.lookup-a :tag :found.rt)
      [(annex/get-annex-runtime 'annex.lookup-a :tag)
       (annex/get-annex-runtime 'annex.lookup-b :tag)
       (annex/get-annex-runtime 'annex.lookup-a :missing)])
  => [:found.rt nil nil])

^{:refer lang.core.script-annex/remove-annex-runtime}
(fact "returns the removed value then nil and retains other tags"
  (do (annex/add-annex-runtime 'annex.remove :tag :old.rt)
      (annex/add-annex-runtime 'annex.remove :keep :keep.rt)
      [(annex/remove-annex-runtime 'annex.remove :tag)
       (annex/remove-annex-runtime 'annex.remove :tag)
       (annex/get-annex-runtime 'annex.remove :keep)])
  => [:old.rt nil :keep.rt])

^{:refer lang.core.script-annex/register-annex-tag}
(fact "returns previous registration and language while replacing configuration"
  [(annex/register-annex-tag 'annex.register :tag :lua :default {:port 1})
   (annex/register-annex-tag 'annex.register :tag :python :oneshot {:port 2})
   (get (deref (:registry (annex/get-annex 'annex.register))) :tag)]
  => [[nil :lua]
      [{:lang :lua :runtime :default :config {:port 1}} :python]
      {:lang :python :runtime :oneshot :config {:port 2}}])

^{:refer lang.core.script-annex/deregister-annex-tag}
(fact "returns removed config without removing the live runtime"
  (do (annex/register-annex-tag 'annex.deregister :tag :lua :default {:port 1})
      (annex/add-annex-runtime 'annex.deregister :tag :still.rt)
      [(annex/deregister-annex-tag 'annex.deregister :tag)
       (annex/deregister-annex-tag 'annex.deregister :tag)
       (annex/get-annex-runtime 'annex.deregister :tag)])
  => [{:lang :lua :runtime :default :config {:port 1}} nil :still.rt])

^{:refer lang.core.script-annex/start-runtime}
(fact "merges runtime defaults and caller config then applies resource setup"
  (do
    (resource/spec-add
      {:type :annex/test-runtime
       :instance {:create identity :setup (fn [value] (assoc value :started true))}})
    (reg/registry-install :lang/annex-probe
      {:rt {:default {:resource :annex/test-runtime :config {:layout :full :default 1}}}})
    (annex/start-runtime :annex-probe :default {:layout :flat :caller 2}))
  => {:lang :annex-probe :runtime :default :layout :flat :default 1 :caller 2 :started true})

^{:refer lang.core.script-annex/same-runtime?}
(fact "compares exactly lang runtime layout and emit while ignoring incidental fields"
  (do
    (reg/registry-install :lang/annex-compare
      {:rt {:default {:resource :annex/test-runtime :config {:layout :flat}}}})
    (let [current {:lang :annex-compare :runtime :default :layout :flat :emit {:a 1} :id :old}]
      [(annex/same-runtime? current :annex-compare :default {:emit {:a 1} :id :new})
       (annex/same-runtime? current :annex-compare :default {:emit {:a 2}})
       (annex/same-runtime? current :annex-compare :default {:emit {:a 1} :layout :full})]))
  => [true false false])


(defstruct AnnexStopProbe [id log])
(extend-type AnnexStopProbe IComponent
  (start [value] value)
  (stop [value] (do (swap! (:log value) conj (:id value)) value))
  (kill [value] (do (swap! (:log value) conj (:id value)) value)))

^{:refer lang.core.script-annex/clear-annex :id managed-component-stop}
(fact "replacement and clearing stop actual components once in order"
  (let [log (atom [])
        old (AnnexStopProbe :old log)
        new (AnnexStopProbe :new log)]
    (annex/add-annex-runtime 'annex.managed :tag old)
    (annex/add-annex-runtime 'annex.managed :tag new)
    (annex/clear-annex 'annex.managed)
    (annex/clear-annex 'annex.managed)
    [(deref log) (annex/get-annex-runtime 'annex.managed :tag)])
  => [[:old :new] nil])


(defstruct AnnexThrowStopProbe [id log])
(extend-type AnnexThrowStopProbe IComponent
  (start [value] value)
  (stop [value]
    (do (swap! (:log value) conj :stop)
        (throw (ex :annex/stop-failed {:id (:id value)}))))
  (kill [value] value))

^{:refer lang.core.script-annex/remove-annex-runtime :id stop-failure-keeps-state}
(fact "propagates stop failure and preserves the previous runtime map"
  (let [log (atom [])
        current (AnnexThrowStopProbe :current log)
        annex (annex/get-annex 'annex.stop-failure)]
    (reset! (:runtimes annex) {:tag current :keep :untouched})
    (try
      (let [result (try
                     (annex/remove-annex-runtime 'annex.stop-failure :tag)
                     :missed
                     (catch error :stop-failed))]
        [result
         (let [stored (get (deref (:runtimes annex)) :tag)] (if (nil? stored) false (Base/identical? current stored)))
         (get (deref (:runtimes annex)) :keep)
         (deref log)])
      (finally (reset! (:runtimes annex) {}))))
  => [:stop-failed true :untouched [:stop]])

