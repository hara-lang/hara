^{:refer lang.core.script-annex/get-annex :id :retained-caller-namespace}
(fact "zero-arity annex lookup uses the caller namespace"
 (let [value (annex/get-annex)]
  [(Base/identical? value (annex/get-annex (ns-current)))
   (Base/identical? value (annex/annex-current))])
 => [true true])

^{:refer lang.core.script-annex/register-annex-tag :id :retained-coordinate-isolation}
(fact "the same tag remains independent in two namespace-owned annexes"
 (do
  (annex/register-annex-tag 'annex.coordinate-a :one :lua :default {:a 1})
  (annex/register-annex-tag 'annex.coordinate-b :one :python :default {:b 2})
  [(deref (:registry (annex/get-annex 'annex.coordinate-a)))
   (deref (:registry (annex/get-annex 'annex.coordinate-b)))])
 => [{:one {:lang :lua :runtime :default :config {:a 1}}}
     {:one {:lang :python :runtime :default :config {:b 2}}}])

^{:refer lang.core.script-annex/rt-annex:create :id :retained-snapshot-baseline}
(fact "the original annex exposes independent empty registration and runtime snapshots"
 (let [a (annex/rt-annex:create {:id :snapshot})
       saved {:registry (deref (:registry a)) :runtimes (deref (:runtimes a))}]
  (reset! (:registry a) {:later true})
  [saved (deref (:registry a)) (deref (:runtimes a))])
 => [{:registry {} :runtimes {}} {:later true} {}])

^{:refer lang.core.script-annex/deregister-annex-tag :id :retained-registration-restore}
(fact "registration snapshots can be restored without replacing the namespace-owned library"
 (let [a (annex/get-annex 'annex.restore)
       library (:library a)]
  (annex/register-annex-tag 'annex.restore :one :postgres :default {})
  (let [saved (deref (:registry a))]
   (annex/deregister-annex-tag 'annex.restore :one)
   (let [cleared (deref (:registry a))]
    (reset! (:registry a) saved)
    [cleared (deref (:registry a))
     (Base/identical? library (:library (annex/get-annex 'annex.restore)))])))
 => [{} {:one {:lang :postgres :runtime :default :config {}}} true])

^{:refer lang.core.script-annex/start-runtime :id :retained-runtime-restore}
(fact "runtime restoration uses the real setup and stop boundaries"
 (let [events (atom [])]
  (resource/spec-add
   {:type :annex/restore-probe
    :instance {:create (fn [_] (->AnnexStopProbe :stop events))
               :setup (fn [value] (swap! events conj :start) value)}})
  (reg/registry-install :lang/restore-probe
   {:rt {:default {:resource :annex/restore-probe}}})
  (annex/register-annex-tag 'annex.restore-runtime :one :restore-probe :default {})
  (let [a (annex/get-annex 'annex.restore-runtime)
        descriptor (get (deref (:registry a)) :one)
        first-runtime (annex/start-runtime (:lang descriptor) (:runtime descriptor) (:config descriptor))]
   (annex/add-annex-runtime 'annex.restore-runtime :one first-runtime)
   (annex/clear-annex 'annex.restore-runtime)
   (let [after-clear (deref (:runtimes a))
         restored (annex/start-runtime (:lang descriptor) (:runtime descriptor) (:config descriptor))]
    (annex/add-annex-runtime 'annex.restore-runtime :one restored)
    [after-clear (deref events)
     (Base/identical? restored (annex/get-annex-runtime 'annex.restore-runtime :one))
     (deref (:registry a))])))
 => [{} [:start :stop :start] true
     {:one {:lang :restore-probe :runtime :default :config {}}}])

^{:refer lang.core.script-annex/annex-reset :id :retained-reset-idempotence}
(fact "reset removes the namespace instance and returns nil on repetition"
 (let [before (annex/get-annex 'annex.reset-original)]
  (annex/register-annex-tag 'annex.reset-original :one :lua :default {})
  (let [removed (annex/annex-reset 'annex.reset-original)
        second-reset (annex/annex-reset 'annex.reset-original)
        after (annex/get-annex 'annex.reset-original)]
   [(Base/identical? before removed) second-reset
    (deref (:registry after)) (deref (:runtimes after))]))
 => [true nil {} {}])

^{:refer lang.core.script-annex/get-annex :id :retained-namespace-tags}
(fact "tag enumeration comes from each annex rather than global coordinate filtering"
 (do
  (annex/register-annex-tag 'annex.tags-a :one :lua :default {})
  (annex/register-annex-tag 'annex.tags-b :two :lua :default {})
  [(set (keys (deref (:registry (annex/get-annex 'annex.tags-a)))))
   (set (keys (deref (:registry (annex/get-annex 'annex.tags-b)))))])
 => [#{:one} #{:two}])

^{:refer lang.core.script-annex/clear-annex :id :retained-explicit-clear}
(fact "clearing runtimes retains tags until explicit deregistration"
 (do
  (annex/register-annex-tag 'annex.clear-explicit :one :lua :default {})
  (annex/add-annex-runtime 'annex.clear-explicit :one :runtime)
  (let [removed (annex/clear-annex 'annex.clear-explicit)
        a (annex/get-annex 'annex.clear-explicit)
        registered (set (keys (deref (:registry a))))]
   (annex/deregister-annex-tag 'annex.clear-explicit :one)
   [removed registered (deref (:registry a)) (deref (:runtimes a))]))
 => [{:one :runtime} #{:one} {} {}])

^{:refer lang.core.script-annex/clear-annex, :id :retained-caller-clear}
(fact
  "zero-arity clear affects only the caller annex and preserves its registration"
  (let [caller (ns-current)
        a (annex/get-annex caller)
        saved-registry (deref (:registry a))
        saved-runtimes (deref (:runtimes a))]
    (try
      (reset! (:registry a) {})
      (reset! (:runtimes a) {})
      (annex/register-annex-tag caller :local :lua :default {})
      (annex/add-annex-runtime caller :local :here)
      (annex/add-annex-runtime 'annex.clear-other :other :there)
      [(annex/clear-annex)
       (annex/clear-annex)
       (set (keys (deref (:registry (annex/get-annex caller)))))
       (deref (:runtimes (annex/get-annex 'annex.clear-other)))]
      (finally
        (annex/clear-annex)
        (annex/clear-annex 'annex.clear-other)
        (annex/annex-reset 'annex.clear-other)
        (reset! (:registry a) saved-registry)
        (reset! (:runtimes a) saved-runtimes))))
  =>
  [{:local :here} {} #{:local} {:other :there}])
