(ns lang.core.script-basic-test
  (:require [lang.core :as l]
            [lang.core.script :as script]))

(l/script- :js
  {:runtime :basic
   :timeout 15000})

^{:refer lang.core/script-}
(Test/check
 [{:name "starts a JavaScript basic runtime for l/script- evaluation"
   :test (fn []
           (try
             (l/restart)
             (let [runtime (get-in (deref script/+scripts+)
                                   [['lang.core.script-basic-test :js] :runtime])
                   result (!.js (+ 19 23))]
               [result
                (:lang runtime)
                (get-in runtime [:process :transport])
                (do
                  (l/stop)
                  (get-in (deref script/+scripts+)
                          [['lang.core.script-basic-test :js] :runtime]))
                (get-in (deref (:state runtime)) [:status])])
             (finally
               (l/stop))))
   :expected [42 :js :process-socket nil :stopped]}])
