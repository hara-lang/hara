(ns lang.core.script-def-test
  (:use code.test)
  (:require [lang.core.script-def :as script-def]))

^{:refer lang.core.script-def/sym-default-inverse-str}
(fact "template symbols convert only underscore separators"
  [(script-def/sym-default-inverse-str 'create_object)
   (script-def/sym-default-inverse-str 'create-object)]
  => ["create-object" "create-object"])

^{:refer lang.core.script-def/tmpl-entry}
(fact "script-def preserves Foundation entry template semantics"
  (let [entry-a (std.foundation/with-template-meta {:type :fragment :tag "js"}
                  (script-def/tmpl-entry '[createObject create]))
        entry-b (std.foundation/with-template-meta {:type :fragment
                                                     :base "Webassembly"
                                                     :prefix "ws-"
                                                     :tag "js"}
                  (script-def/tmpl-entry 'compile))]
    [entry-a entry-b])
  => '[(def$.js createObject create)
       (def$.js ws-compile Webassembly.compile)])

^{:refer lang.core.script-def/tmpl-macro}
(fact "script-def preserves standalone property macro metadata"
  (let [macro-form (std.foundation/with-template-meta {:tag "js"}
                     (script-def/tmpl-macro
                      '[length [arr] {:property true :tag "js"}]))
        macro-symbol (second macro-form)]
    [(first macro-form) macro-symbol
     (boolean (:standalone (meta macro-symbol)))])
  => '[defmacro.js length true])
