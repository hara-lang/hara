(ns lang.core.impl-deps-imports-test
  (:require [lang.base.book :as b]
            [lang.base.book-module :as module]
            [lang.base.emit-prep-js-test :as prep-js]
            [lang.base.emit-prep-lua-test :as prep-lua]
            [lang.core.impl :as impl]
            [lang.core.impl-deps :as deps]
            [lang.core.impl-deps-imports :as deps-imports]
            [lang.core.impl-entry :as entry]
            [lang.core.library :as lib]
            [lang.core.library-snapshot :as snap])
  (:use code.test))

(do)

(do)

(def +library-lua+
  (doto (lib/library:create
         {:snapshot (snap/snapshot {:lua {:id :lua
                                          :book prep-lua/+book-min+}})})
    (lib/install-module! :lua 'L.util
                         {:import  '[["cjson" :as cjson]
                                     ["socket" :as socket]]})
    (lib/add-entry-single!
     (entry/create-fragment
      '(def$ cjson-read cjson.read)
      {:lang :lua
       :namespace 'L.util
       :module 'L.util}))
    (lib/add-entry-single!
     (entry/create-fragment
      '(def$ socket-read socket.read)
      {:lang :lua
       :namespace 'L.util
       :module 'L.util}))
    (lib/install-module! :lua 'L.app
                         {:require '[[L.util :as ut]]})
    (lib/add-entry-single!
     (entry/create-code-base
      '(defn read-json
         [a]
         (return (ut/cjson-read "{\"a\": 1}")))
      {:lang :lua
       :namespace 'L.app
       :module 'L.app}
      {}))
    (lib/add-entry-single!
     (entry/create-code-base
      '(defn read-socket
         [a]
         (return (ut/socket-read)))
      {:lang :lua
       :namespace 'L.app
       :module 'L.app}
      {}))))

(def +library-js+
  (doto (lib/library:create
         {:snapshot (snap/snapshot {:js {:id :js
                                         :book prep-js/+book-min+}})})
    (lib/install-module! :js 'JS.ui
                         {:import  ' [["@measured/puck" :as [* Puck]]
                                      ["@radix-ui/themes" :as [* Radix]
                                       :bundle [["@radix-ui/themes/styles.css"]]]]})
    (lib/add-entry-single!
     (entry/create-fragment
      '(def$ Button Radix.Button)
      {:lang :js
       :namespace 'JS.ui
       :module 'JS.ui}))
    (lib/add-entry-single!
     (entry/create-fragment
      '(def$ Puck Puck)
      {:lang :js
       :namespace 'JS.ui
       :module 'JS.ui}))
    (lib/install-module! :js 'JS.app
                         {:require '[[JS.ui :as ui]]})
    (lib/add-entry-single!
     (entry/create-fragment
      '(def$ Button ui/Button)
      {:lang :js
       :namespace 'JS.app
       :module 'JS.app}))
    (lib/add-entry-single!
     (entry/create-code-base
      '(defn App
         []
         (return
          [:% -/Button
           [:% ui/Puck]]))
      {:lang :js
       :namespace 'JS.app
       :module 'JS.app}
      {}))
    (lib/add-entry-single!
     (entry/create-code-base
      '(defn AppRadix
         []
         (return
          [:% ui/Button]))
      {:lang :js
       :namespace 'JS.app
       :module 'JS.app}
      {}))
    ))

^{:refer lang.core.impl-deps-imports/get-entry-imports :added "4.0"}
(fact "gets all fragment imports from code entries"

      (deps-imports/get-entry-imports
       (map (fn [migration-argument-0] (b/get-fragment-entry (lib/get-book +library-js+ (keyword "js")) migration-argument-0))
            (deps-imports/get-fragment-deps
             (lib/get-book +library-js+ :js)
             (first (deps/collect-script-entries
                     (lib/get-book +library-js+ :js)
                     ['JS.app/App])))))
      => '{JS.ui/Puck {"@measured/puck" #{Puck}}, JS.ui/Button {"@radix-ui/themes" #{Radix}}})

^{:refer lang.core.impl-deps-imports/get-namespace-imports :added "4.0"}
(fact "merges imports for both fragment and code entries"

      (deps-imports/get-namespace-imports
       (concat
        '{JS.ui/Puck {"@measured/puck" #{Puck}}}
        '{JS.ui/Button {"@radix-ui/themes" #{Radix}}}))
      => '{JS.ui {"@measured/puck" #{Puck}, "@radix-ui/themes" #{Radix}}})

^{:refer lang.core.impl-deps-imports/get-fragment-deps :added "4.0"}
(fact "gets all the fragment dependencies"

      (deps-imports/get-fragment-deps
       (lib/get-book +library-js+ :js)
       (first (deps/collect-script-entries
               (lib/get-book +library-js+ :js)
               ['JS.app/App])))
      => '#{JS.ui/Puck JS.app/Button JS.ui/Button})

^{:refer lang.core.impl-deps-imports/format-namespace-imports :added "4.0"}
(fact "formats a list of namespace imports into an import map"

      (deps-imports/format-namespace-imports
       (lib/get-book +library-js+ :js)
       (deps-imports/get-namespace-imports
        (concat
         '{JS.ui/Puck {"@measured/puck" #{Puck}}}
         '{JS.ui/Button {"@radix-ui/themes" #{Radix}}})))
      => '{"@measured/puck" {:as [* Puck]},
           "@radix-ui/themes" {:as [* Radix],
                               :bundle {"@radix-ui/themes/styles.css" {}}}})

^{:refer lang.core.impl-deps-imports/script-import-deps :added "4.0"}
(fact "collect all native imports"

      (deps-imports/script-import-deps
       (lib/get-book +library-js+ :js)
       (first (deps/collect-script-entries
               (lib/get-book +library-js+ :js)
               ['JS.app/App])))
      => '{JS.ui {"@measured/puck" #{Puck}, "@radix-ui/themes" #{Radix}}}

      (dissoc (lib/get-module +library-js+ :js 'JS.app)
              :fragment :code)
      => '{:require-impl nil,
           :static nil,
           :specialize {},
           :includes #{},
           :native-lu {},
           :internal {JS.ui ui, JS.app -},
           :implements [],
           :lang :js,
           :alias {},
           :native {},
           :link {ui JS.ui, - JS.app},
           :id JS.app,
           :display :default}

      (dissoc (lib/get-module +library-js+ :js 'JS.ui)
              :fragment :code)
      => '{:require-impl nil,
           :static nil,
           :specialize {},
           :includes #{},
           :native-lu {Puck "@measured/puck",
                       Radix "@radix-ui/themes"},
           :internal {JS.ui -},
           :implements [],
           :lang :js,
           :alias {Puck Puck, Radix Radix},
           :native
           {"@measured/puck" {:as [* Puck]},
            "@radix-ui/themes"
            {:as [* Radix], :bundle {"@radix-ui/themes/styles.css" {}}}},
           :link {- JS.ui},
           :id JS.ui,
           :display :default})

^{:refer lang.core.impl-deps-imports/script-imports :added "4.0"}
(fact "gets the ns imports for a script"

      (deps-imports/script-imports
       (lib/get-book +library-js+ :js)
       (first (deps/collect-script-entries
               (lib/get-book +library-js+ :js)
               ['JS.app/App])))
      => '{"@measured/puck"   {:as [* Puck]},
           "@radix-ui/themes" {:as [* Radix],
                               :bundle {"@radix-ui/themes/styles.css" {}}}})

^{:refer lang.core.impl-deps-imports/module-imports, :added "4.0"}
(fact
  "gets a modules imports as well as code links"
  (deps-imports/module-imports (lib/get-book +library-js+ :js) 'JS.app)
  =>
  '{:native
    {"@measured/puck" {:as [* Puck]},
     "@radix-ui/themes"
     {:as [* Radix], :bundle {"@radix-ui/themes/styles.css" {}}}},
    :direct #{}})


^{:refer lang.core.impl-deps-imports/module-code-deps, :added "4.0"}
(do)

(do)

(do)

(fact:global {:teardown [(doseq [value [+library-js+ +library-lua+]] (lib/reset-all! value) (reset! (:settings value) {}))]})

(require [lang.core.impl-deps-imports :as imports])

(def +app-entry+
  {:id 'main
   :module 'demo.app
   :section :code
   :deps #{'demo.dep/run}
   :deps-native {"app-native" #{'App}}
   :deps-fragment #{'demo.fragments/shared}})

(def +fixture-book+
  {:lang :js
   :grammar {:reserved {}}
   :modules
   {'demo.app {:id 'demo.app
               :lang :js
               :native {"app-native" {:as 'App}}
               :code {'main +app-entry+}}
    'demo.dep {:id 'demo.dep :lang :js :native {} :code {'run {:id 'run :module 'demo.dep
                                                               :section :code :deps #{}}}}
    'demo.fragments
    {:id 'demo.fragments
     :lang :js
     :native {"react" {:as 'React}}
     :fragment
     {'shared {:id 'shared :module 'demo.fragments :section :fragment
               :deps-native {"react" #{'React}}
               :deps-fragment #{'demo.fragments/leaf}}
      'leaf {:id 'leaf :module 'demo.fragments :section :fragment
             :deps-native {"leaf-native" #{'Leaf}}
             :deps-fragment #{}}}
     :code {}}}})

^{:refer lang.core.impl-deps-imports/materialize-import-entry}
(fact "materializes code imports while retaining fragment import entries"
  [(imports/materialize-import-entry +fixture-book+ +app-entry+)
   (imports/materialize-import-entry +fixture-book+
                                     (get-in +fixture-book+
                                             [:modules 'demo.fragments :fragment 'shared]))]
  => [+app-entry+
      (get-in +fixture-book+ [:modules 'demo.fragments :fragment 'shared])])

^{:refer lang.core.impl-deps-imports/get-entry-imports}
(fact "collects native imports for code and already-materialized fragment entries"
  [(imports/get-entry-imports [+app-entry+])
   (imports/get-entry-imports
    +fixture-book+
    [(get-in +fixture-book+ [:modules 'demo.fragments :fragment 'shared])])]
  => [{'demo.app/main {"app-native" #{'App}}}
      {'demo.fragments/shared {"react" #{'React}}}])

^{:refer lang.core.impl-deps-imports/get-namespace-imports}
(fact "merges native symbol sets by owning module and source name"
  (imports/get-namespace-imports
   {'demo.app/a {"app-native" #{'App}}
    'demo.app/b {"app-native" #{'Component}}
    'demo.fragments/shared {"react" #{'React}}})
  => {'demo.app {"app-native" #{'App 'Component}}
      'demo.fragments {"react" #{'React}}})

^{:refer lang.core.impl-deps-imports/get-fragment-deps}
(fact "finds the transitive fragment closure without revisiting a supplied baseline"
  [(imports/get-fragment-deps +fixture-book+ [+app-entry+])
   (imports/get-fragment-deps +fixture-book+ [+app-entry+]
                              #{'demo.fragments/shared})]
  => [#{'demo.fragments/shared 'demo.fragments/leaf}
      #{'demo.fragments/shared}])

^{:refer lang.core.impl-deps-imports/format-namespace-imports}
(fact "selects concrete native module declarations from namespace import symbols"
  (imports/format-namespace-imports
   +fixture-book+
   {'demo.fragments {"react" #{'React} "absent" #{'Missing}}})
  => {"react" {:as 'React}})

^{:refer lang.core.impl-deps-imports/script-import-deps}
(fact "collects native dependency symbols from script code and transitive fragments"
  (imports/script-import-deps +fixture-book+ [+app-entry+])
  => {'demo.app {"app-native" #{'App}}
      'demo.fragments {"react" #{'React}
                       "leaf-native" #{'Leaf}}})

^{:refer lang.core.impl-deps-imports/script-imports}
(fact "formats script native dependencies into the target import declaration map"
  (imports/script-imports +fixture-book+ [+app-entry+])
  => {"app-native" {:as 'App}
      "react" {:as 'React}})

^{:refer lang.core.impl-deps-imports/module-imports}
(fact "returns a module's native imports and derived direct code modules"
  (imports/module-imports +fixture-book+ 'demo.app)
  => {:native {"app-native" {:as 'App}
               "react" {:as 'React}}
      :direct #{'demo.dep}})

^{:refer lang.core.impl-deps-imports/module-imports}
(fact "reports code-derived dependencies without unused declared links"
  (let [book-value (assoc-in +fixture-book+
                             [:modules 'demo.app :link]
                             {'linked 'demo.link})]
    (:direct (imports/module-imports book-value 'demo.app)))
  => #{'demo.dep})

^{:refer lang.core.impl-deps-imports/module-code-deps}
(fact "builds a transitive module dependency graph deterministically"
  [(imports/module-code-deps +fixture-book+ ['demo.app])
   (imports/module-code-deps +fixture-book+ ['demo.dep]
                             {:all #{'demo.app}
                              :graph {'demo.app #{'demo.dep}}})]
  => [{:all #{'demo.app 'demo.dep}
       :graph {'demo.app #{'demo.dep}
               'demo.dep #{}}}
      {:all #{'demo.app 'demo.dep}
       :graph {'demo.app #{'demo.dep}
               'demo.dep #{}}}])

^{:refer (quote tahto.core.impl-deps-imports/get-namespace-imports), :added "4.0"}
(fact
  "retains the prior staged namespace import assertion"
  (imports/get-namespace-imports
    (concat
      '{JS.ui/Puck {"@measured/puck" #{Puck}}}
      '{JS.ui/Button {"@radix-ui/themes" #{Radix}}}))
  =>
  '{JS.ui {"@measured/puck" #{Puck}, "@radix-ui/themes" #{Radix}}})
^{:refer lang.core.impl-deps-imports/materialize-import-entry :id materialize-stale-imports}
(fact "recomputes code import metadata even when stale dependencies are present"
  (let [grammar {:reserved {:plain {:hydrate (fn [form grammar options] [{:hydrated true} 7])}}}
        book {:lang :js :grammar grammar :modules {'demo {:id 'demo :lang :js :link {} :native {}}}}
        stale {:op :plain :section :code :lang :js :module 'demo :id 'run
               :form-input '(unused) :form '(old)
               :deps-native {"stale" #{'Old}}}
        fragment (assoc stale :section :fragment)
        materialized (imports/materialize-import-entry book stale)]
    [(select-keys materialized [:form :deps-native :hydrated])
     (:deps-native stale)
     (= fragment (imports/materialize-import-entry book fragment))])
  => [{:form 7 :deps-native {} :hydrated true} {"stale" #{'Old}} true])
