(ns lang.core.library-test
  (:require [lang.base.book :as b]
            [lang.base.book-entry :as entry]
            [lang.base.book-meta :as meta]
            [lang.base.book-module :as module]
            [lang.base.emit-common :as common]
            [lang.base.emit-helper :as helper]
            [lang.base.grammar :as grammar]
            [lang.core.library :as lib]
            [lang.core.library-snapshot :as snap]
            [lang.core.library-snapshot-prep-test :as prep]
            [lang.base.emit-prep-lua-test :as lua-prep]
            [lang.base.util :as ut]
            [lang.model.v1.spec-lua :as lua])
  (:use code.test))

(do
  (def +migration-owned-libraries+ (atom []))
  (fact:global
    {:teardown
     [(try
        (doseq [library (deref +migration-owned-libraries+)]
          (try
            (lib/reset-all! library)
            (finally (reset! (:settings library) {}))))
        (finally (reset! +migration-owned-libraries+ [])))]})
  (def +library+
   (let [migration-created-library (lib/library
                                     {:snapshot prep/+snap+})]
     (swap! +migration-owned-libraries+ conj migration-created-library)
     migration-created-library)))

(def +contract-book+
  (b/book {:lang :lua
           :meta (:meta lua-prep/+book-empty+)
           :grammar (:grammar lua-prep/+book-empty+)
           :modules {'L.contract (module/book-module {:lang :lua
                                                      :id 'L.contract
                                                      :code {'foo (b/book-entry {:lang :lua
                                                                                 :module 'L.contract
                                                                                 :section :code
                                                                                 :id 'foo
                                                                                 :form-input '(defabstract foo [x])
                                                                                 :namespace 'L.contract})}})
                     'L.impl (module/book-module {:lang :lua
                                                 :id 'L.impl
                                                 :implements ['L.contract]
                                                 :code {'foo (b/book-entry {:lang :lua
                                                                            :module 'L.impl
                                                                            :section :code
                                                                            :id 'foo
                                                                            :form-input '(defn foo [x] x)
                                                                            :namespace 'L.impl})}})}}))

(def +contract-snapshot+
  (snap/snapshot {:lua {:id :lua
                        :book +contract-book+}}))

^{:refer lang.core.library/wait-snapshot, :added "4.0"}
(fact
  "gets the current waiting snapshot"
  (lib/wait-snapshot +library+)
  =>
  (satisfies snap/snapshot?)
  (meta (lib/wait-snapshot +library+))
  =>
  {:parent nil})

^{:refer lang.core.library/wait-apply, :added "4.0"}
(fact
  "get the library state when task queue is empty"
  (snap/snapshot? (lib/wait-apply +library+ identity))
  (lib/wait-apply +library+ snap/get-book :lua)
  =>
  (satisfies b/book?)
  (lib/wait-apply +library+ deps-ordered [:lua.redis])
  =>
  '(:x :lua :lua.redis))

^{:refer lang.core.library/wait-mutate!, :added "4.0"}
(fact
  "mutates library once task queue is empty"
  (-> +library+
   (doto (lib/wait-mutate! snap/delete-module :x 'x.core))
   (lib/wait-apply snap/get-book :x)
   (b/list-entries))
  =>
  ()
  (do
    (lib/add-module! +library+ prep/+x-module+)
    (when (not
            (=
              (keys
                (get-in
                  (lib/get-snapshot +library+)
                  [:x :book :modules]))
              '(x.core)))
      (throw
        (ex
          :migration/assertion
          {}
          :ex/message
          "Historical Library assertion failed")))))

^{:refer lang.core.library/get-snapshot, :added "4.0"}
(fact
  "gets the current snapshot for the library"
  (lib/get-snapshot +library+)
  =>
  (satisfies snap/snapshot?))

^{:refer lang.core.library/snapshot-find-module, :added "4.1"}
(fact
  "finds a module anywhere in the merged library snapshot"
  (-> (lib/snapshot-find-module prep/+snap+ 'L.core) first)
  =>
  :lua
  (-> (lib/snapshot-find-module prep/+snap+ 'L.core) second)
  =>
  (satisfies module/book-module?)
  (-> (lib/snapshot-find-module prep/+snap+ 'x.core) first)
  =>
  :x
  (lib/snapshot-find-module prep/+snap+ 'missing.module)
  =>
  nil)

^{:refer lang.core.library/entry-arity :added "4.1"}
(fact "returns the arity of an entry from its input form"

  (lib/entry-arity {:form-input '(defn add-fn [a b] (+ a b))})
  => 2

  (lib/entry-arity {:form-input '(defn no-args [] x)})
  => 0

  (lib/entry-arity {:form-input '(do something)})
  => nil)

^{:refer lang.core.library/entry-abstract? :added "4.1"}
(fact "checks if an entry was declared with `defabstract`"

  (lib/entry-abstract? {:form-input '(defabstract foo [x])})
  => true

  (lib/entry-abstract? {:form-input '(defn foo [x] x)})
  => false

  (lib/entry-abstract? {:form-input "not a seq"})
  => false)

^{:refer lang.core.library/validate-module-implements :added "4.1"}
(fact "checks that a module satisfies all declared abstract contracts"

  (lib/validate-module-implements +contract-snapshot+ :lua 'L.impl)
  => true

  (lib/validate-module-implements (snap/snapshot
                                   {:lua {:id :lua
                                          :book (assoc-in +contract-book+
                                                          [:modules 'L.impl :code]
                                                          {})}})
                                  :lua
                                  'L.impl)
  => (throws-info {:missing '[foo]})

  (lib/validate-module-implements (snap/snapshot
                                   {:lua {:id :lua
                                          :book (assoc-in +contract-book+
                                                          [:modules 'L.impl :code 'foo :form-input]
                                                          '(defn foo [x y] x))}})
                                  :lua
                                  'L.impl)
  => (throws-info {:mismatched '[{:id foo
                                  :expected 1
                                  :actual 2}]}))

^{:refer lang.core.library/get-book, :added "4.0"}
(fact
  "gets a book from library"
  (lib/get-book +library+ :x)
  =>
  (satisfies b/book?))

^{:refer lang.core.library/get-book-raw, :added "4.0"}
(fact
  "gets the raw book, without merge"
  (b/list-entries (lib/get-book-raw +library+ :lua.redis))
  =>
  (satisfies empty?)
  (b/list-entries (lib/get-book +library+ :lua.redis))
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value)))))

^{:refer lang.core.library/get-module, :added "4.0"}
(fact
  "gets a module from library"
  (lib/get-module +library+ :x 'x.core)
  =>
  (satisfies module/book-module?))

^{:refer lang.core.library/get-entry, :added "4.0"}
(fact
  "gets an entry from library"
  (lib/get-entry
    +library+
    '{:lang :lua, :module L.core, :section :fragment, :id sub})
  =>
  (satisfies entry/book-entry?))

^{:refer lang.core.library/add-book!, :added "4.0"}
(fact
  "adds a book to the library"
  (lib/add-book!
    +library+
    (b/book
      (b/book
        {:lang :js,
         :parent :x,
         :meta (meta/book-meta {}),
         :grammar
         (grammar/grammar
           :js
           (grammar/to-reserved (grammar/build))
           helper/+default+)})))
  (lib/wait-apply +library+ deps-ordered [:js])
  =>
  '(:x :js)
  (lib/delete-book! +library+ :js)
  =>
  (any (satisfies nil?) (satisfies map?)))

^{:refer lang.core.library/delete-book! :added "4.0"}
(fact "deletes a book"
  (lib/delete-book! +library+ :js) => nil)

^{:refer lang.core.library/reset-all!, :added "4.0"}
(fact
  "resets the library"
  (lib/reset-all! +library+ (lib/reset-all! +library+))
  =>
  (satisfies snap/snapshot?))

^{:refer lang.core.library/list-modules :added "4.0"}
(fact "lists all modules"

  (lib/list-modules +library+ :lua)
  => (contains ['L.core 'x.core]
               :in-any-order :gaps-ok))

^{:refer lang.core.library/list-entries :added "4.0"}
(fact "lists entries"

  (lib/list-entries +library+ :lua)
  => '(L.core/identity-fn)

  (lib/list-entries +library+ :lua 'L.core)
  => '{:code (identity-fn), :fragment (add sub)})

^{:refer lang.core.library/add-module!, :added "4.0"}
(fact
  "adds a module to the library"
  (lib/add-module!
    +library+
    (module/book-module
      '{:lang :lua.redis,
        :id L.redis.hello,
        :link {r L.redis, u L.core}}))
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value))))
  (lib/delete-module! +library+ :lua.redis 'L.redis.hello)
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value)))))

^{:refer lang.core.library/delete-module!, :added "4.0"}
(fact
  "deletes a module from the library"
  (lib/delete-module! +library+ :lua.redis 'L.redis.hello)
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value)))))

^{:refer lang.core.library/delete-modules!, :added "4.0"}
(fact
  "deletes a bunch of modules from the library"
  (lib/delete-modules! +library+ :lua.redis ['L.redis.hello])
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value)))))

^{:refer lang.core.library/library-string, :added "4.0"}
(fact
  "returns the library string"
  (lib/library-string +library+)
  =>
  (satisfies string?))

^{:refer lang.core.library/library? :added "4.0"}
(fact "checks if object is a library"

  (lib/library? +library+)
  => true)

^{:refer lang.core.library/library:create, :added "4.0"}
(fact
  "creates a new library"
  (let [migration-created-library (lib/library:create {})]
    (swap! +migration-owned-libraries+ conj migration-created-library)
    migration-created-library)
  =>
  (satisfies lib/library?))

^{:refer lang.core.library/library, :added "4.0"}
(fact
  "creates and start a new library"
  (let [migration-created-library (lib/library {})]
    (swap! +migration-owned-libraries+ conj migration-created-library)
    migration-created-library)
  =>
  (satisfies lib/library?))

(do)

^{:refer lang.core.library/add-entry-single!, :added "4.0"}
(fact
  "adds an entry synchronously"
  (lib/delete-entry!
    +library+
    {:lang :lua, :section :code, :module 'L.core, :id 'add-fn})
  (lib/add-entry-single!
    +library+
    (b/book-entry
      {:lang :lua,
       :section :code,
       :namespace (ns-current),
       :module 'L.core,
       :id 'add-fn,
       :form-input '(defn add-fn [x y] (return (+ x y))),
       :deps #{}}))
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value)))))

^{:refer lang.core.library/delete-entry!, :added "4.0"}
(fact
  "deletes an entry from the library"
  (lib/delete-entry!
    +library+
    {:lang :lua, :module 'L.core, :id 'add-fn})
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value)))))

^{:refer lang.core.library/install-module!, :added "4.0"}
(fact
  "installs a module to library"
  (lib/delete-module! +library+ :lua 'L.util)
  (lib/install-module! +library+ :lua 'L.util {})
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value)))))

(code.test.registry/register
  'lang.core.library-test
  {:desc "installs a specialized module clone into the library",
   :meta
   {:refer 'lang.core.library/install-module-specialized!,
    :added "4.1"},
   :function
   (fn [_]
     (let [+specialized-lib+ (let [migration-created-library
                                   (lib/library
                                     {:snapshot prep/+snap+})]
                               (swap!
                                 +migration-owned-libraries+
                                 conj
                                 migration-created-library)
                               migration-created-library)]
       (try
         (lib/install-module-specialized!
           +specialized-lib+
           :lua
           'L.core
           'L.core.specialized
           {})
         [(code.test.base.process/check
            (fn []
              (lib/get-module
                +specialized-lib+
                :lua
                'L.core.specialized))
            (satisfies module/book-module?))
          (code.test.base.process/check
            (fn []
              (-> (lib/get-module
                    +specialized-lib+
                    :lua
                    'L.core.specialized)
               :id))
            'L.core.specialized)]
         (finally
           (lib/reset-all! +specialized-lib+)
           (reset! (:settings +specialized-lib+) {})))))})

^{:refer lang.core.library/install-book!, :added "4.0"}
(fact
  "installs a book to library"
  (lib/delete-book! +library+ :lua.redis)
  (lib/install-book! +library+ prep/+book-lua-redis-empty+)
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value))))
  (:parent (lib/get-book-raw +library+ :lua.redis))
  =>
  :lua
  (:parent prep/+book-lua-redis-empty+)
  =>
  :lua)

^{:refer lang.core.library/purge-book!, :added "4.0"}
(fact
  "clears all modules from book"
  (lib/purge-book! +library+ :lua)
  =>
  (satisfies
    (fn [value]
      (or (coll? value) (form? value) (iter? value) (b/book? value)))))

(do)
^{:refer lang.core.library/reset-all! :id historical-fixture-cleanup}
(fact "clears every tracked historical Library and repeats teardown idempotently"
 (let [owned (vec (deref +migration-owned-libraries+))
       teardown (:after-all (deref code.test.registry/+lifecycle-config+))]
  (teardown)
  [(count owned)
   (vec (map (fn [library] [(into {} (deref (:instance library))) (deref (:settings library))]) owned))
   (deref +migration-owned-libraries+)
   (do (teardown) (deref +migration-owned-libraries+))])
 => [4 [[{} {}] [{} {}] [{} {}] [{} {}]] [] []])

^{:refer lang.core.library/add-entry! :id supplied-dispatch-contract}
(fact "passes the original entry to the supplied dispatcher and propagates its outcome"
 (let [library (lib/library:create {})
       calls (atom [])
       entry lua-prep/+core-fragment-add+
       accepting (assoc library :dispatch (fn [value] (swap! calls conj value) [:queued (:id value)]))
       rejecting (assoc library :dispatch (fn [_] (throw (ex :migration/dispatch {} :ex/message "dispatch failed"))))]
  (try
   [(lib/add-entry! accepting entry)
    (= [entry] (deref calls))
    (try (lib/add-entry! rejecting entry) :unexpected (catch error (ex-message error)))
    (into {} (deref (:instance library)))]
   (finally (lib/reset-all! library) (reset! (:settings library) {}) (reset! calls []))))
 => [[:queued 'add] true "dispatch failed" {}])

(require [lang.model.v1.spec-xtalk :as xt])
^{:refer lang.core.library/wait-snapshot :id parent-module-overlay}
(fact "overlays child modules while retaining the parent's Book fields and snapshot metadata"
 (let [parent-book (assoc xt/+book+ :modules {'shared {:owner :parent} 'base {:owner :parent}} :scope :parent)
       child-book (assoc xt/+book+ :modules {'shared {:owner :child} 'local {:owner :child}} :scope :child)
       parent (lib/library:create {:snapshot (snap/add-book (snap/snapshot {}) parent-book)})
       child (lib/library:create {:parent parent :snapshot (snap/add-book (snap/snapshot {}) child-book)})]
  (try
   (let [result (lib/wait-snapshot child)
         resolved (snap/get-book-raw result :xtalk)]
    [(:modules resolved) (:scope resolved)
     (= (lib/wait-snapshot parent) (:parent (meta result)))
     (= child-book (snap/get-book-raw (deref (:instance child)) :xtalk))
     (= parent-book (snap/get-book-raw (deref (:instance parent)) :xtalk))])
   (finally (lib/reset-all! child) (reset! (:settings child) {})
            (lib/reset-all! parent) (reset! (:settings parent) {}))))
 => [{'shared {:owner :child} 'base {:owner :parent} 'local {:owner :child}} :parent true true true])
^{:refer lang.core.library/wait-snapshot :id parent-supplier-live}
(fact "resolves a parent supplier again after parent state changes"
 (let [parent (lib/library:create {})
       calls (atom 0)
       child (lib/library:create {:parent (fn [] (swap! calls inc) parent)})]
  (try
   (let [before (lib/wait-snapshot child)
         _ (lib/install-book! parent xt/+book+)
         after (lib/wait-snapshot child)]
    [(into {} before) (set (keys after)) (deref calls)
     (into {} (deref (:instance child)))])
   (finally (lib/reset-all! child) (reset! (:settings child) {})
            (lib/reset-all! parent) (reset! (:settings parent) {}) (reset! calls 0))))
 => [{} #{:xtalk} 2 {}])
^{:refer lang.core.library/wait-mutate! :id strict-rejection-atomic}
(fact "strict validation rejects merged Books before committing the local snapshot"
 (let [value (lib/library:create {})
       merged (assoc xt/+book+ :merged #{:xtalk :lua})]
  (try
   (let [before (deref (:instance value))
         previous-strict lib/*strict*
         error (binding [lib/*strict* true]
                 (try (lib/wait-mutate! value
                        (fn [state] [:invalid (snap/add-book state merged)]))
                      :unexpected (catch error (ex-message error))))
         unchanged (= before (deref (:instance value)))
         accepted (binding [lib/*strict* false]
                    (lib/wait-mutate! value
                     (fn [state] [:accepted (snap/add-book state merged)])))]
    [error unchanged (= previous-strict lib/*strict*) accepted
     (= merged (snap/get-book-raw (deref (:instance value)) :xtalk))])
   (finally (binding [lib/*strict* false] (lib/reset-all! value))
            (reset! (:settings value) {}))))
 => ["MERGED BOOK DISALLOWED" true true :accepted true])
(def ^:dynamic *parent-fixture* nil)
(defn parent-supplier [] *parent-fixture*)
^{:refer lang.core.library/wait-snapshot :id parent-var-supplier}
(fact "dereferences a Var parent supplier before invoking it"
 (let [parent (lib/library:create {:snapshot (snap/add-book (snap/snapshot {}) xt/+book+)})]
  (binding [*parent-fixture* parent]
   (let [child (lib/library:create {:parent (var parent-supplier)})]
    (try
     [(set (keys (lib/wait-snapshot child))) (into {} (deref (:instance child)))]
     (finally (lib/reset-all! child) (reset! (:settings child) {})
              (lib/reset-all! parent) (reset! (:settings parent) {}))))))
 => [#{:xtalk} {}])

^{:refer lang.core.library/library:create :id native-constructor-baseline}
(fact "uses the original constructor fields and independent local state"
  (let [value (lib/library:create {:id :requested})
        other (lib/library:create {})]
    (try
      [(lib/library? value) (lib/library? {})
       (:id value) (:parent value)
       (into {} (deref (:instance value)))
       (= value (:library (deref (:settings value))))
       (do (lib/add-book! value prep/+book-x+) (into {} (deref (:instance other))))]
      (finally (lib/reset-all! value) (reset! (:settings value) {})
               (lib/reset-all! other) (reset! (:settings other) {}))))
  => [true false nil nil {} true {}])

^{:refer lang.core.library/reset-all! :id native-snapshot-restore-roundtrip}
(fact "reset returns the prior snapshot and supports idempotent clearing and exact restore"
  (let [value (lib/library:create {:snapshot (snap/snapshot-reset prep/+snap+)})]
    (try
      (let [before (deref (:instance value))
            previous (lib/reset-all! value)
            empty-first (into {} (deref (:instance value)))
            empty-second (lib/reset-all! value)
            replaced (lib/reset-all! value previous)]
        [(= before previous) empty-first (into {} empty-second)
         (into {} replaced) (= before (deref (:instance value)))])
      (finally (lib/reset-all! value) (reset! (:settings value) {}))))
  => [true {} {} {} true])

^{:refer lang.core.library/delete-module! :id native-local-delete-parent-preserved}
(fact "deleting a local module reveals its inherited parent without changing parent state"
  (let [base (snap/snapshot-reset prep/+snap+)
        parent (lib/library:create {:snapshot base})
        child (lib/library:create {:parent parent :snapshot base})]
    (try
      (lib/add-module! parent (module/book-module {:lang :lua :id 'demo.module :native-marker :parent}))
      (lib/add-module! child (module/book-module {:lang :lua :id 'demo.module :native-marker :child}))
      (let [before (:native-marker (lib/get-module child :lua 'demo.module))
            removed (lib/delete-module! child :lua 'demo.module)]
        [before (first (first removed))
         (:native-marker (lib/get-module child :lua 'demo.module))
         (get-in (deref (:instance child)) [:lua :book :modules 'demo.module])
         (:native-marker (lib/get-module parent :lua 'demo.module))
         (get-in (lib/get-book-raw child :lua) [:modules 'demo.module :native-marker])])
      (finally (lib/reset-all! child) (reset! (:settings child) {})
               (lib/reset-all! parent) (reset! (:settings parent) {}))))
  => [:child [:modules 'demo.module] :parent nil :parent :parent])

^{:refer lang.core.library/add-entry-single! :id native-entry-mutation-results}
(fact "synchronous entry changes preserve identity fields and original mutation diff paths"
  (let [value (lib/library:create {:snapshot (snap/snapshot-reset prep/+snap+)})]
    (try
      (let [module-diff (lib/add-module! value (module/book-module {:lang :lua :id 'demo.module}))
            data (entry/book-entry {:lang :lua :module 'demo.module :section :code :id 'value :native-marker :kept})
            entry-diff (lib/add-entry-single! value data)
            stored (lib/get-entry value data)
            listed (vec (lib/list-entries value :lua 'demo.module :code))
            deleted (lib/delete-entry! value data)]
        [(first (first module-diff)) (first (first entry-diff))
         (select-keys stored [:lang :module :section :id :native-marker])
         listed (first (first deleted))
         (lib/get-entry value data)
         (vec (lib/list-entries value :lua 'demo.module :code))])
      (finally (lib/reset-all! value) (reset! (:settings value) {}))))
  => [[:modules 'demo.module] [:modules 'demo.module :code 'value]
      {:lang :lua :module 'demo.module :section :code :id 'value :native-marker :kept}
      ['value] [:modules 'demo.module :code 'value] nil []])

^{:refer lang.core.library/purge-book! :id native-purge-preserves-grammar}
(fact "purge clears only the selected language modules and retains its Book"
  (let [value (lib/library:create {:snapshot (snap/snapshot-reset prep/+snap+)})]
    (try
      (lib/add-module! value (module/book-module {:lang :lua :id 'a}))
      (lib/add-module! value (module/book-module {:lang :lua :id 'b}))
      (lib/add-module! value (module/book-module {:lang :x :id 'parent.module}))
      (let [grammar (:grammar (lib/get-book-raw value :lua))
            purged (lib/purge-book! value :lua)]
        [(:lang purged) (:modules purged)
         (get-in (deref (:instance value)) [:lua :book :modules])
         (= grammar (:grammar (lib/get-book-raw value :lua)))
         (get-in (deref (:instance value)) [:x :book :modules 'parent.module :id])])
      (finally (lib/reset-all! value) (reset! (:settings value) {}))))
  => [:lua {} {} true 'parent.module])

^{:refer lang.core.library/*strict* :id native-strict-binding}
(fact "strict mode defaults off and its binding is restored after normal and exceptional exits"
  (let [before lib/*strict*]
    [before
     (binding [lib/*strict* true] lib/*strict*)
     (try (binding [lib/*strict* true] (throw (ex :migration/expected {})))
          (catch error :caught))
     (= before lib/*strict*)])
  => [false true :caught true])

^{:refer lang.core.library/+ops+ :id native-original-operation-table}
(fact "the original operation table preserves keys mutation pairs and immutable snapshots"
  (let [empty (snap/snapshot {})
        [language added] ((get lib/+ops+ :add-book) empty prep/+book-x+)
        data (entry/book-entry {:lang :x :module 'demo.module :section :code :id 'value})
        [module-diff with-module] ((get lib/+ops+ :set-module) added
                                   (module/book-module {:lang :x :id 'demo.module :code {'value data}}))
        [entry-diff without-entry] ((get lib/+ops+ :delete-entry) with-module data)
        [delete-diff without-module] ((get lib/+ops+ :delete-module) without-entry :x 'demo.module)
        [deleted-language without-book] ((get lib/+ops+ :delete-book) without-module :x)]
    [(set (keys lib/+ops+)) language
     (first (first module-diff)) (first (first entry-diff))
     (get-in without-entry [:x :book :modules 'demo.module :code 'value])
     (first (first delete-diff)) deleted-language (into {} without-book) (into {} empty)])
  => [#{:add-book :delete-book :set-module :delete-module :delete-entry} :x
      [:modules 'demo.module] [:modules 'demo.module :code 'value] nil
      [:modules 'demo.module] :x {} {}])

^{:refer lang.core.library/install-module-specialized! :id native-specialized-module-state}
(fact "specialization returns original installation status and keeps source and cloned module identities separate"
  (let [value (lib/library:create {:snapshot prep/+snap+})]
    (try
      (let [[snapshot status installed] (lib/install-module-specialized!
                                        value :lua 'L.core 'L.core.native-copy {})
            copied (lib/get-module value :lua 'L.core.native-copy)]
        [status (:id installed) (:id copied) (get-in copied [:link '-])
         (:id (lib/get-module value :lua 'L.core))
         (get-in snapshot [:lua :book :modules 'L.core.native-copy :id])])
      (finally (lib/reset-all! value) (reset! (:settings value) {}))))
  => [:new 'L.core.native-copy 'L.core.native-copy 'L.core.native-copy 'L.core 'L.core.native-copy])
