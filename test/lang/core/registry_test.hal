(ns lang.core.registry-test
  (:use code.test)
  (:require [lang.core.registry :refer :all]))

^{:refer lang.core.registry/registry-book-list :added "4.1"}
(fact "lists all registered books"
  (let [books (set (registry-book-list))]
    [(has? books [:js :default])
      (has? books [:lua :default])
      (has? books [:lua.nginx :default])
      (has? books [:lua.redis :default])
      (has? books [:postgres :default])])
  => [true true true true true])

^{:refer lang.core.registry/registry-book-ns :added "4.1"}
(fact "gets the namespace for a registry entry"
  (registry-book-ns :js)
  => 'lang.model.v1.spec-js

  (registry-book-ns :circom)
  => 'lang.model.annex.spec-circom

  (registry-book-ns :fortran)
  => 'lang.model.annex.spec-fortran

  (registry-book-ns :llvm)
  => 'lang.model.spec-llvm

  (registry-book-ns :solidity)
  => 'lang.model.spec-solidity

  (registry-book-ns :ruby)
  => 'lang.model.spec-ruby

  (registry-book-ns :verilog)
  => 'lang.model.annex.spec-verilog)

^{:refer lang.core.registry/registry-book-info :added "4.1"}
(fact "gets the full registry entry"
  (registry-book-info :js)
  => '{:ns lang.model.v1.spec-js
       :book +book+
       :parent :xtalk})

^{:refer lang.core.registry/registry-book-info, :id registry-lua-variants}
(fact
  "gets variant lua book info"
  (registry-book-info :lua.redis)
  =>
  '{:ns lang.model.spec-lua.variant-redis, :book +book+, :parent :lua}
  (registry-book-info :lua.nginx)
  =>
  '{:ns lang.model.spec-lua.variant-nginx, :book +book+, :parent :lua})

^{:refer lang.core.registry/registry-book, :added "4.1"}
(comment :deferred-original-model-loading)

^{:refer lang.core.registry/+registry+}
(fact "keeps the original runtime coordinate values and supports exact restoration"
  (let [before (deref +registry+)]
    (try
      (let [original [(get before [:js :basic]) (get before [:lua :basic]) (get before [:python :basic])]]
        (reset! +registry+ {})
        (reset! +registry+ before)
        [original (= before (deref +registry+))])
      (finally (reset! +registry+ before))))
  => [['lang.runtime.basic.impl.process-js 'lang.runtime.basic.impl.process-lua
       'lang.runtime.basic.impl.process-python] true])

^{:refer lang.core.registry/+book-registry+}
(fact "keeps unversioned variant descriptors and restores all registry entries"
  (let [before (deref +book-registry+)]
    (try
      (let [variant (get before [:lua.redis :default])]
        (reset! +book-registry+ {})
        (reset! +book-registry+ before)
        [variant (= before (deref +book-registry+))])
      (finally (reset! +book-registry+ before))))
  => [{:ns 'lang.model.spec-lua.variant-redis :book '+book+ :parent :lua} true])

^{:refer lang.core.registry/registry-book}
(fact "loads the registered namespace and returns its Var value without a selection cache"
  (let [before (deref +book-registry+)]
    (try
      (reset! +book-registry+
        {[:contract :default] {:ns 'migration.registry-value-fixture :book 'fixture-value}
         [:contract :missing-var] {:ns 'migration.registry-value-fixture :book 'absent}})
      [(registry-book :contract) (registry-book :contract :missing-var) (registry-book :absent)]
      (finally (reset! +book-registry+ before))))
  => [{:origin :registered-var} nil nil])
