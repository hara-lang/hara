(ns lang.core.script-test
  (:require [lang.core.library :as library]
            [lang.core.registry :as registry]
            [lang.core.runtime :as runtime]
            [lang.core.script :as script]))

(defn isolated
  [function]
  (let [snapshot (script/script-snapshot)]
    (try
      (script/script-reset!)
      (function)
      (finally (script/script-restore! snapshot)))))

(def schema-fixture :scalar)

^{:refer lang.core.script/script-snapshot}
(Test/check [{:name "captures empty script state"
              :test (fn [] (let [value (isolated script/script-snapshot)]
                             [(dissoc value :library)
                              (select-keys (:library value) [:revision :books :selected])]))
              :expected [{:modules {} :scripts {} :loaded-modules {}
                          :module-contexts {} :compile-cache {}}
                         {:revision 0 :books {} :selected {}}]}])

^{:refer lang.core.script/script-restore!}
(Test/check [{:name "restores script registries"
              :test (fn [] (let [value (isolated (fn []
                                                    (script/script-restore! {:modules {'demo {:id 'demo}}
                                                                             :scripts {} :loaded-modules {}
                                                                             :module-contexts {} :compile-cache {}})))]
                             [(dissoc value :library)
                              (select-keys (:library value) [:revision :books :selected])]))
              :expected [{:modules {'demo {:id 'demo}}
                          :scripts {} :loaded-modules {} :module-contexts {} :compile-cache {}}
                         {:revision 0 :books {} :selected {}}]}])

^{:refer lang.core.script/script-reset!}
(Test/check [{:name "clears script state idempotently"
              :test (fn [] (isolated (fn [] (mapv (fn [value]
                                                    (dissoc value :library))
                                                  [(script/script-reset!) (script/script-reset!)]))))
              :expected [{:modules {} :scripts {} :loaded-modules {} :module-contexts {} :compile-cache {}}
                         {:modules {} :scripts {} :loaded-modules {} :module-contexts {} :compile-cache {}}]}])

^{:refer lang.core.script/reset-compile-cache!}
(Test/check [{:name "clears only structural compile cache"
              :test (fn [] (isolated (fn []
                                       (swap! script/+compile-cache+ assoc :entry :result)
                                       (script/reset-compile-cache!)
                                       (deref script/+compile-cache+))))
              :expected {}}])

^{:refer lang.core.script/with:cache-none}
(Test/check [{:name "binds cache bypass for an enclosed form"
              :test (fn [] (script/with:cache-none script/*cache-none*))
              :expected true}])

^{:refer lang.core.script/with:cache-force}
(Test/check [{:name "binds cache refresh for an enclosed form"
              :test (fn [] (script/with:cache-force script/*cache-force*))
              :expected true}])

^{:refer lang.core.script/namespace-symbol}
(Test/check [{:name "returns the current source namespace"
              :test (fn [] (script/namespace-symbol))
              :expected 'lang.core.script}])

^{:refer lang.core.script/module-symbol}
(Test/check [{:name "uses configured module mapping when present"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.script {})
                                       (script/module-symbol))))
              :expected 'demo.script}])

^{:refer lang.core.script/current-module-id}
(Test/check [{:name "publishes the current logical module id"
              :test (fn [] (script/current-module-id))
              :expected 'lang.core.script}])

^{:refer lang.core.script/symbol-id}
(Test/check [{:name "drops a symbol namespace for entry ids"
              :test (fn [] (script/symbol-id 'demo/value))
              :expected 'value}])

^{:refer lang.core.script/require-module}
(Test/check [{:name "extracts module ids from require specs"
              :test (fn [] [(script/require-module 'demo.a)
                            (script/require-module ['demo.b :as 'b])])
              :expected ['demo.a 'demo.b]}])

^{:refer lang.core.script/require-primary?}
(Test/check [{:name "recognizes only explicit primary require specs"
              :test (fn [] [(script/require-primary? 'demo.a)
                            (script/require-primary? ['demo.a :primary true])])
              :expected [false true]}])

^{:refer lang.core.script/require-link}
(Test/check [{:name "derives default and aliased require links"
              :test (fn [] [(script/require-link 'demo.a)
                            (script/require-link ['demo.b :as 'b])])
              :expected [['demo.a 'demo.a] ['b 'demo.b]]}])

^{:refer lang.core.script/module-config}
(Test/check [{:name "creates source-faithful module data"
              :test (fn [] (select-keys (script/module-config :postgres 'demo.a
                                                              {:require ['demo.b]
                                                               :emit {:code {:transforms {:entry ['demo/transform]}}}})
                                        [:id :lang :require :link :code :fragment :emit]))
              :expected {:id 'demo.a :lang :postgres :require ['demo.b]
                         :link {'- 'demo.a 'demo.b 'demo.b} :code {} :fragment {}
                         :emit {:code {:transforms {:entry ['demo/transform]}}}}}])

^{:refer lang.core.script/configure-module}
(Test/check [{:name "registers module source against the current namespace"
              :test (fn [] (isolated (fn []
                                       (select-keys (script/configure-module :postgres 'demo.a {:static {:mode :test}})
                                                    [:id :lang :static]))))
              :expected {:id 'demo.a :lang :postgres :static {:mode :test}}}
             {:name "keeps source module configuration local to its target language"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a
                                                                 {:static {:application ["scratch"]}})
                                       [(select-keys (script/configure-module :xtalk 'demo.a {})
                                                     [:id :lang :static])
                                        (select-keys (library/library-get-module
                                                      (library/default-library) :postgres 'demo.a)
                                                     [:id :lang :static])])))
              :expected [{:id 'demo.a :lang :xtalk}
                         {:id 'demo.a :lang :postgres
                          :static {:application ["scratch"]}}]}])

^{:refer lang.core.script/portable-schema-form}
(Test/check [{:name "recursively retains portable schema data"
              :test (fn [] (script/portable-schema-form {:a [#{'demo/a}]}))
              :expected {:a [#{'demo/a}]}}])

^{:refer lang.core.script/schema-value-form}
(Test/check [{:name "ignores ordinary declaration Vars"
              :test (fn [] (let [value (var schema-fixture)]
                           (script/schema-value-form value)))
              :expected nil}])

^{:refer lang.core.script/module-source-symbol}
(Test/check [{:name "resolves a module owner from source contexts"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (script/module-source-symbol 'demo.a))))
              :expected 'lang.core.script}
             {:name "resolves a generic source module through a target Book parent"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :xtalk 'demo.a {})
                                       (script/module-source-symbol :js 'demo.a))))
              :expected 'lang.core.script}])

^{:refer lang.core.script/module-schema-values}
(Test/check [{:name "collects no scalar schema declarations"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (script/module-schema-values 'demo.a))))
              :expected {}}])

^{:refer lang.core.script/refresh-module-schemas}
(Test/check [{:name "merges collected schemas into the module"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (select-keys (script/refresh-module-schemas 'demo.a) [:id :schema]))))
              :expected {:id 'demo.a :schema {}}}
             {:name "updates a generic module when it is requested by a target Book"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :xtalk 'demo.a {})
                                       (select-keys (script/refresh-module-schemas :js 'demo.a)
                                                    [:id :lang :schema]))))
              :expected {:id 'demo.a :lang :xtalk :schema {}}}])

^{:refer lang.core.script/register-code}
(Test/check [{:name "builds registered code symbols"
              :test (fn [] (symbol (str 'demo.a "/" (name 'exposed))))
              :expected 'demo.a/exposed}])

^{:refer lang.core.script/code-operation-key}
(Test/check [{:name "retains every portable declaration operation instead of collapsing it to def"
              :test (fn [] [(script/code-operation-key '(defn ping [] "pong"))
                            (script/code-operation-key '(deftype Log []))
                            (script/code-operation-key '(deftrigger audit []))
                            (script/code-operation-key '(defenum Status []))
                            (script/code-operation-key '(defconst version 1))
                            (script/code-operation-key '(def value 1))])
              :expected [:defn :deftype :deftrigger :defenum :defconst :def]}])

^{:refer lang.core.script/register-code}
(Test/check [{:name "registers code in the logical module"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (script/register-code '(defn exposed [] 1))
                                       (select-keys (get-in (deref script/+modules+) ['demo.a :code 'exposed])
                                                    [:id :module :lang :section :op]))))
              :expected {:id 'exposed :module 'demo.a :lang :postgres :section :code :op 'defn}}])

^{:refer lang.core.script/register-code}
(Test/check [{:name "retains declaration metadata for typed compiler consumers"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (script/register-code
                                        :postgres
                                        '(defn exposed [] 1)
                                        {:static/public true
                                         :api/meta {:kind :test}})
                                       (select-keys
                                        (library/library-get-entry (library/default-library)
                                                                   :postgres 'demo.a :code 'exposed)
                                        [:static/public :api/meta]))))
              :expected {:static/public true :api/meta {:kind :test}}}])

^{:refer lang.core.script/register-code}
(Test/check [{:name "merges generated declaration metadata into the registered source form"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :go 'demo.a {})
                                       (let [entry (script/register-code
                                                    :go
                                                    '(defn generated [] 1)
                                                    {:- [:int]})]
                                         [(get entry :-)
                                          (:declaration-meta entry)
                                          (get (meta (second (:form entry))) :-)]))))
              :expected [[:int] {:- [:int]} [:int]]}])

^{:refer lang.core.script/register-fragment}
(Test/check [{:name "associates fragment data into an atom"
              :test (fn [] (let [entries (atom {})]
                           (swap! entries assoc-in ['demo.a :fragment 'hidden] {:id 'hidden})
                           (get-in (deref entries) ['demo.a :fragment 'hidden :id])))
              :expected 'hidden}])

^{:refer lang.core.script/register-fragment}
(Test/check [{:name "registers fragments in the logical module"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (script/register-fragment '(defmacro hidden [] 1) nil)
                                       (select-keys (get-in (deref script/+modules+) ['demo.a :fragment 'hidden])
                                                    [:id :module :lang :section]))))
              :expected {:id 'hidden :module 'demo.a :lang :postgres :section :fragment}}])

^{:refer lang.core.script/register-fragment}
(Test/check [{:name "retains fragment declaration metadata"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (script/register-fragment
                                        :postgres
                                        '(defmacro hidden [] 1)
                                        nil
                                        {:static/return [:text]})
                                       (select-keys
                                        (library/library-get-entry (library/default-library)
                                                                   :postgres 'demo.a :fragment 'hidden)
                                        [:static/return]))))
              :expected {:static/return [:text]}}])

^{:refer lang.core.script/register-fragment-pointer}
(Test/check [{:name "registers portable fragment pointers with retained return metadata"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (let [value (script/register-fragment-pointer
                                                    :postgres 'helper '(auth.uid)
                                                    {:- [:uuid]})
                                             entry (get-in (deref script/+modules+)
                                                           ['demo.a :fragment 'helper])]
                                         [(pointer? value)
                                          (IPointer/ptr-context value)
                                          (:op entry)
                                          (:static/return entry)]))))
              :expected [true :lang/postgres 'def$ [:uuid]]}])

^{:refer lang.core.script/register-macro-fragment}
(Test/check [{:name "registers source macro fragments with their compiler template"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (script/register-macro-fragment
                                        :postgres
                                        '(defmacro auth-uid [] '(auth.uid))
                                        (fn [] '(auth.uid)))
                                       (let [entry (get-in (deref script/+modules+)
                                                           ['demo.a :fragment 'auth-uid])]
                                         [(select-keys entry [:lang :section :op :op-key])
                                          (fn? (:template entry))]))))
              :expected [{:lang :postgres :section :fragment
                          :op 'defmacro :op-key :defmacro}
                         true]}])

^{:refer lang.core.script/script-context}
(Test/check [{:name "creates stable language pointer contexts"
              :test (fn [] (script/script-context :postgres))
              :expected :lang/postgres}])

^{:refer lang.core.script/register-code-pointer}
(Test/check [{:name "registers code and returns the corresponding native pointer"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (let [value (script/register-code-pointer
                                                    :postgres
                                                    '(deftype Log [])
                                                    {:public true})]
                                         [(pointer? value)
                                         (IPointer/ptr-context value)
                                         (get-in value [:entry :id])
                                         (get-in value [:entry :op-key])
                                         (:static/public
                                          (library/library-get-entry (library/default-library)
                                                                     :postgres 'demo.a :code 'Log))]))))
              :expected [true :lang/postgres 'Log :deftype true]}])

^{:refer lang.core.script/script-tags}
(Test/check
 [{:name "includes Foundation and canonical PostgreSQL grammar tags"
   :test (fn [] (script/script-tags :postgres))
   :expected [:pg :postgres]}
  {:name "uses a precompiled grammar index without materializing a Book"
   :test (fn []
           (let [before (registry/registry-snapshot)]
             (try
               (reset! registry/+book-macro-registry+
                       {:fixture {:tag :fixture
                                  :definitions ['defn]
                                  :highlights ['return]
                                  :highlight-meta {}}})
               [(script/script-tags :fixture)
                (script/script-definition-symbols :fixture)
                (script/script-highlight-symbols :fixture)]
               (finally (registry/registry-restore! before)))))
   :expected [[:fixture] ['defn] ['return]]}])

^{:refer lang.core.script/script-definition-symbols}
(Test/check [{:name "finds PostgreSQL code declaration operations from the grammar"
              :test (fn [] (let [symbols (set (script/script-definition-symbols :postgres))]
                           [(has? symbols 'deftype)
                            (has? symbols 'defenum)
                            (has? symbols 'deftrigger)
                            (has? symbols 'defconst)]))
              :expected [true true true true]}])

^{:refer lang.core.script/script-highlight-symbols}
(Test/check [{:name "returns the PostgreSQL grammar's explicit highlight declarations"
              :test (fn [] (script/script-highlight-symbols :postgres))
              :expected ['br 'break 'return 'set=]}])

^{:refer lang.core.script/script-quote-macro-expansion}
(Test/check [{:name "quotes target macro bodies without host evaluation"
              :test (fn [] (let [form (script/script-quote-macro-expansion
                                    ['(auth.uid)])]
                           [(first form) (first (second form))
                            (first (nth form 2))]))
              :expected ['list 'quote 'do]}])

^{:refer lang.core.script/script-runtime-macro-body}
(Test/check [{:name "converts vector macro declarations to quoted target output"
              :test (fn [] (let [body (script/script-runtime-macro-body
                                    ['[] '(auth.uid)])]
                           [(first body) (first (second body))]))
              :expected [[] 'list]}])

^{:refer lang.core.script/script-defmacro-expansion}
(Test/check [{:name "builds host macro and fragment registration expansion"
              :test (fn [] (let [form (script/script-defmacro-expansion
                                    :postgres
                                    (with-meta 'auth-uid {:static/return [:text]})
                                    ['[] '(auth.uid)]
                                    'demo.pg)]
                           [(first form)
                            (str/includes? (pr-str form) ":static/return")]))
              :expected ['do true]}])

^{:refer lang.core.script/script-eval-macro-form}
(Test/check [{:name "builds caller-local PostgreSQL evaluators"
              :test (fn [] (let [form (script/script-eval-macro-form :postgres :pg)]
                           [(first form) (second form)]))
              :expected ['defmacro '!.pg]}])

^{:refer lang.core.script/script-definition-macro-form}
(Test/check [{:name "builds a declaration macro that registers a code pointer"
              :test (fn [] (let [form (script/script-definition-macro-form
                                    :postgres :pg 'deftype)]
                            [(first form)
                            (second form)
                            (str/includes? (pr-str form) "(second &form)")]))
              :expected ['defmacro 'deftype.pg true]}])

^{:refer lang.core.script/script-fragment-macro-form}
(Test/check [{:name "builds portable PostgreSQL fragment declaration macros"
              :test (fn [] (let [form (script/script-fragment-macro-form :postgres :pg)]
                           [(first form) (second form)]))
              :expected ['defmacro 'def$.pg]}])

^{:refer lang.core.script/script-defmacro-macro-form}
(Test/check [{:name "builds PostgreSQL source macro declaration macros"
              :test (fn [] (let [form (script/script-defmacro-macro-form :postgres :pg)]
                           [(first form) (second form)]))
              :expected ['defmacro 'defmacro.pg]}])

^{:refer lang.core.script/script-highlight-macro-form}
(Test/check [{:name "builds inert declarations for explicit grammar highlights"
              :test (fn [] (let [form (script/script-highlight-macro-form :postgres 'highlighted)]
                           [(first form) (second form)]))
              :expected ['defmacro 'highlighted]}])

^{:refer lang.core.script/script-macro-parts}
(Test/check [{:name "extracts the operation and tag from generated aliases"
              :test (fn [] (script/script-macro-parts '(deftype.pg ScriptLog)))
              :expected {:operation "deftype" :tag :pg}}])

^{:refer lang.core.script/script-macro-language}
(Test/check [{:name "maps short generated tags to canonical language names"
              :test (fn [] [(script/script-macro-language '(deftype.pg ScriptLog))
                            (script/script-macro-language '(deftype.xt ScriptLog))
                            (script/script-macro-language '(!.py (+ 1 2)))])
              :expected [:postgres :xtalk :python]}])

^{:refer lang.core.script/script-generated-macro-source}
(Test/check [{:name "selects the stable macro source for a generated alias"
              :test (fn [] (script/script-generated-macro-source
                            (script/script-definition-macro-form :postgres :pg 'deftype)))
              :expected 'lang.core.script/script-generated-definition}])

^{:refer lang.core.script/script-macro-forms}
(Test/check [{:name "builds every PostgreSQL declaration tag from the active grammar"
              :test (fn [] (let [symbols (set (map second (script/script-macro-forms :postgres)))]
                           [(has? symbols 'deftype.pg)
                            (has? symbols 'deftype.postgres)
                            (has? symbols 'defn.pg)
                            (has? symbols 'def$.pg)
                            (has? symbols 'defmacro.pg)
                            (has? symbols '!.pg)]))
              :expected [true true true true true true]}])

^{:refer lang.core.script/script-macro-bindings}
(Test/check [{:name "maps each grammar's aliases to generic macro implementation Vars"
              :test (fn [] (let [bindings (set (script/script-macro-bindings :postgres))
                                 xtalk-bindings (set (script/script-macro-bindings :xtalk))]
                             [(has? bindings ['!.pg
                                              'lang.core.script/script-generated-eval])
                              (has? bindings ['def$.pg
                                              'lang.core.script/script-generated-fragment])
                              (has? bindings ['defmacro.pg
                                              'lang.core.script/script-generated-defmacro])
                              (has? bindings ['deftype.pg
                                              'lang.core.script/script-generated-definition])
                              (has? xtalk-bindings ['defn.xt
                                              'lang.core.script/script-generated-definition])
                              (has? xtalk-bindings ['defmacro.xt
                                              'lang.core.script/script-generated-defmacro])]))
              :expected [true true true true true true]}])

^{:refer lang.core.script/script-intern-macros!}
(Test/check [{:name "interns generated aliases through the stable Runtime API"
              :test (fn []
                      (script/script-intern-macros! 'lang.core.script-test :xtalk)
                      [(not (nil? (Base/resolve 'lang.core.script-test/!.xt)))
                       (not (nil? (Base/resolve 'lang.core.script-test/def$.xt)))
                       (not (nil? (Base/resolve 'lang.core.script-test/defmacro.xt)))
                       (not (nil? (Base/resolve 'lang.core.script-test/defn.xt)))
                       (= 'def
                          (first
                           (macroexpand-1
                            '(lang.core.script-test/defn.xt generated [] 1))))])
              :expected [true true true true true]}])

^{:refer lang.core.script/script-install-macro-form}
(Test/check [{:name "guards generated macros against replacing caller-owned symbols"
              :test (fn [] (let [form (script/script-install-macro-form
                                      (script/script-definition-macro-form :postgres :pg 'deftype))]
                             [(first form) (first (last form))]))
              :expected ['if 'intern-var]}])

^{:refer lang.core.script/defn.xt}
(Test/check [{:name "expands into code registration and a native definition"
              :test (fn [] (first (macroexpand-1 '(lang.core.script/defn.xt demo [] 1))))
              :expected 'do}])

^{:refer lang.core.script/defmacro.xt}
(Test/check [{:name "expands into fragment registration and a native macro"
              :test (fn [] (first (macroexpand-1 '(lang.core.script/defmacro.xt demo [] 1))))
              :expected 'do}])

^{:refer lang.core.script/module-loaded?}
(Test/check [{:name "recognizes registered module state"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (script/module-loaded? 'demo.a))))
              :expected true}])

^{:refer lang.core.script/load-module}
(Test/check [{:name "loads already-registered empty modules without source reload"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :postgres 'demo.a {})
                                       (script/load-module 'demo.a))))
              :expected 'demo.a}
             {:name "loads a generic module through a target Book parent"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :xtalk 'demo.a {})
                                       (swap! script/+loaded-modules+ assoc [:js 'demo.a] true)
                                       (script/load-module :js 'demo.a))))
              :expected 'demo.a}])

^{:refer lang.core.script/script-options}
(Test/check [{:name "normalizes script call option shapes"
              :test (fn [] [(script/script-options [])
                            (script/script-options [{:runtime :default}])
                            (script/script-options ['demo.a {:runtime :default}])])
              :expected [['lang.core.script {}]
                         ['lang.core.script {:runtime :default}]
                         ['demo.a {:runtime :default}]]}])

^{:refer lang.core.script/script-ns-import}
(Test/check [{:name "returns an empty primary set for an empty script"
              :test (fn [] (isolated (fn [] (script/script-ns-import :postgres {}))))
              :expected #{}}])

^{:refer lang.core.script/setup}
(Test/check [{:name "configures and records test scripts"
              :test (fn [] (isolated (fn []
                                       (script/setup :postgres 'demo.a {} true)
                                       (select-keys (get (deref script/+scripts+) ['demo.a :postgres])
                                                    [:lang :module :runtime]))))
              :expected {:lang :postgres :module 'demo.a :runtime nil}}])

^{:refer lang.core.script/setup}
(Test/check
 [{:name "prepares only the explicit basic target Book during script setup"
   :test (fn [] (isolated (fn []
                            (script/setup :js 'demo.a {:runtime :basic} true)
                            [(:lang (:book (library/library-book-record
                                            (library/runtime-library) :js)))
                             (library/library-book-record
                              (library/runtime-library) :python)])))
   :expected [:js nil]}])

^{:refer lang.core.script/compile-script-module}
(Test/check
 [{:name "compiles one selected module against its active Library Book"
   :test (fn [] (isolated (fn []
                            (script/configure-module :postgres 'demo.a {})
                            (binding [script/*module-compiler*
                                      (fn [options]
                                        [(:lang options)
                                         (:main options)
                                         (:layout options)
                                         (:emit options)
                                         (get-in options [:book :lang])])]
                              (script/compile-script-module
                               :postgres 'demo.a {:emit {:dialect :fixture}})))))
   :expected [:postgres 'demo.a :flat {:dialect :fixture} :postgres]}])

^{:refer lang.core.script/script-module-source?}
(Test/check
 [{:name "avoids materializing a Book for an empty selected script module"
   :test (fn [] (isolated (fn []
                            (script/configure-module :postgres 'demo.a {})
                            [(script/script-module-source? :postgres 'demo.a)
                             (do
                               (script/register-library-module!
                                :postgres
                                {:id 'demo.a :lang :postgres
                                 :code {:ready {}} :fragment {}})
                               (script/script-module-source? :postgres 'demo.a))])))
   :expected [false true]}])

^{:refer lang.core.script/initialize-script!}
(Test/check
 [{:name "injects compiled selected script source through runtime evaluation"
   :test (fn [] (isolated (fn []
                            (let [calls (atom [])
                                  instance (runtime/rt-default {:lang :postgres})]
                              (script/register-library-module!
                               :postgres
                               {:id 'demo.a :lang :postgres
                                :code {:ready {}} :fragment {}})
                              (binding [script/*module-compiler*
                                        (fn [_] {:output "select 1" :diagnostics []})
                                        script/*module-evaluator*
                                        (fn [runtime source options]
                                          (swap! calls conj [runtime source options]))]
                                (script/initialize-script!
                                 instance :postgres 'demo.a {:timeout 41})
                                (mapv (fn [[runtime source options]]
                                        [(= instance runtime) source options])
                                      (deref calls)))))))
   :expected [[true "select 1" {:timeout 41}]]}
  {:name "fails before evaluating a diagnostic module result"
   :test (fn [] (isolated (fn []
                            (let [calls (atom [])
                                  instance (runtime/rt-default {:lang :postgres})
                                  result
                                  (do
                                    (script/register-library-module!
                                     :postgres
                                     {:id 'demo.a :lang :postgres
                                      :code {:ready {}} :fragment {}})
                                    (try
                                      (binding [script/*module-compiler*
                                                (fn [_] {:output "never"
                                                         :diagnostics [{:code :fixture/missing}]})
                                                script/*module-evaluator*
                                                (fn [_ source _]
                                                  (swap! calls conj source))]
                                        (script/initialize-script! instance :postgres 'demo.a {}))
                                      :no-error
                                      (catch error
                                        [(:ex/code (ex-data error))
                                         (:module (ex-data error))
                                         (:diagnostics (ex-data error))])))]
                              [result (deref calls)]))))
   :expected [[:hara/dependency 'demo.a [{:code :fixture/missing}]] []]}
  {:name "loads only the selected Book while skipping empty-module compilation"
   :test (fn [] (isolated (fn []
                            (script/configure-module :postgres 'demo.a {})
                            (let [result
                                  (binding [script/*module-compiler*
                                            (fn [_]
                                              (throw (ex :generic {}
                                                         :ex/message "compiler should not run")))]
                                    (script/initialize-script!
                                     (runtime/rt-default {:lang :postgres})
                                     :postgres 'demo.a {}))]
                              [(:lang result)
                               (not (nil? (:book
                                            (library/library-book-record
                                             (library/runtime-library) :postgres))))]))))
   :expected [:postgres true]}])

^{:refer lang.core.script/start-script}
(Test/check [{:name "starts, replaces, and records one selected script runtime"
              :test (fn [] (isolated (fn []
                                       (script/setup :postgres 'demo.a {} true)
                                       (let [first (script/start-script :postgres 'demo.a {})
                                             second (script/start-script :postgres 'demo.a {})]
                                         [(:status (deref (:state first)))
                                          (:status (deref (:state second)))
                                          (= second (get-in (deref script/+scripts+)
                                                            [['demo.a :postgres] :runtime]))]))))
              :expected [:stopped :started true]}])

^{:refer lang.core.script/script-form}
(Test/check [{:name "builds ordinary script setup forms"
              :test (fn [] (first (script/script-form :postgres [])))
              :expected 'lang.core.script/setup}])

^{:refer lang.core.script/script}
(Test/check [{:name "expands ordinary script declarations"
              :test (fn [] (first (macroexpand-1 '(lang.core.script/script :postgres))))
              :expected 'do}])

^{:refer lang.core.script/script-test-form}
(Test/check [{:name "builds test script setup forms"
              :test (fn [] (last (script/script-test-form :postgres [])))
              :expected true}])

^{:refer lang.core.script/script-expansion}
(Test/check [{:name "combines module setup with grammar-derived declaration macros"
              :test (fn [] (let [form (script/script-expansion 'demo.pg :postgres [] false)]
                           [(first form) (first (second form)) (first (last form))]))
              :expected ['do 'lang.core.script/setup 'lang.core.script/start-script]}])

^{:refer lang.core.script/script-}
(Test/check [{:name "expands test script declarations"
              :test (fn [] (first (macroexpand-1 '(lang.core.script/script- :postgres))))
              :expected 'do}])

^{:refer lang.core.script/selected-book}
(Test/check [{:name "selects target grammar without eagerly merging XTalk modules"
              :test (fn [] (isolated (fn []
                                       (script/register-library-module!
                                        :xtalk
                                        {:id 'demo.xtalk :lang :xtalk :code {} :fragment {}})
                                       (let [selected (script/selected-book :js)]
                                         [(:lang selected)
                                          (:parent selected)
                                          (get-in selected [:modules 'demo.xtalk])]))))
              :expected [:js :xtalk nil]}])

^{:refer lang.core.script/compile-cache-key}
(Test/check [{:name "keys cache entries by language module source and registry snapshot"
              :test (fn [] (let [key (script/compile-cache-key :postgres 'demo.a '(+ 1 2))]
                           [(first key) (second key) (nth key 2) (number? (nth key 3))]))
              :expected [:postgres 'demo.a '(+ 1 2) true]}])

^{:refer lang.core.script/compile-one}
(Test/check [{:name "returns a staged compiler result and memoises it"
              :test (fn [] (isolated (fn []
                                       (let [module (script/module-config :postgres 'demo.a {})
                                             first-result (script/compile-one :postgres '(+ 1 2) module nil)
                                             second-result (script/compile-one :postgres '(+ 1 2) module nil)]
                                         [(string? (:output first-result))
                                          (= first-result second-result)
                                          (= 1 (count (deref script/+compile-cache+)))]))))
              :expected [true true true]}])

^{:refer lang.core.script/compile-form}
(Test/check [{:name "emits one PostgreSQL expression"
              :test (fn [] (isolated (fn [] (script/compile-form :postgres 'demo.a '(+ 1 2)))))
              :expected "1 + 2"}])

^{:refer lang.core.script/restart}
(Test/check [{:name "starts registered default scripts"
              :test (fn [] (isolated (fn []
                                       (script/setup :postgres 'demo.a {} true)
                                       (script/restart)
                                       (:status (deref (:state (get-in (deref script/+scripts+)
                                                                       [['demo.a :postgres] :runtime])))))))
              :expected :started}])

^{:refer lang.core.script/stop}
(Test/check [{:name "stops registered scripts and clears runtime references"
              :test (fn [] (isolated (fn []
                                       (script/setup :postgres 'demo.a {} true)
                                       (script/restart)
                                       (script/stop)
                                       (:runtime (get (deref script/+scripts+) ['demo.a :postgres])))))
              :expected nil}])

^{:refer lang.core.script/eval-form}
(Test/check [{:name "reports the explicitly selected module in a dependency error"
              :test (fn [] (try (script/eval-form :postgres 'demo.a '(+ 1 2))
                                (catch error [(:ex/code (ex-data error))
                                              (:module (ex-data error))])))
              :expected [:hara/dependency 'demo.a]}])

^{:refer lang.core.script/eval-forms}
(Test/check [{:name "delegates every form to the configured evaluator"
              :test (fn [] (try (script/eval-forms :postgres ['(+ 1 2)])
                                (catch error (:ex/code (ex-data error)))))
              :expected :hara/dependency}])
