                                                                       [['demo.a :postgres] :runtime])))))))
              :expected :started}])

^{:refer lang.core.script/stop}
(Test/check [{:name "stops registered scripts and clears runtime references"
              :test (fn [] (isolated (fn []
                                       (script/setup :postgres 'demo.a {} true)
                                       (script/restart)
                                       (script/stop)
                                       (:runtime (get (deref script/+scripts+) ['demo.a :postgres])))))
              :expected nil}])

^{:refer lang.core.script/eval-form}
(Test/check [{:name "reports the explicitly selected module in a dependency error"
              :test (fn [] (isolated (fn []
                                       (try (script/eval-form :postgres 'demo.a '(+ 1 2))
                                            (catch error [(:ex/code (ex-data error))
                                                         (:module (ex-data error))])))))
              :expected [:hara/dependency 'demo.a]}])

^{:refer lang.core.script/eval-forms}
(Test/check [{:name "delegates every form to the configured evaluator"
              :test (fn [] (isolated (fn []
                                       (try (script/eval-forms :postgres ['(+ 1 2)])
                                            (catch error (:ex/code (ex-data error)))))))
              :expected :hara/dependency}])
