              :test (fn [] (isolated (fn []
                                       (script/configure-module :python 'demo.a {})
                                       (fn? (get-in (script/selected-book :python)
                                                    [:selection :grammar :reserved
                                                     'x:lu-del :macro])))))
              :expected true}])

^{:refer lang.core.script/selected-book}
(Test/check [{:name "retains Python token configuration in the selected Book"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :python 'demo.a {})
                                       (get-in (script/selected-book :python)
                                               [:selection :grammar :token :nil]))))
              :expected "None"}])

^{:refer lang.core.script/compile-cache-key}
(Test/check [{:name "keys cache entries by language module source and registry snapshot"
              :test (fn [] (let [key (script/compile-cache-key :postgres 'demo.a '(+ 1 2))]
                           [(first key) (second key) (nth key 2) (number? (nth key 3))]))
              :expected [:postgres 'demo.a '(+ 1 2) true]}])

^{:refer lang.core.script/compile-one}
(Test/check [{:name "returns a staged compiler result and memoises it"
              :test (fn [] (isolated (fn []
                                       (let [module (script/module-config :postgres 'demo.a {})
                                             first-result (script/compile-one :postgres '(+ 1 2) module nil)
                                             second-result (script/compile-one :postgres '(+ 1 2) module nil)]
                                         [(string? (:output first-result))
                                          (= first-result second-result)
                                          (= 1 (count (deref script/+compile-cache+)))]))))
              :expected [true true true]}])

^{:refer lang.core.script/compile-form}
(Test/check [{:name "emits one PostgreSQL expression"
              :test (fn [] (isolated (fn [] (script/compile-form :postgres 'demo.a '(+ 1 2)))))
              :expected "1 + 2"}])

^{:refer lang.core.script/compile-form}
(Test/check [{:name "emits identity lookup deletion through the selected Python Book"
              :test (fn [] (isolated (fn []
                                       (script/configure-module :python 'demo.a {})
                                       (script/compile-form
                                        :python
                                        'demo.a
                                        '(x:lu-del lookup key)))))
              :expected "lookup.pop(id(key), None)"}])

^{:refer lang.core.script/restart}
