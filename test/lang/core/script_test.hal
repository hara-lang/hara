(ns lang.core.script-test
 (:require [code.test :refer :all] [lang.core.script :as script]
 [lang.core.library :as lib] [lang.model.v1.spec-xtalk :as xtalk] [lang.model.v1.spec-lua :as lua]
 [code.test.context]))
^{:refer lang.core.script/script-require-target-id :added "4.1"}
(fact "constructs a target module id from module, source, and alias"

  (script/script-require-target-id 'my.module 'source.core nil)
  => 'my.module.source.core

  (script/script-require-target-id 'my.module 'source.core 'src)
  => 'my.module.src

  (script/script-require-target-id 'my.module 'source.core '[prefix src])
  => 'my.module.src)
^{:refer lang.core.script/script-specialize-merge-contracts :added "4.1"}
(fact "merges specialization bindings into a contract map"

  (script/script-specialize-merge-contracts :demo 'current {}
                                            {'source.core {:backend 'backend.core
                                                           :bindings {'contract.core 'backend.core}}})
  => {'contract.core {:backend 'backend.core
                      :source 'source.core
                      :declared-backend 'backend.core}}

  (script/script-specialize-merge-contracts :demo 'current
                                            {'contract.core {:backend 'backend.core
                                                             :source 'source.core
                                                             :declared-backend 'backend.core}}
                                            {'other.core {:backend 'alt.core
                                                          :bindings {'contract.core 'alt.core}}})
  => (throws))
^{:refer lang.core.script/script-specialize-require :added "4.1"}
(fact "resolves a specialization require spec"

  (let [lib (lib/library:create {})]
    (lib/install-book! lib xtalk/+book+)
    (lib/install-book! lib lua/+book+)
    (lib/install-module! lib :lua 'demo.contract {})
    (lib/install-module! lib :lua 'demo.source {:require '[[demo.contract :as cache]]})
    (lib/install-module! lib :lua 'demo.backend {:implements '[demo.contract]})
    (script/script-specialize-require :lua 'demo.current lib '[demo.source :as src :with demo.backend]))
  => '{:require-spec [demo.current.src :as src]
       :specialize {demo.source {:backend demo.backend
                                 :bindings {demo.contract demo.backend}
                                 :contracts [demo.contract]
                                 :source-lang :lua
                                 :backend-lang :lua
                                 :target demo.current.src}}})
^{:refer lang.core.script/script-specialize-config :added "4.1"}
(fact "processes config require specs for specialization"

  (let [lib (lib/library:create {})]
    (lib/install-book! lib xtalk/+book+)
    (lib/install-book! lib lua/+book+)
    (lib/install-module! lib :lua 'demo.contract {})
    (lib/install-module! lib :lua 'demo.source {:require '[[demo.contract :as cache]]})
    (lib/install-module! lib :lua 'demo.backend {:implements '[demo.contract]})
    (script/script-specialize-config :lua 'demo.current
                                     {:require '[[demo.source :as src :with demo.backend]]}
                                     lib))
  => '{:require [[demo.current.src :as src]]
       :specialize {demo.source {:backend demo.backend
                                 :bindings {demo.contract demo.backend}
                                 :contracts [demo.contract]
                                 :source-lang :lua
                                 :backend-lang :lua
                                 :target demo.current.src}}})
^{:refer lang.core.script/script-test-mode? :added "4.0"}
(fact "detects test mode from :test-mode and eval-mode"

  (script/script-test-mode? {})
  => false

  (script/script-test-mode? {:test-mode true})
  => false

  (binding [code.test.context/*eval-mode* false]
    (script/script-test-mode? {:test-mode true}))
  => true

  (binding [code.test.context/*eval-mode* false]
    (script/script-test-mode? {}))
  => false)
(def +runtime-config-key+ :port)
(def +runtime-config-value+ 17001)
(def +runtime-config-form+ "ready")
(def +runtime-config+ {:port +runtime-config-value+ :startup {:args ["/bin/sh" "-lc" +runtime-config-form+]}})

^{:refer lang.core.script/resolve-runtime-config :id original-symbol-config}
(fact "resolves original quoted runtime configuration"
 (script/resolve-runtime-config '+runtime-config+)
 => {:port 17001 :startup {:args ["/bin/sh" "-lc" "ready"]}})

^{:refer lang.core.script/resolve-runtime-config :id nested-config-contract}
(fact "resolves nested keys vars symbols and forms while preserving false nil and numbers"
 (script/resolve-runtime-config
  {'+runtime-config-key+ '+runtime-config-value+
   :startup {:args ["/bin/sh" "-lc" '(str "rea" "dy")]}
   :value (var +runtime-config-value+) :false false :nil nil :count 4})
 => {:port 17001 :startup {:args ["/bin/sh" "-lc" "ready"]}
     :value 17001 :false false :nil nil :count 4})

^{:refer lang.core.script/resolve-runtime-config :id collection-config-contract}
(fact "resolves set and vector members without dropping false or nil"
 (script/resolve-runtime-config [#{'+runtime-config-value+ false nil} '(+ 1 2) [] {}])
 => [#{17001 false nil} 3 [] {}])

^{:refer lang.core.script/script-macro-import :id original-empty-macros}
(fact "allows books without any exported macros"
 (script/script-macro-import {:macros [] :highlights []})
 => '[#{} #{}])

^{:refer lang.core.script/script-ns-import :id empty-imports-boundary}
(fact "imports an empty namespace configuration"
 (script/script-ns-import :lua {}) => #{})

^{:refer lang.core.script/script-ns-import :id intrinsic-current-namespace}
(fact "retains current-namespace shorthand without mutating native aliases"
 (let [before (ns-aliases (ns-current))]
   [(script/script-ns-import :lua {})
    (eval '-/+runtime-config-value+)
    (= before (ns-aliases (ns-current)))])
 => [#{} 17001 true])

^{:refer lang.core.script/script :id original-macro-expansion}
(fact "preserves script arities and quoted module/config forms"
 [(macroexpand-1 '(script/script :lua))
  (macroexpand-1 '(script/script :lua demo.module))
  (macroexpand-1 '(script/script :lua demo.module {:runtime :default}))]
 => '[(lang.core.script/script-fn :lua)
      (lang.core.script/script-fn :lua (quote demo.module))
      (lang.core.script/script-fn :lua (quote demo.module) (quote {:runtime :default}))])

^{:refer lang.core.script/script- :id original-test-macro-expansion}
(fact "preserves original test macro setup and quoting"
 [(macroexpand-1 '(script/script- :lua))
  (macroexpand-1 '(script/script- :lua {:test-mode true}))]
 => '[(lang.core.script/script-test :lua {})
      (lang.core.script/script-test :lua (quote {:test-mode true}))])

^{:refer lang.core.script/script+ :id original-ext-macro-expansion}
(fact "preserves tagged extension coordinates and quoted config"
 [(macroexpand-1 '(script/script+ [:one :lua]))
  (macroexpand-1 '(script/script+ [:one :lua] {:runtime :oneshot}))]
 => '[(lang.core.script/script-ext [:one :lua] {})
      (lang.core.script/script-ext [:one :lua] (quote {:runtime :oneshot}))])

^{:refer lang.core.script/! :id original-tagged-macro-expansion}
(fact "preserves tagged evaluation body namespace metadata and non-vector rejection"
 (let [form (with-meta '(script/! [:one] (+ 1 2)) {:probe 7}) expanded (macroexpand-1 form)]
   [(first expanded) (second expanded) (nth expanded 2) (nth expanded 3)
    (:probe (nth expanded 4))
    (macroexpand-1 '(script/! :one (+ 1 2)))])
 => '[lang.core.script/script-ext-run (quote lang.core.script-test) :one (quote (+ 1 2)) 7 nil])

(require [lang.core.impl :as impl] [lang.core.runtime :as rt]
 [lang.core.script-annex :as annex] [std.lib.context.space :as space]
 [std.lib.context.resource :as resource])

^{:refer lang.core.script/script-fn-base :id lua-original-module-setup}
(fact "installs an original Lua module into the supplied library"
 (let [library (impl/clone-default-library)]
  (try
   (impl/with:library [library]
    (let [config (script/script-fn-base :lua 'script.pipeline.module {} library)]
      [(:module config) (:module/primary config)
       (Base/identical? library (:library config))
       (:id (lib/get-module library :lua 'script.pipeline.module))]))
   (finally (lib/reset-all! library) (reset! (:settings library) {}))))
 => '[script.pipeline.module #{} true script.pipeline.module])

^{:refer lang.core.script/script-fn, :id lua-original-default-runtime}
(fact
  "creates the original registered Lua default runtime with its module library"
  (let [library (impl/clone-default-library)]
    (binding [space/*spaces* (atom {})
              resource/*resource-active* (atom
                                           {:global {},
                                            :namespace {},
                                            :shared {}})]
      (try
        (impl/with:library
          [library]
          (let [runtime (script/script-fn
                          :lua
                          'script.pipeline.runtime
                          {})]
            [(rt/rt-default? runtime)
             (:lang runtime)
             (:runtime runtime)
             (:module runtime)
             (Base/identical? library (:library runtime))]))
        (finally
          (try
            (when (annex/annex-current)
              (annex/clear-annex (ns-current)))
            (finally
              (try
                (space/reset-spaces!)
                (finally
                  (lib/reset-all! library)
                  (reset! (:settings library) {})))))))))
  =>
  '[true :lua :default script.pipeline.runtime true])

^{:refer lang.core.script/script-test-prep, :id lua-original-annex-module}
(fact
  "keeps test module setup in the original annex child library"
  (let [library (impl/clone-default-library)]
    (binding [space/*spaces* (atom {})
              resource/*resource-active* (atom
                                           {:global {},
                                            :namespace {},
                                            :shared {}})]
      (try
        (impl/with:library
          [library]
          (let [config (script/script-test-prep :lua {})
                child (annex/get-annex-library (ns-current))]
            [(:module config)
             (Base/identical? child (:library config))
             (:id (lib/get-module child :lua (ns-current)))
             (:id (lib/get-module library :lua (ns-current)))]))
        (finally
          (try
            (when (annex/annex-current)
              (annex/clear-annex (ns-current)))
            (finally
              (try
                (space/reset-spaces!)
                (finally
                  (lib/reset-all! library)
                  (reset! (:settings library) {})))))))))
  =>
  '[lang.core.script-test true lang.core.script-test nil])

^{:refer lang.core.script/script-ext, :id lua-original-tagged-reuse}
(fact
  "creates and reuses an original tagged runtime and emits through its pointer"
  (let [library (impl/clone-default-library)]
    (binding [space/*spaces* (atom {})
              resource/*resource-active* (atom
                                           {:global
                                            (:global
                                              (deref
                                                resource/*resource-active*)),
                                            :namespace {},
                                            :shared {}})]
      (try
        (impl/with:library
          [library]
          (let [[previous instance] (script/script-ext
                                      [:first :lua]
                                      {:runtime :default})
                reused (script/script-ext
                         [:first :lua]
                         {:runtime :default})]
            [previous
             (rt/rt-default? instance)
             (:module instance)
             (count reused)
             (Base/identical? instance (first reused))
             (Base/identical? instance (script/annex:get :first))
             (binding [impl/*library* nil]
               (script/script-ext-run
                 (ns-current)
                 :first
                 '(return (+ 1 2))
                 {}))]))
        (finally
          (try
            (when (annex/annex-current)
              (annex/clear-annex (ns-current)))
            (finally
              (try
                (space/reset-spaces!)
                (finally
                  (lib/reset-all! library)
                  (reset! (:settings library) {})))))))))
  =>
  '[nil true lang.core.script-test 1 true true "return 1 + 2"])

^{:refer lang.core.script/annex:restart-all, :id lua-original-tagged-lifecycle}
(fact
  "preserves registrations while stopping and restarting original tagged runtimes"
  (let [library (impl/clone-default-library)]
    (binding [space/*spaces* (atom {})
              resource/*resource-active* (atom
                                           {:global {},
                                            :namespace {},
                                            :shared {}})]
      (try
        (impl/with:library
          [library]
          (script/script-ext [:one :lua] {:runtime :default})
          (script/script-ext [:two :lua] {:runtime :default})
          (let [initial (script/annex:list)
                stopped (script/annex:stop :one)
                partial (script/annex:list)
                remaining (set (keys (script/annex:stop-all)))
                inactive (script/annex:list)
                restarted (set (keys (script/annex:restart-all)))]
            [initial
             (rt/rt-default? stopped)
             partial
             remaining
             inactive
             restarted
             (script/annex:list)]))
        (finally
          (try
            (when (annex/annex-current)
              (annex/clear-annex (ns-current)))
            (finally
              (try
                (space/reset-spaces!)
                (finally
                  (lib/reset-all! library)
                  (reset! (:settings library) {})))))))))
  =>
  [{:registered #{:one :two}, :active #{:one :two}}
   true
   {:registered #{:one :two}, :active #{:two}}
   #{:two}
   {:registered #{:one :two}, :active #{}}
   #{:one :two}
   {:registered #{:one :two}, :active #{:one :two}}])

(require [lang.base.emit-prep-lua-test :as prep] [lang.core.library-snapshot :as snap])

^{:refer lang.core.script/+module-keys+}
(fact "retains original module config keys and order"
 script/+module-keys+
 => [:lang :id :require :implements :specialize :import :macro-only :bundle :file :export :static :test-mode])

^{:refer lang.core.script/+runtime-keys+}
(fact "retains original runtime config keys and order"
 script/+runtime-keys+
 => [:runtime :config :layout :emit :lang :context :module :namespace :id])

^{:refer lang.core.script/script-require-form}
(fact "normalizes aliases and only collection-valued refer selections"
 [(script/script-require-form 'demo.source nil nil)
  (script/script-require-form 'demo.source 'src '[one two])
  (script/script-require-form 'demo.source '[prefix src] [])
  (script/script-require-form 'demo.source nil 'backend.source)]
 => '[[demo.source] [demo.source :as src :refer [one two]]
      [demo.source :as src :refer []] [demo.source]])

^{:refer lang.core.script/script-module-loaded?}
(fact "distinguishes absent empty and populated modules"
 (let [library (lib/library:create {:snapshot (snap/snapshot {:lua {:id :lua :book prep/+book-min+}})})]
  (try
   (lib/install-module! library :lua 'empty.module {})
   [(script/script-module-loaded? nil :lua 'L.core)
    (script/script-module-loaded? library nil 'L.core)
    (script/script-module-loaded? library :lua 'missing.module)
    (script/script-module-loaded? library :lua 'L.core)
    (script/script-module-loaded? library :lua 'empty.module)]
   (finally (lib/reset-all! library) (reset! (:settings library) {}))))
 => [false false false true false])

^{:refer lang.core.script/script-require-entry}
(fact "reloads missing module dependencies and returns only primary namespaces"
 [(script/script-require-entry nil :lua '[std.lib.context.pointer :primary true])
  (script/script-require-entry nil :lua '[std.lib.context.pointer])]
 => '[std.lib.context.pointer nil])

(require [std.lib.context.registry :as ctx-reg])
^{:refer lang.core.script/annex:start, :id :original-lifecycle-annex:start} (fact "starts only a registered original annex tag" (let [library (impl/clone-default-library)] (binding [space/*spaces* (atom {}) resource/*resource-active* (atom {:global (:global (deref resource/*resource-active*)), :namespace {}, :shared {}}) ctx-reg/*registry* (atom (deref ctx-reg/*registry*))] (try (impl/with:library [library] (do (annex/register-annex-tag (ns-current) :one :lua :default {}) (let [[previous instance] (script/annex:start :one)] [previous (rt/rt-default? instance) (:lang instance) (:module instance) (script/annex:start :missing)]))) (finally (try (when (annex/annex-current) (annex/clear-annex (ns-current))) (finally (try (space/reset-spaces!) (finally (lib/reset-all! library) (reset! (:settings library) {}))))))))) => (quote [nil true :lua lang.core.script-test nil]))
^{:refer lang.core.script/annex:get, :id :original-lifecycle-annex:get} (fact "returns the identical tagged runtime or nil for an absent tag" (let [library (impl/clone-default-library)] (binding [space/*spaces* (atom {}) resource/*resource-active* (atom {:global (:global (deref resource/*resource-active*)), :namespace {}, :shared {}}) ctx-reg/*registry* (atom (deref ctx-reg/*registry*))] (try (impl/with:library [library] (let [missing (script/annex:get :missing) [_ instance] (script/script-ext [:one :lua] {:runtime :default})] [missing (Base/identical? instance (script/annex:get :one)) (Base/identical? instance (script/annex:get :one (ns-current)))])) (finally (try (when (annex/annex-current) (annex/clear-annex (ns-current))) (finally (try (space/reset-spaces!) (finally (lib/reset-all! library) (reset! (:settings library) {}))))))))) => (quote [nil true true]))
^{:refer lang.core.script/annex:stop, :id :original-lifecycle-annex:stop} (fact "returns and removes only the selected runtime while retaining registrations" (let [library (impl/clone-default-library)] (binding [space/*spaces* (atom {}) resource/*resource-active* (atom {:global (:global (deref resource/*resource-active*)), :namespace {}, :shared {}}) ctx-reg/*registry* (atom (deref ctx-reg/*registry*))] (try (impl/with:library [library] (let [[_ instance] (script/script-ext [:one :lua] {:runtime :default})] (script/script-ext [:two :lua] {:runtime :default}) [(Base/identical? instance (script/annex:stop :one)) (script/annex:get :one) (script/annex:list)])) (finally (try (when (annex/annex-current) (annex/clear-annex (ns-current))) (finally (try (space/reset-spaces!) (finally (lib/reset-all! library) (reset! (:settings library) {}))))))))) => (quote [true nil {:registered #{:one :two}, :active #{:two}}]))
^{:refer lang.core.script/annex:start-all, :id :original-lifecycle-annex:start-all} (fact "starts all registered tags and subsequently reuses each instance" (let [library (impl/clone-default-library)] (binding [space/*spaces* (atom {}) resource/*resource-active* (atom {:global (:global (deref resource/*resource-active*)), :namespace {}, :shared {}}) ctx-reg/*registry* (atom (deref ctx-reg/*registry*))] (try (impl/with:library [library] (do (annex/register-annex-tag (ns-current) :one :lua :default {}) (annex/register-annex-tag (ns-current) :two :lua :default {}) (let [created (script/annex:start-all) reused (script/annex:start-all)] [(set (keys created)) (mapv (fn [migration-argument-0] (count (get created migration-argument-0))) [:one :two]) (mapv (fn [migration-argument-0] (count (get reused migration-argument-0))) [:one :two]) (mapv (fn [migration-argument-0] (Base/identical? (second (get created migration-argument-0)) (first (get reused migration-argument-0)))) [:one :two])]))) (finally (try (when (annex/annex-current) (annex/clear-annex (ns-current))) (finally (try (space/reset-spaces!) (finally (lib/reset-all! library) (reset! (:settings library) {}))))))))) => (quote [#{:one :two} [2 2] [1 1] [true true]]))
^{:refer lang.core.script/annex:stop-all, :id :original-lifecycle-annex:stop-all} (fact "returns removed runtimes, retains tags, and is idempotent" (let [library (impl/clone-default-library)] (binding [space/*spaces* (atom {}) resource/*resource-active* (atom {:global (:global (deref resource/*resource-active*)), :namespace {}, :shared {}}) ctx-reg/*registry* (atom (deref ctx-reg/*registry*))] (try (impl/with:library [library] (do (script/script-ext [:one :lua] {:runtime :default}) (script/script-ext [:two :lua] {:runtime :default}) [(set (keys (script/annex:stop-all))) (script/annex:stop-all) (script/annex:list)])) (finally (try (when (annex/annex-current) (annex/clear-annex (ns-current))) (finally (try (space/reset-spaces!) (finally (lib/reset-all! library) (reset! (:settings library) {}))))))))) => (quote [#{:one :two} {} {:registered #{:one :two}, :active #{}}]))
^{:refer lang.core.script/annex:list, :id :original-lifecycle-annex:list} (fact "distinguishes registered-only, active, and absent tags" (let [library (impl/clone-default-library)] (binding [space/*spaces* (atom {}) resource/*resource-active* (atom {:global (:global (deref resource/*resource-active*)), :namespace {}, :shared {}}) ctx-reg/*registry* (atom (deref ctx-reg/*registry*))] (try (impl/with:library [library] (do (annex/register-annex-tag (ns-current) :waiting :lua :default {}) (script/script-ext [:active :lua] {:runtime :default}) [(script/annex:list) (script/annex:list (ns-current))])) (finally (try (when (annex/annex-current) (annex/clear-annex (ns-current))) (finally (try (space/reset-spaces!) (finally (lib/reset-all! library) (reset! (:settings library) {}))))))))) => (quote [{:registered #{:waiting :active}, :active #{:active}} {:registered #{:waiting :active}, :active #{:active}}]))
^{:refer lang.core.script/script-ext-run, :id :original-lifecycle-script-ext-run} (fact "emits through the selected original tagged runtime and rejects missing tags" (let [library (impl/clone-default-library)] (binding [space/*spaces* (atom {}) resource/*resource-active* (atom {:global (:global (deref resource/*resource-active*)), :namespace {}, :shared {}}) ctx-reg/*registry* (atom (deref ctx-reg/*registry*))] (try (impl/with:library [library] (do (script/script-ext [:one :lua] {:runtime :default}) [(binding [impl/*library* nil] (script/script-ext-run (ns-current) :one (quote (return (+ 1 2))) {})) (try (script/script-ext-run (ns-current) :missing (quote (return 1)) {}) :unexpected-success (catch error :missing-tag))])) (finally (try (when (annex/annex-current) (annex/clear-annex (ns-current))) (finally (try (space/reset-spaces!) (finally (lib/reset-all! library) (reset! (:settings library) {}))))))))) => (quote ["return 1 + 2" :missing-tag]))
^{:refer lang.core.script/script-test, :id :original-lifecycle-script-test} (fact "creates a scratch runtime without starting its context in explicit test mode" (let [library (impl/clone-default-library)] (binding [space/*spaces* (atom {}) resource/*resource-active* (atom {:global (:global (deref resource/*resource-active*)), :namespace {}, :shared {}}) ctx-reg/*registry* (atom (deref ctx-reg/*registry*))] (try (impl/with:library [library] (binding [code.test.context/*eval-mode* false] (let [instance (script/script-test :lua {:test-mode true})] [(rt/rt-default? instance) (:instance (space/space:context-get (space/space space/*namespace*) :lang/lua)) (Base/identical? instance (ctx-reg/registry-scratch :lang/lua))]))) (finally (try (when (annex/annex-current) (annex/clear-annex (ns-current))) (finally (try (space/reset-spaces!) (finally (lib/reset-all! library) (reset! (:settings library) {}))))))))) => (quote [true nil true]))
^{:refer lang.core.script/script-require-entry :id trailing-option-maps}
(fact "preserves Clojure trailing-map options and nil singleton options"
 [(script/script-require-entry nil :lua '[std.lib.context.pointer {:primary true}])
  (script/script-require-entry nil :lua '[std.lib.context.pointer :primary false {:primary true}])
  (script/script-require-entry nil :lua '[std.lib.context.pointer nil])
  (script/script-require-entry nil :lua '[std.lib.context.pointer :primary])]
 => '[std.lib.context.pointer std.lib.context.pointer nil nil])

(require [lang.base.book :as book])
^{:refer lang.core.script/install, :id historical-lua-install}
(fact
  "installs the original Lua Book in its model namespace through the original pipeline"
  (binding [space/*spaces* (atom {}) ctx-reg/*registry* (atom {})]
    (let [slots '[def$.lua
                  defmacro.lua
                  !.lua
                  defptr.lua
                  defrun.lua
                  defn.lua
                  defglobal.lua
                  defgen.lua
                  defn-.lua
                  deftemp.lua
                  defabstract.lua
                  def.lua
                  return
                  break
                  local
                  tab
                  until]
          library (lib/library:create
                    {:snapshot
                     (snap/snapshot
                       {:xtalk {:id :xtalk, :book xtalk/+book+}})})
          caller (ns-current)
          slot-baseline (mapv
                          (fn [sym]
                            (let [variable
                                  (resolve
                                    (symbol
                                      "lang.model.v1.spec-lua"
                                      (name sym)))]
                              [sym (deref variable) (meta variable)]))
                          slots)]
      (try
        (impl/with:library
          [library]
          (let [result (Runtime/eval-in
                         'lang.model.v1.spec-lua
                         (fn [] (script/install lua/+book+)))
                stored (get-in (lib/get-snapshot library) [:lua :book])
                context (ctx-reg/registry-get :lang/lua)]
            [(vector? result)
             (count result)
             (book/book? stored)
             (:lang stored)
             (:parent stored)
             (= (:grammar lua/+book+) (:grammar stored))
             (=
               (nth result 2)
               (select-keys stored [:macros :highlights]))
             (= (nth result 1) context)
