(require [lang.core.pointer :as ptr])
(intern 'lang.model.v1.spec-lua (with-meta 'add-more {:macro false}) nil)
(def +install-slot-baseline+
 (mapv (fn [sym]
  (let [v (resolve (symbol "lang.model.v1.spec-lua" (name sym)))]
   [(deref v) (meta v)]))
  '[def$.lua defmacro.lua !.lua defptr.lua defrun.lua defn.lua
    defglobal.lua defgen.lua defn-.lua deftemp.lua defabstract.lua def.lua
    return break local tab until add-more]))

^{:refer lang.core.script/install, :id installed-macro-emission}
(fact
  "a macro published by original installation creates a real Entry and emits through the original Lua grammar"
  (binding [space/*spaces* (atom {}) ctx-reg/*registry* (atom {})]
    (let [slots '[def$.lua
                  defmacro.lua
                  !.lua
                  defptr.lua
                  defrun.lua
                  defn.lua
                  defglobal.lua
                  defgen.lua
                  defn-.lua
                  deftemp.lua
                  defabstract.lua
                  def.lua
                  return
                  break
                  local
                  tab
                  until
                  add-more]
          library (lib/library:create
                    {:snapshot
                     (snap/snapshot
                       {:xtalk {:id :xtalk, :book xtalk/+book+}})})
          slot-baseline (mapv
                          (fn [sym]
                            (let [variable
                                  (resolve
                                    (symbol
                                      "lang.model.v1.spec-lua"
                                      (name sym)))]
                              [sym (deref variable) (meta variable)]))
                          slots)]
      (try
        (impl/with:library
          [library]
          (Runtime/eval-in
            'lang.model.v1.spec-lua
            (fn [] (script/install lua/+book+)))
          (lib/install-module! library :lua 'L.core {})
          (let [v (Runtime/eval-in
                    'lang.model.v1.spec-lua
                    (fn []
                      (eval
                        (with-meta
                          '(defn.lua
                             add-more
                             [x y z]
                             (return (+ x y z)))
                          {:module 'L.core}))))
                pointer (deref v)
                entry (ptr/ptr-deref pointer)]
            [(str v)
             (book/book-entry? entry)
             (select-keys entry [:lang :module :id :form-input])
             (ptr/ptr-invoke-string pointer [1 2 3] {})
             (ptr/ptr-invoke-string pointer [1 2 3] {:layout :full})]))
        (finally
          (doseq [[sym value metadata] slot-baseline]
            (intern
              'lang.model.v1.spec-lua
              (with-meta sym metadata)
              value))
          (space/reset-spaces!)
          (ctx-reg/reset-registry!)
          (lib/reset-all! library)
          (reset! (:settings library) {})))))
  =>
  ["#'lang.model.v1.spec-lua/add-more"
   true
   {:lang :lua,
    :module 'L.core,
    :id 'add-more,
    :form-input '(defn add-more [x y z] (return (+ x y z)))}
   "add_more(1,2,3)"
   "L_core___add_more(1,2,3)"])
^{:refer lang.core.script/install, :id repeat-install}
(fact
  "repeat installation reports no Book change and retains existing modules and macro Vars"
  (binding [space/*spaces* (atom {}) ctx-reg/*registry* (atom {})]
    (let [slots '[def$.lua
                  defmacro.lua
                  !.lua
                  defptr.lua
                  defrun.lua
                  defn.lua
                  defglobal.lua
                  defgen.lua
                  defn-.lua
                  deftemp.lua
                  defabstract.lua
                  def.lua
                  return
                  break
                  local
                  tab
                  until]
          library (lib/library:create
                    {:snapshot
                     (snap/snapshot
                       {:xtalk {:id :xtalk, :book xtalk/+book+}})})
          slot-baseline (mapv
                          (fn [sym]
                            (let [variable
                                  (resolve
                                    (symbol
                                      "lang.model.v1.spec-lua"
                                      (name sym)))]
                              [sym (deref variable) (meta variable)]))
                          slots)]
      (try
        (impl/with:library
          [library]
          (let [first-result (Runtime/eval-in
                               'lang.model.v1.spec-lua
                               (fn [] (script/install lua/+book+)))
                _ (lib/install-module! library :lua 'L.core {})
                before (get-in (lib/get-snapshot library) [:lua :book])
                second-result (Runtime/eval-in
                                'lang.model.v1.spec-lua
                                (fn [] (script/install lua/+book+)))
                after (get-in (lib/get-snapshot library) [:lua :book])]
            [(second (first first-result))
             (second (first second-result))
             (book/book? after)
             (= (:modules before) (:modules after))
             (set (keys (:modules after)))
             (= (nth first-result 2) (nth second-result 2))
             (:lang
               (get-in (lib/get-snapshot library) [:xtalk :book]))]))
        (finally
          (doseq [[sym value metadata] slot-baseline]
            (intern
              'lang.model.v1.spec-lua
              (with-meta sym metadata)
              value))
          (space/reset-spaces!)
          (ctx-reg/reset-registry!)
          (lib/reset-all! library)
          (reset! (:settings library) {})))))
  =>
  [:new :no-change true true '#{L.core} true :xtalk])
^{:refer lang.core.script/install, :id missing-parent-boundary}
(fact
  "a missing parent fails before runtime registration or macro publication"
  (binding [space/*spaces* (atom {}) ctx-reg/*registry* (atom {})]
    (let [library (lib/library:create {:snapshot (snap/snapshot {})})
          macro-before (Runtime/eval-in
                         'lang.model.v1.spec-lua
                         (fn []
                           (let [v (eval '#'def$.lua)]
                             [(deref v) (:macro (meta v))])))]
      (try
        (impl/with:library
          [library]
          (let [before (lib/get-snapshot library)
                error (try
                        (script/install lua/+book+)
                        (catch error (ex-data error)))]
            [(select-keys error [:ex/code :ex/message])
             (set (:options error))
             (= before (lib/get-snapshot library))
             (deref ctx-reg/*registry*)
             (=
               macro-before
               (Runtime/eval-in
                 'lang.model.v1.spec-lua
                 (fn []
                   (let [v (eval '#'def$.lua)]
                     [(deref v) (:macro (meta v))]))))]))
        (finally
          (space/reset-spaces!)
          (ctx-reg/reset-registry!)
          (lib/reset-all! library)
          (reset! (:settings library) {})))))
  =>
  [{:ex/code :hara/generic, :ex/message "Parent not installed"}
   #{}
   true
   {}
   true])
^{:refer lang.core.script/install, :id install-slots-restored}
(fact
  "installation and definition fixtures restore all model namespace slots"
  (mapv
    (fn [sym]
      (let [v (Runtime/eval-in
                'lang.model.v1.spec-lua
                (fn [] (eval (list 'var sym))))]
        [(deref v) (meta v)]))
    '[def$.lua
      defmacro.lua
      !.lua
      defptr.lua
      defrun.lua
      defn.lua
      defglobal.lua
      defgen.lua
      defn-.lua
      deftemp.lua
      defabstract.lua
      def.lua
      return
      break
      local
      tab
      until
      add-more])
  =>
  +install-slot-baseline+)


(require [lang.model.v1.spec-js])
^{:refer lang.core.script/resolve-runtime-config
  :id historical-prep-config :added "4.1"}
(fact "resolves original keys and forms through JavaScript test preparation"
  (let [library (impl/clone-default-library)]
    (binding [space/*spaces* (atom {})
              resource/*resource-active* (atom {:global {} :namespace {} :shared {}})]
      (try
        (impl/with:library [library]
          (select-keys
            (script/script-test-prep
              :js
              {:runtime :basic
               :config {'+runtime-config-key+ '+runtime-config-value+
                        :startup {:args ["/bin/sh" "-lc" '(str "rea" "dy")]}}})
            [:port :startup]))
        (finally
          (try
            (when (annex/annex-current) (annex/clear-annex (ns-current)))
            (finally
              (try
                (space/reset-spaces!)
                (finally
                  (lib/reset-all! library)
                  (reset! (:settings library) {})))))))))
  => {:port 17001 :startup {:args ["/bin/sh" "-lc" "ready"]}})

^{:refer lang.core.script/script-test-prep, :id historical-js-test-prep, :added "4.0"}
(fact
  "preps the current namespace"
  (let [library (impl/clone-default-library)]
    (binding [space/*spaces* (atom {})
              resource/*resource-active* (atom
                                           {:global {},
                                            :namespace {},
                                            :shared {}})]
      (try
        (impl/with:library
          [library]
          (select-keys (script/script-test-prep :js {}) [:module]))
        (finally
          (try
            (when (annex/annex-current)
              (annex/clear-annex (ns-current)))
            (finally
              (try
                (space/reset-spaces!)
                (finally
                  (lib/reset-all! library)
                  (reset! (:settings library) {})))))))))
  =>
  {:module 'lang.core.script-test})
