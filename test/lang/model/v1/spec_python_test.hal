(ns lang.model.v1.spec-python-test
  (:require [lang.core.impl :as l]
            [lang.core.library :as lib]
            [lang.model.v1.spec-python :as py]
            [lang.model.v1.spec-xtalk :as xtalk]
            [lang.typed.xtalk-infer :as infer]
            [code.test :refer :all]))

(def migration-library (lib/library:create {}))

(fact:global {:teardown [(lib/reset-all! migration-library) (reset! (:settings migration-library) {})]})

(lib/install-book! migration-library xtalk/+book+)

(lib/install-book! migration-library py/+book+)

^{:refer lang.model.v1.spec-python/python-emit-nonlocal, :added "4.1"}
(comment
  "Original empty historical fact; behavioral coverage remains required."
  "^{:refer tahto.model.spec-python/python-emit-nonlocal, :added \"4.1\"} (fact \"emits python nonlocal statements\")")

^{:refer lang.model.v1.spec-python/python-defn-, :added "4.0"}
(fact
  "hidden function without decorators"
  (l/with:library
    [migration-library]
    (l/emit-as :python '[(defn- hello [] (return 1))]))
  =>
  "def hello():\n  return 1")

^{:refer lang.model.v1.spec-python/python-defn, :added "4.0"}
(fact
  "creates a defn function for python"
  (l/with:library
    [migration-library]
    (l/emit-as
      :python
      '[(defn ^{:decorators [classmethod classmethod (app.route "/about")]} hello []
          (return 1))]))
  =>
  (str/join
    "\n"
    [""
     "@classmethod"
     "@classmethod"
     "@app.route(\"/about\")"
     "def hello():"
     "  return 1"]))

^{:refer lang.model.v1.spec-python/python-fn, :added "4.1"}
(fact
  "lifts callbacks that lower to Python assignment statements"
  (l/with:library
    [migration-library]
    (let [out (l/emit-as
                :python
                '[(var
                    data
                    {:set_props
                     (fn [elem props]
                       (x:set-key elem "props" props))})])]
      [(boolean (re-find #"def py_callback__.*\(elem,props\):" out))
       (str/includes? out "elem[\"props\"] = props")
       (boolean (re-find #"data = \{\"set_props\":py_callback__" out))
       (not
         (boolean
           (re-find
             #"lambda elem,props : elem\[\"props\"\] = props"
             out)))]))
  =>
  [true true true true])

^{:refer lang.model.v1.spec-python/python-fn, :added "4.1", :id test-python-fn-direct-assignment}
(fact
  "lifts callbacks that use direct assignment"
  (l/with:library
    [migration-library]
    (let [out (l/emit-as
                :python
                '[(var removed nil)
                  (var
                    data
                    {:callback (fn
                                 [link-id]
                                 (:= removed link-id))})])]
      [(boolean (re-find #"def py_callback__.*\(link_id\):" out))
       (boolean (re-find #"removed = link_id" out))
       (boolean (re-find #"data = \{\"callback\":py_callback__" out))
       (not
         (boolean
           (re-find #"lambda link_id : removed = link_id" out)))]))
  =>
  [true true true true])

^{:refer lang.model.v1.spec-python/python-fn, :added "4.1", :id test-python-fn-invoke-argument}
(fact
  "lifts callbacks passed directly as invoke arguments"
  (l/with:library
    [migration-library]
    (let [out (l/emit-as
                :python
                '[(var removed nil)
                  (use_callback (fn
                                  [link-id]
                                  (:= removed link-id)))])]
      [(boolean (re-find #"def py_callback__.*\(link_id\):" out))
       (boolean (re-find #"removed = link_id" out))
       (boolean (re-find #"use_callback\(py_callback__" out))
       (not
         (boolean
           (re-find
             #"use_callback\(lambda link_id : removed = link_id\)"
             out)))]))
  =>
  [true true true true])

^{:refer lang.model.v1.spec-python/python-dot, :added "4.1"}
(fact
  "rewrites JS-style array length lookups to len"
  (l/with:library
    [migration-library]
    [(l/emit-as :python '[(. xs ["length"])])
     (l/emit-as :python '[(. obj ["key"])])])
  =>
  ["len(xs)" "obj.get(\"key\")"])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-get-key, :added "4.1"}
(fact
  "preserves falsey defaults for canonical key reads"
  (l/with:library
    [migration-library]
    (let [out (l/emit-as :python '[(x:get-key obj "key" false)])] out))
  =>
  "obj.get(\"key\") or False")

^{:refer tahto.core.impl/emit-as, :added "4.1", :id test-python-typed-canonical-access}
(fact
  "emits typed canonical object and array access"
  (l/with:library
    [migration-library]
    [(l/emit-as
       :python
       '[(. obj [key])]
       {:lang/xtalk-context
        {:infer infer/infer-type,
         :env
         '{obj {:kind :record, :fields []},
           key {:kind :primitive, :name :xt/str}}}})
     (l/emit-as
       :python
       '[(. arr [i])]
       {:lang/xtalk-context
        {:infer infer/infer-type,
         :env
         '{arr {:kind :array, :item {:kind :primitive, :name :xt/int}},
           i {:kind :primitive, :name :xt/int}}}})])
  =>
  ["obj.get(key)" "arr[i]"])

^{:refer lang.model.v1.spec-python/python-defclass, :added "4.0"}
(fact
 "emits a defclass template for python"
 (l/with:library
  [migration-library]
  (l/emit-as
   :python
   '[(var*
      :%
      (StringProperty
       :default
       "*.text"
       :options
       #{"HIDDEN"}
       :maxlen
       255)
      bl-text)]))
 =>
 "bl_text: StringProperty(default=\"*.text\",options={\"HIDDEN\"},maxlen=255)"
 (l/with:library
  [migration-library]
  (let
   [out
    (l/emit-as
     :python
     '[(defclass
        ReloadScriptsOperator
        [bpy.types.Operator]
        (var bl-idname "script")
        (var bl-label "Reload code")
        (var bl-description "Reloads all distance code.")
        (var*
         :%
         (StringProperty
          :default
          "*.text"
          :options
          #{"HIDDEN"}
          :maxlen
          255)
         bl-text)
        ^{:decorators [classmethod classmethod classmethod]}
        (fn
         execute
         [self context]
         (let
          [my-path (bpy.path.abspath "//")]
          (when
           [:not my-path]
           (self.report #{"ERROR"} "Save the Blend file first")
           (return #{"CANCELLED"}))
          (return #{"FINISHED"}))))])]
   [(boolean
     (re-find
      #"class ReloadScriptsOperator\(bpy.types.Operator\):"
      out))
    (boolean (re-find #"bl_idname = \"script\"" out))
    (boolean (re-find #"bl_label = \"Reload code\"" out))
    (boolean
     (re-find #"bl_description = \"Reloads all distance code\.\"" out))
    (boolean
     (re-find
      #"bl_text: StringProperty\(default=\"\*\.text\",options=\{\"HIDDEN\"\},maxlen=255\)"
      out))
    (boolean (re-find #"def execute\(self,context\):" out))
    (boolean
     (re-find
      #"self\.report\(\{\"ERROR\"\},\"Save the Blend file first\"\)"
      out))
    (boolean (re-find #"return \{\"FINISHED\"\}" out))]))
 =>
 [true true true true true true true true])

^{:refer lang.model.v1.spec-python/python-var, :added "4.0"}
(fact
  "var -> fn.inner shorthand"
  (l/with:library
    [migration-library]
    (py/python-var '(var hello (fn [x] x))))
  =>
  '(fn.inner hello [x] x)
  (l/with:library
    [migration-library]
    (py/python-var '(var hello (fn []))))
  =>
  '(fn.inner hello [])
  (l/with:library [migration-library] (py/python-var '#'hello))
  =>
  '(var* hello := nil))

^{:refer lang.model.v1.spec-python/tf-for-object, :added "4.0"}
(fact
  "for object loop"
  (l/with:library
    [migration-library]
    (py/tf-for-object '(for:object [[k v] arr] [k v])))
  =>
  '(for [[k v] :in (. arr (items))] [k v]))

^{:refer lang.model.v1.spec-python/tf-for-array, :added "4.0"}
(fact
  "for array loop"
  (l/with:library
    [migration-library]
    (py/tf-for-array '(for:array [[i e] arr] [i e])))
  =>
  '(for [i :in (range (len arr))] (var e (. arr [i])) [i e])
  (l/with:library
    [migration-library]
    (py/tf-for-array '(for:array [e arr] e)))
  =>
  '(for [e :in arr] e))

^{:refer lang.model.v1.spec-python/tf-for-iter, :added "4.0"}
(fact
  "for iter loop"
  (l/with:library
    [migration-library]
    (py/tf-for-array '(for:iter [e it] e)))
  =>
  '(for [e :in it] e))

^{:refer lang.model.v1.spec-python/tf-for-index, :added "4.0"}
(fact
  "for index transform"
  (l/with:library
    [migration-library]
    (py/tf-for-index '(for:index [i [0 2 10]] i)))
  =>
  '(for [i :in (range 0 2 10)] i))

^{:refer lang.model.v1.spec-python/tf-for-return, :added "4.0"}
(fact
  "for return transform"
  (l/with:library
    [migration-library]
    (py/tf-for-return
      '(for:return
         [[ok err] (call)]
         {:success (return ok), :error (return err)})))
  =>
  '(try
     (var ok (call))
     (return ok)
     (catch [Exception :as err] (return err))))

