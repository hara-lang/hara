(ns lang.model.v1.spec-dart-test
  (:use code.test)
  (:require [lang.base.book :as book]
            [lang.base.emit :as emit]
            [lang.base.grammar :as grammar]
            [lang.core.impl :as impl]
            [lang.core.library :as library]
            [lang.model.v1.spec-dart :as subject]))

^{:refer lang.model.v1.spec-dart/+language+}
(fact "Dart keeps the original language identity and version"
  [subject/+language+ subject/+tag+ subject/+version+ subject/+grammar-version+]
  => [:dart :dt 1 1])

^{:refer lang.model.v1.spec-dart/+template+}
(fact "Dart exposes the concrete emitter template instead of a catalog source"
  [(map? subject/+template+)
   (= subject/+template+ subject/+profile+)
   (not (has? subject/+template+ :source/kind))
   (get-in subject/+template+ [:token :nil :as])]
  => [true false true "null"])

^{:refer lang.model.v1.spec-dart/+grammar+}
(fact "Dart grammar is directly built from reserved operators"
  [(grammar/grammar? subject/+grammar+)
   (:tag subject/+grammar+)
   (count (:reserved subject/+grammar+))
   (get-in subject/+grammar+ [:reserved 'var* :raw])]
  => [true :dt 303 "var"])

^{:refer lang.model.v1.spec-dart/+meta+}
(fact "Dart metadata renders imports with suffixes and normalized aliases"
  ((:module-import subject/+meta+)
   "package:xtalk_ui/page"
   {:as 'event-listener :suffix ".dart"}
   {})
  => '(:- "import 'package:xtalk_ui/page.dart' as event_listener;"))

^{:refer lang.model.v1.spec-dart/+book+}
(fact "Dart is a source-owned child Book with the concrete grammar"
  [(book/book? subject/+book+)
   (:lang subject/+book+)
   (:parent subject/+book+)
   (= (:grammar subject/+book+) subject/+grammar+)
   (nil? (:selection subject/+book+))]
  => [true :dart :xtalk true true])

^{:refer lang.model.v1.spec-dart/+init+}
(fact "Dart initialization installs the Book through the standard script path"
  (let [stored (get-in (library/get-snapshot (impl/default-library))
                       [:dart :book])]
    [(vector? subject/+init+)
     (= :dart (:lang stored))
     (book/book? stored)
     (= (:grammar stored) subject/+grammar+)])
  => [true true true true])

^{:refer lang.model.v1.spec-dart/+grammar+ :id dart-direct-emission}
(fact "Dart emission uses the concrete grammar without catalog materialization"
  [(emit/emit '(var greeting "hello") subject/+grammar+ nil {})
   (emit/emit '(x:len [1 2 3]) subject/+grammar+ nil {})
   (emit/emit '(defn hello [name] (return (x:cat "hi " name)))
              subject/+grammar+ nil {})]
  => ["var greeting = \"hello\""
      "<dynamic>[1,2,3].length"
      "hello(name) {\n  return \"hi \" + name;\n}"])

^{:refer lang.model.v1.spec-dart/+grammar+ :id dart-target-boundaries}
(fact "Dart preserves target-specific call, math, and loop forms"
  [(emit/emit '(x:print "hello") subject/+grammar+ nil {})
   (emit/emit '(x:arr-push items 1) subject/+grammar+ nil {})
   (emit/emit '(pow 2 5) subject/+grammar+ nil {})
   (emit/emit '(for [(var index := 0) (< index 3) (:++ index)]
                 (print index))
              subject/+grammar+ nil {})]
  => ["(() {\n  print(\"hello\");\n  return null;\n})()"
      "items.add(1)"
      "math.pow(2,5)"
      "for(var index = 0; index < 3; ++index){\n  print(index);\n}"])
