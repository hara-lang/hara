(ns lang.model.v1.spec-xtalk.fn-lua-test
 (:use code.test)
 (:require [lang.model.v1.spec-xtalk.fn-lua :as r]))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-del}
(fact "deletion assigns nil to the exact target"
 (r/lua-tf-x-del '[_ (. obj ["key"])]) => '(:= (. obj ["key"]) nil))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-cat}
(fact "concatenation retains empty and ordered argument lists"
 [(r/lua-tf-x-cat '[_]) (r/lua-tf-x-cat '[_ "a" value "b"])]
 => ['(cat) '(cat "a" value "b")])
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-eval}
(fact "expression evaluation prefixes return and invokes the loaded function"
 (r/lua-tf-x-eval '[_ source]) => '((loadstring (cat "return " source))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-apply}
(fact "application unpacks the argument collection once"
 (r/lua-tf-x-apply '[_ callable args]) => '(callable (unpack args)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-construct}
(fact "construction preserves the constructor and unpacked arguments"
 (r/lua-tf-x-construct '[_ Widget args]) => '(Widget (unpack args)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-err}
(fact "error lowering retains message-only and structured data branches"
 [(r/lua-tf-x-err '[_ "message"]) (r/lua-tf-x-err '[_ "message" {:code 7}])]
 => ['(error "message" 0) '(error (cjson.encode ["message" {:code 7}]) 0)])
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-ex-native?}
(fact "native exception recognition requires table and exact discriminator"
 (r/lua-tf-x-ex-native? '[_ err])
 => '(and (== "table" (type err)) (== "xt.exception" (. err ["__type__"]))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-ex-new}
(fact "exception construction retains absent and explicit false data"
 [(r/lua-tf-x-ex-new '[_ "message"]) (r/lua-tf-x-ex-new '[_ "message" false])]
 => [{"__type__" "xt.exception" "message" "message" "data" nil}
     {"__type__" "xt.exception" "message" "message" "data" false}])
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-ex-message}
(fact "message lookup rejects non-native exceptions"
 (r/lua-tf-x-ex-message '[_ err])
 => '(:? (x:ex-native? err) (. err ["message"]) nil))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-ex-data}
(fact "data lookup rejects non-native exceptions"
 (r/lua-tf-x-ex-data '[_ err])
 => '(:? (x:ex-native? err) (. err ["data"]) nil))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-hash-id}
(fact "the original unsupported identity hash returns nil"
 (r/lua-tf-x-hash-id '[_ object]) => '(return nil))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-has-key?}
(fact "presence distinguishes missing check from explicit false or zero"
 [(r/lua-tf-x-has-key? '[_ obj "key" nil])
  (r/lua-tf-x-has-key? '[_ obj "key" false])
  (r/lua-tf-x-has-key? '[_ obj "key" 0])]
 => ['(not= nil (. obj ["key"])) '(== false (x:get-key obj "key" nil))
     '(== 0 (x:get-key obj "key" nil))])
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-return-wrap}
(fact "runtime wrapping separates pcall errors from result encoding"
 (r/lua-tf-x-return-wrap '[_ work encode])
 => '(do (var out)
         (var '[o-ok o-err] (pcall (fn [] (:= out (work)))))
         (cond o-err (return (cjson.encode {:type "error" :value o-err}))
               :else (return (encode out)))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-return-eval}
(fact "runtime evaluation keeps loader failure and direct multi-value binding"
 (r/lua-tf-x-return-eval '[_ source wrap])
 => '(return (wrap (fn []
                    (var load-fn (or loadstring load))
                    (var '[f err] (load-fn source))
                    (if err (error err) (return (f)))))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bytes-new}
(fact "byte construction copies all values through unpack"
 (r/lua-tf-x-bytes-new '[_ values]) => '[(unpack values)])
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bytes-get}
(fact "byte lookup offsets the external index exactly once"
 (r/lua-tf-x-bytes-get '[_ bytes index]) => '(x:get-idx bytes (x:offset index)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bytes-set}
(fact "byte mutation uses rawset with one offset"
 (r/lua-tf-x-bytes-set '[_ bytes index value]) => '(rawset bytes (x:offset index) value))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bytes-copy}
(fact "byte copying allocates a new array expression"
 (r/lua-tf-x-bytes-copy '[_ bytes]) => '[(unpack bytes)])
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bytes-slice}
(fact "byte slicing preserves optional exclusive end conventions"
 [(r/lua-tf-x-bytes-slice '[_ bytes 0]) (r/lua-tf-x-bytes-slice '[_ bytes 1 4])]
 => ['[(unpack bytes (x:offset 0))] '[(unpack bytes (x:offset 1) 4)]])
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bytes-u8}
(fact "unsigned conversion masks to eight bits"
 (r/lua-tf-x-bytes-u8 '[_ value]) => '(bit.band value 255))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bytes-s8}
(fact "signed conversion preserves the 127 boundary"
 (r/lua-tf-x-bytes-s8 '[_ value]) => '(:? (> value 127) (- value 256) value))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-socket-send}
(fact "socket send decodes the byte sequence before dispatch"
 (r/lua-tf-x-socket-send '[_ conn bytes]) => '(. conn (send (x:str-decode bytes))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-socket-close}
(fact "socket close invokes the connection method"
 (r/lua-tf-x-socket-close '[_ conn]) => '(. conn (close)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-global-has?}
(fact "global presence converts the provided name to a symbol"
 (r/lua-tf-x-global-has? '[_ "answer"]) => '(not= answer nil))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-global-set}
(fact "global assignment retains false"
 (r/lua-tf-x-global-set '[_ "answer" false]) => '(:= answer false))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-global-del}
(fact "global deletion assigns nil"
 (r/lua-tf-x-global-del '[_ "answer"]) => '(:= answer nil))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-m-mod}
(fact "modulo preserves operand order and sign"
 (r/lua-tf-x-m-mod '[_ -10 3]) => '(mod -10 3))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-m-quot}
(fact "quotient retains floor division"
 (r/lua-tf-x-m-quot '[_ -10 3]) => '(math.floor (/ -10 3)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-string?}
(fact "string recognition compares the native type"
 (r/lua-tf-x-is-string? '[_ value]) => '(== "string" (type value)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-number?}
(fact "number recognition compares the native type"
 (r/lua-tf-x-is-number? '[_ value]) => '(== "number" (type value)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-integer?}
(fact "integer recognition checks remainder modulo one"
 (r/lua-tf-x-is-integer? '[_ value]) => '(== 0 (mod value 1)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-boolean?}
(fact "boolean recognition compares the native type"
 (r/lua-tf-x-is-boolean? '[_ value]) => '(== "boolean" (type value)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-function?}
(fact "function recognition compares the native type"
 (r/lua-tf-x-is-function? '[_ value]) => '(== "function" (type value)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-lu-create}
(fact "lookup creation installs weak keys on a fresh table"
 (r/lua-tf-x-lu-create '[_]) => '(setmetatable {} {"__mode" "k"}))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-lu-get}
(fact "lookup keys use the object's string identity"
 (r/lua-tf-x-lu-get '[_ lookup object]) => '(. lookup [(tostring object)]))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-lu-set}
(fact "lookup assignment retains the supplied identifier"
 (r/lua-tf-x-lu-set '[_ lookup object identifier])
 => '(:= (. lookup [(tostring object)]) identifier))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-lu-del}
(fact "lookup deletion uses the same identity key"
 (r/lua-tf-x-lu-del '[_ lookup object]) => '(:= (. lookup [(tostring object)]) nil))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-and}
(fact "bitwise and uses the original bit library"
 (r/lua-tf-x-bit-and '[_ left right]) => '(bit.band left right))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-or}
(fact "bitwise or uses the original bit library"
 (r/lua-tf-x-bit-or '[_ left right]) => '(bit.bor left right))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-lshift}
(fact "left shift retains the shift distance"
 (r/lua-tf-x-bit-lshift '[_ value distance]) => '(bit.lshift value distance))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-rshift}
(fact "right shift retains the shift distance"
 (r/lua-tf-x-bit-rshift '[_ value distance]) => '(bit.rshift value distance))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-xor}
(fact "bitwise xor uses the original bit library"
 (r/lua-tf-x-bit-xor '[_ left right]) => '(bit.bxor left right))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-arr-clone}
(fact "array cloning unpacks into a new vector expression"
 (r/lua-tf-x-arr-clone '[_ array]) => '[(unpack array)])
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-arr-slice}
(fact "array slicing offsets start and preserves the upper bound"
 (r/lua-tf-x-arr-slice '[_ array 0 4]) => '[(unpack array (x:offset 0) 4)])
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-arr-remove}
(fact "array removal offsets the external index"
 (r/lua-tf-x-arr-remove '[_ array index]) => '(table.remove array (x:offset index)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-arr-push-first}
(fact "array prepend inserts at Lua index one"
 (r/lua-tf-x-arr-push-first '[_ array item]) => '(table.insert array 1 item))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-arr-pop-first}
(fact "array shift removes Lua index one"
 (r/lua-tf-x-arr-pop-first '[_ array]) => '(table.remove array 1))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-arr-insert}
(fact "the original insertion leaves its supplied index unchanged"
 (r/lua-tf-x-arr-insert '[_ array index item]) => '(table.insert array index item))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-arr-sort}
(fact "preserves the pinned sort form including its extra empty-list argument"
 (r/lua-tf-x-arr-sort '[_ array key-fn compare-fn])
 => '(table.sort () array (fn [a b] (return (compare-fn (key-fn a) (key-fn b))))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-join}
(fact "string joining puts the collection before its separator"
 (r/lua-tf-x-str-join '[_ separator array]) => '(table.concat array separator))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-index-of}
(fact "string search retains minus-one fallback"
 (r/lua-tf-x-str-index-of '[_ text token]) => '(or (string.find text token) -1))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-to-fixed}
(fact "fixed precision builds the exact Lua format string"
 (r/lua-tf-x-str-to-fixed '[_ number digits]) => '(string.format (cat "%." digits "f") number))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-replace}
(fact "string replacement preserves all three operands"
 (r/lua-tf-x-str-replace '[_ text token replacement]) => '(string.gsub text token replacement))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-trim}
(fact "trim preserves the anchored whitespace pattern and capture"
 (r/lua-tf-x-str-trim '[_ text]) => '(string.gsub text "^%s*(.-)%s*$" "%1"))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-trim-left}
(fact "left trim uses only the initial whitespace pattern"
 (r/lua-tf-x-str-trim-left '[_ text]) => '(string.gsub text "^%s*" ""))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-trim-right}
(fact "right trim preserves initial whitespace through the capture"
 (r/lua-tf-x-str-trim-right '[_ text]) => '(string.gsub text "^(%s*.-)%s*$" "%1"))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-decode}
(fact "string decoding unpacks byte arguments into string.char"
 (r/lua-tf-x-str-decode '[_ bytes]) => '(string.char (x:unpack bytes)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-not}
(fact "bitwise negation uses bit.bnot"
 (r/lua-tf-x-bit-not '[_ value]) => '(bit.bnot value))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-iter-from-obj}
(fact "object iteration yields key-value pairs from a coroutine"
 (r/lua-tf-x-iter-from-obj '[_ object])
 => '(coroutine.wrap (fn [] (for [k v :in (pairs object)] (coroutine.yield [k v])))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-iter-from-arr}
(fact "array iteration yields values in ipairs order"
 (r/lua-tf-x-iter-from-arr '[_ array])
 => '(coroutine.wrap (fn [] (for [_ v :in (ipairs array)] (coroutine.yield v)))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-iter-from}
(fact "preserves the original iterator body even though it yields a different symbol"
 (r/lua-tf-x-iter-from '[_ object])
 => '(coroutine.wrap (fn [] (for [e :in (. object ["iterator"])] (coroutine.yield v)))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-iter-eq}
(fact "iterator equality stops on mismatch and checks right-side exhaustion"
 (r/lua-tf-x-iter-eq '[_ left right equal])
 => '(do (for [x0 :in left]
           (var x1 (right))
           (when (not (equal x0 x1)) (return false)))
         (return (== nil (right)))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-iter-next}
(fact "iterator next invokes the supplied iterator"
 (r/lua-tf-x-iter-next '[_ iterator]) => '(iterator))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-iter-has?}
(fact "iterator support requires a table with a function-valued iterator field"
 (r/lua-tf-x-iter-has? '[_ object])
 => '(and (== "table" (type object)) (== "function" (. '(object) ["iterator"]))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-iter-native?}
(fact "native Lua iterators are functions"
 (r/lua-tf-x-iter-native? '[_ iterator]) => '(== "function" (type iterator)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-async-run}
(fact "async run creates and resumes the supplied coroutine"
 (r/lua-tf-x-async-run '[_ thunk]) => '(coroutine.resume (coroutine.create thunk)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-with-delay}
(fact "delayed execution converts milliseconds to seconds before invoking thunk"
 (r/lua-tf-x-with-delay '[_ milliseconds thunk])
 => '(do (var socket (require "socket"))
         (socket.sleep (/ milliseconds 1000.0))
         (return (thunk))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-pwd}
(fact "working directory reads the original PWD environment variable"
 (r/lua-tf-x-pwd '[_]) => '(os.getenv "PWD"))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-file-resolve}
(fact "path resolution preserves nil-root and absolute-path branches"
 (r/lua-tf-x-file-resolve '[_ root path])
 => '(:? (or (== nil root) (== "/" (string.sub path 1 1))) path (cat root "/" path)))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-type-native}
(fact "native type classification preserves metatable and first-index array detection"
 (r/lua-tf-x-type-native '[_ value])
 => '(do (var t := (type value))
         (if (== t "table")
           (if (or (and (not= nil cjson)
                        (not= nil (. cjson ["array_mt"]))
                        (== (getmetatable value) (. cjson ["array_mt"])))
                   (not= nil (. '(value) [1])))
             (return "array") (return "object"))
           (return t))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-object?}
(fact "object classification excludes marked arrays and nonempty indexed tables"
 (r/lua-tf-x-is-object? '[_ value])
 => '(or (and (== "table" (type value))
              (or (== nil cjson)
                  (== nil (. cjson ["array_mt"]))
                  (not= (getmetatable value) (. cjson ["array_mt"])))
              (== nil (. '(value) [1])))
         (== "object" (type value))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-array?}
(fact "array classification accepts marked or nonempty indexed tables"
 (r/lua-tf-x-is-array? '[_ value])
 => '(or (and (== "table" (type value))
              (or (and (not= nil cjson)
                       (not= nil (. cjson ["array_mt"]))
                       (== (getmetatable value) (. cjson ["array_mt"])))
                  (not= nil (. '(value) [1]))))
         (== "array" (type value))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-split}
(fact "string splitting retains the quoted immediate lambda and pattern"
 (r/lua-tf-x-str-split '[_ text separator])
 => '('((fn [s tok]
           (var out := {})
           (string.gsub s (string.format "([^%s]+)" tok)
                        (fn [c] (table.insert out c)))
           (return out)))
       text separator))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-str-encode}
(fact "string encoding preserves ordered byte extraction through gsub"
 (r/lua-tf-x-str-encode '[_ text])
 => '('((fn [s]
           (var out := {})
           (string.gsub s "." (fn [c] (table.insert out (string.byte c))))
           (return out)))
       text))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-file-read}
(fact "file reading checks open failure closes the handle and returns encoded bytes"
 (r/lua-tf-x-file-read '[_ filename])
 => '(x:promise (fn []
                  (var '[handle err] (io.open filename "rb"))
                  (when err (x:err err))
                  (var out (handle:read "*a"))
                  (handle:close)
                  (return (x:str-encode out)))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-file-write}
(fact "file writing closes before reporting write failure and returns nil"
 (r/lua-tf-x-file-write '[_ filename bytes])
 => '(x:promise (fn []
                  (var '[handle err] (io.open filename "wb"))
                  (when err (x:err err))
                  (var '[out write-err] (handle:write (x:str-decode bytes)))
                  (handle:close)
                  (when write-err (x:err write-err))
                  (return nil))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-shell}
(fact "shell execution preserves literal root and both process failure branches"
 (r/lua-tf-x-shell '[_ command directory callback])
 => '(do* (var command (:? root (cat "cd " root " && " command) command))
          (var '[ok handle] (pcall (fn [] (return (io.popen command)))))
          (if (not ok)
            (return (callback handle nil))
            (do* (var res (handle:read "*a"))
                 (var '[closed reason code] (handle:close))
                 (if closed
                   (return (callback nil res))
                   (return (callback {:err reason :code code :out res} nil)))))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-socket-connect}
(fact "socket connection preserves docker resolution and callback outcome ordering"
 (r/lua-tf-x-socket-connect '[_ hostname port options callback])
 => '(do* (when (== hostname "host.docker.internal")
            (var handle (io.popen
                         (cat "ping host.docker.internal -c 1 -q 2>&1"
                              " | " "grep -Po \"(\\d{1,3}\\.){3}\\d{1,3}\"")))
            (:= hostname (handle:read "*a"))
            (:= hostname (string.sub hostname 1 (- (len hostname) 1)))
            (handle:close))
          (var socket (require "socket"))
          (var '[conn err] (socket.connect hostname port))
          (if err (return (callback err nil)) (return (callback nil conn)))))
^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-return-encode}
(fact "return encoding preserves nil tagging recursive filtering and raw fallback"
 (r/lua-tf-x-return-encode '[_ result request-id request-key])
 => '(do
       (var ret nil)
       (var type-fn
            (fn [obj]
              (var t (type obj))
              (if (== t "table")
                (if (== nil (. '(obj) [1])) (return "object") (return "array"))
                (return t))))
       (var json-filter
            (fn [obj]
              (var t (type obj))
              (if (== t "table")
                (do (var mt (getmetatable obj))
                    (if (or (and (not= nil mt)
                                 (not= nil (. cjson ["array_mt"]))
                                 (== mt (. cjson ["array_mt"])))
                            (not= nil (. '(obj) [1])))
                      (do (var out {})
                          (var max 0)
                          (for:object [[k v] obj]
                            (when (== "number" (type k))
                              (when (> k max) (:= max k))))
                          (for:index [i [1 max]]
                            (var v (. obj [i]))
                            (if (== nil v)
                              (:= (. out [i]) (. cjson ["null"]))
                              (if (== "function" (type v))
                                (:= (. out [i]) (. cjson ["null"]))
                                (:= (. out [i]) (json-filter v)))))
                          (setmetatable out mt)
                          (return out))
                      (do (var out {})
                          (for:object [[k v] obj]
                            (when (not= "function" (type v))
                              (:= (. out [k]) (json-filter v))))
                          (return out))))
                (if (== t "function") (return (. cjson ["null"])) (return obj)))))
       (var '[r-ok r-err]
            (pcall (fn []
                     (cond (== nil result)
                           (:= ret (cjson.encode {:id request-id :key request-key
                                                  :return "nil" :type "data"
                                                  :value (. cjson ["null"])}))
                           :else
                           (:= ret (cjson.encode {:id request-id :key request-key
                                                  :return (type-fn result) :type "data"
                                                  :value (json-filter result)}))))))
       (cond r-err
             (return (cjson.encode {:id request-id :key request-key :type "raw"
                                    :return (type-fn result) :error (tostring r-err)
                                    :value (tostring result)}))
             :else (return ret))))
