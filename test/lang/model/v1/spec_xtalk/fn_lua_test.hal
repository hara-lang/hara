^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-and, :id native-regression-lua-tf-x-bit-and}
(fact
  "restores pinned lua-tf-x-bit-and bit-library expansion"
  (r/lua-tf-x-bit-and '[_ left right])
  =>
  '(bit.band left right))

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-or, :id native-regression-lua-tf-x-bit-or}
(fact
  "restores pinned lua-tf-x-bit-or bit-library expansion"
  (r/lua-tf-x-bit-or '[_ left right])
  =>
  '(bit.bor left right))

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-xor, :id native-regression-lua-tf-x-bit-xor}
(fact
  "restores pinned lua-tf-x-bit-xor bit-library expansion"
  (r/lua-tf-x-bit-xor '[_ left right])
  =>
  '(bit.bxor left right))

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-socket-connect, :id native-regression-lua-tf-x-socket-connect}
(fact
  "builds the Lua socket connection form"
  (let [form (r/lua-tf-x-socket-connect
               '(x:socket-connect host port opts cb))]
    [(first form)
     (first (nth form 1))
     (first (nth form 2))
     (first (nth form 3))
     (first (nth form 4))])
  =>
  ['do* 'when 'var 'var 'if])

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-socket-send, :id native-regression-lua-tf-x-socket-send}
(fact
  "builds the Lua socket send form"
  (let [form (r/lua-tf-x-socket-send '(x:socket-send conn bytes))]
    [(first form) (nth form 1) (first (nth form 2))])
  =>
  ['. 'conn 'send])

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-socket-close, :id native-regression-lua-tf-x-socket-close}
(fact
  "builds the Lua socket close form"
  (let [form (r/lua-tf-x-socket-close '(x:socket-close conn))]
    [(first form) (nth form 1) (first (nth form 2))])
  =>
  ['. 'conn 'close])

^{:refer lang.model.v1.spec-xtalk.fn-lua/+lua-socket+, :id native-regression-+lua-socket+}
(fact
  "registers all Lua socket operators"
  [(count r/+lua-socket+)
   (get-in r/+lua-socket+ [:x-socket-connect :emit])
   (get-in r/+lua-socket+ [:x-socket-connect :op-spec :allow-blocks])]
  =>
  [3 :macro true])
