(ns lang.model.v1.spec-xtalk.fn-lua-test
  (:use code.test)
  (:require [lang.model.v1.spec-xtalk.fn-lua :as subject]))

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-string?}
(fact "lowers the Lua string predicate"
  (subject/lua-tf-x-is-string? '(x:is-string? value))
  => '(== "string" (type value)))

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-number?}
(fact "lowers the Lua number predicate"
  (subject/lua-tf-x-is-number? '(x:is-number? value))
  => '(== "number" (type value)))

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-boolean?}
(fact "lowers the Lua boolean predicate"
  (subject/lua-tf-x-is-boolean? '(x:is-boolean? value))
  => '(== "boolean" (type value)))

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-function?}
(fact "lowers the Lua function predicate"
  (subject/lua-tf-x-is-function? '(x:is-function? value))
  => '(== "function" (type value)))

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-and}
(fact "lowers Lua bitwise and through the portable bit loop"
  (let [form (subject/lua-tf-x-bit-and '(x:bit-and left right))]
    [(first (first form)) (nth form 1) (nth form 2)])
  => ['fn 'left 'right])

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-or}
(fact "lowers Lua bitwise or through the portable bit loop"
  (let [form (subject/lua-tf-x-bit-or '(x:bit-or left right))]
    [(first (first form)) (nth form 1) (nth form 2)])
  => ['fn 'left 'right])

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-bit-xor}
(fact "lowers Lua bitwise xor through the portable bit loop"
  (let [form (subject/lua-tf-x-bit-xor '(x:bit-xor left right))]
    [(first (first form)) (nth form 1) (nth form 2)])
  => ['fn 'left 'right])

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-socket-connect}
(fact "builds the Lua socket connection form"
  (let [form (subject/lua-tf-x-socket-connect
              '(x:socket-connect host port opts cb))]
    [(first form)
     (first (nth form 1))
     (first (nth form 2))
     (first (nth form 3))
     (first (nth form 4))])
  => ['do* 'when 'var 'var 'if])

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-socket-send}
(fact "builds the Lua socket send form"
  (let [form (subject/lua-tf-x-socket-send
              '(x:socket-send conn bytes))]
    [(first form) (nth form 1) (first (nth form 2))])
  => ['. 'conn 'send])

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-socket-close}
(fact "builds the Lua socket close form"
  (let [form (subject/lua-tf-x-socket-close
              '(x:socket-close conn))]
    [(first form) (nth form 1) (first (nth form 2))])
  => ['. 'conn 'close])

^{:refer lang.model.v1.spec-xtalk.fn-lua/+lua-socket+}
(fact "registers all Lua socket operators"
  [(count subject/+lua-socket+)
   (get-in subject/+lua-socket+ [:x-socket-connect :emit])
   (get-in subject/+lua-socket+ [:x-socket-connect :op-spec :allow-blocks])]
  => [3 :macro true])
