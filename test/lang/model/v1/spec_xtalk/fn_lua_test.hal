^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-string?, :id native-regression-lua-tf-x-is-string?}
(fact
  "lowers the Lua string predicate"
  (r/lua-tf-x-is-string? '(x:is-string? value))
  =>
  '(== "string" (type value)))

^{:refer lang.model.v1.spec-xtalk.fn-lua/lua-tf-x-is-number?, :id native-regression-lua-tf-x-is-number?}
(fact
  "lowers the Lua number predicate"
