(ns lang.model.v1.spec-xtalk.fn-js-test
  (:use code.test)
  (:require [lang.model.v1.spec-xtalk.fn-js :as subject]))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-is-string?}
(fact "lowers the JavaScript string predicate"
  (subject/js-tf-x-is-string? '(x:is-string? value))
  => '(== "string" (typeof value)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-is-number?}
(fact "lowers the JavaScript number predicate"
  (subject/js-tf-x-is-number? '(x:is-number? value))
  => '(== "number" (typeof value)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-is-boolean?}
(fact "lowers the JavaScript boolean predicate"
  (subject/js-tf-x-is-boolean? '(x:is-boolean? value))
  => '(== "boolean" (typeof value)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-is-function?}
(fact "lowers the JavaScript function predicate"
  (subject/js-tf-x-is-function? '(x:is-function? value))
  => '(== "function" (typeof value)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-arr-push}
(fact "lowers JavaScript array push"
  (subject/js-tf-x-arr-push '(x:arr-push arr value))
  => '(. arr (push value)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-arr-pop}
(fact "lowers JavaScript array pop"
  (subject/js-tf-x-arr-pop '(x:arr-pop arr))
  => '(. arr (pop)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-arr-push-first}
(fact "lowers JavaScript array unshift"
  (subject/js-tf-x-arr-push-first '(x:arr-push-first arr value))
  => '(. arr (unshift value)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-arr-pop-first}
(fact "lowers JavaScript array shift"
  (subject/js-tf-x-arr-pop-first '(x:arr-pop-first arr))
  => '(. arr (shift)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-arr-remove}
(fact "lowers JavaScript array removal"
  (subject/js-tf-x-arr-remove '(x:arr-remove arr index))
  => '(. arr (splice index 1)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-arr-insert}
(fact "lowers JavaScript array insertion"
  (subject/js-tf-x-arr-insert '(x:arr-insert arr index value))
  => '(. arr (splice index 0 value)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-arr-map}
(fact "lowers JavaScript array map"
  (subject/js-tf-x-arr-map '(x:arr-map arr f))
  => '(. arr (map f)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-arr-foldl}
(fact "lowers JavaScript left fold"
  (subject/js-tf-x-arr-foldl '(x:arr-foldl arr f initial))
  => '(. arr (reduce f initial)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-arr-foldr}
(fact "lowers JavaScript right fold"
  (subject/js-tf-x-arr-foldr '(x:arr-foldr arr f initial))
  => '(. arr (reduceRight f initial)))

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-socket-connect}
(fact "builds the JavaScript socket connection form"
  (let [form (subject/js-tf-x-socket-connect
              '(x:socket-connect host port opts cb))]
    [(first form)
     (first (nth form 1))
     (nth (nth form 1) 1)
     (first (nth form 3))
     (first (nth (nth (nth form 3) 1) 2))])
  => ['do* 'var 'net 'return 'connect])

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-socket-send}
(fact "builds the JavaScript socket send form"
  (let [form (subject/js-tf-x-socket-send
              '(x:socket-send conn bytes))]
    [(first form) (nth form 2) (first (nth form 1))])
  => ['x:get-idx 1 '(. conn (write bytes))])

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-socket-close}
(fact "builds the JavaScript socket close form"
  (let [form (subject/js-tf-x-socket-close
              '(x:socket-close conn))]
    [(first form) (nth form 1) (first (nth form 2))])
  => ['. 'conn 'end])

^{:refer lang.model.v1.spec-xtalk.fn-js/+js-socket+}
(fact "registers all JavaScript socket operators"
  [(count subject/+js-socket+)
   (get-in subject/+js-socket+ [:x-socket-connect :emit])
   (get-in subject/+js-socket+ [:x-socket-connect :op-spec :allow-blocks])]
  => [3 :macro true])

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-notify-http}
(fact "builds the JavaScript HTTP notification form"
  (let [form (subject/js-tf-x-notify-http
              '(x:notify-http host port value id key opts))
        options (nth form 1)
        fetch-form (nth form 2)
        request (nth fetch-form 2)]
    [(first form)
     options
     (first fetch-form)
     (get request :method)
     (first (nth form 3))
     (first (nth form 4))])
  => ['try
      '(var #{path scheme} (or opts {}))
      'fetch
      "POST"
      'return
      'catch])

^{:refer lang.model.v1.spec-xtalk.fn-js/js-tf-x-with-delay}
(fact "builds the JavaScript delayed promise form"
  (let [form (subject/js-tf-x-with-delay
              '(x:with-delay ms thunk))
        executor (nth form 2)
        timer (nth executor 2)]
    [(first form)
     (second form)
     (first executor)
     (first timer)
     (last timer)])
  => ['new 'Promise 'fn 'setTimeout 'ms])
