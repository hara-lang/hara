(ns lang.model.v1.spec-xtalk.fn-python-test (:require [lang.core.impl :as l] [lang.core.library :as lib] [lang.model.v1.spec-python :as model] [lang.model.v1.spec-xtalk :as xtalk] [lang.model.v1.spec-xtalk.fn-python :refer :all] [code.test :refer :all]) (:config {:role :internal}))

(def migration-library (lib/library:create {}))
(fact:global {:teardown [(lib/reset-all! migration-library) (reset! (:settings migration-library) {})]})
(lib/install-book! migration-library xtalk/+book+)
(lib/install-book! migration-library model/+book+)


^{:refer lang.model.v1.spec-xtalk.fn-python/+python-promise+, :added "4.1"}
(fact
  "async run emits a host thread start"
  (l/with:library
    [migration-library]
    (l/emit-as :python [(python-tf-x-async-run '[_ thunk])]))
  =>
  (satisfies #"(?s)threading.*Thread.*target"))

^{:refer lang.model.v1.spec-xtalk.fn-python/+python-iter, :added "4.1"}
(fact
  "iter null"
  (l/with:library
    [migration-library]
    (l/emit-as :python [(:default (:x-iter-null +python-iter+))]))
  =>
  (satisfies #"iter"))

^{:refer xt.lang.spec-primitive/throw, :added "4.1"}
(fact
  "normalizes thrown values and catch bindings"
  (l/with:library
    [migration-library]
    (let [out (l/emit-as
                :python
                ['(do:>
                    (try (throw "boom") (catch err (return err))))])]
      [(boolean (re-find #"(?s)raise .*Exception" out))
       (boolean (re-find #"except Exception as [^:]+:" out))]))
  =>
  [true true])

