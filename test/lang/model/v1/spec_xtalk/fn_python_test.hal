^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-del}
(fact "deletion preserves binding forms and lowers only supported key-access shapes"
 [(py/python-tf-x-del '[_ obj])
  (py/python-tf-x-del '[_ (. obj ["key"])])
  (py/python-tf-x-del '[_ (. obj [key])])
  (py/python-tf-x-del '[_ (x:get-key obj key)])
  (py/python-tf-x-del '[_ (xt/x:get-key obj key fallback)])
  (py/python-tf-x-del '[_ (. obj [])])
  (py/python-tf-x-del '[_ (. obj [a b])])
  (py/python-tf-x-del '[_ (x:get-key obj)])
  (py/python-tf-x-del '[_ (x:get-key obj key fallback extra)])
  (py/python-tf-x-del '[_ (. obj (get key))])]
 => '[(del obj)
      (del (. obj (setitem "key")))
      (del (. obj (setitem key)))
      (del (. obj (setitem key)))
      (del (. obj (setitem key)))
      (del (. obj []))
      (del (. obj [a b]))
      (del (x:get-key obj))
      (del (x:get-key obj key fallback extra))
      (del (. obj (get key)))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-del-key}
(fact "key deletion uses pop with an explicit nil default and preserves key expressions"
 [(py/python-tf-x-del-key '[_ obj "key"])
  (py/python-tf-x-del-key '[_ (make-object) (key-fn)])]
 => '[(. obj (pop "key" nil)) (. (make-object) (pop (key-fn) nil))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-get-key}
(fact "key access distinguishes nil from false zero and empty-string defaults"
 [(py/python-tf-x-get-key '[_ obj key])
  (py/python-tf-x-get-key '[_ obj key nil])
  (py/python-tf-x-get-key '[_ obj key false])
  (py/python-tf-x-get-key '[_ obj key 0])
  (py/python-tf-x-get-key '[_ obj key ""])
  (py/python-tf-x-get-key '[_ (make-object) (key-fn) (fallback)])]
 => '[(. obj (get key)) (. obj (get key))
      (or (. obj (get key)) false) (or (. obj (get key)) 0)
      (or (. obj (get key)) "")
      (or (. (make-object) (get (key-fn))) (fallback))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-has-key?}
(fact "key presence preserves the original non-nil test and explicit comparison branch"
 [(py/python-tf-x-has-key? '[_ obj key])
  (py/python-tf-x-has-key? '[_ obj key nil])
  (py/python-tf-x-has-key? '[_ obj key false])
  (py/python-tf-x-has-key? '[_ obj key 0])
  (py/python-tf-x-has-key? '[_ obj key ""])
  (py/python-tf-x-has-key? '[_ (make-object) (key-fn) (check-fn)])]
 => '[(not= nil (. obj (get key))) (not= nil (. obj (get key)))
      (== false (x:get-key obj key nil)) (== 0 (x:get-key obj key nil))
      (== "" (x:get-key obj key nil))
      (== (check-fn) (x:get-key (make-object) (key-fn) nil))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-set-key}
(fact "key assignment uses setitem even for literal keys and preserves value expressions"
 [(py/python-tf-x-set-key '[_ obj "key" nil])
  (py/python-tf-x-set-key '[_ obj key false])
  (py/python-tf-x-set-key '[_ (make-object) (key-fn) (value-fn)])]
 => '[(:= (. obj (setitem "key")) nil)
      (:= (. obj (setitem key)) false)
      (:= (. (make-object) (setitem (key-fn))) (value-fn))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-cat}
(fact "concatenation keeps zero one and many operands in their original order"
 [(py/python-tf-x-cat '[_])
  (py/python-tf-x-cat '[_ "a"])
  (py/python-tf-x-cat '[_ "a" (str b) "c"])]
 => '[(+) (+ "a") (+ "a" (str b) "c")])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-len}
(fact "length preserves literals and compound operand forms"
 [(py/python-tf-x-len '[_ []])
  (py/python-tf-x-len '[_ "abc"])
  (py/python-tf-x-len '[_ (load-items)])]
 => '[(len []) (len "abc") (len (load-items))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-err}
(fact "error construction preserves literal and computed messages"
 [(py/python-tf-x-err '[_ "boom"])
  (py/python-tf-x-err '[_ (message-fn)])
  (py/python-tf-x-err '[_ nil])]
 => '[(throw (Exception "boom")) (throw (Exception (message-fn))) (throw (Exception nil))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-ex-native?}
(fact "native exception recognition uses BaseException for any operand form"
 [(py/python-tf-x-ex-native? '[_ err])
  (py/python-tf-x-ex-native? '[_ (fetch-error)])
  (py/python-tf-x-ex-native? '[_ nil])]
 => '[(isinstance err BaseException) (isinstance (fetch-error) BaseException) (isinstance nil BaseException)])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-ex-new}
(fact "exception data is omitted only when missing or nil"
 [(py/python-tf-x-ex-new '[_ "boom"])
  (py/python-tf-x-ex-new '[_ "boom" nil])
  (py/python-tf-x-ex-new '[_ "boom" false])
  (py/python-tf-x-ex-new '[_ "boom" 0])
  (py/python-tf-x-ex-new '[_ "boom" ""])
  (py/python-tf-x-ex-new '[_ (message-fn) {:code 7}])]
 => '[(Exception "boom") (Exception "boom")
      (Exception "boom" false) (Exception "boom" 0) (Exception "boom" "")
      (Exception (message-fn) {:code 7})])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-ex-message}
(fact "exception message guards type and argument length before selecting index zero"
 [(py/python-tf-x-ex-message '[_ err])
  (py/python-tf-x-ex-message '[_ (fetch-error)])]
 => '[(:? (isinstance err BaseException)
           (:? (> (len (. err args)) 0) (. (. err args) [0]) nil) nil)
      (:? (isinstance (fetch-error) BaseException)
           (:? (> (len (. (fetch-error) args)) 0) (. (. (fetch-error) args) [0]) nil) nil)])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-ex-data}
(fact "exception data guards type and two arguments before selecting index one"
 [(py/python-tf-x-ex-data '[_ err])
  (py/python-tf-x-ex-data '[_ (fetch-error)])]
 => '[(:? (isinstance err BaseException)
           (:? (> (len (. err args)) 1) (. (. err args) [1]) nil) nil)
      (:? (isinstance (fetch-error) BaseException)
           (:? (> (len (. (fetch-error) args)) 1) (. (. (fetch-error) args) [1]) nil) nil)])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-eval}
(fact "evaluation preserves code strings and computed input without evaluating them"
 [(py/python-tf-x-eval '[_ "1 + 2"])
  (py/python-tf-x-eval '[_ (source-fn)])]
 => '[(eval "1 + 2") (eval (source-fn))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-apply}
(fact "function application creates one unpack operand for empty literal and computed arguments"
 [(py/python-tf-x-apply '[_ f []])
  (py/python-tf-x-apply '[_ f [1 false nil]])
  (py/python-tf-x-apply '[_ (get-fn) (get-args)])]
 => '[(f (:* [])) (f (:* [1 false nil])) ((get-fn) (:* (get-args)))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-construct}
(fact "construction preserves the constructor and creates one unpack operand"
 [(py/python-tf-x-construct '[_ Thing []])
  (py/python-tf-x-construct '[_ Thing [1 false nil]])
  (py/python-tf-x-construct '[_ (get-ctor) (get-args)])]
 => '[(Thing (:* [])) (Thing (:* [1 false nil])) ((get-ctor) (:* (get-args)))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-random}
(fact "random expansion imports Python random and ignores the input marker"
 [(py/python-tf-x-random '[_])
  (py/python-tf-x-random '[_ ignored])]
 => '[(. (__import__ "random") (random)) (. (__import__ "random") (random))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-print}
(fact "print retains zero one and many arguments in order"
 [(py/python-tf-x-print '[_])
  (py/python-tf-x-print '[_ "hello"])
  (py/python-tf-x-print '[_ "hello" (value-fn) false nil])]
 => '[(print) (print "hello") (print "hello" (value-fn) false nil)])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-type-native}
(fact "native type expansion preserves all branches and checks boolean before number"
 (py/python-tf-x-type-native '[_ obj])
 => '(cond (isinstance obj '(dict)) (return "object")
           (isinstance obj '(list)) (return "array")
           (callable obj) (return "function")
           (== bool (type obj)) (return "boolean")
           (isinstance obj '(int float)) (return "number")
           (isinstance obj '(str)) (return "string")
           :else (return (str (type obj)))))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-ex-new :id :python-exception-ignored-tail}
(fact "exception construction ignores operands beyond the first optional data value"
 [(py/python-tf-x-ex-new '[_ "boom" nil extra]) (py/python-tf-x-ex-new '[_ "boom" {:code 7} extra])]
 => '[(Exception "boom") (Exception "boom" {:code 7})])

