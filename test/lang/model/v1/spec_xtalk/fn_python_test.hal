^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-return-encode, :id :pinned-python-return-0}
(fact "preserves pinned python-tf-x-return-encode expansion case 0" (py/python-tf-x-return-encode (quote [_ out id key])) => (quote (do (:- :import json) (var type-fn (fn [obj] (cond (isinstance obj (quote (dict))) (return "object") (isinstance obj (quote (list))) (return "array") (callable obj) (return "function") (== bool (type obj)) (return "boolean") (isinstance obj (quote (int float))) (return "number") (isinstance obj (quote (str))) (return "string") :else (return (str (type obj)))))) (var json-filter (fn [obj] (cond (isinstance obj (quote (dict))) (do (var out {}) (for:object [[k v] obj] (when (not (callable v)) (:= (. out [k]) (json-filter v)))) (return out)) (isinstance obj (quote (list))) (do (var out []) (for:array [v obj] (when (not (callable v)) (. out (append (json-filter v))))) (return out)) (callable obj) (return nil) :else (return obj)))) (var ts (type-fn out)) (try (return (json.dumps {:id id, :key key, :type "data", :return ts, :value (json-filter out)})) (catch Exception (return (json.dumps {:id id, :key key, :type "raw", :return ts, :value (str out)})))))))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-return-wrap, :id :pinned-python-return-1}
(fact "preserves pinned python-tf-x-return-wrap expansion case 1" (py/python-tf-x-return-wrap (quote [_ f encode-fn])) => (quote (do (:- :import json) (try (:= out (f)) (catch [Exception :as e] (return (json.dumps {:type "error", :value (str e)})))) (return (encode-fn out nil nil)))))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-return-eval, :id :pinned-python-return-2}
(fact "preserves pinned python-tf-x-return-eval expansion case 2" (py/python-tf-x-return-eval (quote [_ s wrap-fn])) => (quote (do (fn thunk [] (let [g (globals)] (exec s g g) (return (g.get "OUT")))) (return (wrap-fn thunk)))))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-return-encode, :id :pinned-python-return-3}
(fact "preserves pinned python-tf-x-return-encode expansion case 3" (py/python-tf-x-return-encode (quote [_ (get data :value) nil :tag])) => (quote (do (:- :import json) (var type-fn (fn [obj] (cond (isinstance obj (quote (dict))) (return "object") (isinstance obj (quote (list))) (return "array") (callable obj) (return "function") (== bool (type obj)) (return "boolean") (isinstance obj (quote (int float))) (return "number") (isinstance obj (quote (str))) (return "string") :else (return (str (type obj)))))) (var json-filter (fn [obj] (cond (isinstance obj (quote (dict))) (do (var out {}) (for:object [[k v] obj] (when (not (callable v)) (:= (. out [k]) (json-filter v)))) (return out)) (isinstance obj (quote (list))) (do (var out []) (for:array [v obj] (when (not (callable v)) (. out (append (json-filter v))))) (return out)) (callable obj) (return nil) :else (return obj)))) (var ts (type-fn (get data :value))) (try (return (json.dumps {:id nil, :key :tag, :type "data", :return ts, :value (json-filter (get data :value))})) (catch Exception (return (json.dumps {:id nil, :key :tag, :type "raw", :return ts, :value (str (get data :value))})))))))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-return-wrap, :id :pinned-python-return-4}
(fact "preserves pinned python-tf-x-return-wrap expansion case 4" (py/python-tf-x-return-wrap (quote [_ (fn [] 42) result/encode])) => (quote (do (:- :import json) (try (:= out ((fn [] 42))) (catch [Exception :as e] (return (json.dumps {:type "error", :value (str e)})))) (return (result/encode out nil nil)))))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-return-eval, :id :pinned-python-return-5}
(fact "preserves pinned python-tf-x-return-eval expansion case 5" (py/python-tf-x-return-eval (quote [_ "OUT = 3" result/wrap])) => (quote (do (fn thunk [] (let [g (globals)] (exec "OUT = 3" g g) (return (g.get "OUT")))) (return (result/wrap thunk)))))

