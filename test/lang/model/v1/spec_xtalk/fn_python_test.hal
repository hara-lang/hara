    [migration-library]
    (python-tf-x-get-key '[_ obj key default]))
  =>
  '(or (. obj (get key)) default))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-has-key?, :added "4.1"}
(fact
  "has key"
  (l/with:library
    [migration-library]
    (python-tf-x-has-key? '[_ obj key nil]))
  =>
  '(not= nil (. obj (get key))))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-err, :added "4.0"}
(fact
  "raises error"
  (l/with:library [migration-library] (python-tf-x-err '[_ "msg"]))
  =>
  '(throw (Exception "msg")))

