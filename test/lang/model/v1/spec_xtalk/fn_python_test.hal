(ns lang.model.v1.spec-xtalk.fn-python-test
  (:use code.test)
  (:require [lang.model.v1.spec-xtalk.fn-python :as subject]))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-err}
(fact "lowers a Python exception"
  (subject/python-tf-x-err '(x:err value))
  => '(throw (std.native.Exception value)))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-random}
(fact "lowers a Python random call"
  (subject/python-tf-x-random '(x:random))
  => '(. (__import__ "random") (random)))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-is-string?}
(fact "lowers the Python string predicate"
  (subject/python-tf-x-is-string? '(x:is-string? value))
  => '(isinstance value str))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-is-number?}
(fact "lowers the Python number predicate"
  (subject/python-tf-x-is-number? '(x:is-number? value))
  => '(isinstance value (quote (int float))))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-is-integer?}
(fact "lowers the Python integer predicate"
  (subject/python-tf-x-is-integer? '(x:is-integer? value))
  => '(isinstance value (quote (int))))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-is-boolean?}
(fact "lowers the Python boolean predicate"
  (subject/python-tf-x-is-boolean? '(x:is-boolean? value))
  => '(isinstance value bool))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-is-function?}
(fact "lowers the Python callable predicate"
  (subject/python-tf-x-is-function? '(x:is-function? value))
  => '(callable value))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-is-object?}
(fact "lowers the Python dictionary predicate"
  (subject/python-tf-x-is-object? '(x:is-object? value))
  => '(isinstance value dict))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-is-array?}
(fact "lowers the Python list predicate"
  (subject/python-tf-x-is-array? '(x:is-array? value))
  => '(isinstance value list))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-arr-push}
(fact "lowers Python array append"
  (subject/python-tf-x-arr-push '(x:arr-push arr value))
  => '(. arr (append value)))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-arr-pop}
(fact "lowers Python array pop"
  (subject/python-tf-x-arr-pop '(x:arr-pop arr))
  => '(. arr (pop)))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-arr-push-first}
(fact "lowers Python array insertion at the start"
  (subject/python-tf-x-arr-push-first '(x:arr-push-first arr value))
  => '(. arr (insert 0 value)))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-arr-pop-first}
(fact "lowers Python array removal at the start"
  (subject/python-tf-x-arr-pop-first '(x:arr-pop-first arr))
  => '(. arr (pop 0)))

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-socket-connect}
(fact "builds the Python socket connection form"
  (let [form (subject/python-tf-x-socket-connect
              '(x:socket-connect host port opts cb))]
    [(first form)
     (first (nth form 1))
     (first (nth form 2))
     (first (nth (nth form 2) 3))
     (first (nth form 3))
     (nth (nth (nth (nth form 2) 2) 2) 1)])
  => ['do ':- 'try 'catch 'return '(quote (host port))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-socket-send}
(fact "builds the Python socket send form"
  (let [form (subject/python-tf-x-socket-send
              '(x:socket-send conn bytes))]
    [(first form) (nth form 2) (first (nth form 1))])
  => ['x:get-idx 1 '(. conn (sendall (bytes bytes)))])

^{:refer lang.model.v1.spec-xtalk.fn-python/python-tf-x-socket-close}
(fact "builds the Python socket close form"
  (let [form (subject/python-tf-x-socket-close
              '(x:socket-close conn))]
    [(first form) (nth form 1) (first (nth form 2))])
  => ['. 'conn 'close])

^{:refer lang.model.v1.spec-xtalk.fn-python/+python-socket+}
(fact "registers all Python socket operators"
  [(count subject/+python-socket+)
   (get-in subject/+python-socket+ [:x-socket-connect :emit])
   (get-in subject/+python-socket+ [:x-socket-connect :op-spec :allow-blocks])]
  => [3 :macro true])
