(ns lang.model.v1.spec-xtalk.fn-go-test
  (:require [lang.model.v1.spec-xtalk.fn-go :refer :all])
  (:use code.test))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-len, :added "4.1"}
(fact "go-tf-x-len" (go-tf-x-len '(x:len arr)) => '(len arr))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-cat, :added "4.1"}
(fact "go-tf-x-cat" (go-tf-x-cat '(x:cat "a" "b")) => '(+ "a" "b"))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-print, :added "4.1"}
(fact
  "go-tf-x-print"
  (go-tf-x-print '(x:print "hello"))
  =>
  '(fmt.Println "hello"))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-abs, :added "4.1"}
(fact "go-tf-x-m-abs" (go-tf-x-m-abs '(x:m-abs n)) => '(math.Abs n))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-max, :added "4.1"}
(fact "go-tf-x-m-max" (go-tf-x-m-max '(x:m-max a b)) => '(math.Max a b))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-min, :added "4.1"}
(fact "go-tf-x-m-min" (go-tf-x-m-min '(x:m-min a b)) => '(math.Min a b))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-ceil, :added "4.1"}
(fact "go-tf-x-m-ceil" (go-tf-x-m-ceil '(x:m-ceil n)) => '(math.Ceil n))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-floor, :added "4.1"}
(fact
  "go-tf-x-m-floor"
  (go-tf-x-m-floor '(x:m-floor n))
  =>
  '(math.Floor n))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-sqrt, :added "4.1"}
(fact "go-tf-x-m-sqrt" (go-tf-x-m-sqrt '(x:m-sqrt n)) => '(math.Sqrt n))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-pow, :added "4.1"}
(fact "go-tf-x-m-pow" (go-tf-x-m-pow '(x:m-pow b e)) => '(math.Pow b e))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-split, :added "4.1"}
(fact
  "go-tf-x-str-split"
  (go-tf-x-str-split '(x:str-split s sep))
  =>
  '(strings.Split s sep))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-join, :added "4.1"}
(fact
  "go-tf-x-str-join"
  (go-tf-x-str-join '(x:str-join sep arr))
  =>
  '(strings.Join arr sep))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-index-of, :added "4.1"}
(fact
  "go-tf-x-str-index-of"
  (go-tf-x-str-index-of '(x:str-index-of s sub))
  =>
  '(strings.Index s sub))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-to-upper, :added "4.1"}
(fact
  "go-tf-x-str-to-upper"
  (go-tf-x-str-to-upper '(x:str-to-upper s))
  =>
  '(strings.ToUpper s))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-to-lower, :added "4.1"}
(fact
  "go-tf-x-str-to-lower"
  (go-tf-x-str-to-lower '(x:str-to-lower s))
  =>
  '(strings.ToLower s))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-trim, :added "4.1"}
(fact
  "go-tf-x-str-trim"
  (go-tf-x-str-trim '(x:str-trim s))
  =>
  '(strings.TrimSpace s))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-arr-push, :added "4.1"}
(fact
  "go-tf-x-arr-push"
  (go-tf-x-arr-push '(x:arr-push arr item))
  =>
  '(:= arr (append arr item)))

(ns lang.model.v1.spec-xtalk.fn-go-test
  (:require [lang.model.v1.spec-xtalk.fn-go :as subject]))

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-len}
(Test/check
 [{:name "emits Go len"
   :test (fn [] (subject/go-tf-x-len ['x 'items]))
   :expected (list 'len 'items)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-cat}
(Test/check
 [{:name "emits Go concatenation"
   :test (fn [] (subject/go-tf-x-cat ['x 'left 'right]))
   :expected (list '+ 'left 'right)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-print}
(Test/check
 [{:name "emits fmt.Println"
   :test (fn [] (subject/go-tf-x-print ['x 'value]))
   :expected (list 'fmt.Println 'value)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-abs}
(Test/check
 [{:name "emits math.Abs"
   :test (fn [] (subject/go-tf-x-m-abs ['x 'value]))
   :expected (list 'math.Abs 'value)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-max}
(Test/check
 [{:name "emits math.Max"
   :test (fn [] (subject/go-tf-x-m-max ['x 'left 'right]))
   :expected (list 'math.Max 'left 'right)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-min}
(Test/check
 [{:name "emits math.Min"
   :test (fn [] (subject/go-tf-x-m-min ['x 'left 'right]))
   :expected (list 'math.Min 'left 'right)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-ceil}
(Test/check
 [{:name "emits math.Ceil"
   :test (fn [] (subject/go-tf-x-m-ceil ['x 'value]))
   :expected (list 'math.Ceil 'value)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-floor}
(Test/check
 [{:name "emits math.Floor"
   :test (fn [] (subject/go-tf-x-m-floor ['x 'value]))
   :expected (list 'math.Floor 'value)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-sqrt}
(Test/check
 [{:name "emits math.Sqrt"
   :test (fn [] (subject/go-tf-x-m-sqrt ['x 'value]))
   :expected (list 'math.Sqrt 'value)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-m-pow}
(Test/check
 [{:name "emits math.Pow"
   :test (fn [] (subject/go-tf-x-m-pow ['x 'base 'exponent]))
   :expected (list 'math.Pow 'base 'exponent)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-split}
(Test/check
 [{:name "emits strings.Split"
   :test (fn [] (subject/go-tf-x-str-split ['x 'value 'separator]))
   :expected (list 'strings.Split 'value 'separator)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-join}
(Test/check
 [{:name "emits strings.Join"
   :test (fn [] (subject/go-tf-x-str-join ['x 'separator 'items]))
   :expected (list 'strings.Join 'items 'separator)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-index-of}
(Test/check
 [{:name "emits strings.Index"
   :test (fn [] (subject/go-tf-x-str-index-of ['x 'value 'substring]))
   :expected (list 'strings.Index 'value 'substring)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-to-upper}
(Test/check
 [{:name "emits strings.ToUpper"
   :test (fn [] (subject/go-tf-x-str-to-upper ['x 'value]))
   :expected (list 'strings.ToUpper 'value)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-to-lower}
(Test/check
 [{:name "emits strings.ToLower"
   :test (fn [] (subject/go-tf-x-str-to-lower ['x 'value]))
   :expected (list 'strings.ToLower 'value)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-str-trim}
(Test/check
 [{:name "emits strings.TrimSpace"
   :test (fn [] (subject/go-tf-x-str-trim ['x 'value]))
   :expected (list 'strings.TrimSpace 'value)}])

^{:refer lang.model.v1.spec-xtalk.fn-go/go-tf-x-arr-push}
(Test/check
 [{:name "emits append assignment"
   :test (fn [] (subject/go-tf-x-arr-push ['x 'items 'value]))
   :expected (list ':= 'items (list 'append 'items 'value))}])


(ns lang.model.v1.spec-xtalk.fn-go-test
  (:require [lang.model.v1.spec-xtalk.fn-go :refer :all])
  (:use code.test))

^{:refer lang.model.v1.spec-xtalk.fn-go/+go-core+ :id original-core-vars}
(fact "Go core entries retain original Var callbacks and value flags"
  +go-core+
  => {:x-print {:macro #'go-tf-x-print :emit :macro :value true}
      :x-len {:macro #'go-tf-x-len :emit :macro :value true}
      :x-cat {:macro #'go-tf-x-cat :emit :macro :value true}})

^{:refer lang.model.v1.spec-xtalk.fn-go/+go-math+ :id original-math-vars}
(fact "Go math entries retain all seven original Var callbacks"
  +go-math+
  => {:x-m-abs {:macro #'go-tf-x-m-abs :emit :macro :value true}
      :x-m-max {:macro #'go-tf-x-m-max :emit :macro :value true}
      :x-m-min {:macro #'go-tf-x-m-min :emit :macro :value true}
      :x-m-ceil {:macro #'go-tf-x-m-ceil :emit :macro :value true}
      :x-m-floor {:macro #'go-tf-x-m-floor :emit :macro :value true}
      :x-m-sqrt {:macro #'go-tf-x-m-sqrt :emit :macro :value true}
      :x-m-pow {:macro #'go-tf-x-m-pow :emit :macro :value true}})

^{:refer lang.model.v1.spec-xtalk.fn-go/+go-str+ :id original-string-vars}
(fact "Go string entries retain original names and Var callbacks"
  +go-str+
  => {:x-str-split {:macro #'go-tf-x-str-split :emit :macro :value true}
      :x-str-join {:macro #'go-tf-x-str-join :emit :macro :value true}
      :x-str-index-of {:macro #'go-tf-x-str-index-of :emit :macro :value true}
      :x-str-to-upper {:macro #'go-tf-x-str-to-upper :emit :macro :value true}
      :x-str-to-lower {:macro #'go-tf-x-str-to-lower :emit :macro :value true}
      :x-str-trim {:macro #'go-tf-x-str-trim :emit :macro :value true}})

^{:refer lang.model.v1.spec-xtalk.fn-go/+go-arr+ :id original-array-vars}
(fact "Go array assignment retains its Var callback without a value flag"
  +go-arr+
  => {:x-arr-push {:macro #'go-tf-x-arr-push :emit :macro}})

^{:refer lang.model.v1.spec-xtalk.fn-go/+go+ :id original-group-composition}
(fact "Go combines the four original literal groups in order"
  +go+ => (merge +go-core+ +go-math+ +go-str+ +go-arr+))
