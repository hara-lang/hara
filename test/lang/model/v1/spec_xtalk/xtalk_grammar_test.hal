(ns lang.model.v1.spec-xtalk.xtalk-grammar-test
  (:require [lang.model.v1.spec-xtalk.xtalk-grammar :as model]))

^{:refer lang.model.v1.spec-xtalk.xtalk-grammar/+language+}
(Test/check
 [{:name "V1 XTalk grammar declares archive template profile and grammar sources"
   :test (fn [] [model/+language+ model/+tag+ model/+grammar-version+
                 (select-keys model/+template+ [:source/kind :source/id :source/version :template/value])
                 (select-keys model/+profile+ [:source/kind :source/id :source/version])
                 (select-keys model/+grammar+ [:source/kind :source/id :source/version
                                                :grammar/release :grammar/language :grammar/tag
                                                :grammar/engine :grammar/emit-template :grammar/profiles])])
   :expected [:xtalk :xtalk 1
              {:source/kind :emit-template :source/id :xtalk :source/version 1
               :template/value (:template/value model/+template+)}
              {:source/kind :profile :source/id :xtalk :source/version 1}
              {:source/kind :grammar :source/id :xtalk :source/version 1
               :grammar/release "foundation-v1" :grammar/language :xtalk :grammar/tag :xtalk
               :grammar/engine {:minimum 1 :maximum 1}
               :grammar/emit-template {:template/id :xtalk :template/version 1}
               :grammar/profiles [{:profile/id :xtalk :profile/version 1}]}]}])
