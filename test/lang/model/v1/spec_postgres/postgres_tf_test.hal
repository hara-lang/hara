(ns lang.model.v1.spec-postgres.postgres-tf-test
  (:require [lang.model.v1.spec-postgres.postgres-tf :as tf :refer
                                                     :all])
  (:use code.test))

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-js-idx}
(Test/check
  [{:name "normalizes PostgreSQL JSON keys",
    :test (fn [] [(tf/pg-js-idx 'x-user-id) (tf/pg-js-idx 'user-id)]),
    :expected ["user_id" "er_id"]}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-js}
(Test/check
  [{:name "builds deterministic JSONB object and array forms",
    :test
    (fn [] [(tf/pg-tf-js [nil (Algo/ordered-map :a 1 :b [2 3])])
            (tf/pg-tf-js [nil #{'x-name}])]),
    :expected
    ['(jsonb-build-object "a" 1 "b" (jsonb-build-array 2 3))
     '(jsonb-build-object "name" x-name)]}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-json-value}
(Test/check [{:name "recursively converts JSONB values"
              :test (fn [] (tf/pg-json-value [1 :active]))
              :expected '(jsonb-build-array 1 "active")}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-free-data}
(Test/check [{:name "quotes free data"
              :test (fn [] (first (tf/pg-tf-free-data [nil [1 2]])))
              :expected 'quote}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-free-vec}
(Test/check [{:name "quotes free vectors"
              :test (fn [] (first (tf/pg-tf-free-vec [nil [1 2]])))
              :expected 'quote}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-for}
(Test/check [{:name "builds a FOR loop section"
              :test (fn [] (first (tf/pg-tf-for '(for [i 0 1] (return i)))))
              :expected :FOR}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-foreach}
(Test/check [{:name "builds a FOREACH loop section"
              :test (fn [] (first (tf/pg-tf-foreach '(for:each [i :in arr] (return i)))))
              :expected :FOREACH}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-loop}
(Test/check [{:name "builds a LOOP section"
              :test (fn [] (first (tf/pg-tf-loop '(loop (return 1)))))
              :expected :LOOP}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-throw}
(Test/check [{:name "builds a JSONB-backed raise form"
              :test (fn [] (first (tf/pg-tf-throw '(throw {:id 1} :tag))))
              :expected :raise-exception}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-error}
(Test/check [{:name "adds the standard error status"
              :test (fn [] (first (tf/pg-tf-error '(error {:id 1} :tag))))
              :expected :raise-exception}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-assert}
(Test/check [{:name "builds a negated assertion with error payload"
              :test (fn [] (first (tf/pg-tf-assert '(assert (= 1 1) [:tag {:id 1}]))))
              :expected 'if}])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-js-idx, :added "4.0"}
(fact "ignores single letter prefix" (pg-js-idx 'i-hello) => "hello")

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-js, :added "4.0"}
(fact
  "converts a map to js object"
  (pg-tf-js (list 'js (Algo/ordered-map :a 1 :b 2)))
  =>
  '(jsonb-build-object "a" 1 "b" 2)
  (pg-tf-js '(js {:a [1 2 3]}))
  =>
  '(jsonb-build-object "a" (jsonb-build-array 1 2 3)))

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-for, :added "4.0"}
(fact
  "creates for loop"
  (pg-tf-for '(for [i < 0] (:++ i)))
  =>
  '[:FOR i < 0 :LOOP \\ (\| (do (:++ i))) \\ :END-LOOP \;])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-foreach, :added "4.0"}
(fact
  "creates foreach loop"
  (pg-tf-foreach '(foreach [i :in (array 1 2 3 4 5)] (:++ i)))
  =>
  '[:FOREACH
    i
    :in
    (array 1 2 3 4 5)
    :LOOP
    \\
    (\| (do (:++ i)))
    \\
    :END-LOOP
    \;])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-loop, :added "4.0"}
(fact
 "creates loop"
 (pg-tf-loop '(loop (:++ i)))
 =>
 '[:LOOP \\ (\| (do (:++ i))) \\ :END-LOOP \;])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-throw, :added "4.0"}
(fact
  "creates throw transform"
  (pg-tf-throw '(throw {}))
  =>
  '[:raise-exception
    :using
    '[[:detail := (:text (% {}))] [:message := "nil"]]])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-error, :added "4.0"}
(fact
  "creates error transform"
  (pg-tf-error '(error {}))
  =>
  '[:raise-exception
    :using
    '[[:detail := (:text (% {:status "error"}))] [:message := "nil"]]])

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-assert, :added "4.0"}
(fact
  "creates assert transform"
  (pg-tf-assert '(assert (= 1 1) [:tag {}]))
  =>
  '(if [:NOT '((= 1 1))]
     [:raise-exception
      :using
      '[[:detail := (:text (% {:status "error", :tag :tag}))]
        [:message := "tag"]]]))

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-js}
(fact "preserves input object-entry order instead of sorting keys"
 (pg-tf-js (list 'js (Algo/ordered-map :b 2 :a 1)))
 => '(jsonb-build-object "b" 2 "a" 1))

^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-json-value}
(fact "retained standalone JSON helper keeps its sorted-key and recursive contract"
 (tf/pg-json-value (Algo/ordered-map :b [2 :active] :a 1))
 => '(jsonb-build-object "a" 1 "b" (jsonb-build-array 2 "active")))
^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-free-data}
(fact "retained free data helper keeps both quote layers and data"
 (tf/pg-tf-free-data [nil [1 :active]])
 => '(quote ((quote [1 :active]))))
^{:refer lang.model.v1.spec-postgres.postgres-tf/pg-tf-free-vec}
(fact "retained free vector helper preserves the complete quoted vector"
 (tf/pg-tf-free-vec [nil '(1 :active)])
 => '(quote [1 :active]))

^{:refer lang.model.v1.spec-postgres.postgres-tf/*input-syms*}
(fact "input symbol bindings are scoped and restored after failure"
 [tf/*input-syms*
  (binding [tf/*input-syms* #{'i-name}] tf/*input-syms*)
  tf/*input-syms*
  (try (binding [tf/*input-syms* #{'i-failed}] (throw (ex :generic {} :ex/message "fixture"))) (catch error (ex-message error)))
  tf/*input-syms*]
 => [nil #{'i-name} nil "fixture" nil])
