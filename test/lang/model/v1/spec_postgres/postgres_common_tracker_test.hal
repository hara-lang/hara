(ns lang.model.v1.spec-postgres.postgres-common-tracker-test
  (:require [lang.model.v1.spec-postgres.postgres-common-tracker :as tracker]))

^{:refer lang.model.v1.spec-postgres.postgres-common-tracker/tracker-string}
(Test/check [{:name "formats tracker metadata"
              :test (fn [] (tracker/tracker-string {:name "Task" :in true :out true}))
              :expected "#pg.tracker [Task] {:in true, :out true}"}])

^{:refer lang.model.v1.spec-postgres.postgres-common-tracker/add-tracker}
(Test/check [{:name "attaches active tracker metadata"
              :test (fn [] (tracker/add-tracker {:track 'op} {:in true} :spec :create))
              :expected {:track 'op :static/tracker {:in true}}}])

^{:refer lang.model.v1.spec-postgres.postgres-common-tracker/tracker-map}
(Test/check [{:name "reads a tracker direction"
              :test (fn [] (tracker/tracker-map {:in {:create {:id true}}} :create))
              :expected {:id true}}])

^{:refer lang.model.v1.spec-postgres.postgres-common-tracker/tracker-map-output}
(Test/check [{:name "maps tracker fields to JSONB extraction forms"
              :test (fn [] (tracker/tracker-map-output {:in {:create {:time-created true}}}
                                                        :create 'op))
              :expected {:time-created '(:->> op "time_created")}}])

^{:refer lang.model.v1.spec-postgres.postgres-common-tracker/tracker-map-in}
(Test/check [{:name "creates insert tracking values"
              :test (fn [] (tracker/tracker-map-in
                            {:track 'op
                             :static/tracker {:in {:create {:op-created true}}}}))
              :expected {:op-created '(:->> op "op_created")}}])

^{:refer lang.model.v1.spec-postgres.postgres-common-tracker/tracker-map-modify}
(Test/check [{:name "creates modify tracking values"
              :test (fn [] (tracker/tracker-map-modify
                            {:track 'op
                             :static/tracker {:in {:modify {:op-updated true}}}}))
              :expected {:op-updated '(:->> op "op_updated")}}])
