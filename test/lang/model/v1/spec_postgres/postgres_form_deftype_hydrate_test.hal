(ns lang.model.v1.spec-postgres.postgres-form-deftype-hydrate-test
  (:require [lang.model.v1.spec-postgres.postgres-form-deftype-hydrate :as form]))

^{:refer lang.model.v1.spec-postgres.postgres-form-deftype-hydrate/resolve-reference}
(Test/check [{:name "resolves explicit reference coordinates"
              :test (fn [] (form/resolve-reference
                            {:schema "audit" :table 'Entry :type :uuid}
                            {}))
              :expected {:schema "audit" :table 'Entry :type :uuid :column :id}}])

^{:refer lang.model.v1.spec-postgres.postgres-form-deftype-hydrate/resolve-enum}
(Test/check [{:name "resolves explicit enum coordinates"
              :test (fn [] (form/resolve-enum {:schema "audit" :id 'state} {}))
              :expected {:schema "audit" :id 'state}}])

^{:refer lang.model.v1.spec-postgres.postgres-form-deftype-hydrate/hydrate-column}
(Test/check [{:name "publishes column hydration"
              :test (fn [] (form/hydrate-column :name {:type :text} {}))
              :expected [:name {:type :text}]}])

^{:refer lang.model.v1.spec-postgres.postgres-form-deftype-hydrate/pg-deftype-hydrate}
(Test/check [{:name "publishes table hydration through the archived entry point"
              :test (fn [] (fn? form/pg-deftype-hydrate))
              :expected true}])
