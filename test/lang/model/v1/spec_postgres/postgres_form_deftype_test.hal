(ns lang.model.v1.spec-postgres.postgres-form-deftype-test
  (:require [lang.model.v1.spec-postgres.postgres-form-deftype :as form]))

^{:refer lang.model.v1.spec-postgres.postgres-form-deftype/pg-deftype-ref-name}
(Test/check [{:name "publishes the archived reference-name helper"
              :test (fn [] (form/pg-deftype-ref-name 'owner))
              :expected "owner_id"}])

^{:refer lang.model.v1.spec-postgres.postgres-form-deftype/pg-deftype-format}
(Test/check [{:name "publishes the PostgreSQL table formatter"
              :test (fn [] (:static/dbtype
                            (first (form/pg-deftype-format
                                    '(deftype Entry [id {:type :uuid :primary true}] {})))))
              :expected :table}])

^{:refer lang.model.v1.spec-postgres.postgres-form-deftype/pg-deftype-hydrate}
(Test/check [{:name "publishes table hydration"
              :test (fn [] (fn? form/pg-deftype-hydrate))
              :expected true}])

^{:refer lang.model.v1.spec-postgres.postgres-form-deftype/pg-deftype}
(Test/check [{:name "publishes the complete table emitter"
              :test (fn [] (fn? form/pg-deftype))
              :expected true}])
