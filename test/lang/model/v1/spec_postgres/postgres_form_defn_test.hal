(ns lang.model.v1.spec-postgres.postgres-form-defn-test
  (:require [lang.model.v1.spec-postgres.postgres-form-defn :as form]))

^{:refer lang.model.v1.spec-postgres.postgres-form-defn/pg-defn-format}
(Test/check [{:name "publishes the Foundation function formatter"
              :test (fn [] (:static/return
                            (first (form/pg-defn-format
                                    '(defn demo {:- [:text]} [:text value] value)))))
              :expected [:text]}])

^{:refer lang.model.v1.spec-postgres.postgres-form-defn/pg-defnformat}
(Test/check [{:name "retains the archived formatter alias"
              :test (fn [] (= form/pg-defnformat form/pg-defn-format))
              :expected true}])

^{:refer lang.model.v1.spec-postgres.postgres-form-defn/+pg-defnlang-types+}
(Test/check [{:name "publishes language tags for PostgreSQL functions"
              :test (fn [] (get-in form/+pg-defnlang-types+ [:js :tag]))
              :expected "plv8"}])

^{:refer lang.model.v1.spec-postgres.postgres-form-defn/pg-defn}
(Test/check [{:name "publishes the complete PostgreSQL function emitter"
              :test (fn [] (fn? form/pg-defn))
              :expected true}])
