(ns lang.model.v1.spec-postgres.postgres-form-defrole-test
  (:require [lang.model.v1.spec-postgres.postgres-form-defrole :as role]))

^{:refer lang.model.v1.spec-postgres.postgres-form-defrole/pg-defrole-access}
(Test/check [{:name "creates role grants for selected tables"
              :test (fn [] (role/pg-defrole-access {:select ['Log]} 'reader {}))
              :expected [[:grant :select :on-table 'Log :to 'reader]]}])

^{:refer lang.model.v1.spec-postgres.postgres-form-defrole/suppress-block}
(Test/check [{:name "wraps role operations in a suppressing block"
              :test (fn [] (first (role/suppress-block [[:create-role 'reader :inherit]])))
              :expected :do}])

^{:refer lang.model.v1.spec-postgres.postgres-form-defrole/pg-defrole}
(Test/check [{:name "expands role lifecycle and grants"
              :test (fn [] (first (role/pg-defrole
                                   '(defrole reader {:grant [other]}))))
              :expected 'do}])
