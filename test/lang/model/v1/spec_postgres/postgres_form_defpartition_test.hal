(ns lang.model.v1.spec-postgres.postgres-form-defpartition-test
  (:require [lang.model.v1.spec-postgres.postgres-form-defpartition :as form]))

^{:refer lang.model.v1.spec-postgres.postgres-form-defpartition/pg-partition-name}
(Test/check [{:name "publishes the archived partition-name helper"
              :test (fn [] (form/pg-partition-name "parent" "west" {}))
              :expected "parent__west"}])

^{:refer lang.model.v1.spec-postgres.postgres-form-defpartition/pg-partition-def}
(Test/check [{:name "publishes the archived partition definition helper"
              :test (fn [] (fn? form/pg-partition-def))
              :expected true}])

^{:refer lang.model.v1.spec-postgres.postgres-form-defpartition/pg-defpartition}
(Test/check [{:name "publishes the archived partition declaration helper"
              :test (fn [] (first (form/pg-defpartition
                                   '(defpartition part [parent]
                                      [{:use :region :in ["west"]}]))))
              :expected 'do}])
