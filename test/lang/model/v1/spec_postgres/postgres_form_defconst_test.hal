(ns lang.model.v1.spec-postgres.postgres-form-defconst-test
  (:require [lang.model.v1.spec-postgres.postgres-const :as const]
            [lang.model.v1.spec-postgres.postgres-form-defconst :as form]))

^{:refer lang.model.v1.spec-postgres.postgres-form-defconst/pg-defconst-hydrate}
(Test/check [{:name "publishes table-backed constant hydration"
              :test (fn [] (fn? form/pg-defconst-hydrate))
              :expected true}])

^{:refer lang.model.v1.spec-postgres.postgres-form-defconst/pg-defconst}
(Test/check [{:name "returns the hydrated constant form"
              :test (fn [] (form/pg-defconst
                            '(defconst value table {})))
              :expected nil}])

^{:refer lang.model.v1.spec-postgres.postgres-const/pg-defconst}
(Test/check [{:name "keeps the owner entry point equivalent to the facade"
              :test (fn [] (= (const/pg-defconst '(defconst value table {}))
                              (form/pg-defconst '(defconst value table {}))))
              :expected true}])
