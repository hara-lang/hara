(ns lang.model.v1.spec-js.html-test
  (:use code.test)
  (:require [lang.base.emit-common :as common]
            [lang.model.v1.spec-js.html :as html]))

^{:refer lang.model.v1.spec-js.html/wrap-indent-inner}
(fact "increments indentation only while visiting nested HTML vectors"
  [((html/wrap-indent-inner (fn [_] common/*indent*)) [:div "hello"])
   ((html/wrap-indent-inner (fn [_] common/*indent*)) "plain")]
  => [2 0])

^{:refer lang.model.v1.spec-js.html/wrap-indent-outer}
(fact "restores the outer indentation while leaving scalar values unchanged"
  [((html/wrap-indent-outer (fn [_] common/*indent*)) [:div "hello"])
   ((html/wrap-indent-outer (fn [_] common/*indent*)) "plain")]
  => [-2 0])

^{:refer lang.model.v1.spec-js.html/prewalk-indent}
(fact "walks nested HTML data without changing its structure"
  (html/prewalk-indent identity [:div [:p "hello"]])
  => [:div [:p "hello"]])

^{:refer lang.model.v1.spec-js.html/prepare-html}
(fact "preserves the Foundation HTML tree before emission"
  (html/prepare-html [:a [:b [:c]]] {})
  => [:a [:b [:c]]])

^{:refer lang.model.v1.spec-js.html/html-render}
(fact "renders nested HTML trees with attributes and escaping-free text"
  (html/html-render [:section {:class ["hero" "wide"]}
                     [:h1 "Hello"]])
  => "<section class=\"hero wide\">\n  <h1>Hello</h1>\n</section>")

^{:refer lang.model.v1.spec-js.html/emit-html}
(fact "emits HTML from a Foundation tree"
  (html/emit-html [:a [:b [:c]]] {} {})
  => "<a>\n  <b>\n    <c></c>\n  </b>\n</a>")
