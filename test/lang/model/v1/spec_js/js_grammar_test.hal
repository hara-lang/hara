(ns lang.model.v1.spec-js.js-grammar-test
  (:use code.test)
  (:require [lang.model.v1.spec-js.js-grammar :as grammar]))

^{:refer lang.model.v1.spec-js.js-grammar/js-vector}
(fact "emits ordinary vectors as arrays and reserves keyword heads for JSX"
  [(grammar/js-vector [] grammar/+template+ {})
   (grammar/js-vector ['red 1] grammar/+template+ {})
   (str/includes? (grammar/js-vector [:div "hello"] grammar/+template+ {})
                  "<div>hello</div>")]
  => ["[]" "[red,1]" true])
