(ns lang.model.v1.spec-js.js-native-test
  (:require [lang.model.v1.spec-js.js-native :as subject]))

^{:refer lang.model.v1.spec-js.js-native/+js-native-prototype+}
(Test/check
 [{:name "uses JavaScript prototype aliases and allows prototype blocks"
   :test (fn [] [(get-in subject/+js-native-prototype+ [:prototype-get :emit])
                 (get-in subject/+js-native-prototype+ [:prototype-set :emit])
                 (get-in subject/+js-native-prototype+ [:prototype-create :op-spec :allow-blocks])])
   :expected [:alias :alias true]}])

^{:refer lang.model.v1.spec-js.js-native/+js-native-definitions+}
(Test/check
 [{:name "retains the Foundation JavaScript operator definitions"
   :test (fn [] [(get-in subject/+js-native-definitions+ [:property :emit])
                 (get-in subject/+js-native-definitions+ [:teq :raw])
                 (get-in subject/+js-native-definitions+ [:tneq :raw])
                 (get-in subject/+js-native-definitions+ [:delete :raw])
                 (get-in subject/+js-native-definitions+ [:undef :raw])
                 (get-in subject/+js-native-definitions+ [:nan :raw])
                 (get-in subject/+js-native-definitions+ [:vargs :raw])
                 (not (nil? (get subject/+js-native-definitions+ :instanceof)))])
   :expected [:def-assign "===" "!==" "delete" "undefined" "NaN" "...vargs" true]}])

^{:refer lang.model.v1.spec-js.js-native/js-tf-var-let}
(Test/check
 [{:name "lowers JavaScript var to let"
   :test (fn [] (subject/js-tf-var-let '(var a 1)))
   :expected '(var* :let a := 1)}])

^{:refer lang.model.v1.spec-js.js-native/js-tf-var-const}
(Test/check
 [{:name "lowers JavaScript const"
   :test (fn [] (subject/js-tf-var-const '(const a 1)))
   :expected '(var* :const a := 1)}])

^{:refer lang.model.v1.spec-js.js-native/js-defclass}
(Test/check
 [{:name "creates a JavaScript class form"
   :test (fn []
           (subject/js-defclass
            '(defclass Try [:- React.Component]
               (fn constructor [] (return this)))))
   :expected '(:- :class Try :extends (quote [React.Component]) \{
                (\\ \\ (\| (do (fn.inner constructor [] (return this)))) \\)
                \})}])

^{:refer lang.model.v1.spec-js.js-native/js-x-obj-vals}
(Test/check
 [{:name "emits JavaScript object values"
   :test (fn [] (subject/js-x-obj-vals '(x:obj-vals obj)))
   :expected '(Object.values obj)}])

^{:refer lang.model.v1.spec-js.js-native/js-x-obj-pairs}
(Test/check
 [{:name "emits JavaScript object entries"
   :test (fn [] (subject/js-x-obj-pairs '(x:obj-pairs obj)))
   :expected '(Object.entries obj)}])

^{:refer lang.model.v1.spec-js.js-native/js-x-obj-assign}
(Test/check
 [{:name "emits JavaScript object assignment"
   :test (fn [] (subject/js-x-obj-assign '(x:obj-assign obj other)))
   :expected '(Object.assign obj other)}])

^{:refer lang.model.v1.spec-js.js-native/js-x-arr-slice}
(Test/check
 [{:name "emits a bounded JavaScript array slice"
   :test (fn [] (subject/js-x-arr-slice '(x:arr-slice arr start end)))
   :expected '(. arr (slice start end))}])

^{:refer lang.model.v1.spec-js.js-native/js-x-arr-reverse}
(Test/check
 [{:name "copies before reversing a JavaScript array"
   :test (fn [] (subject/js-x-arr-reverse '(x:arr-reverse arr)))
   :expected '(. arr (slice) (reverse))}])

^{:refer lang.model.v1.spec-js.js-native/js-x-arr-each}
(Test/check
 [{:name "emits JavaScript forEach"
   :test (fn [] (subject/js-x-arr-each '(x:arr-each arr f)))
   :expected '(. arr (forEach f))}])

^{:refer lang.model.v1.spec-js.js-native/js-x-arr-every}
(Test/check
 [{:name "emits JavaScript every"
   :test (fn [] (subject/js-x-arr-every '(x:arr-every arr pred)))
   :expected '(. arr (every pred))}])

^{:refer lang.model.v1.spec-js.js-native/js-x-arr-some}
(Test/check
 [{:name "emits JavaScript some"
   :test (fn [] (subject/js-x-arr-some '(x:arr-some arr pred)))
   :expected '(. arr (some pred))}])

^{:refer lang.model.v1.spec-js.js-native/js-x-arr-filter}
(Test/check
 [{:name "emits JavaScript filter"
   :test (fn [] (subject/js-x-arr-filter '(x:arr-filter arr pred)))
   :expected '(. arr (filter pred))}])

^{:refer lang.model.v1.spec-js.js-native/js-x-arr-find}
(Test/check
 [{:name "emits JavaScript findIndex"
   :test (fn [] (subject/js-x-arr-find '(x:arr-find arr pred)))
   :expected '(. arr (findIndex pred))}])

^{:refer lang.model.v1.spec-js.js-native/js-x-arr-concat}
(Test/check
 [{:name "emits JavaScript concat"
   :test (fn [] (subject/js-x-arr-concat '(x:arr-concat arr other)))
   :expected '(. arr (concat other))}])
