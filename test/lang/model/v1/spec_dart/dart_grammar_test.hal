(ns lang.model.v1.spec-dart.dart-grammar-test
  (:require [lang.model.v1.spec-dart.dart-grammar :as subject]))

^{:refer lang.model.v1.spec-dart.dart-grammar/+baseline+}
(Test/check
 [{:name "Dart starts from the canonical compiler and XTalk operator baselines"
   :test (fn [] [(has? subject/+baseline+ :var)
                 (has? subject/+baseline+ :x-len)
                 (has? subject/+baseline+ :with-global)])
   :expected [true true true]}])

^{:refer lang.model.v1.spec-dart.dart-grammar/+features+}
(Test/check
 [{:name "Dart features include its XTalk operators and native definitions"
   :test (fn [] [(get-in subject/+features+ [:x-len :emit])
                 (get-in subject/+features+ [:for-array :emit])
                 (get-in subject/+features+ [:dart-or :raw])
                 (get-in subject/+features+ [:vargs :emit])])
   :expected [:macro :macro "??" :pre]}])

^{:refer lang.model.v1.spec-dart.dart-grammar/+template+}
(Test/check
 [{:name "Dart template emits dynamic literals and semicolon statements"
   :test (fn [] [(get-in subject/+template+ [:default :common :statement])
                 (get-in subject/+template+ [:data :vector :start])
                 (get-in subject/+template+ [:data :map :start])
                 (get-in subject/+template+ [:token :nil :as])
                 (get-in subject/+template+ [:default :function :prefix])])
   :expected [";" "<dynamic>[" "<dynamic, dynamic>{" "null" nil]}])

^{:refer lang.model.v1.spec-dart.dart-grammar/+template-source+}
(Test/check
 [{:name "Dart template source has a stable grammar coordinate"
   :test (fn [] [(:source/kind subject/+template-source+)
                 (:source/id subject/+template-source+)
                 (:source/version subject/+template-source+)])
   :expected [:emit-template :dt 1]}])

^{:refer lang.model.v1.spec-dart.dart-grammar/+profile+}
(Test/check
 [{:name "Dart profile names the target and carries its operators"
   :test (fn [] [(:source/kind subject/+profile+)
                 (:profile/id subject/+profile+)
                 (get-in subject/+profile+ [:profile/operators :x-promise :emit])])
   :expected [:profile :dt :macro]}])

^{:refer lang.model.v1.spec-dart.dart-grammar/+grammar+}
(Test/check
 [{:name "Dart grammar appends its target rewrite stage"
   :test (fn [] [(:grammar/id subject/+grammar+)
                 (:grammar/language subject/+grammar+)
                 (count (get-in subject/+grammar+ [:grammar/rewrite :staging :append]))])
   :expected [:dt :dart 1]}])
