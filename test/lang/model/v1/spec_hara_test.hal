(ns lang.model.v1.spec-hara-test
  (:require [lang.common.book :as book]
            [lang.model.v1.spec-hara :as subject]))

^{:refer lang.model.v1.spec-hara/+language+}
(Test/check
 [{:name "Hara book identifies the language and XTalk parent"
   :test (fn [] [subject/+language+
                 subject/+tag+
                 subject/+version+
                 (:parent subject/+book+)
                 (book/book? subject/+book+)])
   :expected [:hara :hara 1 :xtalk true]}])

^{:refer lang.model.v1.spec-hara/select}
(Test/check
 [{:name "Hara selection resolves its declared grammar"
   :test (fn [] [(:grammar/id (:coordinate subject/+selection+))
                 (:grammar/version (:coordinate subject/+selection+))])
   :expected [:hara 1]}])

^{:refer lang.model.v1.spec-hara/compile}
(Test/check
 [{:name "Hara spec compiles a simple definition through its emitter"
   :test (fn [] (subject/compile '(def value 1)))
   :expected "(def value 1)"}])
