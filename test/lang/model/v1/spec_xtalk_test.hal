(ns lang.model.v1.spec-xtalk-test
  (:require [lang.base.registry :as registry]
            [lang.model.v1.spec-xtalk :as model]))

^{:refer lang.model.v1.spec-xtalk/+language+}
(Test/check
 [{:name "V1 XTalk is a versioned grammar/book model, not lang.model.xtalk"
   :test (fn [] (let [catalog (model/catalog)
                       selected (model/select catalog)]
                 [model/+language+ model/+tag+ model/+version+ model/+grammar-version+
                  (registry/versions catalog :xtalk)
                  (:coordinate selected)
                  (:coordinate model/+selection+)
                  [(:lang model/+book+) (:parent model/+book+) (:version model/+book+)
                   (get-in model/+book+ [:selection :coordinate])]
                  (= model/+book+ model/+init+)
                  (count (registry/list (model/install catalog)))]))
   :expected [:xtalk :xtalk 1 1 [1]
              {:grammar/id :xtalk :grammar/version 1 :grammar/release "foundation-v1" :grammar/facets []}
              {:grammar/id :xtalk :grammar/version 1 :grammar/release "foundation-v1" :grammar/facets []}
              [:xtalk nil 1 {:grammar/id :xtalk :grammar/version 1 :grammar/release "foundation-v1" :grammar/facets []}]
              true 3]}])
