(ns lang.model.v1.spec-js-test
  (:require [lang.base.book :as book]
            [lang.model.v1.spec-js :as subject]
            [lang.model.v1.spec-js.js-grammar :as model]))

^{:refer lang.model.v1.spec-js/+language+}
(Test/check
 [{:name "JavaScript book identifies the language and grammar"
   :test (fn [] [subject/+language+
                 subject/+tag+
                 subject/+version+
                 subject/+grammar-version+
                 (:grammar/tag subject/+grammar+)
                 (get-in subject/+selection+ [:coordinate :grammar/id])])
   :expected [:js :js 1 1 :js :js]}])

^{:refer lang.model.v1.spec-js/select}
(Test/check
 [{:name "JavaScript selection returns the pinned selection"
   :test (fn [] (= (subject/select) subject/+selection+))
   :expected true}])

^{:refer lang.model.v1.spec-js/+book+}
(Test/check
 [{:name "JavaScript book carries its grammar selection"
   :test (fn [] [(:lang subject/+book+)
                 (:parent subject/+book+)
                 (:version subject/+book+)
                 (book/book? subject/+book+)])
   :expected [:js :xtalk 1 true]}])
