(ns lang.seedgen-cli-test (:require [lang.seedgen.cli :as cli]))

(Test/check [{:name "seedgen owns operation and runtime language parsing" :expected {:language :lua :operation :benchadd} :test (fn [] (cli/parse-arguments ["benchadd" "lua"]))}])

(Test/check [{:name "seedgen defaults to listing" :expected {:language nil :operation :list} :test (fn [] (cli/parse-arguments []))}])
