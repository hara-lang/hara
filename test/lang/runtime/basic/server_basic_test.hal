(ns lang.runtime.basic.server-basic-test
  (:require [lang.runtime.basic.server-basic :refer :all]
            [code.test :refer [fact satisfies]]))

^{:refer lang.runtime.basic.server-basic/get-port, :added "4.0", :id :historical/get-port}
(fact
  "gets the port given lang and id"
  (let [historical-results (atom [])]
    (do
      (let [clients (atom []) unregistered (atom [])]
        (binding [lang.runtime.basic.server-basic/*env* (atom {})]
          (try
            (do
              (start-server "test-port" :lua nil)
              (swap!
                historical-results
                conj
                (Result/data
                  (code.test.base.process/check
                    (fn [] (get-port {:lang :lua, :id "test-port"}))
                    (satisfies long?))))
              (stop-server "test-port" :lua))
            (finally
              (do
                (doseq [client (deref clients)] (Socket/close client))
                (doseq [server (deref unregistered)]
                  ((deref (:stop server))))
                (doseq [[lang entries] (seq
                                         (deref
                                           lang.runtime.basic.server-basic/*env*))]
                  (doseq [id (keys entries)]
                    (loop []
                      (if (stop-server id lang) (recur)))))))))))
    (deref historical-results))
  =>
  [true])

^{:refer lang.runtime.basic.server-basic/wait-ready, :added "4.0", :id :historical/wait-ready}
(fact
  "wait until server is ready"
  (let [historical-results (atom [])]
    (do
      (let [clients (atom []) unregistered (atom [])]
        (binding [lang.runtime.basic.server-basic/*env* (atom {})]
          (try
            (do
              (start-server "test-wait" :lua nil)
              (swap!
                historical-results
                conj
                (Result/data
                  (code.test.base.process/check
                    (fn []
                      (get-in
                        (deref lang.runtime.basic.server-basic/*env*)
                        [:lua "test-wait"]))
                    (satisfies
                      (fn [value]
                        (or
                          (map? value)
                          (and
                            (satisfies? IAssoc value)
                            (= :server/basic (:type value)))))))))
              (swap!
                clients
                conj
                (Socket/connect
                  "127.0.0.1"
                  (get-port {:lang :lua, :id "test-wait"})
                  {}
                  (fn [error connection] nil)))
              (swap!
                historical-results
                conj
                (Result/data
                  (code.test.base.process/check
                    (fn [] (wait-ready :lua "test-wait"))
                    true)))
              (stop-server "test-wait" :lua))
            (finally
              (do
                (doseq [client (deref clients)] (Socket/close client))
                (doseq [server (deref unregistered)]
                  ((deref (:stop server))))
                (doseq [[lang entries] (seq
                                         (deref
                                           lang.runtime.basic.server-basic/*env*))]
                  (doseq [id (keys entries)]
                    (loop []
                      (if (stop-server id lang) (recur)))))))))))
    (deref historical-results))
  =>
  [true true])

^{:refer lang.runtime.basic.server-basic/run-basic-server, :added "4.0", :id :historical/run-basic-server}
(fact
  "runs a basic socket server"
  (let [historical-results (atom [])]
    (do
      (let [state (atom nil)
            ready (fn [value] nil)
            server (run-basic-server {:port 0} state ready)]
        (try
          (do
            (swap!
              historical-results
              conj
              (Result/data
                (code.test.base.process/check
                  (fn [] (:instance server))
                  (satisfies
                    (fn [value]
                      (and
                        (long? value)
                        (< 0 (:port (Socket/endpoint value)))))))))
            ((:stop server)))
          (finally ((:stop server))))))
    (deref historical-results))
  =>
  [true])

^{:refer lang.runtime.basic.server-basic/get-encoding, :added "4.0", :id :historical/get-encoding}
(fact
  "gets the encoding to use"
  (let [historical-results (atom [])]
    (do
      (swap!
        historical-results
        conj
        (Result/data
          (code.test.base.process/check
            (fn [] (get-encoding :json))
            (satisfies map?)))))
    (deref historical-results))
  =>
  [true])

^{:refer lang.runtime.basic.server-basic/get-relay, :added "4.0", :id :historical/get-relay}
(fact
  "gets the relay associated with the server"
  (let [historical-results (atom [])]
