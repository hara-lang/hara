(ns lang.runtime.basic.impl.source-js-test
  (:require [lang.runtime.basic.impl.source-js :as subject]))

^{:refer lang.runtime.basic.impl.source-js/transport-source}
(Test/check
 [{:name "exposes Node scheduling primitives to the persistent VM context"
   :test (fn []
           (let [source (subject/transport-source 43121)]
             [(str/includes? source
                             "{TextEncoder,TextDecoder,require,process,setTimeout,clearTimeout,setInterval,clearInterval}")
              (str/includes? source "context.globalThis=context;")]))
   :expected [true true]}])
