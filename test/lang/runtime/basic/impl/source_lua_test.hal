(ns lang.runtime.basic.impl.source-lua-test
  (:require [lang.runtime.basic.impl.source-lua :as subject]))

^{:refer lang.runtime.basic.impl.source-lua/transport-source}
(Test/check
 [{:name "loads Lua expressions for values before falling back to statements"
   :test (fn [] (let [source (subject/transport-source 1234)
                      expression (str/index-of source "loader('return '..source)")
                      statement (str/index-of source "loader(source)")]
                  [(str/includes? source "if not chunk then chunk,load_error=loader(source) end")
                   (and (>= expression 0)
                        (>= statement 0)
                        (< expression statement))]))
   :expected [true true]}])
