(ns lang.runtime.basic.impl.process-lua-test
  (:require [lang.core.registry :as registry]
            [std.lib.context.resource :as resource]
            [lang.runtime.basic.impl.process-lua :as subject]
            [lang.runtime.basic.type-common :as common]))

^{:refer lang.runtime.basic.impl.process-lua/+lua-init+}
(Test/check
 [{:name "declares Lua and LuaJIT program environments"
   :test (fn [] [(get-in (common/get-program-options :lua) [:default :basic])
                 (get-in (common/get-program-options :lua) [:env :lua :exec])
                 (get-in (common/get-program-options :lua) [:env :lua :extension])
                 (get-in (common/get-program-options :lua) [:env :lua :flags :basic])
                 (get-in (common/get-program-options :lua) [:env :luajit :exec])
                 (get-in (common/get-program-options :lua) [:env :luajit :flags :basic])
                 (get-in (common/get-program-options :lua) [:default :basic])])
   :expected [:lua "lua" "lua" ["-e"] "luajit" ["-e"] :lua]}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-oneshot-config+}
(Test/check
 [{:name "configures Lua one-shot JSON output"
   :test (fn [] (select-keys (common/get-context-options :lua :oneshot :default) [:main :emit :json]))
   :expected {:main {} :emit {} :json :full}}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-verify-config+}
(Test/check
 [{:name "configures Lua verification through stdin"
   :test (fn [] (select-keys (common/get-context-options :lua :verify :default) [:main :emit :json :transport]))
   :expected {:main {} :emit {} :json false :transport :process-stdin}}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-basic-config+}
(Test/check
 [{:name "configures persistent Lua evaluation over JSON lines"
   :test (fn [] (let [config (common/get-context-options :lua :basic :default)]
                  [(select-keys config [:main :json :encode :timeout :transport])
                   (:profile config)
                   (boolean (get-in config [:emit :code :transforms :entry]))
                   (boolean (:bootstrap config))]))
   :expected [{:main {} :json :full :encode :json
               :timeout 2000 :transport :process-socket}
              {:input [] :source []
               :response [[:lang/node-response 1]]}
              true
              true]}])

^{:refer lang.runtime.basic.impl.process-lua/lua-basic-script-globalize-entry}
(Test/check
 [{:name "converts local Lua declarations to globals for basic runtime"
   :test (fn [] [(subject/lua-basic-script-globalize-entry
                  "local function add_10(x) return x + 10 end"
                  {:entry {:op-key :defn}})
                 (subject/lua-basic-script-globalize-entry
                  "local x = 1"
                  {:entry {:op-key :def}})
                 (subject/lua-basic-script-globalize-entry
                 "function add_10(x) return x + 10 end"
                 {:entry {:op-key :defn}})
                 (subject/lua-basic-script-globalize-entry
                  "local function native_math(x) return x + 10 end"
                  {:entry {:op-key :defn.xt}})
                 (subject/lua-basic-script-globalize-entry
                  "local x = 1"
                  {:entry {:op-key :other}})])
   :expected ["function add_10(x) return x + 10 end"
              "x = 1"
              "function add_10(x) return x + 10 end"
              "function native_math(x) return x + 10 end"
              "local x = 1"]}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-oneshot+}
(Test/check
 [{:name "installs the Lua one-shot runtime type"
   :test (fn [] [(:context subject/+lua-oneshot+)
                 (set (keys (select-keys (:instance (resource/spec-get :lang/rt.oneshot)) [:create :raw-eval])))
                 (get (deref registry/+registry+) [:lua :oneshot])])
   :expected [{:key :oneshot :resource :lang/rt.oneshot :config {:runtime :oneshot}}
              #{:create :raw-eval}
              'lang.runtime.basic.impl.process-lua]}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-verify+}
(Test/check
 [{:name "installs the Lua verification runtime type"
   :test (fn [] [(:context subject/+lua-verify+)
                 (set (keys (select-keys (:instance (resource/spec-get :lang/rt.verify)) [:create :raw-eval])))
                 (:type (resource/spec-get :lang/rt.verify))])
   :expected [{:key :verify :resource :lang/rt.verify :config {:runtime :verify}}
              #{:create :raw-eval}
              :lang/rt.verify]}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-basic+}
(Test/check
 [{:name "installs the Lua persistent basic runtime type"
   :test (fn [] [(:context subject/+lua-basic+)
                 (get-in subject/+lua-basic+ [:context :config :layout])
                 (set (keys (select-keys (:instance (resource/spec-get :lang/rt.basic)) [:create :start :stop :raw-eval])))
                 (:type (resource/spec-get :lang/rt.basic))])
   :expected [{:key :basic :resource :lang/rt.basic :config {:runtime :basic :layout :full}}
              :full
              #{:create :start :stop :raw-eval}
              :lang/rt.basic]}])

^{:refer lang.runtime.basic.impl.process-lua/+init+}
(Test/check
 [{:name "publishes all Lua runtime coordinates"
   :test (fn [] [(get subject/+init+ :lang)
                 (set (keys (dissoc subject/+init+ :lang)))
                 (boolean (:oneshot subject/+init+))
                 (boolean (:verify subject/+init+))
                 (boolean (:basic subject/+init+))])
   :expected [:lua #{:program :oneshot :verify :basic} true true true]}])

^{:refer lang.runtime.basic.impl.process-lua/default-body-transform}
(Test/check
 [{:name "Lua body normalization preserves arrays, statement order, and empty returns"
   :test (fn []
    [(subject/default-body-transform [1 2 3] {})
     (subject/default-body-transform [1 2 3] {:bulk true})
     (subject/default-body-transform [] {:bulk true})
     (subject/default-body-transform (quote [(var x 40) (+ x 2)]) {:bulk true})])
   :expected (quote
    [(do (defn OUT-FN [] (return [1 2 3])) (return (OUT-FN)))
     (do (defn OUT-FN [] 1 2 (return 3)) (return (OUT-FN)))
     (do (defn OUT-FN [] (return nil)) (return (OUT-FN)))
     (do (defn OUT-FN [] (var x 40) (return (+ x 2))) (return (OUT-FN)))])}
  {:name "Lua evaluation helper is local and registered as the body transform"
   :test (fn []
    [(:inner (meta (second (second (subject/default-body-transform 42 {})))))
     (= subject/default-body-transform
        (get-in subject/+lua-basic-script-emit+ [:body :transform]))])
   :expected [true true]}])
