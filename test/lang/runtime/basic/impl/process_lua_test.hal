(ns lang.runtime.basic.impl.process-lua-test
  (:require [lang.core.registry :as registry]
            [lang.core.runtime :as runtime]
            [lang.runtime.basic.impl.process-lua :as subject]
            [lang.runtime.basic.type-common :as common]))

^{:refer lang.runtime.basic.impl.process-lua/+lua-init+}
(Test/check
 [{:name "declares Lua and LuaJIT program environments"
   :test (fn [] [(get-in subject/+lua-init+ [:default :basic])
                 (get-in subject/+lua-init+ [:env :lua :exec])
                 (get-in subject/+lua-init+ [:env :lua :extension])
                 (get-in subject/+lua-init+ [:env :lua :flags :basic])
                 (get-in subject/+lua-init+ [:env :luajit :exec])
                 (get-in subject/+lua-init+ [:env :luajit :flags :basic])
                 (get-in (common/get-program-options :lua) [:default :basic])])
   :expected [:lua "lua" "lua" ["-e"] "luajit" ["-e"] :lua]}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-oneshot-config+}
(Test/check
 [{:name "configures Lua one-shot JSON output"
   :test (fn [] (select-keys subject/+lua-oneshot-config+ [:main :emit :json]))
   :expected {:main {} :emit {} :json :full}}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-verify-config+}
(Test/check
 [{:name "configures Lua verification through stdin"
   :test (fn [] (select-keys subject/+lua-verify-config+ [:main :emit :json :transport]))
   :expected {:main {} :emit {} :json false :transport :process-stdin}}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-basic-config+}
(Test/check
 [{:name "configures persistent Lua evaluation over JSON lines"
   :test (fn [] (let [config subject/+lua-basic-config+]
                  [(select-keys config [:main :json :encode :timeout :transport])
                   (:profile config)
                   (boolean (get-in config [:emit :code :transforms :entry]))
                   (boolean (:bootstrap config))]))
   :expected [{:main {} :json :full :encode :json
               :timeout 2000 :transport :process-socket}
              {:input [] :source []
               :response [[:lang/node-response 1]]}
              true
              true]}])

^{:refer lang.runtime.basic.impl.process-lua/lua-basic-script-globalize-entry}
(Test/check
 [{:name "converts local Lua declarations to globals for basic runtime"
   :test (fn [] [(subject/lua-basic-script-globalize-entry
                  "local function add_10(x) return x + 10 end"
                  {:entry {:op-key :defn}})
                 (subject/lua-basic-script-globalize-entry
                  "local x = 1"
                  {:entry {:op-key :def}})
                 (subject/lua-basic-script-globalize-entry
                 "function add_10(x) return x + 10 end"
                 {:entry {:op-key :defn}})
                 (subject/lua-basic-script-globalize-entry
                  "local function native_math(x) return x + 10 end"
                  {:entry {:op-key :defn.xt}})
                 (subject/lua-basic-script-globalize-entry
                  "local x = 1"
                  {:entry {:op-key :other}})])
   :expected ["function add_10(x) return x + 10 end"
              "x = 1"
              "function add_10(x) return x + 10 end"
              "function native_math(x) return x + 10 end"
              "local x = 1"]}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-oneshot+}
(Test/check
 [{:name "installs the Lua one-shot runtime type"
   :test (fn [] [(select-keys subject/+lua-oneshot+ [:lang :runtime :type])
                 (set (keys (:instance subject/+lua-oneshot+)))
                 (registry/registry-runtime-ns :lua :oneshot)])
   :expected [{:lang :lua :runtime :oneshot :type :lang/rt.oneshot}
              #{:create :raw-eval}
              'lang.runtime.basic.impl.process-lua]}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-verify+}
(Test/check
 [{:name "installs the Lua verification runtime type"
   :test (fn [] [(select-keys subject/+lua-verify+ [:lang :runtime :type])
                 (set (keys (:instance subject/+lua-verify+)))
                 (:type (runtime/runtime-spec :lua :verify))])
   :expected [{:lang :lua :runtime :verify :type :lang/rt.verify}
              #{:create :raw-eval}
              :lang/rt.verify]}])

^{:refer lang.runtime.basic.impl.process-lua/+lua-basic+}
(Test/check
 [{:name "installs the Lua persistent basic runtime type"
   :test (fn [] [(select-keys subject/+lua-basic+ [:lang :runtime :type])
                 (get-in subject/+lua-basic+ [:config :layout])
                 (set (keys (:instance subject/+lua-basic+)))
                 (:type (runtime/runtime-spec :lua :basic))])
   :expected [{:lang :lua :runtime :basic :type :lang/rt.basic}
              :full
              #{:create :start :stop :raw-eval}
              :lang/rt.basic]}])

^{:refer lang.runtime.basic.impl.process-lua/+init+}
(Test/check
 [{:name "publishes all Lua runtime coordinates"
   :test (fn [] [(get subject/+init+ :lang)
                 (set (keys (dissoc subject/+init+ :lang)))
                 (boolean (:oneshot subject/+init+))
                 (boolean (:verify subject/+init+))
                 (boolean (:basic subject/+init+))])
   :expected [:lua #{:program :oneshot :verify :basic} true true true]}])
