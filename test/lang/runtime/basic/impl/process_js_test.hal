(ns lang.runtime.basic.impl.process-js-test
  (:require [lang.core.registry :as registry]
            [std.lib.context.resource :as resource]
            [lang.runtime.basic.impl.process-js :as subject]
            [lang.runtime.basic.type-common :as common]))

^{:refer lang.runtime.basic.impl.process-js/+program-init+}
(Test/check
 [{:name "declares the Node.js executable and context flags"
   :test (fn [] [(get-in (common/get-program-options :js) [:default :oneshot])
                 (get-in (common/get-program-options :js) [:default :verify])
                 (get-in (common/get-program-options :js) [:default :basic])
                 (get-in (common/get-program-options :js) [:env :nodejs :exec])
                 (get-in (common/get-program-options :js) [:env :nodejs :extension])
                 (get-in (common/get-program-options :js) [:env :nodejs :flags :oneshot])
                 (get-in (common/get-program-options :js) [:env :nodejs :flags :verify])
                 (get-in (common/get-program-options :js) [:default :basic])])
   :expected [:nodejs :nodejs :nodejs "node" "js" ["-e"]
              ["--input-type=module" "--check" "-"] :nodejs]}])

^{:refer lang.runtime.basic.impl.process-js/+js-oneshot-config+}
(Test/check
 [{:name "configures JavaScript one-shot evaluation for full JSON output"
   :test (fn [] (select-keys (common/get-context-options :js :oneshot :default)
                              [:main :emit :json]))
   :expected {:main {} :emit {} :json :full}}])

^{:refer lang.runtime.basic.impl.process-js/+js-verify-config+}
(Test/check
 [{:name "configures JavaScript verification over stdin"
   :test (fn [] (select-keys (common/get-context-options :js :verify :default)
                              [:main :emit :json :transport]))
   :expected {:main {} :emit {} :json false
              :transport :process-stdin}}])

^{:refer lang.runtime.basic.impl.process-js/+js-basic-config+}
(Test/check
 [{:name "configures persistent JavaScript evaluation over a socket"
   :test (fn [] (let [config (common/get-context-options :js :basic :default)]
                  [(select-keys config [:main :emit :json :timeout :transport])
                   (:profile config)
                   (boolean (:bootstrap config))]))
   :expected [{:main {} :emit {} :json :full
               :timeout 2000 :transport :process-socket}
              {:input [] :source []
               :response [[:lang/node-response 1]]}
              true]}])

^{:refer lang.runtime.basic.impl.process-js/+js-oneshot+}
(Test/check
 [{:name "installs the JavaScript one-shot runtime type"
   :test (fn [] [(:context subject/+js-oneshot+)
                 (set (keys (select-keys (:instance (resource/spec-get :lang/rt.oneshot)) [:create :raw-eval])))
                 (get (deref registry/+registry+) [:js :oneshot])])
   :expected [{:key :oneshot :resource :lang/rt.oneshot :config {:runtime :oneshot}}
              #{:create :raw-eval}
              'lang.runtime.basic.impl.process-js]}])

^{:refer lang.runtime.basic.impl.process-js/+js-verify+}
(Test/check
 [{:name "installs the JavaScript verification runtime type"
   :test (fn [] [(:context subject/+js-verify+)
                 (set (keys (select-keys (:instance (resource/spec-get :lang/rt.verify)) [:create :raw-eval])))
                 (:type (resource/spec-get :lang/rt.verify))])
   :expected [{:key :verify :resource :lang/rt.verify :config {:runtime :verify}}
              #{:create :raw-eval}
              :lang/rt.verify]}])

^{:refer lang.runtime.basic.impl.process-js/+js-basic+}
(Test/check
 [{:name "installs the JavaScript persistent basic runtime type"
   :test (fn [] [(:context subject/+js-basic+)
                 (get-in subject/+js-basic+ [:context :config :layout])
                 (set (keys (select-keys (:instance (resource/spec-get :lang/rt.basic)) [:create :start :stop :raw-eval])))
                 (:type (resource/spec-get :lang/rt.basic))])
   :expected [{:key :basic :resource :lang/rt.basic :config {:runtime :basic :layout :full}}
              :full
              #{:create :start :stop :raw-eval}
              :lang/rt.basic]}])

^{:refer lang.runtime.basic.impl.process-js/+init+}
(Test/check
 [{:name "publishes all JavaScript runtime coordinates"
   :test (fn [] [(get subject/+init+ :lang)
                 (set (keys (dissoc subject/+init+ :lang)))
                 (boolean (:oneshot subject/+init+))
                 (boolean (:verify subject/+init+))
                 (boolean (:basic subject/+init+))])
   :expected [:js #{:program :oneshot :verify :basic} true true true]}])
