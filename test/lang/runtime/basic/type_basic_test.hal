(ns lang.runtime.basic.type-basic-test
  (:require [lang.runtime.basic.transport-node :as node]
            [lang.runtime.basic.type-basic :as subject]))

^{:refer lang.runtime.basic.type-basic/start-basic}
(Test/check
 [{:name "starts a runtime without a compiled module"
   :test (fn [] (let [runtime (subject/RuntimeBasic
                                :test
                                :hara
                                :basic
                                nil
                                nil
                                {:module nil}
                                (atom {:status :created})
                                nil
                                {:input [] :source [] :response []}
                                2000)]
                   (subject/basic-state (subject/start-basic runtime))))
   :expected {:status :started :transport nil}}])

^{:refer lang.runtime.basic.type-basic/start-basic}
(Test/check
 [{:name "starts a runtime with a selected module without compiling it"
   :test (fn [] (let [runtime (subject/RuntimeBasic
                                :test
                                :hara
                                :basic
                                nil
                                nil
                                {:module 'demo.unloaded}
                                (atom {:status :created})
                                nil
                                {:input [] :source [] :response []}
                                2000)]
                   (subject/basic-state (subject/start-basic runtime))))
   :expected {:status :started :transport nil}}])

^{:refer lang.runtime.basic.type-basic/rt-basic-port}
(Test/check
 [{:name "returns the runtime transport's bound port"
   :test (fn [] (let [transport (node/create
                                 :python
                                 ["python3" "-c"]
                                 {:bootstrap (fn [_] "pass")}
                                 2000)
                       _ (swap! (:state transport) assoc :port 4123)
                       runtime (subject/RuntimeBasic
                                :python.basic
                                :python
                                :basic
                                :cpython
                                ["python3" "-c"]
                                {:transport :process-socket}
                                (atom {:status :started})
                                transport
                                {:input [] :source [] :response []}
                                2000)]
                   (subject/rt-basic-port runtime)))
   :expected 4123}])
