(ns lang.runtime.basic.type-basic-test
  (:use code.test)
  (:require [lang.model.v1.spec-js]
            [lang.base.util]
            [lang.runtime.basic.impl.process-python]
            [lang.runtime.basic.impl.process-lua]
            [lang.runtime.basic.impl.process-js]
            [lang.runtime.basic.transport-node :as node]
            [lang.runtime.basic.type-basic :as subject]))

^{:refer lang.runtime.basic.type-basic/default-id}
(fact "uses the language runtime coordinate for the default basic id"
  [(subject/default-id :js)
   (subject/default-id :lua)]
  => [:js.basic :lua.basic])

^{:refer lang.runtime.basic.type-basic/rt-basic:create}
^{:refer lang.runtime.basic.type-basic/basic-state}
(fact "creates an unstarted persistent Node runtime"
  (let [instance (subject/rt-basic:create {:lang :js :runtime :basic})]
    [(:id instance)
     (:lang instance)
     (:program instance)
     (get-in instance [:process :transport])
     (get-in instance [:process :persistent])
     (fn? (get-in instance [:process :bootstrap]))
     (:profile instance)
     (subject/basic-state instance)])
  => [:js.basic
      :js
      :nodejs
      :process-socket
      true
      true
      {:input [] :source [] :response [[:lang/node-response 1]]}
      {:status :created :transport :process-socket}])

^{:refer lang.runtime.basic.type-basic/eval-basic}
^{:refer lang.runtime.basic.type-basic/eval-raw-basic}
(fact "rejects semantic and raw evaluation before start"
  (let [instance (subject/rt-basic:create {:lang :js :runtime :basic})]
    [(try
       (subject/eval-basic instance "1 + 1")
       :missing
       (catch error
         [(ex-message error)
          (get-in (ex-data error) [:state :status])]))
     (try
       (subject/eval-raw-basic instance "1 + 1")
       :missing
       (catch error
         [(ex-message error)
          (get-in (ex-data error) [:state :status])]))])
  => [["Basic runtime is not started" :created]
      ["Basic runtime is not started" :created]])

^{:refer lang.runtime.basic.type-basic/start-basic}
(Test/check
 [{:name "starts a runtime without a compiled module"
   :test (fn [] (let [runtime (subject/RuntimeBasic
                                :test
                                :hara
                                :basic
                                nil
                                nil
                                {:module nil}
                                (atom {:status :created})
                                nil
                                {:input [] :source [] :response []}
                                2000)]
                   (subject/basic-state (subject/start-basic runtime))))
   :expected {:status :started :transport nil}}])

^{:refer lang.runtime.basic.type-basic/start-basic}
(Test/check
 [{:name "starts a runtime with a selected module without compiling it"
   :test (fn [] (let [runtime (subject/RuntimeBasic
                                :test
                                :hara
                                :basic
                                nil
                                nil
                                {:module 'demo.unloaded}
                                (atom {:status :created})
                                nil
                                {:input [] :source [] :response []}
                                2000)]
                   (subject/basic-state (subject/start-basic runtime))))
   :expected {:status :started :transport nil}}])

^{:refer lang.runtime.basic.type-basic/rt-basic-port}
(Test/check
 [{:name "returns the runtime transport's bound port"
   :test (fn [] (let [transport (node/create
                                 :python
                                 ["python3" "-c"]
                                 {:bootstrap (fn [_] "pass")}
                                 2000)
                       _ (swap! (:state transport) assoc :port 4123)
                       runtime (subject/RuntimeBasic
                                :python.basic
                                :python
                                :basic
                                :cpython
                                ["python3" "-c"]
                                {:transport :process-socket}
                                (atom {:status :started})
                                transport
                                {:input [] :source [] :response []}
                                2000)]
                   (subject/rt-basic-port runtime)))
   :expected 4123}])

^{:refer lang.runtime.basic.type-basic/start-basic}
^{:refer lang.runtime.basic.type-basic/rt-basic}
^{:refer lang.runtime.basic.type-basic/raw-eval-basic}
^{:refer lang.runtime.basic.type-basic/stop-basic}
(fact "restarts the Node basic runtime after an idempotent teardown"
  (let [instance (subject/rt-basic {:lang :js})]
    (try
      (let [first-value (subject/raw-eval-basic instance "({answer: 42})")]
        (subject/stop-basic instance)
        (subject/stop-basic instance)
        (subject/start-basic instance)
        (let [second-value (subject/raw-eval-basic instance "21 + 21")]
          [first-value
           second-value
           (subject/basic-state (subject/stop-basic instance))]))
      (finally
        (subject/stop-basic instance))))
  => [{"answer" 42}
      42
      {:status :stopped :transport :process-socket}])

^{:refer lang.runtime.basic.type-basic/eval-raw-basic}
(fact "retains lazy Python and Lua basic bootstrap configurations"
  (let [python (subject/rt-basic:create {:lang :python :runtime :basic})
        lua (subject/rt-basic:create {:lang :lua :runtime :basic})]
    [[(get-in python [:process :transport])
      (fn? (get-in python [:process :bootstrap]))
      (get-in python [:profile :response])]
     [(get-in lua [:process :transport])
      (fn? (get-in lua [:process :bootstrap]))
      (get-in lua [:profile :response])]])
  => [[:process-socket true [[:lang/node-response 1]]]
      [:process-socket true [[:lang/node-response 1]]]])

^{:refer lang.runtime.basic.type-basic/raw-eval-basic}
(fact "round-trips a generated color function through the persistent JavaScript VM"
  (let [instance (subject/rt-basic {:lang :js})
        source (str "function substring(s,start,finish){return s.substring(start,finish); }"
                    "function starts_withp(s,pattern){return s.substring(0,pattern.length)===pattern;}"
                    "const HEX={\"4\":4,\"5\":5,\"9\":9,\"F\":15,\"8\":8,\"1\":1};"
                    "function hex__gtn(s){return HEX[s.toUpperCase()]||0;}"
                    "function hex__gtrgb(s){"
                    "let v=function(s,a,b){return hex__gtn(substring(s,a,b));};"
                    "if(!starts_withp(s,\"#\")){throw \"invalid\";}"
                    "return [(v(s,1,2)*16)+v(s,2,3),"
                    "(v(s,3,4)*16)+v(s,4,5),"
                    "(v(s,5,6)*16)+v(s,6,7)];}"
                    "hex__gtrgb(\"#45f981\")")]
    (try
      (subject/raw-eval-basic instance source)
      (finally
        (subject/stop-basic instance))))
  => [69 249 129])

^{:refer lang.runtime.basic.type-basic/rt-basic:create}
(fact "preserves script ownership and emission options"
  (let [instance (subject/rt-basic:create {:lang :js
                  :module (quote sample.module) :layout :full
                  :emit {:test-marker :kept} :library :library-marker})]
    (try
      (select-keys instance [:module :layout :emit :library])
      (finally (subject/stop-basic instance))))
  => {:module (quote sample.module) :layout :full :emit {:test-marker :kept} :library :library-marker})

^{:refer lang.runtime.basic.type-basic/RuntimeBasic}
(fact "invokes a pointer through the native script emitter and persistent JS runtime"
  (let [instance (subject/rt-basic {:lang :js :layout :full})]
    (try
      (IContextEval/invoke-ptr instance
        (lang.base.util/lang-pointer :js {})
        (quote [(+ 1 2)]))
      (finally (subject/stop-basic instance))))
  => [3])

^{:refer lang.runtime.basic.type-basic/RuntimeBasic}
(fact "does not decode semantic string results a second time"
  (let [instance (subject/rt-basic {:lang :js :layout :full})]
    (try
      [(IContextEval/invoke-ptr instance
         (lang.base.util/lang-pointer :js {:form "hello"}) [])
       (IContextEval/invoke-ptr instance
         (lang.base.util/lang-pointer :js {:form "{\"answer\":42}"}) [])
       (IContextEval/invoke-ptr instance
         (lang.base.util/lang-pointer :js {:form [false 3]}) [])]
      (finally (subject/stop-basic instance))))
  => ["hello" "{\"answer\":42}" [false 3]])

^{:refer lang.runtime.basic.type-basic/rt-basic-port}
(fact "prefers the bound transport port and falls back to configured port"
  (let [state (atom {:port 4123})
        instance {:transport {:state state} :process {:port 5123}}]
    (try
      [(subject/rt-basic-port instance)
       (subject/rt-basic-port {:process {:port 5123}})
       (subject/rt-basic-port {})]
      (finally (reset! state {}))))
  => [4123 5123 nil])

^{:refer lang.runtime.basic.type-basic/stop-basic}
(fact "stop is idempotent and returns the same runtime"
  (let [instance (subject/rt-basic:create {:lang :js})]
    (try
      [(= instance (subject/stop-basic instance))
       (= instance (subject/stop-basic instance))
       (subject/basic-state instance)]
      (finally (subject/stop-basic instance))))
  => [true true {:status :stopped :transport :process-socket}])

^{:refer lang.runtime.basic.type-basic/basic-state}
(fact "reports the current runtime lifecycle state"
  (let [instance (subject/rt-basic:create {:lang :js})]
    (try
      (let [before (subject/basic-state instance)]
        (subject/stop-basic instance)
        [before (subject/basic-state instance)])
      (finally (subject/stop-basic instance))))
  => [{:status :created :transport :process-socket}
      {:status :stopped :transport :process-socket}])

^{:refer lang.runtime.basic.type-basic/rt-basic}
(fact "creates and starts an immediately usable basic runtime"
  (let [instance (subject/rt-basic {:lang :js})]
    (try
      [(subject/basic-state instance)
       (subject/raw-eval-basic instance "6 * 7")]
      (finally (subject/stop-basic instance))))
  => [{:status :started :transport :process-socket} 42])
