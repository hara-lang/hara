(ns lang.runtime.basic.type-common-test
  (:require [lang.runtime.basic.type-common :as subject]))

^{:refer lang.runtime.basic.type-common/runtime-deep-merge}
(Test/check
 [{:name "preserves nested runtime defaults while replacing leaf options"
   :test (fn []
           (subject/runtime-deep-merge
            {:env {:node {:exec "node" :flags {:basic ["-e"]}}}
             :timeout 1000}
            {:env {:node {:flags {:verify ["--check"]}}}
             :timeout 2000}))
   :expected {:env {:node {:exec "node"
                           :flags {:basic ["-e"] :verify ["--check"]}}}
              :timeout 2000}}])

^{:refer lang.runtime.basic.type-common/valid-context}
(Test/check
 [{:name "accepts the portable two-step context and still rejects unknown contexts"
   :test (fn [] [(subject/valid-context :twostep)
                 (try
                   (subject/valid-context :missing)
                   :missing
                   (catch error (:ex/code (ex-data error))))])
   :expected [:twostep :hara/argument]}])
