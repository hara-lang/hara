(ns lang.seedgen.form-bench-test (:use code.test) (:require [std.foundation.string :as str] [std.fs :as fs] [std.fs.path :as path] [lang.seedgen.form-bench :as subject]))

(def +sample-source+ (str "(ns xt.sample.multi-test\n" "  (:use code.test)\n" "  (:require [tahto.core :as l]))\n\n" "^{:seedgen/root {:all true}}\n" "(l/script- :js {:runtime :basic})\n\n" "(l/script- :python {:runtime :basic})\n\n" "^{:refer xt.lang.spec-base/example :added \"4.1\"}\n" "(fact \"runtime branches\"\n" "  (!.js (+ 1 2))\n" "  => 3\n\n" "  (!.python (+ 1 2))\n" "  => 3)\n"))

(Test/check [{:name "expands rename parts for runtime namespaces" :expected [["python"] ["prefix" "lua" "tail"] ["7"]] :test (fn [] [(subject/bench-rename-part->segments :lang :python) (subject/bench-rename-part->segments [:prefix :lang (quote tail)] :lua) (subject/bench-rename-part->segments 7 :js)])}])

(Test/check [{:name "normalizes runtime aliases before bench resolution" :expected [:ruby :python] :test (fn [] [(subject/bench-requested-runtime-lang :ruby) (subject/bench-requested-runtime-lang "python")])}])

(Test/check [{:name "returns the display family for a requested runtime" :expected [:python :ruby] :test (fn [] [(subject/bench-display-lang :python) (subject/bench-display-lang :ruby)])}])

(Test/check [{:name "chooses an available concrete runtime and falls back to the request" :expected [:lua :dart] :test (fn [] [(subject/bench-resolve-runtime-lang :lua [:js :lua]) (subject/bench-resolve-runtime-lang :dart [:js :lua])])}])

(Test/check [{:name "rewrites seed namespaces into bench namespaces" :expected [(quote xtbench.python.sample.multi-test) (quote samplebench.js.multi-test)] :test (fn [] [(subject/bench-target-ns (quote xt.sample.multi-test) :python nil) (subject/bench-target-ns (quote sample.multi-test) :js (quote {sample [samplebench :lang]}))])}])

(Test/check [{:name "normalizes legacy project keys for native project APIs" :expected {:test-paths ["test-lang"] :project/root "/tmp/project" :root "/tmp/project" :project/test-paths ["test-lang"]} :test (fn [] (select-keys (subject/bench-project {:test-paths ["test-lang"] :root "/tmp/project"}) [:root :test-paths :project/root :project/test-paths]))}])

(Test/check [{:name "places a bench namespace under the source test root" :expected "/tmp/project/test-lang/xtbench/python/sample_test.clj" :test (fn [] (subject/bench-target-path (subject/bench-project {:test-paths ["test-lang"] :root "/tmp/project"}) "/tmp/project/test-lang/xt/sample_test.clj" (quote xtbench.python.sample-test)))}])

(Test/check [{:name "resolves requested targets from the seedgen root and project layout" :expected [true [:python] (quote xtbench.python.sample.multi-test) true] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-bench-resolve-"}) file (path/join root "test" "multi_test.clj") project {:test-paths ["test"] :root root} lookup {(quote xt.sample.multi-test) file}] (try (fs/create-directory (path/parent file) {:exists-ok? true :parents? true}) (fs/write-bytes file (str/encode-utf8 +sample-source+)) (let [value (subject/bench-resolve-targets (quote xt.sample.multi-test) {:lang [:python]} lookup project)] [(map? value) (:target-langs value) (-> value :targets first :ns) (str/ends-with? (-> value :targets first :path) "/test/xtbench/python/sample/multi_test.clj")]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "renders each resolved target through the infile renderer" :expected [true true (quote xtbench.js.sample.multi-test)] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-bench-render-"}) file (path/join root "test" "multi_test.clj") project {:test-paths ["test"] :root root} lookup {(quote xt.sample.multi-test) file}] (try (fs/create-directory (path/parent file) {:exists-ok? true :parents? true}) (fs/write-bytes file (str/encode-utf8 +sample-source+)) (let [resolved (subject/bench-resolve-targets (quote xt.sample.multi-test) {} lookup project) target (first (subject/bench-render-targets (:output resolved) file (:targets resolved)))] [(string? (:content target)) (str/includes? (:content target) "!.js") (:ns target)]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "returns sorted fact function symbols from parsed output" :expected [(quote a-value) (quote z-value)] :test (fn [] (subject/bench-output-functions {:entries {(quote demo) {(quote z-value) {} (quote a-value) {}}}}))}])

(Test/check [{:name "identifies seedgen resolution error envelopes" :expected [true false] :test (fn [] [(subject/bench-error-state {:status :error}) (subject/bench-error-state {:status :ok})])}])

(Test/check [{:name "returns a project-relative output path" :expected "test/xtbench/js/sample_test.clj" :test (fn [] (subject/bench-relative-path (subject/bench-project {:root "/tmp/project"}) "/tmp/project/test/xtbench/js/sample_test.clj"))}])

(Test/check [{:name "writes a rendered target and reports its canonical edit status" :expected [{:verified true :updated true :path "test/target.clj"} true] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-bench-transform-"}) file (path/join root "test" "target.clj") project (subject/bench-project {:test-paths ["test"] :root root}) target {:path file}] (try (let [value (subject/bench-transform-output project target "(ns demo.target)\n" true)] [(select-keys value [:path :updated :verified]) (str/includes? (str/decode-utf8 (fs/read-bytes file)) "demo.target")]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "lists target bench namespaces and returns missing-file errors" :expected [[(quote xtbench.python.sample.multi-test) (quote xtbench.js.sample.multi-test)] {:status :error :data :no-test-file}] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-bench-list-"}) file (path/join root "test" "multi_test.clj") project {:test-paths ["test"] :root root} lookup {(quote xt.sample.multi-test) file}] (try (fs/create-directory (path/parent file) {:exists-ok? true :parents? true}) (fs/write-bytes file (str/encode-utf8 +sample-source+)) [(subject/seedgen-benchlist (quote xt.sample.multi-test) {:lang [:python :js]} lookup project) (subject/seedgen-benchlist (quote sample.missing-test) {} lookup project)] (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "creates a bench target without mutating the canonical seed" :expected [{:verified true :ns (quote xtbench.python.sample.multi-test) :updated true :lang :python :path "test/xtbench/python/sample/multi_test.clj"} true true true true] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-bench-add-"}) file (path/join root "test" "multi_test.clj") project {:test-paths ["test"] :root root} lookup {(quote xt.sample.multi-test) file}] (try (fs/create-directory (path/parent file) {:exists-ok? true :parents? true}) (fs/write-bytes file (str/encode-utf8 +sample-source+)) (let [value (subject/seedgen-benchadd (quote xt.sample.multi-test) {:write true :lang [:python]} lookup project) target (first (:outputs value)) target-path (path/join root (:path target)) content (str/decode-utf8 (fs/read-bytes target-path))] [(select-keys target [:lang :ns :path :updated :verified]) (= +sample-source+ (str/decode-utf8 (fs/read-bytes file))) (str/includes? content "(ns xtbench.python.sample.multi-test") (str/includes? content "(!.python (+ 1 2))") (not (str/includes? content "!.js"))]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "removes a selected bench target while leaving the seed source intact" :expected [{:exists true :updated true :lang :python} false] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-bench-remove-"}) file (path/join root "test" "multi_test.clj") project {:test-paths ["test"] :root root} lookup {(quote xt.sample.multi-test) file}] (try (fs/create-directory (path/parent file) {:exists-ok? true :parents? true}) (fs/write-bytes file (str/encode-utf8 +sample-source+)) (subject/seedgen-benchadd (quote xt.sample.multi-test) {:write true :lang [:python]} lookup project) (let [value (subject/seedgen-benchremove (quote xt.sample.multi-test) {:write true :lang [:python]} lookup project) target (first (:outputs value))] [(select-keys target [:lang :updated :exists]) (fs/exists? (path/join root (:path target)))]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])
