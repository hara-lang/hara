(ns lang.seedgen.common-infile-test (:use code.test) (:require [std.foundation.string :as str] [std.fs :as fs] [lang.seedgen.common-infile :as subject]))

(Test/check [{:name "reads fact-level seedgen configuration for a runtime" :expected [{:suppress true :timeout 1000} nil] :test (fn [] [(subject/fact-lang-entry (with-meta (quote (fact "TODO")) {:seedgen/base {:python {:suppress true} :all {:timeout 1000}}}) :python) (subject/fact-lang-entry (quote (fact "TODO")) :python)])}])

(Test/check [{:name "returns the root runtime and an explicit missing-file result" :expected [:js {:status :error :data :no-test-file}] :test (fn [] (let [path (fs/temp-file "/" {:prefix "seedgen-infile-root-"})] (fs/delete path {:missing-ok? true}) (try (fs/write-bytes path (str/encode-utf8 (str "(ns sample-test\n" "  (:require [tahto.core :as l]))\n\n" "^{:seedgen/root true}\n" "(l/script- :js {:runtime :basic})\n"))) (let [lookup (fn [value] (when (= value (quote sample-test)) path))] [(subject/seedgen-root (quote sample) {} lookup {}) (subject/seedgen-root (quote missing) {} lookup {})]) (finally (fs/delete path {:missing-ok? true})))))}])

(Test/check [{:name "returns declared non-root runtimes and handles a missing test file" :expected [[:lua :python] {:status :error :data :no-test-file}] :test (fn [] (let [path (fs/temp-file "/" {:prefix "seedgen-infile-list-"})] (fs/delete path {:missing-ok? true}) (try (fs/write-bytes path (str/encode-utf8 (str "(ns sample-test\n" "  (:require [tahto.core :as l]))\n\n" "^{:seedgen/root true}\n" "(l/script- :js {:runtime :basic})\n\n" "(l/script- :lua {:runtime :basic})\n\n" "(l/script- :python {:runtime :basic})\n"))) (let [lookup (fn [value] (when (= value (quote sample-test)) path))] [(subject/seedgen-list (quote sample) {} lookup {}) (subject/seedgen-list (quote missing) {} lookup {})]) (finally (fs/delete path {:missing-ok? true})))))}])

(Test/check [{:name "reports facts not covered by the root runtime and honors suppression" :expected [#{(quote xt.lang.spec-base/example.B) (quote xt.lang.spec-base/example.C) (quote xt.lang.spec-base/example.D)} #{:incomplete} {:status :error :data :no-test-file}] :test (fn [] (let [path (fs/temp-file "/" {:prefix "seedgen-infile-incomplete-"})] (fs/delete path {:missing-ok? true}) (try (fs/write-bytes path (str/encode-utf8 (str "(ns sample-incomplete-test\n" "  (:require [tahto.core :as l]))\n\n" "^{:seedgen/root true}\n" "(l/script- :js {:runtime :basic})\n\n" "^{:refer xt.lang.spec-base/example.A\n" "  :setup [(!.js (+ 1 2 3))]}\n" "(fact \"covered from setup\" \"TODO\")\n\n" "^{:refer xt.lang.spec-base/example.B}\n" "(fact \"not covered\" \"TODO\")\n\n" "^{:refer xt.lang.spec-base/example.C\n" "  :teardown [(!.lua (+ 1 2 3))]}\n" "(fact \"covered by another runtime\" \"TODO\")\n\n" "^{:refer xt.lang.spec-base/example.D}\n" "(fact \"not covered by notify\"\n" "  (notify/wait-on :dt (repl/notify 1))\n" "  \"TODO\")\n\n" "^{:refer xt.lang.spec-base/example.E}\n" "(fact \"covered from notify\"\n" "  (notify/wait-on :js (repl/notify 1))\n" "  \"TODO\")\n\n" "^{:refer xt.lang.spec-base/example.F\n" "  :seedgen/base {:all {:suppress true}}}\n" "(fact \"suppressed\" \"TODO\")\n"))) (let [lookup (fn [value] (when (= value (quote sample-incomplete-test)) path)) result (subject/seedgen-incomplete (quote sample-incomplete) {} lookup {})] [(set (keys result)) (set (map :status (vals result))) (subject/seedgen-incomplete (quote missing) {} lookup {})]) (finally (fs/delete path {:missing-ok? true})))))}])
