(ns lang.seedgen.form-parse-test (:use code.test) (:require [std.block.base :as block] [std.block.navigate :as nav] [std.foundation.string :as str] [std.fs :as fs] [lang.seedgen.form-common :as form-common] [lang.seedgen.form-parse :as subject]))

(def +sample-source+ (str "(ns sample\n" "  (:require [tahto.core :as l]))\n\n" "^{:seedgen/root true}\n" "(l/script- :js {:runtime :basic})\n\n" "(l/script- :lua {:runtime :basic})\n\n" "^{:refer sample/hello :added \"4.1\"}\n" "(fact \"hello\"\n" "  (!.js 1)\n" "  => 1)\n\n" "(+ 1 2)\n"))

(def +sample-root+ (nav/parse-root +sample-source+))

(def +sample-top-navs+ (form-common/nav-top-levels +sample-root+))

(Test/check [{:name "returns an empty classification map" :expected {:root [] :derived [] :scaffold []} :test (fn [] (subject/class-empty))}])

(Test/check [{:name "returns explicit seedgen classification from metadata" :expected [:root :derived :scaffold nil] :test (fn [] [(subject/class-explicit (with-meta (quote (l/script- :js)) {:seedgen/root true})) (subject/class-explicit (with-meta (quote (l/script- :lua)) {:seedgen/derived true})) (subject/class-explicit (with-meta (quote (+ 1 2 3)) {:seedgen/scaffold true})) (subject/class-explicit (quote (+ 1 2 3)))])}])

(Test/check [{:name "recognizes configured script heads" :expected [true false true] :test (fn [] [(subject/form-script? #{(quote tahto.core/script-)} (quote (tahto.core/script- :js {}))) (subject/form-script? #{(quote tahto.core/script-)} (quote (+ 1 2 3))) (subject/form-script? #{(quote l/script-)} (quote (l/script- :js {})))])}])

(Test/check [{:name "classifies forms as root, derived or scaffold" :expected [:root :derived :root :derived :scaffold] :test (fn [] [(subject/class-form :js #{(quote tahto.core/script-)} (quote (tahto.core/script- :js {}))) (subject/class-form :js #{(quote tahto.core/script-)} (quote (tahto.core/script- :lua {}))) (subject/class-form :js #{(quote tahto.core/script-)} (quote (!.js 1))) (subject/class-form :js #{(quote tahto.core/script-)} (quote (!.lua 1))) (subject/class-form :js #{(quote tahto.core/script-)} (quote (+ 1 2 3)))])}])

(Test/check [{:name "classifies navigable forms by runtime" :expected [2 0 1] :test (fn [] (let [root (nav/parse-root "(tahto.core/script- :js {})\n\n(!.js 1)\n\n(+ 1 2 3)") navs (form-common/nav-top-levels root) classified (subject/class-navs :js #{(quote tahto.core/script-)} navs)] [(count (:root classified)) (count (:derived classified)) (count (:scaffold classified))]))}])

(Test/check [{:name "merges classifications by concatenating entries" :expected {:root [1 4] :derived [2 5] :scaffold [3 6]} :test (fn [] (subject/class-merge {:root [1] :derived [2] :scaffold [3]} {:root [4] :derived [5] :scaffold [6]}))}])

(Test/check [{:name "recognizes assertion arrow symbols" :expected [true true false] :test (fn [] [(subject/check-arrow? (quote =>)) (subject/check-arrow? (quote =>*)) (subject/check-arrow? (quote +))])}])

(Test/check [{:name "classifies fact checks by runtime language" :expected [1 1 0 1] :test (fn [] (let [root (nav/parse-root "(fact \"hello\"\n  (!.js 1)\n  => 1\n\n  (!.lua 2)\n  => 2)") fact-nav (nav/down root) classified (subject/check-classify :js #{(quote tahto.core/script-)} fact-nav)] [(count (:root classified)) (count (:derived classified)) (count (:scaffold classified)) (-> classified :root first :expected :form block/block-value)]))}])

(Test/check [{:name "classifies setup and teardown metadata" :expected [1 1] :test (fn [] (let [root (nav/parse-root "^{:setup [(!.js (setup))]\n  :teardown [(!.lua (tear))]}\n(fact \"hello\"\n  (!.js 1)\n  => 1)") fact-nav (nav/down root) classified (subject/fact-classify-meta :js #{(quote tahto.core/script-)} fact-nav)] [(count (get-in classified [:fact-setup :root])) (count (get-in classified [:fact-teardown :derived]))]))}])

(Test/check [{:name "navigates to the configuration map in a global fact" :expected {:setup (quote [(!.js (setup))])} :test (fn [] (let [root (nav/parse-root "(fact:global {:setup [(!.js (setup))]})") fact-nav (first (form-common/nav-top-levels root))] (some-> (subject/fact-config-nav fact-nav) nav/value)))}])

(Test/check [{:name "builds global runtime and top-level context" :expected {:global-top [0 0 1] :global-script {:root :js :derived 1} :lang {:root :js :derived [:lua]}} :test (fn [] (let [root (nav/parse-root +sample-source+) top-navs (form-common/nav-top-levels root) forms (mapv nav/value top-navs) context (subject/global-context forms top-navs)] {:global-top [(count (get-in context [:global-top :root])) (count (get-in context [:global-top :derived])) (count (get-in context [:global-top :scaffold]))] :global-script {:root (some-> (:root (:global-script context)) :form block/block-value second) :derived (count (get-in context [:global-script :derived]))} :lang (:lang context)}))}])

(Test/check [{:name "adds metadata, lifecycle and check classifications to an entry" :expected [true 1 0 true] :test (fn [] (let [root (nav/parse-root "^{:setup [(!.js (setup))]}\n(fact \"hello\"\n  (!.js 1)\n  => 1)") fact-nav (nav/down root) entry (subject/entry-enrich :js #{(quote tahto.core/script-)} fact-nav {})] [(map? (:checks entry)) (count (get-in entry [:fact-setup :root])) (count (get-in entry [:fact-teardown :root])) (= (quote !.js) (-> entry :checks :root first :form block/block-value first))]))}])

(Test/check [{:name "returns globals and nested fact entries" :expected [{:root :js :derived [:lua]} ["sample/hello" 1 (quote fact)] {:status :error :data :no-test-file}] :test (fn [] (let [path (fs/temp-file "/" {:prefix "seedgen-form-parse-"})] (fs/delete path {:missing-ok? true}) (try (fs/write-bytes path (str/encode-utf8 +sample-source+)) (let [lookup (fn [value] (when (= value (quote sample-test)) path)) output (subject/seedgen-readforms (quote sample) {} lookup {}) entry (get-in output [:entries (quote sample) (quote hello)])] [(get-in output [:globals :lang]) [(str (:id entry)) (count (get-in entry [:checks :root])) (-> entry :test :sexp first)] (subject/seedgen-readforms (quote missing) {} lookup {})]) (finally (fs/delete path {:missing-ok? true})))))}])
