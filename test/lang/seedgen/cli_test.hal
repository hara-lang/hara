(ns lang.seedgen.cli-test (:use code.test) (:require [code.test.artifact :as artifact] [lang.seedgen.cli :as subject] [std.foundation.string :as str] [std.fs :as fs] [std.fs.path :as path] [tool.cli.template :as template]))

(Test/check [{:name "reads EDN arguments and removes quote wrappers" :expected [42 (quote xt.demo) [(quote xt.demo) (quote other)] 7] :test (fn [] [(subject/read-arg "42") (subject/read-arg "'xt.demo") (subject/read-arg "'[xt.demo other]") (subject/read-arg 7)])}])

(Test/check [{:name "collects selectors after :only and preserves remaining options" :expected [[[(quote xt.foo) (quote xt.bar)] [":with" "[lua python]"]] [(quote xt.foo) []] [nil []]] :test (fn [] [(subject/collect-selector [":only" "xt.foo" "xt.bar" ":with" "[lua python]"]) (subject/collect-selector ["'xt.foo"]) (subject/collect-selector [])])}])

(Test/check [{:name "parses test selectors languages metrics and extra options" :expected [{:langs [(quote lua) (quote python)] :params {} :selector [(quote xt.foo) (quote xt.bar)] :extra []} {:langs [(quote lua)] :params {:metrics (quote target/out.json)} :selector (quote xt.foo) :extra [":metrics" "target/out.json"]} {:langs nil :params {} :selector :all :extra []}] :test (fn [] [(subject/parse-test-args [":only" "xt.foo" "xt.bar" ":with" "[lua python]"]) (subject/parse-test-args ["'xt.foo" ":with" "[lua]" ":metrics" "target/out.json"]) (subject/parse-test-args ["':all"])])}])

(Test/check [{:name "prefers native project roots and falls back to the process cwd" :expected ["/native" "/legacy" true] :test (fn [] [(subject/project-root {:project/root "/native" :root "/legacy"}) (subject/project-root {:root "/legacy"}) (string? (subject/project-root {}))])}])

(Test/check [{:name "normalizes legacy project maps into native project keys" :expected {:test-paths ["test"] :project/root "/tmp/project" :root "/tmp/project" :source-paths ["src"] :project/source-paths ["src"] :project/test-paths ["test"]} :test (fn [] (select-keys (subject/normalise-project {:test-paths ["test"] :root "/tmp/project" :source-paths ["src"]}) [:root :source-paths :test-paths :project/root :project/source-paths :project/test-paths]))}])

(Test/check [{:name "uses supplied seedgen records as a deterministic project inventory" :expected [{:namespace (quote xt.demo-test) :type :test :path "test-lang/xt/demo_test.clj"}] :test (fn [] (let [records [{:namespace (quote xt.demo-test) :type :test :path "test-lang/xt/demo_test.clj"}] project (subject/normalise-project {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records records})] (subject/project-records project)))}])

(Test/check [{:name "recognizes exact and nested project path roots" :expected [true true false] :test (fn [] [(subject/path-has-root? "test-lang/xt/demo.clj" "test-lang/xt") (subject/path-has-root? "/repo/test-lang/xt/demo.clj" "test-lang/xt") (subject/path-has-root? "test-lang/kmi/demo.clj" "test-lang/xt")])}])

(Test/check [{:name "accepts xt and kmi seedgen test trees only" :expected [true true false] :test (fn [] (map boolean [(subject/seedgen-test-area? "test-lang/xt/demo.clj") (subject/seedgen-test-area? "lib/test-lang/kmi/demo.clj") (subject/seedgen-test-area? "test/demo.clj")]))}])

(Test/check [{:name "honors explicit and source-marked skip records" :expected [true true false false] :test (fn [] [(subject/seedgen-skip-record? {:seedgen/skip true}) (subject/seedgen-skip-record? {:source "demo :seedgen/skip"}) (subject/seedgen-skip-record? {:path "/missing/seedgen-test.clj"}) (subject/seedgen-skip-record? {})])}])

(Test/check [{:name "lists seedgen test namespaces while filtering skipped records" :expected [(quote kmi.demo.a-test) (quote xt.demo.z-test)] :test (fn [] (let [records [{:namespace (quote xt.demo.z-test) :type :test :path "test-lang/xt/demo/z_test.clj"} {:namespace (quote kmi.demo.a-test) :type :test :path "test-lang/kmi/demo/a_test.clj"} {:namespace (quote xt.demo.skip-test) :type :test :path "test-lang/xt/demo/skip_test.clj" :seedgen/skip true} {:namespace (quote demo.source) :type :source :path "src/demo/source.hal"}]] (subject/source-namespaces {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records records})))}])

(Test/check [{:name "matches a namespace against any configured prefix" :expected [true false false] :test (fn [] [(subject/prefix-matches? (quote xt.demo.alpha) ["kmi." "xt.demo"]) (subject/prefix-matches? (quote xt.demo.alpha) []) (subject/prefix-matches? (quote kmi.demo.alpha) ["xt."])])}])

(Test/check [{:name "delegates collection selector behavior to Work" :expected [true true true] :test (fn [] [(subject/prefix-matches? (quote xt.demo.alpha) [(quote xt.demo) (quote other)]) (subject/prefix-matches? (quote xt.demo.alpha) (quote (xt xt.demo))) (subject/prefix-matches? (quote xt.demo.alpha) #{(quote xt.demo.alpha)})])}])

(Test/check [{:name "normalizes language include and exclude compatibility rules" :expected [{:include ["xt.demo"] :exclude ["xt.demo.skip"]} true] :test (fn [] [(subject/language-rules :js {:js {:include [(quote xt.demo)] :exclude [(quote xt.demo.skip)]}}) (try (subject/language-rules :lua {:js {}}) false (catch Throwable _ true))])}])

(Test/check [{:name "normalizes all selector shapes to prefix strings" :expected [["xt."] ["xt.demo"] ["xt.demo" "kmi.demo"] ["xt"] []] :test (fn [] [(subject/selector-prefixes :all) (subject/selector-prefixes (quote xt.demo)) (subject/selector-prefixes [(quote xt.demo) (quote kmi.demo)]) (subject/selector-prefixes :xt) (subject/selector-prefixes nil)])}])

(Test/check [{:name "applies selector include and exclude rules to seedgen records" :expected [[(quote xt.demo.alpha-test)] [(quote xt.demo.alpha-test)] []] :test (fn [] (let [records [{:namespace (quote xt.demo.alpha-test) :type :test :path "test-lang/xt/demo/alpha_test.clj"} {:namespace (quote xt.demo.skip-test) :type :test :path "test-lang/xt/demo/skip_test.clj"} {:namespace (quote kmi.demo.beta-test) :type :test :path "test-lang/kmi/demo/beta_test.clj"}] project {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records records} config {:python {:include [(quote xt.demo.alpha)] :exclude []} :js {:include :all :exclude [(quote xt.demo.skip)]}}] [(subject/compatible-namespaces :js :all config project) (subject/compatible-namespaces :python :all config project) (subject/compatible-namespaces :js (quote kmi.demo) config project)]))}])

(Test/check [{:name "reports only languages compatible with each selected namespace" :expected {(quote xt.demo.alpha-test) [:js :python]} :test (fn [] (let [records [{:namespace (quote xt.demo.alpha-test) :type :test :path "test-lang/xt/demo/alpha_test.clj"} {:namespace (quote kmi.demo.beta-test) :type :test :path "test-lang/kmi/demo/beta_test.clj"}] project {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records records} config {:python {:include [(quote xt.demo)] :exclude []} :js {:include :all :exclude []}}] (subject/compatible-report :all config project)))}])

(Test/check [{:name "rewrites xt and kmi namespaces into xtbench names" :expected [(quote xtbench.lua.lang.sample) (quote xtbench.python.kmi.lang.runtime) (quote demo.core)] :test (fn [] [(subject/generated-namespace (quote xt.lang.sample) :lua) (subject/generated-namespace (quote kmi.lang.runtime) :python) (subject/generated-namespace (quote demo.core) :js)])}])

(Test/check [{:name "extracts a runtime keyword from xtbench namespaces" :expected [:lua nil nil] :test (fn [] [(subject/extract-lang (quote xtbench.lua.lang.sample-test)) (subject/extract-lang (quote demo.core)) (subject/extract-lang (quote xtbench))])}])

(Test/check [{:name "reads metadata maps and safely handles non-map result values" :expected [{:ns (quote xtbench.lua.sample-test)} true] :test (fn [] [(subject/failure-meta {:meta {:ns (quote xtbench.lua.sample-test)}}) (map? (subject/failure-meta 42))])}])

(Test/check [{:name "finds function references in direct and nested failure metadata" :expected [(quote demo/direct) (quote demo/refer) (quote demo/nested)] :test (fn [] [(subject/failure-function {:function (quote demo/direct)}) (subject/failure-function {:meta {:refer (quote demo/refer)}}) (subject/failure-function {:meta {:function (quote demo/nested)}})])}])

(Test/check [{:name "groups latest native artifact failures by runtime language" :expected {:python {:throw [(quote xt.lang.core/run)]} :lua {:errored [(quote xtbench.lua.load-error-test)] :failed [(quote xt.lang.sample/emit) (quote xt.lang.sample/parse)]}} :test (fn [] (let [baseline (deref artifact/+latest+)] (try (reset! artifact/+latest+ {:failures {:throw [{:meta {:ns (quote xtbench.python.core-test) :refer (quote xt.lang.core/run)}}] :failed [{:meta {:ns (quote xtbench.lua.sample-test) :refer (quote xt.lang.sample/parse)}} {:meta {:ns (quote xtbench.lua.sample-test) :function (quote xt.lang.sample/emit)}}] :timeout []} :errored [(quote xtbench.lua.load-error-test)]}) (subject/failing-functions) (finally (reset! artifact/+latest+ baseline)))))}])

(Test/check [{:name "removes the xtbench runtime prefix from benchmark namespaces" :expected ["lang.sample-test" "lang.sample-test"] :test (fn [] [(subject/canonical-bench-namespace (quote xtbench.lua.lang.sample-test)) (subject/canonical-bench-namespace (quote lang.sample-test))])}])

(Test/check [{:name "makes paths relative only when they are rooted at the project" :expected ["test/a.clj" "test/a.clj" nil] :test (fn [] [(subject/relative-test-path "/repo" "/repo/test/a.clj") (subject/relative-test-path "/repo" "test/a.clj") (subject/relative-test-path "/repo" nil)])}])

(Test/check [{:name "normalizes one failure result into a JSON-safe occurrence" :expected {:runtime-namespace "xtbench.lua.lang.sample-test" :namespace "lang.sample-test" :type :failed :line 42 :function "xt.lang.sample/parse" :path "test/sample_test.clj"} :test (fn [] (subject/failure-occurrence :failed {:meta {:ns (quote xtbench.lua.lang.sample-test) :line 42 :path "/repo/test/sample_test.clj" :refer (quote xt.lang.sample/parse)}} "/repo"))}])

(Test/check [{:name "coalesces repeated occurrences at the same source location" :expected [{:count 2 :type :failed :line 4 :path "test/a.clj"}] :test (fn [] (subject/occurrence-locations [{:type :failed :line 4 :path "test/a.clj"} {:type :failed :line 4 :path "test/a.clj"}]))}])

(Test/check [{:name "groups failures by canonical namespace function and location" :expected [{:runtime-namespace "xtbench.python.kmi.lang.runtime-test" :counts {:failed 1} :namespace "kmi.lang.runtime-test" :namespace-errors [] :functions [{:counts {:failed 1} :locations [{:count 1 :type :failed :line 17 :path "test-lang/xtbench/python/kmi/lang/runtime_test.clj"}] :function "kmi.lang.runtime/eval-string"}]} {:runtime-namespace "xtbench.lua.lang.load-error-test" :counts {:errored 1} :namespace "lang.load-error-test" :namespace-errors [{:count 1 :type :errored}] :functions []} {:runtime-namespace "xtbench.lua.lang.sample-test" :counts {:throw 1 :failed 2} :namespace "lang.sample-test" :namespace-errors [] :functions [{:counts {:throw 1} :locations [{:count 1 :type :throw :line 51 :path "test-lang/xtbench/lua/lang/sample_test.clj"}] :function "xt.lang.sample/emit"} {:counts {:failed 2} :locations [{:count 2 :type :failed :line 42 :path "test-lang/xtbench/lua/lang/sample_test.clj"}] :function "xt.lang.sample/parse"}]}] :test (fn [] (let [failed {:meta {:ns (quote xtbench.lua.lang.sample-test) :line 42 :path "/repo/test-lang/xtbench/lua/lang/sample_test.clj" :refer (quote xt.lang.sample/parse)}} thrown {:meta {:ns (quote xtbench.lua.lang.sample-test) :line 51 :function (quote xt.lang.sample/emit) :path "test-lang/xtbench/lua/lang/sample_test.clj"}} kmi-failed {:meta {:ns (quote xtbench.python.kmi.lang.runtime-test) :line 17 :path "test-lang/xtbench/python/kmi/lang/runtime_test.clj" :refer (quote kmi.lang.runtime/eval-string)}} summary (with-meta {:throw 1 :failed 2 :timeout 0 :passed 3} {:data {:throw [thrown] :failed [failed failed kmi-failed] :timeout []}})] (subject/failure-tree summary [(quote xtbench.lua.lang.load-error-test)] {:root "/repo"})))}])

(Test/check [{:name "totals failed throw timeout and namespace errors" :expected [6 1] :test (fn [] [(subject/failing-summary {:throw 2 :failed 1 :timeout 3} []) (subject/failing-summary {:throw 0 :failed 0 :timeout 0} [(quote xtbench.lua.error-test)])])}])

(Test/check [{:name "writes a failure list and restores the run directory baseline" :expected [true true true true] :test (fn [] (let [tahto (path/join (OS/cwd) ".tahto") run-dir (path/join tahto "runs") tahto-existed? (fs/exists? tahto) run-existed? (fs/exists? run-dir) holder (atom nil)] (try (let [file-path (subject/save-failing-list {:lua {:failed [(quote demo/run)]}}) _ (reset! holder file-path)] [(string? file-path) (str/ends-with? file-path ".edn") (fs/exists? file-path) (str/includes? (str/decode-utf8 (fs/read-bytes file-path)) "demo/run")]) (finally (let [file-path (deref holder)] (when (and file-path (fs/exists? file-path)) (fs/delete file-path {:missing-ok? true}))) (when (and (not run-existed?) (fs/exists? run-dir)) (fs/delete run-dir {:recursive? true :missing-ok? true})) (when (and (not tahto-existed?) (fs/exists? tahto)) (fs/delete tahto {:recursive? true :missing-ok? true}))))))}])

(Test/check [{:name "removes generated benchmark trees idempotently" :expected [true false true] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-clear-test-"}) directory (path/join root "test" "xtbench" "js") file (path/join directory "sample_test.clj")] (try (fs/create-directory directory {:exists-ok? true :parents? true}) (fs/write-bytes file (str/encode-utf8 "sample")) (let [first-result (subject/clear-bench-lang :js {:test-paths ["test"] :root root :source-paths []}) second-result (subject/clear-bench-lang :js {:test-paths ["test"] :root root :source-paths []})] [(boolean (seq first-result)) (fs/exists? directory) (empty? second-result)]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "builds a namespace to path lookup from project records" :expected {(quote demo.core) "src/demo/core.hal" (quote demo.core-test) "test/demo/core_test.hal"} :test (fn [] (subject/project-lookup {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records [{:namespace (quote demo.core) :path "src/demo/core.hal"} {:namespace (quote demo.core-test) :path "test/demo/core_test.hal"}]}))}])

(Test/check [{:name "builds a source unit with source text and lookup provenance" :expected [true (quote demo.core) "(ns demo.core)\n(def value 1)\n" true true] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-unit-test-"}) file (path/join root "src" "demo" "core.hal") project {:test-paths ["test"] :root root :source-paths ["src"]} lookup {(quote demo.core) file}] (try (fs/create-directory (path/parent file) {:exists-ok? true :parents? true}) (fs/write-bytes file (str/encode-utf8 "(ns demo.core)\n(def value 1)\n")) (let [unit (subject/source-unit (quote demo.core) project lookup)] [(str/ends-with? (:path unit) "/src/demo/core.hal") (:namespace unit) (:source unit) (= project (:seedgen/project unit)) (= lookup (:seedgen/lookup unit))]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "resolves generated output paths against the project root" :expected {:namespace (quote xtbench.js.demo-test) :path "/repo/test/xtbench/js/demo_test.clj"} :test (fn [] (subject/target-record {:root "/repo"} {:ns (quote xtbench.js.demo-test) :path "test/xtbench/js/demo_test.clj"}))}])

(Test/check [{:name "loads project compatibility data and provides a runtime fallback" :expected [{:js {:include :all :exclude []}} {:js {:include ["xt.demo"] :exclude ["xt.skip"]}}] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-config-test-"}) file (path/join root "config" "xtalk" "xtalk_compatibility.edn")] (try (let [fallback (subject/load-compatibility {:test-paths [] :root root :source-paths []})] (fs/create-directory (path/parent file) {:exists-ok? true :parents? true}) (fs/write-bytes file (str/encode-utf8 "{:js {:include [\"xt.demo\"] :exclude [\"xt.skip\"]}}")) [(select-keys fallback [:js]) (subject/load-compatibility {:test-paths [] :root root :source-paths []})]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "returns a passing zero-target result for an empty project" :expected {:exit 0 :summary {:results [] :throw 0 :status :passed :errored [] :failed 0 :timeout 0 :passed 0} :generated {:js []}} :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-test-test-"}) project {:test-paths [] :root root :source-paths [] :seedgen/records []}] (try (select-keys (subject/seedgen-test :all [:js] project) [:generated :exit :summary]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "selects source namespaces while excluding test namespaces" :expected [(quote kmi.demo.beta) (quote xt.demo.alpha)] :test (fn [] (subject/source-namespaces-for :all {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records [{:namespace (quote xt.demo.alpha) :type :source :path "src/xt/demo/alpha.hal"} {:namespace (quote xt.demo.alpha-test) :type :source :path "src/xt/demo/alpha_test.hal"} {:namespace (quote kmi.demo.beta) :type :source :path "src/kmi/demo/beta.hal"}]}))}])

(Test/check [{:name "extracts definition names from a source file" :expected [(quote alpha) (quote beta)] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-vars-test-"}) file (path/join root "core.hal")] (try (fs/write-bytes file (str/encode-utf8 "(ns demo.core)\n(defn alpha [x] x)\n(defn beta [] 2)\n")) (subject/source-vars (quote demo.core) {(quote demo.core) file}) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "finds the project test namespace path" :expected "test/demo/core_test.hal" :test (fn [] (subject/test-file-for (quote demo.core) {(quote demo.core-test) "test/demo/core_test.hal"} {:test-paths [] :root "/tmp/project" :source-paths []}))}])

(Test/check [{:name "converts a source namespace to the legacy test path convention" :expected ["test/xt/lang/sample_test.clj" "test/kmi/lang/runtime_test.clj"] :test (fn [] [(subject/inferred-test-path (quote xt.lang.sample)) (subject/inferred-test-path (quote kmi.lang.runtime))])}])

(Test/check [{:name "finds refer symbols in an existing fact file" :expected [#{(quote demo.core/alpha)} #{}] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-facts-test-"}) file (path/join root "core_test.clj")] (try (fs/write-bytes file (str/encode-utf8 "(ns demo.core-test)\n(:use code.test)\n^{:refer demo.core/alpha}\n(fact \"alpha\" true => true)\n")) [(subject/existing-fact-refers file) (subject/existing-fact-refers (path/join root "missing.clj"))] (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "dry-runs and writes missing TODO facts without duplication" :expected [1 false 1 true true] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-ensure-test-"}) source-file (path/join root "src" "demo" "core.hal") project {:test-paths ["test"] :root root :source-paths ["src"]} lookup {(quote demo.core) source-file} test-file (path/join root "test" "demo" "core_test.clj")] (try (fs/create-directory (path/parent source-file) {:exists-ok? true :parents? true}) (fs/write-bytes source-file (str/encode-utf8 "(ns demo.core)\n(defn alpha [] 1)\n")) [(subject/ensure-test-file! (quote demo.core) ["alpha"] false project lookup) (fs/exists? test-file) (subject/ensure-test-file! (quote demo.core) ["alpha"] true project lookup) (fs/exists? test-file) (str/includes? (str/decode-utf8 (fs/read-bytes test-file)) "^{:refer demo.core/alpha")] (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "counts and writes TODO facts only when requested" :expected [0 2 true true] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-todos-test-"}) source-file (path/join root "src" "demo" "todo.hal") project {:test-paths ["test"] :root root :source-paths ["src"] :seedgen/records [{:namespace (quote demo.todo) :type :source :path source-file}]} test-file (path/join root "test" "demo" "todo_test.clj")] (try (fs/create-directory (path/parent source-file) {:exists-ok? true :parents? true}) (fs/write-bytes source-file (str/encode-utf8 "(ns demo.todo)\n(defn alpha [] 1)\n(defn beta [] 2)\n")) [(subject/seedgen-todos (quote demo.todo) {:project project}) (subject/seedgen-todos (quote demo.todo) {:write true :project project}) (fs/exists? test-file) (str/includes? (str/decode-utf8 (fs/read-bytes test-file)) "demo.todo/alpha")] (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "parses keyword/value command parameters and rejects missing values" :expected [{:write true :lang (quote lua)} true] :test (fn [] [(subject/parse-command-params [":with" "lua" ":write" "true"]) (try (subject/parse-command-params [":write"]) false (catch Throwable _ true))])}])

(Test/check [{:name "parses a generic command selector and its options" :expected [{:params {:lang (quote lua)} :selector [(quote xt.foo) (quote xt.bar)]} {:params {:write true} :selector (quote xt.foo)}] :test (fn [] [(subject/parse-command-args [":only" "xt.foo" "xt.bar" ":lang" "lua"]) (subject/parse-command-args ["'xt.foo" ":write" "true"])])}])

(Test/check [{:name "retains the short operation parser for legacy callers" :expected [{:language nil :operation :list} {:language :python :operation :benchadd} true] :test (fn [] [(subject/parse-arguments []) (subject/parse-arguments ["benchadd" "python"]) (try (subject/parse-arguments ["missing"]) false (catch Throwable _ true))])}])

(Test/check [{:name "filters root seedgen units by selector" :expected [] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-selected-test-"})] (try (subject/selected-seedgen-units :all {:test-paths [] :root root :source-paths [] :seedgen/records []}) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "returns the complete inventory for Work to select" :expected [2 [(quote xt.demo.one) (quote other.two)] [(quote xt.demo.one-test) (quote other.two-test)]] :test (fn [] (let [units (subject/selected-seedgen-units (quote xt.demo) {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records [{:namespace (quote xt.demo.one-test) :type :test :path "test-lang/xt/demo/one_test.hal"} {:namespace (quote other.two-test) :type :test :path "test-lang/xt/other/two_test.hal"}]})] [(count units) (vec (map :namespace units)) (vec (map :seedgen/test-namespace units))]))}])

(Test/check [{:name "runs a seedgen operation through the task report envelope" :expected {:results 0 :operation :list :items 0} :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-cli-operation-test-"})] (try (select-keys (:summary (subject/run-seedgen-operation :list :all {} {:test-paths [] :root root :source-paths [] :seedgen/records []})) [:operation :items :results]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "dispatches compatible and TODO commands and validates command names" :expected [{} 0 true true] :test (fn [] (let [project {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records []}] [(subject/run-seedgen-command "compatible" [] project) (subject/run-seedgen-command "todos" [":only" "missing"] project) (try (subject/run-seedgen-command "metrics-merge" [] project) false (catch Throwable _ true)) (try (subject/run-seedgen-command "missing" [] project) false (catch Throwable _ true))]))}])

(Test/check [{:name "wraps a seedgen command in the closed CLI result model" :expected {:result/data 0 :result/outcome :tool.cli.outcome/success :result/exit 0} :test (fn [] (let [project {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records []} result (subject/execute-request {:request/options {:project project} :request/arguments ["todos" ":only" "missing"]})] (select-keys result [:result/outcome :result/exit :result/data])))}])

(Test/check [{:name "publishes a template-backed handler that returns a model result" :expected [true :tool.cli.outcome/success 0 0] :test (fn [] (let [project {:test-paths [] :root "/tmp/project" :source-paths [] :seedgen/records []} result (subject/handler {:request/options {:project project} :request/arguments ["todos" ":only" "missing"]})] [(template/handler? subject/handler) (:result/outcome result) (:result/exit result) (:result/data result)]))}])

(Test/check [{:name "returns structured native exit results without terminating the process" :expected [{:exit 1 :error "Usage: seedgen <command> <selector> [options]"} 1] :test (fn [] [(select-keys (subject/-main) [:exit :error]) (:exit (subject/-main "missing"))])}])
