(ns lang.seedgen.common-meta-test (:use code.test) (:require [lang.seedgen.common-meta :as meta]))

(Test/check [{:name "retains the complete runtime configuration authority" :expected [10 :twostep (quote !.R) "go"] :test (fn [] [(count meta/+runtime-lang-config+) (get-in meta/+runtime-lang-config+ [:dart :runtime]) (get-in meta/+runtime-lang-config+ [:r :dispatch]) (get-in meta/+runtime-lang-config+ [:go :suffix])])}])

(Test/check [{:name "retains the Ruby compatibility alias" :expected {:ruby :rb} :test (fn [] meta/+runtime-lang-aliases+)}])

(Test/check [{:name "retains the executable runtime set" :expected #{:js :lua :python :scheme :elisp :r :rb :php} :test (fn [] meta/+runtime-executable-langs+)}])

(Test/check [{:name "sorts all configured runtime language keys" :expected [:dart :elisp :go :js :lua :php :python :r :rb :scheme] :test (fn [] meta/+runtime-langs+)}])

(Test/check [{:name "normalizes keyword, string, symbol, and alias inputs" :expected [:js :js :js :rb :unknown] :test (fn [] [(meta/normalize-runtime-lang :js) (meta/normalize-runtime-lang "js") (meta/normalize-runtime-lang (quote js)) (meta/normalize-runtime-lang :ruby) (meta/normalize-runtime-lang :unknown)])}])

(Test/check [{:name "returns complete runtime metadata and nil for unknown languages" :expected [{:runtime :basic :script :js :check-mode :realtime :dispatch (quote !.js) :suffix "js"} {:runtime :basic :script :ruby :check-mode :realtime :dispatch (quote !.rb) :suffix "rb"} nil] :test (fn [] [(select-keys (meta/runtime-lang-config :js) [:script :dispatch :suffix :runtime :check-mode]) (select-keys (meta/runtime-lang-config :ruby) [:script :dispatch :suffix :runtime :check-mode]) (meta/runtime-lang-config :unknown)])}])

(Test/check [{:name "resolves script language through canonical aliases" :expected [:js :ruby nil] :test (fn [] [(meta/runtime-script-lang :js) (meta/runtime-script-lang :ruby) (meta/runtime-script-lang :unknown)])}])

(Test/check [{:name "returns target dispatch symbols" :expected [(quote !.js) (quote !.dt) nil] :test (fn [] [(meta/runtime-dispatch-symbol :js) (meta/runtime-dispatch-symbol :dart) (meta/runtime-dispatch-symbol :unknown)])}])

(Test/check [{:name "separates basic and two-step runtimes" :expected [:basic :twostep nil] :test (fn [] [(meta/runtime-type :js) (meta/runtime-type :dart) (meta/runtime-type :unknown)])}])

(Test/check [{:name "reports realtime and batched checking modes" :expected [:realtime :batched nil] :test (fn [] [(meta/runtime-check-mode :python) (meta/runtime-check-mode :go) (meta/runtime-check-mode :unknown)])}])

(Test/check [{:name "normalizes, deduplicates, sorts, and groups runtime languages" :expected [{:batched [:dart] :realtime [:js :python]} {:realtime [:r :rb :scheme]}] :test (fn [] [(meta/runtime-suite-groups [:js :dart :python]) (meta/runtime-suite-groups [:ruby :rb :r :scheme])])}])

(Test/check [{:name "returns generated file suffixes" :expected ["js" "rb" "r" nil] :test (fn [] [(meta/runtime-lang-suffix :js) (meta/runtime-lang-suffix :ruby) (meta/runtime-lang-suffix :r) (meta/runtime-lang-suffix :unknown)])}])
