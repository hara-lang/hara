(ns lang.seedgen.metrics-test (:use code.test) (:require [std.foundation.string :as str] [std.fs :as fs] [std.fs.path :as path] [lang.seedgen.metrics :as subject]))

(Test/check [{:name "returns an ISO-8601 UTC timestamp" :expected [true true true] :test (fn [] (let [value (subject/utc-now)] [(string? value) (str/includes? value "T") (str/ends-with? value "Z")]))}])

(Test/check [{:name "returns present environment values and nil for an empty name" :expected [true nil] :test (fn [] [(string? (subject/env "PATH")) (subject/env "")])}])

(Test/check [{:name "parses integer text without throwing on invalid input" :expected [42 nil nil nil] :test (fn [] [(subject/parse-long-safe "42") (subject/parse-long-safe "") (subject/parse-long-safe "not-a-number") (subject/parse-long-safe nil)])}])

(Test/check [{:name "renders scalar and sequential selectors" :expected [":xt.lang,:xt.event" "xt.lang"] :test (fn [] [(subject/selector-name [:xt.lang :xt.event]) (subject/selector-name (quote xt.lang))])}])

(Test/check [{:name "marks records with any failure count as failures" :expected ["success" "failure" "failure"] :test (fn [] [(subject/conclusion {:passed 2} []) (subject/conclusion {:failed 1} []) (subject/conclusion {:passed 2} ["error"])])}])

(Test/check [{:name "returns workflow, git and run context records" :expected [true true true true] :test (fn [] (let [context (subject/github-context)] [(string? (:workflow-key context)) (string? (:workflow-name context)) (map? (:git context)) (>= (:attempt (:run context)) 1)]))}])

(Test/check [{:name "converts native values into JSON-compatible keys and arrays" :expected {"items" [1 "two"] "state" "ready" "nested" {"ok" true}} :test (fn [] (subject/json-value {:state :ready "nested" {:ok true} :items (quote (1 :two))}))}])

(Test/check [{:name "restores keyword keys after JSON decoding" :expected {:state "ready" :items [1 {:ok true}]} :test (fn [] (subject/keywordize-json {"items" [1 {"ok" true}] "state" "ready"}))}])

(Test/check [{:name "builds a complete successful job record" :expected {:schema-version 1 :failures [{:counts {:failed 1} :namespace "lang.sample-test"}] :spec {:spec-feature-count 4 :test-count 2 :spec-implemented 3 :coverage (double 0.5) :model-count 3 :spec-missing 1 :spec-abstract 0} :status "success" :tests {:throw 0 :errored 0 :failed 0 :timeout 0 :passed 7 :skipped 1} :language "python" :failure-counts {:throw 0 :errored 0 :failed 0 :timeout 0} :kind "xtbench-job" :generated-count 1 :suite "xt.lang"} :test (fn [] (let [record (subject/test-record (quote [xt.lang]) [:python] {:failures [{:counts {:failed 1} :namespace "lang.sample-test"}] :spec {:spec-feature-count 4 :test-count 2 :spec-implemented 3 :coverage (double 0.5) :model-count 3 :spec-missing 1 :spec-abstract 0} :summary {:throw 0 :failed 0 :timeout 0 :passed 7 :skipped 1} :generated {:python [(quote xtbench.python.lang-test)]}})] (select-keys record [:schema-version :kind :suite :language :status :generated-count :tests :failure-counts :failures :spec])))}])

(Test/check [{:name "writes JSON to a nested path and returns that path" :expected [true {:count 2 :status "success"}] :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-metrics-write-"}) file (path/join root "nested" "record.json")] (try [(string? (subject/write-json! file {:count 2 :status :success})) (subject/read-json file)] (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "writes a serialized test record" :expected {:status "success" :language "lua" :generated-count 1 :suite "xt.lang"} :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-metrics-test-"}) file (path/join root "job.json")] (try (subject/write-test-record! file (quote [xt.lang]) [:lua] {:summary {:passed 1} :generated {:lua [(quote xtbench.lua.sample)]}}) (select-keys (subject/read-json file) [:suite :language :status :generated-count]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "extracts exception messages and stringifies fallback errors" :expected ["broken" "already-text"] :test (fn [] [(subject/error-message (ex :generic {} :ex/message "broken")) (subject/error-message "already-text")])}])

(Test/check [{:name "writes a failed record with an explicit error payload" :expected {:status "failure" :error {:message "broken"} :tests {:throw 0 :errored 1 :failed 0 :timeout 0 :passed 0 :skipped 0}} :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-metrics-error-"}) file (path/join root "error.json")] (try (subject/write-error-record! file (quote [xt.lang]) [:js] (ex :generic {} :ex/message "broken")) (select-keys (subject/read-json file) [:status :tests :error]) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "reads JSON object keys as keywords" :expected {:status "success" :items [1 2]} :test (fn [] (let [root (fs/temp-directory "/" {:prefix "seedgen-metrics-read-"}) file (path/join root "record.json")] (try (fs/write-bytes file (str/encode-utf8 "{\"status\":\"success\",\"items\":[1,2]}")) (subject/read-json file) (finally (fs/delete root {:recursive? true :missing-ok? true})))))}])

(Test/check [{:name "aggregates suite and language job records" :expected [{:status "failure" :workflow-key "core" :tests {:throw 0 :errored 0 :failed 1 :timeout 0 :passed 8 :skipped 1}} {:status "failure" :workflow-key "core" :error {:message "No XTBench job metrics artifacts were published." :type "missing-metrics-artifacts"} :jobs [] :tests {:throw 0 :errored 0 :failed 0 :timeout 0 :passed 0 :skipped 0} :metrics-status "missing-artifacts"} {:git {:event "push" :ref "refs/heads/main" :sha "def456"} :workflow-name "XTBench Core" :run {:attempt 1 :id 99 :url "https://example.test/run/12345" :number 4}}] :test (fn [] (let [context {:git {:event "push" :ref "refs/heads/main" :sha "abc123"} :workflow-name "XTBench Core" :run {:attempt 2 :id 12345 :url "https://example.test/run/12345" :number 77} } records [{:suite "xt.lang" :status "success" :language "lua" :workflow-name "XTBench Core" :tests {:throw 0 :errored 0 :failed 0 :timeout 0 :passed 5 :skipped 1} :run {:attempt 1 :number 4}} {:suite "xt.event" :status "failure" :language "lua" :workflow-name "XTBench Core" :tests {:throw 0 :errored 0 :failed 1 :timeout 0 :passed 3 :skipped 0} :git {:sha "def456"} :run {:id 99 :attempt 1 :number 4}}] value (subject/aggregate-records "core" records context) missing (subject/aggregate-records "core" [] context)] [(select-keys value [:workflow-key :status :tests]) (select-keys missing [:status :workflow-key :error :jobs :tests :metrics-status]) (select-keys value [:git :workflow-name :run])]))}])

(Test/check [{:name "removes verbose failures from compact history jobs" :expected {:workflow-key "core" :jobs [{:status "success" :language "lua"}] :path "runs/core/1-1.json"} :test (fn [] (subject/history-entry "runs/core/1-1.json" {:workflow-key "core" :jobs [{:failures [{:namespace "sample"}] :status "success" :language "lua"}]}))}])

(Test/check [{:name "keeps rerun attempts distinct and applies retention" :expected [[[2 2] [2 1]] "runs/core/2-2.json" 2] :test (fn [] (let [record (fn [number attempt] {:status "success" :workflow-key "core" :tests {} :run {:attempt attempt :number number}}) index (-> {} (subject/update-index "runs/core/1-1.json" (record 1 1) 2) (subject/update-index "runs/core/2-1.json" (record 2 1) 2) (subject/update-index "runs/core/2-2.json" (record 2 2) 2)) runs (get-in index [:workflows "core" :runs])] [(mapv (fn [entry] [(get-in entry [:run :number]) (get-in entry [:run :attempt])]) runs) (get-in index [:workflows "core" :latest :path]) (count runs)]))}])

(Test/check [{:name "aggregates input artifacts and writes run, latest and index files" :expected [{:status "failure" :tests {:throw 0 :errored 0 :failed 1 :timeout 0 :passed 3 :skipped 0}} true true] :test (fn [] (let [input (fs/temp-directory "/" {:prefix "seedgen-metrics-input-"}) output (fs/temp-directory "/" {:prefix "seedgen-metrics-output-"}) job (fn [suite status passed failed] {:suite suite :status status :workflow-name "local" :tests {:throw 0 :errored 0 :failed failed :timeout 0 :passed passed :skipped 0} :run {:attempt 1 :number 3} :language "lua" :failure-counts {:throw 0 :errored 0 :failed failed :timeout 0}})] (try (subject/write-json! (path/join input "a.json") (job "xt.a" "success" 2 0)) (subject/write-json! (path/join input "b.json") (job "xt.b" "failure" 1 1)) (let [record (subject/merge-directory! input output "core")] [(select-keys record [:status :tests]) (fs/exists? (path/join output "latest" "core.json")) (fs/exists? (path/join output "index.json"))]) (finally (fs/delete input {:recursive? true :missing-ok? true}) (fs/delete output {:recursive? true :missing-ok? true})))))}])
