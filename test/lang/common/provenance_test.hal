(ns lang.common.provenance-test
  (:require [lang.common.provenance :as provenance]))

^{:refer lang.common.provenance/module-id}
(Test/check
 [{:name "reduces archived module maps to their stable identifier"
   :test (fn [] [(provenance/module-id {:id :fixture})
                 (provenance/module-id :fixture)])
   :expected [:fixture :fixture]}])

^{:refer lang.common.provenance/namespace-id}
(Test/check
 [{:name "normalizes loaded namespace handles while retaining unresolved values"
   :test (fn [] [(provenance/namespace-id 'std.foundation)
                 (provenance/namespace-id 'missing.namespace)
                 (provenance/namespace-id :fixture)])
   :expected ['std.foundation 'missing.namespace :fixture]}])

^{:refer lang.common.provenance/line-of}
(Test/check
 [{:name "finds explicit and nested archive source-line metadata"
   :test (fn [] [(provenance/line-of nil)
                 (provenance/line-of {:line 1})
                 (provenance/line-of {:entry {:line 2}})
                 (provenance/line-of {:form {:line 3}})])
   :expected [nil 1 2 3]}])

^{:refer lang.common.provenance/compact}
(Test/check
 [{:name "drops only nil provenance fields"
   :test (fn [] (provenance/compact {:lang/module :fixture
                                     :lang/line nil
                                     :lang/source false}))
   :expected {:lang/module :fixture :lang/source false}}])

^{:refer lang.common.provenance/frame}
(Test/check
 [{:name "retains canonical provenance and ignores unrecognized historical keys"
   :test (fn []
           [(provenance/frame {:lang/provenance {:lang/module {:id :inner}}
                               :lang/line 7
                               :lang/source :fixture})
            (provenance/frame {:tahto/module :legacy})])
   :expected [{:lang/module :inner :lang/line 7 :lang/source :fixture}
              {}]}])

^{:refer lang.common.provenance/provenance}
(Test/check
 [{:name "merges nonempty archive provenance frames in order"
   :test (fn [] (provenance/provenance {:lang/module :module}
                                        nil
                                        {}
                                        {:lang/line 8}))
   :expected {:lang/module :module :lang/line 8}}])

^{:refer lang.common.provenance/provenance-stack}
(Test/check
 [{:name "uses a supplied stack or creates one frame from plain provenance"
   :test (fn []
           [(provenance/provenance-stack {:lang/provenance-stack [{:lang/module :outer}
                                                                    {:lang/line 9}]})
            (provenance/provenance-stack {:lang/module :single})
            (provenance/provenance-stack nil)])
   :expected [[{:lang/module :outer} {:lang/line 9}]
              [{:lang/module :single}]
              []]}])

^{:refer lang.common.provenance/same-site?}
(Test/check
 [{:name "compares only stable source-site identity fields"
   :test (fn []
           [(provenance/same-site? {:lang/module :m :lang/line 1 :lang/source :a}
                                   {:lang/module :m :lang/line 1 :lang/source :b})
            (provenance/same-site? {:lang/module :m :lang/line 1}
                                   {:lang/module :m :lang/line 2})])
   :expected [true false]}])

^{:refer lang.common.provenance/append-frame}
(Test/check
 [{:name "adds new provenance frames and eliminates adjacent duplicate sites"
   :test (fn []
           [(provenance/append-frame [] {:lang/module :m :lang/line 1})
            (provenance/append-frame [{:lang/module :m :lang/line 1}]
                                     {:lang/module :m :lang/line 1})
            (provenance/append-frame [{:lang/module :m :lang/line 1}]
                                     {:lang/module :m :lang/line 2})])
   :expected [[{:lang/module :m :lang/line 1}]
              [{:lang/module :m :lang/line 1}]
              [{:lang/module :m :lang/line 1}
               {:lang/module :m :lang/line 2}]]}])

^{:refer lang.common.provenance/with-provenance}
(Test/check
 [{:name "attaches merged canonical provenance without changing empty input"
   :test (fn []
           [(provenance/with-provenance {:lang/provenance {:lang/module :outer}}
                                        {:lang/line 4})
            (provenance/with-provenance {:value :unchanged} nil)])
   :expected [{:lang/provenance {:lang/module :outer :lang/line 4}}
              {:value :unchanged}]}])

^{:refer lang.common.provenance/error-with-provenance}
(Test/check
 [{:name "wraps errors once with a canonical provenance stack"
   :test (fn []
           (let [error (provenance/error-with-provenance
                        "compile"
                        {:lang/module :fixture :lang/line 12}
                        (ex :generic {:reason :inner} :ex/message "inner"))]
             [(ex-message error)
              (select-keys (ex-data error)
                           [:reason :lang/module :lang/line :lang/wrapped :lang/cause-message])]))
   :expected ["compile: inner"
              {:reason :inner
               :lang/module :fixture
               :lang/line 12
               :lang/wrapped true
               :lang/cause-message "inner"}]}])

^{:refer lang.common.provenance/throw-with-provenance}
(Test/check
 [{:name "throws the same canonical provenance wrapper"
   :test (fn []
           (try
             (provenance/throw-with-provenance "compile" {:lang/module :fixture}
                                               (ex :generic {} :ex/message "inner"))
             :missing
             (catch error
               [(ex-message error) (:lang/module (ex-data error))])))
   :expected ["compile: inner" :fixture]}])
