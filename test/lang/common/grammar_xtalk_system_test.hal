(ns lang.common.grammar-xtalk-system-test
  (:require [lang.common.grammar-xtalk-system :as system]))

^{:refer lang.common.grammar-xtalk-system/xtalk-entry?}
(Test/check [{:name "recognizes XTalk entries and builds the declared profile tables"
              :test (fn [] [(system/xtalk-entry? {:op :x-add})
                            (system/xtalk-entry? [:x-add])
                            (system/xtalk-profiles)
                            (system/xtalk-areas)])
              :expected [true false
                         [:xtalk-common :xtalk-functional :xtalk-language-specific
                          :xtalk-hara.lang-link-specific :xtalk-runtime-specific]
                         [:common :functional :language-specific
                          :hara.lang-link-specific :runtime-specific]]}])

^{:refer lang.common.grammar-xtalk-system/xtalk-area-profiles}
(Test/check [{:name "maps areas, profiles, operations, and entries in both directions"
              :test (fn [] [(system/xtalk-area-profiles :common)
                            (system/xtalk-area-profiles :unknown)
                            [(system/member? (system/xtalk-profile-ops :xtalk-common) :x-add)
                             (system/member? (system/xtalk-profile-ops :xtalk-common) :x-obj-keys)]
                            (system/xtalk-op-profiles :x-add)
                            (select-keys (system/xtalk-op-entry :x-add) [:op :symbol :emit])
                            (system/xtalk-symbol-op 'x:add)
                            (select-keys (system/xtalk-symbol-entry 'x:add) [:op :emit])])
              :expected [[:xtalk-common] [] [true true] #{:xtalk-common}
                         {:op :x-add :symbol #{'x:add} :emit :macro}
                         :x-add {:op :x-add :emit :macro}]}])

^{:refer lang.common.grammar-xtalk-system/xtalk-op-requires}
(Test/check [{:name "calculates direct and transitive requirements with the collection helpers"
              :test (fn [] [(system/xtalk-op-requires :x-arr-map)
                            (system/xtalk-op-closure :x-file-read)
                            (system/xtalk-ops-profiles #{:x-add :x-arr-map})
                            (system/set-union #{:a} #{:b})
                            [(system/member? {:a 1} :a)
                             (system/member? #{:a} :b)
                             (system/set-subset? #{:a} #{:a :b})]])
              :expected [#{} #{:x-file-read :x-promise}
                         #{:xtalk-common :xtalk-functional}
                         #{:a :b} [true false true]]}])

^{:refer lang.common.grammar-xtalk-system/reserved-entry-for}
(Test/check [{:name "resolves hard-link polyfills while respecting concrete grammar overrides"
              :test (fn [] [(select-keys
                             (system/reserved-entry-for
                              {'x:obj-keys {:emit :macro}}
                              (system/xtalk-op-entry :x-obj-keys))
                             [:emit])
                            (system/xtalk-op-polyfill-symbol :x-obj-keys)
                            (system/xtalk-op-polyfill-symbol :x-obj-keys
                                                              {:reserved {'x:obj-keys {:emit :macro}}})
                            (system/xtalk-ops-polyfill-symbols #{:x-obj-keys :x-promise})
                            (system/xtalk-ops-polyfill-modules #{:x-obj-keys :x-promise})])
              :expected [{:emit :macro}
                         'xt.lang.common-data/obj-keys
                         nil
                         #{'xt.lang.common-data/obj-keys 'xt.lang.common-promise/promise}
                         #{'xt.lang.common-data 'xt.lang.common-promise}]}])

^{:refer lang.common.grammar-xtalk-system/scalar?}
(Test/check [{:name "scans scalar, nested, and hard-link XTalk forms without host state"
              :test (fn [] [(mapv system/scalar? [nil 'symbol :keyword "text" 1 true false '(x:add 1 2)])
                            (system/scan-node {:ops #{} :symbols #{}} '(x:add 1 2) nil)
                            (system/scan-xtalk
                             '(do (x:obj-keys data) (x:arr-map items f) (x:str-ends-with s suffix)))
                            (system/scan-xtalk '(do (tmpl:call v)) {'tmpl:call {:emit :hard-link}})])
              :expected [[true true true true true true true false]
                         {:ops #{:x-add} :symbols #{'x:add}}
                         {:ops #{:x-obj-keys :x-arr-map :x-str-ends-with}
                          :symbols #{'x:obj-keys 'x:arr-map 'x:str-ends-with}
                          :profiles #{:xtalk-common :xtalk-functional}
                          :polyfill-modules #{'xt.lang.common-data 'xt.lang.common-string}}
                         {:ops #{} :symbols #{} :profiles #{} :polyfill-modules #{} :template? true}]}])

^{:refer lang.common.grammar-xtalk-system/xtalk-grammar-supported-ops}
(Test/check [{:name "derives grammar support and missing profiles from reserved operations"
              :test (fn [] (let [reserved (into {}
                                                (map (fn [op]
                                                       [(symbol "xtest" (name op)) {:op op}])
                                                     (system/xtalk-profile-ops :xtalk-common)))]
                            [(system/xtalk-grammar-supported-ops
                              {:reserved {'x:add {:op :x-add} 'foo {:op :foo}}})
                             (system/xtalk-grammar-supported-profiles {:reserved reserved})
                             (system/xtalk-grammar-missing-profiles
                              {:reserved reserved}
                              [:xtalk-common :xtalk-functional])]))
              :expected [#{:x-add} [:xtalk-common] #{:xtalk-functional}]}])

^{:refer lang.common.grammar-xtalk-system/xtalk-library-profiles}
(Test/check [{:name "reports declared library requirements and no unclassified XTalk operations"
              :test (fn [] [(system/xtalk-library-profiles 'xtalk.lib.db.sql)
                            (system/xtalk-library-profiles 'unknown.library)
                            (system/xtalk-unclassified-ops)])
              :expected [#{:xtalk-common :xtalk-runtime-specific} #{} []]}])
