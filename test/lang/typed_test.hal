        (do
          (let [report (namespace-report
                         (load-ns
                           'tahto.model.spec-xtalk-typed-fixture))]
            [(:namespace report)
             (some
               (fn [migration-argument-0]
                 (=
                   'tahto.model.spec-xtalk-typed-fixture/find-user
                   (:function migration-argument-0)))
               (:functions report))]))
        (finally
          (intern
            'code.project
