(defn sample-context []
  (let [fn-def (types/make-fn-def
                 'sample
                 'lookup
                 [(types/make-arg 'id types/+str-type+ [])]
                 types/+int-type+
                 {}
                 []
                 nil)
        macro-def (types/make-fn-def
                    'sample
                    'expand
                    []
                    types/+unknown-type+
                    {:macro true}
                    []
                    nil)
        value-def (types/make-value-def
                    'sample
                    'Count
                    types/+int-type+
                    {}
                    3
                    nil)]
    (load-registry
      {'sample/lookup
       (assoc (types/make-registry-entry 'sample/lookup) :fn fn-def),
       'sample/expand
       (assoc
         (types/make-registry-entry 'sample/expand)
         :macro
         macro-def),
       'sample/Count
       (assoc
         (types/make-registry-entry 'sample/Count)
         :value
         value-def)})))

^{:refer lang.typed/load-analysis, :added "4.1"}
(fact
  "builds an isolated registry from parsed analysis and preserves the live registry"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do
      (let [spec (types/make-spec-def
                   'sample
                   'Role
                   types/+str-type+
                   {})
            analysis {:ns 'sample,
                      :specs [spec],
                      :functions [],
                      :macros [],
                      :values []}]
        (binding [types/*type-registry* (atom
                                          {'outside/value :sentinel})]
          (let [ctx (load-analysis analysis)]
            [(:domain ctx)
             (:analysis ctx)
             (-> (entry ctx 'sample/Role) :spec :name)
             (deref types/*type-registry*)])))))
  =>
  [:xtalk
   {:ns 'sample,
    :specs [(types/make-spec-def 'sample 'Role types/+str-type+ {})],
    :functions [],
    :macros [],
    :values []}
   "Role"
   {'outside/value :sentinel}])

^{:refer lang.typed/load-registry, :added "4.1"}
(fact
  "wraps an explicit registry without changing its identity"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do
      (let [registry {'sample/value :entry}
            ctx (load-registry registry)]
        [(:domain ctx) (Base/identical? registry (:registry ctx))])))
  =>
  [:xtalk true])

^{:refer lang.typed/with-context-registry, :added "4.1"}
(fact
  "exposes a context registry only for the callback and restores the prior registry"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do
      (binding [types/*type-registry* (atom {:outside true})]
        [(with-context-registry
           {:registry {:inside true}}
           (fn [] (deref types/*type-registry*)))
         (deref types/*type-registry*)])))
  =>
  [{:inside true} {:outside true}])

^{:refer lang.typed/entries, :added "4.1"}
(fact
  "returns every registry entry in a context"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do (set (map :symbol (entries (sample-context))))))
  =>
  '#{sample/expand sample/lookup sample/Count})

^{:refer lang.typed/entry, :added "4.1"}
(fact
  "returns a registry entry by fully-qualified symbol"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do
      (let [ctx (sample-context)]
        [(:symbol (entry ctx 'sample/lookup))
         (entry ctx 'sample/missing)])))
  =>
  '[sample/lookup nil])

^{:refer lang.typed/macro-def, :added "4.1"}
(fact
  "selects the macro declaration from a combined registry entry"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do
      (types/declaration-kind
        (macro-def (sample-context) 'sample/expand))))
  =>
  :macro)

^{:refer lang.typed/value-def, :added "4.1"}
(fact
  "selects the value declaration from a combined registry entry"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do
      (let [value (value-def (sample-context) 'sample/Count)]
        [(:name value)
         (:raw-value value)
         (types/type->data (:type value))])))
  =>
  ["Count" 3 {:kind :primitive, :name :xt/int}])

^{:refer lang.typed/missing-function!, :added "4.1"}
(fact
  "throws a structured missing-function error"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do (missing-function! 'sample/missing)))
  =>
  (throws-info {:type :typed/missing-function, :fn 'sample/missing}))

^{:refer lang.typed/missing-argument!, :added "4.1"}
(fact
  "throws a structured missing-argument error"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do (missing-argument! 'sample/lookup 'missing)))
  =>
  (throws-info
    {:type :typed/missing-argument, :fn 'sample/lookup, :arg 'missing}))

^{:refer lang.typed/function-def, :added "4.1"}
(fact
  "resolves functions by symbol and accepts an existing function definition"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do
      (let [ctx (sample-context)
            resolved (function-def ctx 'sample/lookup)]
        [(Base/identical? resolved (function-def ctx resolved))
         (:name resolved)])))
  =>
  [true "lookup"]
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do (function-def (sample-context) 'sample/missing)))
  =>
  (throws-info {:type :typed/missing-function, :fn 'sample/missing}))

^{:refer lang.typed/function-output, :added "4.1"}
(fact
  "returns the declared output type as portable data"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (do (function-output (sample-context) 'sample/lookup)))
  =>
  {:kind :primitive, :name :xt/int})

;; Additional contracts: caller metadata, both input arities, and reversible registry state.
(ns lang.typed-test)
^{:refer lang.typed/analysis->registry :id registry-isolation}
(fact "analysis builds an isolated registry without losing its source context"
 (binding [types/*type-registry* (atom {:baseline 1})]
  (let [spec (types/make-spec-def 'sample 'Role types/+str-type+ {:docstring "role"})
        analysis {:ns 'sample :specs [spec] :functions [] :macros [] :values [] :source "retained"}
        registry (analysis->registry analysis)
        ctx (load-analysis analysis)]
    [(set (keys registry)) (= spec (:spec (get registry 'sample/Role)))
     (= analysis (:analysis ctx)) (= registry (:registry ctx))
     (deref types/*type-registry*)]))
 => ['#{sample/Role} true true true {:baseline 1}])

^{:refer lang.typed/analysis->registry :id registry-failure-restores}
(fact "partial registration failure restores the original registry and propagates the error"
 (binding [types/*type-registry* (atom {:baseline 1})]
  (let [original lang.typed.xtalk-parse/register-types!
        original-meta (meta (var lang.typed.xtalk-parse/register-types!))
        observed (atom nil)]
   (try
    (intern 'lang.typed.xtalk-parse (with-meta 'register-types! original-meta)
      (fn [analysis]
       (reset! observed [analysis (deref types/*type-registry*)])
       (reset! types/*type-registry* {:partial true})
       (throw (ex :typed/test-registration {:stage :partial}))))
    [(try (analysis->registry {:ns 'fixture}) :unexpected
          (catch error (select-keys (ex-data error) [:ex/code :stage])))
     (deref observed) (deref types/*type-registry*)]
    (finally
      (intern 'lang.typed.xtalk-parse (with-meta 'register-types! original-meta) original)))))
 => [{:ex/code :typed/test-registration :stage :partial} [{:ns 'fixture} {}] {:baseline 1}])

^{:refer lang.typed/with-context-registry :id nested-registry-restoration}
(fact "nested context callbacks restore each boundary even on failure"
 (binding [types/*type-registry* (atom {:outside 1})]
  (let [seen (atom [])
        result (try
          (with-context-registry {:registry {:outer 2}}
            (fn []
              (swap! seen conj (deref types/*type-registry*))
              (try
                (with-context-registry {:registry {:inner 3}}
                  (fn []
                    (swap! seen conj (deref types/*type-registry*))
                    (throw (ex :typed/test-callback {:value 4}))))
                (finally (swap! seen conj (deref types/*type-registry*))))))
          :unexpected
          (catch error (select-keys (ex-data error) [:ex/code :value])))]
   [result (deref seen) (deref types/*type-registry*)]))
 => [{:ex/code :typed/test-callback :value 4}
     [{:outer 2} {:inner 3} {:outer 2}] {:outside 1}])

^{:refer lang.typed/register-spec-form! :id registration-alias-and-file}
(fact "registration resolves aliases and retains explicit template file provenance"
 (binding [types/*type-registry* (atom {})]
  (let [bare (with-template-meta nil (register-spec-form! 'sample/Bare :xt/int {:tag :bare}))
        aliased (with-template-meta {:file "fixture/caller.hal"}
                  (register-spec-form! 'sample/Alias 'types/Role {:tag :alias}
                    '{types domain.types}))]
   [(:file bare) (:spec-meta bare)
    (:file aliased) (types/type->data (:type aliased))
    (Base/identical? aliased (spec-def (load-registry) 'sample/Alias))]))
 => ["UNKNOWN" {:tag :bare} "fixture/caller.hal"
     '{:kind :named :name domain.types/Role} true])

^{:refer lang.typed/defspec.xt :id macro-doc-attrs-and-caller}
(fact "defspec macro preserves symbol metadata, attribute precedence, docs and caller namespace"
 (binding [types/*type-registry* (atom {})]
  (let [result (defspec.xt ^{:label :symbol :preserved true} Detailed
                 "a documented type" {:label :attribute} :xt/str)
        spec (spec-def (load-registry) 'lang.typed-test/Detailed)]
   [result (:ns spec) (:name spec)
    (select-keys (:spec-meta spec) [:label :preserved :docstring])
    (types/type->data (:type spec))]))
 => [nil "lang.typed-test" "Detailed"
     {:label :attribute :preserved true :docstring "a documented type"}
     {:kind :primitive :name :xt/str}])

^{:refer lang.typed/function-input :id input-arities-and-missing}
(fact "all-input mode retains names and missing-argument mode retains qualified function and argument"
 (let [ctx (sample-context)]
   [(function-input ctx 'sample/lookup)
    (try (function-input ctx 'sample/lookup 'absent) :unexpected
      (catch error (select-keys (ex-data error) [:type :fn :arg])))
    (try (function-def ctx nil) :unexpected
      (catch error (select-keys (ex-data error) [:type :fn])))])
 => [[{:name 'id :type {:kind :primitive :name :xt/str}}]
     {:type :typed/missing-argument :fn 'sample/lookup :arg 'absent}
     {:type :typed/missing-function :fn nil}])

^{:refer lang.typed/namespace-report :id namespace-filter-and-registry-context}
(fact "namespace reports include all functions without a namespace and filter by the declared namespace"
 (binding [types/*type-registry* (atom {:baseline 1})]
  (let [ctx (sample-context)
        own (assoc ctx :analysis {:ns 'sample})
        other (assoc ctx :analysis {:ns 'elsewhere})]
   [(:namespace (namespace-report ctx))
    (mapv :function (:functions (namespace-report ctx)))
    (:namespace (namespace-report own))
    (mapv :function (:functions (namespace-report own)))
    (:functions (namespace-report other))
    (deref types/*type-registry*)]))
 => [nil '[sample/lookup] 'sample '[sample/lookup] [] {:baseline 1}])

^{:refer lang.typed-test/sample-context :id sample-context-exact}
(fact "the isolated sample context contains exactly its function macro and value declarations"
 (let [ctx (sample-context)]
  [(:domain ctx)
   (into {} (map (fn [[sym value]] [sym (set (types/entry-kinds value))])
                 (seq (:registry ctx))))
   (:raw-value (value-def ctx 'sample/Count))])
 => [:xtalk '{sample/lookup #{:fn} sample/expand #{:macro} sample/Count #{:value}} 3])
