^{:refer lang.typed/namespace-report, :added "4.1"}
(fact
  "checks every function in an xtalk context namespace"
  (binding [types/*type-registry* (atom (deref types/*type-registry*))]
    (let [fixture-root (deref
                         (File/temp-directory
                           "test"
                           {:prefix ".typed-root-"}))
