(ns lang.core-test
  (:require [lang.core :as l]
            [lang.core.library :as library]))

^{:refer lang.core/with:library}
(Test/check [{:name "facade binding selects the supplied library and restores the prior binding"
              :test (fn []
                      (let [before (l/default-library)
                            local (library/library:create {})]
                        [(l/with:library [local]
                           [(Base/identical? local (l/default-library))
                            (Base/identical? local (l/runtime-library))
                            (into {} (l/get-snapshot local))])
                         (Base/identical? before (l/default-library))]))
              :expected [[true true {}] true]}])

^{:refer lang.core/script}
(Test/check [{:name "ordinary declaration preserves module and config"
              :test (fn [] (macroexpand-1 '(l/script :lua demo.module {:runtime :default})))
              :expected '(lang.core.script/script-fn :lua (quote demo.module) (quote {:runtime :default}))}])

^{:refer lang.core/script-}
(Test/check [{:name "test declaration publishes the current script owner"
              :test (fn [] (macroexpand-1 '(l/script- :js {:runtime :basic})))
              :expected '(lang.core.script/script-test :js (quote {:runtime :basic}))}])

^{:refer lang.core/script+}
(Test/check [{:name "tagged declaration preserves coordinates"
              :test (fn [] (macroexpand-1 '(l/script+ [:one :lua])))
              :expected '(lang.core.script/script-ext [:one :lua] {})}])

^{:refer lang.core/!}
(Test/check [{:name "tagged evaluation preserves caller and body"
              :test (fn []
                      (vec (take 4 (macroexpand-1 '(l/! [:one] (+ 1 2))))))
              :expected '[lang.core.script/script-ext-run (quote lang.core-test) :one (quote (+ 1 2))]}])

^{:refer lang.core/get-book}
(Test/check [{:name "core initializes the portable target books before script setup"
              :test (fn []
                      (mapv (fn [lang] (:lang (l/get-book (l/default-library) lang)))
                            [:xtalk :js :lua :python]))
              :expected [:xtalk :js :lua :python]}])
