(ns lang.typed.xtalk-common-test
  (:use code.test)
  (:require [lang.typed.xtalk-common :refer :all]))

(defn sample-spec []
  (make-spec-def 'sample.route 'User +str-type+ {:doc "user"}
                 {:file "sample.clj" :line 10 :column 5}))

(defn sample-fn []
  (make-fn-def 'sample.route 'find-user [(make-arg 'id +str-type+ [])] +str-type+ {} ['id] nil
               {:file "sample.clj" :line 12 :column 5}))

(defn sample-macro []
  (make-fn-def 'sample.route 'expand [(make-arg 'x +unknown-type+ [])] +unknown-type+ {:macro true} ['x] nil
               {:file "sample.clj" :line 14 :column 5}))

(defn sample-generator []
  (make-fn-def 'sample.route 'stream [] +unknown-type+ {:generator true} [] nil
               {:file "sample.clj" :line 16 :column 5}))

(defn sample-value []
  (make-value-def 'sample.route 'ScopeMap +int-type+ {:def true} {:a 1} nil
                  {:file "sample.clj" :line 18 :column 5}))

(defn populate! []
  (clear-registry!)
  (register-spec! 'sample.route/User (sample-spec))
  (register-function! 'sample.route/find-user (sample-fn))
  (register-macro! 'sample.route/expand (sample-macro))
  (register-value! 'sample.route/ScopeMap (sample-value)))

^{:refer lang.typed.xtalk-common/primitive-type, :added "4.1"}
(fact
  "builds primitive type maps"
  (do
    (clear-registry!)
    (try (primitive-type :xt/str) (finally (clear-registry!))))
  =>
  '{:kind :primitive, :name :xt/str})

^{:refer lang.typed.xtalk-common/snake-case-string, :added "4.1"}
(fact
  "normalizes dash names to snake case"
  (do
    (clear-registry!)
    (try (snake-case-string "route-path") (finally (clear-registry!))))
  =>
  "route_path")

^{:refer lang.typed.xtalk-common/maybe-type, :added "4.1"}
(fact
  "wraps maybe types"
  (do
    (clear-registry!)
    (try (maybe-type +str-type+) (finally (clear-registry!))))
  =>
  '{:kind :maybe, :item {:kind :primitive, :name :xt/str}})

^{:refer lang.typed.xtalk-common/union-type, :added "4.1"}
(fact
  "dedupes union members"
  (do
    (clear-registry!)
    (try
      (union-type [+str-type+ +str-type+ +int-type+])
      (finally (clear-registry!))))
  =>
  '{:kind :union,
    :types
    [{:kind :primitive, :name :xt/str}
     {:kind :primitive, :name :xt/int}]})

^{:refer lang.typed.xtalk-common/source-loc, :added "4.1"}
(fact
  "builds location maps from form metadata"
  (do
    (clear-registry!)
    (try
      [(source-loc (with-meta 'x {:line 10, :column 5}) "sample.clj")
       (source-loc nil)]
      (finally (clear-registry!))))
  =>
  '[{:file "sample.clj", :line 10, :column 5} {:file "UNKNOWN"}])

^{:refer lang.typed.xtalk-common/type-key, :added "4.1"}
(fact
  "builds namespaced type keys"
  (do
    (clear-registry!)
    (try
      [(type-key 'sample.route 'User) (type-key nil 'User)]
      (finally (clear-registry!))))
  =>
  '[sample.route/User User])

^{:refer lang.typed.xtalk-common/valid-key?, :added "4.1"}
(fact
  "accepts only namespaced symbols as registry keys"
  (do
    (clear-registry!)
    (try
      [(valid-key? 'sample.route/User) (valid-key? 'User)]
      (finally (clear-registry!))))
  =>
  [true false])

^{:refer lang.typed.xtalk-common/clear-registry!, :added "4.1"}
(fact
  "clears registry state"
  (do
    (clear-registry!)
    (try
      (do (populate!) (clear-registry!) (count (list-entries)))
      (finally (clear-registry!))))
  =>
  0)

^{:refer lang.typed.xtalk-common/make-registry-entry, :added "4.1"}
(fact
  "creates blank registry entries"
  (do
    (clear-registry!)
    (try
      (into {} (make-registry-entry 'sample.route/User))
      (finally (clear-registry!))))
  =>
  '{:symbol sample.route/User,
    :spec nil,
    :fn nil,
    :macro nil,
    :value nil})

^{:refer lang.typed.xtalk-common/get-entry, :added "4.1"}
(fact
  "gets registry entries"
  (do
    (clear-registry!)
    (try
      (do (populate!) (not (nil? (get-entry 'sample.route/User))))
      (finally (clear-registry!))))
  =>
  true)

^{:refer lang.typed.xtalk-common/entry-declarations, :added "4.1"}
(fact
  "extracts present declarations from an entry"
  (do
    (clear-registry!)
    (try
      (do
        (populate!)
        (keys (entry-declarations (get-entry 'sample.route/User))))
      (finally (clear-registry!))))
  =>
  '(:spec))

^{:refer lang.typed.xtalk-common/entry-kinds, :added "4.1"}
(fact
  "lists declaration kinds"
  (do
    (clear-registry!)
    (try
      (do
        (populate!)
        (vec (entry-kinds (get-entry 'sample.route/find-user))))
      (finally (clear-registry!))))
  =>
  [:fn])

^{:refer lang.typed.xtalk-common/entry-primary, :added "4.1"}
(fact
