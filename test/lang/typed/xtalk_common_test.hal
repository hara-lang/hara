^{:refer lang.typed.xtalk-common/register-entry!, :added "4.1"}
(fact
  "register-entry rejects invalid keys"
  (do
    (clear-registry!)
    (try
      (try
        (register-entry! 'User :spec {})
        false
        (catch ex (= 'User (-> ex ex-data :key))))
      (finally (clear-registry!))))
  =>
  true)

^{:refer lang.typed.xtalk-common/register-spec!, :added "4.1"}
(fact
  "registers specs"
  (do
    (clear-registry!)
    (try
      (do
        (clear-registry!)
        (register-spec! 'sample.route/User (sample-spec))
        (not (nil? (get-spec 'sample.route/User))))
      (finally (clear-registry!))))
  =>
  true)

