(ns lang.typed.xtalk-env-test
  (:use code.test)
  (:require [lang.typed.xtalk-common :as types]
            [lang.typed.xtalk-env :refer :all]
            [lang.typed.xtalk-parse :as parse]))

(def +ctx+
 {:ns 'sample.route,
  :aliases '{k xt.lang.common-lib},
  :infer
  (fn [form ctx]
    (require 'lang.typed.xtalk-infer)
    ((deref (resolve 'lang.typed.xtalk-infer/infer-type)) form ctx))})

(def +user-record+
  {:kind :record
   :fields [{:name "id" :type types/+str-type+ :optional? false}
            {:name "count" :type types/+int-type+ :optional? false}]})

(defn fixture-register! []
  (types/clear-registry!)
  (parse/register-types! (parse/analyze-namespace 'tahto.model.spec-xtalk-typed-fixture)))

^{:refer lang.typed.xtalk-env/maybe-register-function!, :added "4.1"}
(fact
  "registers functions lazily from namespaces"
  (let [path "test/tahto/model/spec_xtalk_typed_fixture.hal"
        parent-existed (deref (File/exists? "test/tahto"))
        model-existed (deref (File/exists? "test/tahto/model"))
        baseline (deref types/*type-registry*)]
    (when (deref (File/exists? path))
      (throw
        (ex
          :conflict
          {:path path}
          :ex/message
          "Refusing to overwrite fixture source")))
    (try
      (deref
        (File/write
          path
          (String/encode-utf8
            "(ns tahto.model.spec-xtalk-typed-fixture\n  (:require [tahto.core :as l]\n            [tahto.typed :refer [defspec.xt]]))\n\n(l/script :xtalk\n  {:require [[xt.lang.common-lib :as k]]})\n\n(defspec.xt User\n  [:xt/record\n   [\"id\" :xt/str]\n   [\"name\" :xt/str]])\n\n(defspec.xt UserMap\n  [:xt/dict :xt/str User])\n\n(defspec.xt find-user\n  [:fn [UserMap :xt/str] [:xt/maybe User]])\n\n(defn.xt find-user\n  [users id]\n  (return (xt/x:get-key users id)))\n\n(defn.xt ^{:- [User]}\n  wrong-user-name\n  [user]\n  (return \"not-a-user\"))\n\n(defn.xt ^{:- [[:xt/maybe User]]}\n  find-user-wrong-key\n  [UserMap users\n   :xt/int id]\n  (return (-/find-user users id)))\n")
          {:mode :create, :parents? true}))
      (do
        (types/clear-registry!)
        (:name
          (maybe-register-function!
            'tahto.model.spec-xtalk-typed-fixture/find-user)))
      (finally
        (reset! types/*type-registry* baseline)
        (deref (File/delete path {:missing-ok? true}))
        (when (not model-existed)
          (deref (File/delete "test/tahto/model" {:missing-ok? true})))
        (when (not parent-existed)
          (deref (File/delete "test/tahto" {:missing-ok? true}))))))
  =>
  "find-user")

^{:refer lang.typed.xtalk-env/lookup-symbol-type, :added "4.1"}
(fact
  "looks up env or registered symbol types"
  (let [path "test/tahto/model/spec_xtalk_typed_fixture.hal"
        parent-existed (deref (File/exists? "test/tahto"))
        model-existed (deref (File/exists? "test/tahto/model"))
        baseline (deref types/*type-registry*)]
    (when (deref (File/exists? path))
      (throw
        (ex
          :conflict
          {:path path}
          :ex/message
          "Refusing to overwrite fixture source")))
    (try
      (deref
        (File/write
          path
          (String/encode-utf8
            "(ns tahto.model.spec-xtalk-typed-fixture\n  (:require [tahto.core :as l]\n            [tahto.typed :refer [defspec.xt]]))\n\n(l/script :xtalk\n  {:require [[xt.lang.common-lib :as k]]})\n\n(defspec.xt User\n  [:xt/record\n   [\"id\" :xt/str]\n   [\"name\" :xt/str]])\n\n(defspec.xt UserMap\n  [:xt/dict :xt/str User])\n\n(defspec.xt find-user\n  [:fn [UserMap :xt/str] [:xt/maybe User]])\n\n(defn.xt find-user\n  [users id]\n  (return (xt/x:get-key users id)))\n\n(defn.xt ^{:- [User]}\n  wrong-user-name\n  [user]\n  (return \"not-a-user\"))\n\n(defn.xt ^{:- [[:xt/maybe User]]}\n  find-user-wrong-key\n  [UserMap users\n   :xt/int id]\n  (return (-/find-user users id)))\n")
          {:mode :create, :parents? true}))
      (do
        (fixture-register!)
        [(lookup-symbol-type
           'user-id
           {:env '{user-id {:kind :primitive, :name :xt/str}},
            :ns 'sample.route,
            :aliases {},
            :infer
            (fn [form ctx]
              (require 'lang.typed.xtalk-infer)
              ((deref (resolve 'lang.typed.xtalk-infer/infer-type))
                form
                ctx))})
         (types/type->data (lookup-symbol-type 'x:add +ctx+))
         (types/type->data
           (lookup-symbol-type
             'tahto.model.spec-xtalk-typed-fixture/find-user
             +ctx+))])
      (finally
        (reset! types/*type-registry* baseline)
        (deref (File/delete path {:missing-ok? true}))
        (when (not model-existed)
          (deref (File/delete "test/tahto/model" {:missing-ok? true})))
        (when (not parent-existed)
          (deref (File/delete "test/tahto" {:missing-ok? true}))))))
  =>
  '[{:kind :primitive, :name :xt/str}
    {:kind :fn,
     :inputs
     [{:kind :primitive, :name :xt/num}
      {:kind :primitive, :name :xt/num}],
     :output {:kind :primitive, :name :xt/num}}
    {:kind :fn,
     :inputs
     [{:kind :named,
       :name tahto.model.spec-xtalk-typed-fixture/UserMap}
      {:kind :primitive, :name :xt/str}],
     :output
     {:kind :maybe,
      :item
      {:kind :named,
       :name tahto.model.spec-xtalk-typed-fixture/User}}}])

^{:refer lang.typed.xtalk-env/binding-decl :added "4.1"}
(fact "extracts binding declarations"
  [(binding-decl 'value +ctx+)
   (binding-decl '(:xt/int count) +ctx+)]
  => '[{:symbol value :type nil}
        {:symbol count :type {:kind :primitive :name :xt/int}}])

^{:refer lang.typed.xtalk-env/dynamic-assignment-target? :added "4.1"}
(fact "recognizes dynamic assignment targets"
  [(dynamic-assignment-target? '(x:get-key acc tag))
   (dynamic-assignment-target? 'count)]
  => [true false])

^{:refer lang.typed.xtalk-env/map-binding-updates :added "4.1"}
(fact "builds env updates for map destructuring"
  (map-binding-updates '{:keys [id] :strs [name] :syms [flag]}
                       {:kind :record
                        :fields [{:name "id" :type types/+str-type+ :optional? false}
                                 {:name "name" :type types/+str-type+ :optional? false}
                                 {:name "flag" :type types/+bool-type+ :optional? false}]}
                       +ctx+)
  => '{id {:kind :primitive :name :xt/str}
       name {:kind :primitive :name :xt/str}
       flag {:kind :primitive :name :xt/bool}})

^{:refer lang.typed.xtalk-env/binding-updates :added "4.1"}
(fact "builds env updates for binding targets"
  [(binding-updates '[a b] {:kind :tuple :types [types/+str-type+ types/+int-type+]} +ctx+)
   (binding-updates '#{id} +user-record+ +ctx+)]
  => '[{a {:kind :primitive :name :xt/str}
         b {:kind :primitive :name :xt/int}}
        {id {:kind :primitive :name :xt/str}}])

^{:refer lang.typed.xtalk-env/lookup-symbol-type :id lookup-boundaries}
(fact "unknown namespace lookup retains the registry and local bindings take precedence"
 (let [baseline (deref types/*type-registry*)]
  (try
   (types/clear-registry!)
   [(maybe-register-function! 'unqualified)
    (maybe-register-function! 'missing.env.fixture/fn)
    (lookup-symbol-type 'missing.env.fixture/fn +ctx+)
    (lookup-symbol-type 'x:add (assoc +ctx+ :env {'x:add types/+str-type+}))
    (= (deref types/*type-registry*) (do (types/clear-registry!) (deref types/*type-registry*)))]
   (finally (reset! types/*type-registry* baseline))))
 => [nil nil types/+unknown-type+ types/+str-type+ true])

^{:refer lang.typed.xtalk-env/binding-updates :id binding-boundaries}
(fact "binding updates preserve tuple gaps, array items, symbol targets and unsupported targets"
 [(binding-updates '[a b] {:kind :tuple :types [types/+str-type+]} +ctx+)
  (binding-updates '[a b] {:kind :array :item types/+int-type+} +ctx+)
  (binding-updates 'value types/+bool-type+ +ctx+)
  (binding-updates 1 types/+int-type+ +ctx+)
  (map-binding-updates {} +user-record+ +ctx+)
  (binding-decl 1 +ctx+)
  (dynamic-assignment-target? '(other acc tag))]
 => [{'a types/+str-type+ 'b types/+unknown-type+}
     {'a types/+int-type+ 'b types/+int-type+}
     {'value types/+bool-type+} nil nil nil false])
