(ns lang.typed.xtalk-ops-test
  (:use code.test)
  (:require [lang.typed.xtalk-common :as types]
            [lang.typed.xtalk-ops :refer :all]))

^{:refer lang.typed.xtalk-ops/op-table-vars :added "4.1"}
(fact "finds grammar op table vars"
  (pos? (count (op-table-vars 'lang.base.grammar-spec)))
  => true)

^{:refer lang.typed.xtalk-ops/op-entries :added "4.1"}
(fact "collects builtin op entries"
  (boolean (some (fn [migration-argument-0] (has? ((keyword "symbol") migration-argument-0) (quote x:get-key))) (op-entries)))
  => true)

^{:refer lang.typed.xtalk-ops/canonical-symbol-from-entry :added "4.1"}
(fact "prefers canonical x symbols from op entries"
  (canonical-symbol-from-entry {:emit :alias
                                :raw 'xt.lang.common-lib/get-key
                                :symbol #{'xt.lang.common-lib/get-key 'x:get-key}})
  => 'x:get-key)

^{:refer lang.typed.xtalk-ops/builtin-entry :added "4.1"}
(fact "looks up builtin entries"
  [(has? (builtin-entry 'x:get-key) :symbol)
   (has? (builtin-entry 'if) :symbol)]
  => [true true])

^{:refer lang.typed.xtalk-ops/canonical-entry :added "4.1"}
(fact "augments entries with canonical symbol"
  (:canonical-symbol (canonical-entry 'x:get-key))
  => 'x:get-key)

^{:refer lang.typed.xtalk-ops/canonical-symbol :added "4.1"}
(fact "returns canonical builtin symbols when indexed"
  [(canonical-symbol 'x:get-key)
   (canonical-symbol 'xt.lang.common-lib/get-key)
   (canonical-symbol 'xt.lang.common-lib/len)]
  => '[x:get-key x:get-key x:len])

^{:refer lang.typed.xtalk-ops/op-arglists :added "4.1"}
(fact "exposes builtin op arglists from op-spec"
  (op-arglists (canonical-entry 'x:get-key))
  => '([obj key] [obj key default]))

^{:refer lang.typed.xtalk-ops/op-type-forms :added "4.1"}
(fact "extracts singular and plural type forms from op-spec"
  [(op-type-forms (canonical-entry 'x:add))
   (op-type-forms {:op-spec {:types [[:fn [:xt/num] :xt/num]
                                     [:fn [:xt/str] :xt/str]]}})
   (op-type-forms {:op-spec {:arglists '([value])}})
   (op-type-forms {})]
  => '([[:fn [:xt/num :xt/num] :xt/num]]
        [[:fn [:xt/num] :xt/num]
         [:fn [:xt/str] :xt/str]]
        []
        []))

^{:refer lang.typed.xtalk-ops/op-types :added "4.1"}
(fact "normalizes builtin op types from op-spec"
  (mapv types/type->data (op-types (canonical-entry 'x:add)))
  => '[{:kind :fn
         :inputs [{:kind :primitive :name :xt/num}
                  {:kind :primitive :name :xt/num}]
         :output {:kind :primitive :name :xt/num}}])

^{:refer lang.typed.xtalk-ops/builtin-type :added "4.1"}
(fact "returns callable builtin types when op-spec declares them"
  (types/type->data (builtin-type 'x:len))
  => '{:kind :fn
       :inputs [{:kind :primitive :name :xt/any}]
       :output {:kind :primitive :name :xt/int}})

^{:refer lang.typed.xtalk-ops/builtin? :added "4.1"}
(fact "detects builtin operators"
  [(builtin? 'x:get-key)
   (builtin? 'sample.route/missing)]
  => [true false])
^{:refer lang.typed.xtalk-ops/+op-source-namespaces+}
(fact "builtin tables retain original source grouping and order"
 +op-source-namespaces+
 => '[lang.base.grammar-spec lang.base.grammar-macro lang.base.grammar-xtalk])
^{:refer lang.typed.xtalk-ops/+legacy-op-aliases+}
(fact "the complete original legacy symbol table is retained"
 +legacy-op-aliases+
 => '{xt.lang.common-lib/len x:len
      xt.lang.common-lib/arr-clone x:arr-clone
      xt.lang.common-lib/first x:first
      xt.lang.common-lib/second x:second
      xt.lang.common-lib/get-key x:get-key
      xt.lang.common-lib/obj-keys x:obj-keys
      xt.lang.common-lib/json-encode x:json-encode
      xt.lang.common-lib/json-decode x:json-decode
      xt.lang.common-lib/cat x:cat
      xt.lang.common-lib/fn? x:is-function?
      xt.lang.common-lib/arr? x:is-array?
      xt.lang.common-lib/obj? x:is-object?})
^{:refer lang.typed.xtalk-ops/+op-index+}
(fact "the deferred index retains all original lookup tables and memoizes its value"
 (let [index (deref +op-index+)]
  [(Base/type +op-index+) (IRealize/realized? +op-index+)
   (set (keys index))
   (= index (deref +op-index+))
   (= (get-in index [:by-symbol 'x:get-key]) (builtin-entry 'x:get-key))])
 => [:std.native.Delay true #{:entries :by-symbol :by-raw} true true])
^{:refer lang.typed.xtalk-ops/op-table-vars :id native-var-discovery}
(fact "namespace traversal returns the actual math table Var"
 (boolean (some (fn [value] (= 'lang.base.grammar-spec/+op-math+ (var-sym value)))
                (op-table-vars 'lang.base.grammar-spec)))
 => true)
^{:refer lang.typed.xtalk-ops/builtin-entry :id builtin-alias-boundaries}
(fact "qualified shorthand and legacy aliases resolve without inventing unknown entries"
 [(canonical-symbol 'xt/x:get-key)
  (canonical-symbol 'xtd/get-key)
  (canonical-symbol 'xt.lang.common-lib/get-key)
  (builtin-entry nil)
  (builtin-entry :missing)]
 => '[x:get-key x:get-key x:get-key nil nil])
^{:refer lang.typed.xtalk-ops/canonical-symbol-from-entry :id canonical-selection-boundaries}
(fact "canonical selection prefers x symbols and sorts its ordinary fallback"
 [(canonical-symbol-from-entry {:symbol #{'z 'a}})
  (canonical-symbol-from-entry {:symbol #{'a 'x:z 'x:b}})
  (canonical-symbol-from-entry {:symbol #{}})]
 => '[a x:b nil])
^{:refer lang.typed.xtalk-ops/op-type-forms :id type-precedence-boundary}
(fact "plural type specifications take precedence over singular specifications"
 (op-type-forms {:op-spec {:types [[:fn [:xt/str] :xt/str]]
                          :type [:fn [:xt/int] :xt/int]}})
 => [[:fn [:xt/str] :xt/str]])
^{:refer lang.typed.xtalk-ops/builtin-type :id unknown-type-boundary}
(fact "unknown operators have no inferred builtin type"
 (builtin-type 'sample.route/missing) => nil)
