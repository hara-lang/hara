(ns hara.script-math-python-probe-test
  (:require [lang.core :as l])
  (:use code.test))

(l/script- :python
  {:runtime :basic
   :test-mode true
   :require [[xt.lang.common-math :as xtm]
             [xt.lang.spec-base :as xt]]})

(fact:global
 {:setup [(l/rt:restart)]
  :teardown [(l/rt:stop)]})

(fact "starts the common math Python graph"
  (!.py (xtm/abs -5))
  => 5)
