(ns hara.command-test
  (:require [hara.command]))

^{:refer hara.command/main}
(Test/check
 [{:name "publishes the lazy command entrypoint"
   :test (fn []
           [(hara.command/main ["--version"])
            (hara.command/main ["run" "hara.command.core"])
            (hara.command/main ["build"])])
   :expected [{:stdout "hara 0.1.0\n" :stderr "" :exit 0}
              {:stdout "Usage: hara [--version|help|headless|run NAMESPACE [ARGS...]|test [SELECTOR...]|package <check|sync|pull|add|remove|update|search|info>|lifecycle <phase>|goal PLUGIN ENTRY|deploy [plan|stage|build] [--root PATH]|specs test TARGET]\n"
               :stderr ""
               :exit 0}
              {:stdout "" :stderr ":command/unknown-route: unknown command: build\n" :exit 2}]}])
