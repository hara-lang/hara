(ns hara.command.manage-test
  (:use code.test)
  (:require [hara.command.manage :as command]))

^{:refer hara.command.manage/response}
(Test/register
 {:desc "routes parser failures through the native command response envelope"
  :test (fn [] (select-keys (command/response {:arguments {:argv ["unknown"]}}) [:stdout :exit]))
  :expected {:stdout "" :exit 2}})
