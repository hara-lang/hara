(ns hara.command.doc-test
  (:require [hara.command.doc :as command]))

^{:refer hara.command.doc/response}
(Test/check
 [{:name "publishes the code.doc CLI response through the hara command namespace"
   :test (fn [] (select-keys (command/response {:arguments {:argv ["template-init"]}})
                              [:stderr :exit]))
   :expected {:stderr "" :exit 0}}])
