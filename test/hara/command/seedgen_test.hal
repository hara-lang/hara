(ns hara.command.seedgen-test
  (:require [hara.command.seedgen :as command]))

^{:refer hara.command.seedgen/response}
(Test/check
 [{:name "returns a CLI error envelope for an unknown seedgen command"
   :test (fn [] (let [result (command/response
                              {:arguments {:argv ["missing"]}
                               :options {:project {:root "/tmp/project"
                                                   :source-paths []
                                                   :test-paths []
                                                   :seedgen/records []}}})]
                 [(:stdout result)
                  (= 2 (:exit result))
                  (str/ends-with? (:stderr result) "\n")]))
   :expected ["" true true]}])
