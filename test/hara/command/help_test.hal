(ns hara.command.help-test
  (:require [hara.command.help :as help]))

^{:refer hara.command.help/response}
(Test/check
 [{:name "creates the command usage response"
   :test (fn [] (help/response {}))
   :expected {:stdout "Usage: hara [--version|help|headless|run NAMESPACE [ARGS...]|test [SELECTOR...]|package <check|sync|pull|add|remove|update|search|info>|lifecycle <phase>|goal PLUGIN ENTRY|deploy [plan|stage|build] [--root PATH]|specs test TARGET]\n"
              :stderr ""
              :exit 0}}])
