(ns hara.command.test-test
  (:require [hara.command.test :as test]))

(defn cleanup
  []
  (deref (File/delete "/.hara/test/latest.edn" {:missing-ok? true}))
  (deref (File/delete "/.hara/test" {:missing-ok? true}))
  (deref (File/delete "/.hara" {:missing-ok? true})))

^{:refer hara.command.test/response}
(Test/check
 [{:name "forwards a native parsed request to the code.test response"
   :test (fn []
           (try
             (select-keys (test/response {:arguments {:argv []}}) [:stderr :exit])
             (finally (cleanup))))
   :expected {:stderr "" :exit 0}}])
