(ns db.postgres.provider-test
  (:require [db.protocol :as protocol]
            [db.postgres.connection :as connection]
            [db.postgres.native :as native]))

(def postgres-connection
  (connection/PostgresConnection 7 :postgresql :postgres :native ["sql"] nil nil))

^{:refer db.postgres.native/provider-options}
(Test/check
 [{:name "makes the native PostgreSQL provider selection explicit"
   :test (fn [] [(native/provider-options {:host "database"})
                 (protocol/db-provider postgres-connection)
                 (connection/provider-descriptor postgres-connection)])
   :expected [{:host "database" :provider :postgres}
              :postgres
              {:provider/id :postgres :provider/engine :postgresql
               :provider/capabilities ["sql"]}]}])
