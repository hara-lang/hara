(ns tool.migrate.walk-test
  (:require [tool.migrate :as migrate]))

(Test/check
 [{:name "walks a staged tree"
   :test (fn [] (count (deref (File/walk "test-temp/foundation-base/src/tahto/core"))))
   :expected 34}])

(Test/check
 [{:name "resolves staged root"
   :test (fn [] (str (File/resolve "test-temp/foundation-base" "")))
   :expected "/Users/zcaudate/Development/greenways/workspace/technology/hara/test-temp/foundation-base"}])
