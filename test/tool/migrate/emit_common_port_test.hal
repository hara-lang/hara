(ns tool.migrate.emit-common-port-test
  (:require [tool.migrate :as migrate]))

(Test/check
 [{:name "migrates emit-common facts through tool.migrate"
   :test (fn []
           (count
            (migrate/foundation-lang-staged-apply-files
             "."
             "test-temp/foundation-base"
             ["test/tahto/base/emit_common_test.clj"])))
   :expected 1}])
