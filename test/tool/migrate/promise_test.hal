(ns tool.migrate.promise-test)

(Test/check
 [{:name "reads staged source through a promise"
   :test (fn []
           (let [value (deref
                        (IPromise/then
                         (File/read "test-temp/foundation-base/src/tahto/core/pointer.clj")
                         (fn [bytes] (count bytes))))]
             (> value 0)))
   :expected true}])
