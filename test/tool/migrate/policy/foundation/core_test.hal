(ns tool.migrate.policy.foundation.core-test
  (:use code.test)
  (:require [tool.migrate.policy.foundation.core :as core]
            [std.fs :as fs]))


   ^{:refer tool.migrate.policy.foundation.core/plan}
   (fact "empty migration plans are valid"
     (let [result (core/plan {:migration :lang.model/v1 :units []})]
       [(:write result) (:records result) (empty? (:diagnostics result))])
     => [nil [] true])

   ^{:refer tool.migrate.policy.foundation.core/rewrite-requires}
   (fact "rewrite-requires emits only the current native Work frontend requires"
     (let [canonical (core/rewrite-requires "(:require [std.task :as task] [std.work :as work])")
           retired "[std.work.template.task :as task]"]
       [(str/includes? canonical "[work.flow.task :as task]")
        (str/includes? canonical "[work.flow :refer [def.work]]")
        (str/includes? canonical "[work.core :as work]")
        (not (str/includes? canonical retired))])
     => [true true true true])

   ^{:refer tool.migrate.policy.foundation.core/normalize-foundation-source}
   (fact "normalize-foundation-source uses preloaded Foundation names"
     (let [source "(ns demo.core (:require [std.foundation :as h] [std.foundation :as walk])) (defn apply-value [value] (h/apply-with value (walk/prewalk identity)))"
           output (core/normalize-foundation-source source)]
       [(str/includes? output "apply-with")
        (str/includes? output "prewalk")
        (not (str/includes? output "[std.foundation :as h]"))
        (not (str/includes? output "[std.foundation :as walk]"))])
     => [true true true true])

   ^{:refer tool.migrate.policy.foundation.core/migrate-foundation-common-test-source}
   (fact "migrate-foundation-common-test-source uses builtin foundation names"
     (let [result (core/migrate-foundation-common-test-source
                   "(ns demo.core (:require [std.foundation :as h] [std.foundation :as walk] [clojure.string :as str])) (fact value (= 1 (h/apply-with 1 (walk/prewalk identity)))) (str/trim \" value \")"
                   "demo.core-test")
           output (:after result)]
       [(str/includes? output "(apply-with")
        (str/includes? output "(prewalk")
        (not (str/includes? output "[std.foundation :as h]"))
        (not (str/includes? output "[std.foundation :as walk]"))
        (not (str/includes? output "h/apply-with"))
        (not (str/includes? output "walk/prewalk"))
        (not (str/includes? output "[clojure.string :as str]"))
        (str/includes? output "str/trim")
        (not (str/includes? output "(pr-str"))])
     => [true true true true true true true true true])

   ^{:refer tool.migrate.policy.foundation.core/migrate-source}
   (fact "migrate-source applies builtin alias normalization after policy edits"
     (let [result (core/migrate-source
                   "(ns demo.core (:require [std.foundation :as h] [std.foundation :as walk])) (defn apply-value [value] (h/apply-with value (walk/prewalk identity))) (def value {:polis/source :polis/value})")
           output (:after result)]
       [(= true (:changed result))
        (str/includes? output "apply-with")
        (str/includes? output "prewalk")
        (not (str/includes? output "[std.foundation :as h]"))
        (not (str/includes? output "[std.foundation :as walk]"))
        (str/includes? output ":lang/source")
        (str/includes? output ":lang/value")])
     => [true true true true true true true])

   ^{:refer tool.migrate.policy.foundation.core/lang-model-v1-test-source-path}
   (fact "model test sources follow the versioned test tree"
     (core/lang-model-v1-test-source-path "src/tahto/model/spec_c.clj")
     => "test/tahto/model/spec_c.clj")

   ^{:refer tool.migrate.policy.foundation.core/route-lang-model-v1-namespace}
   (fact "model namespaces route from reference and legacy names"
     [(core/route-lang-model-v1-namespace 'tahto.model.spec-c)
      (core/route-lang-model-v1-namespace 'lang.model.spec-c)
      (core/route-lang-model-v1-namespace 'lang.model.v1.spec-c)
      (core/route-lang-model-v1-namespace 'demo.core)]
     => ["lang.model.v1.spec-c" "lang.model.v1.spec-c" "lang.model.v1.spec-c" "demo.core"])

   ^{:refer tool.migrate.policy.foundation.core/route-lang-model-v1-path}
   (fact "model source and test paths route without changing target paths"
     [(core/route-lang-model-v1-path "src/tahto/model/spec_c.clj")
      (core/route-lang-model-v1-path "test/tahto/model/spec_c.clj")
      (core/route-lang-model-v1-path "src/lang/model/v1/spec_c.hal")
      (core/route-lang-model-v1-path "docs/spec_c.clj")]
     => ["src/lang/model/v1/spec_c.hal" "test/lang/model/v1/spec_c.hal" "src/lang/model/v1/spec_c.hal" "docs/spec_c.hal"])

   ^{:refer tool.migrate.policy.foundation.core/lang-model-v1-source-namespace}
   (fact "model source paths produce canonical reference namespaces"
     [(core/lang-model-v1-source-namespace "src/tahto/model/spec_c.clj")
      (core/lang-model-v1-source-namespace "src/tahto/model/sql/spec_common/form_defn.clj")]
     => ["tahto.model.spec-c" "tahto.model.sql.spec-common.form-defn"])

   ^{:refer tool.migrate.policy.foundation.core/lang-model-v1-unit}
   (fact "model units retain provenance while routing targets"
     (let [unit (core/lang-model-v1-unit
                 "src/tahto/model/spec_c.clj"
                 "(ns tahto.model.spec-c)"
                 {:source/namespace 'tahto.model.spec-c :language :c :status :pending})]
       [(:path unit) (:target/path unit) (:target/namespace unit) (:kind unit)
        (:language unit) (:create unit) (:move unit)])
     => ["src/tahto/model/spec_c.clj" "src/lang/model/v1/spec_c.hal"
         "lang.model.v1.spec-c" :source :c true true])

   ^{:refer tool.migrate.policy.foundation.core/lang-model-v1-unit-for}
   (fact "model inventory lookup distinguishes known and unknown paths"
     (let [known (core/lang-model-v1-unit-for "src/tahto/model/spec_glsl.clj")
           c-unit (core/lang-model-v1-unit-for "src/tahto/model/spec_c.clj")]
       [(:id known) (:status known) (:status c-unit)
        (nil? (core/lang-model-v1-unit-for "src/tahto/model/missing.clj"))])
     => ["spec_glsl" :ported :ported true])

   ^{:refer tool.migrate.policy.foundation.core/lang-model-v1-inventory}
   (fact "model inventory includes all planned source-owned units"
     (let [inventory (core/lang-model-v1-inventory)]
       [(count inventory) (:target/path (first inventory))
        (:target/namespace (first inventory)) (:target/namespace (last inventory))
        (count (filter (fn [unit] (= :pending (:status unit))) inventory))])
     => [39 "src/lang/model/v1/spec_xtalk.hal"
         "lang.model.v1.spec-xtalk" "lang.model.v1.spec-xtalk.fn-scheme" 7])

   ^{:refer tool.migrate.policy.foundation.core/rewrite-lang-model-v1-source}
   (fact "model rewrite preserves canonical names and is idempotent"
     (let [source "(ns tahto.model.spec-c (:require [tahto.base.emit :as emit] [clojure.string :as str]))"
           output (core/rewrite-lang-model-v1-source source)]
       [(str/includes? output "lang.model.v1.spec-c")
        (str/includes? output "lang.base.emit")
        (not (str/includes? output "[clojure.string :as str]"))
        (not (str/includes? output "std.foundation.string"))
        (= output (core/rewrite-lang-model-v1-source output))])
     => [true true true true true])

   ^{:refer tool.migrate.policy.foundation.core/lang-model-v1-diagnostics}
   (fact "model diagnostics classify source constructs without blocking warnings"
     (let [diagnostics (core/lang-model-v1-diagnostics
                        "(defn- hidden [] #'hidden) #( + 1 2) ^:private")]
       [(count diagnostics) (:level (first diagnostics))
        (:migration/error (first diagnostics))
        (nil? (core/lang-model-v1-blocking? diagnostics))
        (core/lang-model-v1-blocking? [{:level :error}])])
     => [4 :warning :lang.model-v1/private-definition true true])

   ^{:refer tool.migrate.policy.foundation.core/lang-model-v1-blocking?}
   (fact "model blocking policy rejects errors and accepts warnings"
     [(core/lang-model-v1-blocking? [])
      (nil? (core/lang-model-v1-blocking? [{:level :warning}]))
      (core/lang-model-v1-blocking? [{:level :error}])]
     => [nil true true])

   ^{:refer tool.migrate.policy.foundation.core/migrate-lang-model-v1-source}
   (fact "model source migration records the route and clean diagnostics"
     (let [result (core/migrate-lang-model-v1-source
                   "(ns tahto.model.spec-c (:require [tahto.base.emit :as emit]))")]
       [(:changed result) (:rules result) (:diagnostics result)
        (str/includes? (:after result) "lang.model.v1.spec-c")])
     => [true [:lang.model-v1/route] [] true])

   ^{:refer tool.migrate.policy.foundation.core/migrate-lang-model-v1-unit}
   (fact "model unit migration returns the routed target and provenance"
     (let [result (core/migrate-lang-model-v1-unit
                   {:source/path "src/tahto/model/spec_c.clj"
                    :target/path "src/lang/model/v1/spec_c.hal"
                    :source/namespace 'tahto.model.spec-c
                    :source "(ns tahto.model.spec-c)"})]
       [(:path result) (:target/path result) (:target/namespace result)
        (:move result) (:create result) (:changed result)])
     => ["src/lang/model/v1/spec_c.hal"
         "src/lang/model/v1/spec_c.hal" "lang.model.v1.spec-c" true true true])

   ^{:refer tool.migrate.policy.foundation.core/+lang-model-v1-units+}
   (fact "model migration inventory exposes the source-owned unit catalog"
     [(count core/+lang-model-v1-units+)
      (:status (first core/+lang-model-v1-units+))
      (:status (core/lang-model-v1-unit-for "src/tahto/model/spec_js/jsx.clj"))
      (:status (core/lang-model-v1-unit-for "src/tahto/model/spec_js/html.clj"))
      (:status (core/lang-model-v1-unit-for "src/tahto/model/spec_js/meta.clj"))
      (:status (core/lang-model-v1-unit-for "src/tahto/model/spec_js/qml.clj"))
      (:status (core/lang-model-v1-unit-for "src/tahto/model/spec_dart.clj"))
      (:status (core/lang-model-v1-unit-for "src/tahto/model/spec_dart/rewrite.clj"))
      (:status (core/lang-model-v1-unit-for "src/tahto/model/spec_dart/typed.clj"))
      (:status (last core/+lang-model-v1-units+))]
     => [39 :ported :ported :ported :ported :ported :ported :ported :ported :pending])

   ^{:refer tool.migrate.policy.foundation.core/+foundation-lang-compiler-scopes+}
   (fact "the compiler closure routes both Foundation base families and the hard cut to lang.base"
     (mapv (fn [scope]
             [(:id scope) (:stage scope)
              (:source/prefix scope) (:target/prefix scope)
              (:test/source-prefix scope) (:test/target-prefix scope)])
           core/+foundation-lang-compiler-scopes+)
     => [[:lang.base :base
          "src/tahto/base/" "src/lang/base/"
          "test/tahto/base/" "test/lang/base/"]
         [:lang.base.book :base
          "src/tahto/common/" "src/lang/base/"
          "test/tahto/common/" "test/lang/base/"]
         [:lang.base-hard-cut :base
          "src/lang/common/" "src/lang/base/"
          "test/lang/common/" "test/lang/base/"]
         [:lang.base-hard-cut-test :base
          "test/lang/common/" "test/lang/base/"
          "test/lang/common/" "test/lang/base/"]
         [:lang.core :core
          "src/tahto/core/" "src/lang/core/"
          "test/tahto/core/" "test/lang/core/"]
         [:lang.model/v1 :model
          "src/tahto/model/" "src/lang/model/v1/"
          "test/tahto/model/" "test/lang/model/v1/"]
         [:lang.runtime.basic :runtime
          "src/tahto/runtime/basic/" "src/lang/runtime/basic/"
          "test/tahto/runtime/basic/" "test/lang/runtime/basic/"]])

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-compiler-scope}
   (fact "the compiler closure accepts only the selected model catalog"
     [(select-keys
       (core/foundation-lang-compiler-scope "src/tahto/base/emit_data.clj")
       [:id :stage])
      (select-keys
       (core/foundation-lang-compiler-scope "src/tahto/model/spec_js/meta.clj")
       [:id :stage])
      (core/foundation-lang-compiler-scope
       "src/tahto/model/annex/spec_rust.clj")]
     => [{:id :lang.base :stage :base}
         {:id :lang.model/v1 :stage :model}
         nil])

   ^{:refer tool.migrate.policy.foundation.core/route-foundation-lang-compiler-path}
   (fact "compiler source paths route into the canonical Hara owners"
     [(core/route-foundation-lang-compiler-path "src/tahto/base/emit_data.clj")
      (core/route-foundation-lang-compiler-path "src/tahto/common/book.clj")
      (core/route-foundation-lang-compiler-path "src/tahto/core/compile.clj")
      (core/route-foundation-lang-compiler-path "src/tahto/model/spec_js/meta.clj")
      (core/route-foundation-lang-compiler-path "src/tahto/runtime/basic/type_basic.clj")
      (core/route-foundation-lang-compiler-path "src/tahto/model/annex/spec_rust.clj")]
     => ["src/lang/base/emit_data.hal"
         "src/lang/base/book.hal"
         "src/lang/core/compile.hal"
         "src/lang/model/v1/spec_js/meta.hal"
         "src/lang/runtime/basic/type_basic.hal"
         nil])

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-compiler-test-paths}
   (fact "compiler units retain their paired historical and target tests"
     (core/foundation-lang-compiler-test-paths "src/tahto/model/spec_js/meta.clj")
     => {:source/path "test/tahto/model/spec_js/meta_test.clj"
         :target/path "test/lang/model/v1/spec_js/meta_test.hal"})

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-plus-groups}
   (fact "compiler migration records source-owned construction groups"
     (core/foundation-lang-plus-groups
      "(def +features+ {})\n(def +grammar+ {})\n(def +book+ {})\n(def +init+ +book+)")
     => ['+features+ '+grammar+ '+book+ '+init+])

   ^{:refer tool.migrate.policy.foundation.core/rewrite-foundation-lang-compiler-source}
   (fact "compiler source rewrites follow the selected owning stage"
     [(core/rewrite-foundation-lang-compiler-source
       :base
       "(ns tahto.base.emit-data (:require [tahto.common.book]))")
      (core/rewrite-foundation-lang-compiler-source
       :core
       "(ns tahto.core.compile (:require [tahto.core.runtime]))")
      (core/rewrite-foundation-lang-compiler-source
       :runtime
       "(ns tahto.runtime.basic.type-basic)")
      (core/rewrite-foundation-lang-compiler-source
       :base
       "(def value {:polis/phase :polis/source})")]
     => ["(ns lang.base.emit-data (:require [lang.base.book]))"
         "(ns lang.core.compile (:require [lang.core.runtime]))"
         "(ns lang.runtime.basic.type-basic)"
         "(def value {:lang/phase :lang/source})"])

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-compiler-unit}
   (fact "compiler units carry routing, stage, paired test, and group provenance"
     (let [unit (core/foundation-lang-compiler-unit
                 {:source/path "src/tahto/model/spec_js/meta.clj"
                  :source/namespace 'tahto.model.spec-js.meta
                  :source "(def +meta+ {})"})]
       [(select-keys unit [:source/path :target/path :source/namespace
                           :target/namespace :migration :stage :groups])
        (:test unit)])
     => [{:source/path "src/tahto/model/spec_js/meta.clj"
          :target/path "src/lang/model/v1/spec_js/meta.hal"
          :source/namespace 'tahto.model.spec-js.meta
          :target/namespace 'lang.model.v1.spec-js.meta
          :migration :foundation/lang-compiler
          :stage :model
          :groups ['+meta+]}
         {:source/path "test/tahto/model/spec_js/meta_test.clj"
          :target/path "test/lang/model/v1/spec_js/meta_test.hal"}])

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-inventory}
   (fact "the lang inventory preserves one selected unit per supplied Foundation source"
     (let [inventory
           (core/foundation-lang-inventory
            [{:source/path "src/tahto/base/emit_data.clj"
              :source/namespace 'tahto.base.emit-data
              :source "(def value 1)"}
             {:source/path "src/tahto/model/spec_js/meta.clj"
              :source/namespace 'tahto.model.spec-js.meta
              :source "(def +meta+ {})"}
             {:source/path "src/tahto/model/annex/spec_rust.clj"
              :source/namespace 'tahto.model.annex.spec-rust
              :source "(def ignored 1)"}])]
       [(mapv :target/path inventory)
        (mapv :stage inventory)])
     => [["src/lang/base/emit_data.hal"
          "src/lang/model/v1/spec_js/meta.hal"]
         [:base :model]])

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-plan}
   (fact "the compiler closure produces a dry plan with routed edits"
     (let [result
           (core/foundation-lang-plan
            [{:source/path "src/tahto/base/emit_data.clj"
              :source/namespace 'tahto.base.emit-data
              :source "(ns tahto.base.emit-data)\n(def value 1)"}])]
       [(:write result)
        (:valid result)
        (get-in result [:records 0 :data :target/path])
        (get-in result [:records 0 :data :stage])])
     => [nil true "src/lang/base/emit_data.hal" :base])

   ^{:refer tool.migrate.policy.foundation.core/migrate-selected-unit}
   (fact "the selected compiler migration retains the routed source and rewrite"
     (let [unit
           (core/foundation-lang-compiler-unit
            {:source/path "src/tahto/base/emit_data.clj"
             :source/namespace 'tahto.base.emit-data
             :source "(ns tahto.base.emit-data)\n(def value 1)"})
           result (core/migrate-selected-unit unit)]
       [(:path result)
        (:target/namespace result)
        (:stage result)
        (str/includes? (:after result) "lang.base.emit-data")
        (:rules result)])
     => ["src/lang/base/emit_data.hal"
         'lang.base.emit-data
         :base
         true
         [:foundation/lang-compiler-route]])

   ^{:refer tool.migrate.policy.foundation.core/migrate-selected-unit}
   (fact "the planner hard-cuts current lang.common source and tests to lang.base"
     (let [source (core/migrate-selected-unit
                   (core/foundation-lang-compiler-unit
                    {:source/path "src/lang/common/emit_data.hal"
                     :source/namespace 'lang.common.emit-data
                     :source "(ns lang.common.emit-data (:require [lang.common.book]))"}))
           test (core/migrate-selected-unit
                 (core/foundation-lang-compiler-unit
                  {:source/path "test/lang/common/emit_data_test.hal"
                   :source/namespace 'lang.common.emit-data-test
                   :source "(ns lang.common.emit-data-test (:require [lang.common.emit-data :as emit]))"}))]
       [[(:path source) (:target/namespace source) (:after source) (:test source)]
        [(:path test) (:target/namespace test) (:after test) (:kind test)]])
     => [["src/lang/base/emit_data.hal"
          'lang.base.emit-data
          "(ns lang.base.emit-data (:require [lang.base.book]))"
          {:source/path "test/lang/common/emit_data_test.hal"
           :target/path "test/lang/base/emit_data_test.hal"}]
         ["test/lang/base/emit_data_test.hal"
          'lang.base.emit-data-test
          "(ns lang.base.emit-data-test (:require [lang.base.emit-data :as emit]))"
          :test]])

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-base-hard-cut-namespace}
   (fact "hard-cut namespaces derive from both source and fact-test paths"
     [(core/foundation-lang-base-hard-cut-namespace "src/lang/common/emit_data.hal")
      (core/foundation-lang-base-hard-cut-namespace "test/lang/common/emit_data_test.hal")]
     => ['lang.common.emit-data 'lang.common.emit-data-test])

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-base-hard-cut-relative-path}
   (fact "hard-cut paths must remain inside their declared migration root"
     (core/foundation-lang-base-hard-cut-relative-path
      "/tmp/lang-base-root"
      "/tmp/lang-base-root/src/lang/common/demo.hal")
     => "src/lang/common/demo.hal")

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-base-hard-cut-apply}
   (fact "the hard cut applies source and fact-test moves atomically and is idempotent"
     (let [root (deref (File/temp-directory "test-temp" {:prefix "lang-base-hard-cut-"}))
           source-path (File/join root "src/lang/common/demo.hal")
           test-path (File/join root "test/lang/common/demo_test.hal")
           consumer-path (File/join root "src/lang/core/compile.hal")
           project-path (File/join root "project.edn")
           target-source (File/join root "src/lang/base/demo.hal")
           target-test (File/join root "test/lang/base/demo_test.hal")]
       (try
        (deref
         (File/write source-path
                     (String/encode-utf8
                      "(ns lang.common.demo (:require [lang.common.book :as book]))")
                     {:mode :replace :parents? true}))
        (deref
         (File/write test-path
                     (String/encode-utf8
                      "(ns lang.common.demo-test (:use code.test) (:require [lang.common.demo :as demo]))")
                     {:mode :replace :parents? true}))
        (deref
         (File/write consumer-path
                     (String/encode-utf8
                      "(ns lang.core.compile (:require [lang.common.demo :as demo]))")
                     {:mode :replace :parents? true}))
        (deref
         (File/write project-path
                     (String/encode-utf8
                      "{:project/source-files [\"src/lang/common/demo.hal\"]}")
                     {:mode :replace :parents? true}))
        (let [plan (core/foundation-lang-base-hard-cut-plan root)
              references (core/foundation-lang-base-reference-plan root)
              applied (core/foundation-lang-base-hard-cut-apply root)
              replay (core/foundation-lang-base-hard-cut-plan root)]
          [(count (:inventory plan))
           (:valid plan)
           (count (:inventory references))
           (count applied)
           (empty? (:records replay))
           (deref (File/exists? target-source))
           (deref (File/exists? target-test))
           (deref (File/exists? source-path))
           (deref (File/exists? test-path))
           (String/decode-utf8 (deref (File/read target-source)))
           (String/decode-utf8 (deref (File/read target-test)))
           (String/decode-utf8 (deref (File/read consumer-path)))
           (String/decode-utf8 (deref (File/read project-path)))])
        (finally
         (fs/delete root {:recursive? true}))))
     => [2 true 2 4 true true true false false
         "(ns lang.base.demo (:require [lang.base.book :as book]))"
         "(ns lang.base.demo-test (:use code.test) (:require [lang.base.demo :as demo]))"
         "(ns lang.core.compile (:require [lang.base.demo :as demo]))"
         "{:project/source-files [\"src/lang/base/demo.hal\"]}"])

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-validate-plan}
   (fact "an empty compiler plan validates without a write"
     (core/foundation-lang-validate-plan "." {:records []})
     => {:valid? true :write false :edits [] :diagnostics []})

   ^{:refer tool.migrate.policy.foundation.core/foundation-lang-apply-plan}
   (fact "an empty compiler plan is an idempotent no-op apply boundary"
     (core/foundation-lang-apply-plan "." {:records []})
     => [])


^{:refer tool.migrate.policy.foundation.core/rewrite-foundation-lang-compiler-source}
(fact "structural compiler routing preserves literals and crosses stage boundaries"
  (core/rewrite-foundation-lang-compiler-source
   :core "(ns tahto.core.demo (:require [tahto.base.emit]))\n;; tahto.core.demo\n(def text \"tahto.core.demo\")")
  => "(ns lang.core.demo (:require [lang.base.emit]))\n;; tahto.core.demo\n(def text \"tahto.core.demo\")")

^{:refer tool.migrate.policy.foundation.core/normalize-foundation-test-source}
(fact "structural test normalization preserves undeclared aliases and predicates"
  (core/normalize-foundation-test-source
   "(ns demo)\n(fact (math/value \"h/value walk/value\") => float?)")
  => "(ns demo)\n(fact (math/value \"h/value walk/value\") => float?)")

^{:refer tool.migrate.policy.foundation.core/foundation-common-fact-count}
(fact "structural fact inventory excludes comments and literal fake facts"
  (core/foundation-common-fact-count
   ";; (fact fake)\n(def note \"(fact fake)\")\n(fact \"real\" 1 => 1)")
  => 1)

^{:refer tool.migrate.policy.foundation.core/foundation-common-diagnostics}
(fact "structural diagnostics ignore literal compiler namespace mentions"
  (mapv :reference
        (core/foundation-common-diagnostics
         ";; tahto.core/a\n(def note \"tahto.core/b\")\n(tahto.core/c)"))
  => ["tahto.core/c"])

^{:refer tool.migrate.policy.foundation.core/migrate-foundation-common-test-source}
(fact "structural base-test translation preserves assertions and literal references"
  (select-keys
   (core/migrate-foundation-common-test-source
    "(ns tahto.base.emit-test (:require [tahto.core :as l]))\n(fact \"tahto.core/x\" (math/value \"h/value\") => float?)"
    "lang.base.emit-test")
   [:after :facts])
  => {:after "(ns lang.base.emit-test (:require [lang.core :as l]))\n(fact \"tahto.core/x\" (math/value \"h/value\") => float?)"
      :facts {:source 1 :direct 1 :adapted 0 :covered-current 0 :unmapped 0}})

^{:refer tool.migrate.policy.foundation.core/migrate-selected-unit}
(fact "structural compiler units retain copy provenance and blocking diagnostics"
  (let [source "(ns tahto.core.demo)\n#?(:clj tahto.base/a :cljs tahto.base/b)"
        result (core/migrate-selected-unit
                {:source/path "src/tahto/core/demo.clj" :source source
                 :migration :foundation/lang-compiler :stage :core :copy true})]
    [(:copy result) (:move result) (= source (:before result))
     (= source (:after result)) (:rules/applied result)
     (mapv :reason (filter (fn [entry] (= :error (:level entry)))
                          (:diagnostics result)))])
  => [true false true true [] [:reader-conditional]])

^{:refer tool.migrate.policy.foundation.core/migration-item}
(fact "structural migration records distinguish informational evidence from blockers"
  (let [unit {:source/path "src/tahto/core/demo.clj"
              :migration :foundation/lang-compiler :stage :core :copy true}
        safe (core/migration-item (assoc unit :source "(ns tahto.core.demo)") {})
        blocked (core/migration-item
                 (assoc unit :source "(ns tahto.core.demo)\n#?(:clj value)") {})]
    [(:status safe)
     (mapv :level (get-in safe [:data :diagnostics]))
     (:status blocked)
     (mapv :reason (filter (fn [entry] (= :error (:level entry)))
                          (get-in blocked [:data :diagnostics])))])
  => [:return [:info] :error [:reader-conditional]])

^{:refer tool.migrate.policy.foundation.core/foundation-lang-direct-plan}
(fact "structural direct plans use the execution classifier without dropping evidence"
  (let [unit {:path "src/tahto/core/demo.clj" :source/path "src/tahto/core/demo.clj"
              :stage :core :copy true}
        safe (core/foundation-lang-direct-plan
              :foundation/lang-compiler [(assoc unit :source "(ns tahto.core.demo)")])
        blocked (core/foundation-lang-direct-plan
                 :foundation/lang-compiler [(assoc unit :source "#?(:clj value)")])]
    [(:valid safe) (:write safe) (mapv :status (:records safe))
     (get-in safe [:records 0 :data :after])
     (:valid blocked) (mapv :status (:records blocked))])
  => [true nil [:return] "(ns lang.core.demo)" false [:error]])

^{:refer tool.migrate.policy.foundation.core/foundation-lang-validate-plan}
(fact "structural write validation retains safe evidence and rejects manual diagnostics"
  (let [root (deref (File/temp-directory "test-temp" {:prefix "lang-plan-validation-"}))
        path (File/join root "source.hal")
        info {:level :info :safety :safe :type :tool.migrate/rewrite}
        unit {:source/path "source.hal" :target/path "target.hal"
              :before "before" :after "after" :copy true :changed true
              :diagnostics [info]}]
    (try
      (deref (File/write path (String/encode-utf8 "before") {:mode :replace :parents? true}))
      (let [safe (core/foundation-lang-validate-plan root {:records [{:data unit}]})
            blocked (core/foundation-lang-validate-plan
                     root {:records [{:data (assoc unit :diagnostics
                                                   [{:safety :manual :level :warning}])}]})]
        [(:valid? safe) (:write safe) (:diagnostics safe)
         (:valid? blocked) (:write blocked)
         (deref (File/exists? (File/join root "target.hal")))])
      (finally (fs/delete root {:recursive? true}))))
  => [true false [{:level :info :safety :safe :type :tool.migrate/rewrite}]
      false false false])

^{:refer tool.migrate.policy.foundation.core/apply}
(fact "structural apply preserves copied authority and blocks manual work before writing"
  (let [root (deref (File/temp-directory "test-temp" {:prefix "lang-plan-apply-"}))
        source-path (File/join root "source.hal")
        target-path (File/join root "target.hal")
        unit {:source/path "source.hal" :target/path "target.hal"
              :before "before" :after "after" :copy true :changed true
              :diagnostics [{:level :info :safety :safe :type :tool.migrate/rewrite}]}]
    (try
      (deref (File/write source-path (String/encode-utf8 "before") {:mode :replace :parents? true}))
      (let [applied (core/apply root {:records [{:data unit}]})
            blocked (try
                      (core/apply root {:records [{:data (assoc unit
                                               :after "must-not-write"
                                               :diagnostics [{:safety :manual :level :warning}])}]})
                      :unexpected
                      (catch error (:ex/message (ex-data error))))]
        [(mapv :write applied)
         (String/decode-utf8 (deref (File/read source-path)))
         (String/decode-utf8 (deref (File/read target-path)))
         blocked])
      (finally (fs/delete root {:recursive? true}))))
  => [[true] "before" "after" "Migration contains blocking diagnostics"])


^{:refer tool.migrate.policy.foundation.core/+foundation-lang-root-scopes+}
(fact "root scopes retain exact source target and namespace ownership"
  (mapv (fn [scope] [(:source/path scope) (:target/path scope) (:target/namespace scope)])
        core/+foundation-lang-root-scopes+)
  => [["src/tahto/core.clj" "src/lang/core.hal" 'lang.core]
      ["src/tahto/runtime/basic.clj" "src/lang/runtime/basic.hal" 'lang.runtime.basic]
      ["test/tahto/core_test.clj" "test/lang/core_test.hal" 'lang.core-test]
      ["test/tahto/runtime/basic_test.clj" "test/lang/runtime/basic_test.hal" 'lang.runtime.basic-test]])

^{:refer tool.migrate.policy.foundation.core/foundation-lang-compiler-scope}
(fact "root selection is exact and preserves child directory scopes"
  (mapv (fn [path] (let [scope (core/foundation-lang-compiler-scope path)] (if scope (select-keys scope [:id :stage :kind]) nil)))
        ["src/tahto/core.clj" "test/tahto/runtime/basic_test.clj"
         "src/tahto/core_extra.clj" "src/tahto/core/impl.clj"])
  => [{:id :lang.core-root :stage :core :kind :source}
      {:id :lang.runtime.basic-root-test :stage :runtime :kind :test}
      nil
      {:id :lang.core :stage :core}])

^{:refer tool.migrate.policy.foundation.core/route-foundation-lang-compiler-path}
(fact "root routes do not include similarly named sibling files"
  (mapv core/route-foundation-lang-compiler-path
        ["src/tahto/core.clj" "src/tahto/runtime/basic.clj"
         "test/tahto/core_test.clj" "test/tahto/runtime/basic_test.clj"
         "src/tahto/core_extra.clj" "src/tahto/runtime/basic_extra.clj"])
  => ["src/lang/core.hal" "src/lang/runtime/basic.hal"
      "test/lang/core_test.hal" "test/lang/runtime/basic_test.hal" nil nil])

^{:refer tool.migrate.policy.foundation.core/foundation-lang-compiler-test-paths}
(fact "root source test pairs are explicit and test roots do not acquire test tests"
  (mapv core/foundation-lang-compiler-test-paths
        ["src/tahto/core.clj" "src/tahto/runtime/basic.clj"
         "test/tahto/core_test.clj" "test/tahto/runtime/basic_test.clj"])
  => [{:source/path "test/tahto/core_test.clj" :target/path "test/lang/core_test.hal"}
      {:source/path "test/tahto/runtime/basic_test.clj" :target/path "test/lang/runtime/basic_test.hal"}
      nil nil])

^{:refer tool.migrate.policy.foundation.core/foundation-lang-compiler-unit}
(fact "root inventory units keep source evidence and route root test namespace suffixes"
  (mapv
   (fn [path]
     (let [unit (core/foundation-lang-compiler-unit
                 {:source/path path :source "(ns authority)" :copy true :groups/skip? true})]
       [(:source/path unit) (:target/path unit) (:target/namespace unit)
        (:stage unit) (:kind unit) (:copy unit) (:source unit)]))
   ["src/tahto/core.clj" "test/tahto/runtime/basic_test.clj"])
  => [["src/tahto/core.clj" "src/lang/core.hal" 'lang.core :core :source true "(ns authority)"]
      ["test/tahto/runtime/basic_test.clj" "test/lang/runtime/basic_test.hal"
       'lang.runtime.basic-test :runtime :test true "(ns authority)"]])

^{:refer tool.migrate.policy.foundation.core/foundation-lang-authority-paths}
(fact "root Git selection uses only the pinned read-only tree and exact root names"
  (let [calls (atom [])
        runner (fn [argv input]
                 (swap! calls conj [argv input])
                 "test/tahto/core_test.clj\nsrc/tahto/core_extra.clj\nsrc/tahto/core.clj\nsrc/tahto/runtime/basic.clj\ntest/tahto/runtime/basic_test.clj\nsrc/tahto/base/provenance.clj\nsrc/tahto/model/spec_js.clj\n")
        paths (core/foundation-lang-authority-paths runner "pinned")]
    [paths (deref calls)])
  => [["src/tahto/base/provenance.clj" "src/tahto/core.clj" "src/tahto/runtime/basic.clj"
       "test/tahto/core_test.clj" "test/tahto/runtime/basic_test.clj"]
      [[["ls-tree" "-r" "--name-only" "pinned"] nil]]])

^{:refer tool.migrate.policy.foundation.core/foundation-lang-staged-paths}
(fact "root staged discovery includes existing exact files without mutating the authority"
  (let [root (deref (File/temp-directory "test-temp" {:prefix "lang-root-inventory-"}))
        paths ["src/tahto/core.clj" "test/tahto/runtime/basic_test.clj"
               "src/tahto/base/provenance.clj" "src/tahto/core_extra.clj"]]
    (try
      (doseq [prefix core/+foundation-lang-authority-prefixes+]
        (fs/create-directory (File/resolve root prefix) {:parents? true}))
      (doseq [path paths]
        (deref (File/write (File/resolve root path) (String/encode-utf8 "(ns authority)")
                           {:mode :replace :parents? true})))
      (let [first-pass (core/foundation-lang-staged-paths root)
            second-pass (core/foundation-lang-staged-paths root)]
        [(mapv (fn [path] (core/foundation-lang-staged-relative-path root path)) first-pass)
         (= first-pass second-pass)
         (mapv (fn [path] (String/decode-utf8 (deref (File/read (File/resolve root path))))) paths)])
      (finally (fs/delete root {:recursive? true}))))
  => [["src/tahto/base/provenance.clj" "src/tahto/core.clj" "test/tahto/runtime/basic_test.clj"]
      true ["(ns authority)" "(ns authority)" "(ns authority)" "(ns authority)"]])
