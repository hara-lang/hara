(ns tool.sh-test
  (:require [tool.sh :as subject]))

^{:refer tool.sh/process-failure}
(Test/check
 [{:name "wraps a non-Exception process failure without an invalid cause"
   :test (fn []
           (try
             (subject/process-failure :spawn ["missing"] "native failure")
             :missing
             (catch error
               [(ex-message error)
                (:tool.sh/error (ex-data error))
                (:command (ex-data error))])))
   :expected ["tool.sh process access is unavailable or failed"
              :process-unavailable
              ["missing"]]}])
