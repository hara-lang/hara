(ns tool.migrate-test
  (:use code.test)
  (:require [std.foundation.string :as str]
            [tool.migrate :as migrate]))

(def +foundation-authority-git-dir+
  "/Users/zcaudate/Development/greenways/workspace/reference/foundation-base/.git")
(def +foundation-authority-revision+
  "fe54cc866473a888bfbd4ce2d3de6d8011f09f72")
(def +foundation-stage-root+
  "test-temp/foundation-base")

(def catalog
  {:document/id :demo/transform
   :document/type :code-migration-spec
   :migration/rules
   [{:rule/id :demo/rename
     :rule/languages [:clojure :hara]
     :rule/phase :expression
     :rule/priority 1
     :rule/kind :token
     :rule/match {:clojure {:text "old"}
                  :hara {:text "legacy"}}
     :rule/rewrite {:clojure {:op :replace-token :text "new"}
                    :hara {:op :replace-token :text "native"}}
     :rule/safety :safe
     :rule/evidence {:source/path "src/demo.clj"
                     :target/spec :hara/foundation}}]})

^{:refer tool.migrate/transform-code}
(fact "the root facade publishes the registry-backed transform"
  ((fn [result]
     [(:target/path result)
      (:changed result)
      (str/includes? (:after result) "new")
      (count (:rules/applied result))])
   (migrate/transform-code
    {:source/path "src/demo.clj"
     :source/text "(ns demo)\n(def old 1)\n"
     :target/path "lib/demo.hal"}
    {:catalog catalog
     :mode :safe}))
  => ["lib/demo.hal" true true 1])

^{:refer tool.migrate/transform-code}
(fact "tool.migrate keeps the implementation owner behind the facade"
  [(get (Runtime/namespace 'tool.migrate) :namespace/role)
   (get (Runtime/namespace 'tool.migrate.common.transform) :namespace/role)
   (nil? (get (ns-publics 'tool.migrate) 'language))
   (nil? (get (ns-publics 'tool.migrate) 'target-language))
   (nil? (get (ns-publics 'tool.migrate)
             'canonicalize-public-metadata))]
  => [:facade :internal false false false])

^{:refer tool.migrate/canonicalize-public-metadata}
(fact "the migration facade exposes public metadata canonicalization"
  (:output
   (migrate/canonicalize-public-metadata
    "^{:public true} (defn old [] 1)"))
  => "(defn ^{:public true} old [] 1)")

^{:refer tool.migrate/project-plan}
(fact "the migration facade exposes a read-only project plan"
  (let [plan
        (migrate/project-plan
         {:units [{:source/path "/authority/demo.clj"
                   :source/root "/authority"
                   :source/text "(ns demo.core)\n(def value 1)\n"
                   :source/sha256 "sha256:source"
                   :target/path "/hara/demo.hal"
                   :target/root "/hara"}]})]
    [(:operation plan)
     (:write plan)
     (count (:units plan))
     (fn? migrate/project-validate-write-plan)])
  => [:tool.migrate/project false 1 true])

^{:refer tool.migrate/foundation-lang-plan}
(fact "the migration facade publishes the Foundation lang compiler closure"
  (let [units [{:source/path "src/tahto/base/emit_data.clj"
                :source/namespace 'tahto.base.emit-data
                :source "(ns tahto.base.emit-data)\n(def value 1)"}]
        inventory (migrate/foundation-lang-inventory units)
        plan (migrate/foundation-lang-plan units)]
    [(mapv :target/path inventory)
     (:valid plan)
     (get-in plan [:records 0 :data :target/namespace])
     (migrate/foundation-lang-validate-plan "." {:records []})
     (migrate/foundation-lang-apply-plan "." {:records []})])
  => [["src/lang/base/emit_data.hal"]
      true
      'lang.base.emit-data
      {:valid? true :write false :edits [] :diagnostics []}
      []])

^{:refer tool.migrate/foundation-script-inventory}
(fact "the migration facade publishes the Foundation script and impl mechanism inventory"
  (let [inventory (migrate/foundation-script-inventory)]
    [(has? (set (:source/references inventory)) 'tahto.core.script/script-fn-base)
     (has? (set (:source/references inventory)) 'tahto.core.script-macro/call-thunk)
     (has? (set (:source/references inventory))
           'tahto.core.impl-lifecycle/emit-module-setup)
     (has? (set (:source/references inventory))
           'tahto.core.impl-deps-imports/module-code-deps)
     (has? (set (:target/references inventory)) 'lang.core.script/eval-form)
     (has? (set (:target/references inventory)) 'lang.core.script-annex/start-tag-in)
     (has? (set (:target/references inventory))
           'lang.core.impl-lifecycle/emit-module-setup)
     (has? (set (:target/references inventory))
           'lang.core.impl-deps-imports/module-code-deps)
     (has? (set (:validation/references inventory))
           'lang.core.script-contract-test/run)
     (has? (set (:validation/references inventory))
           'lang.core.impl-lifecycle-test/run)
     (has? (set (:validation/references inventory))
           'lang.core.impl-deps-imports-test/run)
     (has? (set (map :target/refer (:records inventory)))
           'lang.core.impl-lifecycle/emit-module-setup)
     (has? (set (map :target/refer (:records inventory)))
           'lang.core.impl-deps-imports/module-code-deps)])
  => [true true true true true true true true true true true true true])

^{:refer tool.migrate/foundation-lang-authority-paths}
(fact "the authority walker covers every selected Foundation source and fact-test path"
  (let [paths (migrate/foundation-lang-staged-paths
               +foundation-stage-root+)
        names (set (map str paths))]
    [(count paths)
     (has? names "src/tahto/core/pointer.clj")
     (has? names "test/tahto/runtime/basic/type_websocket_test.clj")])
  => [261 true true])

^{:refer tool.migrate/foundation-lang-authority-units}
(fact "authority units retain provenance and are copy-only"
  (let [units (migrate/foundation-lang-staged-units
               +foundation-stage-root+)
        unit (first (filter #(= "src/tahto/core/pointer.clj"
                                (:source/path %))
                            units))]
    [(count units)
     (:authority/source unit)
     (:copy unit)
     (str/includes? (:source unit) "(ns tahto.core.pointer")])
  => [261 true true true])

^{:refer tool.migrate/foundation-lang-authority-inventory}
(fact "authority inventory routes source and test namespaces to lang targets"
  (let [inventory (migrate/foundation-lang-staged-inventory
                   +foundation-stage-root+)
        pointer (first (filter #(= "src/tahto/core/pointer.clj"
                                   (:source/path %))
                               inventory))
        websocket-test (first (filter #(= "test/tahto/runtime/basic/type_websocket_test.clj"
                                          (:source/path %))
                                      inventory))]
    [(count inventory)
     (:target/path pointer)
     (:target/namespace pointer)
     (:kind websocket-test)
     (:target/path websocket-test)
     (:target/namespace websocket-test)])
  => [261
      "src/lang/core/pointer.hal"
      'lang.core.pointer
      :test
      "test/lang/runtime/basic/type_websocket_test.hal"
      'lang.runtime.basic.type-websocket-test])
