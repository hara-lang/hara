(ns code.manage.var-test
  (:use code.test)
  (:require [code.manage.var :as manage-var]))

^{:refer code.manage.var/find-usages}
(Test/register
 {:desc "finds literal usages only when a variable is selected"
  :test (fn [] [(manage-var/find-usages {:source "run run" :path "demo.hal"} {:var "run"}) (manage-var/find-usages {:source "run" :path "demo.hal"} {})])
  :expected [[{:text "run run" :column 1 :line 1 :path "demo.hal"} {:text "run run" :column 5 :line 1 :path "demo.hal"}] []]})
