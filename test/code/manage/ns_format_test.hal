(ns code.manage.ns-format-test
  (:use code.test)
  (:require [code.manage.ns-format :as manage-format]))

^{:refer code.manage.ns-format/ns-format}
(Test/register
 {:desc "normalizes a source file through the shared healing edit"
  :test (fn [] (:after (manage-format/ns-format {:source "(ns demo)" :path "demo.hal"})))
  :expected "(ns demo)\n"})
