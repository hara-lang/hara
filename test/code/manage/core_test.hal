^{:refer code.manage.core/check-contract}
(Test/register
 {:desc "publishes the connector contract checker"
  :test (fn [] (:valid? (core/check-contract {:source "not markdown" :complete? true})))
  :expected false})

^{:refer code.manage.core/test-path-for}
(Test/register
 {:desc "publishes test path mapping"
  :test (fn [] (core/test-path-for {:path "src/demo.hal"} {}))
  :expected "test/demo_test.hal"})

^{:refer code.manage.core/test-namespace-for}
(Test/register
 {:desc "derives a test namespace from a source unit"
  :test (fn [] (core/test-namespace-for {:source "(ns demo.core)" :namespace (quote demo.core) :path "demo.hal"} {}))
  :expected (quote demo.core-test)})

^{:refer code.manage.core/definition-names}
(Test/register
 {:desc "publishes definition name projection"
  :test (fn [] (core/definition-names unit))
  :expected [(quote run)]})

^{:refer code.manage.core/public-definition-names}
(Test/register
 {:desc "publishes public definition names"
  :test (fn [] (core/public-definition-names unit))
  :expected [(quote run)]})

^{:refer code.manage.core/reachable-definition-names}
(Test/register
 {:desc "publishes reachable definition names"
  :test (fn [] (core/reachable-definition-names unit))
  :expected [(quote run)]})

^{:refer code.manage.core/orphaned-meta}
(Test/register
 {:desc "publishes orphaned metadata inspection"
  :test (fn [] (core/orphaned-meta unit))
  :expected []})

^{:refer code.manage.core/includes-any?}
(Test/register
 {:desc "publishes compatibility line matching"
  :test (fn [] (core/includes-any? "a b" ["z" "b"]))
  :expected true})

^{:refer code.manage.core/remove-matching-lines}
(Test/register
 {:desc "publishes compatibility line removal"
  :test (fn [] (core/remove-matching-lines "keep\nremove" ["remove"]))
  :expected "keep\n"})

^{:refer code.manage.core/replacements}
(Test/register
 {:desc "publishes replacement option normalization"
  :test (fn [] (core/replacements {:match "a" :replacement "b"}))
  :expected [["a" "b"]]})

^{:refer code.manage.core/replace-all}
(Test/register
 {:desc "publishes literal replacement"
  :test (fn [] (core/replace-all "a" [["a" "b"]]))
  :expected "b"})

^{:refer code.manage.core/refactor-swap}
(Test/register
 {:desc "publishes explicit replacement pairs"
  :test (fn [] (:after (core/refactor-swap unit [["run" "start"]])))
  :expected "(ns demo)\n(defn start [] true)\n"})

^{:refer code.manage.core/incomplete-report}
(Test/register
 {:desc "publishes path-keyed incomplete reports"
  :test (fn [] (keys (core/incomplete-report [unit])))
  :expected ["demo.hal"]})

^{:refer code.manage.core/task?}
(Test/register
 {:desc "recognizes native manage task bundles"
  :test (fn [] [(core/task? core/analyse) (core/task? {})])
  :expected [true false]})

^{:refer code.manage.core/task-operation}
(Test/register
 {:desc "reads task operation metadata"
  :test (fn [] (core/task-operation core/analyse))
  :expected :analyse})

^{:refer code.manage.core/tasklet-reference}
(Test/register
 {:desc "reads tasklet identity metadata"
  :test (fn [] (core/tasklet-reference core/analyse))
  :expected (quote code.manage.unit/analyse)})

^{:refer code.manage.core/batch-records}
(Test/register
 {:desc "projects records from a native task result"
  :test (fn [] (core/batch-records {:records [{:item/id :demo}]}))
  :expected [{:item/id :demo}]})

^{:refer code.manage.core/run-task}
(Test/register
 {:desc "runs a task through the shared work.flow.task boundary"
  :test (fn [] (count (:records (core/run-task core/locate-code {:units [unit]}))))
  :expected 1})

^{:refer code.manage.core/legacy-operations}
(Test/register
 {:desc "retains the archive operation inventory"
  :test (fn [] [(first core/legacy-operations) (last core/legacy-operations) (has? (set core/legacy-operations) :incomplete-report)])
  :expected [:analyse :heal-code true]})

^{:refer code.manage.core/editing-operations}
(Test/register
 {:desc "classifies editing operations"
  :test (fn [] [(has? core/editing-operations :purge) (has? core/editing-operations :missing)])
  :expected [true false]})

^{:refer code.manage.core/parity-inventory}
(Test/register
 {:desc "records a stable boundary for every legacy operation"
  :test (fn [] [(count core/parity-inventory) (get-in core/parity-inventory [:purge :boundary]) (get-in core/parity-inventory [:missing :boundary])])
  :expected [35 :pure-edit-plan :portable-inspection]})

^{:refer code.manage.core/+tasks+}
(Test/register
 {:desc "indexes all executable task operations"
  :test (fn [] [(count core/+tasks+) (has? core/+tasks+ :unclean-findings)])
  :expected [35 true]})

^{:refer code.manage.core/operation-tasks}
(Test/register
 {:desc "aliases the executable operation index"
  :test (fn [] (= core/+tasks+ core/operation-tasks))
  :expected true})

^{:refer code.manage.core/command-task}
(Test/register
 {:desc "resolves supported tasks and rejects unknown operations"
  :test (fn [] [(= core/analyse (core/command-task :analyse)) (try (core/command-task :unknown) false (catch error true))])
  :expected [true true]})

^{:refer code.manage.core/result-edit}
(Test/register
 {:desc "projects edit results"
  :test (fn [] [(core/result-edit {:after "x"}) (core/result-edit {:finding :x})])
  :expected [{:after "x"} nil]})

^{:refer code.manage.core/result-findings}
(Test/register
 {:desc "projects finding results"
  :test (fn [] [(core/result-findings {:finding {:kind :todo}}) (core/result-findings [{:kind :todo} {:path "x"}])])
  :expected [[{:kind :todo}] [{:kind :todo}]]})

^{:refer code.manage.core/plan}
(Test/register
 {:desc "returns archive-compatible plan data from native task execution"
  :test (fn [] (let [plan (core/plan :locate-code {:units [unit] :selector :all})] [(get-in plan [:summary :operation]) (count (:records plan)) (get-in plan [:results 0 :item/id])]))
  :expected [:locate-code 1 (quote demo)]})

^{:refer code.manage.core/maintenance-work}
(Test/register
 {:desc "retains the maintenance-work task lookup alias"
  :test (fn [] (= core/analyse (core/maintenance-work :analyse)))
  :expected true})

^{:refer code.manage.core/run}
(Test/register
 {:desc "runs ordinary operations and the report compatibility branch"
  :test (fn [] [(count (:records (core/run :locate-code {:units [unit]}))) (has? (core/run :incomplete-report {:units [unit]}) "demo.hal")])
  :expected [1 true]})
