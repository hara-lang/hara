(ns code.manage.core-test
  (:use code.test)
  (:require [code.manage.core :as core]))

(def unit
  {:path "demo.hal"
   :type :source
   :namespace 'demo
   :source "(ns demo)\n(defn run [] true)\n"
   :test-path "demo_test.hal"
   :test-source "(ns demo-test)\n"})

^{:refer code.manage.core/compose-task}
(Test/register
 {:desc "composes a tasklet into a native task bundle"
  :test (fn [] (core/task? (core/compose-task :demo (fn [value] value) (quote demo/id) 1)))
  :expected true})

^{:refer code.manage.core/analyse}
(Test/register
 {:desc "publishes the analyse operation as a task"
  :test (fn [] [(core/task? core/analyse) (core/task-operation core/analyse)])
  :expected [true :analyse]})

