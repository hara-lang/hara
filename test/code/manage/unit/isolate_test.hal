(ns code.manage.unit.isolate-test
  (:use code.test)
  (:require [code.manage.unit.isolate :as isolate]))

^{:refer code.manage.unit.isolate/isolate}
(Test/register
 {:desc "retains the namespace and selected fact lines"
  :test (fn [] (:after (isolate/isolate {:source "(ns demo-test)\n(def value 1)\n(fact \"one\")\n(def other 2)\n" :path "demo_test.hal"} {})))
  :expected "(ns demo-test)\n(fact \"one\")\n"})
