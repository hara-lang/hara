(ns code.manage.unit.require-test
  (:use code.test)
  (:require [code.manage.unit.require :as unit-require]))

^{:refer code.manage.unit.require/require-file}
(Test/register
 {:desc "returns non-private definition symbols"
  :test (fn [] (unit-require/require-file {:source "(ns demo)\n(defn run [] true)\n(def value 1)\n" :path "demo.hal"}))
  :expected [(quote run) (quote value)]})
