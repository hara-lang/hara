(ns code.manage.unit.snapto-test
  (:use code.test)
  (:require [code.manage.unit.snapto :as snapto]))

^{:refer code.manage.unit.snapto/snapto}
(Test/register
 {:desc "delegates snap-to replacements to refactor-code"
  :test (fn [] (:after (snapto/snapto {:source "alpha beta" :path "demo.hal"} {:match "beta" :replacement "gamma"})))
  :expected "alpha gamma"})
