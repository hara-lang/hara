(ns code.manage.unit.factcheck-test
  (:use code.test)
  (:require [code.manage.unit.factcheck :as factcheck]))

(def unit
  {:path "demo.hal"
   :type :source
   :namespace 'demo
   :source "(ns demo)\n(defn run \"doc\" [] true)\n"
   :test-path "demo_test.hal"
   :test-source "^{:refer demo/run}\n(fact \"run\")\n"})

^{:refer code.manage.unit.factcheck/factcheck-remove}
(Test/register
 {:desc "uses the purge tasklet for factcheck removal compatibility"
  :test (fn [] (:changed (factcheck/factcheck-remove unit {})))
  :expected true})

^{:refer code.manage.unit.factcheck/factcheck-generate}
(Test/register
 {:desc "imports matching fact metadata through the native source edit path"
  :test (fn [] (:changed (factcheck/factcheck-generate unit {})))
  :expected true})
