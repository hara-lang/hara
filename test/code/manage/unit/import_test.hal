(ns code.manage.unit.import-test
  (:use code.test)
  (:require [code.manage.unit.import :as unit-import]))

^{:refer code.manage.unit.import/import}
(Test/register
 {:desc "imports a matching fact title into source documentation"
  :test (fn [] (let [result (unit-import/import {:source "(ns demo)\n(defn run [] true)\n" :test-source "^{:refer demo/run}\n(fact \"runs\")\n" :type :source :test-path "demo_test.hal" :path "demo.hal"} {})] [(:imported result) (:changed result) (str/includes? (:after result) "\"runs\"")]))
  :expected [["demo/run"] true true]})
