(ns code.manage.ns-rename-test
  (:use code.test)
  (:require [code.manage.ns-rename :as manage-rename]))

^{:refer code.manage.ns-rename/ns-rename}
(Test/register
 {:desc "renames literal namespace text and preserves no-op behavior"
  :test (fn [] [(:after (manage-rename/ns-rename {:source "(ns old.core)\n(old.core/run)" :path "demo.hal"} {:to "new.core" :from "old.core"})) (:after (manage-rename/ns-rename {:source "(ns old.core)" :path "demo.hal"} {}))])
  :expected ["(ns new.core)\n(new.core/run)" "(ns old.core)"]})
