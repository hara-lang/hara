(ns code.manage.automation-test
  (:require [code.manage.automation :as automation]))

^{:refer code.manage.automation/incomplete-report}
(Test/register
 {:desc "returns findings keyed by unit path"
  :test (fn []
          (automation/incomplete-report
           [{:path "demo.hal"
             :namespace 'demo
             :source "(ns demo)\n(defn run [] true)"
             :type :source
             :test-path "demo_test.hal"
             :test-source "(ns demo-test)"}]))
  :expected {"demo.hal" [{:path "demo.hal" :line 2 :column 1
                           :classification "M" :kind :missing
                           :namespace 'demo :name 'run :refer "demo/run"
                           :message "missing fact for demo/run"}]}
  :meta {:refer 'code.manage.automation/incomplete-report}})
