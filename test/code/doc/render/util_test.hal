(ns code.doc.render.util-test
  (:require [code.doc.render.util :as util]))

^{:refer code.doc.render.util/adjust-indent}
(Test/check
 [{:name "removes a fixed leading whitespace width from each eligible line"
   :test (fn [] (util/adjust-indent "\n    a\n    b\n    c" 2))
   :expected "\n  a\n  b\n  c"}])

^{:refer code.doc.render.util/basic-html-escape}
(Test/check
 [{:name "escapes static HTML text in deterministic entity order"
   :test (fn [] (util/basic-html-escape "<&>\"\\"))
   :expected "&lt;&amp;&gt;&quot;&#92;"}])

^{:refer code.doc.render.util/basic-html-unescape}
(Test/check
 [{:name "restores nested entities without interpreting arbitrary HTML"
   :test (fn [] (util/basic-html-unescape "&amp;lt; &amp;amp;"))
   :expected "&lt; &amp;"}])

^{:refer code.doc.render.util/join-string}
(Test/check
 [{:name "preserves text and joins a vector of fragments"
   :test (fn [] [(util/join-string "hello")
                 (util/join-string ["hello" " " "world"])])
   :expected ["hello" "hello world"]}])

^{:refer code.doc.render.util/markup}
(Test/check
 [{:name "rejects non-text before resolving the CommonMark Component"
   :test (fn []
           (try
             (util/markup {:source "# Guide"})
             :missing-error
             (catch error (:ex/code (ex-data error)))))
   :expected :code.doc/markdown-required}])
