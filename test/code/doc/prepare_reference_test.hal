(ns code.doc.prepare-reference-test
  (:require [code.doc.prepare :as prepare]))

^{:refer code.doc.prepare/prepare}
(Test/check
 [{:name "prepares page-local reference snippets before numbering tags and rendering"
   :test (fn [] (get-in
                 (prepare/prepare {:path "guide.hal"
                                   :references {"code.core/foo" {:source {:code "(def foo 1)"}}}
                                   :content [{:type :reference :refer "code.core/foo"}]})
                 [:articles "guide.hal" :elements]))
   :expected [{:type :reference :refer "code.core/foo" :origin :reference :mode :source :indentation 0 :code "(def foo 1)" :title "source of <i>code.core/foo</i>" :tag "source-code-core--foo"}]}])
