(ns code.test-test
  (:require [code.test]))

^{:refer code.test/exactly}
(Test/check
 [{:name "the facade publishes matcher APIs"
   :test (fn [] (:checker/type (code.test/exactly {:a 1})))
   :expected :exactly}])

^{:refer code.test/contains-in}
(Test/check
 [{:name "the facade publishes recursive collection matchers"
   :test (fn [] (:checker/type (code.test/contains-in {:a {:b 2}})))
   :expected :contains}])

^{:refer code.test/fact}
(Test/check
 [{:name "the facade publishes the v1 fact macro without a library main"
   :test (fn []
           (let [fact (code.test/fact "facade fact" 1 => 1)]
             [(:desc fact) (nil? (resolve 'code.test/-main))]))
   :expected ["facade fact" true]}])
