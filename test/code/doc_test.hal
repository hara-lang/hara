(ns code.doc-test
  (:require [code.doc :as doc]))

^{:refer code.doc/render-commonmark}
(Test/check
 [{:name "publishes the Component-backed CommonMark entry point"
   :test (fn []
           (try
             (doc/render-commonmark nil)
             :missing-error
             (catch error (:ex/code (ex-data error)))))
   :expected :code.doc/markdown-required}])

^{:refer code.doc/render-page}
(Test/check
 [{:name "publishes the native static page renderer through code.doc"
   :test (fn [] (select-keys
                 (doc/render-page {:path "index.hal" :source "(code.doc/page {:content [\"# Index\"]})" :content ["# Index"]}
                                  (fn [_] "<h1>Index</h1>"))
                 [:output/path :body]))
   :expected {:output/path "index.html"
              :body "<h1>Index</h1>"}}])

^{:refer code.doc/render-static-page}
(Test/check
 [{:name "publishes static native page rendering through the code.doc facade"
   :test (fn [] (select-keys
                 (doc/render-static-page {:path "index.hal"
                                          :source "fixture"
                                          :content ["# Index"]}
                                         (fn [_] "<h1>Index</h1>"))
                 [:output/path :body]))
   :expected {:output/path "index.html" :body "<h1>Index</h1>"}}])

^{:refer code.doc/check-page}
(Test/check
 [{:name "publishes deterministic static page diagnostics through the code.doc facade"
   :test (fn [] (doc/check-page {:path "index.hal"
                                 :references {}
                                 :content [{:type :reference :refer "missing/value"}]}))
   :expected [{:type :missing-reference :refer "missing/value" :page "index.hal"}]}])
