(ns code.deploy-test
  (:require [code.deploy :as deploy]))

^{:refer code.deploy/plan}
(Test/check
 [{:name "publishes the deploy planner through a focused facade"
   :test (fn [] (let [result (deploy/plan ".")]
                  [(vector? (:deploy/packages result))
                   (vector? (:deploy/order result))
                   (:deploy/unowned-namespaces result)]))
   :expected [true true []]}])

^{:refer code.deploy/delete-tree}
(Test/check
 [{:name "publishes the reversible staged-tree reset boundary"
   :test (fn [] (let [root (deref (File/temp-directory "." {:prefix "hara-deploy-facade-"}))]
                  (deref (File/write (File/join root "nested/file.edn")
                                      (String/encode-utf8 "{:value true}")
                                      {:mode :replace :parents? true}))
                  (deploy/delete-tree root)
                  (deref (File/exists? root))))
   :expected false}])

^{:refer code.deploy/pull}
(Test/check
 [{:name "publishes download-only dependency materialization"
   :test (fn [] (let [root (deref (File/temp-directory "." {:prefix "hara-deploy-pull-facade-"}))]
                  (try
                    (deref (File/write (File/join root "project.edn")
                                       (String/encode-utf8
                                        "{:project/id \"fixture/facade-pull\" :project/version \"1.0.0\" :project/dependencies {}}")
                                       {:mode :replace :parents? true}))
                    (let [result (deploy/pull root {})]
                      [(get result :selected)
                       (deref (File/exists? (File/join root "project.lock.edn")))])
                    (finally (deploy/delete-tree root)))))
   :expected [{} false]}])
