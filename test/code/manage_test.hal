(ns code.manage-test
  (:use code.test)
  (:require [code.manage :as manage]))

^{:refer code.manage/analyse}
(Test/register
 {:desc "publishes the native analyse task through the facade"
  :test (fn [] [(manage/task? manage/analyse) (manage/task-operation manage/analyse)])
  :expected [true :analyse]})

^{:refer code.manage/plan}
(Test/register
 {:desc "publishes archive-compatible planning over native Work tasks"
  :test (fn [] (let [plan (manage/plan :locate-code {:units [{:source "(ns demo)" :namespace (quote demo) :type :source :path "demo.hal"}] :selector :all})] [(get-in plan [:summary :operation]) (count (:records plan))]))
  :expected [:locate-code 1]})

^{:refer code.manage/legacy-operations}
(Test/register
 {:desc "publishes the complete legacy operation list"
  :test (fn [] [(first manage/legacy-operations) (has? (set manage/legacy-operations) :incomplete-report)])
  :expected [:analyse true]})
