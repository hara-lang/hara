(ns code.test.result-test
  (:require [code.test.checker]
            [code.test.result]))

^{:refer code.test.result/compare}
(Test/check
 [{:name "compare produces passing and failing native results"
   :test (fn []
           (let [passing (code.test.result/compare 1 1)
                 failing (code.test.result/compare 1 2)]
             [(Test/passed? passing) (Test/passed? failing) (Test/failure-count failing)]))
   :expected [true false 1]}])

^{:refer code.test.result/comparison-result}
(Test/check
 [{:name "comparison-result keeps the portable matcher view"
   :test (fn []
           (let [result (code.test.result/comparison-result
                         "fixture" 2 (code.test.checker/exactly 2)
                         (code.test.result/compare 2 (code.test.checker/exactly 2)))]
             [(Test/passed? result) (Test/actual result) (Test/expected result)]))
   :expected [true 2 {:checker/type :exactly :checker/form 2}]}])

^{:refer code.test.result/comparison-passed?}
(Test/check
 [{:name "comparison-passed? follows the native result status"
   :test (fn [] [(code.test.result/comparison-passed? (code.test.result/compare :a :a))
                 (code.test.result/comparison-passed? (code.test.result/compare :a :b))])
   :expected [true false]}])

^{:refer code.test.result/comparison-actual}
(Test/check
 [{:name "comparison-actual reads a comparison actual value"
   :test (fn [] (code.test.result/comparison-actual (code.test.result/compare {:a 1} {:a 1})))
   :expected true}])

^{:refer code.test.result/comparison-expected}
(Test/check
 [{:name "comparison-expected reads a comparison expected value"
   :test (fn [] (code.test.result/comparison-expected (code.test.result/compare {:a 1} {:a 1})))
   :expected true}])

^{:refer code.test.result/comparison-failure-count}
(Test/check
 [{:name "comparison-failure-count reports exact mismatches"
   :test (fn [] (code.test.result/comparison-failure-count (code.test.result/compare 1 2)))
   :expected 1}])

^{:refer code.test.result/comparison-failure}
(Test/check
 [{:name "comparison-failure exposes the native mismatch"
   :test (fn []
           (let [failure (code.test.result/comparison-failure (code.test.result/compare 1 2) 0)]
             [(:failure/actual failure) (:failure/expected failure)]))
   :expected [false true]}])
