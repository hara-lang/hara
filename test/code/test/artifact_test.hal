(ns code.test.artifact-test
  (:require [code.test.artifact :as artifact]))

^{:refer code.test.artifact/+latest+}
(Test/check
 [{:name "provides an isolated latest artifact store"
   :test (fn []
           (let [baseline (deref artifact/+latest+)]
             (try
               (reset! artifact/+latest+ {:status :passed})
               (deref artifact/+latest+)
               (finally
                 (reset! artifact/+latest+ baseline)))))
   :expected {:status :passed}}])
