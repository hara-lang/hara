(ns code.test.checker.schema-test
  (:require [code.test.checker]
            [code.test.checker.schema]))

^{:refer code.test.checker.schema/conforms}
(Test/check
 [{:name "conforms uses typed-schema validation and retains the form"
   :test (fn []
           (let [matcher (code.test.checker.schema/conforms [:map [:name :str]])]
             [(code.test.checker/checker-view matcher)
              (code.test.checker/matches? matcher {:name "Ada"})
              (code.test.checker/matches? matcher {:name 1})]))
   :expected [{:checker/type :typed/schema :checker/form [:map [:name :str]]}
              true false]}])
