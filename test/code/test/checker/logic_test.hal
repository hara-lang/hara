(ns code.test.checker.logic-test
  (:require [code.test.checker :as checker]
            [code.test.checker.logic :as logic]))

^{:refer code.test.checker.logic/is-not}
(Test/check
 [{:name "is-not negates its composed expectation"
   :test (fn [] [(checker/matches? (logic/is-not (checker/exactly 1)) 2)
                 (checker/matches? (logic/is-not (checker/exactly 1)) 1)])
   :expected [true false]}])

^{:refer code.test.checker.logic/any}
(Test/check
 [{:name "any accepts an actual value matching at least one expectation"
   :test (fn [] [(checker/matches? (logic/any (checker/exactly 1) (checker/exactly 2)) 2)
                 (checker/matches? (logic/any (checker/exactly 1) (checker/exactly 2)) 3)])
   :expected [true false]}])

^{:refer code.test.checker.logic/all}
(Test/check
 [{:name "all requires every expectation to match"
   :test (fn [] [(checker/matches? (logic/all (checker/satisfies number?) (checker/satisfies (fn [value] (> value 2)))) 3)
                 (checker/matches? (logic/all (checker/satisfies number?) (checker/satisfies (fn [value] (> value 2)))) 1)])
   :expected [true false]}])
