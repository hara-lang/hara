(ns code.test.command-test
  (:require [code.test.command :as command]
            [code.test.context :as context]
            [code.test.registry :as registry]))

(def fixture-namespace 'code.test.command-test)

(defn cleanup
  []
  (let [path (File/join "/" ".hara/test/latest.edn")]
    (deref (File/delete path {:missing-ok? true}))
    (deref (File/delete (File/join "/" ".hara/test") {:missing-ok? true}))
    (deref (File/delete (File/join "/" ".hara") {:missing-ok? true})))
  (Test/purge)
  (registry/reset)
  (context/reset))

^{:refer code.test.command/selector}
(Test/check
 [{:name "selector defaults to all and converts the first CLI name"
   :test (fn [] [(command/selector []) (command/selector ["code.test.command"])])
   :expected [:all 'code.test.command]}])

^{:refer code.test.command/response}
(Test/check
 [{:name "response forwards parsed argv through the Work-backed runner"
   :test (fn []
           (try
             (registry/register fixture-namespace
                                {:desc "one" :test (fn [] 1) :expected 1 :meta {}})
             (select-keys
              (command/response {:arguments {:argv ["code.test.command"]}})
              [:stderr :exit])
             (finally (cleanup))))
   :expected {:stderr "" :exit 0}}])
