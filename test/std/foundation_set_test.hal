(ns std.foundation-set-test
  (:use code.test))

(def results
  [(fact "root Foundation owns set algebra"
     [(union #{1 2} #{2 3})
      (intersection #{1 2 3} #{2 3 4} #{3 5})
      (difference #{1 2 3} #{2} #{3})]
     => [#{1 2 3} #{3} #{1}])
   (fact "root Foundation owns set relations and selection"
     [(subset? #{1 2} #{1 2 3})
      (subset? #{1 4} #{1 2 3})
      (superset? #{1 2 3} #{1 2})
      (select odd? #{1 2 3 4})]
     => [true false true #{1 3}])])

(pr-str (run '[std.foundation-set-test]))
