(ns std.foundation-set-test)

^{:refer std.foundation/union}
(Test/check
 [{:name "root Foundation owns set algebra"
   :test (fn []
           [(union #{1 2} #{2 3})
            (intersection #{1 2 3} #{2 3 4} #{3 5})
            (difference #{1 2 3} #{2} #{3})])
   :expected [#{1 2 3} #{3} #{1}]}
  {:name "root Foundation owns set relations and filtering"
   :test (fn []
           [(subset? #{1 2} #{1 2 3})
            (subset? #{1 4} #{1 2 3})
            (superset? #{1 2 3} #{1 2})
            (filter odd? #{1 2 3 4})])
   :expected [true false true #{1 3}]}])
