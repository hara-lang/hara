(ns std.config.ext.json-test
  (:require [std.config.ext.json :as json]))

^{:refer std.config.ext.json/keyword-key}
(Test/check [{:name "turns string keys into keywords and leaves other keys alone"
              :test (fn [] [(json/keyword-key "entry") (json/keyword-key :entry)])
              :expected [:entry :entry]}])

^{:refer std.config.ext.json/keywordize-map}
(Test/check [{:name "keywordizes a map and its nested map values"
              :test (fn [] (json/keywordize-map {"outer" {"inner" 2}}))
              :expected {:outer {:inner 2}}}])

^{:refer std.config.ext.json/keywordize}
(Test/check [{:name "recursively preserves collection shape while keywordizing map keys"
              :test (fn [] (json/keywordize [{"first" 1} {"second" [2]}]))
              :expected [{:first 1} {:second [2]}]}])

^{:refer std.config.ext.json/read-json}
(Test/check [{:name "reads JSON into recursively keywordized Hara data"
              :test (fn [] (json/read-json "{\"enabled\":true,\"items\":[{\"name\":\"hara\"}]}"))
              :expected {:enabled true :items [{:name "hara"}]}}])
