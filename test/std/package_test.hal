(ns std.package-test
  (:require [std.package]
            [std.package.project :as project]))

(Test/check
 [{:name "publishes runtime, generic build, and HBX leaves without tool dependencies"
   :test (fn []
           [(= (std.package/catalog) (std.native.Package/catalog))
            (= (project/project-check ".")
               {:identity "hara/foundation" :version "0.1.23"})
            (std.package/hbx-detect (std.package/hbx-pack []))
            (mapv identity (std.package/hbx-unpack (std.package/hbx-pack [])))])
   :expected [true true :hbx []]}
  {:name "publishes the Foundation specification reader boundary"
   :test (fn []
           (try
             (std.package/read-spec-content
              "content/01-lang/000-metaspec/draft/metaspec-metaspec.edn")
             false
             (catch error
               (= "hara:hara/foundation.specs"
                  (:package/coordinate (ex-data error))))))
   :expected true}])
