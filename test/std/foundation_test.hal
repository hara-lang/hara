(ns std.foundation-test)

(intern-in [published-when std.foundation/when])

^{:refer std.foundation/type}
(Test/check
 [{:name "returns the portable runtime type keyword"
   :test (fn [] [(type 42) (type "hara") (type :foundation)])
   :expected [:std.native.Long :std.native.String :std.native.Keyword]}])

(defprotocol IDeclarationParent
  (declaration-parent [self]))

(defprotocol IDeclarationChild
  [IDeclarationParent]
  (declaration-child [self]))

(defprotocol IDeclarationResult
  (declaration-result [self]))

(def declaration-protocol-result
  (defprotocol IDeclarationCaptured
    (declaration-captured [self])))

(def declaration-struct-result
  (defstruct DeclarationCaptured []))

(def declaration-mutable-result
  (defmutable DeclarationMutableCaptured []))

(defstruct DeclarationValue [value])

(defmutable DeclarationCounter [value])

(defstruct DeclarationInline [value]
  IDeclarationResult
  (declaration-result [self] (:value self)))

(def declaration-extend-type-result
  (extend-type DeclarationValue
    IDeclarationParent
    (declaration-parent [self] (:value self))))

(def declaration-extend-type-child-result
  (extend-type DeclarationValue
    IDeclarationChild
    (declaration-child [self] (+ (:value self) 1))))

(def declaration-extend-type-mutable-result
  (extend-type DeclarationCounter
    IDeclarationChild
    (declaration-child [self] (field self :value))))

(def declaration-multimethod-result
  (defmulti declaration-classify
    (fn [value] value)))

(def declaration-method-result
  (defmethod declaration-classify :value [value] 7))

(def declaration-default-method-result
  (defmethod declaration-classify :default [value] 9))

^{:refer std.foundation/defstruct}
(Test/check
 [{:name "publishes an immutable constructor, inline implementations, and a nil result"
   :test (fn []
           [(= declaration-struct-result nil)
            (declaration-result (DeclarationInline 3))])
   :expected [true 3]}])

^{:refer std.foundation/defmutable}
(Test/check
 [{:name "publishes a mutable constructor and returns nil"
   :test (fn []
           [(= declaration-mutable-result nil)
            (field (DeclarationCounter 4) :value)])
   :expected [true 4]}])

^{:refer std.foundation/defprotocol}
(Test/check
 [{:name "publishes protocol methods and inherits a leading parent vector"
   :test (fn []
           [(= declaration-protocol-result IDeclarationCaptured)
            (Base/satisfies? IDeclarationChild (DeclarationValue 4))
            (Base/satisfies? IDeclarationParent (DeclarationValue 4))])
   :expected [true true true]}
  {:name "rejects duplicate protocol methods during macro expansion"
   :test (fn []
           (try
             (do (std.native.Runtime/macroexpand-1
                  '(defprotocol IDeclarationInvalid
                     (same [self])
                     (same [self])) )
                 false)
             (catch error true)))
   :expected true}])

^{:refer std.foundation/extend-type}
(Test/check
 [{:name "returns the protocol after registering a named type implementation"
   :test (fn []
           [(= declaration-extend-type-result IDeclarationParent)
            (declaration-parent (DeclarationValue 5))])
   :expected [true 5]}])

^{:refer std.foundation/extend-type}
(Test/check
 [{:name "registers each named type independently and returns the protocol"
   :test (fn []
           [(= declaration-extend-type-child-result IDeclarationChild)
            (= declaration-extend-type-mutable-result IDeclarationChild)
            (declaration-child (DeclarationValue 5))
            (declaration-child (DeclarationCounter 6))])
   :expected [true true 6 6]}])

^{:refer std.foundation/defmulti}
(Test/check
 [{:name "publishes a multimethod through Base and returns it"
   :test (fn []
           [(= declaration-multimethod-result declaration-classify)
            (declaration-classify :value)])
   :expected [true 7]}])

^{:refer std.foundation/defmethod}
(Test/check
 [{:name "registers dispatch and default multimethod implementations"
   :test (fn []
           [(= declaration-method-result nil)
            (= declaration-default-method-result nil)
            (declaration-classify :other)])
   :expected [true true 9]}])

^{:refer std.foundation/list}
(Test/check
 [{:name "constructs a list from all values"
   :test (fn [] (vec (std.foundation/list 1 2 3)))
   :expected [1 2 3]}])

^{:refer std.foundation/vector}
(Test/check
 [{:name "constructs a vector from all values"
   :test (fn [] (std.foundation/vector 1 2 3))
   :expected [1 2 3]}])

^{:refer std.foundation/array}
(Test/check
 [{:name "constructs a mutable array from all values"
   :test (fn []
           (let [value (std.foundation/array 1 2 3)]
             [(std.foundation/array? value)
              (std.foundation/count value)
              (std.foundation/nth value 1)]))
   :expected [true 3 2]}])

^{:refer std.foundation/object}
(Test/check
 [{:name "constructs a mutable object from alternating entries"
   :test (fn []
           (let [value (std.foundation/object "answer" 42)]
             [(std.foundation/object? value)
              (std.foundation/get value "answer")]))
   :expected [true 42]}])

^{:refer std.foundation/bytes}
(Test/check
 [{:name "constructs an opaque byte buffer through Bytes/new"
   :test (fn []
           (let [value (std.foundation/bytes 1 2 -3)]
             [(std.native.Bytes/count value)
              (std.native.Bytes/get value 2)]))
   :expected [3 253]}])

^{:refer std.foundation/uuid}
(Test/check
 [{:name "constructs UUID values with portable type identity"
   :test (fn []
           (let [random (std.foundation/uuid)
                 fixed (std.foundation/uuid "00000000-0000-0000-0000-000000000000")
                 bits (std.foundation/uuid 0 1)]
             [(uuid? random)
              (= (type random) :std.native.UUID)
              (str fixed)
              (str bits)]))
   :expected [true true
              "#uuid \"00000000-0000-0000-0000-000000000000\""
              "#uuid \"00000000-0000-0000-0000-000000000001\""]}])

^{:refer std.foundation/hash}
(Test/check
 [{:name "dispatches hashing through Base/hash"
   :test (fn [] [(long? (std.foundation/hash [1 2]))
                 (= (std.foundation/hash [1 2])
                    (std.foundation/hash (std.foundation/list 1 2)))])
   :expected [true true]}
  {:name "rejects zero-arity hashing"
   :test (fn []
           (try
             (do (std.foundation/hash) false)
             (catch error true)))
   :expected true}])

^{:refer std.foundation/uuid?}
(Test/check
 [{:name "recognizes UUID values by portable type"
   :test (fn [] [(std.foundation/uuid? (std.foundation/uuid "00000000-0000-0000-0000-000000000000"))
                 (std.foundation/uuid? :not-a-uuid)])
   :expected [true false]}])

^{:refer std.foundation/regexp?}
(Test/check
 [{:name "recognizes compiled regular expressions"
   :test (fn [] [(std.foundation/regexp? (std.foundation/regexp "x"))
                 (std.foundation/regexp? "x")])
   :expected [true false]}])

^{:refer std.foundation/str}
(Test/check
 [{:name "concatenates multiple values without recursive allocation"
   :test (fn [] [(str "IWork" "Agent" "Driver" nil)
                 (str "answer=" 42)])
   :expected ["IWorkAgentDriver" "answer=42"]}
  {:name "appends character text instead of readable character syntax"
   :test (fn [] [(str \a)
                 (str \a \newline "done")
                 (str :hello)
                 (str 'hello)
                 (str [1 "a"])])
   :expected ["a"
              "a\ndone"
              ":hello"
              "hello"
              "[1 \"a\"]"]}])

^{:refer std.foundation/pr-str}
(Test/check
 [{:name "renders readable values and separates multiple values"
   :test (fn [] [(pr-str \a)
                 (pr-str nil)
                 (pr-str \a :hello)
                 (pr-str [1 "a"])])
   :expected ["\\a"
              "nil"
              "\\a :hello"
              "[1 \"a\"]"]}])

^{:refer std.foundation/apply}
(Test/check
 [{:name "applies leading arguments and a final sequence"
   :test (fn [] (std.foundation/apply + 1 [2 3]))
   :expected 6}])

^{:refer std.foundation/ex?}
(Test/check
 [{:name "recognizes portable Exception values"
   :test (fn [] [(std.foundation/ex? (Exception/new "fixture" {:kind :fixture}))
                 (std.foundation/ex? :not-an-exception)])
   :expected [true false]}])

^{:refer std.foundation/ex}
(Test/check
 [{:name "prints and reads canonical #ex literals without the legacy constructor"
   :test (fn []
           (let [error (ex :argument {:input :fixture} :ex/message "bad input")
                 reread (Edn/read (Edn/write error))]
             [(String/starts-with? (Edn/write error) "#ex[")
              (ex-message reread)
              (ex-data reread)
              (nil? (std.foundation/resolve (symbol (str "std.foundation/" "ex" "-" "info"))))]))
   :expected [true
              "bad input"
              {:input :fixture :ex/code :hara/argument :ex/class :ex.class/argument :ex/message "bad input"}
              true]}])

^{:refer std.foundation/get}
(Test/check
 [{:name "dispatches associative access through ILookup"
   :test (fn [] [(std.foundation/get {:a 1} :a)
                 (std.foundation/get {:a 1} :missing)
                 (std.foundation/get {:a 1} :missing :fallback)])
   :expected [1 nil :fallback]}])

^{:refer std.foundation/count}
(Test/check
 [{:name "dispatches collection size through ICount"
   :test (fn [] [(std.foundation/count [1 2 3])
                 (std.foundation/count {})])
   :expected [3 0]}])

^{:refer std.foundation/empty}
(Test/check
 [{:name "dispatches empty-value construction through IEmpty"
   :test (fn [] [(std.foundation/empty [1 2 3])
                 (std.foundation/empty {:a 1})])
   :expected [[] {}]}])

^{:refer std.foundation/nth}
(Test/check
 [{:name "dispatches indexed access through INth"
   :test (fn [] [(std.foundation/nth [10 20 30] 1)
                 (std.foundation/nth [10 20] 1)])
   :expected [20 20]}])

^{:refer std.foundation/conj}
(Test/check
 [{:name "conjoins values through IConj"
   :test (fn [] [(std.foundation/conj [1] 2)
                 (std.foundation/conj [1] 2 3)
                 (std.foundation/conj {:a 1} (std.foundation/pair :b 2))])
   :expected [[1 2] [1 2 3] {:a 1 :b 2}]}
  {:name "accepts vector entries and rejects list values when conjoining to a map"
   :test (fn [] [(try (std.foundation/conj {} [:a 1]) false
                      (catch error true))
                 (try (std.foundation/conj {} '(:a 1)) false
                      (catch error true))])
   :expected [false true]}])

^{:refer std.foundation/cons}
(Test/check
 [{:name "conses a value through ICons"
     :test (fn [] (std.foundation/cons 1 [2 3]))
     :expected '(1 2 3)}])

^{:refer std.foundation/pair}
(Test/check
 [{:name "constructs a dedicated map entry"
   :test (fn [] (let [entry (std.foundation/pair :a 1)]
                  [(type entry)
                   (std.foundation/count entry)
                   (std.foundation/nth entry 0)
                   (std.foundation/nth entry 1)
                   (std.foundation/vector? entry)
                   (std.foundation/sequential? entry)
                   (std.foundation/map-entry? entry)]))
   :expected [:std.native.MapEntry 2 :a 1 false false true]}
  {:name "exposes pair indexing and iteration without collection capabilities"
   :test (fn [] (let [entry (std.foundation/pair :a 1)]
                  [(satisfies? IPair entry)
                   (satisfies? ICount entry)
                   (satisfies? INth entry)
                   (std.foundation/get entry 0 :missing)
                   (std.foundation/get entry 1 :missing)
                   (std.foundation/get entry 2 :missing)
                   (satisfies? IIter entry)
                   (std.foundation/vec entry)
                   (satisfies? ISequential entry)
                   (satisfies? ILinearType entry)
                   (satisfies? IColl entry)
                   (satisfies? IConj entry)
                   (satisfies? IEmpty entry)]))
   :expected [true true true :a 1 :missing true [:a 1]
              false false false false false]}])

