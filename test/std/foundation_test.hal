^{:refer std.foundation/reduce-in}
(Test/check
 [{:name "reduces into a persistent collection"
   :test (fn [] (std.foundation/reduce-in [] conj [1 2 3]))
   :expected [1 2 3]}
  {:name "honors reduced early termination"
   :test (fn []
           (std.foundation/reduce-in 0
                        (fn [total value]
                          (if (= value 3)
                            (std.foundation/reduced total)
                            (+ total value)))
                        [1 2 3 4]))
   :expected 3}])

