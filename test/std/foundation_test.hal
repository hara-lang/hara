  {:name "removes one member from a set"
   :test (fn [] (std.foundation/dissoc #{:a :b} :a))
   :expected #{:b}}
  {:name "removes multiple keys"
   :test (fn [] (std.foundation/dissoc {:a 1 :b 2 :c 3} :a :c))
   :expected {:b 2}}
  {:name "returns nil when removing from nil"
   :test (fn [] (std.foundation/dissoc nil :a))
   :expected nil}])

