^{:refer std.foundation/->}
(Test/check
 [{:name "supports positional and explicit placeholder threading"
   :test (fn [] [(std.foundation/-> 1 inc (- 10 %))
                 (std.foundation/-> 2 (+ % %) (* % %))])
   :expected [8 16]}
  {:name "does not treat quoted percent as a placeholder"
   :test (fn [] (std.foundation/-> 1 (vector '%)))
   :expected [1 '%]}])

^{:refer std.foundation/->>}
(Test/check
 [{:name "supports thread-last insertion and explicit placement"
   :test (fn [] [(std.foundation/->> [1 2 3] (map inc) (reduce +))
                 (std.foundation/->> [1 2 3] (reduce + %))])
   :expected [9 6]}])

