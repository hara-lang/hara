^{:refer std.foundation/swap-return!}
(Test/check
 [{:name "returns output from the successful atomic replacement"
   :test (fn []
           (let [reference (atom 10)
                 output (std.foundation/swap-return!
                         reference
                         (fn [value] [value (+ value 5)]))]
             [output (deref reference)]))
   :expected [10 15]}
  {:name "optionally returns output together with new state"
   :test (fn []
           (let [reference (atom {:count 1})]
             (std.foundation/swap-return!
              reference
              (fn [value]
                [(:count value) (update value :count inc)])
              true)))
   :expected [1 {:count 2}]}])

