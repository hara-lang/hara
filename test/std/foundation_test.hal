^{:refer std.foundation/form?}
(Test/check
 [{:name "recognizes List, Cons, and lazy Seq forms"
   :test (fn [] [(std.foundation/form? '(a b))
                 (std.foundation/form? (cons 'a (cons 'b nil)))
                 (std.foundation/form? (std.foundation/take 2 (std.foundation/iterate std.foundation/inc 0)))
                 (std.foundation/form? [1 2])])
   :expected [true true true false]}])

^{:refer std.foundation/walk}
(Test/check
 [{:name "walks Cons forms as source forms"
   :test (fn [] (std.foundation/walk std.foundation/inc identity (cons 1 (cons 2 nil))))
   :expected '(2 3)}
  {:name "walks metadata-free vectors without attaching metadata"
   :test (fn [] (std.foundation/walk std.foundation/inc identity [1 2]))
   :expected [2 3]}])

^{:refer std.foundation/postwalk}
(Test/check
 [{:name "walks metadata-free vectors in post-order"
   :test (fn [] (std.foundation/postwalk (fn [value] (if (number? value) (inc value) value)) [1 2]))
   :expected [2 3]}])

^{:refer std.foundation/prewalk}
(Test/check
 [{:name "walks metadata-free vectors in pre-order"
   :test (fn [] (std.foundation/prewalk (fn [value] (if (number? value) (inc value) value)) [1 2]))
   :expected [2 3]}])

