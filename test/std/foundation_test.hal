 [{:name "selects qualified keys with an optional namespace"
   :test (fn [] [(std.foundation/qualified-keys {:a 1 :ns/b 2 :other/c 3})
                 (std.foundation/qualified-keys {:a 1 :ns/b 2 :other/c 3} :ns)])
   :expected [{:ns/b 2 :other/c 3} {:ns/b 2}]}])

