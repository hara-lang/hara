^{:refer std.foundation/apply-with}
(Test/check
 [{:name "returns an object when no function is supplied"
   :test (fn [] (std.foundation/apply-with 2))
   :expected 2}
  {:name "prepends the object to function arguments"
   :test (fn [] (std.foundation/apply-with 2 + 1 2 3))
   :expected 8}
  {:name "preserves the object when function is nil"
   :test (fn [] (std.foundation/apply-with 2 nil 1 2))
   :expected 2}
  {:name "works as an object-first threaded operation"
   :test (fn [] (-> 2 (std.foundation/apply-with + 1 2 3)))
   :expected 8}])

^{:refer std.foundation/tap}
(Test/check
 [{:name "calls an observer and preserves the object"
   :test (fn []
           (let [seen (atom nil)
                 object {:value 7}
                 output (std.foundation/tap object
                               (fn [value label]
                                 (reset! seen [value label])
                                 :ignored)
                               :observed)]
             [output @seen]))
   :expected [{:value 7} [{:value 7} :observed]]}
  {:name "requires an observer function"
   :test (fn []
           (try
             (do (std.foundation/tap :value nil) false)
             (catch error true)))
   :expected true}])

