   :test (fn [] (vec (std.foundation/map + [1 2] [10 20])))
   :expected [11 22]}
  {:name "preserves vector shape and metadata"
   :test (fn []
           (let [output (std.foundation/map inc (with-meta (vec [1 2]) {:tag :sample}))]
             [output (std.foundation/meta output)]))
   :expected [[2 3] {:tag :sample}]}])

^{:refer std.foundation/filter}
(Test/check [])

^{:refer std.foundation/take}
(Test/check [])

^{:refer std.foundation/drop}
(Test/check
 [{:name "keeps Seq pipelines lazy and reusable"
   :test (fn []
           (let [output (std.foundation/drop 1 (std.foundation/iterate std.foundation/inc 0))]
             [(std.foundation/seq? output)
              (std.foundation/first output)
              (std.foundation/first output)
              (std.foundation/first (std.foundation/rest output))]))
   :expected [true 1 1 2]}
  {:name "keeps Iterator pipelines lazy and consumptive"
   :test (fn []
           (let [output (std.foundation/drop 1 (std.foundation/iter [1 2 3]))]
             [(std.foundation/iter? output)
              (std.foundation/iter-next output)
              (std.foundation/iter-next output)]))
   :expected [true 2 3]}
  {:name "preserves eager persistent collection behavior"
   :test (fn []
           [(std.foundation/drop 1 [1 2 3])
            (std.foundation/drop 1 '(a b c d))])
   :expected [[2 3] (quote (b c d))]}
  {:name "supports the original lazy thread-last pipeline"
   :test (fn []
           (->> (std.foundation/iterate std.foundation/inc 0)
                (std.foundation/drop 1)
                (std.foundation/take-while (fn [value] (< value 5)))
                (std.foundation/filter (fn [value] (= 0 (mod value 2))))
                (std.foundation/first)))
   :expected 2}
  {:name "preserves list order"
   :test (fn [] (std.foundation/drop 1 '(a b c d)))
   :expected '(b c d)}])

