(Test/check [])

^{:refer std.foundation/read-forms}
(Test/check [])

^{:refer std.foundation/read-forms-spanned}
(Test/check
 [{:name "reads nested source positions without evaluating forms"
   :test (fn []
           (let [node (first (std.foundation/read-forms-spanned "; comment\n(defn sample [x]\n  (inc x))"))
                 call (last (:children node))
                 metadata (first (std.foundation/read-forms-spanned "^{:refer demo.subject/run}\n(def run [] 1)"))
                 unevaluated (first (std.foundation/read-forms-spanned "(throw (ex :host {} :ex/message \"not evaluated\"))"))]
             [(= (:form node) (quote (defn sample [x] (inc x))))
              (= [(:offset (:start node)) (:line (:start node)) (:column (:start node))
                  (:offset (:end node)) (:line (:end node)) (:column (:end node))]
                 [10 2 1 37 3 11])
              (= (:form call) (quote (inc x)))
              (= [(:offset (:start call)) (:line (:start call)) (:column (:start call))
                  (:offset (:end call)) (:line (:end call)) (:column (:end call))]
                 [29 3 3 36 3 10])
              (= (:refer (meta (:form metadata))) (quote demo.subject/run))
              (= (:form unevaluated) (quote (throw (ex :host {} :ex/message "not evaluated"))))]))
   :expected [true true true true true true]}])

^{:refer std.foundation/result?}
(Test/check
 [{:name "recognizes native Results"
   :test (fn []
           (let [created (std.foundation/result :success 42 {:source :test})
                 synchronized (std.foundation/result 42)]
             [(std.foundation/result? created)
              (std.foundation/result? nil)
              (:status created)
              (:data created)
              (:error created)
              (:context created)
              (:status synchronized)
              (:data synchronized)]))
   :expected [true false :success 42 nil {:source :test} :success 42]}])

^{:refer std.foundation/schema?}
(Test/check
 [{:name "recognizes native SchemaType values"
   :test (fn []
           (let [compiled (std.foundation/schema :int)]
             [(std.foundation/schema? compiled)
              (std.foundation/schema? nil)]))
   :expected [true false]}])

^{:refer std.foundation/ns-current}
(Test/check
 [{:name "returns the active caller namespace"
   :test (fn [] (std.foundation/ns-current))
   :expected 'std.foundation-test}
  {:name "does not publish removed namespace aliases"
   :test (fn []
           (mapv nil?
                 [(std.foundation/resolve 'std.foundation/env-current)
                  (std.foundation/resolve 'std.foundation/current-namespace)
                  (std.foundation/resolve 'std.foundation/the-ns)
                  (std.foundation/resolve 'std.foundation/env-vars)
                  (std.foundation/resolve 'std.foundation/env-namespaces)
                  (std.foundation/resolve 'std.foundation/env-namespace)
                  (std.foundation/resolve 'std.foundation/env-resolve)
                  (std.foundation/resolve 'ns:create)
                  (std.foundation/resolve 'ns:list)
                  (std.foundation/resolve 'ns:map)
                  (std.foundation/resolve 'ns:find)
                  (std.foundation/resolve 'ns:name)
                  (std.foundation/resolve 'ns:aliases)
                  (std.foundation/resolve 'ns:imports)]))
   :expected [true true true true true true true true true true true true true true]}])

