^{:refer std.foundation/if-let}
(Test/check
 [{:name "binds dependent pairs from left to right"
   :test (fn [] (std.foundation/if-let [a 2 b (+ a 3)] (+ a b) :failed))
   :expected 7}
  {:name "uses the shared alternative at the first falsey binding"
   :test (fn [] (std.foundation/if-let [a nil b (+ a 3)] (+ a b) :failed))
   :expected :failed}
  {:name "tests the raw value before destructuring"
   :test (fn [] (std.foundation/if-let [[a b] [1 2]] (+ a b) :failed))
   :expected 3}])

^{:refer std.foundation/when-let}
(Test/check
 [{:name "evaluates the body after every binding succeeds"
   :test (fn [] (std.foundation/when-let [a 2 b (+ a 3)] (+ a b)))
   :expected 7}
  {:name "returns nil at the first falsey binding"
   :test (fn [] (std.foundation/when-let [a false b 3] (+ a b)))
   :expected nil}])

^{:refer std.foundation/for}
(Test/check
 [{:name "builds nested comprehensions with destructuring"
   :test (fn []
           (vec (std.foundation/for [[a b] [[1 2] [3 4]]
                        scale [10 100]]
                  (* (+ a b) scale))))
   :expected [30 300 70 700]}
  {:name "supports sequential let when and while modifiers"
   :test (fn []
           (vec (std.foundation/for [x (range 8)
                        :let [y (* x 2)
                              z (+ y 1)]
                        :when (not (= 0 (mod z 3)))
                        :while (< z 12)]
                  [x y z])))
   :expected [[0 0 1] [2 4 5] [3 6 7] [5 10 11]]}
  {:name "scopes while to its associated inner binding"
   :test (fn []
           (vec (std.foundation/for [x [1 2]
                        y [1 2 3 4]
                        :while (< y 3)]
                  [x y])))
   :expected [[1 1] [1 2] [2 1] [2 2]]}
  {:name "consumes a native iterator in order"
   :test (fn []
           (let [calls (atom 0)
                 values (std.foundation/for [x (Iter/iter-range 0 3)]
                          (do (swap! calls inc) x))]
             [(vec values) @calls]))
   :expected [[0 1 2] 3]}
  {:name "collects eagerly into a final destination"
   :test (fn []
           [(std.foundation/for [x [1 2 2 3] :into #{}] x)
            (std.foundation/for [x [1 2] :into [:start]] (* x 10))
            (std.foundation/for [x [1 2] :into {:zero 0}] (std.foundation/pair x (* x x)))])
   :expected [#{1 2 3} [:start 10 20] {:zero 0 1 1 2 4}]}
  {:name "rejects invalid into placement"
   :test (fn []
           (try
             (do (macroexpand '(std.foundation/for [x [1] :into [] :when true] x)) false)
             (catch error true)))
   :expected true}])

^{:refer std.foundation/doseq}
(Test/check
 [{:name "executes eagerly with comprehension modifiers and returns nil"
   :test (fn []
           (let [seen (atom [])
                 output (std.foundation/doseq [x (range 8)
                                  :let [y (* x 2)]
                                  :when (not (= 0 (mod y 3)))
                                  :while (< y 11)]
                          (swap! seen conj [x y]))]
             [output @seen]))
   :expected [nil [[1 2] [2 4] [4 8] [5 10]]]}
  {:name "rejects into destinations"
   :test (fn []
           (try
             (do (macroexpand '(std.foundation/doseq [x [1] :into []] x)) false)
             (catch error true)))
   :expected true}])

^{:refer std.foundation/dotimes}
(Test/check
 [{:name "evaluates the bound once and returns nil"
   :test (fn []
           (let [bounds (atom 0)
                 seen (atom [])
                 output (std.foundation/dotimes [index (do (swap! bounds inc) 4)]
                          (swap! seen conj index))]
             [output @bounds @seen]))
   :expected [nil 1 [0 1 2 3]]}
  {:name "does not execute for a non-positive bound"
   :test (fn []
           (let [seen (atom [])]
             [(std.foundation/dotimes [index 0] (swap! seen conj index))
              (std.foundation/dotimes [index -2] (swap! seen conj index))
              @seen]))
   :expected [nil nil []]}])

^{:refer std.foundation/while}
(Test/check
 [{:name "reevaluates its test and returns nil"
   :test (fn []
           (let [index (atom 0)
                 seen (atom [])
                 output (std.foundation/while (< @index 3)
                          (swap! seen conj @index)
                          (swap! index inc))]
             [output @index @seen]))
   :expected [nil 3 [0 1 2]]}])

^{:refer std.foundation/cond->}
(Test/check
 [{:name "threads every matching clause pair"
   :test (fn [] (std.foundation/cond-> 1 true inc true (* 3)))
   :expected 6}])

^{:refer std.foundation/cond->>}
(Test/check
 [{:name "threads every matching clause pair last"
   :test (fn [] (std.foundation/cond->> 1 true inc true (* 3)))
   :expected 6}])

^{:refer std.foundation/with-ns}
(Test/check [])

^{:refer std.foundation/intern-in}
(Test/check
 [{:name "publishes macro Vars as usable macros"
   :test (fn [] (macroexpand-1 '(published-when true 1)))
   :expected '(if true (do 1) nil)}
  {:name "retains publication source metadata in generated intern-var forms"
   :test (fn []
           (let [form '(intern-in [published source/value])
                 expanded (std.foundation/macroexpand-1 form)
                 generated (first expanded)
                 metadata (nth generated 4)]
             [(= (get metadata :line)
                 (get (meta (second form)) :line))
              (= (get metadata :column)
                 (get (meta (second form)) :column))
              (= (get metadata :file)
                 (get (meta form) :file))]))
   :expected [true true true]}])

^{:refer std.foundation/intern-all}
(Test/check
 [{:name "emits macro publication metadata for every public source Var"
   :test (fn []
           (let [expanded (std.foundation/macroexpand-1 '(intern-all std.foundation))
                 macro-entry (first
                              (filter
                               (fn [form]
                                 (= (nth form 2) '(quote when)))
                               expanded))]
             [(= (count expanded)
                 (count (std.foundation/ns-publics 'std.foundation)))
              (= (nth macro-entry 4) {:macro true})]))
   :expected [true true]}])

