   :expected 42}])

^{:refer std.foundation/eval}
(Test/check
 [{:name "evaluates a form value"
   :test (fn [] (std.foundation/eval '(+ 19 23)))
   :expected 42}
  {:name "resolves caller namespace definitions inside a function"
   :test (fn []
           (do
             (def eval-visible-value 42)
             ((fn [] (std.foundation/eval 'eval-visible-value)))))
   :expected 42}])

^{:refer std.foundation/defonce}
(Test/check
  [{:name "does not replace an existing Var root"
   :test (fn []
           (do
             (std.foundation/defonce retained-value (atom 1))
             (swap! retained-value inc)
             (std.foundation/defonce retained-value (atom 99))
             (deref retained-value)))
   :expected 2}
  {:name "expands through the non-loading Base resolver"
   :test (fn []
           (std.foundation/macroexpand-1
            '(std.foundation/defonce expanded-value 42)))
   :expected '(if (Base/resolve (quote std.foundation-test/expanded-value))
                  (Base/resolve (quote std.foundation-test/expanded-value))
                  (Runtime/eval (quote (def expanded-value 42))))}])

