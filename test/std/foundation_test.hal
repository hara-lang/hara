^{:refer std.foundation/merge-with}
(Test/check
 [{:name "combines duplicate keys across maps"
   :test (fn [] (std.foundation/merge-with + {:a 1} {:a 2} {:b 3} nil))
   :expected {:a 3 :b 3}}
  {:name "returns an empty map with no sources"
   :test (fn [] (std.foundation/merge-with +))
   :expected {}}])

^{:refer std.foundation/merge}
(Test/check
 [{:name "merges sources left to right and skips nil"
   :test (fn [] (std.foundation/merge {:a 1} nil {:a 2 :b 3}))
   :expected {:a 2 :b 3}}
  {:name "returns an empty map with no sources"
   :test (fn [] (std.foundation/merge))
   :expected {}}])

^{:refer std.foundation/merge-nested}
(Test/check
 [{:name "merges nested maps from left to right"
   :test (fn [] (std.foundation/merge-nested {:a {:b {:c 1 :d 2}}}
                                {:a {:b {:c 3}}}
                                {:e 4}))
   :expected {:a {:b {:c 3 :d 2}} :e 4}}
  {:name "replaces nested maps with later scalar values"
   :test (fn [] (std.foundation/merge-nested {:a {:b {:c 3}}} {:a {:b 3}}))
   :expected {:a {:b 3}}}])

^{:refer std.foundation/dissoc-in}
(Test/check
 [{:name "removes a nested value and empty parents"
   :test (fn [] (std.foundation/dissoc-in {:a {:b {:c 1}} :x 2} [:a :b :c]))
   :expected {:x 2}}])

^{:refer std.foundation/transpose}
(Test/check
 [{:name "exchanges map keys and values"
   :test (fn [] (std.foundation/transpose {:a 1 :b 2 :c 3}))
   :expected {1 :a 2 :b 3 :c}}])

^{:refer std.foundation/find-at}
(Test/check
 [{:name "returns the first matching index"
   :test (fn [] [(std.foundation/find-at even? [1 3 4 6])
                 (std.foundation/find-at keyword? [1 2])])
   :expected [2 -1]}])

^{:refer std.foundation/insert-at}
(Test/check
 [{:name "inserts one or more values at an index"
   :test (fn [] (std.foundation/insert-at [:a :b] 1 :x :y))
   :expected [:a :x :y :b]}])

^{:refer std.foundation/remove-at}
(Test/check
 [{:name "removes one or more values at an index"
   :test (fn [] [(std.foundation/remove-at [:a :b :c :d] 2)
                 (std.foundation/remove-at [:a :b :c :d] 1 2)])
   :expected [[:a :b :d] [:a :d]]}])

^{:refer std.foundation/qualified-keys}
