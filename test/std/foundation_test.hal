   :expected {:ns/a 1 :other/b 2}}])

^{:refer std.foundation/unqualify-keys}
(Test/check
 [{:name "unqualifies every keyword or one namespace"
   :test (fn [] [(std.foundation/unqualify-keys {:a 1 :ns/b 2 :other/c 3})
                 (std.foundation/unqualify-keys {:a 1 :ns/b 2 :other/c 3} :ns)])
   :expected [{:a 1 :b 2 :c 3}
              {:a 1 :b 2 :other/c 3}]}])

