^{:refer std.foundation/gensym}
(Test/check
 [{:name "returns distinct symbols with the requested prefix"
   :test (fn [] (let [first-symbol (std.foundation/gensym "test")
                      second-symbol (std.foundation/gensym "test")]
                  [(not= first-symbol second-symbol)
                   (= "test" (std.foundation/subs (name first-symbol) 0 4))]))
   :expected [true true]}])

^{:refer std.foundation/macroexpand-1}
(Test/check
 [{:name "expands one macro layer"
   :test (fn [] (std.foundation/macroexpand-1 '(when true 1)))
   :expected '(if true (do 1) nil)}])

^{:refer std.foundation/ns-alias-state}
(Test/check
 [{:name "reports the lifecycle state of a resolver-visible global alias"
   :test (fn []
           (do
             (require [std.foundation.string])
             (let [state (std.foundation/ns-alias-state 'str)]
               [(get state :alias)
                (get state :target)
                (or (= :loaded (get state :state))
                    (= :unloaded (get state :state)))])))
   :expected ['str 'std.foundation.string true]}])

^{:refer std.foundation/intern-var}
(Test/check
 [{:name "keeps source location metadata ahead of publication metadata"
   :test (fn []
           (let [source (var std.foundation/list)
                 source-meta (meta source)
                 published (std.foundation/intern-var
                            'std.foundation
                            'list
                            source
                            {:file "facade.hal" :line 999 :column 4})
                 published-meta (meta published)]
             [(= (get published-meta :file)
                 (get source-meta :file))
             (= (get published-meta :line)
                 (get source-meta :line))
             (= (get published-meta :column)
                 (get source-meta :column))]))
   :expected [true true true]}
  {:name "publishes a source macro Var through the direct function"
   :test (fn []
           (let [published (std.foundation/intern-var
                            'std.foundation-test
                            'published-when-var
                            (var std.foundation/when)
                            {})]
             [(:macro (meta published))
              (std.foundation/macroexpand-1 '(published-when-var true 1))]))
   :expected [true '(if true (do 1) nil)]}])

^{:refer std.foundation/eval-in-ns}
(Test/check
 [{:name "evaluates forms in an existing namespace"
