^{:refer std.block.navigate/swap :added "3.0" :class [:nav/edit]}
(Test/check
 [{:name "applies a function to the element at the current cursor position, replacing it with the result"
   :test (fn []
             (-> (parse-string "(0  #|1   2 3)")
                 (position-right) (swap inc)
                 display-navigator))
   :expected "<0,4> (0  |2   2 3)"}])

^{:refer std.block.navigate/update-children :added "3.0" :class [:nav/edit]}
(Test/check
 [{:name "replaces the current children"
   :test (fn []
             (-> (update-children (parse-string "[1 2 3]")
                                  [(construct/block 4) (construct/space) (construct/block 5)])
                 display-navigator))
   :expected "<0,0> |[4 5]"}])

^{:refer std.block.navigate/line-info :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "returns the line info for the current block #1"
   :test (fn [] (line-info (parse-string "[1 \\n  2 3]")))
   :expected {:col 1 :end-col 12 :end-row 1 :row 1}}
  {:name "returns the line info for the current block #2"
   :test (fn [] (line-info (parse-string "[1 \n  2 3]")))
   :expected {:col 1 :end-col 7 :end-row 2 :row 1}}])
