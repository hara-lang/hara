(ns std.block.navigate-test
  (:require [std.block.base :as base]
    [std.block.construct :as construct]
    [std.block.navigate :refer :all :as navigate]
    [std.block.parse :as parse]
    [std.block.type :as type]
    [std.lib.zip :as zip])
  (:config {:override [next replace type]}))

+(def scalar-cursor (navigate/navigator 7))

^{:refer std.block.navigate/block?}
(Test/check [{:name "recognizes the current scalar block" :test (fn [] (navigate/block? scalar-cursor)) :expected true}])
^{:refer std.block.navigate/expression?}
(Test/check [{:name "recognizes a scalar expression" :test (fn [] (navigate/expression? scalar-cursor)) :expected true}])
^{:refer std.block.navigate/type}
(Test/check [{:name "returns the scalar type" :test (fn [] (navigate/type scalar-cursor)) :expected :token}])
^{:refer std.block.navigate/tag}
(Test/check [{:name "returns the scalar tag" :test (fn [] (navigate/tag scalar-cursor)) :expected :number}])
^{:refer std.block.navigate/string}
(Test/check [{:name "renders a scalar" :test (fn [] (navigate/string scalar-cursor)) :expected "7"}])
^{:refer std.block.navigate/length}
(Test/check [{:name "returns scalar length" :test (fn [] (navigate/length scalar-cursor)) :expected 1}])
^{:refer std.block.navigate/width}
(Test/check [{:name "returns scalar width" :test (fn [] (navigate/width scalar-cursor)) :expected 1}])
^{:refer std.block.navigate/height}
(Test/check [{:name "returns scalar height" :test (fn [] (navigate/height scalar-cursor)) :expected 0}])
^{:refer std.block.navigate/prefixed}
(Test/check [{:name "returns no scalar prefix width" :test (fn [] (navigate/prefixed scalar-cursor)) :expected 0}])
^{:refer std.block.navigate/suffixed}
(Test/check [{:name "returns no scalar suffix width" :test (fn [] (navigate/suffixed scalar-cursor)) :expected 0}])
^{:refer std.block.navigate/verify}
(Test/check [{:name "verifies a scalar" :test (fn [] (navigate/verify scalar-cursor)) :expected true}])
^{:refer std.block.navigate/value}
(Test/check [{:name "returns the scalar value" :test (fn [] (navigate/value scalar-cursor)) :expected 7}])
^{:refer std.block.navigate/value-string}
(Test/check [{:name "returns the scalar value rendering" :test (fn [] (navigate/value-string scalar-cursor)) :expected "7"}])
^{:refer std.block.navigate/children}
(Test/check [{:name "returns no scalar children" :test (fn [] (navigate/children scalar-cursor)) :expected []}])
^{:refer std.block.navigate/info}
(Test/check [{:name "returns scalar metrics" :test (fn [] (navigate/info scalar-cursor)) :expected {:height 0 :tag :number :width 1 :type :token :string "7"}}])
^{:refer std.block.navigate/void?}
(Test/check [{:name "does not classify a scalar as void" :test (fn [] (navigate/void? scalar-cursor)) :expected false}])
^{:refer std.block.navigate/space?}
(Test/check [{:name "does not classify a scalar as space" :test (fn [] (navigate/space? scalar-cursor)) :expected false}])
^{:refer std.block.navigate/linebreak?}
(Test/check [{:name "does not classify a scalar as a linebreak" :test (fn [] (navigate/linebreak? scalar-cursor)) :expected false}])
^{:refer std.block.navigate/linespace?}
(Test/check [{:name "does not classify a scalar as line spacing" :test (fn [] (navigate/linespace? scalar-cursor)) :expected false}])
^{:refer std.block.navigate/eof?}
(Test/check [{:name "does not classify a scalar as end-of-file" :test (fn [] (navigate/eof? scalar-cursor)) :expected false}])
^{:refer std.block.navigate/comment?}
(Test/check [{:name "does not classify a scalar as a comment" :test (fn [] (navigate/comment? scalar-cursor)) :expected false}])
^{:refer std.block.navigate/token?}
(Test/check [{:name "classifies a scalar as a token" :test (fn [] (navigate/token? scalar-cursor)) :expected true}])
^{:refer std.block.navigate/container?}
(Test/check [{:name "does not classify a scalar as a container" :test (fn [] (navigate/container? scalar-cursor)) :expected false}])
^{:refer std.block.navigate/modifier?}
(Test/check [{:name "does not classify a scalar as a modifier" :test (fn [] (navigate/modifier? scalar-cursor)) :expected false}])



^{:refer std.block.navigate/left-anchor :added "3.0" :class [:nav/primitive]}
(Test/check
 [{:name "calculates the length to the last newline"
   :test (fn [] (left-anchor (-> (navigator nil) (zip/step-right))))
   :expected 3}])

^{:refer std.block.navigate/update-step-left
  :added "3.0"
  :class [:nav/primitive]}
(Test/check
 [{:name "updates the step position to the left"
   :test (fn [] (-> {:position [0 7]} (update-step-left (construct/block [1 2 3]))))
   :expected {:position [0 0]}}])

^{:refer std.block.navigate/update-step-right
  :added "3.0"
  :class [:nav/primitive]}
(Test/check
 [{:name "updates the step position to the right"
   :test (fn [] (-> {:position [0 0]} (update-step-right (construct/block [1 2 3]))))
   :expected {:position [0 7]}}])

^{:refer std.block.navigate/update-step-inside
  :added "3.0"
  :class [:nav/primitive]}
(Test/check
 [{:name "updates the step position to within a block"
   :test (fn [] (-> {:position [0 0]} (update-step-inside (construct/block #{}))))
   :expected {:position [0 2]}}])

^{:refer std.block.navigate/update-step-inside-left
  :added "3.0"
  :class [:nav/primitive]}
(Test/check
 [{:name "updates the step position to within a block"
   :test (fn [] (-> {:position [0 3]} (update-step-inside-left (construct/block #{}))))
   :expected {:position [0 2]}}])

^{:refer std.block.navigate/update-step-outside
  :added "3.0"
  :class [:nav/primitive]}
(Test/check
 [{:name "updates the step position to be outside a block"
   :test (fn []
             (let [left-elems [(construct/block [1 2 3]) (construct/newline)]]
                  (-> {:left left-elems :position [1 0]}
                      (update-step-outside left-elems) :position)))
   :expected [0 7]}
  {:name "updates the step position with no left elements"
   :test (fn []
             (-> {:left [] :right [(construct/block 1)] :position [0 2]}
                 (update-step-outside []) :position))
   :expected [0 2]}])

^{:refer std.block.navigate/display-navigator
  :added "3.0"
  :class [:nav/primitive]}
(Test/check
 [{:name "displays a string representing the navigator"
   :test (fn [] (-> (navigator [1 2 3 4]) (display-navigator)))
   :expected "<0,0> |[1 2 3 4]"}])

^{:refer std.block.navigate/navigator :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "creates a navigator for the block"
   :test (fn [] (display-navigator (navigator [1 2 3 4])))
   :expected "<0,0> |[1 2 3 4]"}])

^{:refer std.block.navigate/navigator? :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "checks if object is navigator"
   :test (fn [] (navigator? (navigator [1 2 3 4])))
   :expected true}])

^{:refer std.block.navigate/from-status :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "constructs a navigator from a given status"
   :test (fn []
             (display-navigator (from-status (construct/block [1 2 3 (construct/cursor) 4]))))
   :expected "<0,7> [1 2 3 |4]"}])

^{:refer std.block.navigate/parse-string :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "creates a navigator from string"
   :test (fn [] (display-navigator (parse-string "(2   #|   3  )")))
   :expected "<0,5> (2   |   3  )"}])

^{:refer std.block.navigate/parse-root :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "parses the navigator from root string"
   :test (fn [] (display-navigator (parse-root "a b c")))
   :expected "<0,0> |a b c"}])

^{:refer std.block.navigate/parse-first :added "4.0"}
(Test/check
 [{:name "parses the navigator from the first form #1"
   :test (fn [] (display-navigator (parse-first "a b c")))
   :expected "<0,0> |a"}
  {:name "parses the navigator from the first form #2"
   :test (fn [] (display-navigator (parse-first "(+ 1 2 3) (+ 4 5)")))
   :expected "<0,0> |(+ 1 2 3)"}])

^{:refer std.block.navigate/parse-root-status
  :added "3.0"
  :class [:nav/general]}
(Test/check
 [{:name "parses string and creates a navigator from status"
   :test (fn [] (display-navigator (parse-root-status "a b #|c")))
   :expected "<0,4> a b |c"}])

^{:refer std.block.navigate/root-string :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "returns the top level string"
   :test (fn [] (root-string (navigator [1 2 3 4])))
   :expected "[1 2 3 4]"}])

^{:refer std.block.navigate/left-expression :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "returns the expression on the left"
   :test (fn []
             (-> {:left [(construct/newline) (construct/block [1 2 3])]}
                 (left-expression) (base/block-value)))
   :expected [1 2 3]}])

^{:refer std.block.navigate/left-expressions :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "returns all expressions on the left"
   :test (fn []
             (->> {:left [(construct/newline) (construct/block :b)
                          (construct/space)   (construct/space)
                          (construct/block :a)]}
                  (left-expressions) (mapv base/block-value)))
   :expected [:a :b]}])

^{:refer std.block.navigate/right-expression :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "returns the expression on the right"
   :test (fn []
             (-> {:right [(construct/newline) (construct/block [1 2 3])]}
                 (right-expression) (base/block-value)))
   :expected [1 2 3]}])

^{:refer std.block.navigate/right-expressions
  :added "3.0"
  :class [:nav/general]}
(Test/check
 [{:name "returns all expressions on the right"
   :test (fn []
             (->> {:right [(construct/newline) (construct/block :b)
                           (construct/space)   (construct/space)
                           (construct/block :a)]}
                  (right-expressions) (mapv base/block-value)))
   :expected [:b :a]}])

^{:refer std.block.navigate/top :added "4.0"}
(Test/check
 [{:name "moves cursor to the top"
   :test (fn [] (-> (parse-string "(1  [1 2 3]    #|)") (top) display-navigator))
   :expected "<0,0> |(1  [1 2 3]    )"}])

^{:refer std.block.navigate/left :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the left expression"
   :test (fn [] (-> (parse-string "(1  [1 2 3]    #|)") (left) display-navigator))
   :expected "<0,4> (1  |[1 2 3]    )"}])

^{:refer std.block.navigate/left-most :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the left-most expression"
   :test (fn []
             (-> (parse-string "(1  [1 2 3]  3 4   #|)") (left-most) display-navigator))
   :expected "<0,1> (|1  [1 2 3]  3 4   )"}])

^{:refer std.block.navigate/left-most? :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "checks if navigator is at left-most"
   :test (fn [] (-> (from-status [1 [(construct/cursor) 2 3]]) (left-most?)))
   :expected true}])

^{:refer std.block.navigate/right :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the expression on the right"
   :test (fn [] (-> (parse-string "(#|[1 2 3]  3 4  ) ") (right) display-navigator))
   :expected "<0,10> ([1 2 3]  |3 4  )"}])

^{:refer std.block.navigate/right-most :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the right-most expression"
   :test (fn [] (-> (parse-string "(#|[1 2 3]  3 4  ) ") (right-most) display-navigator))
   :expected "<0,12> ([1 2 3]  3 |4  )"}])

^{:refer std.block.navigate/right-most? :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "checks if navigator is at right-most"
   :test (fn [] (-> (from-status [1 [2 3 (construct/cursor)]]) (right-most?)))
   :expected true}])

^{:refer std.block.navigate/up :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "navigates outside of the form"
   :test (fn [] (display-navigator (up (from-status [1 [2 (construct/cursor) 3]]))))
   :expected "<0,3> [1 |[2 3]]"}])

^{:refer std.block.navigate/down :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "navigates into the form"
   :test (fn [] (display-navigator (down (from-status [1 (construct/cursor) [2 3]]))))
   :expected "<0,4> [1 [|2 3]]"}])

^{:refer std.block.navigate/right* :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "navigates to right element, including whitespace"
   :test (fn [] (display-navigator (right* (from-status [(construct/cursor) 1 2]))))
   :expected "<0,2> [1| 2]"}])

^{:refer std.block.navigate/left* :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "navigates to left element, including whitespace"
   :test (fn [] (display-navigator (left* (from-status [1 (construct/cursor) 2]))))
   :expected "<0,2> [1| 2]"}])

^{:refer std.block.navigate/block :added "3.0" :class [:nav/general]}
(Test/check
 [{:name "returns the current block"
   :test (fn [] (block (from-status [1 [2 (construct/cursor) 3]])))
   :expected (construct/block 3)}])

^{:refer std.block.navigate/prev :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the previous expression"
   :test (fn [] (-> (parse-string "([1 2 [3]] #|)") (prev) display-navigator))
   :expected "<0,7> ([1 2 [|3]] )"}])

^{:refer std.block.navigate/find-prev :added "4.0"}
(Test/check
 [{:name "finds the previous token or whitespace"
   :test (fn []
             (-> (parse-string "( \n \n [[3 \n]] #|  )")
                 (find-prev type/linebreak-block?) display-navigator))
   :expected "<2,5> ( \n \n [[3 |\n]]   )"}])

^{:refer std.block.navigate/find-prev-token :added "4.0"}
(Test/check
 [{:name "finds the previous token"
   :test (fn []
             (-> (parse-string "( \n \n [[3 \n]] #|  )")
                 (find-prev-token 3) display-navigator))
   :expected "<2,3> ( \n \n [[|3 \n]]   )"}])

^{:refer std.block.navigate/next :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the next expression"
   :test (fn []
             (-> (parse-string "(#|  [[3]]  )")
                 (navigate/next) (navigate/next)
                 (navigate/next) display-navigator))
   :expected "<0,5> (  [[|3]]  )"}])

^{:refer std.block.navigate/find-next :added "4.0"}
(Test/check
 [{:name "finds the next expression"
   :test (fn []
             (-> (parse-string "(#|  [[3] @5]  )")
                 (find-next (fn [x] (= :deref (base/block-tag x)))) display-navigator))
   :expected "<0,8> (  [[3] |@5]  )"}])

^{:refer std.block.navigate/find-next-token :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the next token"
   :test (fn []
             (-> (parse-string "(#|  [[3 2]]  )") (find-next-token 2) display-navigator))
   :expected "<0,7> (  [[3 |2]]  )"}])

^{:refer std.block.navigate/prev-anchor :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the previous newline #1"
   :test (fn []
             (-> (parse-string "( \n \n [[3 \n]] #|  )") (prev-anchor) (:position)))
   :expected [3 0]}
  {:name "moves to the previous newline #2"
   :test (fn [] (-> (parse-string "( #| )") (prev-anchor) (:position)))
   :expected [0 0]}])

^{:refer std.block.navigate/next-anchor :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the next newline"
   :test (fn [] (-> (parse-string "( \n \n#| [[3 \n]]  )") (next-anchor) (:position)))
   :expected [3 0]}])

^{:refer std.block.navigate/left-token :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the left token"
   :test (fn [] (-> (parse-string "(1  {}  #|2 3 4)") (left-token) display-navigator))
   :expected "<0,1> (|1  {}  2 3 4)"}])

^{:refer std.block.navigate/left-most-token :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the left-most token"
   :test (fn []
             (-> (parse-string "(1  {}  2 3 #|4)") (left-most-token) display-navigator))
   :expected "<0,1> (|1  {}  2 3 4)"}])

^{:refer std.block.navigate/right-token :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the right token"
   :test (fn [] (-> (parse-string "(#|1  {}  2 3 4)") (right-token) display-navigator))
   :expected "<0,8> (1  {}  |2 3 4)"}])

^{:refer std.block.navigate/right-most-token :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the right-most token"
   :test (fn []
             (-> (parse-string "(#|1  {}  2 3 [4])") (right-most-token) display-navigator))
   :expected "<0,10> (1  {}  2 |3 [4])"}])

^{:refer std.block.navigate/prev-token :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the previous token"
   :test (fn [] (-> (parse-string "(1 (2 3 [4])#|)") (prev-token) display-navigator))
   :expected "<0,9> (1 (2 3 [|4]))"}])

^{:refer std.block.navigate/next-token :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves to the next token"
   :test (fn [] (-> (parse-string "(#|[[1 2 3 4]])") (next-token) display-navigator))
   :expected "<0,3> ([[|1 2 3 4]])"}])

^{:refer std.block.navigate/position-left :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves the cursor to left expression #1"
   :test (fn [] (-> (parse-string "( 2   #|   3  )") (position-left) display-navigator))
   :expected "<0,2> ( |2      3  )"}
  {:name "moves the cursor to left expression #2"
   :test (fn [] (-> (parse-string "(   #|   3  )") (position-left) display-navigator))
   :expected "<0,1> (|      3  )"}])

^{:refer std.block.navigate/position-right :added "3.0" :class [:nav/move]}
(Test/check
 [{:name "moves the cursor the right expression #1"
   :test (fn [] (-> (parse-string "(2   #|    3  )") (position-right) display-navigator))
   :expected "<0,9> (2       |3  )"}
  {:name "moves the cursor the right expression #2"
   :test (fn [] (-> (parse-string "(2   #|     )") (position-right) display-navigator))
   :expected "<0,10> (2        |)"}])

^{:refer std.block.navigate/tighten-left :added "3.0" :class [:nav/edit]}
(Test/check
 [{:name "removes extra spaces on the left #1"
   :test (fn [] (-> (parse-string "(1 2 3   #|4)") (tighten-left) display-navigator))
   :expected "<0,7> (1 2 3 |4)"}
  {:name "removes extra spaces on the left #2"
   :test (fn [] (-> (parse-string "(1 2 3   #|    4)") (tighten-left) display-navigator))
   :expected "<0,7> (1 2 3 |4)"}
  {:name "removes extra spaces on the left #3"
   :test (fn [] (-> (parse-string "(    #|     )") (tighten-left) display-navigator))
   :expected "<0,1> (|)"}])

^{:refer std.block.navigate/tighten-right :added "3.0" :class [:nav/edit]}
(Test/check
 [{:name "removes extra spaces on the right #1"
   :test (fn []
             (-> (parse-string "(1 2 #|3       4)") (tighten-right) display-navigator))
   :expected "<0,5> (1 2 |3 4)"}
  {:name "removes extra spaces on the right #2"
   :test (fn []
             (-> (parse-string "(1 2 3   #|    4)") (tighten-right) display-navigator))
   :expected "<0,5> (1 2 |3 4)"}
  {:name "removes extra spaces on the right #3"
   :test (fn [] (-> (parse-string "(    #|     )") (tighten-right) display-navigator))
   :expected "<0,1> (|)"}])

^{:refer std.block.navigate/tighten :added "3.0" :class [:nav/edit]}
(Test/check
 [{:name "removes extra spaces on both the left and right"
   :test (fn [] (-> (parse-string "(1 2      #|3       4)") (tighten) display-navigator))
   :expected "<0,5> (1 2 |3 4)"}])

^{:refer std.block.navigate/level-empty? :added "3.0" :class [:nav/edit]}
(Test/check
 [{:name "checks if current container has expressions"
   :test (fn [] (-> (parse-string "( #| )") (level-empty?)))
   :expected true}])

^{:refer std.block.navigate/insert-raw :added "4.0"}
(Test/check
 [{:name "inserts a raw element #1"
   :test (fn []
             (-> (parse-string "( #| )") (insert-raw (construct/space)) display-navigator))
   :expected "<0,3> (  | )"}
  {:name "inserts a raw element #2"
   :test (fn []
             (-> (parse-string "( #| )")
                 (insert-raw (construct/space)) (insert-raw (construct/space))
                 (insert-raw (construct/space)) (insert-raw (construct/space))
                 display-navigator))
   :expected "<0,6> (     | )"}])

^{:refer std.block.navigate/insert-empty :added "3.0" :class [:nav/edit]}
(Test/check
 [{:name "inserts an element into an empty container"
   :test (fn [] (-> (parse-string "( #| )") (insert-empty 1) display-navigator))
   :expected "<0,1> (|1  )"}])

^{:refer std.block.navigate/insert-token-to-right
  :added "3.0"
  :class [:nav/edit]}
(Test/check
 [{:name "inserts an element to the right #1"
   :test (fn [] (-> (parse-string "(#|0)") (insert-token-to-right 1) display-navigator))
   :expected "<0,1> (|0 1)"}
  {:name "inserts an element to the right #2"
   :test (fn [] (-> (parse-string "(#|)") (insert-token-to-right 1) display-navigator))
   :expected "<0,1> (|1)"}
  {:name "inserts an element to the right #3"
   :test (fn [] (-> (parse-string "( #| )") (insert-token-to-right 1) display-navigator))
   :expected "<0,1> (|1  )"}])

^{:refer std.block.navigate/insert-token-to-left
  :added "3.0"
  :class [:nav/edit]}
(Test/check
 [{:name "inserts an element to the left #1"
   :test (fn [] (-> (parse-string "(#|0)") (insert-token-to-left 1) display-navigator))
   :expected "<0,3> (1 |0)"}
  {:name "inserts an element to the left #2"
   :test (fn [] (-> (parse-string "(#|)") (insert-token-to-left 1) display-navigator))
   :expected "<0,1> (|1)"}
  {:name "inserts an element to the left #3"
   :test (fn [] (-> (parse-string "( #| )") (insert-token-to-left 1) display-navigator))
   :expected "<0,1> (|1  )"}])

^{:refer std.block.navigate/insert-token :added "4.0"}
(Test/check
 [{:name "standard insert token"
   :test (fn [] (-> (parse-string "(#|0)") (insert-token 1) display-navigator))
   :expected "<0,3> (0 |1)"}])

^{:refer std.block.navigate/insert-all :added "3.0"}
(Test/check
 [{:name "inserts all expressions into the block"
   :test (fn [] (-> (parse-string "") (insert-all [1 2 3 4 5 6]) display-navigator))
   :expected "<0,10> 1␣2␣3␣4␣5␣|6:eof"}])

