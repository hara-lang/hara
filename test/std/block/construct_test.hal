^{:refer std.block.construct/construct-collection :added "3.0"}
(Test/check
 [{:name "constructs a collection"
   :test (fn []
             (std.block.base/block-representation (construct-collection [1 2 (void) (void) 3])))
   :expected "[1 2  3]"}]
 migration-test-check)

^{:refer std.block.construct/construct-children :added "3.0"}
(Test/check [{:name "constructs the children ", :test (fn [] (mapv std.block.base/block-representation (construct-children [1 (construct/newline) (void) 2]))), :expected ["1" "\\n" "␣" "2"]}] migration-test-check)

^{:refer std.block.construct/block :added "3.0"}
(Test/check
 [{:name "creates a block #1"
   :test (fn [] (base/block-info (block 1)))
   :expected {:height 0 :string "1" :tag :number :type :token :width 1}}
  {:name "creates a block #2"
   :test (fn []
             (std.block.base/block-representation (block [1 (construct/newline) (void) 2])))
   :expected "[1
 2]"}]
 migration-test-check)

^{:refer std.block.construct/add-child :added "3.0"}
(Test/check
 [{:name "adds a child to a container block"
   :test (fn []
             (-> (block [])
                 (add-child 1) (add-child 2)
                 (std.block.base/block-representation)))
   :expected "[12]"}]
 migration-test-check)

