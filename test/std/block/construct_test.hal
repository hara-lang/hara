(Test/check
 [{:name "creates multiple space blocks"
   :test (fn [] (apply str (map std.block.base/block-representation (spaces 5))))
   :expected "␣␣␣␣␣"}]
 migration-test-check)

^{:refer std.block.construct/tab :added "3.0"}
(Test/check [{:name "creates a tab", :test (fn [] (std.block.base/block-representation (tab))), :expected "\\t"}] migration-test-check)

^{:refer std.block.construct/tabs :added "3.0"}
(Test/check [{:name "creates multiple tabs", :test (fn [] (apply str (map std.block.base/block-representation (tabs 5)))), :expected "\\t\\t\\t\\t\\t"}] migration-test-check)

^{:refer std.block.construct/newline :added "3.0"}
(Test/check [{:name "creates a newline", :test (fn [] (std.block.base/block-representation (construct/newline))), :expected "\\n"}] migration-test-check)

^{:refer std.block.construct/newlines :added "3.0"}
(Test/check [{:name "creates multiple newlines", :test (fn [] (apply str (map std.block.base/block-representation (newlines 5)))), :expected "\\n\\n\\n\\n\\n"}] migration-test-check)

^{:refer std.block.construct/newline? :added "4.0"}
(Test/check
 [{:name "checks if a block is a newline"
   :test (fn [] (newline? (construct/newline)))
   :expected true}]
 migration-test-check)

^{:refer std.block.construct/comment :added "3.0"}
(Test/check
 [{:name "creates a comment block"
