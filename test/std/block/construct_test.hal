(ns std.block.construct-test
  (:require [std.block.base :as base]
            [std.block.construct :refer :all :as construct]))

(defn migration-test-check
  [test expected]
  (let [actual (test)]
    (std.native.Test/result
     "archive migration check"
     actual
     expected
     (std.native.Test/compare actual expected))))

(defn migration-meta-tree
  [value]
  (let [metadata   (select-keys (or (meta value) {}) [:readable-len :tag :spec])
        normalized (cond
                    (vector? value) (mapv migration-meta-tree value)
                    (map? value)    (reduce-kv
                                     (fn
                                      [output key item] (assoc output (migration-meta-tree key) (migration-meta-tree item))) {}
                                     value)
                    (set? value)    (set (map migration-meta-tree value))
                    (seq? value)    (apply list (map migration-meta-tree value))
                    :else           value)]
    {:meta metadata :value normalized}))

^{:refer std.block.construct/void :added "3.0"}
(Test/check
 [{:name "creates a void block"
   :test (fn [] (std.block.base/block-representation (void)))
   :expected "␣"}]
 migration-test-check)

