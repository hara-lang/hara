^{:refer std.block.construct/token-dimensions :added "3.0"}
(Test/check [{:name "returns the dimensions of the token #1", :test (fn [] (token-dimensions :regexp "#\"hello\\nworld\"")), :expected [15 0]} {:name "returns the dimensions of the token #2", :test (fn [] (token-dimensions :regexp "#\"hello\nworld\"")), :expected [6 1]}] migration-test-check)

^{:refer std.block.construct/string-token :added "3.0"}
(Test/check [{:name "constructs a string token #1", :test (fn [] (std.block.base/block-representation (string-token "hello"))), :expected "\"hello\""} {:name "constructs a string token #2", :test (fn [] (std.block.base/block-representation (string-token "hello\nworld"))), :expected "\"hello\\nworld\""} {:name "constructs a string token #3", :test (fn [] (std.block.base/block-representation (string-token " \"hello\"  "))), :expected "\" \\\"hello\\\"  \""}] migration-test-check)

^{:refer std.block.construct/token :added "3.0"}
(Test/check
 [{:name "creates a token"
   :test (fn [] (std.block.base/block-representation (token (quote abc))))
   :expected "abc"}]
 migration-test-check)

^{:refer std.block.construct/token-from-string :added "3.0"}
(Test/check
 [{:name "creates a token from a string input"
   :test (fn [] (std.block.base/block-representation (token-from-string "abc")))
   :expected "abc"}]
 migration-test-check)

^{:refer std.block.construct/container-checks :added "3.0"}
(Test/check
 [{:name "performs checks for the container #1"
   :test (fn [] (container-checks :list [] {}))
   :expected true}
  {:name "performs checks for the container #2"
   :test (fn [] (container-checks :list [(token 1)] {:cons 1}))
   :expected true}
  {:name "performs checks for the container #3"
   :test (fn [] (try (container-checks :list [] {:cons 1}) (catch e :thrown)))
   :expected :thrown}]
 migration-test-check)

^{:refer std.block.construct/container :added "3.0"}
(Test/check
 [{:name "creates a container"
   :test (fn [] (std.block.base/block-representation (container :list [(void) (void)])))
   :expected "(  )"}]
 migration-test-check)

