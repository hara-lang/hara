(Test/check
 [{:name "returns the clojure forms representation of the dsl"
   :test (fn [] (rep (block [1 2 3 4])))
   :expected [1 2 3 4]}]
 migration-test-check)

^{:refer std.block.construct/get-lines :added "4.0"}
(Test/check
 [{:name "gets the lines for a block"
   :test (fn []
             (get-lines (block [(construct/newline) (void) :very-long-line (construct/newline) (void) 2])))
   :expected ["[" " :very-long-line" " 2]"]}]
 migration-test-check)

^{:refer std.block.construct/line-split}
(Test/check
 [{:name "splits top-level child blocks at newline boundaries"
   :test (fn []
           (let [dom (line-split
                      (block [(construct/newline)
                              (void)
                              1]))]
             [(:tag dom)
              (mapv count (:lines dom))
              (mapv (fn [line]
                      (mapv std.block.base/block-representation line))
                    (:lines dom))]))
   :expected [:vector [0 2] [[] ["␣" "1"]]]}]
 migration-test-check)

^{:refer std.block.construct/line-restore}
(Test/check
 [{:name "restores line domains with increasing body indentation"
   :test (fn []
           (mapv (fn [offset]
                   (std.block.base/block-representation
                    (line-restore
                     (line-split
                      (block [(construct/newline)
                              (void)
                              :very-long-line
                              (construct/newline)
                              (void)
                              2]))
                     offset)))
                 [0 2 5 10]))
   :expected ["[
 :very-long-line
 2]"
              "[
   :very-long-line
   2]"
              "[
      :very-long-line
      2]"
              "[
           :very-long-line
           2]"]}]
 migration-test-check)

^{:refer std.block.construct/indent-body :added "4.0"}
(Test/check
 [{:name "indents the body given offset"
   :test (fn []
             (std.block.base/block-representation (indent-body (block [1 2 (construct/newline) 3 4]) 5)))
   :expected "[1 2
     3 4]"}]
 migration-test-check)

^{:refer std.block.construct/raw-block}
(Test/check
 [{:name "creates a concrete block from fully supplied fields"
   :test (fn []
           (base/block-info
            (raw-block :token :number "1" 1 [] {:width 1 :height 0})))
   :expected {:type :token :tag :number :string "1" :height 0 :width 1}}]
 migration-test-check)

^{:refer std.block.construct/text-height}
(Test/check
 [{:name "counts newline boundaries in text"
   :test (fn [] (text-height "a\nb\n"))
   :expected 2}]
 migration-test-check)

^{:refer std.block.construct/text-width}
(Test/check
 [{:name "returns the width after the final newline"
   :test (fn [] [(text-width "abc") (text-width "ab\ncde")])
   :expected [3 3]}]
 migration-test-check)

^{:refer std.block.construct/repeat-string}
(Test/check
 [{:name "repeats source text exactly the requested number of times"
   :test (fn [] (repeat-string "ab" 3))
   :expected "ababab"}]
 migration-test-check)

^{:refer std.block.construct/join-strings}
(Test/check
 [{:name "joins printable source fragments without separators"
   :test (fn [] (join-strings ["a" 2 "c"]))
   :expected "a2c"}]
 migration-test-check)

^{:refer std.block.construct/error}
(Test/check
 [{:name "creates reader-error blocks with source dimensions and message"
   :test (fn []
           (let [block (error "bad\nsource" "unexpected token")]
             [(base/block-info block) (:message (:props block))]))
   :expected [{:type :error :tag :reader-error :string "bad\nsource" :height 1 :width 6}
              "unexpected token"]}]
 migration-test-check)

^{:refer std.block.construct/modifier}
(Test/check
 [{:name "creates modifiers that receive accumulator and input"
   :test (fn []
           (let [block (modifier :append "@" (fn [out input] (conj out input)))]
             [(base/block-type block)
              (base/block-modify block [:kept] :input)]))
   :expected [:modifier [:kept :input]]}]
 migration-test-check)

^{:refer std.block.construct/container-tag}
(Test/check
 [{:name "classifies concrete collection values"
   :test (fn [] [(container-tag []) (container-tag ()) (container-tag {})
                 (container-tag #{}) (container-tag 1)])
   :expected [:vector :list :map :set nil]}]
 migration-test-check)

^{:refer std.block.construct/child-strings}
(Test/check
 [{:name "concatenates the exact source text of children"
   :test (fn [] (child-strings [(token 1) (space) (token 2)]))
   :expected "1 2"}]
 migration-test-check)

^{:refer std.block.construct/child-value-string}
(Test/check
 [{:name "uses modifiers verbatim, expressions as values, and skips void blocks"
   :test (fn [] [(child-value-string (uneval))
                 (child-value-string (token 1))
                 (child-value-string (space))])
   :expected ["#_" "1" nil]}]
 migration-test-check)

^{:refer std.block.construct/container-value-string}
(Test/check
 [{:name "renders expression value strings within supplied delimiters"
   :test (fn [] (container-value-string "[" "]" [(token 1) (space) (token 2)]))
   :expected "[1 2]"}]
 migration-test-check)

^{:refer std.block.construct/expression-values}
(Test/check
 [{:name "suppresses the expression immediately following hash-uneval"
   :test (fn [] (expression-values [(token 1) (uneval) (token 2) (token 3)]))
   :expected [1 3]}]
 migration-test-check)

^{:refer std.block.construct/pair-map}
(Test/check
 [{:name "builds maps from pairs and rejects an odd input count"
   :test (fn [] [(pair-map [:a 1 :b 2])
                 (try (pair-map [:a]) false (catch _ true))])
   :expected [{:a 1 :b 2} true]}]
 migration-test-check)

^{:refer std.block.construct/block-form}
(Test/check
 [{:name "converts keyword tokens and concrete collections to reader forms"
   :test (fn [] [(block-form (token :name))
                 (block-form (block [1 2]))])
   :expected ['(keyword "name") [1 2]]}]
 migration-test-check)

^{:refer std.block.construct/container-value}
(Test/check
 [{:name "computes vector, map, and quote container values"
   :test (fn [] [(container-value :vector [(token 1) (token 2)])
                 (container-value :map [(token :a) (token 1)])
                 (container-value :quote [(token 'x)])])
   :expected [[1 2] {:a 1} '(quote x)]}]
 migration-test-check)

^{:refer std.block.construct/make-container}
(Test/check
 [{:name "builds containers with delimiters and replace-children behavior"
   :test (fn []
           (let [block (make-container :vector [(token 1)] nil)
                 replaced (base/replace-children block [(token 2)])]
             [(base/block-representation block)
              (base/block-representation replaced)]))
   :expected ["[1]" "[2]"]}]
 migration-test-check)

^{:refer std.block.construct/construct-map-values}
(Test/check
 [{:name "flattens sorted map entries for deterministic construction"
   :test (fn [] (construct-map-values {2 20 1 10}))
   :expected [1 10 2 20]}]
 migration-test-check)

^{:refer std.block.construct/split-lines-at-newlines}
(Test/check
 [{:name "splits child sequences at newline blocks while retaining line content"
   :test (fn []
           (mapv (fn [line]
                   (mapv base/block-representation line))
                 (split-lines-at-newlines [(token 1) (newline) (space) (token 2)])))
   :expected [["1"] ["␣" "2"]]}]
 migration-test-check)

^{:refer std.block.construct/restore-line}
(Test/check
 [{:name "recursively restores nested line domains without changing scalar blocks"
   :test (fn []
           (mapv base/block-representation
                 (restore-line [(token 1) (space)] 4)))
   :expected ["1" "␣"]}]
 migration-test-check)
