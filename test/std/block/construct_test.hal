(Test/check
 [{:name "constructs empty list"
   :test (fn [] (std.block.base/block-representation (construct/empty)))
   :expected "()"}]
 migration-test-check)

^{:refer std.block.construct/root :added "3.0"}
(Test/check
 [{:name "constructs a root block"
   :test (fn [] (std.block.base/block-representation (root (quote [a b]))))
   :expected "a b"}]
 migration-test-check)

^{:refer std.block.construct/contents :added "3.0"}
(Test/check
 [{:name "reads out the contents of a container"
   :test (fn [] (contents (block [1 2 3])))
   :expected (quote [1 ␣ 2 ␣ 3])}]
 migration-test-check)

^{:refer std.block.construct/max-width}
(Test/check
 [{:name "measures the widest line with and without a first-line offset"
   :test (fn []
           (let [block (construct/block
                        [:very-long-line (construct/newline) (construct/void) 2])]
             [(max-width block)
              (max-width block 10)
              (max-width (construct/empty))]))
   :expected [16 16 2]}]
 migration-test-check)

^{:refer std.block.construct/line-width :added "4.0"}
(Test/check
 [{:name "get the width at the line which it finishes #1"
   :test (fn [] (line-width (block [:very-long-line (construct/newline) (void) 2])))
   :expected 3}
  {:name "get the width at the line which it finishes #2"
   :test (fn [] (line-width (block [:very-long-line (construct/newline) (void) 2]) 3))
   :expected 0}]
 migration-test-check)

