(ns std.block.layout-test
  (:require [std.block.construct :as construct]
            [std.block.layout :as layout]))

(def binding-map (Algo/ordered-map :keys '[a b] :as 'rest))

^{:refer std.block.layout/is-def?}
(Test/check [{:name "recognises declaration forms and def-prefixed symbols"
              :test (fn [] [(layout/is-def? 'defn) (layout/is-def? 'define-local) (layout/is-def? 'let)])
              :expected [true true false]}])

^{:refer std.block.layout/is-binding?}
(Test/check [{:name "recognises binding forms and with-prefixed symbols"
              :test (fn [] [(layout/is-binding? 'let) (layout/is-binding? 'with-open) (layout/is-binding? 'assoc)])
              :expected [true true false]}])

^{:refer std.block.layout/layout-hiccup-like}
(Test/check [{:name "recognises nested keyword-tagged hiccup vectors"
              :test (fn [] [(layout/layout-hiccup-like [:a :b])
                            (layout/layout-hiccup-like [:a [:b]])])
              :expected [false true]}])

^{:refer std.block.layout/layout-spec-fn}
(Test/check [{:name "derives aligned two-column specs for assoc forms"
              :test (fn [] (layout/layout-spec-fn '(assoc m :a 1 :b 2) true))
              :expected {:col-call true :col-from 1 :columns 2}}])

^{:refer std.block.layout/layout-annotate-arglist}
(Test/check [{:name "annotates nested binding maps and vectors with layout metadata"
              :test (fn []
                      (= (let [annotated (first (layout/layout-annotate-arglist [binding-map]))]
                           [(get (meta annotated) :readable-len)
                            (:tag (meta (:keys annotated)))
                            (:columns (:spec (meta (:keys annotated))))])
                         [30 :vector 1]))
              :expected true}])

^{:refer std.block.layout/layout-annotate-bindings}
(Test/check [{:name "annotates binding vectors with two-column layout metadata"
              :test (fn []
                      (= (let [annotated (layout/layout-annotate-bindings [binding-map 1])]
                           [(:col-align (:spec (meta annotated)))
                            (:columns (:spec (meta annotated)))
                            (count annotated)])
                         [true 2 2]))
              :expected true}])

^{:refer std.block.layout/layout-annotate-fn-named}
(Test/check [{:name "keeps the named function shape while annotating arglists"
              :test (fn []
                      (let [annotated (layout/layout-annotate-fn-named '(defn hello [x] x))]
                        [(first annotated) (second annotated) (count annotated)]))
              :expected ['defn 'hello 4]}])

^{:refer std.block.layout/layout-annotate-fn-anon}
(Test/check [{:name "keeps anonymous function head and arity while annotating arglists"
              :test (fn []
                      (let [annotated (layout/layout-annotate-fn-anon '(fn [x] x))]
                        [(first annotated) (count annotated)]))
              :expected ['fn 3]}])

^{:refer std.block.layout/layout-annotate-svg-path}
(Test/check [{:name "splits SVG path coordinates into a vector"
              :test (fn [] (:d (second (layout/layout-annotate-svg-path [:path {:d "M 10 10 L 20 20"}]))))
              :expected ["M" "10" "10" "L" "20" "20"]}])

^{:refer std.block.layout/layout-annotate}
(Test/check [{:name "dispatches SVG paths to their layout annotation"
              :test (fn [] (:d (second (layout/layout-annotate [:path {:d "M 0 1"}]))))
              :expected ["M" "0" "1"]}])

^{:refer std.block.layout/layout-default-fn}
(Test/check [{:name "renders short vectors without multiline expansion"
              :test (fn [] (pr-str (construct/rep (layout/layout-default-fn [1 2] {}))))
              :expected "[1 2]"}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "renders a simple call into one layout line"
              :test (fn [] (construct/get-lines (layout/layout-main '(+ 1 2 3))))
              :expected ["(+ 1 2 3)"]}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "formats a documented function declaration"
              :test (fn [] (construct/get-lines (layout/layout-main '(defn calculate-sum "Calculates the sum of two numbers." [a b] (+ a b)))))
              :expected ["(defn calculate-sum" "  \"Calculates the sum of two numbers.\"" "  [a b]" "  (+ a b))"]}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "formats a documented Postgres declaration"
              :test (fn [] (construct/get-lines (layout/layout-main '(defn.pg create-user "Creates a user in Postgres." [db user-data] (pg/insert! db :users user-data)))))
              :expected ["(defn.pg create-user" "  \"Creates a user in Postgres.\"" "  [db user-data]" "  (pg/insert! db" "    :users" "    user-data))"]}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "formats a local binding declaration"
              :test (fn [] (construct/get-lines (layout/layout-main '(let [a 10 b 20] (println (+ a b))))))
              :expected ["(let [a 10 b 20]" "  (println (+ a b)))"]}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "formats a component lifecycle form"
              :test (fn [] (construct/get-lines (layout/layout-main '(component/with [sys system] (start sys) (run sys)))))
              :expected ["(component/with [sys system]" "  (start sys)" "  (run sys))"]}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "formats an argument destructuring map"
              :test (fn []
                      (construct/get-lines
                       (layout/layout-main
                        (list 'defn 'configure [(Algo/ordered-map :keys '[host port] :as 'opts)] '(connect host port)))))
              :expected ["(defn configure" "  [{:as opts :keys [host port]}]" "  (connect host port))"]}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "formats nested configuration maps"
              :test (fn []
                      (construct/get-lines
                       (layout/layout-main
                        (list 'def 'config
                              (Algo/ordered-map
                               :server (Algo/ordered-map :host "localhost" :port 8080)
                               :db (Algo/ordered-map :type "postgres" :url "jdbc:postgresql://..."))))))
              :expected ["(def config" "  {:server {:host \"localhost\"" "            :port 8080}" "   :db     {:type \"postgres\"" "            :url  \"jdbc:postgresql://...\"}})"]}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "aligns sibling compound calls"
              :test (fn [] (construct/get-lines (layout/layout-main '(do-things (first-step a b c) (second-step d e f)))))
              :expected ["(do-things (first-step a b c)" "           (second-step d e f))"]}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "indents a nested compound call"
              :test (fn [] (construct/get-lines (layout/layout-main '(do-things (first-step-complex (sub-step-1 a) (sub-step-2 b))))))
              :expected ["(do-things" " (first-step-complex" "  (sub-step-1 a)" "  (sub-step-2 b)))"]}])

^{:refer std.block.layout/layout-main}
(Test/check [{:name "wraps long argument destructuring"
              :test (fn []
                      (construct/get-lines
                       (layout/layout-main
                        (list 'defn 'foo
                              [(Algo/ordered-map :keys '[a b c d e f g h i j k l m n o p] :as 'opts)]
                              '(println a)))))
              :expected ["(defn foo" "  [{:keys [a" "           b" "           c" "           d" "           e" "           f" "           g" "           h" "           i" "           j" "           k" "           l" "           m" "           n" "           o" "           p]" "    :as opts}]" "  (println a))"]}])
