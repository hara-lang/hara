(ns std.block.protocol-test
  (:require [std.block.protocol]))

(defstruct ProtocolFixture [])

(extend-type ProtocolFixture std.block.protocol/IBlock
  (block-type [_] :token)
  (block-tag [_] :symbol)
  (block-string [_] "value")
  (block-length [_] 5)
  (block-width [_] 5)
  (block-height [_] 1)
  (block-prefixed [_] true)
  (block-suffixed [_] false)
  (block-verify [_] :valid)
  (block-info [_] {:kind :fixture}))

(extend-type ProtocolFixture std.block.protocol/IBlockModifier
  (block-modify [_ accumulator input] [accumulator input]))

(extend-type ProtocolFixture std.block.protocol/IBlockExpression
  (block-value [_] 'value)
  (block-value-string [_] "value"))

(extend-type ProtocolFixture std.block.protocol/IBlockContainer
  (block-children [_] [:child])
  (replace-children [_ children] children))

^{:refer std.block.protocol/block-type}
(Test/check
 [{:name "returns a block's broad token type"
   :test (fn [] (std.block.protocol/block-type (ProtocolFixture)))
   :expected :token}])

^{:refer std.block.protocol/block-tag}
(Test/check
 [{:name "returns a block's specific token tag"
   :test (fn [] (std.block.protocol/block-tag (ProtocolFixture)))
   :expected :symbol}])

^{:refer std.block.protocol/block-string}
(Test/check
 [{:name "returns the source text carried by a block"
   :test (fn [] (std.block.protocol/block-string (ProtocolFixture)))
   :expected "value"}])

^{:refer std.block.protocol/block-length}
(Test/check
 [{:name "returns the source length carried by a block"
   :test (fn [] (std.block.protocol/block-length (ProtocolFixture)))
   :expected 5}])

^{:refer std.block.protocol/block-width}
(Test/check
 [{:name "returns the display width carried by a block"
   :test (fn [] (std.block.protocol/block-width (ProtocolFixture)))
   :expected 5}])

^{:refer std.block.protocol/block-height}
(Test/check
 [{:name "returns the display height carried by a block"
   :test (fn [] (std.block.protocol/block-height (ProtocolFixture)))
   :expected 1}])

^{:refer std.block.protocol/block-prefixed}
(Test/check
 [{:name "reports whether the block has a leading prefix"
   :test (fn [] (std.block.protocol/block-prefixed (ProtocolFixture)))
   :expected true}])

^{:refer std.block.protocol/block-suffixed}
(Test/check
 [{:name "reports whether the block has a trailing suffix"
   :test (fn [] (std.block.protocol/block-suffixed (ProtocolFixture)))
   :expected false}])

^{:refer std.block.protocol/block-verify}
(Test/check
 [{:name "returns the block verification result"
   :test (fn [] (std.block.protocol/block-verify (ProtocolFixture)))
   :expected :valid}])

^{:refer std.block.protocol/block-info}
(Test/check
 [{:name "returns structural block metadata"
   :test (fn [] (std.block.protocol/block-info (ProtocolFixture)))
   :expected {:kind :fixture}}])

^{:refer std.block.protocol/block-modify}
(Test/check
 [{:name "passes accumulator and input to a block modifier"
   :test (fn [] (std.block.protocol/block-modify (ProtocolFixture) :acc :input))
   :expected [:acc :input]}])

^{:refer std.block.protocol/block-value}
(Test/check
 [{:name "returns the expression value carried by a block"
   :test (fn [] (std.block.protocol/block-value (ProtocolFixture)))
   :expected 'value}])

^{:refer std.block.protocol/block-value-string}
(Test/check
 [{:name "returns the printable expression value"
   :test (fn [] (std.block.protocol/block-value-string (ProtocolFixture)))
   :expected "value"}])

^{:refer std.block.protocol/block-children}
(Test/check
 [{:name "returns a container's children"
   :test (fn [] (std.block.protocol/block-children (ProtocolFixture)))
   :expected [:child]}])

^{:refer std.block.protocol/replace-children}
(Test/check
 [{:name "replaces a container's children"
   :test (fn [] (std.block.protocol/replace-children (ProtocolFixture) [:replacement]))
   :expected [:replacement]}])
