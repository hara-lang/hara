(ns std.block.source-test
  (:require [std.block.source :as source]))

(defn migration-test-check
  [test expected]
  (let [actual (test)]
    (std.native.Test/result
     "archive migration check"
     actual
     expected
     (std.native.Test/compare actual expected))))

^{:refer std.block.source/namespace-name}
(Test/check
 [{:name "finds the declared namespace after leading forms"
   :test (fn [] (source/namespace-name "(def ignored 1)\n(ns demo.core)\n(def value 1)"))
   :expected "demo.core"}
  {:name "recognizes the ns+ declaration form"
   :test (fn [] (source/namespace-name "(ns+ demo.plus)"))
   :expected "demo.plus"}
  {:name "returns nil when no namespace form is present"
   :test (fn [] (source/namespace-name "(def value 1)"))
   :expected nil}]
 migration-test-check)
^{:refer std.block.source/grep-source}
(Test/check
 [{:name "returns one-based matching source line records"
   :test (fn [] (source/grep-source "alpha\nbeta alpha" "alpha"))
   :expected [{:line 1 :column 1 :text "alpha"}
              {:line 2 :column 1 :text "beta alpha"}]}
  {:name "returns no records when the needle is absent"
   :test (fn [] (source/grep-source "alpha\nbeta" "gamma"))
   :expected []}]
 migration-test-check)
