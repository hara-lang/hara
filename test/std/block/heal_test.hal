(ns std.block.heal-candidate-test
  (:require [std.block.heal :as heal]))

^{:refer std.block.heal/heal}
(Test/check [{:name "normalizes a complete expression through the facade"
              :test (fn [] (heal/heal "(+ 1 2)"))
              :expected "(+ 1 2)"}])

^{:refer std.block.heal/print-rainbow}
(Test/check [{:name "prints the content with rainbow parens"
              :test (fn [] (with-out-string (heal/print-rainbow "(+ 12 3)")))
              :expected "\u001b[34m(\u001b[0m+ 12 3\u001b[34m)\u001b[0m"}])

^{:refer std.block.heal/rainbow}
(Test/check [{:name "formats the content with rainbow parens"
              :test (fn [] (heal/rainbow "(+ 12 3)"))
              :expected "\u001b[34m(\u001b[0m+ 12 3\u001b[34m)\u001b[0m"}])
