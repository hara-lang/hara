(ns std.block.check-test
  (:require [std.block.check]))

^{:refer std.block.check/boundary?}
(Test/check
 [{:name "recognizes delimiters and quote boundaries"
   :test (fn [] [(std.block.check/boundary? \[)
                 (std.block.check/boundary? \" )
                 (std.block.check/boundary? nil)
                 (std.block.check/boundary? \a)])
   :expected [true true true false]}])

^{:refer std.block.check/whitespace?}
(Test/check
 [{:name "recognizes standard whitespace characters"
   :test (fn [] [(std.block.check/whitespace? \space)
                 (std.block.check/whitespace? \tab)
                 (std.block.check/whitespace? \a)])
   :expected [true true false]}])

^{:refer std.block.check/comma?}
(Test/check
 [{:name "recognizes commas only"
   :test (fn [] [(std.block.check/comma? \,) (std.block.check/comma? \; )])
   :expected [true false]}])

^{:refer std.block.check/linebreak?}
(Test/check
 [{:name "recognizes configured line breaks"
   :test (fn [] [(std.block.check/linebreak? \newline)
                 (std.block.check/linebreak? \return)
                 (std.block.check/linebreak? \space)])
   :expected [true true false]}])

^{:refer std.block.check/delimiter?}
(Test/check
 [{:name "recognizes opening and closing delimiters"
   :test (fn [] [(std.block.check/delimiter? \))
                 (std.block.check/delimiter? \[)
                 (std.block.check/delimiter? \a)])
   :expected [true true false]}])

^{:refer std.block.check/voidspace?}
(Test/check
 [{:name "recognizes whitespace and commas as void space"
   :test (fn [] [(std.block.check/voidspace? \newline)
                 (std.block.check/voidspace? \,)
                 (std.block.check/voidspace? \a)])
   :expected [true true false]}])

^{:refer std.block.check/linetab?}
(Test/check
 [{:name "recognizes tabs only"
   :test (fn [] [(std.block.check/linetab? \tab) (std.block.check/linetab? \space)])
   :expected [true false]}])

^{:refer std.block.check/linespace?}
(Test/check
 [{:name "recognizes nonbreak, nontab whitespace"
   :test (fn [] [(std.block.check/linespace? \space)
                 (std.block.check/linespace? \tab)
                 (std.block.check/linespace? \newline)])
   :expected [true false false]}])

^{:refer std.block.check/voidspace-or-boundary?}
(Test/check
 [{:name "recognizes either void space or boundaries"
   :test (fn [] [(std.block.check/voidspace-or-boundary? \newline)
                 (std.block.check/voidspace-or-boundary? \[)
                 (std.block.check/voidspace-or-boundary? \a)])
   :expected [true true false]}])

^{:refer std.block.check/tag}
(Test/check
 [{:name "returns the first matching category tag"
   :test (fn [] [(std.block.check/tag std.block.check/*void-checks* \space)
                 (std.block.check/tag std.block.check/*collection-checks* [])])
   :expected [:linespace :vector]}])

^{:refer std.block.check/void-tag}
(Test/check
 [{:name "returns the void category"
   :test (fn [] (std.block.check/void-tag \newline))
   :expected :linebreak}])

^{:refer std.block.check/void?}
(Test/check
 [{:name "reports whether an input has a void tag"
   :test (fn [] [(std.block.check/void? \newline) (std.block.check/void? \a)])
   :expected [true false]}])

^{:refer std.block.check/token-tag}
(Test/check
 [{:name "returns token categories"
   :test (fn [] [(std.block.check/token-tag 'hello) (std.block.check/token-tag 3)])
   :expected [:symbol :number]}])

^{:refer std.block.check/token?}
(Test/check
 [{:name "reports whether an input has a token category"
   :test (fn [] [(std.block.check/token? 3) (std.block.check/token? [])])
   :expected [true false]}])

^{:refer std.block.check/collection-tag}
(Test/check
 [{:name "returns collection categories"
   :test (fn [] [(std.block.check/collection-tag []) (std.block.check/collection-tag {})])
   :expected [:vector :map]}])

^{:refer std.block.check/collection?}
(Test/check
 [{:name "reports whether an input has a collection category"
   :test (fn [] [(std.block.check/collection? {}) (std.block.check/collection? 3)])
   :expected [true false]}])

^{:refer std.block.check/comment?}
(Test/check
 [{:name "recognizes semicolon-prefixed comment strings"
   :test (fn [] [(std.block.check/comment? "hello")
                 (std.block.check/comment? ";hello")])
   :expected [false true]}])
