(ns std.block.reader-test
  (:require [std.block.check :as check]
            [std.block.reader :as reader :refer :all]))

(defn migration-test-check
  [test expected]
  (let [actual (test)]
    (std.native.Test/result
     "archive migration check"
     actual
     expected
     (std.native.Test/compare actual expected))))

^{:refer std.block.reader/reader-state}
(Test/check
 [{:name "returns the mutable cursor and pushback baseline"
   :test (fn []
           (let [reader (create "ab")]
             (read-char reader)
             (reader-state reader)))
   :expected {:position 1 :pushed []}}]
 migration-test-check)

^{:refer std.block.reader/reset-reader!}
(Test/check
 [{:name "idempotently restores the reader state after consuming and pushing data"
   :test (fn []
           (let [reader (create "ab")]
             (try
               (read-char reader)
               (unread-char reader \z)
               [(reader-state (reset-reader! reader))
                (reader-state (reset-reader! reader))
                (read-char reader)]
               (finally
                 (reset-reader! reader)))))
   :expected [{:position 0 :pushed []} {:position 0 :pushed []} \a]}]
 migration-test-check)

^{:refer std.block.reader/create :added "3.0"}
(Test/check
 [{:name "create reader from string"
   :test (fn [] (type (create "hello world")))
   :expected :std.block.reader.Reader}]
 migration-test-check)

^{:refer std.block.reader/reader-position :added "3.0"}
(Test/check
 [{:name "returns the position of the reader"
   :test (fn [] (-> (create "abc") step-char step-char reader-position))
   :expected [1 3]}]
 migration-test-check)

^{:refer std.block.reader/throw-reader :added "3.0"}
(Test/check
 [{:name "throws a reader message"
   :test (fn [] (try
                   (throw-reader (create "abc") "Message" {:data true})
                   false
                   (catch _ true)))
   :expected true}]
 migration-test-check)

^{:refer std.block.reader/step-char :added "3.0"}
(Test/check
 [{:name "moves reader one char forward"
   :test (fn [] (-> (create "abc") step-char read-char str))
   :expected "b"}]
 migration-test-check)

^{:refer std.block.reader/read-char :added "3.0"}
(Test/check
 [{:name "reads single char and move forward"
   :test (fn [] (->> read-char (read-repeatedly (create "abc")) (take 3)
                    (map str) (str/join "")))
   :expected "abc"}]
 migration-test-check)

^{:refer std.block.reader/ignore-char :added "3.0"}
(Test/check
 [{:name "returns nil and moves reader one char forward"
   :test (fn [] (->> ignore-char (read-repeatedly (create "abc")) (take 3) (apply str)))
   :expected ""}]
 migration-test-check)

^{:refer std.block.reader/unread-char :added "3.0"}
(Test/check
 [{:name "move reader one char back, along with char"
   :test (fn [] (-> (create "abc") (step-char) (unread-char \A) (reader/slurp)))
   :expected "Abc"}]
 migration-test-check)

^{:refer std.block.reader/peek-char :added "3.0"}
(Test/check
 [{:name "returns the current reader char with moving"
   :test (fn [] (->> (read-times (create "abc") peek-char 3)
                    (map str) (str/join "")))
   :expected "aaa"}]
 migration-test-check)

^{:refer std.block.reader/read-while :added "3.0"}
(Test/check
 [{:name "reads input while the predicate is true"
   :test (fn [] (read-while (create "abcde") (fn [ch] (not= ch \d))))
   :expected "abc"}]
 migration-test-check)

^{:refer std.block.reader/read-until :added "3.0"}
(Test/check
 [{:name "reads inputs until the predicate is reached"
   :test (fn [] (read-until (create "abcde") (fn [ch] (= ch \d))))
   :expected "abc"}]
 migration-test-check)

^{:refer std.block.reader/read-times :added "3.0"}
(Test/check
 [{:name "reads input repeatedly"
   :test (fn []
             (->> (read-times (create "abcdefg")
                              (fn [migration-argument-0]
                                  (str (read-char migration-argument-0)
                                       (read-char migration-argument-0))) 2)))
   :expected ["ab" "cd"]}]
 migration-test-check)

^{:refer std.block.reader/read-repeatedly :added "3.0"}
(Test/check
 [{:name "reads input repeatedly"
   :test (fn []
             (->> (read-repeatedly (create "abcdefg")
                                   (fn [migration-argument-0]
                                       (str (read-char migration-argument-0)
                                            (read-char migration-argument-0))) empty?)
                  (take 5)))
   :expected ["ab" "cd" "ef" "g"]}]
 migration-test-check)

^{:refer std.block.reader/read-include :added "3.0"}
(Test/check
 [{:name "reads up to a given predicate"
   :test (fn [] (read-include (create "  a") read-char (complement check/voidspace?)))
   :expected [[\space \space] \a]}]
 migration-test-check)

^{:refer std.block.reader/slurp :added "3.0"}
(Test/check
 [{:name "reads rest of input from reader"
   :test (fn [] (reader/slurp (reader/step-char (create "abc efg"))))
   :expected "bc efg"}]
 migration-test-check)

^{:refer std.block.reader/read-to-boundary :added "3.0"}
(Test/check
 [{:name "reads to an input boundary"
   :test (fn [] (read-to-boundary (create "abc efg")))
   :expected "abc"}]
 migration-test-check)
