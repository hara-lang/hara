(ns std.block.heal.print-candidate-test
  (:require [std.block.heal.parse :as parse]
            [std.block.heal.print :as print]))

^{:refer std.block.heal.print/print-rainbow}
(Test/check
 [{:name "prints matching delimiters with the first rainbow color"
   :test (fn []
           (let [content "(a)"]
             (with-out-string
               (print/print-rainbow content
                                    (parse/pair-delimiters
                                     (parse/parse-delimiters content))))))
   :expected "\u001b[34m(\u001b[0ma\u001b[34m)\u001b[0m"}])
