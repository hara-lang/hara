(ns std.foundation-function-predicate-test)

^{:refer std.foundation/function?}
(Test/check
 [{:name "distinguishes IFn values from native function values"
   :test (fn []
           (let [function (fn [value] value)
                 pointer (pointer {:context :kernel :id "ROOT"})]
             [[(fn? function) (function? function)]
              [(fn? inc) (function? inc)]
              [(fn? :key) (function? :key)]
              [(fn? {:key 1}) (function? {:key 1})]
              [(fn? #{:key}) (function? #{:key})]
              [(fn? pointer) (function? pointer)]
              [(fn? 42) (function? 42)]
              (nil? (resolve 'callable?))]))
   :expected [[true true]
              [true true]
              [true false]
              [true false]
              [true false]
              [true false]
              [false false]
              true]}])
