(ns std.foundation-test-primitives-test)

^{:refer std.native.Test/check}
(Test/check
 [{:name "Test/check returns portable passing and failing maps"
   :test (fn []
           (let [passing (test-check "inner pass" {:a [1 2]} {:a [1 2]})
                 failing (test-check "inner fail" 1 2)]
             [(Test/passed? passing) (Result/status passing)
              (Test/passed? failing) (Test/actual failing) (Test/expected failing)]))
   :expected [true :success false 1 2]}
  {:name "Test/check captures thrown expressions and evaluates them once"
   :test (fn []
           (let [evaluations (atom 0)
                 thrown (test-check
                         "inner throw"
                         (do
                           (swap! evaluations inc)
                           (throw (ex :generic {:kind :test} :ex/message "boom")))
                         :never)
                 error (Result/error-value thrown)]
             [(Test/passed? thrown) (Result/status thrown)
              (ex-message error) (ex-data error) (deref evaluations)]))
   :expected [false :error "boom" {:kind :test :ex/code :hara/generic :ex/class :ex.class/internal :ex/message "boom"} 1]}
  {:name "Test/check compares nested collections"
   :test (fn []
           (Test/passed?
            (test-check "nested pass" {:a [1 2]} {:a [1 2]})))
   :expected true}
  {:name "Test/passed? follows the native Result contract"
   :test (fn []
           (let [passing (test-check "pass" 1 1)
                 failing (test-check "fail" 1 2)
                 thrown (test-check "error" (throw (ex :generic {} :ex/message "boom")) :never)]
             [(Test/passed? passing)
              (Test/passed? failing)
              (Test/passed? thrown)]))
   :expected [true false false]}
  {:name "Result uses the canonical #result literal"
   :test (fn []
           (let [result (Result/create :success {:answer 42} {:trace 8})
                 reread (Edn/read (Edn/write result))]
             [(Edn/write result)
              (Result/status reread)
              (Result/data reread)
              (Result/context reread)]))
   :expected ["#result[:success {:answer 42} nil {:trace 8}]"
              :success
              {:answer 42}
              {:trace 8}]}
  {:name "Test/config validates options without a Foundation forwarding method"
   :test (fn []
           (let [config-result (Test/config {:session-scope :fresh})]
             [(map? config-result) (:options config-result)]))
   :expected [true {:session-scope :fresh}]}])
