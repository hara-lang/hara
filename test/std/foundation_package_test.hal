(ns std.foundation.package-test)

^{:refer std.foundation/list}
(Test/register
 {:desc "packages and loads the Foundation root and companion aliases"
  :test (fn []
          [(vec (list 1 2 3))
           (str/upper "hara")
           (bytes/get (bytes/run -1) 0)])
  :expected [[1 2 3] "HARA" 255]
  :meta {:refer 'std.foundation/list
         :id 'foundation-package-smoke}})
