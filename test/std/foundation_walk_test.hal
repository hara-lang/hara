(ns std.foundation-walk-test)

^{:refer std.foundation/form?}
(Test/check
 [{:name "form? recognises persistent source forms only"
   :test (fn []
           [(form? '(+ 1 2)) (form? '()) (form? [1 2]) (form? nil) (form? 1)])
   :expected [true true false false false]}
  {:name "prewalk and postwalk visit nested forms in their documented order"
   :test (fn []
           (let [post-order (atom [])
                 pre-order (atom [])
                 postwalk-value (postwalk
                                 (fn [value]
                                   (swap! post-order conj value)
                                   value)
                                 [1 [2]])
                 prewalk-value (prewalk
                                (fn [value]
                                  (swap! pre-order conj value)
                                  value)
                                [1 [2]])]
             [(deref pre-order) (deref post-order) prewalk-value postwalk-value]))
   :expected [[[1 [2]] 1 [2] 2]
              [1 2 [2] [1 [2]]]
              [1 [2]]
              [1 [2]]]}
  {:name "walking preserves metadata on persistent forms"
   :test (fn []
           (let [tagged-form (with-meta '(+ 1 2) {:source :walk-test})
                 walked-tagged-form (prewalk identity tagged-form)]
             [(meta tagged-form) (meta walked-tagged-form) (= tagged-form walked-tagged-form)]))
   :expected [{:source :walk-test} {:source :walk-test} true]}
  {:name "walk transforms map keys, map values, sets, lists, vectors, and scalars"
   :test (fn []
           [(postwalk-replace {:a :b 1 2} {:a #{1} :nested '(1 [:a])})
            (walk identity identity 42)])
   :expected [{:b #{2} :nested '(2 [:b])} 42]}
  {:name "replacement walks preserve false and nil replacement values"
   :test (fn []
           [(prewalk-replace {:false false :nil nil} [:false :nil])
            (postwalk-replace {:false false :nil nil} '(:false :nil))])
   :expected [[false nil] '(false nil)]}])
