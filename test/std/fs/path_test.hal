(ns std.fs.path-test
  (:require [std.fs.path :as path]))

^{:refer std.fs.path/normalise}
(Test/check
 [{:name "normalises a path through the host filesystem boundary"
   :test (fn [] (let [root (path/normalise ".")]
                 [(str/starts-with? root "/")
                  (= root (path/normalise root))]))
   :expected [true true]}])

^{:refer std.fs.path/join}
(Test/check
 [{:name "joins one or more path components"
   :test (fn [] [(path/join "/tmp" "demo")
                 (path/join "/tmp" "demo" "main.hal")])
   :expected ["/tmp/demo" "/tmp/demo/main.hal"]}])

^{:refer std.fs.path/parent}
(Test/check
 [{:name "returns the normalized parent path"
   :test (fn [] (path/parent "/tmp/demo/main.hal"))
   :expected "/tmp/demo"}])

^{:refer std.fs.path/file-name}
(Test/check
 [{:name "returns the final component and nil for root"
   :test (fn [] [(path/file-name "/tmp/demo/main.hal")
                 (path/file-name "/")])
   :expected ["main.hal" nil]}])

^{:refer std.fs.path/relativize}
(Test/check
 [{:name "removes a root prefix while preserving outside paths"
   :test (fn [] [(path/relativize "/tmp/demo" "/tmp/demo/main.hal")
                 (path/relativize "/tmp/demo" "/other/main.hal")])
   :expected ["main.hal" "/other/main.hal"]}])
