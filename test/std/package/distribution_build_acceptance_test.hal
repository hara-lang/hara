(ns std.package.distribution-build-acceptance-test
  (:require [code.deploy.package :as package]))

^{:refer code.deploy.package/build-distribution}
(Test/check
 [{:name "builds the Hara launcher through the Hara-owned package planner"
   :test (fn [] (let [result (deref (package/build-distribution))]
                  [(map? result)
                   (deref (File/exists? "/target/hara/bin/hara"))]))
   :expected [true true]}])
