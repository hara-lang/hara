(ns std.package.runtime-test
  (:require [std.package.runtime :as runtime]))

(def +missing-coordinate+ "hara:package-runtime-test-missing")

^{:refer std.package.runtime/catalog}
(Test/check
 [{:name "forwards the runtime package catalogue without reshaping it"
   :test (fn []
           (= (runtime/catalog) (std.native.Package/catalog)))
   :expected true}])

^{:refer std.package.runtime/find}
(Test/check
 [{:name "returns nil for an unlocked package coordinate"
   :test (fn []
           (runtime/find +missing-coordinate+))
   :expected nil}])

^{:refer std.package.runtime/ensure}
(Test/check
 [{:name "preserves the not-locked failure boundary"
   :test (fn []
           (try
             (runtime/ensure +missing-coordinate+)
             false
             (catch error true)))
   :expected true}])

^{:refer std.package.runtime/ensure-all}
(Test/check
 [{:name "resolves an empty package batch deterministically"
   :test (fn []
           (IPromise/then (runtime/ensure-all [])
                          (fn [descriptors]
                            (mapv identity descriptors))))
   :expected []}])

^{:refer std.package.runtime/state}
(Test/check
 [{:name "reports no lifecycle state for an unlocked coordinate"
   :test (fn []
           (runtime/state +missing-coordinate+))
   :expected nil}])

^{:refer std.package.runtime/locked?}
(Test/check
 [{:name "does not treat an unlocked coordinate as locked"
   :test (fn []
           (runtime/locked? +missing-coordinate+))
   :expected false}])

^{:refer std.package.runtime/available?}
(Test/check
 [{:name "does not report an unlocked coordinate as available"
   :test (fn []
           (runtime/available? +missing-coordinate+))
   :expected false}])

^{:refer std.package.runtime/ensuring?}
(Test/check
 [{:name "does not report an unlocked coordinate as ensuring"
   :test (fn []
           (runtime/ensuring? +missing-coordinate+))
   :expected false}])

^{:refer std.package.runtime/ready?}
(Test/check
 [{:name "does not report an unlocked coordinate as ready"
   :test (fn []
           (runtime/ready? +missing-coordinate+))
   :expected false}])

^{:refer std.package.runtime/unloading?}
(Test/check
 [{:name "does not report an unlocked coordinate as unloading"
   :test (fn []
           (runtime/unloading? +missing-coordinate+))
   :expected false}])

^{:refer std.package.runtime/failed?}
(Test/check
 [{:name "does not report an unlocked coordinate as failed"
   :test (fn []
           (runtime/failed? +missing-coordinate+))
   :expected false}])

^{:refer std.package.runtime/read}
(Test/check
 [{:name "keeps native descriptor validation at the host boundary"
   :test (fn []
           (try
             (runtime/read nil "content.edn")
             false
             (catch error true)))
   :expected true}])

^{:refer std.package.runtime/load}
(Test/check
 [{:name "keeps the not-locked failure when loading an unknown namespace"
   :test (fn []
           (try
             (runtime/load +missing-coordinate+)
             false
             (catch error true)))
   :expected true}])

^{:refer std.package.runtime/unload}
(Test/check
 [{:name "keeps the not-locked failure for both unload arities"
   :test (fn []
           [(try
              (runtime/unload +missing-coordinate+)
              false
              (catch error true))
            (try
              (runtime/unload +missing-coordinate+ {})
              false
              (catch error true))])
   :expected [true true]}])
