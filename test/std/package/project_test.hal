(ns std.package.project-test
  (:require [std.package.project :as project]))

^{:refer std.package.project/project-check}
(Test/check
 [{:name "checks the current project identity and version"
   :test (fn []
           (project/project-check "."))
   :expected {:identity "hara/foundation"
              :version "0.1.14"}}
  {:name "rejects a path without a project declaration"
   :test (fn []
           (try
             (project/project-check "target/package-project-missing")
             false
             (catch error true)))
   :expected true}])

^{:refer std.package.project/project-build}
(Test/check
 [{:name "builds a project HARP through the programmatic kernel boundary"
   :test (fn []
           (let [output "/target/package-project-test.harp"]
             (IPromise/then
              (std.native.File/delete output {:missing-ok? true})
              (fn [_]
                (IPromise/finally
                 (Promise/run
                  (fn []
                    (project/project-build "spec" "target/package-project-test.harp")))
                 (fn []
                   (std.native.File/delete output {:missing-ok? true})))))))
   :expected "target/package-project-test.harp"}])

^{:refer std.package.project/project-inspect}
(Test/check
 [{:name "rejects inspection of a missing HARP path"
   :test (fn []
           (try
             (project/project-inspect "target/package-project-missing.harp")
             false
             (catch error true)))
   :expected true}])

^{:refer std.package.project/project-install}
(Test/check
 [{:name "rejects installation of a missing package path without creating state"
   :test (fn []
           (try
             (project/project-install "target/package-project-missing.harp")
             false
             (catch error true)))
   :expected true}])

^{:refer std.package.project/project-publish}
(Test/check
 [{:name "keeps publication closed with the native tap and dry-run parameters"
   :test (fn []
           (try
             (project/project-publish "." "hara" true)
             false
             (catch error true)))
   :expected true}])

^{:refer std.package.project/project-verify-registry}
(Test/check
 [{:name "rejects registry verification without a complete request and identity"
   :test (fn []
           (try
             (project/project-verify-registry {} {})
             false
             (catch error true)))
   :expected true}])
