(ns std.foundation.bytes-test)

^{:refer std.foundation.bytes/run}
(Test/check
 [{:name "run creates a byte buffer"
   :test (fn []
           (bytes/count (bytes/run 1 2 3)))
   :expected 3}
  {:name "get returns signed byte value as unsigned"
   :test (fn []
           (bytes/get (std.native.Bytes/new -1) 0))
   :expected 255}])
