(ns std.foundation.promise-test)

^{:refer std.foundation.promise/promise}
(Test/check
 [{:name "promise body constructor resolves to value"
   :test (fn []
           (deref (promise (fn [] 42))))
   :expected 42}
  {:name "promise/from wraps a value"
   :test (fn []
           (deref (promise/from 42)))
   :expected 42}
  {:name "promise? recognizes promises"
   :test (fn []
           (promise? (promise/from 1)))
   :expected true}
  {:name "promise? rejects non-promises"
   :test (fn []
           (promise? 1))
   :expected false}
  {:name "promise/then chains"
   :test (fn []
           (deref (promise/then (promise (fn [] 40))
                                (fn [x] (promise (fn [] (+ x 2)))))))
   :expected 42}
  {:name "promise/catch recovers from rejection"
   :test (fn []
           (deref (promise/catch (promise (fn [] (throw "bad")))
                                 (fn [error] 7))))
   :expected 7}
  {:name "promise/all returns vector of results"
   :test (fn []
           (nth (deref (promise/all [(promise (fn [] 1))
                                     (promise (fn [] 3))]))
                1))
   :expected 3}
  {:name "promise body can return nested promise"
   :test (fn []
           (deref (promise (fn [] (promise (fn [] 9))))))
   :expected 9}
  {:name "promise/finally runs and returns original value"
   :test (fn []
           (deref (promise/finally (promise (fn [] 4))
                                   (fn [] (promise (fn [] 99))))))
   :expected 4}
  {:name "promise/catch on explicit reject"
   :test (fn []
           (deref (promise/catch (promise/new (fn [resolve reject] (reject "bad")))
                                 (fn [error] 8))))
   :expected 8}
  {:name "promise/catch after finally recovers original error"
   :test (fn []
           (deref (promise/catch (promise/finally (promise (fn [] (throw "original")))
                                                   (fn [] nil))
                                 (fn [error] 11))))
   :expected 11}
  {:name "promise/cancel returns the promise"
   :test (fn []
           (let [p (promise/delay 10000 (fn [] 1))]
             (promise? (promise/cancel p))))
   :expected true}])
