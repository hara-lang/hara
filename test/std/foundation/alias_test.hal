(ns std.foundation.alias-test)

^{:refer std.foundation.string/trim}
(Test/check
 [{:name "str/trim source-declared alias works"
   :test (fn []
           (str/trim "  hara  "))
   :expected "hara"}
  {:name "bytes/get source-declared alias works"
   :test (fn []
           (bytes/get (std.native.Bytes/new -1) 0))
   :expected 255}
  {:name "promise? source-declared alias works"
   :test (fn []
           (promise? (promise/new (fn [resolve reject] (resolve 1)))))
   :expected true}
  {:name ":config {:rename :all} preserves loaded source aliases"
   :test (fn []
           (std.native.Runtime/load-string
            "(ns app (:config {:rename :all})) (bytes/count (str/encode-utf8 \"x\"))"))
   :expected 1}])
