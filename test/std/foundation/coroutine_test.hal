(ns std.foundation.coroutine-test)

(require 'std.foundation.coroutine)

^{:refer std.foundation.coroutine/create}
(Test/check
 [{:name "create makes suspended coroutine"
   :test (fn []
           [(std.foundation.coroutine/coroutine? (std.foundation.coroutine/create (fn [x] x)))
            (std.foundation.coroutine/coroutine? 42)
            (std.foundation.coroutine/status (std.foundation.coroutine/create (fn [x] x)))])
   :expected [true false :suspended]}
  {:name "resume runs body to completion"
   :test (fn []
           (let [c (std.foundation.coroutine/create (fn [x] (* x 2)))]
             [(std.foundation.coroutine/resume c 21)
              (std.foundation.coroutine/status c)]))
   :expected [42 :dead]}
  {:name "yield exchanges values both ways"
   :test (fn []
           (let [c (std.foundation.coroutine/create
                    (fn [start]
                      (let [a (std.foundation.coroutine/yield (* start start))]
                        (let [b (std.foundation.coroutine/yield :second)]
                          [a b]))))]
             [(std.foundation.coroutine/resume c 10)
              (std.foundation.coroutine/resume c :got-a)
              (std.foundation.coroutine/resume c :got-b)
              (std.foundation.coroutine/status c)]))
   :expected [100 :second [:got-a :got-b] :dead]}
  {:name "multi-arg resume delivers vector to yield"
   :test (fn []
           (let [c (std.foundation.coroutine/create
                    (fn []
                      (let [v (std.foundation.coroutine/yield :first)] v)))]
             [(std.foundation.coroutine/resume c)
              (std.foundation.coroutine/resume c 9 8)
              (std.foundation.coroutine/status c)]))
   :expected [:first [9 8] :dead]}
  {:name "multiple values are yielded explicitly as one vector"
   :test (fn []
           (let [c (std.foundation.coroutine/create
                    (fn []
                      (std.foundation.coroutine/yield [1 2 3])
                      (std.foundation.coroutine/yield nil)))]
             [(std.foundation.coroutine/resume c)
              (std.foundation.coroutine/resume c 9 8)
              (std.foundation.coroutine/status c)
              (nil? (std.foundation.coroutine/resume c))
              (std.foundation.coroutine/status c)]))
   :expected [[1 2 3] nil :suspended true :dead]}
  {:name "yield works from nested helper"
   :test (fn []
           (let [_ (defn helper-n [x] (std.foundation.coroutine/yield (* x 10)))
                 c (std.foundation.coroutine/create (fn [] (helper-n 3) :end))]
             [(std.foundation.coroutine/resume c)
              (std.foundation.coroutine/resume c)
              (std.foundation.coroutine/status c)]))
   :expected [30 :end :dead]}
  {:name "nested coroutines resume each other"
   :test (fn []
           (let [c-inner (std.foundation.coroutine/create
                          (fn []
                            (std.foundation.coroutine/yield :inner-yield)
                            :inner-end))
                 c-outer (std.foundation.coroutine/create
                          (fn []
                            (std.foundation.coroutine/yield
                             (std.foundation.coroutine/resume c-inner))
                            (std.foundation.coroutine/yield
                             (std.foundation.coroutine/resume c-inner :x))
                            :outer-end))]
             [(std.foundation.coroutine/resume c-outer)
              (std.foundation.coroutine/resume c-outer)
              (std.foundation.coroutine/resume c-outer)
              (std.foundation.coroutine/status c-outer)]))
   :expected [:inner-yield :inner-end :outer-end :dead]}
  {:name "generator pipeline produces lazily"
   :test (fn []
           (let [c (std.foundation.coroutine/create
                    (fn [n]
                      (loop [i 0]
                        (if (std.foundation/< i n)
                          (do
                            (std.foundation.coroutine/yield (std.foundation/* i i))
                            (recur (std.foundation/inc i)))
                          :done))))]
             [(std.foundation.coroutine/resume c 3)
              (std.foundation.coroutine/resume c)
              (std.foundation.coroutine/resume c)
              (std.foundation.coroutine/resume c)
              (std.foundation.coroutine/status c)]))
   :expected [0 1 4 :done :dead]}
  {:name "await returns settled promise value"
   :test (fn []
           (let [c (std.foundation.coroutine/create
                    (fn []
                      (std.foundation.coroutine/await
                       (Promise/delay 50 (fn [] :delayed-value)))))
                 c-quick (std.foundation.coroutine/create
                          (fn []
                            (std.foundation.coroutine/await
                             (Promise/run (fn [] 7)))))]
             [(std.foundation.coroutine/resume c)
              (std.foundation.coroutine/status c)
              (std.foundation.coroutine/resume c-quick)
              (std.foundation.coroutine/status c-quick)]))
   :expected [:delayed-value :dead 7 :dead]}])
