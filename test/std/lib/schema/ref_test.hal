(ns std.lib.schema.ref-test
  (:require [std.lib.schema.ref :refer :all])
  (:use code.test))

^{:refer std.lib.schema.ref/with:ref-fn, :added "4.0"}
(fact
  "passes a function for use in `reverse-ref-attr` method to add additional params to schema"
  (resolve 'with:ref-fn)
  =>
  (satisfies (fn [value] (= :std.native.Var (type value)))))

^{:refer std.lib.schema.ref/keyword-reverse, :added "3.0"}
(fact
  "reverses the keyword by either adding or removing '_' in the value"
  (keyword-reverse :a/b)
  =>
  :a/_b
  (keyword-reverse :a/_b)
  =>
  :a/b
  (keyword-reverse :b)
  =>
  (throws)
  (keyword-reverse :_b)
  =>
  (throws))

^{:refer std.lib.schema.ref/keyword-reversed? :added "3.0"}
(fact "checks whether the keyword is reversed (begins with '_')"

  (keyword-reversed? :a) => false

  (keyword-reversed? :a/b) => false

  (keyword-reversed? :a/_b) => true

  (keyword-reversed? :_a) => false)

^{:refer std.lib.schema.ref/is-reversible? :added "3.0"}
(fact "determines whether a ref attribute is reversible or not"

  (is-reversible? {:ident   :account/email    ;; okay
                   :type    :ref
                   :ref     {:ns  :email}})
  => true

  (is-reversible? {:ident   :email            ;; does not have keyword-ns
                   :type    :ref
                   :ref     {:ns  :email}})
  => false

  (is-reversible? {:ident   :account/email}) ;; is missing data
  => false

  (is-reversible? {:ident   :account/_email   ;; is already reversible
                   :type    :ref
                   :ref     {:ns  :email}})
  => false

  (is-reversible? {:ident   :account/email    ;; is not a ref
                   :type    :long
                   :ref     {:ns  :email}})
  => false

  (is-reversible? {:ident   :account/email    ;; is tagged 'norev'
                   :type    :ref
                   :ref     {:ns  :email
                             :norev true}})
  => false)

^{:refer std.lib.schema.ref/determine-rval :added "3.0"}
(fact "outputs the :rval value of a :ref schema reference"

  (determine-rval [[:account :email false]
                   [{:ident  :account/email}]])
  => :accounts

  (determine-rval [[:account :email true]
                   [{:ident  :account/email}]])
  => :email-accounts

  (determine-rval [[:account :image true]
                   [{:ident  :account/big-image}]])
  => :big-image-accounts

  (determine-rval [[:node  :node  true]
                   [{:ident  :node/children
                     :ref    {:ns    :node}}]])
  => :children-of

  (determine-rval [[:node  :node  false]
                   [{:ident  :node/children
                     :ref    {:ns    :node
                              :rval  :parents}}]])
  => :parents

  (determine-rval [[:node  :node  false]
                   [{:ident  :node/children
                     :ref    {:ns    :node}}]])
  => :children-of)

^{:refer std.lib.schema.ref/forward-ref-attr, :added "3.0"}
(fact
  "creates the :ref schema attribute for the forward reference case"
  (forward-ref-attr
    [{:ident :node/children, :ref {:ns :node, :rval :parents}}])
  =>
  [{:ident :node/children,
    :ref
    {:ns :node,
     :type :forward,
     :val :children,
     :key :node/children,
     :rval :parents,
     :rkey :node/_children,
     :rident :node/parents}}]
  (forward-ref-attr [{:ident :node/children, :ref {:ns :node}}])
  =>
  (throws))

^{:refer std.lib.schema.ref/reverse-ref-attr, :added "3.0"}
(fact
  "creates the reverse :ref schema attribute for backward reference"
  (reverse-ref-attr
    [{:ident :node/children,
      :ref
      {:ns :node,
       :type :forward,
       :val :children,
       :key :node/children,
       :rval :parents,
       :rkey :node/_children,
       :rident :node/parents}}])
  =>
  [{:ident :node/parents,
    :cardinality :many,
    :type :ref,
    :ref
    {:ns :node,
     :type :reverse,
     :val :parents,
     :key :node/_children,
     :rval :children,
     :rkey :node/children,
     :rident :node/children}}]
  (reverse-ref-attr [{:ident :node/children, :ref {:ns :node}}])
  =>
  (throws))

^{:refer std.lib.schema.ref/forward-ref-attr-fn, :added "3.0"}
(fact
  "helper for `forward-ref-attr`"
  (resolve 'forward-ref-attr-fn)
  =>
  (satisfies (fn [value] (= :std.native.Var (type value)))))

^{:refer std.lib.schema.ref/attr-ns-pair :added "3.0"}
(fact "constructs a :ns and :ident root pair for comparison"

  (attr-ns-pair [{:ident  :a/b
                  :ref    {:ns :c}}])
  => [:a :c])

^{:refer std.lib.schema.ref/mark-multiple :added "3.0"}
(fact "marks multiple ns/ident groups"

  (mark-multiple [[[:a :b] [1 2]]
                  [[:c :d] [1]]])
  => [[[:c :d false] 1]
      [[:a :b true] 1] [[:a :b true] 2]])

^{:refer std.lib.schema.ref/ref-attrs :added "3.0"}
(fact "creates forward and reverse attributes for a flattened schema"

  (ref-attrs {:account/email [{:ident   :account/email
                               :type    :ref
                               :ref     {:ns  :email}}]})
  => {:email/accounts [{:ident :email/accounts
                        :cardinality :many
                        :type :ref
                        :ref {:type   :reverse
                              :key    :account/_email
                              :ns     :account
                              :val    :accounts
                              :rval   :email
                              :rident :account/email
                              :rkey   :account/email}}]
      :account/email  [{:ident :account/email
                        :type :ref
                        :ref {:type   :forward
                              :key    :account/email
                              :ns     :email
                              :val    :email
                              :rval   :accounts
                              :rident :email/accounts
                              :rkey   :account/_email}}]})

(comment
  (./import)
  (./scaffold))

(ns std.lib.schema.ref-test)

^{:refer std.lib.schema.ref/with:ref-fn :id :binding-restoration}
(fact "reference callbacks nest and restore their baseline after failure"
  (let [entry (forward-ref-attr [{:ident :node/children :ref {:ns :node :rval :parents}}])]
    [(with:ref-fn [(fn [_] {:source :outer})]
       [(get-in (first (reverse-ref-attr entry)) [:ref :source])
        (with:ref-fn [(fn [_] {:source :inner})]
          (get-in (first (reverse-ref-attr entry)) [:ref :source]))
        (get-in (first (reverse-ref-attr entry)) [:ref :source])])
     (try (with:ref-fn [(fn [_] {:source :failed})]
            (throw (ex :test/callback {} :ex/message "callback failed")))
          (catch e :caught))
     std.lib.schema.ref/*ref-fn*
     (get-in (first (reverse-ref-attr entry)) [:ref :source])])
  => [[:outer :inner :outer] :caught nil nil])

^{:refer std.lib.schema.ref/keyword-reverse, :id :keyword-round-trip}
(fact
  "qualified keyword reversal is an involution including deeper paths"
  (mapv
    (fn [value] [value (keyword-reverse (keyword-reverse value))])
    [:a/b :a/_b (keyword "a/b/c") (keyword "a/b/_c")])
  =>
  [[:a/b :a/b]
   [:a/_b :a/_b]
   [(keyword "a/b/c") (keyword "a/b/c")]
   [(keyword "a/b/_c") (keyword "a/b/_c")]]
  [(keyword-reverse (keyword "a/b/c"))
   (keyword-reverse (keyword "a/b/_c"))]
  =>
  [(keyword "a/b/_c") (keyword "a/b/c")])

^{:refer std.lib.schema.ref/keyword-reversed?, :id :reverse-boundaries}
(fact
  "only a qualified reversed stem counts"
  (mapv keyword-reversed? [nil :_a :a/b :a/_b (keyword "a/b/_c")])
  =>
  [false false false true true])

^{:refer std.lib.schema.ref/is-reversible? :id :mutual-and-empty}
(fact "mutual and missing references are not reversible"
  (mapv is-reversible?
    [nil {} {:type :ref :ident :a/b :ref {:ns :c :mutual true}}
     {:type :ref :ident :a/b :ref {:ns :c :mutual false :norev false}}
     {:type :ref :ident :a/b :ref {:ns nil}}])
  => [false false false true false])

^{:refer std.lib.schema.ref/determine-rval, :id :name-branches}
(fact
  "reference names preserve explicit overrides and normalize compound names"
  [(determine-rval [[:person :email false] [{:ident :person/email}]])
   (determine-rval
     [[:bigAccount :email true] [{:ident :bigAccount/workEmail}]])
   (determine-rval
     [[:node :node false] [{:ident :node/smallChildren}]])
   (determine-rval
     [[:person :person true]
      [{:ident :person/child, :ref {:rval :ancestors}}]])]
  =>
  [:people :work-email-big-accounts :small-children-of :ancestors])

^{:refer std.lib.schema.ref/forward-ref-attr :id :preserve-forward-properties}
(fact "forward references retain source and nested properties without mutation"
  (let [input [{:ident :a/b :doc "original" :ref {:ns :b :rval :as :custom 7}}]]
    [(forward-ref-attr input) input])
  => [[{:ident :a/b :doc "original"
        :ref {:ns :b :rval :as :custom 7 :type :forward :key :a/b
              :val :b :rkey :a/_b :rident :b/as}}]
      [{:ident :a/b :doc "original" :ref {:ns :b :rval :as :custom 7}}]]
  (forward-ref-attr []) => (throws))

^{:refer std.lib.schema.ref/reverse-ref-attr :id :callback-merge}
(fact "reverse callbacks receive the forward attribute and override reference fields"
  (let [entry (forward-ref-attr [{:ident :a/b :ref {:ns :b :rval :as}}])]
    [(with:ref-fn [(fn [attr] {:origin (:ident attr) :ns :override})]
       (reverse-ref-attr entry))
     std.lib.schema.ref/*ref-fn*])
  => [[{:ident :b/as :cardinality :many :type :ref
        :ref {:ns :override :type :reverse :val :as :key :a/_b
              :rval :b :rkey :a/b :rident :a/b :origin :a/b}}] nil]
  (reverse-ref-attr []) => (throws))

^{:refer std.lib.schema.ref/forward-ref-attr-fn :id :forward-helper-result}
(fact "the forward helper derives rval before enriching the original attribute"
  (forward-ref-attr-fn [[:account :email false]
                        [{:ident :account/email :type :ref :ref {:ns :email}}]])
  => [{:ident :account/email :type :ref
       :ref {:ns :email :rval :accounts :type :forward :key :account/email
             :val :email :rkey :account/_email :rident :email/accounts}}])

^{:refer std.lib.schema.ref/attr-ns-pair, :id :root-and-missing}
(fact
  "grouping uses the first path segment and preserves missing fields"
  [(attr-ns-pair [{:ident (keyword "a/b/c"), :ref {:ns :d}}])
   (attr-ns-pair [{:ident :a, :ref {:ns :d}}])
   (attr-ns-pair [{}])]
  =>
  [[:a :d] [nil :d] [nil nil]])

^{:refer std.lib.schema.ref/mark-multiple :id :mixed-group-order}
(fact "empty input and mixed groups preserve the original accumulator semantics"
  [(mark-multiple [])
   (mark-multiple [] [[:sentinel]])
   (mark-multiple [[[:a :b] [1]] [[:c :d] [2 3]] [[:e :f] [4]]])]
  => [[] [[:sentinel]]
      [[[:e :f false] 4] [[:a :b false] 1]
       [[:c :d true] 2] [[:c :d true] 3]]])

^{:refer std.lib.schema.ref/ref-attrs :id :selection-and-pairs}
(fact "reference generation excludes nonreversible fields and retains inverse links"
  [(ref-attrs {}) (ref-attrs nil)
   (ref-attrs {:a/plain [{:ident :a/plain :type :string}]
               :a/mutual [{:ident :a/mutual :type :ref :ref {:ns :b :mutual true}}]})
   (let [schema {:a/b [{:ident :a/b :type :ref :ref {:ns :b}}]}
         result (ref-attrs schema)
         forward (get-in result [:a/b 0 :ref])
         reverse (get-in result [:b/as 0 :ref])]
     [(:rident forward) (:rident reverse)
      (:val forward) (:rval reverse) (:rval forward) (:val reverse)
      schema])]
  => [{} {} {} [:b/as :a/b :b :b :as :as
                {:a/b [{:ident :a/b :type :ref :ref {:ns :b}}]}]])

^{:refer std.lib.schema.ref/mark-multiple :id :explicit-cons-prepend}
(fact "lists and sequences prepend with cons while vectors append"
  [(vec (mark-multiple [[[:a :b] [1]]] nil))
   (vec (mark-multiple [[[:a :b] [1]]] '([[:z :z false] 0])))
   (vec (mark-multiple [[[:a :b] [1]]] (concat [[[:z :z false] 0]] [])))
   (vec (mark-multiple [[[:a :b] [1]]] [[[:z :z false] 0]]))]
  => [[[[:a :b false] 1]]
      [[[:a :b false] 1] [[:z :z false] 0]]
      [[[:a :b false] 1] [[:z :z false] 0]]
      [[[:z :z false] 0] [[:a :b false] 1]]])

^{:refer std.lib.schema.ref/*ref-fn* :id :dynamic-callback-value}
(fact "the callback Var uses a temporary binding and restores nil"
  [(binding [std.lib.schema.ref/*ref-fn* (fn [value] [:callback value])]
     (std.lib.schema.ref/*ref-fn* :input))
   std.lib.schema.ref/*ref-fn*]
  => [[:callback :input] nil])
