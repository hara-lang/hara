(ns std.lib.package-test
  (:require [std.lib.package]))

^{:refer std.lib.package/executable-config}
(Test/check
 [{:name "accepts a complete executable declaration"
   :test (fn []
           (std.lib.package/executable-config
            {:project/executable {:entry 'demo/main
                                  :output "target/demo"
                                  :primary {:project "."}
                                  :archives []}}))
   :expected {:entry 'demo/main
              :output "target/demo"
              :primary {:project "."}
              :archives []}}])

^{:refer std.lib.package/archive-specs}
(Test/check
 [{:name "converts declared HARP archives to native package records"
   :test (fn []
           (std.lib.package/archive-specs
            [{:harp "target/shared.harp"}
             {:harp "target/support.harp"}]))
   :expected [{:path "target/shared.harp" :primary false}
              {:path "target/support.harp" :primary false}]}])

^{:refer std.lib.package/seal-spec}
(Test/check
 [{:name "keeps dependencies before the primary archive"
   :test (fn []
           (std.lib.package/seal-spec
            {:entry 'demo/main
             :output "target/demo"
             :archives [{:harp "target/shared.harp"}]}
            "target/demo.harp"))
   :expected {:output "target/demo"
              :entry 'demo/main
              :archives [{:path "target/shared.harp" :primary false}
                         {:path "target/demo.harp" :primary true}]}}])

^{:refer std.lib.package/project-form}
(Test/check
 [{:name "reads the executable declaration from the mounted project"
   :test (fn []
           (IPromise/then
            (std.lib.package/project-form)
            (fn [project]
              (select-keys (:project/executable project)
                           [:entry :output :primary :archives]))))
   :expected {:entry 'hara.command/main
              :output "target/hara/hara"
              :primary {:project "."}
              :archives []}}])

^{:refer std.lib.package/specs-project}
(Test/check
 [{:name "declares an artifact-only project for the specification corpus"
   :test (fn []
           (std.lib.package/specs-project "0.1.0"))
   :expected {:hara/type :project
              :hara/version "1.0.0"
              :project/id 'hara/foundation.specs
              :project/version "0.1.0"
              :project/source-paths []
              :project/test-paths []
              :project/extension-paths []
              :project/artifact-paths ["content"]
              :project/capabilities #{:file :kernel}
              :project/dependencies {}}}])

^{:refer std.lib.package/build-specs}
(Test/check
 [{:name "delegates the complete artifact project to the native HARP builder"
   :test (fn []
           (let [output "/target/hara-specs-test.harp"]
             (IPromise/then
              (File/delete output {:missing-ok? true})
              (fn [_]
                (IPromise/finally
                 (Promise/run
                  (fn []
                    (let [archive (std.lib.package/build-specs "spec" "target/hara-specs-test.harp")]
                      [archive
                       (string? (Package/inspect archive))])))
                 (fn []
                   (File/delete output {:missing-ok? true})))))))
   :expected ["target/hara-specs-test.harp" true]}])

^{:refer std.lib.package/build-specs}
(Test/check
 [{:name "preserves curated catalogue and conformance payload boundaries"
   :test (fn []
           (let [output "/target/hara-specs-curation-test.harp"]
             (IPromise/then
              (File/delete output {:missing-ok? true})
              (fn [_]
                (IPromise/finally
                 (Promise/run
                  (fn []
                    (let [archive (std.lib.package/build-specs "spec" "target/hara-specs-curation-test.harp")
                          manifest (Package/inspect archive)]
                      [(String/includes? manifest "content/registry-index.json")
                       (String/includes? manifest "content/01-lang/009-halc/draft/conformance/complete.hal")
                       (String/includes? manifest "00-unsorted/contrib")
                       (String/includes? manifest "99-archive")])))
                 (fn []
                   (File/delete output {:missing-ok? true})))))))
   :expected [true true false false]}])

^{:refer std.lib.package/read-spec-content}
(Test/check
 [{:name "fails with a structured boundary when the specification HARP is not mounted"
   :test (fn []
           (try
             (std.lib.package/read-spec-content "content/01-lang/000-metaspec/draft/metaspec-metaspec.edn")
             false
             (catch _ true)))
   :expected true}])

^{:refer std.lib.package/seal-project}
(Test/check
 [{:name "builds and verifies a one-file executable with its HARP payload"
   :test (fn []
           (let [output "/target/hara/hara"]
             (IPromise/then
              (File/delete output {:missing-ok? true})
              (fn [_]
                (IPromise/finally
                 (IPromise/then
                  (std.lib.package/seal-project)
                  (fn [manifest]
                    (let [verified (Package/verify-seal "target/hara/hara")]
                      [(:executable/format manifest)
                       (:entry manifest)
                       (count (:archives manifest))
                       (:executable/format verified)])))
                 (fn []
                   (File/delete output {:missing-ok? true})))))))
   :expected ["hara-executable/v1" 'hara.command/main 2 "hara-executable/v1"]}])
