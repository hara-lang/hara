(ns std.lib.format.ansi-test
  (:require [std.lib.format.ansi :as ansi]))

^{:refer std.lib.format.ansi/encode-raw}
(Test/check [{:name "encodes raw ANSI modifier codes"
              :test (fn [] (ansi/encode-raw [30 20]))
              :expected "\u001b[30;20m"}])

^{:refer std.lib.format.ansi/encode}
(Test/check [{:name "encodes named and configured custom modifiers"
              :test (fn [] [(ansi/encode :bold) (ansi/encode :warn)])
              :expected ["\u001b[1m" "\u001b[33m"]}
             {:name "raises a canonical exception for an unavailable modifier"
              :test (fn []
                      (try
                        (ansi/encode :not-a-modifier)
                        false
                        (catch error
                          [(ex-message error) (:ex/code (ex-data error)) (:input (ex-data error))])))
              :expected ["Modifier not available." :hara/argument :not-a-modifier]}])

^{:refer std.lib.format.ansi/style}
(Test/check [{:name "wraps text with modifiers and reset"
              :test (fn [] (ansi/style "hello" [:bold :red]))
              :expected "\u001b[1;31mhello\u001b[0m"}])

^{:refer std.lib.format.ansi/style-remove}
(Test/check [{:name "removes ANSI-only strings and preserves ordinary text"
              :test (fn [] [(ansi/style-remove "\u001b[0m") (ansi/style-remove "hello")])
              :expected ["" "hello"]}])

^{:refer std.lib.format.ansi/style-values}
(Test/check [{:name "styles every value before one trailing reset"
              :test (fn [] (ansi/style-values :red ["a" "b"]))
              :expected "\u001b[31ma\u001b[31mb\u001b[0m"}])

