(ns std.lib.format.prose-test
  (:require [std.lib.format.prose]))

^{:refer std.lib.format.prose/has-quotes?}
(Test/check
 [{:name "detects surrounding quote pairs"
   :test (fn [] [(std.lib.format.prose/has-quotes? "\"hello\"")
                 (std.lib.format.prose/has-quotes? "hello")])
   :expected [true false]}])

^{:refer std.lib.format.prose/strip-quotes}
(Test/check
 [{:name "strips exactly one surrounding quote pair"
   :test (fn [] [(std.lib.format.prose/strip-quotes "\"hello\"")
                 (std.lib.format.prose/strip-quotes "hello")])
   :expected ["hello" "hello"]}])

^{:refer std.lib.format.prose/whitespace?}
(Test/check
 [{:name "recognizes empty and whitespace-only text"
   :test (fn [] [(std.lib.format.prose/whitespace? "")
                 (std.lib.format.prose/whitespace? "  \t")
                 (std.lib.format.prose/whitespace? "x")])
   :expected [true true false]}])

^{:refer std.lib.format.prose/escape-dollars}
(Test/check
 [{:name "escapes dollars for replacement text"
   :test (fn [] (std.lib.format.prose/escape-dollars "$"))
   :expected "\\$"}])

^{:refer std.lib.format.prose/escape-newlines}
(Test/check
 [{:name "renders literal newlines visibly"
   :test (fn [] (std.lib.format.prose/escape-newlines "a\nb"))
   :expected "a\\nb"}])

^{:refer std.lib.format.prose/escape-escapes}
(Test/check
 [{:name "doubles a backslash before an alphabetic escape"
   :test (fn [] (std.lib.format.prose/escape-escapes "\\n"))
   :expected "\\\\n"}])

^{:refer std.lib.format.prose/escape-quotes}
(Test/check
 [{:name "escapes quote characters"
   :test (fn [] (std.lib.format.prose/escape-quotes "\"hello\""))
   :expected "\\\"hello\\\""}])

^{:refer std.lib.format.prose/filter-empty-lines}
(Test/check
 [{:name "removes blank lines without disturbing content lines"
   :test (fn [] (std.lib.format.prose/filter-empty-lines "a\n  \n   \nb"))
   :expected "a\nb"}])

^{:refer std.lib.format.prose/single-line}
(Test/check
 [{:name "joins text lines with spaces"
   :test (fn [] (std.lib.format.prose/single-line "a\nb\nc"))
   :expected "a b c"}])

^{:refer std.lib.format.prose/join-lines}
(Test/check
 [{:name "joins a collection with newlines"
   :test (fn [] (std.lib.format.prose/join-lines ["hello" "world"]))
   :expected "hello\nworld"}])

^{:refer std.lib.format.prose/|}
(Test/check
 [{:name "joins variadic values with newlines"
   :test (fn [] (std.lib.format.prose/| "abc" "def"))
   :expected "abc\ndef"}])

^{:refer std.lib.format.prose/lines}
(Test/check
 [{:name "turns text lines into the line-form representation"
   :test (fn [] (vec (map str (std.lib.format.prose/lines "abc\ndef"))))
   :expected ["std.lib.format.prose/|" "abc" "def"]}])

^{:refer std.lib.format.prose/spaces}
(Test/check
 [{:name "creates a requested count of spaces"
   :test (fn [] (std.lib.format.prose/spaces 4))
   :expected "    "}])

^{:refer std.lib.format.prose/write-line}
(Test/check
 [{:name "renders nested data compactly"
   :test (fn [] (std.lib.format.prose/write-line [:a :b ["hello" "world"]]))
   :expected "a b hello world"}])

^{:refer std.lib.format.prose/write-lines}
(Test/check
 [{:name "writes one rendered value per line"
   :test (fn [] (std.lib.format.prose/write-lines ["a" "b" "c"]))
   :expected "a\nb\nc"}])

^{:refer std.lib.format.prose/indent}
(Test/check
 [{:name "indents each line and accepts a custom prefix"
   :test (fn [] [(std.lib.format.prose/indent "a\nb" 2)
                 (std.lib.format.prose/indent "a\nb" 1 {:custom ">"})])
   :expected ["  a\n  b" " >a\n >b"]}])

^{:refer std.lib.format.prose/indent-rest}
(Test/check
 [{:name "keeps the first line while indenting remaining lines"
   :test (fn [] (std.lib.format.prose/indent-rest "a\nb\nc" 2))
   :expected "a\n  b\n  c"}])

^{:refer std.lib.format.prose/multi-line?}
(Test/check
 [{:name "detects newline-bearing text"
   :test (fn [] [(std.lib.format.prose/multi-line? "a\nb")
                 (std.lib.format.prose/multi-line? "a")])
   :expected [true false]}])

^{:refer std.lib.format.prose/single-line?}
(Test/check
 [{:name "detects text with no newline"
   :test (fn [] [(std.lib.format.prose/single-line? "a\nb")
                 (std.lib.format.prose/single-line? "a")])
   :expected [false true]}])

^{:refer std.lib.format.prose/layout-lines}
(Test/check
 [{:name "packs tokens below the requested width"
   :test (fn [] (std.lib.format.prose/layout-lines ["hello" "world" "again" "a" "b"] 8))
   :expected "hello\nworld\nagain a\nb"}])
