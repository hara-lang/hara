(ns std.lib.format.progress-test
  (:require [std.lib.format.progress]))

^{:refer std.lib.format.progress/replace-center}
(Test/check
 [{:name "replaces the middle of a bar without changing its width"
   :test (fn []
           (std.lib.format.progress/replace-center "=================" " hello "))
   :expected "===== hello ====="}])

^{:refer std.lib.format.progress/progress-bar-string}
(Test/check
 [{:name "renders completed, marker, and incomplete bar cells"
   :test (fn []
           (std.lib.format.progress/progress-bar-string
            50 100 (:bar std.lib.format.progress/+progress-defaults+)))
   :expected "===================== 50/100                      "}])

^{:refer std.lib.format.progress/progress-spinner-string}
(Test/check
 [{:name "rotates pending progress and clears completed progress"
   :test (fn []
           [(std.lib.format.progress/progress-spinner-string 9 20)
            (std.lib.format.progress/progress-spinner-string 20 20)])
   :expected ["-" ""]}])

^{:refer std.lib.format.progress/progress-eta}
(Test/check
 [{:name "returns a whole-second remaining estimate"
   :test (fn []
           (std.lib.format.progress/progress-eta 100 90 90))
   :expected 10}])

^{:refer std.lib.format.progress/progress}
(Test/check
 [{:name "creates a meter with an immutable reset baseline"
   :test (fn []
           (let [meter (std.lib.format.progress/progress {:total 12 :label "Load"})]
             [(select-keys (:baseline meter) [:total :current :label])
              (select-keys (deref (:state meter)) [:total :current :label])]))
   :expected [{:total 12 :current 0 :label "Load"}
              {:total 12 :current 0 :label "Load"}]}])

^{:refer std.lib.format.progress/progress-reset!}
(Test/check
 [{:name "restores the creation baseline idempotently"
   :test (fn []
           (let [meter (std.lib.format.progress/progress {:total 3 :label "Load"})]
             (try
               (std.lib.format.progress/progress-update meter 2)
               [(select-keys (deref (:state meter)) [:total :current :label])
                (do
                  (std.lib.format.progress/progress-reset! meter)
                  (= (deref (:state meter)) (:baseline meter)))
                (select-keys (deref (:state meter)) [:total :current :label])
                (do
                  (std.lib.format.progress/progress-reset! meter)
                  (= (deref (:state meter)) (:baseline meter)))]
               (finally
                 (std.lib.format.progress/progress-reset! meter)))))
   :expected [{:total 3 :current 2 :label "Load"}
              true
              {:total 3 :current 0 :label "Load"}
              true]}])

^{:refer std.lib.format.progress/progress-string}
(Test/check
 [{:name "formats a meter state without relying on wall-clock time"
   :test (fn []
           (std.lib.format.progress/progress-string
            {:total 100 :current 9 :label "" :start-time 1 :update-time 11}
            std.lib.format.progress/+progress-defaults+))
   :expected "[=====                 9/100                       ] 101s -"}])

^{:refer std.lib.format.progress/progress-update}
(Test/check
 [{:name "increments and caps progress at its total"
   :test (fn []
           (let [meter (std.lib.format.progress/progress {:total 3})]
             (try
               (std.lib.format.progress/progress-update meter 2)
               (std.lib.format.progress/progress-update meter 2)
               (:current (deref (:state meter)))
               (finally
                 (std.lib.format.progress/progress-reset! meter)))))
   :expected 3}])

^{:refer std.lib.format.progress/progress-test}
(Test/check
 [{:name "runs the complete meter demonstration to completion"
   :test (fn []
           (std.lib.format.progress/progress-test))
   :expected "[====================== 3/3 =======================] 0s "}])
