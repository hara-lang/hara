(ns std.lib.context.pointer-test
 (:require [std.lib.context.pointer :as p])
 (:use code.test))

^{:refer std.lib.context.pointer/*runtime*}
(fact "the override is scoped and the baseline is nil"
 [p/*runtime*
  (binding [p/*runtime* :outer]
   [(binding [p/*runtime* :inner] p/*runtime*) p/*runtime*])
  (try (binding [p/*runtime* :temporary] (throw (ex :test/expected {})))
       (catch e :caught))
  p/*runtime*]
 => [nil [:inner :outer] :caught nil])
