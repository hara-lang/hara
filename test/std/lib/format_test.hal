(ns std.lib.format-test
  (:require [std.lib.format :as format]))

^{:refer std.lib.format/line}
(Test/check [{:name "publishes line construction" :test (fn [] (format/line "ok" :success))
              :expected {:line/text "ok" :line/role :success}}])

^{:refer std.lib.format/cell}
(Test/check [{:name "publishes cell construction" :test (fn [] (format/cell 42 :success))
              :expected {:cell/text "42" :cell/role :success}}])

^{:refer std.lib.format/line-cells}
(Test/check [{:name "publishes structured lines" :test (fn [] (:line/text (format/line-cells [(format/cell "a") (format/cell "b")])))
              :expected "ab"}])

^{:refer std.lib.format/value-text}
(Test/check [{:name "publishes portable value rendering" :test (fn [] (format/value-text [:alpha 2]))
              :expected "[:alpha 2]"}])

^{:refer std.lib.format/display-width}
(Test/check [{:name "publishes terminal width measurement" :test (fn [] (format/display-width "界"))
              :expected 2}])

^{:refer std.lib.format/truncate}
(Test/check [{:name "publishes display truncation" :test (fn [] (format/truncate "abcdef" 5))
              :expected "ab..."}])

^{:refer std.lib.format/pad}
(Test/check [{:name "publishes display padding" :test (fn [] (format/pad "x" 3 :right))
              :expected "  x"}])

^{:refer std.lib.format/table-lines}
(Test/check [{:name "publishes table rendering" :test (fn []
                                                         (let [lines (format/table-lines {:section/columns [{:key :path}]
                                                                                          :section/entries [{:path "a"}]})]
                                                           [(count lines) (:line/text (nth lines 2))]))
              :expected [3 "a   "]}])

^{:refer std.lib.format/report-lines}
(Test/check [{:name "publishes structured report rendering" :test (fn []
                                                                      (let [lines (format/report-lines {:report/sections [{:section/id :items :section/kind :text :section/entries ["ok"]}]})]
                                                                        [(count lines) (:line/text (nth lines 0))]))
              :expected [2 "items"]}])

^{:refer std.lib.format/report}
(Test/check [{:name "publishes report rendering" :test (fn [] (format/report {:report/sections [{:section/id :items :section/kind :text :section/entries ["ok"]}]}))
              :expected "items\nok"}])

^{:refer std.lib.format/render-lines}
(Test/check [{:name "publishes structured terminal rendering" :test (fn [] (format/render-lines [{:line/text "ok" :line/role :success}] {:ansi true}))
              :expected ["\u001b[32mok\u001b[0m"]}])

^{:refer std.lib.format/render}
(Test/check [{:name "publishes joined terminal rendering" :test (fn [] (format/render [{:line/text "one"} {:line/text "two"}]))
              :expected "one\ntwo"}])

^{:refer std.lib.format/emit-lines}
(Test/check [{:name "publishes injected line emission" :test (fn []
                                                                 (let [output (atom [])
                                                                       count (format/emit-lines [{:line/text "one"} {:line/text "two"}]
                                                                                                {:emit (fn [text] (swap! output conj text))})]
                                                                   [count @output]))
              :expected [2 ["one" "two"]]}])
