#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PROJECT_ROOT="$REPO_ROOT/core"
cd "$REPO_ROOT"

collect_root() {
    local root="$1"
    if [ -d "$root" ]; then
        find "$root" -name '*.hal' \
            ! -path 'core/lib/test/std/lib/test.hal' \
            -print
    fi
}

collect_files() {
    if [ "$#" -eq 0 ]; then
        collect_root core/lib/test
        collect_root core/lib/test-lang
        return
    fi

    local target
    for target in "$@"; do
        if [ -d "$target" ]; then
            find "$target" -name '*.hal' \
                ! -path 'core/lib/test/std/lib/test.hal' \
                -print
        elif [ -f "$target" ]; then
            if [ "$target" != 'core/lib/test/std/lib/test.hal' ]; then
                printf '%s\n' "$target"
            fi
        else
            echo "Test target not found: $target" >&2
            return 2
        fi
    done
}

mapfile -t TEST_FILES < <(collect_files "$@" | sort -u)

if [ "${#TEST_FILES[@]}" -eq 0 ]; then
    echo "No library test files selected" >&2
    exit 2
fi

ABSOLUTE_TEST_FILES=()
for test_file in "${TEST_FILES[@]}"; do
    if [[ "$test_file" = /* ]]; then
        ABSOLUTE_TEST_FILES+=("$test_file")
    else
        ABSOLUTE_TEST_FILES+=("$REPO_ROOT/$test_file")
    fi
done

exec cargo run --quiet \
    --manifest-path "$REPO_ROOT/core/rust/Cargo.toml" \
    --bin hara-test -- \
    --root "$PROJECT_ROOT" \
    "${ABSOLUTE_TEST_FILES[@]}"
