(ns gw.showcase.supersonic.graph-contract)

(def portable-graph
  {"graph/id" "showcase/supersonic-contract"
   "title" "Portable Signal"
   "nodes"
   [{"id" "source"
     "type" "audio/oscillator"
     "params" {"waveform" "sine"
               "frequency" 220}}
    {"id" "gain"
     "type" "audio/gain"
     "params" {"volume" 0.35}}
    {"id" "output"
     "type" "audio/output"}]
   "connections"
   [{"from" ["source" "audio"]
     "to" ["gain" "audio"]}
    {"from" ["gain" "audio"]
     "to" ["output" "audio"]}]})

[:main {:class "preview-shell"}
 [:article {:class "card"}
  [:span {:class "eyebrow"} "SUPERSONIC / GRAPH CONTRACT"]
  [:h1 "Portable Signal"]
  [:p "The graph is inspectable before playback authority exists. Nodes, typed controls and connections remain ordinary Hara data."]
  [:div {:class "workspace-showcase-grid"}
   [:section
    [:strong "Oscillator"]
    [:p "sine · 220 Hz"]
    [:code "audio/oscillator"]]
   [:section
    [:strong "Gain"]
    [:p "volume 0.35"]
    [:code "range 0 → 1"]]
   [:section
    [:strong "Output"]
    [:p "browser-owned destination"]
    [:code "user gesture required"]]]]]
