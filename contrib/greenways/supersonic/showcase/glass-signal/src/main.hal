(ns gw.showcase.supersonic.glass-signal
  (:require [gw.audio.supersonic :as sonic]))

(def live-graph
  {"graph/id" "showcase/supersonic-glass-signal"
   "title" "Glass Signal"
   "nodes"
   [{"id" "transport"
     "type" "control/transport"
     "label" "Transport"
     "summary" "Musical time for the live sequence."
     "params" {"playing" false
               "tempo" 112
               "steps-per-beat" 2}
     "controls"
     [{"parameter" "playing"
       "type" "boolean"
       "label" "Playing"}
      {"parameter" "tempo"
       "type" "number"
       "label" "Tempo"
       "min" 40
       "max" 240
       "step" 1
       "integer" true}
      {"parameter" "steps-per-beat"
       "type" "number"
       "label" "Steps / beat"
       "min" 1
       "max" 8
       "step" 1
       "integer" true}]}

    {"id" "sequence"
     "type" "data/sequence"
     "label" "Sequence"
     "summary" "Offsets from the root note; nil is a rest."
     "params" {"steps" [0 7 12 7
                        3 10 15 10
                        5 12 17 12
                        3 10 15 nil]}
     "controls"
     [{"parameter" "steps"
       "type" "steps"
       "label" "Note offsets"}]}

    {"id" "source"
     "type" "audio/oscillator"
     "label" "Oscillator"
     "summary" "A browser-owned oscillator created only after Play."
     "params" {"waveform" "sine"
               "root" 48
               "gate" 0.72}
     "controls"
     [{"parameter" "waveform"
       "type" "choice"
       "label" "Waveform"
       "choices" ["sine" "square" "saw" "triangle"]}
      {"parameter" "root"
       "type" "number"
       "label" "MIDI root"
       "min" 24
       "max" 84
       "step" 1
       "integer" true}
      {"parameter" "gate"
       "type" "number"
       "label" "Gate"
       "min" 0.05
       "max" 1
       "step" 0.01}]}

    {"id" "mixer"
     "type" "audio/mixer"
     "label" "Mixer"
     "summary" "Final browser output level."
     "params" {"volume" 0.68}
     "controls"
     [{"parameter" "volume"
       "type" "number"
       "label" "Volume"
       "min" 0
       "max" 1
       "step" 0.01}]}

    {"id" "output"
     "type" "audio/output"
     "label" "Browser output"
     "summary" "Web Audio destination; a user gesture is required."}]

   "connections"
   [{"from" ["transport" "tick"]
     "to" ["sequence" "tick"]
     "kind" "control"}
    {"from" ["sequence" "note"]
     "to" ["source" "note"]
     "kind" "control"}
    {"from" ["source" "audio"]
     "to" ["mixer" "audio"]
     "kind" "audio"}
    {"from" ["mixer" "audio"]
     "to" ["output" "audio"]
     "kind" "audio"}]})

;; Graph publication is silent. Open Audio and press Play once before updating.
(def audio-state (sonic/start live-graph))

[:main {:class "preview-shell"}
 [:article {:class "card"}
  [:span {:class "eyebrow"} "SUPERSONIC / LIVE GRAPH"]
  [:h1 "Glass Signal"]
  [:p "Press Play once, then evaluate sonic/update forms to reshape the running graph without resetting its clock."]]]
