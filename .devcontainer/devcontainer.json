{
  "name": "Hara",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "targets": "wasm32-unknown-unknown,wasm32-wasip1"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "CARGO_HOME": "/home/vscode/.cache/hara/cargo",
    "MAVEN_OPTS": "-Dmaven.repo.local=/home/vscode/.cache/hara/maven",
    "npm_config_cache": "/home/vscode/.cache/hara/npm",
    "PLAYWRIGHT_BROWSERS_PATH": "/home/vscode/.cache/hara/playwright"
  },
  "forwardPorts": [1311, 4321],
  "portsAttributes": {
    "1311": {
      "label": "Hara RESP"
    },
    "4321": {
      "label": "Hara Astro docs"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vscjava.vscode-java-pack",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
