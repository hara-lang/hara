(ns package.split.main
  (:require [lang.core :as l]
            [code.test :as t]))

(defn proof
  "Exercises one public API from each split package."
  []
  (let [runtime (l/rt-create :xtalk :default)]
    {:runtime-lang (:lang runtime)
     :runtime-type (:runtime runtime)
     :checker-type (:checker/type (t/exactly {:package :split}))}))
